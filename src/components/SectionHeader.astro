---
/**
 * SectionHeader — Eyebrow + DM Serif h2 + lead för sektionsrubriker
 *
 * Standardiserar sektionsrubriker på produktsidor så de matchar premium-
 * stilen (samma typografi som ModernHero h1 men i mindre storlek).
 *
 * Lead-prop kan ta HTML (set:html) om man behöver fetstil, lavendel-länk
 * eller annan formattering i lead-texten.
 */
interface Props {
  eyebrow?: string;         // "Snabbval" (optional — utelämnas där hero redan har eyebrow nära)
  h2: string;               // "Färdiga scenpaket"
  lead?: string;            // Vanlig text
  leadHtml?: string;        // Alternativt: HTML-text (set:html)
  id?: string;              // För scroll-target
  maxWidth?: string;        // default "760px" för lead-textens bredd
  marginBottom?: string;    // default "2rem"
}

const {
  eyebrow,
  h2,
  lead,
  leadHtml,
  id,
  maxWidth = '760px',
  marginBottom = '2rem',
} = Astro.props;
---

<div class="sh-header" id={id} style={`margin-bottom:${marginBottom}`}>
  {eyebrow && <p class="sh-eyebrow">{eyebrow}</p>}
  <h2 class="sh-h2">{h2}</h2>
  {leadHtml ? (
    <p class="sh-lead" style={`max-width:${maxWidth}`} set:html={leadHtml} />
  ) : lead ? (
    <p class="sh-lead" style={`max-width:${maxWidth}`}>{lead}</p>
  ) : null}
</div>

<style>
  /* Design 2026 — samma rubriker som startsidan */
  .sh-header { scroll-margin-top: calc(var(--nav-offset, 166px) + 1rem); }
  .sh-eyebrow { color: #c4b5f4; font-family: 'Space Grotesk', sans-serif; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; margin: 0 0 0.75rem; }
  .sh-h2 { font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(1.9rem, 3.6vw, 2.75rem); color: #fff; margin: 0 0 0.9rem; line-height: 1.05; }
  .sh-lead { color: rgba(255,255,255,0.72); font-size: 1.05rem; line-height: 1.6; margin: 0; }
  .sh-lead :global(strong) { color: rgba(255,255,255,0.9); font-weight: 600; }
</style>
