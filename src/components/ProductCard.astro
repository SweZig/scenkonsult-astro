---
// ProductCard.astro
import CartButton from './CartButton.astro';
import Price from './Price.astro';
interface Props {
  id?: string;
  artno?: string;
  name: string;
  price: number | string;
  priceNote?: string;
  image?: string;
  alt?: string;
  description: string;
  persons?: string;
  specs?: string[];
  videoSrc?: string;
  quantityPrices?: { qty: string; price: number }[];
  dimensionTable?: { label: string; value: string; highlight?: boolean }[];
  wide?: boolean;
  category?: string;
  manualUrl?: string;
}
const { id, artno, name, price, priceNote = "/dygn", image, alt, description, persons, specs, videoSrc, quantityPrices, dimensionTable, wide = false, category = 'Produkt', monteringMin, manualUrl } = Astro.props;
const cartId = id ?? name.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// YouTube-detektering — stödjer https://youtu.be/ID, youtube.com/watch?v=ID, youtube.com/embed/ID
const _ytMatch = videoSrc ? String(videoSrc).match(/(?:youtu\.be\/|v=|embed\/)([A-Za-z0-9_-]{11})/) : null;
const youtubeId = _ytMatch ? _ytMatch[1] : '';
const isYouTube = Boolean(youtubeId);

// Bygg slides-array (bild först, sedan video) — används om både bild och video finns
const _slides: Array<{ type: 'image' | 'video'; src: string }> = [];
if (image) _slides.push({ type: 'image', src: image });
if (videoSrc) _slides.push({ type: 'video', src: videoSrc });
const hasMultipleSlides = _slides.length > 1;
const mcId = hasMultipleSlides ? `mc-pc-${Math.random().toString(36).slice(2, 8)}` : '';
const slidesJson = hasMultipleSlides ? JSON.stringify(_slides) : '';

const productJson = JSON.stringify({
  name:      name,
  artno:     artno ?? '',
  desc:      (specs ?? []).join('||'),
  rows:      [
    ...(quantityPrices ? [{ label: 'Volympriser', rows: quantityPrices.map(qp => `${qp.qty} – ${qp.price.toLocaleString('sv')} kr`) }] : []),
    ...(dimensionTable ? [{ label: 'Mått & kapacitet', rows: dimensionTable.map(r => `${r.label}: ${r.value}`) }] : []),
  ],
  price:     typeof price === 'number' ? price : 0,
  priceNote: priceNote,
  category:  category,
  cartId:    cartId,
  images:    image ? [image] : [],
  videos:    videoSrc ? [videoSrc] : [],
  persons:   persons ?? '',
});
---
<article
  class={`bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col h-full ${wide ? 'lg:col-span-2' : ''}`}
  itemscope itemtype="https://schema.org/Product"
  data-sk-product={productJson}
  data-mc-id={hasMultipleSlides ? mcId : undefined}
  data-mc-slides={hasMultipleSlides ? slidesJson : undefined}
  style="cursor:pointer"
>
  {image && !hasMultipleSlides && (
    <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853;cursor:zoom-in">
      <img src={image} alt={alt ?? name} width="512" height="427" loading="lazy"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
    </div>
  )}
  {hasMultipleSlides && (
    <div class="relative bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
      <div class="mc-slide-area w-full h-full" id={`${mcId}-area`}>
        <img src={image} alt={alt ?? name} width="512" height="427" loading="lazy"
          class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
      </div>
      <button
        class="mc-arr mc-arr-l absolute left-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-8 flex items-center justify-center bg-black/65 hover:bg-brand-orange/70 border border-white/15 rounded-md text-white text-base leading-none transition-colors"
        data-mc-dir="-1"
        aria-label="Föregående"
      >‹</button>
      <button
        class="mc-arr mc-arr-r absolute right-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-8 flex items-center justify-center bg-black/65 hover:bg-brand-orange/70 border border-white/15 rounded-md text-white text-base leading-none transition-colors"
        data-mc-dir="1"
        aria-label="Nästa"
      >›</button>
      <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 z-10 flex gap-1" id={`${mcId}-dots`}>
        {_slides.map((s, i) => (
          <button
            class={`mc-dot transition-all ${i === 0 ? 'bg-brand-orange w-2.5 h-2' : 'bg-white/30 w-2 h-2'} ${s.type === 'video' ? 'rounded-sm' : 'rounded-full'}`}
            data-mc-goto={i}
            aria-label={`Slide ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  )}
  <meta itemprop="image" content={image ? `https://scenkonsult.se${image}` : 'https://scenkonsult.se/images/hero/scen3_hero.webp'} />
  <!-- Product schema metadata -->
  <meta itemprop="brand" content="Scenkonsult Norden" />
  {!description && <meta itemprop="description" content={`Hyra ${name} från Scenkonsult Norden. Leverans i hela Storstockholm.`} />}
  <div class="p-5 flex flex-col flex-1">

    {persons && <p class="text-[10px] font-semibold uppercase tracking-wider mb-1" style="color:#c4b5f4">{persons}</p>}
    <h2 class="font-bold text-white text-lg group-hover:text-brand-orange transition-colors leading-tight mb-1" itemprop="name">{name}</h2>
    {artno && <p class="artno-badge mb-2">{artno}</p>}
    {dimensionTable && dimensionTable.length > 0 && (
      <div class="bg-brand-dark/50 rounded-lg p-3 mb-3 text-xs space-y-1 border border-white/5">
        {dimensionTable.map(row => (
          <div class="flex justify-between gap-2">
            <span class="text-white/40">{row.label}</span>
            <span class={row.highlight ? 'text-amber-400 font-semibold' : 'text-white/70'}>{row.value}</span>
          </div>
        ))}
      </div>
    )}
    <p class="text-gray-400 text-sm leading-relaxed mb-3" itemprop="description">{description}</p>

    {quantityPrices && quantityPrices.length > 0 && (
      <div class="bg-brand-dark/60 rounded-xl p-3 mb-3 text-xs space-y-1">
        {quantityPrices.map(qp => (
          <div class="flex justify-between">
            <span class="text-gray-400">{qp.qty}</span>
            <span class="text-white font-semibold">
              <span class="sk-price-excl">{qp.price.toLocaleString('sv')} kr{priceNote !== "/dygn" ? priceNote : " / dygn"}</span>
              <span class="sk-price-incl hidden">{Math.round(qp.price * 1.25).toLocaleString('sv')} kr{priceNote !== "/dygn" ? priceNote : " / dygn"}</span>
            </span>
          </div>
        ))}
      </div>
    )}

    {specs && specs.length > 0 && (
      <ul class="space-y-1 border-t border-white/10 pt-3">
        {specs.map(s => (
          <li class="text-gray-400 text-xs flex gap-1.5"><span class="text-green-400 shrink-0 mt-0.5">▸</span><span>{s}</span></li>
        ))}
      </ul>
    )}

    <!-- Spacer pushes bottom bar ned oavsett specs-antal -->
    <div class="flex-1 min-h-[0.5rem]"></div>

    <!-- Scen-style bottom bar: pris vänster, knapp höger -->
    <div class="flex flex-col border-t border-white/10 pt-4 mt-auto gap-2" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
    <div class="flex items-center justify-between gap-3">
      <meta itemprop="priceCurrency" content="SEK" />
      <meta itemprop="price" content={String(price)} />
      <meta itemprop="priceValidUntil" content="2027-12-31" />
      <meta itemprop="availability" content="https://schema.org/InStock" />
      <meta itemprop="seller" content="Scenkonsult Norden" />
      <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
        <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion">
          <meta itemprop="addressCountry" content="SE" />
        </div>
        <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount">
          <meta itemprop="currency" content="SEK" />
          <meta itemprop="value" content="0" />
        </div>
        <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
          <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
          <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
        </div>
      </div>
      <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
        <meta itemprop="applicableCountry" content="SE" />
        <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
        <meta itemprop="merchantReturnDays" content="1" />
        <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
        <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
      </div>
      {typeof price === 'number' ? (
        <>
          <span class="text-brand-orange font-extrabold text-xl shrink-0">
            <Price amount={price} suffix={priceNote} size="xl" />
          </span>
          <CartButton id={cartId} name={name} price={price} priceNote={priceNote} artno={artno ?? ''} category={category} image={image ?? ''} monteringMin={monteringMin} size="md" />
        </>
      ) : (
        <>
          <span class="text-brand-orange font-extrabold text-xl">{price}</span>
          <a href="/bokningssida/" class="inline-flex items-center gap-2 bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-semibold px-4 py-2 text-sm rounded-lg whitespace-nowrap transition-colors">Boka</a>
        </>
      )}
    </div>
    {manualUrl && (
      <a href={manualUrl} target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-[11px] text-gray-500 hover:text-brand-orange transition-colors mt-1 w-fit">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Ladda ned manual (PDF)
      </a>
    )}
    </div>

  </div>
</article>
