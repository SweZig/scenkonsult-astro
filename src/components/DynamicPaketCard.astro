---
// Dynamiskt paket-kort: kunden väljer yta + trappor → live-pris + live-illustration
// Cart-add splittar paketet i komponentrader (modul × N + trappor + ev. tak)
import scenData from '../data/scenes.json';
import tjanster from '../data/tjanster.json';

const { paket } = Astro.props;
const cfg = paket.config;
const useFoto = !!paket.image;

const SURFACE_LABELS = {
  '1x2-slat':    'Slät 1×2',
  '1x2-halkfri': 'Halkfri 1×2',
  '1x1-halkfri': 'Halkfri 1×1',
};

// Generera deterministiskt unikt id för SVG-pattern (kollisionssäkert)
const svgId = `pkt-${paket.id}`;

// ──────────────────────────────────────────────────────────────────
// JSON-first datalookups — synkade med scenes.json + tjanster.json
// ──────────────────────────────────────────────────────────────────
const _modules = scenData.modules || [];

// surfaceKey: matchar surface (slät/halkfri) + size (1×1/1×2) → '1x2-slat' osv
function _surfaceKey(m) {
  // '1×1 m' → '1x1' (strip whitespace, ' m' suffix, ersätt ×→x)
  const sizeKey = (m.size || '').replace(/\s*m\b/i, '').replace(/\s/g, '').replace(/×/g, 'x');
  const surf = m.surface === 'slät' ? 'slat' : 'halkfri';
  return `${sizeKey}-${surf}`;
}

const INJ_MOD_BY_KEY = Object.fromEntries(
  _modules.map(m => [_surfaceKey(m), { artno: m.artno, name: m.name, price: m.price }])
);

// Trappor 40/60 cm — slå upp via artno
const _tillbehor = scenData.tillbehor || [];
const _trapp40 = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0001');
const _trapp60 = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0002');
const INJ_TRAPP_BY_HEIGHT = {
  40: _trapp40 ? { artno: _trapp40.artno, name: _trapp40.name, price: _trapp40.price } : null,
  60: _trapp60 ? { artno: _trapp60.artno, name: _trapp60.name, price: _trapp60.price } : null,
};

const INJ_FRAKT_RULES = scenData.fraktByArea || [
  { maxArea: 16, fordon: 'storbil' },
  { maxArea: 24, fordon: 'storbil_slap' },
  { maxArea: 9999, fordon: 'lastbil' },
];

const INJ_MONTERING_MIN_PER_MODULE = 10;
---

<article
  class="paket-card"
  id={paket.id}
  data-paket-id={paket.id}
  data-paket-artno={paket.artno}
  data-paket-name={paket.name}
  data-paket-transport={paket.transport}
  data-paket-config={JSON.stringify(cfg)}
  itemscope itemtype="https://schema.org/Product"
>
  <div class="paket-image-wrap">
    {useFoto ? (
      <img src={paket.image} alt={paket.alt || paket.name} width="512" height="427" loading="lazy" class="paket-foto" />
    ) : (
      <svg
        class="paket-svg"
        id={svgId}
        data-paket-svg
        viewBox="0 0 400 320"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label={`Visualisering av ${paket.name}`}
      ></svg>
    )}
  </div>
  <meta itemprop="image" content={`https://scenkonsult.se${paket.image || '/images/hero/scen3_hero.webp'}`} />
  <meta itemprop="brand" content="Scenkonsult Norden" />

  <div class="paket-body">
    <p class="paket-tagline">{paket.tagline}</p>
    <h3 class="paket-name" itemprop="name">{paket.name}</h3>
    <p class="paket-artno">{paket.artno}</p>

    <div class="paket-specs">
      <div class="paket-spec-row"><span class="paket-spec-label">Storlek</span><span class="paket-spec-val">{paket.size}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Mått</span><span class="paket-spec-val">{paket.dimensions}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Höjd</span><span class="paket-spec-val" data-paket-display-height>{cfg.defaultHeight} cm</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Kapacitet</span><span class="paket-spec-val">{paket.capacity}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Transport</span>
        {paket.transport === 'krävs' ? (
          <span class="paket-spec-val paket-spec-warn">Vi levererar – tillkommer</span>
        ) : (
          <span class="paket-spec-val">Tilläggstjänst</span>
        )}
      </div>
    </div>

    <p class="paket-description" itemprop="description">{paket.description}</p>

    <div class="paket-control">
      <span class="paket-control-label">Yta</span>
      <div class="paket-pills" role="radiogroup" aria-label="Yta">
        {cfg.supportedSurfaces.map(s => (
          <button
            type="button"
            class="paket-pill"
            data-yta={s}
            aria-pressed={s === cfg.defaultSurface ? 'true' : 'false'}
          >{SURFACE_LABELS[s]}</button>
        ))}
      </div>
    </div>

    <div class="paket-control">
      <span class="paket-control-label">Trappor</span>
      <div class="paket-pills" role="radiogroup" aria-label="Antal trappor">
        {cfg.stairCounts.map(n => (
          <button
            type="button"
            class="paket-pill"
            data-stairs={n}
            aria-pressed={n === cfg.defaultStairCount ? 'true' : 'false'}
          >{n}</button>
        ))}
      </div>
    </div>

    <div class="paket-bottom" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      <meta itemprop="priceCurrency" content="SEK" />
      <meta itemprop="price" content={paket.price} />
      <meta itemprop="availability" content="https://schema.org/InStock" />
      <meta itemprop="priceValidUntil" content="2027-12-31" />
      <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
        <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion">
          <meta itemprop="addressCountry" content="SE" />
        </div>
        <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount">
          <meta itemprop="currency" content="SEK" />
          <meta itemprop="value" content="0" />
        </div>
        <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
          <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
          <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
        </div>
      </div>
      <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
        <meta itemprop="applicableCountry" content="SE" />
        <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
        <meta itemprop="merchantReturnDays" content="1" />
        <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
        <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
      </div>
      <div class="paket-bottom-row">
        <div class="paket-price">
          <span class="sk-price-excl paket-price-num" data-paket-price-excl>{paket.price.toLocaleString('sv-SE')} kr</span>
          <span class="sk-price-incl hidden paket-price-num" data-paket-price-incl>{Math.round(paket.price * 1.25).toLocaleString('sv-SE')} kr</span>
          <span class="paket-price-suffix">/dygn</span>
        </div>
        <button type="button" class="paket-cart-btn" data-paket-add aria-label={`Lägg ${paket.name} i varukorgen`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span data-paket-cart-label>Lägg i varukorg</span>
        </button>
      </div>
      <p class="paket-price-note">Exkl. transport &amp; montering — tillkommer separat</p>
    </div>
    <p class="paket-warning" data-paket-warning hidden></p>
  </div>
</article>

<script define:vars={{ INJ_MOD_BY_KEY, INJ_TRAPP_BY_HEIGHT, INJ_FRAKT_RULES, INJ_MONTERING_MIN_PER_MODULE }}>
  // ──────────────────────────────────────────────────────────────────
  // Konstanter — byggs dynamiskt från JSON via define:vars
  // ──────────────────────────────────────────────────────────────────
  const MOD_PRICE = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.price]));
  const MOD_ARTNO = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.artno]));
  const MOD_NAMES = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.name]));
  const TRAPP = INJ_TRAPP_BY_HEIGHT;
  const MODULE_MONTERING_MIN = INJ_MONTERING_MIN_PER_MODULE;

  function fmt(n) { return Math.round(n).toLocaleString('sv-SE') + ' kr'; }

  function moduleCount(w, d, surface) {
    const area = w * d;
    return surface === '1x1-halkfri' ? area : Math.floor(area / 2);
  }

  function isSurfaceValid(w, d, surface) {
    if (surface === '1x1-halkfri') return w * d <= 20;
    // 1×2 kräver att minst en dimension är jämn
    return (w % 2 === 0) || (d % 2 === 0);
  }

  function computePrice(cfg, surface, stairs) {
    if (!isSurfaceValid(cfg.width, cfg.depth, surface)) return null;
    const mc = moduleCount(cfg.width, cfg.depth, surface);
    const stairPrice = TRAPP[cfg.defaultHeight]?.price || 0;
    let price = mc * MOD_PRICE[surface] + stairs * stairPrice;
    if (cfg.tak) price += cfg.tak.price;
    return price;
  }

  function getRecommendedFrakt(area) {
    if (!area || area === 0) return null;
    for (const rule of INJ_FRAKT_RULES) {
      if (area <= rule.maxArea) return rule.fordon;
    }
    return INJ_FRAKT_RULES[INJ_FRAKT_RULES.length - 1]?.fordon || 'lastbil';
  }

  // ──────────────────────────────────────────────────────────────────
  // SVG-rendering: top-down 2D av scen + trappor (samma stil som konfiguratorn)
  // ──────────────────────────────────────────────────────────────────
  function drawPaketSvg(svgEl, cfg, surface, stairs) {
    const { width: w, depth: d } = cfg;
    const padX = 60, padY = 60;
    const vw = 400, vh = 320;
    const maxW = vw - 2 * padX;
    const maxH = vh - 2 * padY - 30; // utrymme för trappa under
    const scale = Math.min(maxW / w, maxH / d);
    const stageW = w * scale;
    const stageD = d * scale;
    const x0 = (vw - stageW) / 2;
    const y0 = (vh - stageD) / 2 - 8;

    const svgIdSafe = svgEl.id || 'pkt';
    const isHalkfri = surface.includes('halkfri');
    const moduleFill = isHalkfri ? `url(#patHalkfri-${svgIdSafe})` : '#3a3370';

    let html = '';
    if (isHalkfri) {
      html += `<defs><pattern id="patHalkfri-${svgIdSafe}" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)"><rect width="6" height="6" fill="#3a3370"/><line x1="0" y1="0" x2="0" y2="6" stroke="#5a4ea0" stroke-width="1.2"/></pattern></defs>`;
    }

    // Skugga
    const sh = 5;
    html += `<rect x="${x0 + sh}" y="${y0 + sh}" width="${stageW}" height="${stageD}" fill="rgba(0,0,0,0.4)" rx="2"/>`;

    // Scenens topp
    html += `<rect x="${x0}" y="${y0}" width="${stageW}" height="${stageD}" fill="${moduleFill}" stroke="#c4b5f4" stroke-width="1.5" rx="2"/>`;

    // Modulrutnät
    if (surface === '1x1-halkfri') {
      for (let i = 1; i < w; i++) {
        const x = x0 + i * scale;
        html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
      }
      for (let j = 1; j < d; j++) {
        const y = y0 + j * scale;
        html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
      }
    } else {
      // 1×2: orientera moduler så att den jämna sidan får 2-uppdelning
      const horiz = (w % 2 === 0); // 2m längs bredden
      if (horiz) {
        for (let i = 2; i < w; i += 2) {
          const x = x0 + i * scale;
          html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
        for (let j = 1; j < d; j++) {
          const y = y0 + j * scale;
          html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
      } else {
        for (let i = 1; i < w; i++) {
          const x = x0 + i * scale;
          html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
        for (let j = 2; j < d; j += 2) {
          const y = y0 + j * scale;
          html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
      }
    }

    // Trappor — alltid längs framsidan (botten i SVG)
    const sw = Math.min(stageW, stageD) * 0.18;
    const sd = sw * 0.7;
    const placements = stairs === 1 ? [0.5] : stairs === 2 ? [0.3, 0.7] : [];
    placements.forEach(frac => {
      const sx = x0 + stageW * frac - sw / 2;
      const sy = y0 + stageD;
      html += `<g><rect x="${sx}" y="${sy}" width="${sw}" height="${sd}" fill="#2d2670" stroke="#c4b5f4" stroke-width="1" rx="2"/>`;
      for (let i = 1; i < 4; i++) {
        const ly = sy + (sd * i / 4);
        html += `<line x1="${sx + 2}" y1="${ly}" x2="${sx + sw - 2}" y2="${ly}" stroke="#c4b5f4" stroke-width="0.8" stroke-opacity="0.7"/>`;
      }
      html += `</g>`;
    });

    // "Tak"-symbol om paket har tak — markering ovanpå scenen
    if (cfg.tak) {
      const tx = x0 + stageW / 2;
      const ty = y0 - 14;
      html += `<g opacity="0.8">`;
      html += `<text x="${tx}" y="${ty}" text-anchor="middle" fill="#c4b5f4" font-family="Space Grotesk,sans-serif" font-size="11" font-weight="700" letter-spacing="1">↑ MED TAK</text>`;
      html += `</g>`;
    }

    svgEl.innerHTML = html;
  }

  // ──────────────────────────────────────────────────────────────────
  // Init varje kort
  // ──────────────────────────────────────────────────────────────────
  function initPaketCard(card) {
    // Idempotent: skydda mot att initPaketCard anropas flera gånger på samma kort.
    // Astro-script med define:vars renderas per komponent-instans (12 paket =
    // 12 inline-scripts), och varje script kör querySelectorAll('.paket-card').forEach.
    // Utan denna guard registreras click-handlers N gånger → ett klick = N add-calls.
    if (card.dataset.paketInitialized === '1') return;
    card.dataset.paketInitialized = '1';

    const cfg = JSON.parse(card.dataset.paketConfig || '{}');
    const paketName = card.dataset.paketName;
    let surface = cfg.defaultSurface;
    let stairs = cfg.defaultStairCount;

    const svgEl = card.querySelector('[data-paket-svg]');
    const priceExcl = card.querySelector('[data-paket-price-excl]');
    const priceIncl = card.querySelector('[data-paket-price-incl]');
    const heightDisplay = card.querySelector('[data-paket-display-height]');
    const cartBtn = card.querySelector('[data-paket-add]');
    const cartLabel = card.querySelector('[data-paket-cart-label]');
    const warning = card.querySelector('[data-paket-warning]');

    function update() {
      const price = computePrice(cfg, surface, stairs);

      // Disable invalid surfaces
      card.querySelectorAll('[data-yta]').forEach(b => {
        const valid = isSurfaceValid(cfg.width, cfg.depth, b.dataset.yta);
        if (!valid) {
          b.classList.add('paket-pill-disabled');
          b.disabled = true;
          b.title = b.dataset.yta === '1x1-halkfri' ? `1×1-yta stöder max 20 m² (paketet är ${cfg.width * cfg.depth} m²)` : 'Kräver att en dimension är jämn';
        } else {
          b.classList.remove('paket-pill-disabled');
          b.disabled = false;
          b.title = '';
        }
      });

      if (price === null) {
        priceExcl.textContent = '—';
        priceIncl.textContent = '—';
        cartBtn.disabled = true;
        warning.hidden = false;
        warning.textContent = 'Vald yta är inte kompatibel med paketets mått.';
      } else {
        priceExcl.textContent = price.toLocaleString('sv-SE') + ' kr';
        priceIncl.textContent = Math.round(price * 1.25).toLocaleString('sv-SE') + ' kr';
        cartBtn.disabled = false;
        warning.hidden = true;
      }

      if (heightDisplay) heightDisplay.textContent = cfg.defaultHeight + ' cm';

      // Pressed-states
      card.querySelectorAll('[data-yta]').forEach(b => {
        b.setAttribute('aria-pressed', b.dataset.yta === surface ? 'true' : 'false');
      });
      card.querySelectorAll('[data-stairs]').forEach(b => {
        b.setAttribute('aria-pressed', String(parseInt(b.dataset.stairs)) === String(stairs) ? 'true' : 'false');
      });

      if (svgEl) drawPaketSvg(svgEl, cfg, surface, stairs);
    }

    card.querySelectorAll('[data-yta]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        surface = btn.dataset.yta;
        update();
      });
    });
    card.querySelectorAll('[data-stairs]').forEach(btn => {
      btn.addEventListener('click', () => {
        stairs = parseInt(btn.dataset.stairs);
        update();
      });
    });

    cartBtn?.addEventListener('click', () => {
      if (!window.skCart || cartBtn.disabled) return;
      const mc = moduleCount(cfg.width, cfg.depth, surface);
      const area = cfg.width * cfg.depth;
      const transport = card.dataset.paketTransport;
      const isKravs = transport === 'krävs';
      // Krävs: forceLeverans (override eller auto-rekommenderat fordon)
      // Tillägg: ingen forceLeverans → kunden får välja själv i varukorgen
      const lev = isKravs ? (cfg.forceLeverans || getRecommendedFrakt(area)) : null;

      // skCart.add merger qty på existing item-id men SÄTTER INTE flaggor på en
      // existerande rad. För att flaggor (bulky/requiresAssembly/forceLeverans/
      // monteringMin) garanterat hamnar på storage-itemet, applicera dem direkt
      // efter add-anropet via skCart.get/save.
      function applyFlagsTo(itemId, flags) {
        try {
          const c = window.skCart.get();
          const stored = c.find(i => i.id === itemId);
          if (stored) {
            Object.assign(stored, flags);
            window.skCart.save(c);
          }
        } catch (e) { /* tyst — flaggor är best-effort */ }
      }

      // Modul-rad. bulky+requiresAssembly bara om paketet kräver transport,
      // annars utelämnas → kunden i varukorgen får välja transport+montering själv.
      const modItem = {
        id: MOD_ARTNO[surface],
        artno: MOD_ARTNO[surface],
        name: `${MOD_NAMES[surface]} — ${paketName}`,
        price: MOD_PRICE[surface],
        qty: mc,
        category: 'Scen',
        monteringMin: MODULE_MONTERING_MIN, // alltid satt så att monteringspriset blir rätt om kunden bockar i
      };
      if (isKravs) {
        modItem.bulky = true;
        modItem.requiresAssembly = true;
        if (lev) modItem.forceLeverans = lev;
      }
      window.skCart.add(modItem);
      // Säkerställ flaggor även om itemet redan fanns i cart (merge-bug-skydd)
      const modFlags = { monteringMin: MODULE_MONTERING_MIN };
      if (isKravs) {
        modFlags.bulky = true;
        modFlags.requiresAssembly = true;
        if (lev) modFlags.forceLeverans = lev;
      }
      applyFlagsTo(modItem.id, modFlags);

      // Trapp-rader (om kunden valt > 0)
      if (stairs > 0) {
        const t = TRAPP[cfg.defaultHeight];
        if (t) {
          window.skCart.add({
            id: t.artno,
            artno: t.artno,
            name: `${t.name} — ${paketName}`,
            price: t.price,
            qty: stairs,
            category: 'Scen tillbehör',
          });
        }
      }

      // Tak-paket — alltid bulky/montering eftersom tak är skrymmande och tar tid
      if (cfg.tak) {
        const takItem = {
          id: cfg.tak.artno,
          artno: cfg.tak.artno,
          name: `${cfg.tak.name} — ${paketName}`,
          price: cfg.tak.price,
          qty: 1,
          category: 'Scen tillbehör',
          bulky: true,
          requiresAssembly: true,
          monteringMin: cfg.tak.monteringMin,
        };
        // Om paketet har forceLeverans-override på sig (Large+ tak: lastbil),
        // sätt det på tak-raden också så att 'lastbil' definitivt vinner i cart
        if (cfg.forceLeverans) takItem.forceLeverans = cfg.forceLeverans;
        window.skCart.add(takItem);
        // Säkerställ flaggor även vid merge
        const takFlags = {
          bulky: true,
          requiresAssembly: true,
          monteringMin: cfg.tak.monteringMin,
        };
        if (cfg.forceLeverans) takFlags.forceLeverans = cfg.forceLeverans;
        applyFlagsTo(cfg.tak.artno, takFlags);
      }

      if (cartLabel) {
        const original = cartLabel.textContent;
        cartLabel.textContent = '✓ Lagt till!';
        cartBtn.classList.add('paket-cart-btn-success');
        setTimeout(() => {
          cartLabel.textContent = original;
          cartBtn.classList.remove('paket-cart-btn-success');
        }, 1800);
      }
    });

    update();
  }

  // Init alla paket-kort på sidan
  document.querySelectorAll('.paket-card').forEach(initPaketCard);
</script>

<style is:global>
  .paket-card {
    background: #1e1850;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    overflow: hidden;
