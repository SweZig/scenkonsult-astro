---
// Dynamiskt paket-kort: kunden väljer yta + trappor → live-pris + live-illustration
// Cart-add splittar paketet i komponentrader (modul × N + trappor + ev. tak)
import scenData from '../data/scenes.json';
import tjanster from '../data/tjanster.json';

const { paket } = Astro.props;
const cfg = paket.config;
// Foto används ENDAST för tak-paket (medium-plus-tak, large-plus-tak) —
// konfiguratorns 2D-SVG kan rita scenytan men inte taket. Övriga paket
// renderas alltid med SVG-skiss (yta/trappor uppdateras live när kunden
// väljer). JSON-fältet `paket.image` finns kvar för offert-modal,
// JSON-LD-schema och kategori-sidor (festival, bröllop, guider).
const useFoto = !!cfg.tak && !!paket.image;

const SURFACE_LABELS = {
  '1x2-slat':    'Slät 1×2',
  '1x2-halkfri': 'Halkfri 1×2',
  '1x1-halkfri': 'Halkfri 1×1',
};

// Generera deterministiskt unikt id för SVG-pattern (kollisionssäkert)
const svgId = `pkt-${paket.id}`;

// ──────────────────────────────────────────────────────────────────
// JSON-first datalookups — synkade med scenes.json + tjanster.json
// ──────────────────────────────────────────────────────────────────
const _modules = scenData.modules || [];

// surfaceKey: matchar surface (slät/halkfri) + size (1×1/1×2) → '1x2-slat' osv
function _surfaceKey(m) {
  // '1×1 m' → '1x1' (strip whitespace, ' m' suffix, ersätt ×→x)
  const sizeKey = (m.size || '').replace(/\s*m\b/i, '').replace(/\s/g, '').replace(/×/g, 'x');
  const surf = m.surface === 'slät' ? 'slat' : 'halkfri';
  return `${sizeKey}-${surf}`;
}

const INJ_MOD_BY_KEY = Object.fromEntries(
  _modules.map(m => [_surfaceKey(m), { artno: m.artno, name: m.name, price: m.price }])
);

// Trappor 40/60 cm — slå upp via artno
const _tillbehor = scenData.tillbehor || [];
const _trapp40 = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0001');
const _trapp60 = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0002');
const INJ_TRAPP_BY_HEIGHT = {
  40: _trapp40 ? { artno: _trapp40.artno, name: _trapp40.name, price: _trapp40.price } : null,
  60: _trapp60 ? { artno: _trapp60.artno, name: _trapp60.name, price: _trapp60.price } : null,
};

// Skyddsräcken — slå upp via artno (för auto-beräkning av säkerhetspaket)
const _rail2m = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0007');
const _rail1m = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0006');
const _railStair = _tillbehor.find(t => t.artno === 'SK-SCN-ACC-0008');
const INJ_RAIL_SEGMENTS = {
  '2m': _rail2m ? { artno: _rail2m.artno, name: _rail2m.name, price: _rail2m.price, monteringMin: _rail2m.monteringMin || 0 } : { artno: 'SK-SCN-ACC-0007', name: 'Skyddsräcke 2,0 m', price: 280, monteringMin: 8 },
  '1m': _rail1m ? { artno: _rail1m.artno, name: _rail1m.name, price: _rail1m.price, monteringMin: _rail1m.monteringMin || 0 } : { artno: 'SK-SCN-ACC-0006', name: 'Skyddsräcke 1,0 m', price: 140, monteringMin: 4 },
  'stair': _railStair ? { artno: _railStair.artno, monteringMin: _railStair.monteringMin || 0 } : { artno: 'SK-SCN-ACC-0008', monteringMin: 8 },
};

// Scenkjol-segment per höjd — fasta längder (20cm=4m, 40cm=2m, 60cm=4m).
// Kortets "+ Scenkjol" packar 3 sidor (fram+höger+vänster) genom att avrunda
// upp löpmeter till hela segment av den valda höjdens segmentlängd.
const _skirts = _tillbehor.filter(t => typeof t.skirtHeight === 'number' && typeof t.segmentMeters === 'number');
const INJ_SKIRT_BY_HEIGHT = Object.fromEntries(
  _skirts.map(s => [s.skirtHeight, { artno: s.artno, name: s.name, price: s.price, segmentMeters: s.segmentMeters }])
);

const INJ_SELECTION_RULES = (tjanster.leverans && tjanster.leverans.selection_rules) || [];

const INJ_MONTERING_MIN_PER_MODULE = (tjanster.montering && typeof tjanster.montering.minPerModul === 'number') ? tjanster.montering.minPerModul : 7.5;

// ──────────────────────────────────────────────────────────────────
// Frakt-priser + montering-pris för "+ Montering X kr & transport Y kr"-noten
// Innehåller alla leverans-nycklar så selection_rules kan slå upp valfri.
// ──────────────────────────────────────────────────────────────────
const _lev = tjanster.leverans || {};
const _LEV_META = new Set(['label', 'description', 'zon', 'selection_rules']);
const INJ_LEVERANS_BY_KEY = Object.fromEntries(
  Object.entries(_lev)
    .filter(([k, v]) => !_LEV_META.has(k) && v && typeof v === 'object' && v.id)
    .map(([k, v]) => [k, { name: v.label || k, pris: v.pris || 0 }])
);
const INJ_MONTERING_PRICE_PER_HOUR = (tjanster.montering && tjanster.montering.prisPerTimme) || 600;
const INJ_MONTERING_ROUND_TO_MIN = (tjanster.montering && typeof tjanster.montering.avrundaTillMin === 'number') ? tjanster.montering.avrundaTillMin : 15;
// Antal tekniker — fysisk tid (assemblyMinutesTotal) oförändrad, men visad kostnad debiteras × bemanning.
const INJ_MONTERING_BEMANNING = (tjanster.montering && typeof tjanster.montering.bemanning === 'number') ? tjanster.montering.bemanning : 1;
---

<article
  class="paket-card"
  id={paket.id}
  data-paket-id={paket.id}
  data-paket-artno={paket.artno}
  data-paket-name={paket.name}
  data-paket-transport={paket.transport}
  data-paket-bulky={paket.bulky === true ? '1' : '0'}
  data-paket-config={JSON.stringify(cfg)}
  itemscope itemtype="https://schema.org/Product"
>
  <div class="paket-image-wrap">
    {useFoto ? (
      <img src={paket.image} alt={paket.alt || paket.name} width="512" height="427" loading="lazy" class="paket-foto" />
    ) : (
      <svg
        class="paket-svg"
        id={svgId}
        data-paket-svg
        viewBox="0 0 400 320"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label={`Visualisering av ${paket.name}`}
      ></svg>
    )}
  </div>
  <meta itemprop="image" content={`https://scenkonsult.se${paket.image || '/images/hero/scen3_hero.webp'}`} />
  <meta itemprop="brand" content="Scenkonsult Norden" />

  <div class="paket-body">
    <p class="paket-tagline">{paket.tagline}</p>
    <h3 class="paket-name" itemprop="name">{paket.name}</h3>
    <p class="paket-artno">{paket.artno}</p>

    <div class="paket-specs">
      <div class="paket-spec-row"><span class="paket-spec-label">Storlek</span><span class="paket-spec-val">{paket.size}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Mått</span><span class="paket-spec-val" data-paket-display-dim>{paket.dimensions}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Höjd</span><span class="paket-spec-val" data-paket-display-height>{cfg.defaultHeight} cm</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Kapacitet</span><span class="paket-spec-val">{paket.capacity}</span></div>
      <div class="paket-spec-row"><span class="paket-spec-label">Transport</span>
        {paket.transport === 'krävs' ? (
          <span class="paket-spec-val paket-spec-warn">Vi levererar – tillkommer</span>
        ) : (
          <span class="paket-spec-val">Tilläggstjänst</span>
        )}
      </div>
    </div>

    <p class="paket-description" itemprop="description">{paket.description}</p>

    <div class="paket-control">
      <span class="paket-control-label">Yta</span>
      <div class="paket-pills" role="radiogroup" aria-label="Yta">
        {cfg.supportedSurfaces.map(s => (
          <button
            type="button"
            class="paket-pill"
            data-yta={s}
            aria-pressed={s === cfg.defaultSurface ? 'true' : 'false'}
          >{SURFACE_LABELS[s]}</button>
        ))}
      </div>
    </div>

    {cfg.heights && cfg.heights.length > 1 && (
      <div class="paket-control">
        <span class="paket-control-label">Höjd</span>
        <div class="paket-pills" role="radiogroup" aria-label="Höjd">
          {cfg.heights.map(h => (
            <button
              type="button"
              class="paket-pill"
              data-height={h}
              aria-pressed={h === cfg.defaultHeight ? 'true' : 'false'}
            >{h} cm</button>
          ))}
        </div>
      </div>
    )}

    <div class="paket-control">
      <span class="paket-control-label">Trappor</span>
      <div class="paket-pills" role="radiogroup" aria-label="Antal trappor">
        {cfg.stairCounts.map(n => (
          <button
            type="button"
            class="paket-pill"
            data-stairs={n}
            aria-pressed={n === cfg.defaultStairCount ? 'true' : 'false'}
          >{n}</button>
        ))}
      </div>
    </div>

    <div class="paket-control">
      <span class="paket-control-label">Tillval</span>
      <div class="paket-pills">
        <button
          type="button"
          class="paket-pill paket-pill-skirt"
          data-paket-skirt
          aria-pressed="false"
          title="Lägg till scenkjol — döljer ben och teknik på 3 sidor (fram, höger, vänster)"
        >+ Scenkjol</button>
        <button
          type="button"
          class="paket-pill paket-pill-rail"
          data-paket-rail
          aria-pressed="false"
          title="Lägg till skyddsräcken — auto-beräknas för bak + sidor utan trappa"
        >+ Räcken</button>
      </div>
    </div>

    <div class="paket-bottom" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      <meta itemprop="priceCurrency" content="SEK" />
      <meta itemprop="price" content={paket.price} />
      <meta itemprop="availability" content="https://schema.org/InStock" />
      <meta itemprop="priceValidUntil" content="2027-12-31" />
      <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
        <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion">
          <meta itemprop="addressCountry" content="SE" />
        </div>
        <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount">
          <meta itemprop="currency" content="SEK" />
          <meta itemprop="value" content="0" />
        </div>
        <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
          <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
          <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" />
            <meta itemprop="maxValue" content="1" />
            <meta itemprop="unitCode" content="DAY" />
          </div>
        </div>
      </div>
      <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
        <meta itemprop="applicableCountry" content="SE" />
        <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
        <meta itemprop="merchantReturnDays" content="1" />
        <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
        <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
      </div>
      <div class="paket-bottom-row">
        <div class="paket-price">
          <span class="sk-price-excl paket-price-num" data-paket-price-excl>{paket.price.toLocaleString('sv-SE')} kr</span>
          <span class="sk-price-incl hidden paket-price-num" data-paket-price-incl>{Math.round(paket.price * 1.25).toLocaleString('sv-SE')} kr</span>
          <span class="paket-price-suffix">/dygn</span>
        </div>
        <button type="button" class="paket-cart-btn" data-paket-add aria-label={`Lägg ${paket.name} i varukorgen`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span data-paket-cart-label>Lägg i varukorg</span>
        </button>
      </div>
      <p class="paket-frakt-note" data-paket-frakt-note></p>
    </div>
    <p class="paket-warning" data-paket-warning hidden></p>
  </div>
</article>

<script define:vars={{ INJ_MOD_BY_KEY, INJ_TRAPP_BY_HEIGHT, INJ_RAIL_SEGMENTS, INJ_SKIRT_BY_HEIGHT, INJ_SELECTION_RULES, INJ_MONTERING_MIN_PER_MODULE, INJ_LEVERANS_BY_KEY, INJ_MONTERING_PRICE_PER_HOUR, INJ_MONTERING_ROUND_TO_MIN, INJ_MONTERING_BEMANNING }}>
  // ──────────────────────────────────────────────────────────────────
  // Konstanter — byggs dynamiskt från JSON via define:vars
  // ──────────────────────────────────────────────────────────────────
  const MOD_PRICE = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.price]));
  const MOD_ARTNO = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.artno]));
  const MOD_NAMES = Object.fromEntries(Object.entries(INJ_MOD_BY_KEY).map(([k,v]) => [k, v.name]));
  const TRAPP = INJ_TRAPP_BY_HEIGHT;
  const RAIL_2M = INJ_RAIL_SEGMENTS['2m'];
  const RAIL_1M = INJ_RAIL_SEGMENTS['1m'];
  const RAIL_STAIR = INJ_RAIL_SEGMENTS['stair'];
  const SKIRT_BY_HEIGHT = INJ_SKIRT_BY_HEIGHT;
  const MODULE_MONTERING_MIN = INJ_MONTERING_MIN_PER_MODULE;

  function fmt(n) { return Math.round(n).toLocaleString('sv-SE') + ' kr'; }

  // ──────────────────────────────────────────────────────────────────
  // Scenkjol-paket. Per-sida-regel mot räcken:
  //   - Endast kjol vald → fram + höger + vänster = width + 2×depth löpmeter
  //   - Kjol OCH räcken valda → kjol ENBART fram (width), räcken tar h/v/bak
  // Antal segment avrundas UPP till hela segment av höjdens segmentlängd
  // (20cm=4m, 40cm=2m, 60cm=4m). Returnerar null om ingen kjol finns.
  // ──────────────────────────────────────────────────────────────────
  function computeSkirtPack(width, depth, height, railAlso) {
    const seg = SKIRT_BY_HEIGHT[height];
    if (!seg) return null;
    const meters = railAlso ? width : (width + 2 * depth);
    const count = Math.ceil(meters / seg.segmentMeters);
    return {
      artno: seg.artno,
      name: seg.name,
      price: seg.price,
      count,
      meters,
      segmentMeters: seg.segmentMeters,
      sides: railAlso ? 'fram' : 'fram + höger + vänster',
      totalPrice: count * seg.price,
    };
  }

  // Packa räcken: greedy 2m först, sedan 1m. Sidor < 1m → inget räcke.
  function packRail(meters) {
    if (meters < 1) return { count20: 0, count10: 0 };
    let remaining = meters;
    let c20 = 0, c10 = 0;
    while (remaining >= 2 - 0.001) { c20++; remaining -= 2; }
    while (remaining >= 1 - 0.001) { c10++; remaining -= 1; }
    return { count20: c20, count10: c10 };
  }

  // "Säkerhetspaket" för paketkort: skyddsräcken på sidor utan trappa
  // PLUS räcken på själva trapporna (SK-SCN-ACC-0008, 200 kr × antal trappor).
  // Per-sida-regel mot scenkjol: om skirtAlso=true tar scenkjolen FRAM, så
  // räcken läggs ENDAST på bak + höger + vänster (fram exkluderas helt).
  //
  // Sidlogik (stairs antas på fram, sedan bak):
  //   skirtAlso=false:
  //     0 trappor → fram + bak + 2 sidor
  //     1 trappa  → bak + 2 sidor (fram har trappa)
  //     2 trappor → 2 sidor (fram + bak har trappor)
  //   skirtAlso=true (fram = kjol, aldrig räcke):
  //     0–1 trappor → bak + 2 sidor
  //     2 trappor   → 2 sidor (bak har trappa)
  // Returnerar { count20, count10, stairRailCount, totalPrice }.
  function computeRailPack(width, depth, stairs, skirtAlso) {
    const sides = [];
    if (skirtAlso) {
      // Fram tillhör scenkjolen → aldrig räcke på fram.
      if (stairs <= 1) sides.push(width, depth, depth);   // bak + 2 sidor
      else sides.push(depth, depth);                       // bak har trappa → 2 sidor
    } else {
      if (stairs === 0) sides.push(width, width, depth, depth);
      else if (stairs === 1) sides.push(width, depth, depth);
      else sides.push(depth, depth);
    }
    let c20 = 0, c10 = 0;
    sides.forEach(len => {
      const p = packRail(len);
      c20 += p.count20;
      c10 += p.count10;
    });
    const stairRailCount = stairs; // ett par räcken per trappa, 200 kr/styck
    const total = c20 * RAIL_2M.price + c10 * RAIL_1M.price + stairRailCount * 200;
    return { count20: c20, count10: c10, stairRailCount, totalPrice: total };
  }

  function moduleCount(w, d, surface) {
    const area = w * d;
    return surface === '1x1-halkfri' ? area : Math.floor(area / 2);
  }

  function isSurfaceValid(w, d, surface) {
    if (surface === '1x1-halkfri') return w * d <= 20;
    // 1×2 kräver att minst en dimension är jämn
    return (w % 2 === 0) || (d % 2 === 0);
  }

  // Alla giltiga formationer (w×d) för en given yta + yt-typ, inom
  // konfiguratorns mått-gränser (bredd 2–12 m, djup 2–8 m). Bevarar ytan
  // (= samma pris). 1×1 begränsas till ≤20 m²; 1×2 kräver jämn sida.
  // Sorteras "närmast kvadratiskt först" så de mest naturliga visas vänster.
  function validFormations(area, surface) {
    const out = [];
    for (let w = 2; w <= 12; w++) {
      for (let d = 2; d <= 8; d++) {
        if (w * d !== area) continue;
        if (!isSurfaceValid(w, d, surface)) continue;
        out.push([w, d]);
      }
    }
    out.sort((a, b) => Math.abs(a[0] - a[1]) - Math.abs(b[0] - b[1]) || b[0] - a[0]);
    return out;
  }

  function computePrice(cfg, surface, stairs, height, rail, skirt) {
    if (!isSurfaceValid(cfg.width, cfg.depth, surface)) return null;
    const mc = moduleCount(cfg.width, cfg.depth, surface);
    const useHeight = height ?? cfg.defaultHeight;
    const stairPrice = TRAPP[useHeight]?.price || 0;
    let price = mc * MOD_PRICE[surface] + stairs * stairPrice;
    if (cfg.tak) price += cfg.tak.price;
    if (rail) {
      price += computeRailPack(cfg.width, cfg.depth, stairs, skirt).totalPrice;
    }
    if (skirt) {
      const sp = computeSkirtPack(cfg.width, cfg.depth, useHeight, rail);
      if (sp) price += sp.totalPrice;
    }
    return price;
  }

  // Simulera samma selection_rules-logik som varukorgen, men för ett ensamt
  // paket. modCount = antal modul-rader (qty), hasTak = om paketet har tak.
  // Alla scen-moduler är bulky=true → bidrar 1 per modul till bulkyCount.
  // Tak räknas som +1 ytterligare bulky-rad.
  function getRecommendedFrakt(modCount, hasTak) {
    const bulkyCount = (modCount || 0) + (hasTak ? 1 : 0);
    for (const rule of INJ_SELECTION_RULES) {
      if (rule.if === 'anyItemForces') {
        // Ej tillämpbart för standalone paket-kort (hanteras av forceLeverans-arg)
        continue;
      } else if (rule.if === 'bulkyCount') {
        const min = rule.min || 1;
        if (bulkyCount >= min && INJ_LEVERANS_BY_KEY[rule.use]) return rule.use;
      } else if (rule.if === 'default') {
        return rule.use;
      }
    }
    return 'standard';
  }

  // ──────────────────────────────────────────────────────────────────
  // Montering + transport-not — "+ Montering X kr (Y h) & transport Z kr ..."
  // Identiskt mönster som LED-vägg-sidan: monteringstid avrundad uppåt till
  // närmaste 30 min, kostnad = h × prisPerTimme.
  // ──────────────────────────────────────────────────────────────────
  function computeMonteringMin(modCount, takMonteringMin, railPack) {
    // Modul-rad: modCount × 7,5 min × 2 (montering + demontering)
    let total = modCount * MODULE_MONTERING_MIN * 2;
    // Tak (om paketet har) — också × 2 för montering+demontering
    if (takMonteringMin) total += takMonteringMin * 2;
    // Räcken (om valda) — count20/count10/stairRailCount × respektive monteringMin × 2
    if (railPack) {
      const railMin =
        (railPack.count20 || 0) * RAIL_2M.monteringMin +
        (railPack.count10 || 0) * RAIL_1M.monteringMin +
        (railPack.stairRailCount || 0) * RAIL_STAIR.monteringMin;
      total += railMin * 2;
    }
    // Avrunda upp till närmaste 30 min
    const step = INJ_MONTERING_ROUND_TO_MIN;
    return Math.ceil(total / step) * step;
  }

  function formatHours(min) {
    const h = min / 60;
    // Hela timmar utan decimal, annars 1 decimal med komma (sv-format)
    if (Number.isInteger(h)) return h + ' h';
    return h.toFixed(1).replace('.', ',') + ' h';
  }

  function computeFraktDetails(modCount, hasTak, forceLeverans) {
    const key = forceLeverans || getRecommendedFrakt(modCount, hasTak);
    const lev = INJ_LEVERANS_BY_KEY[key] || INJ_LEVERANS_BY_KEY.storbil_slap || INJ_LEVERANS_BY_KEY.standard;
    return { key, name: lev.name, pris: lev.pris };
  }

  // ──────────────────────────────────────────────────────────────────
  // SVG-rendering: top-down 2D av scen + trappor (samma stil som konfiguratorn)
  // ──────────────────────────────────────────────────────────────────
  function drawPaketSvg(svgEl, cfg, surface, stairs) {
    const { width: w, depth: d } = cfg;
    const padX = 60, padY = 60;
    const vw = 400, vh = 320;
    // Reservera 30px nedtill för formationschips om fler än en formation finns.
    const hasFormChips = validFormations(w * d, surface).length > 1;
    const chipReserve = hasFormChips ? 34 : 0;
    const maxW = vw - 2 * padX;
    const maxH = vh - 2 * padY - 30 - chipReserve; // utrymme för trappa + chips under
    const scale = Math.min(maxW / w, maxH / d);
    const stageW = w * scale;
    const stageD = d * scale;
    const x0 = (vw - stageW) / 2;
    const y0 = (vh - stageD) / 2 - 8 - (chipReserve / 2);

    const svgIdSafe = svgEl.id || 'pkt';
    const isHalkfri = surface.includes('halkfri');
    const moduleFill = isHalkfri ? `url(#patHalkfri-${svgIdSafe})` : '#3a3370';

    let html = '';
    if (isHalkfri) {
      html += `<defs><pattern id="patHalkfri-${svgIdSafe}" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)"><rect width="6" height="6" fill="#3a3370"/><line x1="0" y1="0" x2="0" y2="6" stroke="#5a4ea0" stroke-width="1.2"/></pattern></defs>`;
    }

    // Skugga
    const sh = 5;
    html += `<rect x="${x0 + sh}" y="${y0 + sh}" width="${stageW}" height="${stageD}" fill="rgba(0,0,0,0.4)" rx="2"/>`;

    // Scenens topp
    html += `<rect x="${x0}" y="${y0}" width="${stageW}" height="${stageD}" fill="${moduleFill}" stroke="#c4b5f4" stroke-width="1.5" rx="2"/>`;

    // Modulrutnät
    if (surface === '1x1-halkfri') {
      for (let i = 1; i < w; i++) {
        const x = x0 + i * scale;
        html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
      }
      for (let j = 1; j < d; j++) {
        const y = y0 + j * scale;
        html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
      }
    } else {
      // 1×2: orientera moduler så att den jämna sidan får 2-uppdelning
      const horiz = (w % 2 === 0); // 2m längs bredden
      if (horiz) {
        for (let i = 2; i < w; i += 2) {
          const x = x0 + i * scale;
          html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
        for (let j = 1; j < d; j++) {
          const y = y0 + j * scale;
          html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
      } else {
        for (let i = 1; i < w; i++) {
          const x = x0 + i * scale;
          html += `<line x1="${x}" y1="${y0}" x2="${x}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
        for (let j = 2; j < d; j += 2) {
          const y = y0 + j * scale;
          html += `<line x1="${x0}" y1="${y}" x2="${x0 + stageW}" y2="${y}" stroke="#c4b5f4" stroke-width="0.6" opacity="0.45"/>`;
        }
      }
    }

    // Trappor — alltid längs framsidan (botten i SVG)
    const sw = Math.min(stageW, stageD) * 0.18;
    const sd = sw * 0.7;
    const placements = stairs === 1 ? [0.5] : stairs === 2 ? [0.3, 0.7] : [];
    placements.forEach(frac => {
      const sx = x0 + stageW * frac - sw / 2;
      const sy = y0 + stageD;
      html += `<g><rect x="${sx}" y="${sy}" width="${sw}" height="${sd}" fill="#2d2670" stroke="#c4b5f4" stroke-width="1" rx="2"/>`;
      for (let i = 1; i < 4; i++) {
        const ly = sy + (sd * i / 4);
        html += `<line x1="${sx + 2}" y1="${ly}" x2="${sx + sw - 2}" y2="${ly}" stroke="#c4b5f4" stroke-width="0.8" stroke-opacity="0.7"/>`;
      }
      html += `</g>`;
    });

    // "Tak"-symbol om paket har tak — markering ovanpå scenen
    if (cfg.tak) {
      const tx = x0 + stageW / 2;
      const ty = y0 - 14;
      html += `<g opacity="0.8">`;
      html += `<text x="${tx}" y="${ty}" text-anchor="middle" fill="#c4b5f4" font-family="Space Grotesk,sans-serif" font-size="11" font-weight="700" letter-spacing="1">↑ MED TAK</text>`;
      html += `</g>`;
    }

    // ── Formationsknappar (lavendel) — alla giltiga w×d för aktuell yta + yt-typ.
    // Bevarar ytan (samma pris). Ritas som en rad chips längst ner i skissen.
    // Klick hanteras via event-delegation på svgEl (data-fw/data-fd).
    const forms = validFormations(w * d, surface);
    if (forms.length > 1) {
      const chipH = 22, chipPadX = 9, gap = 6, fontSize = 12;
      // Grov bredduppskattning per chip (monospace-ish): tecken × ~7px + padding.
      const chipW = (label) => Math.max(34, label.length * 7 + chipPadX * 2);
      const labels = forms.map(([fw, fd]) => `${fw}×${fd}`);
      const widths = labels.map(chipW);
      const totalW = widths.reduce((s, x) => s + x, 0) + gap * (forms.length - 1);
      let cx = (vw - totalW) / 2;
      const cy = vh - chipH - 6;
      html += `<g font-family="Space Grotesk,sans-serif" font-size="${fontSize}" font-weight="600">`;
      forms.forEach(([fw, fd], i) => {
        const cwi = widths[i];
        const active = (fw === w && fd === d);
        const fill = active ? '#c4b5f4' : 'rgba(196,181,244,0.14)';
        const stroke = active ? '#c4b5f4' : 'rgba(196,181,244,0.55)';
        const textFill = active ? '#0c0a24' : '#c4b5f4';
        html += `<g class="paket-form-chip" data-fw="${fw}" data-fd="${fd}" style="cursor:pointer">`;
        html += `<rect x="${cx}" y="${cy}" width="${cwi}" height="${chipH}" rx="11" fill="${fill}" stroke="${stroke}" stroke-width="1.2"/>`;
        html += `<text x="${cx + cwi / 2}" y="${cy + chipH / 2 + 4}" text-anchor="middle" fill="${textFill}" pointer-events="none">${labels[i]}</text>`;
        html += `</g>`;
        cx += cwi + gap;
      });
      html += `</g>`;
    }

    svgEl.innerHTML = html;
  }

  // ──────────────────────────────────────────────────────────────────
  // Init varje kort
  // ──────────────────────────────────────────────────────────────────
  function initPaketCard(card) {
    // Idempotent: skydda mot att initPaketCard anropas flera gånger på samma kort.
    // Astro-script med define:vars renderas per komponent-instans (12 paket =
    // 12 inline-scripts), och varje script kör querySelectorAll('.paket-card').forEach.
    // Utan denna guard registreras click-handlers N gånger → ett klick = N add-calls.
    if (card.dataset.paketInitialized === '1') return;
    card.dataset.paketInitialized = '1';

    const cfg = JSON.parse(card.dataset.paketConfig || '{}');
    const paketName = card.dataset.paketName;
    let surface = cfg.defaultSurface;
    let stairs = cfg.defaultStairCount;
    let height = cfg.defaultHeight;
    let rail = false;
    let skirt = false;

    // 1×1-yta: 20 cm-ben och skyddsräcken är ej tillgängliga (bara 1×2 har 20cm-ben;
    // räcken monteras ej på 1×1-podier). Höjd 20 visas/tillåts endast på 1×2-ytor.
    const is1x1 = (s) => s === '1x1-halkfri';

    const svgEl = card.querySelector('[data-paket-svg]');
    const priceExcl = card.querySelector('[data-paket-price-excl]');
    const priceIncl = card.querySelector('[data-paket-price-incl]');
    const heightDisplay = card.querySelector('[data-paket-display-height]');
    const cartBtn = card.querySelector('[data-paket-add]');
    const cartLabel = card.querySelector('[data-paket-cart-label]');
    const warning = card.querySelector('[data-paket-warning]');
    const fraktNoteEl = card.querySelector('[data-paket-frakt-note]');

    function update() {
      // Yta-beroende regler:
      // - 20 cm-höjd: endast 1×2-ytor. På 1×1 → fall tillbaka till 40.
      // - Räcken + Scenkjol-knappar kan ha sina egna gating-regler nedan.
      if (is1x1(surface) && height === 20) {
        height = (cfg.heights || []).includes(40) ? 40 : (cfg.defaultHeight || 40);
      }
      // Räcken ej tillgängligt på 1×1 → nollställ om aktivt.
      if (is1x1(surface) && rail) rail = false;

      const price = computePrice(cfg, surface, stairs, height, rail, skirt);

      // Disable invalid surfaces
      card.querySelectorAll('[data-yta]').forEach(b => {
        const valid = isSurfaceValid(cfg.width, cfg.depth, b.dataset.yta);
        if (!valid) {
          b.classList.add('paket-pill-disabled');
          b.disabled = true;
          b.title = b.dataset.yta === '1x1-halkfri' ? `1×1-yta stöder max 20 m² (paketet är ${cfg.width * cfg.depth} m²)` : 'Kräver att en dimension är jämn';
        } else {
          b.classList.remove('paket-pill-disabled');
          b.disabled = false;
          b.title = '';
        }
      });

      if (price === null) {
        priceExcl.textContent = '—';
        priceIncl.textContent = '—';
        cartBtn.disabled = true;
        warning.hidden = false;
        warning.textContent = 'Vald yta är inte kompatibel med paketets mått.';
      } else {
        priceExcl.textContent = price.toLocaleString('sv-SE') + ' kr';
        priceIncl.textContent = Math.round(price * 1.25).toLocaleString('sv-SE') + ' kr';
        cartBtn.disabled = false;
        warning.hidden = true;
      }

      if (heightDisplay) heightDisplay.textContent = height + ' cm';
      const dimDisplay = card.querySelector('[data-paket-display-dim]');
      if (dimDisplay) dimDisplay.textContent = `${cfg.width}×${cfg.depth} m`;

      // Frakt-note: "+ Montering X kr (Y h) & transport Z kr (Fordon) tillkommer i kassan"
      // Krävs-paket: matter-of-fact ("+ ...")
      // Tillägg-paket: optional ("Vid leverans: + ...")
      if (fraktNoteEl) {
        if (price === null) {
          fraktNoteEl.textContent = '';
        } else {
          const mc = moduleCount(cfg.width, cfg.depth, surface);
          const takMonteringMin = cfg.tak ? (cfg.tak.monteringMin || 0) : 0;
          const railPack = rail ? computeRailPack(cfg.width, cfg.depth, stairs, skirt) : null;
          const monteringMin = computeMonteringMin(mc, takMonteringMin, railPack);
          const monteringKr = Math.round((monteringMin / 60) * INJ_MONTERING_PRICE_PER_HOUR) * INJ_MONTERING_BEMANNING;
          const frakt = computeFraktDetails(mc, !!cfg.tak, cfg.forceLeverans);
          const transport = card.dataset.paketTransport;
          const prefix = transport === 'krävs' ? '+ ' : 'Vid leverans: + ';
          const mE = fmt(monteringKr), mI = fmt(Math.round(monteringKr * 1.25));
          const tE = fmt(frakt.pris),  tI = fmt(Math.round(frakt.pris * 1.25));
          fraktNoteEl.innerHTML =
            prefix +
            'Montering &amp; demontering ' +
            '<span><span class="sk-price-excl">' + mE + '</span><span class="sk-price-incl hidden">' + mI + '</span></span>' +
            ' (' + formatHours(monteringMin) + ') ' +
            '&amp; transport ' +
            '<span><span class="sk-price-excl">' + tE + '</span><span class="sk-price-incl hidden">' + tI + '</span></span>' +
            ' (' + frakt.name + ') tillkommer i kassan';
          if (window.skApplyVat) window.skApplyVat();
        }
      }

      // Pressed-states
      card.querySelectorAll('[data-yta]').forEach(b => {
        b.setAttribute('aria-pressed', b.dataset.yta === surface ? 'true' : 'false');
      });
      card.querySelectorAll('[data-stairs]').forEach(b => {
        b.setAttribute('aria-pressed', String(parseInt(b.dataset.stairs)) === String(stairs) ? 'true' : 'false');
      });
      card.querySelectorAll('[data-height]').forEach(b => {
        const h = parseInt(b.dataset.height);
        // 20 cm endast på 1×2-ytor — inaktivera pillen på 1×1.
        if (h === 20) {
          const disabled = is1x1(surface);
          b.disabled = disabled;
          b.classList.toggle('paket-pill-disabled', disabled);
          b.title = disabled ? '20 cm finns endast för 1×2 m-podier' : '';
        }
        b.setAttribute('aria-pressed', h === height ? 'true' : 'false');
      });
      const railBtn = card.querySelector('[data-paket-rail]');
      if (railBtn) {
        // Räcken ej på 1×1-podier
        const railDisabled = is1x1(surface);
        railBtn.disabled = railDisabled;
        railBtn.classList.toggle('paket-pill-disabled', railDisabled);
        railBtn.setAttribute('aria-pressed', rail ? 'true' : 'false');
        if (railDisabled) {
          railBtn.title = 'Skyddsräcken monteras ej på 1×1 m-podier';
        } else {
          // Dynamisk tooltip som beskriver exakt vad säkerhetspaketet innehåller.
          // När scenkjol också är vald tar kjolen FRAM → räcken bak + sidor.
          const pack = computeRailPack(cfg.width, cfg.depth, stairs, skirt);
          const sidesTxt = skirt
            ? (stairs >= 2 ? 'båda sidor' : 'bak + båda sidor')
            : (stairs === 0 ? 'alla 4 sidor' : stairs === 1 ? 'bak + båda sidor' : 'båda sidor');
          const railSegTxt = pack.count20 > 0 || pack.count10 > 0
            ? `skyddsräcken (${pack.count20}×2m${pack.count10 > 0 ? ' + ' + pack.count10 + '×1m' : ''}) längs ${sidesTxt}`
            : 'skyddsräcken';
          const stairRailTxt = pack.stairRailCount > 0
            ? ` + räcken till ${pack.stairRailCount} trappa${pack.stairRailCount > 1 ? 'or' : ''}`
            : '';
          railBtn.title = `Säkerhetspaket: ${railSegTxt}${stairRailTxt} — totalt ${fmt(pack.totalPrice)}`;
        }
      }
      const skirtBtn = card.querySelector('[data-paket-skirt]');
      if (skirtBtn) {
        const sp = computeSkirtPack(cfg.width, cfg.depth, height, rail);
        // Inaktivera om ingen kjol finns för vald höjd
        const skirtDisabled = !sp;
        skirtBtn.disabled = skirtDisabled;
        skirtBtn.classList.toggle('paket-pill-disabled', skirtDisabled);
        skirtBtn.setAttribute('aria-pressed', skirt ? 'true' : 'false');
        if (skirtDisabled) {
          skirtBtn.title = 'Scenkjol saknas för vald höjd';
        } else {
          skirtBtn.title = `Scenkjol ${height} cm — ${sp.sides} (${sp.meters} m) → ${sp.count}×${sp.name} = ${fmt(sp.totalPrice)}`;
        }
      }

      if (svgEl) drawPaketSvg(svgEl, cfg, surface, stairs);
    }

    card.querySelectorAll('[data-yta]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        surface = btn.dataset.yta;
        update();
      });
    });
    card.querySelectorAll('[data-stairs]').forEach(btn => {
      btn.addEventListener('click', () => {
        stairs = parseInt(btn.dataset.stairs);
        update();
      });
    });
    card.querySelectorAll('[data-height]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        height = parseInt(btn.dataset.height);
        update();
      });
    });
    const railBtn = card.querySelector('[data-paket-rail]');
    if (railBtn) {
      railBtn.addEventListener('click', () => {
        if (railBtn.disabled) return;
        rail = !rail;
        update();
      });
    }
    const skirtBtn = card.querySelector('[data-paket-skirt]');
    if (skirtBtn) {
      skirtBtn.addEventListener('click', () => {
        if (skirtBtn.disabled) return;
        skirt = !skirt;
        update();
      });
    }

    // Formationsknappar i SVG-skissen (event-delegation — SVG ritas om vid varje
    // update() så per-element-listeners skulle försvinna). Byter cfg.width/depth
    // med bibehållen yta → pris stabilt, frakt/montering/skiss räknas om.
    if (svgEl) {
      svgEl.addEventListener('click', (e) => {
        const chip = e.target.closest('.paket-form-chip');
        if (!chip) return;
        const fw = parseInt(chip.dataset.fw, 10);
        const fd = parseInt(chip.dataset.fd, 10);
        if (!fw || !fd) return;
        if (fw === cfg.width && fd === cfg.depth) return;
        cfg.width = fw;
        cfg.depth = fd;
        update();
      });
    }

    cartBtn?.addEventListener('click', () => {
      if (!window.skCart || cartBtn.disabled) return;
      const mc = moduleCount(cfg.width, cfg.depth, surface);
      const transport = card.dataset.paketTransport;
      const isKravs = transport === 'krävs';
      // bulky läses från JSON-flaggan paket.bulky (data-paket-bulky="1") — INTE
      // härlett från transport. Det innebär att ett 'tillägg'-paket fortfarande
      // räknas som skrymmande gods när kunden väljer leverans i kundkorgen, så
      // fraktregeln "bulkyCount >= 1 → Bil med släp" matchar korrekt.
      const isBulky = card.dataset.paketBulky === '1';
      // Krävs: forceLeverans (override eller auto-rekommenderat fordon)
      // Tillägg: ingen forceLeverans → kunden får välja själv i varukorgen
      const lev = isKravs ? (cfg.forceLeverans || getRecommendedFrakt(mc, !!cfg.tak)) : null;

      // Option 1: hela scenens monteringstid räknas EN gång (moduler + tak + räcken,
      // alla × 2 för montering + demontering) och stämplas som assemblyMinutesTotal
      // på modul-raden. Checkout läser detta verbatim (ingen golvning, ingen × qty)
      // → kortets visade tid == debiterad tid by design. Per-item monteringMin sätts
      // INTE på modul/tak/räcke-rader (skulle dubbelräknas + golvas av checkout).
      const takMonteringMinAdd = cfg.tak ? (cfg.tak.monteringMin || 0) : 0;
      const railPackAdd = rail ? computeRailPack(cfg.width, cfg.depth, stairs, skirt) : null;
      const sceneAssemblyMin = computeMonteringMin(mc, takMonteringMinAdd, railPackAdd);

      // skCart.add merger qty på existing item-id men SÄTTER INTE flaggor på en
      // existerande rad. För att flaggor (bulky/requiresAssembly/forceLeverans/
      // monteringMin) garanterat hamnar på storage-itemet, applicera dem direkt
      // efter add-anropet via skCart.get/save.
      function applyFlagsTo(itemId, flags) {
        try {
          const c = window.skCart.get();
          const stored = c.find(i => i.id === itemId);
          if (stored) {
            Object.assign(stored, flags);
            window.skCart.save(c);
          }
        } catch (e) { /* tyst — flaggor är best-effort */ }
      }

      // Modul-rad.
      // - bulky: sätts från JSON-flaggan paket.bulky (oavsett transport) —
      //   används av fraktregeln "bulkyCount >= 1 → Bil med släp" när
      //   kunden VÄLJER leverans. Triggar INTE auto-bock av leverans i varukorgen.
      // - requiresAssembly + forceLeverans: bara om paketet kräver transport.
      //   Dessa flaggor är "transport krävs"-signaler och triggar auto-bock.
      const modItem = {
        id: MOD_ARTNO[surface],
        artno: MOD_ARTNO[surface],
        name: `${MOD_NAMES[surface]} — ${paketName} (${cfg.width}×${cfg.depth} m)`,
        price: MOD_PRICE[surface],
        qty: mc,
        category: 'Scen',
        assemblyMinutesTotal: sceneAssemblyMin, // hela scenens monteringstid (en gång)
      };
      if (isBulky) {
        modItem.bulky = true;
      }
      if (isKravs) {
        modItem.requiresAssembly = true;
        if (lev) modItem.forceLeverans = lev;
      }
      window.skCart.add(modItem);
      // Säkerställ flaggor även om itemet redan fanns i cart (merge-bug-skydd)
      const modFlags = { assemblyMinutesTotal: sceneAssemblyMin };
      if (isBulky) modFlags.bulky = true;
      if (isKravs) {
        modFlags.requiresAssembly = true;
        if (lev) modFlags.forceLeverans = lev;
      }
      applyFlagsTo(modItem.id, modFlags);

      // Trapp-rader (om kunden valt > 0) — använd vald höjd, inte cfg.defaultHeight
      if (stairs > 0) {
        const t = TRAPP[height];
        if (t) {
          window.skCart.add({
            id: t.artno,
            artno: t.artno,
            name: `${t.name} — ${paketName}`,
            price: t.price,
            qty: stairs,
            category: 'Scen tillbehör',
          });
        }
      }

      // Säkerhetspaket — skyddsräcken på sidor utan trappa (+ trapp-räcken).
      // Om scenkjol också vald tar kjolen FRAM → räcken bak + sidor.
      if (rail) {
        const pack = computeRailPack(cfg.width, cfg.depth, stairs, skirt);
        if (pack.count20 > 0) {
          window.skCart.add({
            id: RAIL_2M.artno,
            artno: RAIL_2M.artno,
            name: `${RAIL_2M.name} — ${paketName}`,
            price: RAIL_2M.price,
            qty: pack.count20,
            category: 'Scen tillbehör',
          });
        }
        if (pack.count10 > 0) {
          window.skCart.add({
            id: RAIL_1M.artno,
            artno: RAIL_1M.artno,
            name: `${RAIL_1M.name} — ${paketName}`,
            price: RAIL_1M.price,
            qty: pack.count10,
            category: 'Scen tillbehör',
          });
        }
        if (pack.stairRailCount > 0) {
          window.skCart.add({
            id: 'SK-SCN-ACC-0008',
            artno: 'SK-SCN-ACC-0008',
            name: `Räcke till scentrapp (40/60 cm) — ${paketName}`,
            price: 200,
            qty: pack.stairRailCount,
            category: 'Scen tillbehör',
          });
        }
      }

      // Scenkjol — fasta segment per höjd. Per-sida-regel mot räcken:
      // endast kjol → fram+höger+vänster; kjol OCH räcken → kjol enbart fram.
      if (skirt) {
        const sp = computeSkirtPack(cfg.width, cfg.depth, height, rail);
        if (sp && sp.count > 0) {
          window.skCart.add({
            id: sp.artno,
            artno: sp.artno,
            name: `${sp.name} — ${paketName}`,
            price: sp.price,
            qty: sp.count,
            category: 'Scen tillbehör',
          });
        }
      }

      // Tak-paket — alltid bulky/montering eftersom tak är skrymmande och tar tid
      if (cfg.tak) {
        const takItem = {
          id: cfg.tak.artno,
          artno: cfg.tak.artno,
          name: `${cfg.tak.name} — ${paketName}`,
          price: cfg.tak.price,
          qty: 1,
          category: 'Scen tillbehör',
          bulky: true,
          requiresAssembly: true,
          // monteringMin sätts EJ — taktiden ingår redan i modul-radens assemblyMinutesTotal.
        };
        // Om paketet har forceLeverans-override på sig (Large+ tak: lastbil),
        // sätt det på tak-raden också så att 'lastbil' definitivt vinner i cart
        if (cfg.forceLeverans) takItem.forceLeverans = cfg.forceLeverans;
        window.skCart.add(takItem);
        // Säkerställ flaggor även vid merge
        const takFlags = {
          bulky: true,
          requiresAssembly: true,
        };
        if (cfg.forceLeverans) takFlags.forceLeverans = cfg.forceLeverans;
        applyFlagsTo(cfg.tak.artno, takFlags);
      }

      if (cartLabel) {
        const original = cartLabel.textContent;
        cartLabel.textContent = '✓ Lagt till!';
        cartBtn.classList.add('paket-cart-btn-success');
        setTimeout(() => {
          cartLabel.textContent = original;
          cartBtn.classList.remove('paket-cart-btn-success');
        }, 1800);
      }
    });

    update();
  }

  // Init alla paket-kort på sidan
  document.querySelectorAll('.paket-card').forEach(initPaketCard);
</script>

