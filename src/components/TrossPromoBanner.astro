---
/**
 * TrossPromoBanner — kampanjbanner för "LED-vägg på Trossystem" (SK-BLD-0013).
 * Återanvänds på /hyra-bild-projektorer-skarmar/ och /hyra-bild-led-vagg/.
 *
 * "Boka nu" splittar priset i tre rader (Paneler · Bildprocessor · Tross) via
 * window.skCart.add — exakt samma mekanism som LED-vägg-konfiguratorn — och
 * summan blir produktens pris (11 999). Bokningsavgift (+49) läggs av varukorgen.
 *
 * Pris, bilder och cart-split läses ur src/data/bild.json (JSON-first).
 */
import bildData from '../data/bild.json';

const p = (bildData.products as any[]).find((x: any) => x.artno === 'SK-BLD-0013');
const imgs: string[] = p?.images ?? (p ? [p.image] : []);
const inkl = (n: number) => Math.round(n * 1.25);
---

{p && (
<div class="tross-promo">
  <div class="tross-promo-media" aria-roledescription="bildkarusell" aria-label="LED-vägg på trossystem">
    <span class="tross-promo-tag">★ Kampanj</span>
    <div class="tross-promo-track">
      {imgs.map((src: string, i: number) => (
        <div class:list={["tross-slide", { "is-active": i === 0 }]}>
          <img src={src} alt={p.alt} loading="lazy" width="800" height="667" class="w-full h-full object-cover" />
        </div>
      ))}
    </div>
    {imgs.length > 1 && (
      <div class="tross-dots" role="tablist" aria-label="Välj bild">
        {imgs.map((_: string, i: number) => (
          <button class:list={["tross-dot", { "is-active": i === 0 }]} data-tross-dot={i} aria-label={`Bild ${i + 1}`}></button>
        ))}
      </div>
    )}
  </div>

  <div class="tross-promo-body">
    <span class="tross-promo-eyebrow">Storbild på tross · Inomhus</span>
    <h2 class="tross-promo-title">LED-vägg på Trossystem</h2>
    <p class="tross-promo-desc">
      Sömlös <strong>3,27 m²</strong> bildyta utan skarvar — en obruten yta, inte en mosaik av tv-skärmar.
      Med <strong>bild-i-bild</strong> kör du film eller livesändning i mitten och fyller resten med branding.
      Driftklar mediaspelare och snabb frontservice-rigg.
    </p>
    <ul class="tross-promo-specs">
      <li>P2.5 · 2&nbsp;560 × 1&nbsp;280 mm</li>
      <li>800 cd/m² · 3&nbsp;840 Hz</li>
      <li>HDMI live / förladdat</li>
      <li>8 kabinett i flightcase</li>
    </ul>
    <div class="tross-promo-foot">
      <div class="tross-promo-price">
        <span class="tross-price-old">
          <span class="sk-price-excl">{p.priceOrd.toLocaleString('sv')}&nbsp;kr</span>
          <span class="sk-price-incl hidden">{inkl(p.priceOrd).toLocaleString('sv')}&nbsp;kr</span>
        </span>
        <span class="tross-price-now">
          <span class="sk-price-excl">{p.price.toLocaleString('sv')}&nbsp;kr</span>
          <span class="sk-price-incl hidden">{inkl(p.price).toLocaleString('sv')}&nbsp;kr</span>
        </span>
        <span class="tross-price-note">Allt inkluderat — tross, leverans (ToR) och montering/demontering.</span>
      </div>
      <button class="tross-promo-cta" aria-label="Boka LED-vägg på trossystem">
        <svg class="sk-cart-icon-add shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <svg class="sk-cart-icon-check shrink-0 hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="sk-cart-btn-label">Boka nu</span>
      </button>
    </div>
  </div>
</div>
)}

<style>
  .tross-promo {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) 1fr;
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, #2a1f6b 0%, #1e1850 55%, #0c0a24 100%);
    border: 1px solid rgba(196, 181, 244, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .tross-promo:hover {
    border-color: rgba(196, 181, 244, 0.45);
    box-shadow: 0 12px 44px rgba(196, 181, 244, 0.12);
  }
  @media (max-width: 768px) { .tross-promo { grid-template-columns: 1fr; } }
  .tross-promo-media { position: relative; background: #0c0a24; min-height: 360px; overflow: hidden; }
  @media (max-width: 768px) { .tross-promo-media { min-height: 220px; } }
  .tross-promo-track { position: absolute; inset: 0; }
  .tross-slide { position: absolute; inset: 0; opacity: 0; transition: opacity 0.8s ease; }
  .tross-slide.is-active { opacity: 1; }
  .tross-slide img { object-position: center 45%; }
  .tross-promo-tag {
    position: absolute; top: 14px; left: 14px; z-index: 3;
    background: #0c0a24; color: #e2dcfb;
    border: 1px solid rgba(196, 181, 244, 0.5);
    padding: 0.32rem 0.8rem; border-radius: 99px;
    font-family: 'Space Grotesk', sans-serif; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(12, 10, 36, 0.4);
  }
  .tross-dots { position: absolute; bottom: 12px; left: 0; right: 0; z-index: 3; display: flex; gap: 7px; justify-content: center; }
  .tross-dot { width: 8px; height: 8px; border-radius: 99px; border: none; padding: 0; cursor: pointer; background: rgba(255, 255, 255, 0.4); transition: background 0.3s, width 0.3s; }
  .tross-dot.is-active { background: #c4b5f4; width: 22px; }
  .tross-promo-body { padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; }
  .tross-promo-eyebrow { color: #c4b5f4; font-family: 'Space Grotesk', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem; }
  .tross-promo-title { font-family: 'DM Serif Display', serif; color: white; font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.1; margin: 0 0 0.6rem; }
  .tross-promo-desc { color: rgba(255, 255, 255, 0.72); font-size: 0.9rem; line-height: 1.5; margin: 0 0 0.9rem; }
  .tross-promo-desc strong { color: white; font-weight: 600; }
  .tross-promo-specs { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.9rem; }
  .tross-promo-specs li { color: rgba(255, 255, 255, 0.82); font-size: 0.78rem; padding-left: 1rem; position: relative; }
  .tross-promo-specs li::before { content: "▸"; position: absolute; left: 0; color: #c4b5f4; }
  .tross-promo-foot { margin-top: auto; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 0.9rem; }
  .tross-promo-price { display: flex; flex-direction: column; line-height: 1.1; }
  .tross-price-old { color: rgba(255, 255, 255, 0.45); font-size: 0.85rem; text-decoration: line-through; text-decoration-color: rgba(196, 181, 244, 0.6); }
  .tross-price-now { color: #c4b5f4; font-family: 'DM Serif Display', serif; font-size: 1.9rem; line-height: 1.1; }
  .tross-price-note { color: rgba(255, 255, 255, 0.5); font-size: 0.68rem; margin-top: 0.25rem; max-width: 34ch; }
  .tross-promo-cta { display: inline-flex; align-items: center; gap: 0.55rem; background: #c4b5f4; color: #0c0a24; border: none; padding: 0.8rem 1.4rem; border-radius: 10px; font-family: 'Space Grotesk', sans-serif; font-size: 0.95rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: background 0.2s, transform 0.2s; }
  .tross-promo-cta:hover { background: #e2dcfb; transform: translateY(-2px); }
  .tross-promo-cta.added { background: #4ade80; }
</style>

<script define:vars={{ SPLIT: p?.cartSplit ?? [], FALLBACK_IMG: p?.image ?? '' }}>
  (function () {
    const media = document.querySelector('.tross-promo-media');
    if (media) {
      const slides = media.querySelectorAll('.tross-slide');
      const dots = media.querySelectorAll('.tross-dot');
      let idx = 0, timer = null;
      const show = (n) => {
        idx = (n + slides.length) % slides.length;
        slides.forEach((s, k) => s.classList.toggle('is-active', k === idx));
        dots.forEach((d, k) => d.classList.toggle('is-active', k === idx));
      };
      const start = () => { stop(); if (slides.length > 1) timer = setInterval(() => show(idx + 1), 5000); };
      const stop = () => { if (timer) { clearInterval(timer); timer = null; } };
      dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
      media.addEventListener('mouseenter', stop);
      media.addEventListener('mouseleave', start);
      if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) start();
    }

    const cta = document.querySelector('.tross-promo-cta');
    if (cta) {
      cta.addEventListener('click', () => {
        // Samma mekanism som LED-vägg-konfiguratorn: splitta i panel/processor/tross-rader.
        if (!window.skCart || typeof window.skCart.add !== 'function' || !SPLIT.length) return;
        SPLIT.forEach((row) => {
          window.skCart.add({
            id: row.artno + (row.qty > 1 ? '__' + row.qty : ''),
            artno: row.artno,
            name: row.name,
            price: row.price,
            priceNote: '/dygn',
            category: 'LED-vägg',
            image: row.image || FALLBACK_IMG,
            bulky: !!row.bulky,
            forceLeverans: row.forceLeverans || undefined,
            assemblyMinutesTotal: row.assemblyMinutesTotal || undefined,
            qty: row.qty || 1,
          });
        });
        cta.querySelector('.sk-cart-icon-add')?.classList.add('hidden');
        cta.querySelector('.sk-cart-icon-check')?.classList.remove('hidden');
        cta.classList.add('added');
        const lbl = cta.querySelector('.sk-cart-btn-label');
        if (lbl) lbl.textContent = 'Tillagd ✓';
        setTimeout(() => { window.location.href = '/varukorg/'; }, 650);
      });
    }
  })();
</script>
