---
/**
 * EventBilder.astro — "Från våra event" på en kategorihubb.
 *
 * Raderna kommer ur src/data/event-cases.json (`hub`-delen), som prebuild bygger
 * ur Supabase: event_cases + event_case_images + event_case_hub. Varje kategori
 * har egen bild och egen text för samma uppdrag — ljudhubben lyfter ljudet,
 * ljushubben ljuset. Caset äger fakta, hubben äger vinkeln.
 *
 * `pos` sätter object-position när beskärningen till 4:3 annars tappar motivet.
 * Bilderna är samma filer som på /referenser/ (public/images/event/).
 */
import SectionHeader from './SectionHeader.astro';
import eventCases from '../data/event-cases.json';
import popular from '../data/popular.json';

interface Props {
  kategori: string;   // 'ljud', 'ljus', 'bild', ...
  lead?: string;      // åsidosätter casesLead från konfigurationen
}
const { kategori, lead } = Astro.props;

const items = ((eventCases as any).hub?.[kategori] ?? []) as Array<{
  caseId: string; label: string; descr: string; src: string; alt: string; pos?: string | null;
}>;
const ledtext = lead ?? (popular as Record<string, any>)[kategori]?.casesLead ?? undefined;
---

{items.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <SectionHeader eyebrow="Referenser" h2="Från våra event" lead={ledtext} />
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {items.map((it) => (
        <a href="/referenser/" class="group block bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all">
          <div class="overflow-hidden bg-brand-dark" style="aspect-ratio:4/3">
            <img src={it.src} alt={it.alt} width="800" height="600" loading="lazy" decoding="async" style={it.pos ? `object-position:${it.pos}` : undefined} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-4">
            <p class="font-semibold text-white text-sm leading-snug mb-1">{it.label}</p>
            <p class="text-gray-400 text-xs">{it.descr}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a href="/referenser/" class="text-brand-orange hover:text-white transition-colors text-sm font-semibold">Fler referenser och kundomdömen →</a>
    </div>
  </section>
)}
