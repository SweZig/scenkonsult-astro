---
// Banner på ljud- och ljushubbarna som länkar till kombinationssidan
// /vara-tjanster/hyra-ljud-och-ljus/. Från-priset räknas ur datafilerna.
import config from '../data/ljud-ljus.json';
import ljud from '../data/ljud.json';
import ljus from '../data/ljus.json';
import bild from '../data/bild.json';
import dj from '../data/dj.json';
import scenes from '../data/scenes.json';
import tjanster from '../data/tjanster.json';
import karaoke from '../data/karaoke.json';
import el from '../data/el.json';
import { resolveLjudLjus, minRecommended } from '../lib/ljud-ljus-builder.mjs';
const fran = minRecommended(resolveLjudLjus(config, { ljud, ljus, bild, dj, scenes, tjanster, karaoke, el }));
---
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
  <div class="bg-brand-navy border border-brand-orange/30 rounded-2xl p-6 sm:p-7 flex flex-col sm:flex-row sm:items-center gap-5 justify-between">
    <div>
      <p class="text-brand-orange text-xs font-bold uppercase tracking-widest mb-2" style="font-family:'Space Grotesk',sans-serif">Ljud + ljus i ett paket</p>
      <h2 class="text-white text-2xl mb-2" style="font-family:'DM Serif Display',serif;">Behöver ni både ljud och ljus?</h2>
      <p class="text-gray-400 text-sm m-0">Svara på tre frågor – privat eller företag, hur många ni blir och om fokus är tal eller musik – så sätter vi ihop ett paket. Från <span data-exkl={fran}>{fran.toLocaleString('sv-SE')}</span> kr/dygn.</p>
    </div>
    <a href="/vara-tjanster/hyra-ljud-och-ljus/" class="shrink-0 bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-semibold text-sm px-5 py-3 rounded-xl text-center transition-colors">Hyra ljud och ljus →</a>
  </div>
</section>
