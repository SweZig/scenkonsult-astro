---
/**
 * KunskapBlock — Återanvändbart "Läs mer & förbered dig"-block
 *
 * Samlar guider + Svens Kunskapsskola (videoguider) i ett konsekvent block
 * som ligger på alla kategori- och subkategorisidor. Lyfter fram Sven som
 * Scenkonsults intendent och kunskapsansvarig.
 *
 * Sven-avataren använder den globala SVG-symbolen #mask-glad (def i Layout.astro).
 *
 * Användning:
 *   <KunskapBlock
 *     guides={[{ href:"/for/guider/dmx-styrning-guide/", label:"DMX-styrning — komplett guide" }, ...]}
 *     videos={[{ slug:"led-teknik", label:"LED-teknik — egenskaper och funktioner" }, ...]}
 *   />
 */
interface GuideLink { href: string; label: string; }
interface VideoLink { slug: string; label: string; }

interface Props {
  guides?: GuideLink[];
  videos?: VideoLink[];
  eyebrow?: string;        // default "Läs mer & förbered dig"
  intro?: string;          // valfri introtext under rubriken
  maxWidth?: string;       // wrapper-bredd, default "max-w-7xl"
}

const {
  guides = [],
  videos = [],
  eyebrow = 'Läs mer & förbered dig',
  intro,
  maxWidth = 'max-w-7xl',
} = Astro.props;

const docIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`;
const playIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>`;
---

<section class={`${maxWidth} mx-auto px-4 sm:px-6 lg:px-8 pb-12`}>
  <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;">

    <!-- Sven-intro: intendent & kunskapsansvarig -->
    <div style="display:flex;align-items:flex-start;gap:0.85rem;margin-bottom:1.5rem;">
      <div style="flex-shrink:0;width:44px;height:44px;border-radius:50%;background:rgba(196,181,244,0.12);border:1px solid rgba(196,181,244,0.25);display:flex;align-items:center;justify-content:center;">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><use href="#mask-glad"/></svg>
      </div>
      <div>
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 0.2rem;">{eyebrow}</p>
        <p style="color:rgba(255,255,255,0.72);font-size:0.9rem;line-height:1.6;margin:0;">
          {intro ?? 'Vår intendent Sven ansvarar för all kunskap till dig som kund — guider att läsa och korta videoguider som visar precis hur det fungerar.'}
        </p>
      </div>
    </div>

    <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">

      {guides.length > 0 && (
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Guider</p>
          {guides.map(g => (
            <a href={g.href} style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.72);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.72)'">
              <Fragment set:html={docIcon} />{g.label}
            </a>
          ))}
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      )}

      {videos.length > 0 && (
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
          {videos.map(v => (
            <a href={`/svens-kunskapsskola/#${v.slug}`} style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.72);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.72)'">
              <Fragment set:html={playIcon} />Video: {v.label}
            </a>
          ))}
          <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
        </div>
      )}

    </div>
  </div>
</section>
