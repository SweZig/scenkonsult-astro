---
// SceneConfigurator.astro — interaktiv scenkonfigurator
// Bygger ovanpå scenes.json (modules + tillbehor)
import scenData from '../data/scenes.json';

const modules = scenData.modules || [];
const stairs = (scenData.tillbehor || []).filter(t =>
  ['SK-SCN-ACC-0001', 'SK-SCN-ACC-0002'].includes(t.artno)
);
const skirt = (scenData.tillbehor || []).find(t => t.artno === 'SK-SCN-ACC-0003');
const railSegments = (scenData.tillbehor || []).filter(t =>
  ['SK-SCN-ACC-0005', 'SK-SCN-ACC-0006', 'SK-SCN-ACC-0007'].includes(t.artno)
);

// Data till JS — JSON-säkert
const configData = {
  modules,
  stairs,
  skirt: skirt ? { ...skirt, pricePerMeter: 24.75 } : null,
  railSegments,
};
---

<section class="scene-configurator" id="scene-configurator">
  <div class="cfg-header">
    <p class="cfg-eyebrow">Scen · Bygg din egen</p>
    <h2 class="cfg-title">Bygg din scen — pris direkt</h2>
    <p class="cfg-lead">Välj plattformstyp, mått och tillbehör. Vi ritar upp scenen, räknar ut alla moduler och totalpriset live. Lägg sedan hela konfigurationen i varukorgen i ett klick.</p>
  </div>

  <div class="cfg-grid">
    <!-- VISUALISERINGSSPALT -->
    <div class="cfg-visual">
      <div class="cfg-svg-frame" id="cfg-svg-frame">
        <svg id="cfg-svg" viewBox="0 0 600 420" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visualisering av scenen"></svg>
      </div>
      <div class="cfg-meta-row">
        <div class="cfg-meta">
          <div class="cfg-meta-label">Mått</div>
          <div class="cfg-meta-value" id="cfg-display-dim">— × — m</div>
        </div>
        <div class="cfg-meta">
          <div class="cfg-meta-label">Yta</div>
          <div class="cfg-meta-value" id="cfg-display-area">— m²</div>
        </div>
        <div class="cfg-meta">
          <div class="cfg-meta-label">Höjd</div>
          <div class="cfg-meta-value" id="cfg-display-height">— cm</div>
        </div>
        <div class="cfg-meta">
          <div class="cfg-meta-label">Moduler</div>
          <div class="cfg-meta-value" id="cfg-display-modules">— st</div>
        </div>
      </div>
    </div>

    <!-- FORMSPALT -->
    <div class="cfg-form">

      <!-- Steg 1 — Plattformstyp -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">1</span>Plattformstyp</legend>
        <div class="cfg-radio-stack">
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x2-slat" checked />
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×2 m — slät yta</div>
              <div class="cfg-radio-desc">200 kr/modul. Bäst om matta läggs över. Mått måste passa i 1×2-moduler.</div>
            </div>
          </label>
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x2-halkfri" />
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×2 m — halkfri yta</div>
              <div class="cfg-radio-desc">225 kr/modul. Standard halkfri ovansida. Mått måste passa i 1×2-moduler.</div>
            </div>
          </label>
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x1-halkfri" />
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×1 m — halkfri yta</div>
              <div class="cfg-radio-desc">125 kr/modul. Maximal flexibilitet — fri val av alla mått.</div>
            </div>
          </label>
        </div>
      </fieldset>

      <!-- Steg 2 — Mått -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">2</span>Mått</legend>
        <div class="cfg-dim-row">
          <label class="cfg-dim-input">
            <span class="cfg-dim-label">Bredd</span>
            <div class="cfg-stepper">
              <button type="button" class="cfg-step-btn" data-dim-step="width" data-dir="-1">−</button>
              <input type="number" id="cfg-width" min="2" max="12" value="6" />
              <button type="button" class="cfg-step-btn" data-dim-step="width" data-dir="1">+</button>
            </div>
            <span class="cfg-dim-unit">m</span>
          </label>
          <label class="cfg-dim-input">
            <span class="cfg-dim-label">Djup</span>
            <div class="cfg-stepper">
              <button type="button" class="cfg-step-btn" data-dim-step="depth" data-dir="-1">−</button>
              <input type="number" id="cfg-depth" min="2" max="8" value="4" />
              <button type="button" class="cfg-step-btn" data-dim-step="depth" data-dir="1">+</button>
            </div>
            <span class="cfg-dim-unit">m</span>
          </label>
        </div>
        <p id="cfg-dim-warning" class="cfg-warning"></p>
        <p class="cfg-hint">Min 2×2 m. Max 12×8 m. Större på offert.</p>
      </fieldset>

      <!-- Steg 3 — Höjd -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">3</span>Höjd</legend>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="height" value="40" /><span>40 cm</span></label>
          <label class="cfg-pill"><input type="radio" name="height" value="60" checked /><span>60 cm</span></label>
        </div>
      </fieldset>

      <!-- Steg 4 — Trappor -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">4</span>Trappor</legend>
        <p class="cfg-hint">Trappans höjd anpassas automatiskt till scenhöjden. Max 2 trappor.</p>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="stairCount" value="0" /><span>0 trappor</span></label>
          <label class="cfg-pill"><input type="radio" name="stairCount" value="1" checked /><span>1 trappa</span></label>
          <label class="cfg-pill"><input type="radio" name="stairCount" value="2" /><span>2 trappor</span></label>
        </div>
        <div id="cfg-stair-placement" class="cfg-stair-placement">
          <!-- Genereras dynamiskt baserat på antal trappor -->
        </div>
      </fieldset>

      <!-- Steg 5 — Scenkjol -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">5</span>Scenkjol</legend>
        <p class="cfg-hint">Svart scenkjol som döljer ben och teknik. 24,75 kr per löpmeter.</p>
        <div class="cfg-side-grid">
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="fram" checked /><span>Fram</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="vanster" /><span>Vänster</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="hoger" /><span>Höger</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="bak" /><span>Bak</span></label>
        </div>
      </fieldset>

      <!-- Steg 6 — Skyddsräcken -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">6</span>Skyddsräcken</legend>
        <p class="cfg-hint">140 kr per löpmeter. Räcken kan inte placeras där trappa står.</p>
        <div class="cfg-side-grid">
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="fram" /><span>Fram</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="vanster" /><span>Vänster</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="hoger" /><span>Höger</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="bak" /><span>Bak</span></label>
        </div>
      </fieldset>

      <!-- Steg 7 — Montering -->
      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">7</span>Montering</legend>
        <label class="cfg-toggle">
          <input type="checkbox" id="cfg-installation" />
          <span class="cfg-toggle-text" id="cfg-installation-label">Inkludera montering &amp; demontering av Scenkonsult</span>
        </label>
        <p id="cfg-installation-hint" class="cfg-hint">Beräknad tid: 15 min/modul. Pris timdebiteras separat. Obligatoriskt vid scen ≥ 16 m².</p>
      </fieldset>
    </div>
  </div>

  <!-- PRIS-SPEC + CART -->
  <div class="cfg-summary">
    <h3 class="cfg-summary-title">Specifikation och pris</h3>
    <ul class="cfg-spec-list" id="cfg-spec-list"></ul>
    <div class="cfg-total-row">
      <span class="cfg-total-label">Totalt per dygn</span>
      <span class="cfg-total-value">
        <span class="sk-price-excl" id="cfg-total-excl">0 kr</span>
        <span class="sk-price-incl hidden" id="cfg-total-incl">0 kr</span>
      </span>
    </div>
    <button type="button" class="cfg-cart-btn" id="cfg-add-to-cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      Lägg konfigurationen i varukorgen
    </button>
    <p id="cfg-cart-feedback" class="cfg-cart-feedback"></p>
  </div>
</section>

<script type="application/json" id="cfg-data" set:html={JSON.stringify(configData)}></script>

<script>
(function () {
  if (window.__sceneConfiguratorInit) return;
  window.__sceneConfiguratorInit = true;

  function init() {
    const root = document.getElementById('scene-configurator');
    if (!root) return;
    const dataNode = document.getElementById('cfg-data');
    if (!dataNode) return;
    const cfg = JSON.parse(dataNode.textContent || '{}');

    // ── State ───────────────────────────────────────────────────────────
    const SIDES = ['fram', 'vanster', 'hoger', 'bak'];
    const SIDE_LABELS = { fram: 'Fram', vanster: 'Vänster', hoger: 'Höger', bak: 'Bak' };
    const state = {
      moduleType: '1x2-slat',
      width: 6,
      depth: 4,
      height: 60,
      stairCount: 1,
      stairPositions: ['fram'], // array of sides
      skirt: { fram: true, vanster: false, hoger: false, bak: false },
      rail: { fram: false, vanster: false, hoger: false, bak: false },
      installation: false,
    };

    const MODULE_PRICES = { '1x2-slat': 200, '1x2-halkfri': 225, '1x1-halkfri': 125 };
    const MODULE_ARTNO = { '1x2-slat': 'SK-SCN-MOD-0002', '1x2-halkfri': 'SK-SCN-MOD-0003', '1x1-halkfri': 'SK-SCN-MOD-0001' };
    const MODULE_NAME = {
      '1x2-slat': 'Plattform 1×2 m (slät)',
      '1x2-halkfri': 'Plattform 1×2 m (halkfri)',
      '1x1-halkfri': 'Plattform 1×1 m (halkfri)',
    };
    const RAIL_SEGMENTS = [
      { artno: 'SK-SCN-ACC-0007', length: 2.0, name: 'Skyddsräcke 2,0 m', price: 280 },
      { artno: 'SK-SCN-ACC-0005', length: 1.0, name: 'Skyddsräcke 1,0 m', price: 140 },
    ]; // sorted desc — only 2.0 + 1.0 needed for integer meters
    const RAIL_PRICE_PER_METER = 140;
    const SKIRT_PRICE_PER_METER = 24.75;

    function getStairForHeight(h) {
      if (h === 40) return { artno: 'SK-SCN-ACC-0001', name: 'Scentrapp (40 cm)', price: 279 };
      return { artno: 'SK-SCN-ACC-0002', name: 'Scentrapp (60 cm)', price: 349 };
    }

    // ── Validering ──────────────────────────────────────────────────────
    function isDimValid() {
      const { moduleType, width, depth } = state;
      if (width < 2 || width > 12 || depth < 2 || depth > 8) return false;
      if (!Number.isInteger(width) || !Number.isInteger(depth)) return false;
      if (moduleType === '1x1-halkfri') return true;
      // 1x2: minst en sida måste vara jämn
      return (width % 2 === 0) || (depth % 2 === 0);
    }

    function moduleCount() {
      if (!isDimValid()) return 0;
      if (state.moduleType === '1x1-halkfri') return state.width * state.depth;
      return (state.width * state.depth) / 2;
    }

    // ── Pris-kalkyl ─────────────────────────────────────────────────────
    function computeLineItems() {
      const lines = [];
      if (!isDimValid()) return lines;

      const prefix = `[Scen ${state.width}×${state.depth}·${state.height}cm]`;
      const modCount = moduleCount();

      // 1. Plattformsmoduler
      lines.push({
        artno: MODULE_ARTNO[state.moduleType],
        name: `${prefix} ${MODULE_NAME[state.moduleType]}`,
        price: MODULE_PRICES[state.moduleType],
        qty: modCount,
        category: 'Scen',
      });

      // 2. Trappor
      if (state.stairCount > 0) {
        const stair = getStairForHeight(state.height);
        const positions = state.stairPositions.slice(0, state.stairCount);
        positions.forEach(pos => {
          lines.push({
            artno: stair.artno,
            name: `${prefix} ${stair.name} — placering ${SIDE_LABELS[pos] || pos}`,
            price: stair.price,
            qty: 1,
            category: 'Scen',
          });
        });
      }

      // 3. Scenkjol — räkna meter över alla valda sidor
      const skirtMeters = sideLengthsTotal('skirt');
      if (skirtMeters > 0) {
        lines.push({
          artno: 'SK-SCN-ACC-0003',
          name: `${prefix} Scenkjol (${skirtMeters} m)`,
          price: Math.round(skirtMeters * SKIRT_PRICE_PER_METER * 100) / 100,
          qty: 1,
          category: 'Scen',
          isCalculated: true, // visa pris-per-meter info i spec
          metaText: `${skirtMeters} m × 24,75 kr`,
        });
      }

      // 4. Räcken — pack varje sida med 2.0+1.0-segment, exkludera trappa-sidor
      const railSidesValid = SIDES.filter(s => state.rail[s] && !state.stairPositions.slice(0, state.stairCount).includes(s));
      const railTotals = { 'SK-SCN-ACC-0007': 0, 'SK-SCN-ACC-0005': 0 };
      let railTotalMeters = 0;
      railSidesValid.forEach(side => {
        const len = sideLengthMeters(side);
        const packed = packRail(len);
        railTotals['SK-SCN-ACC-0007'] += packed.count20;
        railTotals['SK-SCN-ACC-0005'] += packed.count10;
        railTotalMeters += len;
      });
      if (railTotals['SK-SCN-ACC-0007'] > 0) {
        lines.push({
          artno: 'SK-SCN-ACC-0007',
          name: `${prefix} Skyddsräcke 2,0 m`,
          price: 280,
          qty: railTotals['SK-SCN-ACC-0007'],
          category: 'Scen',
        });
      }
      if (railTotals['SK-SCN-ACC-0005'] > 0) {
        lines.push({
          artno: 'SK-SCN-ACC-0005',
          name: `${prefix} Skyddsräcke 1,0 m`,
          price: 140,
          qty: railTotals['SK-SCN-ACC-0005'],
          category: 'Scen',
        });
      }

      return lines;
    }

    function sideLengthMeters(side) {
      // fram & bak = bredd, vanster & hoger = djup
      return (side === 'fram' || side === 'bak') ? state.width : state.depth;
    }

    function sideLengthsTotal(prop) {
      return SIDES.filter(s => state[prop][s]).reduce((sum, s) => sum + sideLengthMeters(s), 0);
    }

    function packRail(meters) {
      // greedy: 2.0 sedan 1.0
      let remaining = meters;
      let count20 = 0, count10 = 0;
      while (remaining >= 2 - 0.001) { count20++; remaining -= 2; }
      while (remaining >= 1 - 0.001) { count10++; remaining -= 1; }
      return { count20, count10 };
    }

    function totalPrice(lines) {
      return lines.reduce((sum, l) => sum + l.price * l.qty, 0);
    }

    // ── Rendering: SVG (top-down isometrisk) ────────────────────────────
    function renderSVG() {
      const svg = document.getElementById('cfg-svg');
      if (!svg) return;
      svg.innerHTML = '';

      if (!isDimValid()) {
        svg.innerHTML = `<text x="300" y="210" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-family="Space Grotesk,sans-serif" font-size="14">Vänligen välj giltiga mått</text>`;
        return;
      }

      // Skala: 600x420 viewport. Topp-down, isometrisk lutning.
      // Beräkna skala så att största sidan får ca 80% av rutan
      const padX = 80, padY = 70;
      const usableW = 600 - 2 * padX;
      const usableH = 420 - 2 * padY;
      const scale = Math.min(usableW / state.width, usableH / state.depth) * 0.95;
      const stageW = state.width * scale;
      const stageD = state.depth * scale;
      const cx = 300, cy = 220;
      const x0 = cx - stageW / 2;
      const y0 = cy - stageD / 2;

      // Bakgrund (golv-skugga)
      const shadowOff = 6;
      svg.innerHTML += `<rect x="${x0 + shadowOff}" y="${y0 + shadowOff}" width="${stageW}" height="${stageD}" fill="rgba(0,0,0,0.4)" rx="2"/>`;

      // Plattformsraster
      const modW = state.moduleType === '1x1-halkfri' ? 1 : 2;
      const modH = 1;
      // Bestäm orientation: om bredd är jämn, lägg moduler liggande (modW=2 i bredd)
      // Om djup är jämn, lägg moduler liggande i djup
      // För 1x1: alltid 1m moduler
      let mods = [];
      if (state.moduleType === '1x1-halkfri') {
        for (let r = 0; r < state.depth; r++) {
          for (let c = 0; c < state.width; c++) {
            mods.push({ x: c, y: r, w: 1, h: 1 });
          }
        }
      } else {
        // 1x2: orientering — om bredd jämn, lägg 1×2 horisontellt; annars 2×1 vertikalt
        if (state.width % 2 === 0) {
          for (let r = 0; r < state.depth; r++) {
            for (let c = 0; c < state.width; c += 2) {
              mods.push({ x: c, y: r, w: 2, h: 1 });
            }
          }
        } else {
          for (let r = 0; r < state.depth; r += 2) {
            for (let c = 0; c < state.width; c++) {
              mods.push({ x: c, y: r, w: 1, h: 2 });
            }
          }
        }
      }

      const isHalkfri = state.moduleType.includes('halkfri');
      const moduleFill = isHalkfri ? 'url(#patHalkfri)' : '#3a3370';
      const moduleStroke = '#c4b5f4';

      // Mönster för halkfri yta
      svg.innerHTML += `
        <defs>
          <pattern id="patHalkfri" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
            <rect width="6" height="6" fill="#3a3370"/>
            <line x1="0" y1="0" x2="0" y2="6" stroke="#5a4ea0" stroke-width="1.2"/>
          </pattern>
        </defs>`;

      // Rita modulerna
      mods.forEach(m => {
        const mx = x0 + m.x * scale;
        const my = y0 + m.y * scale;
        svg.innerHTML += `<rect x="${mx}" y="${my}" width="${m.w * scale}" height="${m.h * scale}"
          fill="${moduleFill}" stroke="${moduleStroke}" stroke-width="1" stroke-opacity="0.4" />`;
      });

      // Yttergräns med tjockare ram
      svg.innerHTML += `<rect x="${x0}" y="${y0}" width="${stageW}" height="${stageD}"
        fill="none" stroke="#c4b5f4" stroke-width="2" stroke-opacity="0.8" />`;

      // Scenkjol (svart band)
      Object.keys(state.skirt).forEach(side => {
        if (!state.skirt[side]) return;
        const t = 6;
        let r;
        if (side === 'fram') r = `<rect x="${x0}" y="${y0 + stageD - t}" width="${stageW}" height="${t}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
        if (side === 'bak') r = `<rect x="${x0}" y="${y0}" width="${stageW}" height="${t}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
        if (side === 'vanster') r = `<rect x="${x0}" y="${y0}" width="${t}" height="${stageD}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
        if (side === 'hoger') r = `<rect x="${x0 + stageW - t}" y="${y0}" width="${t}" height="${stageD}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
        svg.innerHTML += r;
      });

      // Skyddsräcken (lavendel-linje)
      const stairSet = new Set(state.stairPositions.slice(0, state.stairCount));
      Object.keys(state.rail).forEach(side => {
        if (!state.rail[side]) return;
        if (stairSet.has(side)) return; // ingen räcke vid trappa
        const off = 4;
        let r;
        if (side === 'fram') r = `<line x1="${x0}" y1="${y0 + stageD + off}" x2="${x0 + stageW}" y2="${y0 + stageD + off}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
        if (side === 'bak') r = `<line x1="${x0}" y1="${y0 - off}" x2="${x0 + stageW}" y2="${y0 - off}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
        if (side === 'vanster') r = `<line x1="${x0 - off}" y1="${y0}" x2="${x0 - off}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
        if (side === 'hoger') r = `<line x1="${x0 + stageW + off}" y1="${y0}" x2="${x0 + stageW + off}" y2="${y0 + stageD}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
        svg.innerHTML += r;
      });

      // Trappor (triangulära markörer pekande in)
      const stairsArr = state.stairPositions.slice(0, state.stairCount);
      stairsArr.forEach(side => {
        const sw = Math.min(stageW, stageD) * 0.18; // trapp-bredd ~ 18% av minsta sidan
        let pts;
        if (side === 'fram') {
          const tx = x0 + stageW / 2, ty = y0 + stageD;
          pts = `${tx - sw / 2},${ty + sw} ${tx + sw / 2},${ty + sw} ${tx},${ty + 4}`;
        }
        if (side === 'bak') {
          const tx = x0 + stageW / 2, ty = y0;
          pts = `${tx - sw / 2},${ty - sw} ${tx + sw / 2},${ty - sw} ${tx},${ty - 4}`;
        }
        if (side === 'vanster') {
          const tx = x0, ty = y0 + stageD / 2;
          pts = `${tx - sw},${ty - sw / 2} ${tx - sw},${ty + sw / 2} ${tx - 4},${ty}`;
        }
        if (side === 'hoger') {
          const tx = x0 + stageW, ty = y0 + stageD / 2;
          pts = `${tx + sw},${ty - sw / 2} ${tx + sw},${ty + sw / 2} ${tx + 4},${ty}`;
        }
        svg.innerHTML += `<polygon points="${pts}" fill="#e2dcfb" stroke="#c4b5f4" stroke-width="1.2" />`;
      });

      // Mått-etiketter
      const labelStyle = `fill="rgba(255,255,255,0.55)" font-family="Space Grotesk,sans-serif" font-size="11" font-weight="600"`;
      svg.innerHTML += `<text x="${x0 + stageW / 2}" y="${y0 + stageD + 50}" text-anchor="middle" ${labelStyle}>Bredd: ${state.width} m (Fram)</text>`;
      svg.innerHTML += `<text x="${x0 + stageW / 2}" y="${y0 - 28}" text-anchor="middle" ${labelStyle} fill-opacity="0.4">${state.width} m (Bak)</text>`;
      svg.innerHTML += `<text x="${x0 - 28}" y="${y0 + stageD / 2}" text-anchor="middle" ${labelStyle} transform="rotate(-90 ${x0 - 28} ${y0 + stageD / 2})">${state.depth} m</text>`;

      // Compass / orientering hint
      svg.innerHTML += `<text x="20" y="30" fill="rgba(196,181,244,0.55)" font-family="Space Grotesk,sans-serif" font-size="9" font-weight="700" letter-spacing="1.5">↑ BAK · ↓ FRAM (mot publik)</text>`;
    }

    // ── Rendering: meta-rad ─────────────────────────────────────────────
    function renderMeta() {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      if (isDimValid()) {
        set('cfg-display-dim', `${state.width} × ${state.depth} m`);
        set('cfg-display-area', `${state.width * state.depth} m²`);
        set('cfg-display-height', `${state.height} cm`);
        set('cfg-display-modules', `${moduleCount()} st`);
      } else {
        set('cfg-display-dim', '— × — m');
        set('cfg-display-area', '— m²');
        set('cfg-display-height', `${state.height} cm`);
        set('cfg-display-modules', '— st');
      }
    }

    // ── Rendering: trapplaceringar (dynamiskt) ──────────────────────────
    function renderStairPlacement() {
      const wrap = document.getElementById('cfg-stair-placement');
      if (!wrap) return;
      const n = state.stairCount;
      if (n === 0) { wrap.innerHTML = ''; return; }
      let html = '<p class="cfg-hint cfg-hint-block">Placering:</p>';
      for (let i = 0; i < n; i++) {
        html += `<div class="cfg-stair-row">
          <span class="cfg-stair-num">Trappa ${i + 1}</span>
          <select data-stair-idx="${i}" class="cfg-select">
            ${SIDES.map(s => `<option value="${s}" ${state.stairPositions[i] === s ? 'selected' : ''}>${SIDE_LABELS[s]}</option>`).join('')}
          </select>
        </div>`;
      }
      wrap.innerHTML = html;

      // Bind
      wrap.querySelectorAll('select[data-stair-idx]').forEach(sel => {
        sel.addEventListener('change', e => {
          const idx = parseInt(e.target.dataset.stairIdx, 10);
          state.stairPositions[idx] = e.target.value;
          render();
        });
      });
    }

    // ── Rendering: dim-warning + räcke-disabling ────────────────────────
    function renderValidation() {
      const warn = document.getElementById('cfg-dim-warning');
      if (!warn) return;
      if (!isDimValid()) {
        if (state.moduleType !== '1x1-halkfri' && state.width % 2 !== 0 && state.depth % 2 !== 0) {
          warn.textContent = `⚠ Med 1×2-moduler måste antingen bredd eller djup vara jämn. Välj t.ex. ${state.width}×${state.depth + 1} eller använd 1×1-moduler.`;
        } else {
          warn.textContent = '⚠ Måtten ligger utanför tillåtet intervall (min 2 m, max 12×8 m).';
        }
      } else {
        warn.textContent = '';
      }

      // Disabla räcke-checkboxar för sidor där trappa står
      const stairSet = new Set(state.stairPositions.slice(0, state.stairCount));
      document.querySelectorAll('input[name="rail"]').forEach(cb => {
        const side = cb.dataset.side;
        if (stairSet.has(side)) {
          cb.disabled = true;
          if (cb.checked) { cb.checked = false; state.rail[side] = false; }
          cb.parentElement?.classList.add('cfg-side-disabled');
        } else {
          cb.disabled = false;
          cb.parentElement?.classList.remove('cfg-side-disabled');
        }
      });
    }

    // ── Rendering: spec-lista + total ───────────────────────────────────
    function renderSpec() {
      const list = document.getElementById('cfg-spec-list');
      if (!list) return;
      const lines = computeLineItems();
      if (lines.length === 0) {
        list.innerHTML = '<li class="cfg-spec-empty">Välj giltiga mått för att se specifikation.</li>';
        document.getElementById('cfg-total-excl').textContent = '0 kr';
        document.getElementById('cfg-total-incl').textContent = '0 kr';
        return;
      }
      let html = '';
      lines.forEach(l => {
        const lineSum = l.price * l.qty;
        const meta = l.metaText ? ` <span class="cfg-spec-meta">(${l.metaText})</span>` : '';
        const qtyText = l.isCalculated ? '' : `<span class="cfg-spec-qty">${l.qty}×</span>`;
        html += `<li class="cfg-spec-row">
          <div class="cfg-spec-name">
            ${qtyText}<span>${l.name}</span>${meta}
          </div>
          <div class="cfg-spec-price">
            <span class="sk-price-excl">${formatKr(lineSum)}</span>
            <span class="sk-price-incl hidden">${formatKr(Math.round(lineSum * 1.25))}</span>
          </div>
        </li>`;
      });
      list.innerHTML = html;

      const total = totalPrice(lines);
      document.getElementById('cfg-total-excl').textContent = formatKr(total);
      document.getElementById('cfg-total-incl').textContent = formatKr(Math.round(total * 1.25));

      // Installation hint
      const area = state.width * state.depth;
      const installHint = document.getElementById('cfg-installation-hint');
      const installCb = document.getElementById('cfg-installation');
      const installLabel = document.getElementById('cfg-installation-label');
      const minutes = moduleCount() * 15;
      if (area >= 16) {
        if (installCb) { installCb.checked = true; installCb.disabled = true; state.installation = true; }
        if (installLabel) installLabel.textContent = 'Montering & demontering ingår (obligatoriskt över 16 m²)';
        if (installHint) installHint.textContent = `Beräknad tid: ca ${minutes} min montering. Pris timdebiteras separat (offereras).`;
      } else {
        if (installCb) installCb.disabled = false;
        if (installLabel) installLabel.textContent = 'Inkludera montering & demontering av Scenkonsult';
        if (installHint) installHint.textContent = state.installation
          ? `Beräknad tid: ca ${minutes} min montering. Pris timdebiteras separat (offereras).`
          : 'Beräknad tid: 15 min/modul. Pris timdebiteras separat. Obligatoriskt vid scen ≥ 16 m².';
      }
    }

    function formatKr(n) {
      return new Intl.NumberFormat('sv-SE').format(Math.round(n)) + ' kr';
    }

    function render() {
      renderValidation();
      renderMeta();
      renderStairPlacement();
      renderSVG();
      renderSpec();
    }

    // ── Bind events ─────────────────────────────────────────────────────
    document.querySelectorAll('input[name="moduleType"]').forEach(el => {
      el.addEventListener('change', e => {
        state.moduleType = e.target.value;
        render();
      });
    });

    document.querySelectorAll('input[name="height"]').forEach(el => {
      el.addEventListener('change', e => {
        state.height = parseInt(e.target.value, 10);
        render();
      });
    });

    document.querySelectorAll('input[name="stairCount"]').forEach(el => {
      el.addEventListener('change', e => {
        state.stairCount = parseInt(e.target.value, 10);
        // Säkra att stairPositions har rätt längd
        while (state.stairPositions.length < state.stairCount) {
          // Använd första lediga sida
          const used = new Set(state.stairPositions);
          const next = SIDES.find(s => !used.has(s)) || 'fram';
          state.stairPositions.push(next);
        }
        render();
      });
    });

    document.querySelectorAll('input[name="skirt"]').forEach(el => {
      el.addEventListener('change', e => {
        state.skirt[e.target.dataset.side] = e.target.checked;
        render();
      });
    });

    document.querySelectorAll('input[name="rail"]').forEach(el => {
      el.addEventListener('change', e => {
        state.rail[e.target.dataset.side] = e.target.checked;
        render();
      });
    });

    const widthInput = document.getElementById('cfg-width');
    const depthInput = document.getElementById('cfg-depth');
    widthInput?.addEventListener('input', e => { state.width = parseInt(e.target.value, 10) || 0; render(); });
    depthInput?.addEventListener('input', e => { state.depth = parseInt(e.target.value, 10) || 0; render(); });

    document.querySelectorAll('button[data-dim-step]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dim = btn.dataset.dimStep;
        const dir = parseInt(btn.dataset.dir, 10);
        if (dim === 'width') {
          state.width = Math.max(2, Math.min(12, state.width + dir));
          if (widthInput) widthInput.value = state.width;
        } else {
          state.depth = Math.max(2, Math.min(8, state.depth + dir));
          if (depthInput) depthInput.value = state.depth;
        }
        render();
      });
    });

    document.getElementById('cfg-installation')?.addEventListener('change', e => {
      state.installation = e.target.checked;
      render();
    });

    // ── Lägg i varukorgen ───────────────────────────────────────────────
    document.getElementById('cfg-add-to-cart')?.addEventListener('click', () => {
      if (!isDimValid()) {
        feedback('Vänligen välj giltiga mått innan du lägger till.', 'error');
        return;
      }
      const lines = computeLineItems();
      if (lines.length === 0) {
        feedback('Tomt — välj minst plattform.', 'error');
        return;
      }
      if (!window.skCart || typeof window.skCart.add !== 'function') {
        feedback('Varukorgen är inte tillgänglig på den här sidan.', 'error');
        return;
      }
      lines.forEach(l => {
        // Multiplicera qty: skCart.add lägger 1, vi anropar qty gånger ELLER skickar med qty
        // Befintligt API: skCart.add({id,name,price,category,qty})
        window.skCart.add({
          id: l.artno,
          artno: l.artno,
          name: l.name,
          price: l.price,
          category: l.category || 'Scen',
          qty: l.qty,
        });
      });
      feedback(`✓ Lade ${lines.length} rader i varukorgen — ${formatKr(totalPrice(lines))}/dygn.`, 'success');
    });

    function feedback(msg, kind) {
      const el = document.getElementById('cfg-cart-feedback');
      if (!el) return;
      el.textContent = msg;
      el.className = `cfg-cart-feedback ${kind === 'error' ? 'is-error' : 'is-success'}`;
      setTimeout(() => { el.textContent = ''; el.className = 'cfg-cart-feedback'; }, 5000);
    }

    // ── Initial render ──────────────────────────────────────────────────
    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', () => {
    window.__sceneConfiguratorInit = false;
    if (document.getElementById('scene-configurator')) {
      window.__sceneConfiguratorInit = true;
      init();
    }
  });
})();
</script>

