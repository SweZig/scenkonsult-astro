---
// SceneConfigurator.astro — interaktiv scenkonfigurator (v2)
import scenData from '../data/scenes.json';
import tjanster from '../data/tjanster.json';

const modules = scenData.modules || [];
const stairs = (scenData.tillbehor || []).filter(t =>
  ['SK-SCN-ACC-0001', 'SK-SCN-ACC-0002'].includes(t.artno)
);
const skirt = (scenData.tillbehor || []).find(t => t.artno === 'SK-SCN-ACC-0003');
const railSegments = (scenData.tillbehor || []).filter(t =>
  ['SK-SCN-ACC-0006', 'SK-SCN-ACC-0007'].includes(t.artno)
);

const fraktOptions = {
  storbil: tjanster.leverans?.storbil,
  storbil_slap: tjanster.leverans?.storbil_slap,
  lastbil: tjanster.leverans?.lastbil,
};

// ──────────────────────────────────────────────────────────────────
// JSON-first lookups som tidigare var hårdkodade i klient-JS
// ──────────────────────────────────────────────────────────────────
function _surfaceKey(m) {
  // '1×1 m' → '1x1' (strip whitespace, ' m' suffix, ersätt ×→x)
  const sizeKey = (m.size || '').replace(/\s*m\b/i, '').replace(/\s/g, '').replace(/×/g, 'x');
  const surf = m.surface === 'slät' ? 'slat' : 'halkfri';
  return `${sizeKey}-${surf}`;
}

const INJ_MODULE_BY_KEY = Object.fromEntries(
  modules.map(m => [_surfaceKey(m), { artno: m.artno, name: m.name, price: m.price }])
);

const INJ_MONTERING_PRICE_PER_HOUR = tjanster.montering?.prisPerTimme || 600;
const INJ_OBLIG_OVER_M2 = tjanster.montering?.obligatoriskOverM2 ?? 16;
const INJ_SKIRT_PRICE_PER_METER = skirt?.pricePerMeter || 24.75;
const INJ_FRAKT_RULES = scenData.fraktByArea || [
  { maxArea: 16, fordon: 'storbil' },
  { maxArea: 24, fordon: 'storbil_slap' },
  { maxArea: 9999, fordon: 'lastbil' },
];

const configData = {
  modules,
  stairs,
  skirt: skirt ? { ...skirt, pricePerMeter: INJ_SKIRT_PRICE_PER_METER } : null,
  railSegments,
  frakt: fraktOptions,
  montering: tjanster.montering,
};
---

<section class="scene-configurator" id="scene-configurator">
  <div class="cfg-header">
    <p class="cfg-eyebrow">Scen · Bygg din egen</p>
    <h2 class="cfg-title">Bygg din scen — pris direkt</h2>
    <p class="cfg-lead">Välj plattformstyp, mått och tillbehör. Vi ritar upp scenen, räknar ut alla moduler och totalpriset live. Lägg sedan hela konfigurationen i varukorgen i ett klick.</p>
  </div>

  <div class="cfg-grid">
    <div class="cfg-visual">
      <div class="cfg-svg-frame" id="cfg-svg-frame">
        <svg id="cfg-svg" viewBox="0 0 600 420" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visualisering av scenen"></svg>
      </div>
      <div class="cfg-meta-row">
        <div class="cfg-meta">
          <div class="cfg-meta-label">Mått</div>
          <div class="cfg-meta-value" id="cfg-display-dim">— m</div>
        </div>
        <div class="cfg-meta">
          <div class="cfg-meta-label">Höjd</div>
          <div class="cfg-meta-value" id="cfg-display-height">— cm</div>
        </div>
        <div class="cfg-meta">
          <div class="cfg-meta-label">Moduler</div>
          <div class="cfg-meta-value" id="cfg-display-modules">— st</div>
        </div>
      </div>
    </div>

    <div class="cfg-form">

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">1</span>Plattformstyp</legend>
        <div class="cfg-radio-stack">
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x1-halkfri" />
            <span class="cfg-yta-swatch" style="background-image:url('/images/scen/tex_yta_halkfri.webp')" aria-hidden="true"></span>
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×1 m — halkfri yta <span class="cfg-radio-price">{INJ_MODULE_BY_KEY['1x1-halkfri']?.price} kr/modul</span></div>
              <div class="cfg-radio-desc">Fri val av mått. Endast 40 cm höjd. Max 20 m² (20 moduler).</div>
            </div>
          </label>
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x2-slat" checked />
            <span class="cfg-yta-swatch" style="background-image:url('/images/scen/tex_yta_slat.webp')" aria-hidden="true"></span>
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×2 m — slät yta <span class="cfg-radio-price">{INJ_MODULE_BY_KEY['1x2-slat']?.price} kr/modul</span></div>
              <div class="cfg-radio-desc">Bäst om matta läggs över. Mått måste passa i 1×2-moduler.</div>
            </div>
          </label>
          <label class="cfg-card-radio">
            <input type="radio" name="moduleType" value="1x2-halkfri" />
            <span class="cfg-yta-swatch" style="background-image:url('/images/scen/tex_yta_halkfri.webp')" aria-hidden="true"></span>
            <div class="cfg-radio-body">
              <div class="cfg-radio-title">1×2 m — halkfri yta <span class="cfg-radio-price">{INJ_MODULE_BY_KEY['1x2-halkfri']?.price} kr/modul</span></div>
              <div class="cfg-radio-desc">Standard halkfri ovansida. Mått måste passa i 1×2-moduler.</div>
            </div>
          </label>
        </div>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">2</span>Mått</legend>
        <div class="cfg-dim-row">
          <label class="cfg-dim-input">
            <span class="cfg-dim-label">Bredd</span>
            <div class="cfg-stepper">
              <button type="button" class="cfg-step-btn" data-dim-step="width" data-dir="-1">−</button>
              <input type="number" id="cfg-width" min="2" max="12" value="6" />
              <button type="button" class="cfg-step-btn" data-dim-step="width" data-dir="1">+</button>
            </div>
            <span class="cfg-dim-unit">m</span>
          </label>
          <label class="cfg-dim-input">
            <span class="cfg-dim-label">Djup</span>
            <div class="cfg-stepper">
              <button type="button" class="cfg-step-btn" data-dim-step="depth" data-dir="-1">−</button>
              <input type="number" id="cfg-depth" min="2" max="8" value="4" />
              <button type="button" class="cfg-step-btn" data-dim-step="depth" data-dir="1">+</button>
            </div>
            <span class="cfg-dim-unit">m</span>
          </label>
        </div>
        <p id="cfg-dim-warning" class="cfg-warning"></p>
        <p class="cfg-hint">Min 2×2 m, max 12×8 m. Större på offert.</p>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">3</span>Höjd</legend>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="height" value="40" /><span>40 cm</span></label>
          <label class="cfg-pill cfg-pill-height-60"><input type="radio" name="height" value="60" checked /><span>60 cm</span></label>
        </div>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">4</span>Trappor</legend>
        <p class="cfg-hint">Trappans höjd anpassas automatiskt till scenhöjden. Max 2 trappor.</p>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="stairCount" value="0" /><span>0</span></label>
          <label class="cfg-pill"><input type="radio" name="stairCount" value="1" checked /><span>1</span></label>
          <label class="cfg-pill"><input type="radio" name="stairCount" value="2" /><span>2</span></label>
        </div>
        <div id="cfg-stair-placement" class="cfg-stair-placement"></div>
        <label class="cfg-stair-rail" id="cfg-stair-rail-row" hidden>
          <input type="checkbox" id="cfg-stair-rail" />
          <span>Lägg till räcke till trappan — <strong>200 kr/trappa</strong> (2 räcken per trappa, ett på vardera sida)</span>
        </label>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">5</span>Scenkjol</legend>
        <p class="cfg-hint">Svart scenkjol som döljer ben och teknik. 24,75 kr per löpmeter.</p>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="skirtMode" value="none" checked /><span>Ingen</span></label>
          <label class="cfg-pill"><input type="radio" name="skirtMode" value="custom" /><span>Anpassad placering</span></label>
        </div>
        <div class="cfg-side-grid cfg-collapsed" id="cfg-skirt-sides">
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="fram" /><span>Fram</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="vanster" /><span>Vänster</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="hoger" /><span>Höger</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="skirt" data-side="bak" /><span>Bak</span></label>
        </div>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">6</span>Skyddsräcken</legend>
        <p class="cfg-hint">140 kr/m för 1,0 m och 2,0 m segment. Räcken rekommenderas för scener från 60 cm höjd och uppåt. Räcken kan inte placeras där trappa står.</p>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="railMode" value="none" checked /><span>Ingen</span></label>
          <label class="cfg-pill"><input type="radio" name="railMode" value="custom" /><span>Anpassad placering</span></label>
        </div>
        <div class="cfg-side-grid cfg-collapsed" id="cfg-rail-sides">
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="fram" /><span>Fram</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="vanster" /><span>Vänster</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="hoger" /><span>Höger</span></label>
          <label class="cfg-side-check"><input type="checkbox" name="rail" data-side="bak" /><span>Bak</span></label>
        </div>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">7</span>Montering</legend>
        <label class="cfg-toggle">
          <input type="checkbox" id="cfg-installation" />
          <span class="cfg-toggle-text" id="cfg-installation-label">Lägg till montering &amp; demontering — tillkommer separat</span>
        </label>
        <p id="cfg-installation-hint" class="cfg-hint"></p>
      </fieldset>

      <fieldset class="cfg-step">
        <legend><span class="cfg-step-num">8</span>Leverans</legend>
        <p class="cfg-hint" id="cfg-frakt-rec">Välj om vi kör ut scenen åt dig eller om du hämtar själv. Vid leverans väljer vi rätt fordon utifrån storleken — tillkommer separat.</p>
        <div class="cfg-pill-row">
          <label class="cfg-pill"><input type="radio" name="frakt" value="none" checked /><span>Hämta själv</span></label>
          <label class="cfg-pill"><input type="radio" name="frakt" value="auto" /><span>Leverans</span></label>
        </div>
        <div class="cfg-pill-row cfg-pill-row-narrow cfg-collapsed-row" id="cfg-frakt-trip-row" style="margin-top:0.6rem">
          <label class="cfg-pill"><input type="radio" name="fraktTrip" value="tr" checked /><span>Tur &amp; retur</span></label>
          <label class="cfg-pill"><input type="radio" name="fraktTrip" value="enkel" /><span>Enkelresa</span></label>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="cfg-summary">
    <h3 class="cfg-summary-title">Specifikation och pris</h3>
    <ul class="cfg-spec-list" id="cfg-spec-list"></ul>
    <p class="cfg-spec-info">💡 Tillkommande poster är beräknade estimat och kan justeras i orderbekräftelsen. Slutlig debitering bekräftas innan leverans.</p>
    <div class="cfg-total-row">
      <span class="cfg-total-label">Hårdvara per dygn <span class="cfg-total-sublabel">(exkl. transport &amp; montering)</span></span>
      <span class="cfg-total-value">
        <span class="sk-price-excl" id="cfg-total-excl">0 kr</span>
        <span class="sk-price-incl hidden" id="cfg-total-incl">0 kr</span>
      </span>
    </div>
    <p class="cfg-total-komplett" id="cfg-total-komplett" style="display:none"></p>
    <button type="button" class="cfg-cart-btn" id="cfg-add-to-cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      Lägg konfigurationen i varukorgen
    </button>
    <p id="cfg-cart-feedback" class="cfg-cart-feedback"></p>
  </div>
</section>

<script type="application/json" id="cfg-data" set:html={JSON.stringify(configData)}></script>

<script define:vars={{ INJ_MODULE_BY_KEY, INJ_MONTERING_PRICE_PER_HOUR, INJ_OBLIG_OVER_M2, INJ_SKIRT_PRICE_PER_METER, INJ_FRAKT_RULES }}>
(function () {
  function initConfigurator() {
    const root = document.getElementById('scene-configurator');
    if (!root) return;
    if (root.dataset.cfgReady === '1') return;
    root.dataset.cfgReady = '1';

    const dataNode = document.getElementById('cfg-data');
    if (!dataNode) return;
    const cfg = JSON.parse(dataNode.textContent || '{}');

    const SIDES = ['fram', 'vanster', 'hoger', 'bak'];
    const SIDE_LABELS = { fram: 'Fram', vanster: 'Vänster', hoger: 'Höger', bak: 'Bak' };
    const state = {
      moduleType: '1x2-slat',
      width: 6,
      depth: 4,
      height: 60,
      stairCount: 1,
      stairPositions: ['fram'],
      stairRail: false,
      skirtMode: 'none',
      skirt: { fram: false, vanster: false, hoger: false, bak: false },
      railMode: 'none',
      rail: { fram: false, vanster: false, hoger: false, bak: false },
      installation: false,
      frakt: 'none',
      fraktTrip: 'tr',
    };

    const MODULE_PRICES = Object.fromEntries(Object.entries(INJ_MODULE_BY_KEY).map(([k,v]) => [k, v.price]));
    const MODULE_ARTNO  = Object.fromEntries(Object.entries(INJ_MODULE_BY_KEY).map(([k,v]) => [k, v.artno]));
    const MODULE_NAME   = Object.fromEntries(Object.entries(INJ_MODULE_BY_KEY).map(([k,v]) => [k, v.name]));
    const FRAKT_DATA = cfg.frakt || {};
    const FRAKT_LABELS = { storbil: 'Stor bil', storbil_slap: 'Stor bil + släp', lastbil: 'Lätt lastbil' };
    const SKIRT_PRICE_PER_METER = INJ_SKIRT_PRICE_PER_METER;
    const MONTERING_PRICE_PER_HOUR = INJ_MONTERING_PRICE_PER_HOUR;
    const OBLIG_OVER_M2 = INJ_OBLIG_OVER_M2;

    function getStairForHeight(h) {
      if (h === 40) return { artno: 'SK-SCN-ACC-0001', name: 'Scentrapp (40 cm)', price: 279 };
      return { artno: 'SK-SCN-ACC-0002', name: 'Scentrapp (60 cm)', price: 349 };
    }

    function isDimValid() {
      const { moduleType, width, depth } = state;
      if (width < 2 || width > 12 || depth < 2 || depth > 8) return false;
      if (!Number.isInteger(width) || !Number.isInteger(depth)) return false;
      if (moduleType === '1x1-halkfri') {
        if (width * depth > 20) return false;
        return true;
      }
      return (width % 2 === 0) || (depth % 2 === 0);
    }

    function moduleCount() {
      if (!isDimValid()) return 0;
      if (state.moduleType === '1x1-halkfri') return state.width * state.depth;
      return (state.width * state.depth) / 2;
    }

    function getRecommendedFrakt() {
      if (!isDimValid()) return null;
      const area = state.width * state.depth;
      if (area === 0) return null;
      for (const rule of INJ_FRAKT_RULES) {
        if (area <= rule.maxArea) return rule.fordon;
      }
      return INJ_FRAKT_RULES[INJ_FRAKT_RULES.length - 1]?.fordon || 'lastbil';
    }

    // state.frakt är 'none' eller 'auto' — vehicle bestäms av getRecommendedFrakt().
    function activeFraktKey() {
      if (state.frakt !== 'auto') return null;
      return getRecommendedFrakt();
    }

    function fraktPrice() {
      const key = activeFraktKey();
      if (!key) return 0;
      const opt = FRAKT_DATA[key];
      if (!opt) return 0;
      return state.fraktTrip === 'enkel' ? (opt.enkelresa || 0) : (opt.pris || 0);
    }

    function fraktArtno() {
      const key = activeFraktKey();
      if (!key) return null;
      const opt = FRAKT_DATA[key];
      if (!opt) return null;
      return state.fraktTrip === 'enkel' ? (opt.enkel?.artno || opt.artno) : opt.artno;
    }

    function fraktLabel() {
      const key = activeFraktKey();
      if (!key) return 'Ingen leverans (kund hämtar själv)';
      const base = FRAKT_LABELS[key] || key;
      return state.fraktTrip === 'enkel' ? `${base} (enkelresa)` : `${base} (tur & retur)`;
    }

    function computeLineItems() {
      const lines = [];
      if (!isDimValid()) return lines;

      const prefix = `[Scen ${state.width}×${state.depth}·${state.height}cm]`;
      const modCount = moduleCount();

      lines.push({
        artno: MODULE_ARTNO[state.moduleType],
        name: `${prefix} ${MODULE_NAME[state.moduleType]}`,
        price: MODULE_PRICES[state.moduleType],
        qty: modCount,
        category: 'Scen',
      });

      if (state.stairCount > 0) {
        const stair = getStairForHeight(state.height);
        const positions = state.stairPositions.slice(0, state.stairCount);
        positions.forEach(pos => {
          lines.push({
            artno: stair.artno,
            name: `${prefix} ${stair.name} — placering ${SIDE_LABELS[pos] || pos}`,
            price: stair.price,
            qty: 1,
            category: 'Scen',
          });
        });
        if (state.stairRail) {
          lines.push({
            artno: 'SK-SCN-ACC-0008',
            name: `${prefix} Räcke till scentrapp (40/60 cm)`,
            price: 200,
            qty: state.stairCount,
            category: 'Scen',
          });
        }
      }

      if (state.skirtMode === 'custom') {
        const skirtMeters = sideLengthsTotal('skirt');
        if (skirtMeters > 0) {
          lines.push({
            artno: 'SK-SCN-ACC-0003',
            name: `${prefix} Scenkjol (${skirtMeters} m)`,
            price: Math.round(skirtMeters * SKIRT_PRICE_PER_METER * 100) / 100,
            qty: 1,
            category: 'Scen',
            isCalculated: true,
            metaText: `${skirtMeters} m × 24,75 kr`,
          });
        }
      }

      if (state.railMode === 'custom') {
        const stairSet = new Set(state.stairPositions.slice(0, state.stairCount));
        // Räcken tillåts på ALLA sidor som har räcke valt, inklusive sidor med
        // trappa. På trapp-sidor räknas trappans bredd (1 m) av från sidlängden
        // — om återstoden är < 1 m räknas inget räcke på den sidan.
        const railSidesValid = SIDES.filter(s => state.rail[s]);
        const railTotals = { 'SK-SCN-ACC-0007': 0, 'SK-SCN-ACC-0006': 0 };
        railSidesValid.forEach(side => {
          let len = sideLengthMeters(side);
          if (stairSet.has(side)) len -= 1; // trappan tar 1 m
          if (len < 1) return;              // för smalt för räcke
          const packed = packRail(len);
          railTotals['SK-SCN-ACC-0007'] += packed.count20;
          railTotals['SK-SCN-ACC-0006'] += packed.count10;
        });
        if (railTotals['SK-SCN-ACC-0007'] > 0) {
          lines.push({ artno: 'SK-SCN-ACC-0007', name: `${prefix} Skyddsräcke 2,0 m`, price: 280, qty: railTotals['SK-SCN-ACC-0007'], category: 'Scen' });
        }
        if (railTotals['SK-SCN-ACC-0006'] > 0) {
          lines.push({ artno: 'SK-SCN-ACC-0006', name: `${prefix} Skyddsräcke 1,0 m`, price: 140, qty: railTotals['SK-SCN-ACC-0006'], category: 'Scen' });
        }
      }

      if (state.installation) {
        const totalMin = modCount * 10 * 2;
        const hours = Math.round(totalMin / 60 * 4) / 4;
        const monteringPris = Math.round(hours * MONTERING_PRICE_PER_HOUR);
        lines.push({
          artno: 'SK-TJN-0001',
          name: `${prefix} Montering & demontering (~${formatTime(totalMin)})`,
          price: monteringPris,
          qty: 1,
          category: 'Tjänst',
          isCalculated: true,
          metaText: `${hours} tim × 600 kr`,
        });
      }

      if (state.frakt === 'auto') {
        const fpris = fraktPrice();
        const fartno = fraktArtno();
        if (fpris > 0 && fartno) {
          lines.push({
            artno: fartno,
            name: `${prefix} ${fraktLabel()}`,
            price: fpris,
            qty: 1,
            category: 'Leverans',
          });
        }
      }

      return lines;
    }

    function formatTime(min) {
      const h = Math.floor(min / 60);
      const m = min % 60;
      if (h === 0) return `${m} min`;
      if (m === 0) return `${h} tim`;
      return `${h} tim ${m} min`;
    }

    function sideLengthMeters(side) {
      return (side === 'fram' || side === 'bak') ? state.width : state.depth;
    }

    function sideLengthsTotal(prop) {
      return SIDES.filter(s => state[prop][s]).reduce((sum, s) => sum + sideLengthMeters(s), 0);
    }

    function packRail(meters) {
      let remaining = meters;
      let count20 = 0, count10 = 0;
      while (remaining >= 2 - 0.001) { count20++; remaining -= 2; }
      while (remaining >= 1 - 0.001) { count10++; remaining -= 1; }
      return { count20, count10 };
    }

    function totalPrice(lines) {
      return lines.reduce((sum, l) => sum + l.price * l.qty, 0);
    }

    function renderSVG() {
      const svg = document.getElementById('cfg-svg');
      if (!svg) return;

      if (!isDimValid()) {
        svg.innerHTML = `<text x="300" y="210" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-family="Space Grotesk,sans-serif" font-size="14">Vänligen välj giltiga mått</text>`;
        return;
      }

      const padX = 95, padY = 85;
      const usableW = 600 - 2 * padX;
      const usableH = 420 - 2 * padY;
      const scale = Math.min(usableW / state.width, usableH / state.depth) * 0.95;
      const stageW = state.width * scale;
      const stageD = state.depth * scale;
      const cx = 300, cy = 220;
      const x0 = cx - stageW / 2;
      const y0 = cy - stageD / 2;

      let html = `<defs>
        <pattern id="patHalkfri" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
          <rect width="6" height="6" fill="#3a3370"/>
          <line x1="0" y1="0" x2="0" y2="6" stroke="#5a4ea0" stroke-width="1.2"/>
        </pattern>
      </defs>`;
      const shadowOff = 6;
      html += `<rect x="${x0 + shadowOff}" y="${y0 + shadowOff}" width="${stageW}" height="${stageD}" fill="rgba(0,0,0,0.4)" rx="2"/>`;

      const isHalkfri = state.moduleType.includes('halkfri');
      const moduleFill = isHalkfri ? 'url(#patHalkfri)' : '#3a3370';
      const moduleStroke = '#c4b5f4';

      let mods = [];
      if (state.moduleType === '1x1-halkfri') {
        for (let r = 0; r < state.depth; r++) {
          for (let c = 0; c < state.width; c++) mods.push({ x: c, y: r, w: 1, h: 1 });
        }
      } else {
        if (state.width % 2 === 0) {
          for (let r = 0; r < state.depth; r++) {
            for (let c = 0; c < state.width; c += 2) mods.push({ x: c, y: r, w: 2, h: 1 });
          }
        } else {
          for (let r = 0; r < state.depth; r += 2) {
            for (let c = 0; c < state.width; c++) mods.push({ x: c, y: r, w: 1, h: 2 });
          }
        }
      }
      mods.forEach(m => {
        const mx = x0 + m.x * scale;
        const my = y0 + m.y * scale;
        html += `<rect x="${mx}" y="${my}" width="${m.w * scale}" height="${m.h * scale}" fill="${moduleFill}" stroke="${moduleStroke}" stroke-width="1" stroke-opacity="0.4" />`;
      });
      html += `<rect x="${x0}" y="${y0}" width="${stageW}" height="${stageD}" fill="none" stroke="#c4b5f4" stroke-width="2" stroke-opacity="0.8" />`;

      if (state.skirtMode === 'custom') {
        Object.keys(state.skirt).forEach(side => {
          if (!state.skirt[side]) return;
          const t = 6;
          if (side === 'fram') html += `<rect x="${x0}" y="${y0 + stageD - t}" width="${stageW}" height="${t}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
          if (side === 'bak') html += `<rect x="${x0}" y="${y0}" width="${stageW}" height="${t}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
          if (side === 'vanster') html += `<rect x="${x0}" y="${y0}" width="${t}" height="${stageD}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
          if (side === 'hoger') html += `<rect x="${x0 + stageW - t}" y="${y0}" width="${t}" height="${stageD}" fill="#000" stroke="#c4b5f4" stroke-width="0.5"/>`;
        });
      }

      const stairSet = new Set(state.stairPositions.slice(0, state.stairCount));
      if (state.railMode === 'custom') {
        // Räcken ritas på ALLA sidor som har räcke valt. På trapp-sidor delas
        // räcket i två segment som flankerar trappan (trappan är 20% av min-
        // dimensionen i SVG och placeras i mitten av sidan).
        Object.keys(state.rail).forEach(side => {
          if (!state.rail[side]) return;
          const off = 4;
          const hasStair = stairSet.has(side);
          const stairWidthSvg = Math.min(stageW, stageD) * 0.20;
          // Räcke ritas i 1 eller 2 segment per sida:
          //   ingen trappa  → [0 → längd]
          //   med trappa   → [0 → (mitt - sw/2)] + [(mitt + sw/2) → längd]
          function railSegments(totalLen) {
            if (!hasStair) return [[0, totalLen]];
            const mid = totalLen / 2;
            const half = stairWidthSvg / 2;
            return [[0, mid - half], [mid + half, totalLen]].filter(s => s[1] - s[0] > 2);
          }
          if (side === 'fram') {
            railSegments(stageW).forEach(([a, b]) => {
              html += `<line x1="${x0 + a}" y1="${y0 + stageD + off}" x2="${x0 + b}" y2="${y0 + stageD + off}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
            });
          }
          if (side === 'bak') {
            railSegments(stageW).forEach(([a, b]) => {
              html += `<line x1="${x0 + a}" y1="${y0 - off}" x2="${x0 + b}" y2="${y0 - off}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
            });
          }
          if (side === 'vanster') {
            railSegments(stageD).forEach(([a, b]) => {
              html += `<line x1="${x0 - off}" y1="${y0 + a}" x2="${x0 - off}" y2="${y0 + b}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
            });
          }
          if (side === 'hoger') {
            railSegments(stageD).forEach(([a, b]) => {
              html += `<line x1="${x0 + stageW + off}" y1="${y0 + a}" x2="${x0 + stageW + off}" y2="${y0 + b}" stroke="#c4b5f4" stroke-width="3" stroke-linecap="round"/>`;
            });
          }
        });
      }

      // Trappor — rektangel med horisontella streck (sett uppifrån) + "Trappa"-etikett
      const stairsArr = state.stairPositions.slice(0, state.stairCount);
      stairsArr.forEach(side => {
        const sw = Math.min(stageW, stageD) * 0.20;
        const sd = sw * 0.8;
        let sx, sy, w, h;
        if (side === 'fram') { sx = x0 + stageW / 2 - sw / 2; sy = y0 + stageD; w = sw; h = sd; }
        if (side === 'bak') { sx = x0 + stageW / 2 - sw / 2; sy = y0 - sd; w = sw; h = sd; }
        if (side === 'vanster') { sx = x0 - sd; sy = y0 + stageD / 2 - sw / 2; w = sd; h = sw; }
        if (side === 'hoger') { sx = x0 + stageW; sy = y0 + stageD / 2 - sw / 2; w = sd; h = sw; }
        html += `<g>`;
        html += `<rect x="${sx}" y="${sy}" width="${w}" height="${h}" fill="#2d2670" stroke="#c4b5f4" stroke-width="1.8" rx="3"/>`;
        if (side === 'vanster' || side === 'hoger') {
          for (let i = 1; i < 4; i++) {
            const lx = sx + (w * i / 4);
            html += `<line x1="${lx}" y1="${sy + 3}" x2="${lx}" y2="${sy + h - 3}" stroke="#c4b5f4" stroke-width="1.4" stroke-opacity="0.95"/>`;
          }
        } else {
          for (let i = 1; i < 4; i++) {
            const ly = sy + (h * i / 4);
            html += `<line x1="${sx + 3}" y1="${ly}" x2="${sx + w - 3}" y2="${ly}" stroke="#c4b5f4" stroke-width="1.4" stroke-opacity="0.95"/>`;
          }
        }
        // "Trappa"-text — placeras utanför trappan (mot motsatt riktning från scenen)
        const trappaStyle = `fill="#c4b5f4" font-family="Space Grotesk,sans-serif" font-size="10" font-weight="700" letter-spacing="0.5"`;
        if (side === 'fram') {
          html += `<text x="${sx + w / 2}" y="${sy + h + 13}" text-anchor="middle" ${trappaStyle}>Trappa</text>`;
        } else if (side === 'bak') {
          html += `<text x="${sx + w / 2}" y="${sy - 5}" text-anchor="middle" ${trappaStyle}>Trappa</text>`;
        } else if (side === 'vanster') {
          html += `<text x="${sx - 6}" y="${sy + h / 2 + 3}" text-anchor="end" ${trappaStyle}>Trappa</text>`;
        } else if (side === 'hoger') {
          html += `<text x="${sx + w + 6}" y="${sy + h / 2 + 3}" text-anchor="start" ${trappaStyle}>Trappa</text>`;
        }
        html += `</g>`;
      });

      const labelStyle = `fill="rgba(255,255,255,0.6)" font-family="Space Grotesk,sans-serif" font-size="12" font-weight="600"`;
      html += `<text x="${x0 + stageW / 2}" y="${y0 + stageD + 70}" text-anchor="middle" ${labelStyle}>Bredd: ${state.width} m (Fram)</text>`;
      html += `<text x="${x0 + stageW / 2}" y="${y0 - 48}" text-anchor="middle" ${labelStyle} fill-opacity="0.45">${state.width} m (Bak)</text>`;
      html += `<text x="${x0 - 48}" y="${y0 + stageD / 2}" text-anchor="middle" ${labelStyle} transform="rotate(-90 ${x0 - 48} ${y0 + stageD / 2})">${state.depth} m</text>`;
      html += `<text x="20" y="30" fill="rgba(196,181,244,0.6)" font-family="Space Grotesk,sans-serif" font-size="10" font-weight="700" letter-spacing="1.5">↑ BAK · ↓ FRAM (mot publik)</text>`;

      svg.innerHTML = html;
    }

    function renderMeta() {
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      if (isDimValid()) {
        const area = state.width * state.depth;
        set('cfg-display-dim', `${state.width} × ${state.depth} m = ${area} m²`);
        set('cfg-display-height', `${state.height} cm`);
        set('cfg-display-modules', `${moduleCount()} st`);
      } else {
        set('cfg-display-dim', '— m');
        set('cfg-display-height', `${state.height} cm`);
        set('cfg-display-modules', '— st');
      }
    }

    function renderStairPlacement() {
      const wrap = document.getElementById('cfg-stair-placement');
      const railRow = document.getElementById('cfg-stair-rail-row');
      if (!wrap) return;
      const n = state.stairCount;
      // Toggle räcke-checkbox baserat på antal trappor
      if (railRow) {
        if (n === 0) {
          railRow.hidden = true;
          if (state.stairRail) {
            state.stairRail = false;
            const cb = document.getElementById('cfg-stair-rail');
            if (cb) cb.checked = false;
          }
        } else {
          railRow.hidden = false;
        }
      }
      if (n === 0) { wrap.innerHTML = ''; return; }
      let html = '<p class="cfg-hint cfg-hint-block">Placering:</p>';
      for (let i = 0; i < n; i++) {
        html += `<div class="cfg-stair-row">
          <span class="cfg-stair-num">Trappa ${i + 1}</span>
          <select data-stair-idx="${i}" class="cfg-select">
            ${SIDES.map(s => `<option value="${s}" ${state.stairPositions[i] === s ? 'selected' : ''}>${SIDE_LABELS[s]}</option>`).join('')}
          </select>
        </div>`;
      }
      wrap.innerHTML = html;
      wrap.querySelectorAll('select[data-stair-idx]').forEach(sel => {
        sel.addEventListener('change', e => {
          const idx = parseInt(e.target.dataset.stairIdx, 10);
          state.stairPositions[idx] = e.target.value;
          render();
        });
      });
    }

    function renderValidation() {
      const warn = document.getElementById('cfg-dim-warning');
      const cartBtn = document.getElementById('cfg-add-to-cart');
      if (!warn) return;

      const area = state.width * state.depth;
      const dimRangeOK = state.width >= 2 && state.width <= 12 && state.depth >= 2 && state.depth <= 8;
      const evenSideOK = state.moduleType === '1x1-halkfri' || (state.width % 2 === 0) || (state.depth % 2 === 0);

      let warning = '';
      if (!dimRangeOK) {
        warning = '⚠ Måtten ligger utanför tillåtet intervall (min 2 m, max 12×8 m).';
      } else if (state.moduleType === '1x1-halkfri' && area > 20) {
        warning = `⚠ 1×1-modulerna räcker till max 20 m² (${area} m² valt). Välj 1×2-moduler för större scen, eller minska måtten.`;
      } else if (!evenSideOK) {
        const altW = state.width + 1 <= 12 ? state.width + 1 : null;
        const altD = state.depth + 1 <= 8 ? state.depth + 1 : null;
        const sugg = altW && altD ? ` Välj t.ex. ${altW}×${state.depth} eller ${state.width}×${altD},` : '';
        warning = `⚠ Med 1×2-moduler måste antingen bredd eller djup vara jämn.${sugg} eller använd 1×1-moduler.`;
      }
      warn.textContent = warning;

      const valid = isDimValid();
      if (cartBtn) {
        cartBtn.disabled = !valid;
      }

      // 1×1 → lås höjd till 40 cm
      const height60 = document.querySelector('input[name="height"][value="60"]');
      const height40 = document.querySelector('input[name="height"][value="40"]');
      const pill60 = document.querySelector('.cfg-pill-height-60');
      if (state.moduleType === '1x1-halkfri') {
        if (state.height !== 40) {
          state.height = 40;
          if (height40) height40.checked = true;
        }
        if (height60) height60.disabled = true;
        if (pill60) pill60.classList.add('cfg-pill-disabled');
      } else {
        if (height60) height60.disabled = false;
        if (pill60) pill60.classList.remove('cfg-pill-disabled');
      }

      // Räcken på trapp-sidor är nu tillåtna (trappan tar av 1 m från sidans
      // räcke-längd). Lägg en hint via title så användaren förstår.
      const stairSet = new Set(state.stairPositions.slice(0, state.stairCount));
      document.querySelectorAll('input[name="rail"]').forEach(cb => {
        const side = cb.dataset.side;
        cb.disabled = false;
        cb.parentElement?.classList.remove('cfg-side-disabled');
        if (stairSet.has(side)) {
          cb.title = 'Räcket delas på sidor med trappa (trappan tar 1 m).';
          cb.parentElement?.classList.add('cfg-side-with-stair');
        } else {
          cb.title = '';
          cb.parentElement?.classList.remove('cfg-side-with-stair');
        }
      });

      // Visa/dölj custom-paneler
      const skirtSides = document.getElementById('cfg-skirt-sides');
      const railSides = document.getElementById('cfg-rail-sides');
      if (skirtSides) skirtSides.classList.toggle('cfg-collapsed', state.skirtMode !== 'custom');
      if (railSides) railSides.classList.toggle('cfg-collapsed', state.railMode !== 'custom');

      // Frakt-rekommendation + trip-toggle visas bara om Leverans valt
      const recEl = document.getElementById('cfg-frakt-rec');
      const tripRow = document.getElementById('cfg-frakt-trip-row');
      if (state.frakt === 'auto') {
        const rec = getRecommendedFrakt();
        if (recEl) {
          if (rec) {
            const pris = formatKr(fraktPrice());
            recEl.textContent = `Vi väljer ${FRAKT_LABELS[rec]} baserat på ${moduleCount()} moduler — ${pris}.`;
          } else {
            recEl.textContent = '';
          }
        }
        if (tripRow) tripRow.classList.remove('cfg-collapsed-row');
      } else {
        if (recEl) recEl.textContent = 'Vi väljer rätt fordon automatiskt baserat på storleken.';
        if (tripRow) tripRow.classList.add('cfg-collapsed-row');
      }
    }

    function renderInstallation() {
      const area = state.width * state.depth;
      const installCb = document.getElementById('cfg-installation');
      const installLabel = document.getElementById('cfg-installation-label');
      const installHint = document.getElementById('cfg-installation-hint');
      const minutes = moduleCount() * 10 * 2;
      const hours = Math.round(minutes / 60 * 4) / 4;
      const pris = Math.round(hours * MONTERING_PRICE_PER_HOUR);

      // Frakt-radioknappar — "Hämta själv" och "Leverans"
      const fraktNone = document.querySelector('input[name="frakt"][value="none"]');
      const fraktAuto = document.querySelector('input[name="frakt"][value="auto"]');
      const fraktNonePill = fraktNone?.closest('.cfg-pill');

      if (area > OBLIG_OVER_M2) {
        if (installCb) { installCb.checked = true; installCb.disabled = true; }
        state.installation = true;
        // Vid stora scener sköter våra tekniker alltid montering — och då levererar vi.
        if (fraktNone) fraktNone.disabled = true;
        if (fraktNonePill) fraktNonePill.classList.add('cfg-pill-disabled');
        if (state.frakt !== 'auto') {
          state.frakt = 'auto';
          if (fraktAuto) fraktAuto.checked = true;
        }
        if (installLabel) installLabel.textContent = '🔧 Våra tekniker sköter alltid montering vid scen över 16 m² — för säker hantering';
        if (installHint) installHint.textContent = `Tillkommer separat: montering + demontering ca ${formatTime(minutes)} (${hours} tim × 600 kr ≈ ${formatKr(pris)}). Vi levererar alltid när vi monterar.`;
      } else {
        if (installCb) installCb.disabled = false;
        // Återaktivera "Hämta själv"-pillen
        if (fraktNone) fraktNone.disabled = false;
        if (fraktNonePill) fraktNonePill.classList.remove('cfg-pill-disabled');
        if (installLabel) installLabel.textContent = 'Lägg till montering & demontering — tillkommer separat';
        if (installHint) {
          if (state.installation) {
            installHint.textContent = `Tillkommer separat: ${formatTime(minutes)} (${hours} tim × 600 kr ≈ ${formatKr(pris)}).`;
          } else {
            installHint.textContent = 'Vi monterar och demonterar åt dig — 10 min/modul × 2. Pris timdebiteras (600 kr/tim). Tillkommer separat. Vid scen över 16 m² sköter våra tekniker alltid montering.';
          }
        }
      }
    }

    function renderSpec() {
      const list = document.getElementById('cfg-spec-list');
      if (!list) return;
      const lines = computeLineItems();
      if (lines.length === 0) {
        list.innerHTML = '<li class="cfg-spec-empty">Välj giltiga mått för att se specifikation.</li>';
        const totalEx = document.getElementById('cfg-total-excl');
        const totalIn = document.getElementById('cfg-total-incl');
        if (totalEx) totalEx.textContent = '0 kr';
        if (totalIn) totalIn.textContent = '0 kr';
        return;
      }

      function renderRow(l) {
        const lineSum = l.price * l.qty;
        const meta = l.metaText ? ` <span class="cfg-spec-meta">(${l.metaText})</span>` : '';
        const qtyText = l.isCalculated ? '' : `<span class="cfg-spec-qty">${l.qty}×</span>`;
        return `<li class="cfg-spec-row">
          <div class="cfg-spec-name">
            ${qtyText}<span>${l.name}</span>${meta}
          </div>
          <div class="cfg-spec-price">
            <span class="sk-price-excl">${formatKr(lineSum)}</span>
            <span class="sk-price-incl hidden">${formatKr(Math.round(lineSum * 1.25))}</span>
          </div>
        </li>`;
      }

      // Gruppera: hårdvara (Scen) vs tillkommer (Tjänst + Leverans)
      const hardvara = lines.filter(l => l.category === 'Scen');
      const tillkommer = lines.filter(l => l.category === 'Tjänst' || l.category === 'Leverans');

      let html = '';
      hardvara.forEach(l => { html += renderRow(l); });

      if (tillkommer.length > 0) {
        const tillkommerSum = tillkommer.reduce((s, l) => s + l.price * l.qty, 0);
        html += `<li class="cfg-spec-divider"><span>Tillkommer separat</span></li>`;
        tillkommer.forEach(l => { html += renderRow(l); });
        html += `<li class="cfg-spec-subtotal">
          <div class="cfg-spec-name"><span>Tillkommer totalt</span></div>
          <div class="cfg-spec-price">
            <span class="sk-price-excl">${formatKr(tillkommerSum)}</span>
            <span class="sk-price-incl hidden">${formatKr(Math.round(tillkommerSum * 1.25))}</span>
          </div>
        </li>`;
      }

      list.innerHTML = html;

      // TOTAL = bara hårdvara
      const hardvaraSum = hardvara.reduce((s, l) => s + l.price * l.qty, 0);
      const totalEx = document.getElementById('cfg-total-excl');
      const totalIn = document.getElementById('cfg-total-incl');
      if (totalEx) totalEx.textContent = formatKr(hardvaraSum);
      if (totalIn) totalIn.textContent = formatKr(Math.round(hardvaraSum * 1.25));

      // Komplett-pris (hårdvara + tillkommer) som mindre rad
      const kompletEl = document.getElementById('cfg-total-komplett');
      if (kompletEl) {
        if (tillkommer.length > 0) {
          const kompletSum = totalPrice(lines);
          kompletEl.innerHTML = `Komplett med tillkommande: <span class="sk-price-excl">~${formatKr(kompletSum)}</span><span class="sk-price-incl hidden">~${formatKr(Math.round(kompletSum * 1.25))}</span>`;
          kompletEl.style.display = '';
        } else {
          kompletEl.style.display = 'none';
        }
      }
    }

    function formatKr(n) {
      return new Intl.NumberFormat('sv-SE').format(Math.round(n)) + ' kr';
    }

    function render() {
      // OBS: renderInstallation kan ändra state.frakt till 'auto' vid obligatorisk
      // montering (≥16 m²). Den måste därför köras FÖRE renderValidation som
      // läser state.frakt och uppdaterar frakt-UI.
      renderInstallation();
      renderValidation();
      renderMeta();
      renderStairPlacement();
      renderSVG();
      renderSpec();
    }

    document.querySelectorAll('input[name="moduleType"]').forEach(el => {
      el.addEventListener('change', e => { state.moduleType = e.target.value; render(); });
    });

    document.querySelectorAll('input[name="height"]').forEach(el => {
      el.addEventListener('change', e => { state.height = parseInt(e.target.value, 10); render(); });
    });
    document.querySelectorAll('input[name="stairCount"]').forEach(el => {
      el.addEventListener('change', e => {
        state.stairCount = parseInt(e.target.value, 10);
        while (state.stairPositions.length < state.stairCount) {
          const used = new Set(state.stairPositions);
          const next = SIDES.find(s => !used.has(s)) || 'fram';
          state.stairPositions.push(next);
        }
        render();
      });
    });
    const stairRailCheckbox = document.getElementById('cfg-stair-rail');
    if (stairRailCheckbox) {
      stairRailCheckbox.addEventListener('change', e => {
        state.stairRail = e.target.checked;
        render();
      });
    }
    document.querySelectorAll('input[name="skirtMode"]').forEach(el => {
      el.addEventListener('change', e => {
        state.skirtMode = e.target.value;
        if (state.skirtMode === 'none') {
          SIDES.forEach(s => { state.skirt[s] = false; });
          document.querySelectorAll('input[name="skirt"]').forEach(cb => cb.checked = false);
        }
        render();
      });
    });
    document.querySelectorAll('input[name="skirt"]').forEach(el => {
      el.addEventListener('change', e => { state.skirt[e.target.dataset.side] = e.target.checked; render(); });
    });
    document.querySelectorAll('input[name="railMode"]').forEach(el => {
      el.addEventListener('change', e => {
        state.railMode = e.target.value;
        if (state.railMode === 'none') {
          SIDES.forEach(s => { state.rail[s] = false; });
          document.querySelectorAll('input[name="rail"]').forEach(cb => cb.checked = false);
        }
        render();
      });
    });
    document.querySelectorAll('input[name="rail"]').forEach(el => {
      el.addEventListener('change', e => { state.rail[e.target.dataset.side] = e.target.checked; render(); });
    });

    const widthInput = document.getElementById('cfg-width');
    const depthInput = document.getElementById('cfg-depth');
    widthInput?.addEventListener('input', e => { state.width = parseInt(e.target.value, 10) || 0; render(); });
    depthInput?.addEventListener('input', e => { state.depth = parseInt(e.target.value, 10) || 0; render(); });
    document.querySelectorAll('button[data-dim-step]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dim = btn.dataset.dimStep;
        const dir = parseInt(btn.dataset.dir, 10);
        if (dim === 'width') {
          state.width = Math.max(2, Math.min(12, state.width + dir));
          if (widthInput) widthInput.value = state.width;
        } else {
          state.depth = Math.max(2, Math.min(8, state.depth + dir));
          if (depthInput) depthInput.value = state.depth;
        }
        render();
      });
    });

    document.getElementById('cfg-installation')?.addEventListener('change', e => {
      if (!e.target.disabled) {
        state.installation = e.target.checked;
        render();
      }
    });

    document.querySelectorAll('input[name="frakt"]').forEach(el => {
      el.addEventListener('change', e => { state.frakt = e.target.value; render(); });
    });
    document.querySelectorAll('input[name="fraktTrip"]').forEach(el => {
      el.addEventListener('change', e => { state.fraktTrip = e.target.value; render(); });
    });

    document.getElementById('cfg-add-to-cart')?.addEventListener('click', () => {
      if (!isDimValid()) {
        feedback('Vänligen välj giltiga mått innan du lägger till.', 'error');
        return;
      }
      const lines = computeLineItems();
      if (lines.length === 0) {
        feedback('Tomt — välj minst plattform.', 'error');
        return;
      }
      if (!window.skCart || typeof window.skCart.add !== 'function') {
        feedback('Varukorgen är inte tillgänglig på den här sidan.', 'error');
        return;
      }

      // Filtrera bort Tjänst (montering) och Leverans (frakt) från cart-rader.
      // Dessa hamnar istället under "Tilläggstjänster" i varukorgen via
      // bulky/monteringMin/forceLeverans-flaggor på plattformsmodul-raden.
      const cartLines = lines.filter(l => l.category !== 'Tjänst' && l.category !== 'Leverans');
      const platformArtnos = Object.values(MODULE_ARTNO);

      cartLines.forEach(l => {
        const isPlatform = platformArtnos.includes(l.artno);
        const item = {
          id: l.artno,
          artno: l.artno,
          name: l.name,
          price: l.price,
          category: l.category || 'Scen',
          qty: l.qty,
        };
        if (isPlatform) {
          item.bulky = true;
          if (state.installation) {
            item.monteringMin = 10;
            item.requiresAssembly = true;
          }
          if (state.frakt === 'auto') {
            const lev = getRecommendedFrakt();
            if (lev) item.forceLeverans = lev;
          }
        }
        window.skCart.add(item);
      });

      const totalSum = totalPrice(lines);
      feedback(`✓ Lade ${cartLines.length} rader i varukorgen — ${formatKr(totalSum)}/dygn.`, 'success');
    });

    function feedback(msg, kind) {
      const el = document.getElementById('cfg-cart-feedback');
      if (!el) return;
      el.textContent = msg;
      el.className = `cfg-cart-feedback ${kind === 'error' ? 'is-error' : 'is-success'}`;
      setTimeout(() => { el.textContent = ''; el.className = 'cfg-cart-feedback'; }, 5000);
    }

    render();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConfigurator);
  } else {
    initConfigurator();
  }
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('scene-configurator');
    if (root) { delete root.dataset.cfgReady; initConfigurator(); }
  });
})();
</script>

