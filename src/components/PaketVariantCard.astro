---
/**
 * PaketVariantCard.astro — paketkort med variantväljare OCH bildgalleri.
 *
 * Kombinerar MediaCards galleri (bilder + videoslides med ‹ ›-pilar och dots)
 * med MixerModelCards modellväljare. Varje variant är en egen katalogpost med
 * eget artikelnummer — endast den valda varianten läggs i varukorgen.
 *
 * Props:
 *   title       — grupprubrik, t.ex. "Ljuspaket, Small"
 *   selectLabel — etikett ovanför väljaren (default "Välj storlek")
 *   category    — varukorgskategori
 *   models      — 1+ varianter, första = förvald. Vid 1 variant döljs väljaren.
 */
interface Model {
  artno: string;
  name: string;
  price: number;
  image: string;
  alt?: string;
  description?: string;
  specs?: string[];
  persons?: string;
  manualUrl?: string;
  bulky?: boolean;
  forceLeverans?: string;
  videos?: string[];
  shortLabel: string;
}
interface Props {
  title: string;
  selectLabel?: string;
  category?: string;
  models: Model[];
  priceNote?: string;
}
const {
  title, selectLabel = 'Välj storlek', category = 'Färdiga ljuspaket',
  models, priceNote = '/dygn',
} = Astro.props;

const uid = `pvc-${Math.random().toString(36).slice(2, 8)}`;
const first = models[0];
const multi = models.length > 1;

const payload = JSON.stringify(models.map(m => ({
  id: m.artno, artno: m.artno, name: m.name, price: m.price,
  image: m.image, alt: m.alt ?? m.name, description: m.description ?? '',
  specs: m.specs ?? [], persons: m.persons ?? '', manualUrl: m.manualUrl ?? '',
  bulky: m.bulky ?? false, forceLeverans: m.forceLeverans ?? undefined,
  category,
  slides: [{ type: 'image', src: m.image },
           ...(m.videos ?? []).map(v => ({ type: 'video', src: `/videos/${v}` }))],
})));

const firstSlides = 1 + (first.videos ?? []).length;

const productJson = JSON.stringify({
  name: first.name, artno: first.artno, desc: (first.specs ?? []).join('||'),
  rows: [], price: first.price, priceNote, category, cartId: first.artno,
  images: [first.image], videos: (first.videos ?? []).map(v => `/videos/${v}`),
  persons: first.persons ?? '', manualUrl: first.manualUrl ?? '',
});
---
<article
  class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group h-full flex flex-col"
  itemscope itemtype="https://schema.org/Product"
  data-pvc={uid}
  data-pvc-models={payload}
  data-sk-product={productJson}
  style="cursor:pointer"
>
  <!-- GALLERI -->
  <div class="relative bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
    <div class="pvc-area w-full h-full" id={`${uid}-area`}>
      <img src={first.image} alt={first.alt ?? first.name} width="512" height="427" loading="lazy"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
    </div>
    {firstSlides > 1 && (
      <>
        <button class="pvc-arr absolute left-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-8 flex items-center justify-center bg-black/65 hover:bg-brand-orange/70 border border-white/15 rounded-md text-white text-base leading-none transition-colors"
          data-pvc-dir="-1" aria-label="Föregående">‹</button>
        <button class="pvc-arr absolute right-1.5 top-1/2 -translate-y-1/2 z-10 w-7 h-8 flex items-center justify-center bg-black/65 hover:bg-brand-orange/70 border border-white/15 rounded-md text-white text-base leading-none transition-colors"
          data-pvc-dir="1" aria-label="Nästa">›</button>
        <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 z-10 flex gap-1" id={`${uid}-dots`}></div>
      </>
    )}
  </div>

  <meta itemprop="image" content={`https://scenkonsult.se${first.image}`} />
  <meta itemprop="brand" content="Scenkonsult Norden" />

  <!-- INNEHÅLL -->
  <div class="p-5 flex flex-col flex-1">
    <div class="text-brand-orange text-[10px] font-semibold uppercase tracking-wider mb-1" id={`${uid}-persons`}>{first.persons}</div>
    <h2 class="font-bold text-white leading-snug mb-2 group-hover:text-brand-orange transition-colors" style="font-size:17px" itemprop="name" id={`${uid}-name`}>{multi ? title : first.name}</h2>
    <p class="artno-badge mb-2" id={`${uid}-artno`}>{first.artno}</p>
    <p class="text-gray-400 text-sm leading-relaxed mb-3" itemprop="description" id={`${uid}-desc`}>{first.description}</p>

    <ul class="space-y-1 border-t border-white/10 pt-3" id={`${uid}-specs`}>
      {(first.specs ?? []).map(s => (
        <li class="text-gray-400 text-xs flex gap-1.5"><span class="text-green-400 shrink-0 mt-0.5">▸</span><span>{s}</span></li>
      ))}
    </ul>

    {multi && (
      <div class="mt-4 border-t border-white/10 pt-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-2">{selectLabel}</p>
        <div class={`grid gap-2 ${models.length >= 3 ? 'grid-cols-3' : 'grid-cols-2'}`} role="group" aria-label={selectLabel}>
          {models.map((m, i) => (
            <button
              type="button"
              class:list={[
                'pvc-opt text-left rounded-lg border px-2.5 py-2 transition-all',
                i === 0 ? 'border-brand-orange bg-brand-orange/10' : 'border-white/15 bg-transparent',
              ]}
              data-pvc-index={i}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="block text-[11px] font-semibold text-white leading-tight">{m.shortLabel}</span>
              <span class="block text-[11px] mt-0.5">
                <span class="sk-price-excl text-brand-orange font-bold">{m.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-bold">{Math.round(m.price * 1.25).toLocaleString('sv')} kr</span>
              </span>
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="flex-1 min-h-[0.5rem]"></div>

    <div class="mt-auto flex flex-col border-t border-white/10 pt-3 gap-2" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
      <meta itemprop="priceCurrency" content="SEK" />
      <meta itemprop="price" content={String(first.price)} />
      <meta itemprop="priceValidUntil" content="2027-12-31" />
      <meta itemprop="availability" content="https://schema.org/InStock" />
      <meta itemprop="seller" content="Scenkonsult Norden" />
      <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
        <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion">
          <meta itemprop="addressCountry" content="SE" />
        </div>
        <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount">
          <meta itemprop="currency" content="SEK" />
          <meta itemprop="value" content="0" />
        </div>
        <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
          <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" />
          </div>
          <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue">
            <meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" />
          </div>
        </div>
      </div>
      <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
        <meta itemprop="applicableCountry" content="SE" />
        <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
        <meta itemprop="merchantReturnDays" content="1" />
        <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
        <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
      </div>

      <div class="flex items-center justify-between gap-3">
        <div class="shrink-0 leading-none" id={`${uid}-price`}>
          <span class="sk-price-excl text-brand-orange font-extrabold" style="font-size:17px">{first.price.toLocaleString('sv')} kr</span>
          <span class="sk-price-incl hidden text-brand-orange font-extrabold" style="font-size:17px">{Math.round(first.price * 1.25).toLocaleString('sv')} kr</span>
          <div class="text-gray-400 text-[10px] mt-0.5">{priceNote}</div>
        </div>
        <button
          type="button"
          class="pvc-add inline-flex items-center whitespace-nowrap px-4 py-2 text-sm gap-2 bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-semibold rounded-lg transition-all duration-200"
          aria-label={`Lägg ${title} i varukorgen`}
        >
          <svg class="pvc-icon-add shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <svg class="pvc-icon-check shrink-0 hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="pvc-label">Lägg i varukorg</span>
        </button>
      </div>

      <a id={`${uid}-manual`} href={first.manualUrl ?? '#'} target="_blank" rel="noopener noreferrer"
        class:list={['inline-flex items-center gap-1.5 text-[11px] text-gray-400 hover:text-brand-orange transition-colors w-fit', !first.manualUrl && 'hidden']}>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Ladda ned manual (PDF)
      </a>
    </div>
  </div>
</article>

<script>
// PaketVariantCard — galleri + variantväljare. Self-contained per kort.
(function () {
  function fmt(n: number) { return n.toLocaleString('sv') + ' kr'; }

  function initCard(card: HTMLElement) {
    if (card.dataset.pvcReady === '1') return;
    card.dataset.pvcReady = '1';

    let models: any[];
    try { models = JSON.parse(card.dataset.pvcModels || '[]'); } catch { return; }
    if (!models.length) return;

    const uid      = card.dataset.pvc!;
    const area     = document.getElementById(`${uid}-area`) as HTMLElement | null;
    const dotsEl   = document.getElementById(`${uid}-dots`) as HTMLElement | null;
    const nameEl   = document.getElementById(`${uid}-name`);
    const personsEl= document.getElementById(`${uid}-persons`);
    const artnoEl  = document.getElementById(`${uid}-artno`);
    const descEl   = document.getElementById(`${uid}-desc`);
    const specsEl  = document.getElementById(`${uid}-specs`);
    const priceEl  = document.getElementById(`${uid}-price`);
    const manualEl = document.getElementById(`${uid}-manual`) as HTMLAnchorElement | null;
    const optBtns  = Array.from(card.querySelectorAll('.pvc-opt')) as HTMLElement[];
    const addBtn   = card.querySelector('.pvc-add') as HTMLElement | null;
    const multi    = optBtns.length > 1;

    let mi = 0;   // vald variant
    let si = 0;   // aktuellt slide

    function slides() { return models[mi].slides || []; }

    function renderSlide() {
      if (!area) return;
      const s = slides()[si];
      if (!s) return;

      const oldVideo = area.querySelector('video');
      if (oldVideo) { oldVideo.pause(); oldVideo.removeAttribute('src'); }

      if (s.type === 'video') {
        area.innerHTML = `
          <video src="${s.src}" autoplay muted loop playsinline class="w-full h-full object-cover" style="display:block"></video>
          <div style="position:absolute;top:8px;left:8px;display:flex;align-items:center;gap:5px;background:rgba(12,10,36,.75);border:1px solid rgba(196,181,244,.3);border-radius:4px;padding:3px 8px;font-size:9px;color:rgba(196,181,244,.85);font-weight:700;letter-spacing:.04em;pointer-events:none">
            <span style="width:6px;height:6px;border-radius:50%;background:#c4b5f4;animation:pvcPulse 1.1s ease-in-out infinite;flex-shrink:0"></span>SPELAS
          </div>`;
      } else {
        area.innerHTML = `<img src="${s.src}" alt="" width="512" height="427" loading="lazy" class="w-full h-full object-contain" style="display:block;transition:transform .3s" />`;
      }

      if (dotsEl) {
        dotsEl.innerHTML = slides().map((sl: any, i: number) =>
          `<button class="pvc-dot transition-all ${i === si ? 'bg-brand-orange w-2.5 h-2' : 'bg-white/30 w-2 h-2'} ${sl.type === 'video' ? 'rounded-sm' : 'rounded-full'}" data-pvc-goto="${i}" aria-label="Slide ${i + 1}"></button>`
        ).join('');
      }
      const arrows = card.querySelectorAll('.pvc-arr');
      arrows.forEach(a => (a as HTMLElement).style.display = slides().length > 1 ? '' : 'none');
      if (dotsEl) dotsEl.style.display = slides().length > 1 ? '' : 'none';
    }

    function paint() {
      const m = models[mi];
      if (nameEl && !multi) nameEl.textContent = m.name;
      if (personsEl) personsEl.textContent = m.persons || '';
      if (artnoEl) artnoEl.textContent = m.artno;
      if (descEl) descEl.textContent = m.description || '';
      if (specsEl) {
        specsEl.innerHTML = (m.specs || []).map((s: string) =>
          `<li class="text-gray-400 text-xs flex gap-1.5"><span class="text-green-400 shrink-0 mt-0.5">▸</span><span>${s}</span></li>`
        ).join('');
      }
      if (priceEl) {
        const ex = priceEl.querySelector('.sk-price-excl');
        const inc = priceEl.querySelector('.sk-price-incl');
        if (ex) ex.textContent = fmt(m.price);
        if (inc) inc.textContent = fmt(Math.round(m.price * 1.25));
      }
      if (manualEl) {
        if (m.manualUrl) { manualEl.setAttribute('href', m.manualUrl); manualEl.classList.remove('hidden'); }
        else manualEl.classList.add('hidden');
      }
      si = 0;
      renderSlide();
    }

    optBtns.forEach(b => b.addEventListener('click', (e) => {
      e.stopPropagation();
      mi = parseInt(b.dataset.pvcIndex || '0', 10);
      optBtns.forEach((x, i) => {
        const on = i === mi;
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
        x.classList.toggle('border-brand-orange', on);
        x.classList.toggle('bg-brand-orange/10', on);
        x.classList.toggle('border-white/15', !on);
        x.classList.toggle('bg-transparent', !on);
      });
      paint();
    }));

    card.querySelectorAll('.pvc-arr').forEach(a => a.addEventListener('click', (e) => {
      e.stopPropagation();
      const dir = parseInt((a as HTMLElement).dataset.pvcDir || '1', 10);
      const n = slides().length;
      si = (si + dir + n) % n;
      renderSlide();
    }));

    if (dotsEl) dotsEl.addEventListener('click', (e) => {
      const dot = (e.target as Element).closest('.pvc-dot') as HTMLElement | null;
      if (!dot) return;
      e.stopPropagation();
      si = parseInt(dot.dataset.pvcGoto || '0', 10);
      renderSlide();
    });

    if (addBtn) addBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const cart = (window as any).skCart;
      if (!cart || typeof cart.add !== 'function') return;
      const m = models[mi];
      cart.add({ id: m.id, name: m.name, price: m.price, artno: m.artno,
                 category: m.category, image: m.image, bulky: m.bulky,
                 forceLeverans: m.forceLeverans, qty: 1 });
      const iAdd = addBtn.querySelector('.pvc-icon-add');
      const iChk = addBtn.querySelector('.pvc-icon-check');
      const lbl  = addBtn.querySelector('.pvc-label');
      iAdd?.classList.add('hidden'); iChk?.classList.remove('hidden');
      if (lbl) lbl.textContent = 'Tillagd!';
      addBtn.style.background = '#7c3aed';
      setTimeout(() => {
        iAdd?.classList.remove('hidden'); iChk?.classList.add('hidden');
        if (lbl) lbl.textContent = 'Lägg i varukorg';
        addBtn.style.background = '';
      }, 1400);
    });

    paint();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('[data-pvc]').forEach(initCard);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
  else initAll();
  document.addEventListener('astro:page-load', initAll);
})();
</script>

<style is:global>
@keyframes pvcPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: .4; transform: scale(.7); }
}
</style>
