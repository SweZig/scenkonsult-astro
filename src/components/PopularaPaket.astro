---
/**
 * PopularaPaket.astro — "Populäraste paketen" på ljud- och ljushubben,
 * grupperat efter tillfälle och gästantal (kundens sökord) i stället för
 * produktnamn. Grupperna kommer ur src/data/popular.json (se nedan).
 * Produkterna slås upp på artno (aldrig index) bland alla `products`-listor i
 * filen. Utgångna produkter (active:false) hoppas över.
 */
import CartButton from './CartButton.astro';
import SectionHeader from './SectionHeader.astro';
import popular from '../data/popular.json';
import { produktLank } from '../utils/produktLank';

/**
 * Grupperna, rubriken och "Se alla"-länken kommer ur src/data/popular.json, som
 * prebuild bygger ur Supabase (content_categories + popular_groups +
 * popular_group_items). Inget av det ligger i koden eller i katalogfilerna.
 *
 * `data` är fortfarande produktkatalogen — priser och specar bor kvar i
 * src/data/*.json och underhålls via /admin/produkter/. Skicka flera filer för
 * en kombinationssida: data={[ljudData, ljusData]}.
 */
interface Props {
  data: any | any[];
  kategori: string;   // nyckel i popular.json: 'ljud', 'ljus', 'bild', ...
  category: string | string[];   // varukorgens kategorinamn: 'Ljud', 'Ljus', ... — en per katalog i data när data är en lista
}
const { data, kategori, category } = Astro.props;

const cfg = (popular as Record<string, any>)[kategori] ?? {};
const heading = cfg.heading ?? 'Populäraste paketen';
const lead = cfg.lead ?? undefined;
// "Se alla" pekar aldrig på sidan man redan står på (ljud & ljus-sidan).
const allaHref = cfg.allaHref && cfg.allaHref !== Astro.url.pathname ? cfg.allaHref : null;
const allaLabel = cfg.allaLabel ?? null;

/**
 * Produktlistorna ser olika ut per katalogfil: ljud.json och ljus.json har
 * nästlade serier (`event`, `live`, `music`…) med varsin `products`-array,
 * medan bild.json (`products`, `tillbehor`, `dukar`), scenes.json (`products`,
 * `tillbehor`, `pipeDrape`, `modules`) och dj.json (`packages`, `equipment`) har
 * sina listor på toppnivån. Båda formerna samlas in här — uppslaget sker
 * alltid på artno, aldrig på index.
 */
const kataloger: any[] = Array.isArray(data) ? data : [data];
const kategorier: string[] = Array.isArray(category) ? category : kataloger.map(() => category);
const alla: any[] = kataloger.flatMap((d: any, i: number) => Object.values(d).flatMap((v: any) => {
  if (Array.isArray(v)) return v.filter((p: any) => p && typeof p === 'object' && p.artno);
  if (v && typeof v === 'object' && Array.isArray(v.products)) return v.products;
  return [];
}).map((p: any) => ({ ...p, _kategori: kategorier[i] ?? kategorier[0] })));
const byArtno = (a: string) => alla.find((p) => p.artno === a && p.active !== false);

const grupper = (cfg.grupper ?? []).map((g: any) => ({
  ...g,
  // Länken pekar på produktens kort på sidan där den säljs (#artno, se
  // src/utils/produktLank.ts). Produkter utan egen sida får ingen länk.
  produkter: (g.artnos ?? []).map(byArtno).filter(Boolean).map((p: any) => ({ ...p, lank: produktLank(p.artno) })),
})).filter((g: any) => g.produkter.length);

const kr = (n: number) => n.toLocaleString('sv-SE');
---
{grupper.length > 0 && (
<section class="pp-sektion">
  <div class="pp-wrap">
    <div class="pp-sida">
      <p class="sk-eyebrow">Topplista</p>
      <h2 class="sk-h2">{heading}</h2>
      {lead && <p class="pp-lead">{lead}</p>}
      <div class="pp-flikar" role="tablist" aria-label="Tillfälle" aria-orientation="vertical">
        {grupper.map((g: any, gi: number) => (
          <button type="button" role="tab" class="pp-flik" id={`pp-${kategori}-t${gi}`} aria-controls={`pp-${kategori}-p${gi}`} aria-selected={gi === 0 ? 'true' : 'false'} tabindex={gi === 0 ? 0 : -1}>
            <span>{g.rubrik}</span>{g.gaster && <span class="pp-flik-g">{g.gaster}</span>}
          </button>
        ))}
      </div>
    </div>
    <div class="pp-lista">
      {grupper.map((g: any, gi: number) => (
        <div class="pp-panel" role="tabpanel" id={`pp-${kategori}-p${gi}`} aria-labelledby={`pp-${kategori}-t${gi}`} hidden={gi !== 0}>
          {g.lead && <p class="pp-panel-lead">{g.lead}</p>}
          <ol>
            {g.produkter.map((p: any, i: number) => (
              <li class="pp-rad" itemscope itemtype="https://schema.org/Product">
                {/* Bild och specar visas inte i topplistan, men produktdatan ligger
                    kvar som dolda meta-taggar sa att rich results bevaras. */}
                <meta itemprop="brand" content="Scenkonsult Norden" />
                <meta itemprop="sku" content={p.artno} />
                <meta itemprop="description" content={p.tagline ?? p.description ?? `Hyra ${p.name} — leverans i hela Storstockholm.`} />
                <meta itemprop="image" content={p.image ? `https://scenkonsult.se${p.image}` : 'https://scenkonsult.se/images/hero/scen3_hero.webp'} />
                <span class="pp-rang">{String(i + 1).padStart(2, '0')}</span>
                {p.image && (p.lank
                  ? <a href={p.lank} tabindex="-1" aria-hidden="true" class="shrink-0"><img src={p.image} alt="" width="128" height="107" loading="lazy" decoding="async" class="pp-tumme" /></a>
                  : <img src={p.image} alt={p.alt ?? p.name} width="128" height="107" loading="lazy" decoding="async" class="pp-tumme" />)}
                {p.lank
                  ? <a href={p.lank} class="pp-namn" itemprop="url"><span itemprop="name">{p.name}</span></a>
                  : <span class="pp-namn" itemprop="name">{p.name}</span>}
                <div class="pp-pris" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <meta itemprop="priceCurrency" content="SEK" />
                  <meta itemprop="price" content={String(p.price)} />
                  <meta itemprop="priceValidUntil" content="2027-12-31" />
                  <meta itemprop="availability" content="https://schema.org/InStock" />
                  <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
                    <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion"><meta itemprop="addressCountry" content="SE" /></div>
                    <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount"><meta itemprop="currency" content="SEK" /><meta itemprop="value" content="0" /></div>
                    <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
                      <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue"><meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" /></div>
                      <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue"><meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" /></div>
                    </div>
                  </div>
                  <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
                    <meta itemprop="applicableCountry" content="SE" />
                    <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
                    <meta itemprop="merchantReturnDays" content="1" />
                    <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
                    <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
                  </div>
                  <span class="sk-price-excl pp-belopp">{kr(p.price)}&nbsp;kr</span>
                  <span class="sk-price-incl hidden pp-belopp">{kr(Math.round(p.price * 1.25))}&nbsp;kr</span>
                  <span class="pp-enhet">{p.priceNote ?? '/dygn'}</span>
                </div>
                <CartButton id={p.artno} name={p.name} price={p.price} priceNote={p.priceNote ?? '/dygn'} category={p._kategori} image={p.image ?? ''} bulky={p.bulky ?? false} monteringMin={p.monteringMin} size="sm" iconOnly={true} />
              </li>
            ))}
          </ol>
          {allaHref && allaLabel && <a href={allaHref} class="pp-fot">{allaLabel}</a>}
        </div>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .pp-sektion { max-width: 80rem; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); }
  .pp-wrap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  .pp-lead { margin: 1rem 0 1.5rem; font-size: 1rem; line-height: 1.55; color: rgba(255,255,255,0.72); }
  .pp-flikar { display: flex; flex-direction: column; gap: 6px; margin-top: 1.25rem; }
  .pp-flik { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.95rem; padding: 0.7rem 1rem; min-height: 48px; border-radius: 12px; cursor: pointer; text-align: left; background: transparent; color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.12); transition: background 0.15s, color 0.15s, border-color 0.15s; }
  .pp-flik:hover { border-color: rgba(196,181,244,0.5); }
  .pp-flik[aria-selected='true'] { background: #c4b5f4; color: #0c0a24; border-color: #c4b5f4; }
  .pp-flik-g { font-size: 0.72rem; font-weight: 600; opacity: 0.75; white-space: nowrap; }
  .pp-lista { border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); background: #0c0a24; overflow: hidden; }
  .pp-panel-lead { margin: 0; padding: 1rem 1.4rem; font-size: 0.95rem; color: rgba(255,255,255,0.72); background: rgba(196,181,244,0.04); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .pp-panel ol { list-style: none; margin: 0; padding: 0; }
  .pp-rad { display: grid; grid-template-columns: 40px 64px minmax(0, 1fr) auto auto; align-items: center; gap: 1rem; padding: 1rem 1.4rem; border-bottom: 1px solid rgba(255,255,255,0.06); transition: background 0.15s; }
  .pp-rad:hover { background: rgba(196,181,244,0.06); }
  .pp-rang { font-family: 'DM Serif Display', serif; font-size: 1.6rem; color: #c4b5f4; }
  .pp-tumme { width: 60px; height: 52px; object-fit: contain; background: #fff; border-radius: 10px; display: block; }
  .pp-namn { color: #fff; font-weight: 700; font-size: 1.05rem; line-height: 1.35; text-decoration: none; min-width: 0; }
  a.pp-namn:hover { color: #c4b5f4; }
  .pp-pris { text-align: right; line-height: 1.15; font-family: 'Space Grotesk', sans-serif; white-space: nowrap; }
  .pp-belopp { color: #c4b5f4; font-weight: 700; font-size: 1.2rem; }
  .pp-enhet { display: block; color: rgba(255,255,255,0.55); font-size: 0.75rem; }
  .pp-rad :global(.sk-cart-btn) { width: 44px; height: 44px; padding: 0; justify-content: center; }
  .pp-fot { display: block; padding: 1rem 1.4rem; background: rgba(196,181,244,0.05); font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.875rem; color: #c4b5f4; text-decoration: none; }
  .pp-fot:hover { color: #e2dcfb; }
  @media (max-width: 900px) {
    .pp-wrap { grid-template-columns: minmax(0, 1fr); }
    .pp-flikar { flex-direction: row; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * clamp(1rem, 3vw, 2rem)); padding-inline: clamp(1rem, 3vw, 2rem); }
    .pp-flikar::-webkit-scrollbar { display: none; }
    .pp-flik { flex: none; border-radius: 999px; min-height: 40px; padding: 0 1rem; }
    .pp-flik-g { display: none; }
  }
  @media (max-width: 720px) {
    .pp-rad { grid-template-columns: 22px 48px minmax(0, 1fr) 44px; gap: 0.6rem; padding: 0.85rem 0.75rem; }
    .pp-rang { font-size: 1.2rem; }
    .pp-tumme { width: 46px; height: 42px; }
    .pp-namn { font-size: 0.95rem; }
    .pp-pris { grid-column: 3; grid-row: 2; text-align: left; margin-top: -0.35rem; }
    .pp-belopp { font-size: 0.9rem; }
    .pp-enhet { display: inline; margin-left: 0.25rem; }
    .pp-rad > :global(.sk-cart-btn) { grid-column: 4; grid-row: 1 / span 2; }
  }
</style>

<script>
  // Flikarna i topplistan (piltangenter enligt WAI-ARIA tabs). Flera topplistor
  // per sida hanteras var för sig.
  document.querySelectorAll<HTMLElement>('.pp-flikar').forEach((lista) => {
    const flikar = [...lista.querySelectorAll<HTMLButtonElement>('.pp-flik')];
    const valj = (f: HTMLButtonElement, fokus = false) => {
      flikar.forEach((x) => {
        const vald = x === f;
        x.setAttribute('aria-selected', String(vald));
        x.tabIndex = vald ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !vald;
      });
      if (fokus) f.focus();
    };
    flikar.forEach((f, i) => {
      f.addEventListener('click', () => valj(f));
      f.addEventListener('keydown', (e) => {
        const steg = ({ ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 } as Record<string, number>)[e.key];
        if (steg) { e.preventDefault(); valj(flikar[(i + steg + flikar.length) % flikar.length], true); }
      });
    });
  });
</script>
