---
/**
 * PopularaPaket.astro — "Populäraste paketen" på ljud- och ljushubben,
 * grupperat efter tillfälle och gästantal (kundens sökord) i stället för
 * produktnamn. Grupperna ligger i datafilens `populara`:
 *   [{ rubrik, gaster, lead, artnos: [...] }]
 * Produkterna slås upp på artno (aldrig index) bland alla `products`-listor i
 * filen. Utgångna produkter (active:false) hoppas över.
 */
import CartButton from './CartButton.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  data: any;
  category: 'Ljud' | 'Ljus';
  lead?: string;
  allaHref: string;
  allaLabel: string;
}
const { data, category, lead, allaHref, allaLabel } = Astro.props;

const alla: any[] = Object.values(data)
  .filter((v: any) => v && typeof v === 'object' && Array.isArray(v.products))
  .flatMap((v: any) => v.products);
const byArtno = (a: string) => alla.find((p) => p.artno === a && p.active !== false);

const grupper = (data.populara ?? []).map((g: any) => ({
  ...g,
  produkter: g.artnos.map(byArtno).filter(Boolean),
})).filter((g: any) => g.produkter.length);

const kr = (n: number) => n.toLocaleString('sv-SE');
---
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  <SectionHeader eyebrow="Snabbval" h2="Populäraste paketen" lead={lead} />
  <div class="space-y-12">
    {grupper.map((g: any) => (
      <div>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
          <h3 class="text-white text-2xl" style="font-family:'DM Serif Display',serif;">{g.rubrik}</h3>
          <span class="text-brand-orange text-xs font-bold uppercase tracking-widest" style="font-family:'Space Grotesk',sans-serif">{g.gaster}</span>
        </div>
        <p class="text-gray-400 text-sm mb-5">{g.lead}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {g.produkter.map((p: any) => (
            <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col" itemscope itemtype="https://schema.org/Product">
              <meta itemprop="brand" content="Scenkonsult Norden" />
              <meta itemprop="sku" content={p.artno} />
              <meta itemprop="description" content={p.tagline ?? p.description ?? `Hyra ${p.name} — leverans i hela Storstockholm.`} />
              <meta itemprop="image" content={p.image ? `https://scenkonsult.se${p.image}` : 'https://scenkonsult.se/images/hero/scen3_hero.webp'} />
              <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
                {p.image && <img src={p.image} alt={p.alt ?? p.name} width="1024" height="853" loading="lazy" class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />}
              </div>
              <div class="p-5 flex flex-col flex-1">
                <span class="text-xs text-brand-orange font-bold uppercase tracking-wide">{p.persons}</span>
                <h4 class="font-bold text-white text-lg mt-1 mb-2" itemprop="name">{p.name}</h4>
                <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3 flex-1">
                  {(p.specs ?? []).slice(0, 3).map((s: string) => (
                    <li class="flex gap-1.5"><span class="text-green-400 shrink-0">✓</span>{s}</li>
                  ))}
                </ul>
                <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                  <meta itemprop="priceCurrency" content="SEK" />
                  <meta itemprop="price" content={String(p.price)} />
                  <meta itemprop="priceValidUntil" content="2027-12-31" />
                  <meta itemprop="availability" content="https://schema.org/InStock" />
                  <div itemprop="shippingDetails" itemscope itemtype="https://schema.org/OfferShippingDetails">
                    <div itemprop="shippingDestination" itemscope itemtype="https://schema.org/DefinedRegion"><meta itemprop="addressCountry" content="SE" /></div>
                    <div itemprop="shippingRate" itemscope itemtype="https://schema.org/MonetaryAmount"><meta itemprop="currency" content="SEK" /><meta itemprop="value" content="0" /></div>
                    <div itemprop="deliveryTime" itemscope itemtype="https://schema.org/ShippingDeliveryTime">
                      <div itemprop="handlingTime" itemscope itemtype="https://schema.org/QuantitativeValue"><meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" /></div>
                      <div itemprop="transitTime" itemscope itemtype="https://schema.org/QuantitativeValue"><meta itemprop="minValue" content="0" /><meta itemprop="maxValue" content="1" /><meta itemprop="unitCode" content="DAY" /></div>
                    </div>
                  </div>
                  <div itemprop="hasMerchantReturnPolicy" itemscope itemtype="https://schema.org/MerchantReturnPolicy">
                    <meta itemprop="applicableCountry" content="SE" />
                    <meta itemprop="returnPolicyCategory" content="https://schema.org/MerchantReturnFiniteReturnWindow" />
                    <meta itemprop="merchantReturnDays" content="1" />
                    <meta itemprop="returnMethod" content="https://schema.org/ReturnInStore" />
                    <meta itemprop="returnFees" content="https://schema.org/FreeReturn" />
                  </div>
                  <div class="leading-none">
                    <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{kr(p.price)}&nbsp;kr</span>
                    <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{kr(Math.round(p.price * 1.25))}&nbsp;kr</span>
                    <span class="text-gray-400 text-xs">{p.priceNote ?? '/dygn'}</span>
                  </div>
                  <CartButton id={p.artno} name={p.name} price={p.price} priceNote={p.priceNote ?? '/dygn'} category={category} image={p.image ?? ''} bulky={p.bulky ?? false} monteringMin={p.monteringMin} size="md" iconOnly={true} />
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="mt-8 text-center">
    <a href={allaHref} class="text-brand-orange hover:text-white transition-colors text-sm font-semibold">{allaLabel}</a>
  </div>
</section>
