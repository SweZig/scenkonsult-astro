---
// ElTillbehorCard.astro — litet tillbehörskort med pris vänster, icon-knapp höger
// modal?: om satt öppnas produktmodal vid klick på kortet
import CartButton from './CartButton.astro';
interface Props {
  img: string;
  name: string;
  excl: number;
  desc?: string;
  category?: string;
  artno?: string;
  modal?: boolean;
  specs?: string[];
  manualUrl?: string;
  priceNote?: string;
  bulky?: boolean;        // skrymmande — räknas i bulkyCount-regeln för leveransfordon
}
const { img, name, excl, desc, category = 'Tillbehör', artno, slug, modal = false, specs, manualUrl, priceNote = '/dygn', bulky = false } = Astro.props;
const cartId = slug || artno || `acc-${name.toLowerCase().replace(/[åä]/g,'a').replace(/ö/g,'o').replace(/[^a-z0-9]+/g, '-')}`;

const productJson = modal ? JSON.stringify({
  name,
  artno: artno ?? '',
  desc:  (specs ?? (desc ? [desc] : [])).join('||'),
  rows:  [],
  price: excl,
  priceNote,
  category,
  cartId,
  images: [img],
  videos: [],
  manualUrl: manualUrl ?? '',
}) : null;
---
<div
  class="bg-brand-navy/60 border border-white/10 rounded-xl p-3 flex flex-col h-full"
  class:list={[modal && 'hover:border-brand-orange/40 transition-colors']}
  data-sk-product={productJson ?? undefined}
  style={modal ? 'cursor:pointer' : undefined}
>
  <div class="bg-brand-dark overflow-hidden rounded-lg mb-2" style="aspect-ratio:1024/853">
    <img src={img} alt={name} width="150" height="150" loading="lazy" class="w-full h-full object-cover" />
  </div>
  <p class="text-white text-xs font-semibold leading-tight mb-0.5">{name}</p>
  {artno && <p class="artno-badge" style="margin-bottom:0.25rem">{artno}</p>}
  {desc && <p class="text-gray-400 text-[10px] leading-tight mb-0.5 flex-1">{desc}</p>}
  <div class="mt-auto pt-2 flex flex-col gap-1.5 border-t border-white/10">
    <div class="flex items-center justify-between gap-1">
      <div class="leading-none">
        <span class="sk-price-excl text-brand-orange text-sm font-bold">{excl} kr</span>
        <span class="sk-price-incl hidden text-brand-orange text-sm font-bold">{Math.round(excl*1.25)} kr</span>
        <span class="text-gray-400 text-[10px]">{priceNote}</span>
      </div>
      <CartButton id={cartId} name={name} price={excl} priceNote={priceNote} artno={artno} category={category} image={img} bulky={bulky} size="sm" iconOnly={true} />
    </div>
    {manualUrl && (
      <a href={manualUrl} target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1 text-[10px] text-gray-400 hover:text-brand-orange transition-colors w-fit"
         onclick="event.stopPropagation()">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Manual (PDF)
      </a>
    )}
  </div>
</div>
