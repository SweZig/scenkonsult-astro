---
/** Kundlogotyper i en rad (samma som startsidan). */
import { KUNDLOGOTYPER } from '../../utils/clients';
interface Props { rubrik?: string }
const { rubrik = 'De har hyrt av oss' } = Astro.props;
---
<section class="kr-wrap">
  <div class="kr-ram">
    <span class="kr-rubrik">{rubrik}</span>
    <div class="kr-rad">
      {KUNDLOGOTYPER.map((l) => <span><img src={l.src} alt={l.name} width={l.w} height={l.h} loading="lazy" decoding="async" class:list={{ 'kr-hog': l.tall }} /></span>)}
    </div>
    <a href="/referenser/" class="kr-lank">Alla referenskunder →</a>
  </div>
</section>
<style>
  .kr-wrap { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem); }
  .kr-ram { display: flex; align-items: center; gap: 1.75rem; padding: 1.4rem 1.75rem; border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; }
  .kr-rubrik { font-family: 'Space Grotesk', sans-serif; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
  .kr-rad { flex: 1 1 560px; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 1.1rem; align-items: center; }
  .kr-rad span { height: 48px; display: flex; align-items: center; justify-content: center; }
  .kr-rad img { max-height: 28px; max-width: 100%; width: auto; height: auto; object-fit: contain; opacity: 0.9; }
  .kr-rad img.kr-hog { max-height: 44px; }
  .kr-lank { font-family: 'Space Grotesk', sans-serif; font-size: 0.875rem; font-weight: 600; color: #c4b5f4; text-decoration: none; white-space: nowrap; }
  @media (max-width: 720px) { .kr-rad { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
