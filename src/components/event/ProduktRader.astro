---
/** Kompakta produktrader med köpknapp ("Lägg i varukorgen direkt"). Länken går till produktens kort. */
import CartButton from '../CartButton.astro';
import { produktLank } from '../../utils/produktLank';
interface Rad { produkt: any; not?: string; kategori: string }
interface Props { eyebrow?: string; rubrik: string; lead?: string; rader: Rad[]; lankar?: Array<{ label: string; href: string }> }
const { eyebrow, rubrik, lead, rader, lankar = [] } = Astro.props;
const kr = (n: number) => n.toLocaleString('sv-SE');
const lista = rader.filter((r) => r.produkt && r.produkt.active !== false).map((r) => ({ ...r, lank: produktLank(r.produkt.artno) }));
---
<section class="sk-band">
  <div class="pr-wrap">
    <div>
      {eyebrow && <p class="sk-eyebrow">{eyebrow}</p>}
      <h2 class="sk-h2">{rubrik}</h2>
      {lead && <p class="pr-lead">{lead}</p>}
      {lankar.length > 0 && <div class="pr-lankar">{lankar.map((l) => <a href={l.href} class="sk-knapp">{l.label}</a>)}</div>}
    </div>
    <div class="pr-lista">
      {lista.map(({ produkt: p, not, kategori, lank }) => (
        <div class="pr-rad">
          {p.image ? <img src={p.image} alt="" width="128" height="107" loading="lazy" decoding="async" /> : <span></span>}
          <span class="pr-text">
            {lank ? <a href={lank} class="pr-namn">{p.name}</a> : <span class="pr-namn">{p.name}</span>}
            {not && <span class="pr-not">{not}</span>}
          </span>
          <span class="pr-pris"><b><span class="sk-price-excl">{kr(p.price)} kr</span><span class="sk-price-incl hidden">{kr(Math.round(p.price * 1.25))} kr</span></b><span>{p.priceNote ?? '/dygn'}</span></span>
          {String(p.artno).startsWith('SK-SCN-')
            ? <a href={lank ?? '/vara-tjanster/hyra-scen/'} class="pr-valj" aria-label={`Konfigurera ${p.name}`} title="Välj höjd och yta i scenkonfiguratorn">→</a>
            : <CartButton id={p.artno} name={p.name} price={p.price} priceNote={p.priceNote ?? '/dygn'} category={kategori} image={p.image ?? ''} bulky={p.bulky ?? false} forceLeverans={p.forceLeverans} monteringMin={p.monteringMin} size="sm" iconOnly={true} />}
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .pr-wrap { max-width: 80rem; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  .pr-lead { margin: 1rem 0 0; color: rgba(255,255,255,0.72); line-height: 1.55; }
  .pr-lankar { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .pr-lankar .sk-knapp { font-size: 0.85rem; padding: 0.6rem 1rem; }
  .pr-lista { border-radius: 18px; border: 1px solid rgba(255,255,255,0.08); background: #0c0a24; overflow: hidden; }
  .pr-rad { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto 44px; gap: 1.1rem; align-items: center; padding: 0.9rem 1.4rem; border-bottom: 1px solid rgba(255,255,255,0.06); transition: background 0.15s; }
  .pr-rad:last-child { border-bottom: 0; }
  .pr-rad:hover { background: rgba(196,181,244,0.06); }
  .pr-rad img { width: 60px; height: 52px; object-fit: contain; background: #fff; border-radius: 10px; }
  .pr-namn { display: block; color: #fff; font-weight: 700; font-size: 1.05rem; text-decoration: none; }
  a.pr-namn:hover { color: #c4b5f4; }
  .pr-not { display: block; font-size: 0.85rem; color: rgba(255,255,255,0.55); }
  .pr-pris { text-align: right; font-family: 'Space Grotesk', sans-serif; white-space: nowrap; }
  .pr-pris b { color: #c4b5f4; font-size: 1.15rem; }
  .pr-pris > span { display: block; font-size: 0.75rem; color: rgba(255,255,255,0.55); }
  .pr-valj { width: 44px; height: 44px; border-radius: 999px; border: 1px solid #c4b5f4; color: #c4b5f4; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 1.1rem; }
  .pr-valj:hover { background: #c4b5f4; color: #0c0a24; }
  .pr-rad :global(.sk-cart-btn) { width: 44px; height: 44px; padding: 0; justify-content: center; }
  @media (max-width: 900px) { .pr-wrap { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 600px) {
    .pr-rad { grid-template-columns: 48px minmax(0, 1fr) 44px; gap: 0.7rem; padding: 0.8rem 0.9rem; }
    .pr-rad img { width: 46px; height: 42px; }
    .pr-pris { grid-column: 2; grid-row: 2; text-align: left; margin-top: -0.4rem; }
    .pr-pris > span { display: inline; margin-left: 0.25rem; }
    .pr-rad > :global(.sk-cart-btn), .pr-valj { grid-column: 3; grid-row: 1 / span 2; }
  }
</style>
