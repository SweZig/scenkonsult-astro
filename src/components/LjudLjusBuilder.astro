---
// LjudLjusBuilder.astro — konfigurator för ljud + ljus (+ bild) på
// /vara-tjanster/hyra-ljud-och-ljus/.
//
// Tre frågor (privat/företag, gästantal, fokus tal/musik/båda) ger ett förslag
// ur ljud-ljus.json → builder.recommend. Kunden justerar per flik; flikarna visar
// bara alternativ som passar svaren, med "Visa alla" för resten. Scenen ritas om
// med karaokebyggarens bildlager (public/images/karaoke/scen/) och ritade former
// där foto saknas (kolumner, uplights, moving heads).
//
// Data: ljud-ljus.json (artikelnummer) → src/lib/ljud-ljus-builder.mjs slår upp
// namn/pris/cart-ID i ljud/ljus/bild.json. Inga priser i komponenten.
// Mobil är primär layout; desktop får sammanfattningen i en sticky kolumn.
import config from '../data/ljud-ljus.json';
import ljud from '../data/ljud.json';
import ljus from '../data/ljus.json';
import bild from '../data/bild.json';
import dj from '../data/dj.json';
import scenes from '../data/scenes.json';
import tjanster from '../data/tjanster.json';
import karaoke from '../data/karaoke.json';
import el from '../data/el.json';
import scen from '../data/karaoke-scen.json';
import { resolveLjudLjus } from '../lib/ljud-ljus-builder.mjs';
const resolved = resolveLjudLjus(config, { ljud, ljus, bild, dj, scenes, tjanster, karaoke, el });
if (resolved.missing.length) {
  throw new Error('[LjudLjusBuilder] Artikelnummer saknas eller är utgångna: ' + resolved.missing.join(', '));
}
const payload = JSON.stringify({ R: resolved, G: scen });
---
<section id="bygg" class="llb max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14" aria-labelledby="llb-h2">
  <div class="llb-head">
    <p class="llb-eyebrow">Bygg ert paket</p>
    <h2 id="llb-h2" class="llb-h2">Svara på tre frågor – se uppställningen växa fram</h2>
  </div>

  <div class="llb-qs">
    <fieldset class="llb-q">
      <legend class="llb-ql">1 · Vem hyr?</legend>
      <div class="llb-seg" id="llb-seg"></div>
    </fieldset>
    <fieldset class="llb-q">
      <legend class="llb-ql" id="llb-guests-l">2 · Hur många blir ni?</legend>
      <div class="llb-chips" id="llb-guests"></div>
    </fieldset>
    <fieldset class="llb-q llb-q-wide">
      <legend class="llb-ql">3 · Vad är viktigast?</legend>
      <div class="llb-focus" id="llb-focus"></div>
    </fieldset>
  </div>
  <p class="llb-reco" id="llb-reco" aria-live="polite"></p>

  <div class="llb-grid">
    <div class="llb-main">
      <div class="llb-scene" id="llb-scene">
        <svg viewBox="0 0 1600 900" role="img" aria-label="Er uppställning" id="llb-svg">
          <defs>
            <radialGradient id="llb-hz"><stop offset="0" stop-color="#d9d2ff" stop-opacity=".55"/><stop offset="1" stop-color="#d9d2ff" stop-opacity="0"/></radialGradient>
            <linearGradient id="llb-bm" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".25"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
            <filter id="llb-blur" x="-60%" y="-30%" width="220%" height="160%"><feGaussianBlur stdDeviation="38"/></filter>
            <linearGradient id="llb-fog" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#f0eeff" stop-opacity=".8"/><stop offset="1" stop-color="#f0eeff" stop-opacity="0"/></linearGradient>
          </defs>
          <g id="llb-layers"></g>
        </svg>
      </div>
      <div class="llb-tabs" role="tablist" aria-label="Områden" id="llb-tabs"></div>
      <div class="llb-panel" id="llb-panel" role="tabpanel"></div>
    </div>
    <aside class="llb-sum" id="llb-sum" aria-label="Ert paket"></aside>
  </div>

  <div class="llb-bar" id="llb-bar" aria-hidden="true">
    <button type="button" class="llb-bar-total" id="llb-bar-total" aria-label="Visa vad som ingår">
      <small id="llb-bar-count"></small>
      <span><b id="llb-bar-sum"></b> <small class="llb-bar-vat" id="llb-bar-vat"></small></span>
    </button>
    <button type="button" class="llb-cta" id="llb-bar-add">Lägg i varukorg</button>
  </div>
  <div class="llb-sheet" id="llb-sheet" hidden>
    <div class="llb-sheet-bg" data-llb-close></div>
    <div class="llb-sheet-card" role="dialog" aria-modal="true" aria-label="Ert paket">
      <button type="button" class="llb-sheet-x" data-llb-close aria-label="Stäng">×</button>
      <div id="llb-sheet-body"></div>
    </div>
  </div>
  <script type="application/json" id="llb-data" set:html={payload}></script>
</section>

<script>
  import { AREAS, listFor, findOption, builtInMixerOk, fixMixer, recommend, shownFor, itemsFor } from '../lib/ljud-ljus-builder.mjs';
  const root = document.getElementById('bygg');
  const { R, G } = JSON.parse(document.getElementById('llb-data')!.textContent || '{}');
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: any) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
  const kr = (n: number) => `<span data-exkl="${n}">${n.toLocaleString('sv-SE')}</span>&nbsp;kr`;
  const STORE = 'sk-ljudljus-val';

  // ── state ────────────────────────────────────────────────────
  type Ans = { seg: string; guests: string; focus: string };
  let A: Ans = { seg: 'privat', guests: 'g2', focus: 'bada' };
  let S: Record<string, string | null> = {};
  let custom = false, showAll = false, tab = 'ljud';
  const segDef = () => R.segments.find((s: any) => s.id === A.seg) || R.segments[0];

  function valid(a: any) {
    return a && R.segments.some((s: any) => s.id === a.seg) && R.guests.some((g: any) => g.id === a.guests) && ['tal', 'musik', 'bada'].includes(a.focus);
  }
  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORE) || 'null');
      if (saved && valid(saved.ans)) {
        A = saved.ans;
        S = recommend(R, A.seg, A.guests, A.focus);
        if (saved.custom && saved.sel) {
          // Sparade val som inte längre finns faller tillbaka på förslaget
          for (const a of AREAS) {
            const v = saved.sel[a];
            if (v == null || findOption(R, a, A.seg, v)) S[a] = v ?? null;
          }
          S = fixMixer(R, S, A.seg);
          custom = true;
        }
        return;
      }
    } catch {}
    S = recommend(R, A.seg, A.guests, A.focus);
  }
  function saveState() { try { localStorage.setItem(STORE, JSON.stringify({ ans: A, sel: S, custom })); } catch {} }
  function answer(patch: Partial<Ans>) {
    A = { ...A, ...patch };
    S = recommend(R, A.seg, A.guests, A.focus);
    custom = false; showAll = false;
  }

  // ── scene ────────────────────────────────────────────────────
  const svg = $('llb-svg') as unknown as SVGSVGElement;
  const layersEl = $('llb-layers');
  const C = ['#c4b5f4', '#ff7ab6', '#6fd3ff', '#ffd36f'];
  function src(name: string) {
    const w = (svg.clientWidth || 800) * (window.devicePixelRatio || 1);
    return `/images/karaoke/scen/${name}${w <= 900 ? '-800' : ''}.webp`;
  }
  const img = (name: string) => `<image href="${src(name)}" x="0" y="0" width="1600" height="900"/>`;
  const imgs = (o: any) => (o?.scen?.img || []).map(img).join('');
  const slide = (x: number, y: number, w: number, h: number) =>
    `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="#1e1850"/>` +
    `<rect x="${x + w * 0.08}" y="${y + h * 0.2}" width="${w * 0.42}" height="${h * 0.09}" rx="3" fill="#c4b5f4"/>` +
    `<rect x="${x + w * 0.08}" y="${y + h * 0.42}" width="${w * 0.6}" height="${h * 0.05}" rx="2" fill="#fff" fill-opacity=".45"/>` +
    `<rect x="${x + w * 0.08}" y="${y + h * 0.54}" width="${w * 0.5}" height="${h * 0.05}" rx="2" fill="#fff" fill-opacity=".35"/>` +
    `<rect x="${x + w * 0.08}" y="${y + h * 0.66}" width="${w * 0.55}" height="${h * 0.05}" rx="2" fill="#fff" fill-opacity=".35"/>`;
  const opt = (a: string) => findOption(R, a, A.seg, S[a]);
  const has = (o: any, k: string) => (o?.scen?.draw || '').split(' ').includes(k);
  // Kolumnhögtalare saknar fotolager — ritas som smala pelare med fot
  const column = (x: number) => {
    let grill = '';
    for (let y = 352; y < 612; y += 13) grill += `<line x1="${x - 17}" y1="${y}" x2="${x + 17}" y2="${y}" stroke="#2c2860" stroke-width="5" stroke-linecap="round"/>`;
    return `<g><ellipse cx="${x}" cy="712" rx="90" ry="14" fill="#000" opacity=".45"/>` +
      `<rect x="${x - 27}" y="334" width="54" height="300" rx="12" fill="#121028"/>` + grill +
      `<rect x="${x - 27}" y="334" width="54" height="300" rx="12" fill="none" stroke="#3d3770" stroke-width="2"/>` +
      `<rect x="${x - 7}" y="634" width="14" height="22" fill="#1a1738"/>` +
      `<rect x="${x - 58}" y="654" width="116" height="52" rx="10" fill="#121028" stroke="#3d3770" stroke-width="2"/>` +
      `<circle cx="${x}" cy="680" r="15" fill="#1d1a42" stroke="#2c2860" stroke-width="3"/></g>`;
  };
  function sceneLayers(): [string, string][] {
    const L: [string, string][] = [];
    L.push(['bg', img('bakgrund')]);
    const lj = opt('ljus');
    // Uplights: färgtvätt nerifrån på bakväggen
    if (has(lj, 'up') || has(lj, 'up2')) {
      const xs = has(lj, 'up2') ? [110, 330, 560, 1040, 1270, 1490] : [110, 330, 1270, 1490];
      let g = '', f = '';
      xs.forEach((x, i) => {
        g += `<ellipse class="llb-pulse${i % 2 ? ' d2' : ''}" cx="${x}" cy="650" rx="95" ry="330" fill="${C[i % 4]}" opacity=".5" filter="url(#llb-blur)"/>`;
        f += `<path d="M${x - 22},652 h44 l-6,-18 h-32 z" fill="#121028" stroke="#3d3770" stroke-width="2"/>`;
      });
      L.push(['up:' + xs.length, `<g style="mix-blend-mode:screen">${g}</g>${f}`]);
    }
    // Ljuspaket: strålar bakom armaturerna (samma geometri som karaokebyggaren)
    const heads = lj?.scen?.heads ? (G.lightHeads[lj.scen.heads] || []) : [];
    if (heads.length) {
      let bm = '';
      heads.forEach(([x, y]: number[], i: number) => {
        const dir = i % 4 < 2 ? -1 : 1, spread = i % 4 === 0 || i % 4 === 3 ? 260 : 120;
        bm += `<polygon class="llb-pulse${i % 2 ? ' d2' : ''}" points="${x - 8},${y} ${x + 8},${y} ${x + dir * spread + 70},740 ${x + dir * spread - 70},740" fill="${C[i % 4]}" opacity=".42"/>`;
      });
      L.push(['pak:' + lj.id, bm + imgs(lj)]);
    }
    // Bild
    const b = opt('bild');
    if (b?.scen?.proj) {
      const d = G.surfaces[b.scen.duk] || [600, 190, 400, 225];
      const p = G.projectors[b.scen.proj], lx = p[0] + p[2] * 0.66, ly = p[1] + p[3] * 0.5;
      L.push(['bild:' + b.id, img('duk_' + b.scen.duk) + `<g opacity=".92">${slide(d[0], d[1], d[2], d[3])}</g>` +
        `<polygon points="${lx - 4},${ly} ${lx + 4},${ly} ${d[0] + d[2]},${d[1] + d[3]} ${d[0] + d[2]},${d[1]} ${d[0]},${d[1]} ${d[0]},${d[1] + d[3]}" fill="url(#llb-bm)" opacity=".3"/>` +
        `<g opacity=".7"><rect x="740" y="${p[1] + p[3]}" width="120" height="8" rx="2" fill="#3b3570"/><line x1="755" y1="${p[1] + p[3] + 8}" x2="755" y2="880" stroke="#3b3570" stroke-width="6"/><line x1="845" y1="${p[1] + p[3] + 8}" x2="845" y2="880" stroke="#3b3570" stroke-width="6"/></g>` +
        img('projektor_' + b.scen.proj)]);
    } else if (b?.scen?.skarm) {
      const [x, y, w, h] = G.surfaces[b.scen.skarm];
      L.push(['bild:' + b.id, `<rect x="${x + 30}" y="${y + h + 14}" width="${w - 60}" height="${650 - y - h - 14}" rx="4" fill="#2a2257" stroke="#3b3570" stroke-width="2" opacity=".8"/>` +
        img('skarm_' + b.scen.skarm) + slide(x, y, w, h)]);
    }
    // Moving heads: två stativ med rörliga strålar
    if (has(lj, 'mh')) {
      let m = '';
      [[470, -1], [1130, 1]].forEach(([x, dir], i) => {
        m += `<polygon class="llb-sweep${i ? ' d2' : ''}" style="transform-origin:${x}px 318px" points="${x - 10},318 ${x + 10},318 ${x + dir * 330 + 60},0 ${x + dir * 330 - 60},0" fill="#e2dcfb" opacity=".26"/>` +
          `<polygon class="llb-sweep d2" style="transform-origin:${x}px 318px" points="${x - 8},318 ${x + 8},318 ${x - dir * 120 + 50},0 ${x - dir * 120 - 50},0" fill="${C[2 + i]}" opacity=".22"/>`;
        m += `<line x1="${x}" y1="356" x2="${x}" y2="735" stroke="#3b3570" stroke-width="7"/>` +
          `<line x1="${x - 46}" y1="735" x2="${x + 46}" y2="735" stroke="#3b3570" stroke-width="7"/>` +
          `<path d="M${x - 30},346 v-34 M${x + 30},346 v-34" stroke="#3d3770" stroke-width="7" stroke-linecap="round"/>` +
          `<rect x="${x - 34}" y="342" width="68" height="14" rx="4" fill="#121028" stroke="#3d3770" stroke-width="2"/>` +
          `<ellipse cx="${x}" cy="318" rx="24" ry="20" fill="#121028" stroke="#8a83c9" stroke-width="3"/>` +
          `<circle cx="${x}" cy="312" r="9" fill="#e2dcfb" opacity=".85"/>`;
      });
      L.push(['mh', m]);
    }
    // Högtalare
    const hg = opt('ljud');
    if (hg?.scen?.draw === 'kolumn1') L.push(['hog:' + hg.id, column(150)]);
    else if (hg?.scen?.draw === 'kolumn2') L.push(['hog:' + hg.id, column(150) + column(1450)]);
    else if (hg) L.push(['hog:' + hg.id, imgs(hg)]);
    // Bord + mixer
    const mx = opt('mixer');
    if (mx) L.push(['mix:' + mx.id, `<g opacity=".7"><rect x="1090" y="707" width="270" height="12" rx="3" fill="#3b3570"/><line x1="1105" y1="719" x2="1105" y2="880" stroke="#3b3570" stroke-width="7"/><line x1="1345" y1="719" x2="1345" y2="880" stroke="#3b3570" stroke-width="7"/></g>` + imgs(mx)]);
    // Mikrofon
    const mk = opt('mik');
    if (mk) L.push(['mik:' + mk.id, imgs(mk)]);
    // Rök
    const rk = opt('rok');
    if (rk) {
      const fx = rk.scen?.fx === 'low'
        ? `<g class="llb-drift"><rect x="0" y="700" width="1600" height="200" fill="url(#llb-fog)"/><ellipse cx="500" cy="860" rx="620" ry="70" fill="url(#llb-hz)"/><ellipse cx="1150" cy="870" rx="600" ry="60" fill="url(#llb-hz)"/></g>`
        : `<g class="llb-drift" opacity=".8"><ellipse cx="400" cy="840" rx="500" ry="90" fill="url(#llb-hz)"/><ellipse cx="900" cy="860" rx="520" ry="80" fill="url(#llb-hz)"/><rect x="0" y="0" width="1600" height="900" fill="#d9d2ff" opacity=".05"/></g>`;
      L.push(['rok:' + rk.id, fx + imgs(rk)]);
    }
    return L;
  }
  const NS = 'http://www.w3.org/2000/svg';
  function renderScene() {
    const want = sceneLayers();
    const have = new Map<string, Element>();
    for (const g of Array.from(layersEl.children)) have.set((g as HTMLElement).dataset.k!, g);
    const keep = new Set<string>();
    for (const [k, markup] of want) {
      let g = have.get(k);
      if (!g) {
        g = document.createElementNS(NS, 'g');
        (g as HTMLElement).dataset.k = k;
        if (k !== 'bg') g.setAttribute('class', 'llb-fade');
        g.innerHTML = markup;
      }
      layersEl.appendChild(g);
      keep.add(k);
    }
    for (const [k, g] of have) if (!keep.has(k)) g.remove();
    const names = itemsFor(R, S, A.seg).map((i: any) => i.name);
    svg.setAttribute('aria-label', 'Er uppställning: ' + (names.join(', ') || 'tom'));
  }

  // ── frågor ───────────────────────────────────────────────────
  const pressed = (on: boolean) => `aria-pressed="${on}"`;
  function renderQuestions() {
    $('llb-seg').innerHTML = R.segments.map((s: any) =>
      `<button type="button" class="llb-segb" data-seg="${s.id}" ${pressed(A.seg === s.id)}><b>${esc(s.label)}</b><small>${esc(s.sub)}</small></button>`).join('');
    $('llb-guests-l').textContent = `2 · Hur många ${segDef().guestNoun} blir ni?`;
    $('llb-guests').innerHTML = R.guests.map((g: any) =>
      `<button type="button" class="llb-chip" data-guests="${g.id}" ${pressed(A.guests === g.id)}>${esc(g.label)}</button>`).join('');
    $('llb-focus').innerHTML = segDef().focus.map((f: any) =>
      `<button type="button" class="llb-fc" data-focus="${f.id}" ${pressed(A.focus === f.id)}><b>${esc(f.label)}</b><small>${esc(f.sub)}</small></button>`).join('');
    $('llb-reco').textContent = custom
      ? 'Ni har justerat förslaget. Ändra ett svar ovan för att få ett nytt förslag.'
      : 'Här är vårt förslag – justera fritt under flikarna.';
  }

  // ── flikar och alternativ ────────────────────────────────────
  const tabLabel = (t: any) => (A.seg === 'foretag' && t.labelForetag) || t.label;
  function renderTabs() {
    $('llb-tabs').innerHTML = R.tabs.map((t: any) => {
      const o = opt(t.id);
      const val = o ? o.label : (t.id === 'mixer' && builtInMixerOk(R, S, A.seg) ? 'Inbyggd' : 'Inget');
      return `<button type="button" role="tab" class="llb-tab" id="llb-tab-${t.id}" aria-selected="${tab === t.id}" data-tab="${t.id}"><span>${esc(tabLabel(t))}</span><small>${esc(val)}</small></button>`;
    }).join('');
    const box = $('llb-tabs'), a = box.querySelector('[aria-selected="true"]') as HTMLElement | null;
    if (a) {
      const br = box.getBoundingClientRect(), ar = a.getBoundingClientRect();
      if (ar.left < br.left || ar.right > br.right) box.scrollBy({ left: ar.left - br.left - (br.width - ar.width) / 2, behavior: 'smooth' });
    }
  }
  function card(area: string, id: string | null, label: string, sub: string, price: number, on: boolean, none = false) {
    return `<button type="button" class="llb-opt${none ? ' none' : ''}" aria-pressed="${on}" data-area="${area}" data-val="${id === null ? '' : esc(id)}">` +
      `<b>${esc(label)}</b><small>${esc(sub || '')}</small>` +
      `<span class="llb-opt-p">${price ? '+ ' + kr(price) : none ? '' : '0&nbsp;kr'}</span></button>`;
  }
  // "Inget"-kort: mixer bara när kolumnens inbyggda räcker; ljudet är alltid obligatoriskt
  function noneCard(area: string) {
    if (area === 'ljud') return '';
    if (area === 'mixer' && !builtInMixerOk(R, { ...S, mixer: null }, A.seg)) return '';
    return card(area, null, R.noneLabels[area] || 'Inget', R.noneSubs?.[area] || '', 0, S[area] == null, true);
  }
  function optsHTML(area: string, list: any[]) {
    return `<div class="llb-opts">${noneCard(area)}${list.map((o: any) => card(area, o.id, o.label, o.sub, o.total, S[area] === o.id)).join('')}</div>`;
  }
  function renderPanel() {
    const t = R.tabs.find((x: any) => x.id === tab);
    $('llb-panel').setAttribute('aria-labelledby', 'llb-tab-' + tab);
    const shown = shownFor(R, tab, A, S, showAll);
    const hidden = listFor(R, tab, A.seg).length - shown.length;
    let h = t.note ? `<p class="llb-note-t">${esc(t.note)}</p>` : '';
    h += optsHTML(tab, shown);
    if (hidden > 0 || showAll) h += `<button type="button" class="llb-link" data-showall>${showAll ? 'Visa bara det som passar er' : `Visa alla alternativ (${hidden} till)`}</button>`;
    if (tab === 'ljus') {
      h += `<p class="llb-note-t">Ljuspaket och moving heads styrs automatiskt till musiken. Vill ni styra ljuset från ett ljusbord (DMX) ordnar vi det på <a href="/bokningssida/">separat offert</a>.</p>`;
      h += `<div class="llb-addon"><h3 class="llb-slot-h">Rök &amp; dimma <span>– tillval</span></h3>${optsHTML('rok', R.options.rok)}</div>`;
    }
    $('llb-panel').innerHTML = h;
    // Mobil: alternativen scrollar i sidled — håll valt kort synligt utan att scrolla sidan
    $('llb-panel').querySelectorAll('.llb-opts').forEach((box) => {
      const on = box.querySelector('[aria-pressed="true"]') as HTMLElement | null;
      if (!on || box.scrollWidth <= box.clientWidth) return;
      const br = box.getBoundingClientRect(), r = on.getBoundingClientRect();
      if (r.left < br.left || r.right > br.right) box.scrollLeft += r.left - br.left - 16;
    });
  }

  // ── sammanfattning ───────────────────────────────────────────
  const qtyLabel = (i: any) => i.qty > 1 ? `${i.qty} × ` : '';
  function sumHTML(compact = false) {
    const it = itemsFor(R, S, A.seg);
    const tot = it.reduce((s: number, i: any) => s + i.total, 0);
    const g = R.guests.find((x: any) => x.id === A.guests);
    const f = segDef().focus.find((x: any) => x.id === A.focus);
    const builtIn = builtInMixerOk(R, S, A.seg) && !S.mixer;
    return `<p class="llb-sum-k">${esc(segDef().label)} · ${esc(g?.label)} · ${esc(f?.label)}</p><h3 class="llb-sum-h">Ert paket</h3>` +
      `<ul class="llb-list">${it.map((i: any) => `<li><span>${qtyLabel(i)}${esc(i.name)}</span><span>${kr(i.total)}</span></li>`).join('')}</ul>` +
      (builtIn ? `<p class="llb-hint">Kolumnen har inbyggd mixer och Bluetooth – koppla in mikrofonen och telefonen direkt.</p>` : '') +
      `<div class="llb-tot"><span>Per dygn</span><b>${kr(tot)}</b></div>` +
      `<p class="llb-note">Leverans, montering och flerdygnsrabatt räknas i varukorgen.</p>` +
      (compact ? '' : `<button type="button" class="llb-cta llb-add" data-add>Lägg ${it.length} artiklar i varukorgen</button><a class="llb-offert" href="/bokningssida/">Hellre en offert? Skicka förfrågan</a><p class="llb-added" hidden></p>`);
  }
  function vatMode() { try { return localStorage.getItem('sk-vat') === 'incl' ? 'incl' : 'excl'; } catch { return 'excl'; } }
  function updateVatLabel() { $('llb-bar-vat').textContent = vatMode() === 'incl' ? 'inkl. moms' : 'exkl. moms'; }
  function renderSum() {
    $('llb-sum').innerHTML = sumHTML();
    const it = itemsFor(R, S, A.seg);
    $('llb-bar-sum').innerHTML = kr(it.reduce((s: number, i: any) => s + i.total, 0));
    $('llb-bar-count').textContent = `${it.length} artiklar · per dygn`;
    if (!$('llb-sheet').hidden) $('llb-sheet-body').innerHTML = sumHTML();
  }
  function renderAll() {
    renderScene(); renderQuestions(); renderTabs(); renderPanel(); renderSum();
    (window as any).skApplyVat?.();
    updateVatLabel();
    saveState();
  }

  // ── varukorg ─────────────────────────────────────────────────
  function addAll(btn?: HTMLElement) {
    const cart = (window as any).skCart;
    if (!cart) return;
    const it = itemsFor(R, S, A.seg);
    for (const i of it) {
      cart.add({ id: i.cartId, name: i.name, price: i.price, priceNote: i.priceNote || '/dygn', category: i.category, image: i.image, artno: i.artno,
        bulky: i.bulky, forceLeverans: i.forceLeverans || undefined, monteringMin: i.monteringMin, qty: i.qty });
    }
    try { (window as any).dataLayer?.push({ event: 'ljudljus_lagg_i_varukorg', kundtyp: A.seg, gaster: A.guests, fokus: A.focus, justerat: custom, artiklar: it.length, varde: it.reduce((s: number, i: any) => s + i.total, 0) }); } catch {}
    if (btn && btn.id === 'llb-bar-add') openSheet();
    root?.querySelectorAll('.llb-added').forEach((p) => {
      (p as HTMLElement).hidden = false;
      p.innerHTML = `✓ ${it.length} artiklar ligger i varukorgen. <a href="/varukorg/">Gå till varukorgen →</a>`;
    });
    const bar = $('llb-bar-add');
    bar.textContent = '✓ Tillagt';
    setTimeout(() => { bar.textContent = 'Lägg i varukorg'; }, 1800);
  }

  // ── mobil: fast nederkant + blad ─────────────────────────────
  function openSheet() { $('llb-sheet-body').innerHTML = sumHTML(); $('llb-sheet').hidden = false; document.body.classList.add('llb-sheet-open'); (window as any).skApplyVat?.(); }
  function closeSheet() { $('llb-sheet').hidden = true; document.body.classList.remove('llb-sheet-open'); }
  const bar = $('llb-bar');
  const io = new IntersectionObserver(([e]) => {
    const on = e.isIntersecting;
    bar.classList.toggle('on', on);
    bar.setAttribute('aria-hidden', String(!on));
    (bar as any).inert = !on;
    document.body.classList.toggle('llb-bar-on', on);
  }, { threshold: 0.15 });
  io.observe(root!.querySelector('.llb-grid')!);

  // ── events ───────────────────────────────────────────────────
  root?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('[data-seg],[data-guests],[data-focus],[data-tab],[data-area],[data-showall],[data-add],[data-llb-close],#llb-bar-total,#llb-bar-add,.llb-bar-vat') as HTMLElement | null;
    if (!el) return;
    const d = el.dataset;
    if (d.seg) { if (d.seg === A.seg) return; answer({ seg: d.seg }); }
    else if (d.guests) answer({ guests: d.guests });
    else if (d.focus) answer({ focus: d.focus });
    else if (d.tab) { tab = d.tab; showAll = false; }
    else if (d.area) {
      S = fixMixer(R, { ...S, [d.area]: d.val === '' ? null : d.val! }, A.seg);
      custom = true;
    }
    else if ('showall' in d) showAll = !showAll;
    else if ('add' in d) { addAll(el); return; }
    else if ('llbClose' in d) { closeSheet(); return; }
    else if (el.id === 'llb-bar-total') { openSheet(); return; }
    else if (el.id === 'llb-bar-add') { addAll(el); return; }
    else if (el.classList.contains('llb-bar-vat')) return;
    renderAll();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
  document.getElementById('sk-vat-excl')?.addEventListener('click', () => setTimeout(updateVatLabel));
  document.getElementById('sk-vat-incl')?.addEventListener('click', () => setTimeout(updateVatLabel));
  $('llb-bar-vat').addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById(vatMode() === 'incl' ? 'sk-vat-excl' : 'sk-vat-incl')?.click();
    setTimeout(updateVatLabel);
  });
  let lastW = 0;
  window.addEventListener('resize', () => {
    const w = svg.clientWidth; if (Math.abs(w - lastW) < 200) return; lastW = w;
    layersEl.innerHTML = ''; renderScene();
  });

  loadState();
  lastW = svg.clientWidth;
  renderAll();
</script>

