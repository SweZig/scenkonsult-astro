---
import SidHuvud from '../../components/SidHuvud.astro';
import Layout from '../../layouts/Layout.astro';
import { telefon, helg } from '../../utils/hours';
---

<Layout
  title="Begär offert – Så här bokar du | Scenkonsult Norden"
  description="Välj utrustning, lägg i varukorgen och skicka in. Inte bindande – vi granskar, prissätter och bekräftar."
>
  <SidHuvud brod={[{ label: 'Hem', href: '/' }, { label: 'Begär offert' }]} eyebrow="Begär offert" h1="Så här" h1Accent="bokar du" introHtml={`Det är enkelt. Välj produkter, lägg i varukorgen och skicka in din förfrågan. Det är <strong>inte en bindande bokning</strong> — vi granskar din varukorg, bekräftar tillgänglighet och återkommer med ett konkret prisförslag.`} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">

    <!-- Steg -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      {[
        { n: '01', rubrik: 'Välj produkter', text: 'Bläddra bland våra tjänster och lägg det du behöver i varukorgen. Du kan lägga till scen, ljud, ljus, DJ och tillbehör i samma förfrågan.' },
        { n: '02', rubrik: 'Skicka förfrågan', text: 'Ange datum, leveransadress och eventuella önskemål i varukorgen. Klicka "Begär offert" — inget betalkortet krävs i det här steget.' },
        { n: '03', rubrik: 'Vi återkommer', text: 'Vi bekräftar tillgänglighet och skickar en tydlig offert med alla kostnader specificerade så snart vi kan. Sedan är det upp till dig.' },
      ].map(s => (
        <div class="rounded-3xl p-6" style="background:#14113a;border:1px solid rgba(255,255,255,0.08)">
          <div class="text-3xl font-extrabold mb-3" style="color:#c4b5f4;font-family:'DM Serif Display',serif">{s.n}</div>
          <h3 class="font-bold text-white mb-2">{s.rubrik}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>

    <!-- Viktigt att veta -->
    <div class="p-6 mb-10" style="background:rgba(196,181,244,0.07);border-left:3px solid #c4b5f4;border-radius:0 20px 20px 0">
      <h2 class="sk-h2s mb-4">Viktigt att veta</h2>
      <ul class="space-y-3 text-sm text-gray-300 leading-relaxed">
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Inte bindande</strong> — din varukorgsskickning är en förfrågan, inte ett köp. Inget debiteras förrän du accepterat offerten.</span></li>
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Frakt och montering</strong> bekräftas i offerten baserat på leveransadress och produktval — priserna i varukorgen är uppskattningar.</span></li>
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Bokningsavgift</strong> — 49 kr (exkl. moms) tillkommer för att täcka våra betalnings- och administrativa kostnader.</span></li>
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Avbokning utrustning</strong> — mer än 7 dagar: full återbetalning. 3–7 dagar: 50%. Under 3 dagar: ingen återbetalning.</span></li>
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Avbokning DJ</strong> — mer än 60 dagar: full återbetalning. 30–60 dagar: 50%. Under 30 dagar: ingen återbetalning. Se fullständiga <a href="/hyresvillkor/" class="hover:underline" style="color:#c4b5f4">hyresvillkor</a>.</span></li>
        <li class="flex gap-3"><span style="color:#c4b5f4">✓</span> <span><strong>Telefon</strong> — {telefon({ kort: false })}. På helger svarar vi i telefon enbart som jour vid pågående uthyrning — skicka förfrågan här så återkommer vi så snart vi kan. Depån har öppet {helg({ kort: false })} för hämtning och återlämning.</span></li>
      </ul>
    </div>

    <!-- CTA:ar -->
    <div class="flex flex-wrap gap-4">
      <a href="/vara-tjanster/" class="sk-knapp sk-knapp-p">
        Bläddra bland tjänster →
      </a>
      <a href="/varukorg/" class="sk-knapp">
        Till varukorgen
      </a>
      <a data-tel="MDcyNDQ4MTAwMA==" data-label="072-448 10 00" href="#tel" class="sk-knapp" style="cursor:pointer"><noscript>072-448 10 00</noscript></a>
    </div>

  </div>
</Layout>
