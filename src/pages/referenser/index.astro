---
import Layout from '../../layouts/Layout.astro';
import siteData from '../../data/site.json';
import { getReviews, getSummary } from '../../utils/reviews';
import { getClientCategories, getAllClientNames } from '../../utils/clients';

const { reviews } = siteData;

// Kundlista (underhålls i admin → Supabase, snapshot i clients.json)
const clientCategories = getClientCategories();
const clients = getAllClientNames();

// Kompletta Google-recensioner (alla, ej begränsade av Places API:ts 5-tak)
const googleReviews = getReviews();
const googleSummary = getSummary();

// Riktiga eventfoton
const eventGallery: Array<{
  src: string;
  src2?: string;
  alt: string;
  alt2?: string;
  label: string;
  desc: string;
  tag: string;
}> = [
  {
    src: "/images/event/festival_vinterviken.webp",
    src2: "/images/event/festival_vinterviken_2.webp",
    alt: "Scenuppbyggnad vid Vintervikens trädgård",
    alt2: "Publik framför scenen under konsert i Vintervikens trädgård",
    label: "Festival – Vinterviken",
    desc: "Scen & ljud, Vasas Flora & Fauna m.fl.",
    tag: "Festival"
  },
  {
    src: "/images/event/skridskodisco_ostermalm_1.webp",
    src2: "/images/event/skridskodisco_ostermalm_2.webp",
    alt: "Skridskodisco på Östermalms IP",
    alt2: "DJ- och ljudsetup för skridskodisco på Östermalms IP",
    label: "Skridskodisco – Östermalms IP",
    desc: "Stockholms Stad — DJ & ljud utomhus, återkommande event",
    tag: "Företagsevent"
  },
  {
    src: "/images/event/kundevent_abg.webp",
    alt: "Kundevent med ABG Sundal Collier",
    label: "Kundevent – ABG Sundal Collier",
    desc: "Ljud & ljus, exklusivt inomhusevent",
    tag: "Företagsevent"
  },
  {
    src: "/images/event/kundevent_djursholms_slott.webp",
    alt: "Event på Djursholms Slott",
    label: "Djursholms Slott",
    desc: "Galakväll, scenljus & PA-system",
    tag: "Företagsevent"
  },
  {
    src: "/images/event/kundevent_lakarforbundet.webp",
    alt: "Kundevent på Läkarförbundets festvåning Östermalm",
    label: "Läkarförbundet – Östermalm",
    desc: "Festvåning, komplett ljud & ljus",
    tag: "Företagsevent"
  },
  {
    src: "/images/event/uf_strawberry_arena_1.webp",
    src2: "/images/event/uf_strawberry_arena_2.webp",
    alt: "Ung Företagsamhet på Strawberry Arena",
    alt2: "Scen- och ljusrigg för Ung Företagsamhet på Strawberry Arena",
    label: "Strawberry Arena – UF",
    desc: "Ung Företagsamhet — stor scen, PA & ljusrigg",
    tag: "Konferens"
  },
  {
    src: "/images/event/kundevent_solna_naringsliv.webp",
    alt: "Konferens för Solna Näringsliv med skärmar och uplight",
    label: "Solna Näringsliv – Konferens",
    desc: "3× skärmar, uplight & PA-system",
    tag: "Konferens"
  },
  {
    src: "/images/event/kundevent_abg_konferens.webp",
    src2: "/images/event/uplight_bardisk.webp",
    alt: "ABG Sundal Collier konferens med LED-skärmar och uplight",
    alt2: "Uplight-belysning på bardisk vid event",
    label: "ABG Sundal Collier – Konferens",
    desc: "LED-skärmar, konferens-AV & uplight i lokalen",
    tag: "Konferens"
  },
  {
    src: "/images/event/kundevent_tele2_scenpodie.webp",
    alt: "Scenpodie med ridå och LED-skärm hos Tele2",
    label: "Tele2 – Scenpodie",
    desc: "Scenpodie, ridå & LED-skärm för konferens",
    tag: "Konferens"
  },
  {
    src: "/images/event/festival_hard_rock_rising.webp",
    alt: "Liveband på scen under Hard Rock Rising på Hard Rock Café",
    label: "Hard Rock Café – Hard Rock Rising",
    desc: "Global Live Music Challenge — ljud & scenljus",
    tag: "Festival"
  },
  {
    src: "/images/event/installation_german_beerhall_1.webp",
    src2: "/images/event/installation_german_beerhall_2.webp",
    alt: "Fast ljusinstallation i taket på German Beerhall",
    alt2: "LED-ramper och ljusarmaturer i taket på German Beerhall",
    label: "German Beerhall",
    desc: "Fast ljusinstallation — LED-ramper & styrning",
    tag: "Installation"
  },
  {
    src: "/images/event/festival_midnattsloppet.webp",
    alt: "Ljud- och ljusrigg på flak vid Midnattsloppet",
    label: "Midnattsloppet – Klara Färdiga Film",
    desc: "Flak med PA & ljus längs banan",
    tag: "Festival"
  },
  {
    src: "/images/event/kundevent_galleri_existens.webp",
    alt: "Projektorinstallation på trosstorn hos Galleri Existens",
    label: "Galleri Existens",
    desc: "Projektorinstallation på tross med ljud",
    tag: "Företagsevent"
  },
];

// Logotyper för "De litar på oss" — en fil per kund i /images/kunder/
const clientLogos: Array<{ src: string; name: string; w: number; h: number }> = [
  { src: "/images/kunder/logo_ica.webp", name: "ICA Sverige", w: 222, h: 114 },
  { src: "/images/kunder/logo_hornbach.webp", name: "Hornbach", w: 276, h: 52 },
  { src: "/images/kunder/logo_abg.webp", name: "ABG Sundal Collier", w: 208, h: 115 },
  { src: "/images/kunder/logo_houdini.webp", name: "Houdini", w: 325, h: 70 },
  { src: "/images/kunder/logo_mdu.webp", name: "Mälardalens universitet", w: 187, h: 111 },
  { src: "/images/kunder/logo_hacksaw.webp", name: "Hacksaw Studios", w: 201, h: 61 },
  { src: "/images/kunder/logo_hardrock.webp", name: "Hard Rock Café", w: 259, h: 150 },
  { src: "/images/kunder/logo_uf.webp", name: "UF Företagande", w: 236, h: 81 },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Våra referenser – Scenkonsult Norden",
  "description": "Se hur Scenkonsult Norden hjälpt kommuner, ambassader, företag och privatpersoner med ljud, ljus, scen och DJ sedan 1986.",
  "url": "https://scenkonsult.se/referenser/"
};
---

<Layout
  title="Våra referenser – Scenkonsult Norden | Ljud, Ljus & Scen sedan 1986"
  description="Se hur vi hjälpt Stockholm Stad, ICA Sverige, ambassader, kommuner och hundratals privatpersoner med professionell eventproduktion. Scenkonsult Norden – sedan 1986."
  schema={pageSchema}
>

  <!-- Breadcrumb -->
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-2" style="padding-top:calc(var(--nav-offset,166px) + 1.5rem)" aria-label="Brödsmulor">
    <ol class="flex items-center gap-2 text-sm text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="hover:text-gray-300 transition-colors" itemprop="item"><span itemprop="name">Hem</span></a>
        <meta itemprop="position" content="1" />
      </li>
      <span>/</span>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="text-white" itemprop="name">Referenser</span>
        <meta itemprop="position" content="2" />
      </li>
    </ol>
  </nav>

  <!-- Hero-sektion -->
  <header class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <p class="text-sm font-semibold uppercase tracking-wide mb-3" style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif">Förtroende sedan 1986</p>
    <h1 class="text-4xl sm:text-5xl font-extrabold text-white mb-6" style="font-family:'DM Serif Display',serif">
      Våra <span style="color:#c4b5f4">Kunder &amp; Uppdrag</span>
    </h1>
    <p class="text-gray-300 text-xl leading-relaxed mb-8">
      Från ambassader och kommuner till bröllopssällskap och festivaler — vi har levererat professionell scen, ljud och ljus till hundratals nöjda kunder i Storstockholm.
    </p>
    <!-- Trust stats-rad -->
    <div class="flex flex-wrap gap-6">
      <div class="flex items-center gap-2">
        <span class="text-2xl font-extrabold" style="color:#c4b5f4">100+</span>
        <span class="text-gray-400 text-sm">privatpersoner</span>
      </div>
      <div class="w-px bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-extrabold" style="color:#c4b5f4">100+</span>
        <span class="text-gray-400 text-sm">uppdrag/år</span>
      </div>
      <div class="w-px bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-extrabold" style="color:#c4b5f4">50+</span>
        <span class="text-gray-400 text-sm">referenskunder</span>
      </div>
      <div class="w-px bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-extrabold" style="color:#c4b5f4">1986</span>
        <span class="text-gray-400 text-sm">grundat</span>
      </div>
      <div class="w-px bg-white/10 hidden sm:block"></div>
      <div class="flex items-center gap-2">
        <span class="text-2xl font-extrabold" style="color:#c4b5f4">100%</span>
        <span class="text-gray-400 text-sm">nöjd-garanti</span>
      </div>
    </div>
    <p class="text-gray-400 text-sm mt-4">Utöver organisationer har vi hjälpt hundratals privatpersoner med bröllop, fester och studentfiranden i Storstockholm.</p>
  </header>

  <!-- Event-galleri -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Eventfoton</h2>
      <p class="text-gray-400">Verkliga uppdrag — från Strawberry Arena till Djursholms Slott.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {eventGallery.map((item) => (
        <div class="group relative bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all cursor-default">
          <div class="overflow-hidden bg-brand-dark relative" style="aspect-ratio:3/4">
            <img
              src={item.src}
              alt={item.alt}
              width="600"
              height="800"
              class:list={["w-full h-full object-cover group-hover:scale-105 transition-transform duration-500", item.src2 && "sk-xfade sk-xfade-a"]}
              loading="lazy"
              decoding="async"
            />
            {item.src2 && (
              <img
                src={item.src2}
                alt={item.alt2 ?? item.alt}
                width="600"
                height="800"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 sk-xfade sk-xfade-b"
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-1">
              <p class="font-semibold text-white text-sm leading-snug">{item.label}</p>
              <span class="shrink-0 text-xs px-2 py-0.5 rounded-full border" style="color:#c4b5f4;border-color:rgba(196,181,244,0.3);background:rgba(196,181,244,0.08);font-family:'Space Grotesk',sans-serif">{item.tag}</span>
            </div>
            <p class="text-gray-400 text-xs">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Logobanner -->
  <section class="sk-logobanner max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white mb-2">De litar på oss</h2>
      <p class="text-gray-400">Ett urval av de organisationer vi levererat till.</p>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {clientLogos.map((logo) => (
        <div class="flex items-center justify-center h-20 sm:h-28 px-4 rounded-xl border border-brand-orange/40">
          <img
            src={logo.src}
            alt={logo.name}
            width={logo.w}
            height={logo.h}
            class="max-h-[58%] max-w-[82%] w-auto h-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Kunder per kategori -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Utvalda kunder</h2>
      <p class="text-gray-400">Vi har förtroendet att leverera till några av Stockholms mest kräsna beställare.</p>
    </div>

    <div id="client-categories-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {clientCategories.map((cat) => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl p-6 hover:border-brand-orange/30 transition-colors">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-2xl">{cat.icon}</span>
            <h3 class="font-bold text-white">{cat.label}</h3>
          </div>
          <ul class="flex flex-wrap gap-2">
            {cat.clients.map((client) => (
              <li class="bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-sm text-gray-300 hover:border-brand-orange/30 hover:text-white transition-colors">
                {client}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Alla kunder — kompakt lista -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-brand-navy border border-white/10 rounded-2xl p-8">
      <h2 class="text-xl font-bold text-white mb-2">Samtliga referenskunder</h2>
      <p class="text-gray-400 text-sm mb-6">Totalt <span id="all-clients-count">{clients.length}</span>+ organisationer som litat på oss.</p>
      <div id="all-clients-list" class="flex flex-wrap gap-2">
        {clients.sort((a: string, b: string) => a.localeCompare(b, 'sv')).map((client: string) => (
          <span class="text-xs bg-white/5 border border-white/10 rounded-md px-2.5 py-1 text-gray-400 hover:text-white hover:border-brand-orange/30 transition-colors cursor-default">
            {client}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Hydrering av kundlistan (speglar admin-ändringar direkt) -->
  <script define:vars={{ CATEGORY_META: [
    { key: 'kommun', label: 'Kommuner & Myndigheter', icon: '🏛️' },
    { key: 'naringsliv', label: 'Näringsliv & Företag', icon: '🏢' },
    { key: 'ambassad', label: 'Ambassader & Org.', icon: '🌍' },
    { key: 'event', label: 'Event & Kultur', icon: '🎶' },
  ] }}>
    (async function hydrateClients() {
      const grid = document.getElementById('client-categories-grid');
      const listEl = document.getElementById('all-clients-list');
      const countEl = document.getElementById('all-clients-count');
      const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => (
        { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]
      ));
      let clients;
      try {
        const res = await fetch('/.netlify/functions/clients-list');
        if (!res.ok) return;
        const j = await res.json();
        if (!j || !j.ok || !Array.isArray(j.clients) || !j.clients.length) return;
        clients = j.clients;
      } catch (_) { return; }

      // Kategorier
      if (grid) {
        const cards = CATEGORY_META.map(cat => {
          const names = clients.filter(c => c.category === cat.key).map(c => c.name);
          if (!names.length) return '';
          return `
            <div class="bg-brand-navy border border-white/10 rounded-2xl p-6 hover:border-brand-orange/30 transition-colors">
              <div class="flex items-center gap-3 mb-5"><span class="text-2xl">${cat.icon}</span><h3 class="font-bold text-white">${esc(cat.label)}</h3></div>
              <ul class="flex flex-wrap gap-2">
                ${names.map(n => `<li class="bg-white/5 border border-white/10 rounded-lg px-3 py-1.5 text-sm text-gray-300 hover:border-brand-orange/30 hover:text-white transition-colors">${esc(n)}</li>`).join('')}
              </ul>
            </div>`;
        }).join('');
        if (cards) grid.innerHTML = cards;
      }

      // Samtliga (alfabetiskt)
      if (listEl) {
        const all = clients.map(c => c.name).sort((a, b) => a.localeCompare(b, 'sv'));
        listEl.innerHTML = all.map(n =>
          `<span class="text-xs bg-white/5 border border-white/10 rounded-md px-2.5 py-1 text-gray-400 hover:text-white hover:border-brand-orange/30 transition-colors cursor-default">${esc(n)}</span>`
        ).join('');
        if (countEl) countEl.textContent = String(all.length);
      }
    })();
  </script>

  <!-- Omdömen -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white mb-2">Vad våra kunder säger</h2>
      <p class="text-gray-400">Riktiga omdömen från riktiga kunder.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {reviews.map((review: { author: string; location: string; rating: number; text: string }) => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl p-6 hover:border-brand-orange/30 transition-colors flex flex-col gap-4">
          <!-- Stjärnor -->
          <div class="flex gap-0.5">
            {Array.from({ length: review.rating }).map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#c4b5f4" class="w-4 h-4">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <!-- Citat -->
          <p class="text-gray-300 leading-relaxed text-sm flex-1">"{review.text}"</p>
          <!-- Avsändare -->
          <div class="flex items-center gap-3 border-t border-white/10 pt-4">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold shrink-0" style="background:rgba(196,181,244,0.15);color:#c4b5f4">
              {review.author.charAt(0)}
            </div>
            <div>
              <p class="text-white text-sm font-semibold">{review.author}</p>
              <p class="text-gray-400 text-xs">{review.location}</p>
            </div>
          </div>
        </div>
      ))}

      <!-- Extra "tom" kort med CTA att lämna omdöme -->
      <div class="bg-brand-navy border border-dashed border-white/20 rounded-2xl p-6 flex flex-col items-center justify-center gap-3 text-center hover:border-brand-orange/30 transition-colors">
        <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:rgba(196,181,244,0.12)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
          </svg>
        </div>
        <p class="text-gray-400 text-sm">Kund hos oss? Vi tar gärna emot ditt omdöme.</p>
        <a href="/feedback/" class="text-sm font-semibold transition-colors" style="color:#c4b5f4">
          Lämna feedback →
        </a>
      </div>
    </div>
  </section>

  <!-- Google-recensioner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex items-center gap-3 mb-6">
      <h2 class="text-2xl font-bold text-white" style="font-family:'DM Serif Display',serif">På Google</h2>
      <a href="https://maps.google.com/?cid=5076721930755148492" target="_blank" rel="noopener"
        id="google-reviews-badge"
        class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium transition-colors"
        style="background:#1e1850;border:1px solid rgba(255,255,255,0.1);color:rgba(196,181,244,0.9)">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.33 0 9.25-3.65 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/></svg>
        <span id="google-reviews-badge-text">{googleSummary.ratingStr} · {googleSummary.count} recensioner</span>
      </a>
    </div>
    <div id="google-reviews-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {googleReviews.map((r) => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl p-5 flex flex-col gap-3 hover:border-brand-orange/30 transition-colors">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background:#c4b5f4;color:#0c0a24">
              {r.initials}
            </div>
            <div>
              <div class="text-white text-sm font-semibold leading-tight">{r.author}</div>
              <div class="text-gray-400 text-xs">{r.time}</div>
            </div>
            <svg class="ml-auto flex-shrink-0" width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.33 0 9.25-3.65 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/></svg>
          </div>
          <div class="flex gap-0.5">
            {Array.from({ length: r.rating }).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#f5a623"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            ))}
          </div>
          <p class="text-gray-300 text-sm leading-relaxed flex-1">"{r.text}"</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Hydrering: speglar admin-ändringar direkt (reviews-list) + live-antal från Google -->
  <script>
    (async function hydrateReviews() {
      const grid = document.getElementById('google-reviews-grid');
      const badge = document.getElementById('google-reviews-badge-text');
      const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => (
        { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]
      ));

      const [listRes, gRes] = await Promise.allSettled([
        fetch('/.netlify/functions/reviews-list'),
        fetch('/api/google-reviews?v=3'),
      ]);

      // 1. Kort + betyg från vår kompletta lista (kringgår Googles 5-tak)
      let ratingStr = null, localCount = null;
      if (listRes.status === 'fulfilled' && listRes.value.ok) {
        const j = await listRes.value.json().catch(() => null);
        if (j && j.ok && Array.isArray(j.reviews) && j.reviews.length && grid) {
          grid.innerHTML = j.reviews.map(r => {
            const stars = Array.from({ length: r.rating || 5 }).map(() =>
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="#f5a623"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>'
            ).join('');
            return `
              <div class="bg-brand-navy border border-white/10 rounded-2xl p-5 flex flex-col gap-3 hover:border-brand-orange/30 transition-colors">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background:#c4b5f4;color:#0c0a24">${esc(r.initials)}</div>
                  <div>
                    <div class="text-white text-sm font-semibold leading-tight">${esc(r.author)}</div>
                    <div class="text-gray-400 text-xs">${esc(r.time)}</div>
                  </div>
                  <svg class="ml-auto flex-shrink-0" width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.33 0 9.25-3.65 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/></svg>
                </div>
                <div class="flex gap-0.5">${stars}</div>
                <p class="text-gray-300 text-sm leading-relaxed flex-1">"${esc(r.text)}"</p>
              </div>`;
          }).join('');
          ratingStr = j.ratingStr;
          localCount = j.count;
        }
      }

      // 2. Antal live från Google (userRatingCount); betyg från vår lista
      let googleCount = null;
      if (gRes.status === 'fulfilled' && gRes.value.ok) {
        const g = await gRes.value.json().catch(() => null);
        if (g && g.ok && g.count != null) googleCount = g.count;
      }
      if (badge && (ratingStr || googleCount != null)) {
        const rStr = ratingStr || badge.textContent.split('·')[0].trim();
        const cnt = googleCount != null ? googleCount : localCount;
        if (cnt != null) badge.textContent = `${rStr} · ${cnt} recensioner`;
      }
    })();
  </script>

  <!-- CTA-sektion -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="rounded-2xl p-8 sm:p-12 text-center border border-brand-orange/20" style="background:linear-gradient(135deg,rgba(30,24,80,0.9) 0%,rgba(12,10,36,0.95) 100%)">
      <p class="text-sm font-semibold uppercase tracking-wide mb-3" style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif">Bli nästa nöjd kund</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4" style="font-family:'DM Serif Display',serif">
        Redo att skapa ert event?
      </h2>
      <p class="text-gray-400 max-w-xl mx-auto mb-8 leading-relaxed">
        Vi hjälper er med allt från rådgivning och utrustningsval till leverans och montering. Kontakta oss idag — vi svarar samma dag.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/kontakt/" class="bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-bold px-8 py-3.5 rounded-xl transition-colors text-sm">
          Begär offert
        </a>
        <a href="/vara-tjanster/" class="border border-white/30 text-white hover:bg-white/10 font-semibold px-8 py-3.5 rounded-xl transition-colors text-sm">
          Se alla tjänster
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Crossfade för eventkort med två bilder (German Beerhall) — 5 s per bild */
  .sk-xfade {
    position: absolute;
    inset: 0;
  }
  .sk-xfade-a { animation: sk-xfade-a 10s ease-in-out infinite; }
  .sk-xfade-b { animation: sk-xfade-b 10s ease-in-out infinite; }

  @keyframes sk-xfade-a {
    0%, 45% { opacity: 1; }
    55%, 95% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes sk-xfade-b {
    0%, 45% { opacity: 0; }
    55%, 95% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sk-xfade-a { animation: none; opacity: 1; }
    .sk-xfade-b { animation: none; opacity: 0; }
  }
</style>
