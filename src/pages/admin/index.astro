        </div>
        <div style="margin-bottom:0.6rem">
          <label class="form-label" style="font-size:0.72rem">Upphängning</label>
          <select id="led-cfg-mount" onchange="adminLedConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
            <option value="ground">Ground support (markställning)</option>
            <option value="tross">Tross-upphängning</option>
          </select>
