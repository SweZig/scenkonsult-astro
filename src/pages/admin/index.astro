    html += '<div style="flex:1">';
    html += '<div style="font-size:0.85rem;font-weight:600;color:' + ev.color + '">' + ev.label + '</div>';
    html += '<div style="font-size:0.75rem;color:var(--text-faint);margin-top:1px">' + fmtTime(l.created_at) + ' · ' + actorLabel + (payloadStr ? ' · ' + payloadStr : '') + '</div>';
    html += '</div></div>';
  });
  html += '</div>';
  return html;
}

