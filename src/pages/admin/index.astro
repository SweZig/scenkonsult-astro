const SVC_CATALOG_KEYS = ['Tjänster', 'Tillägg'];

function buildProductCatalogOptions() {
  let html = '<option value="">+ Välj produkt att lägga till</option>';
  Object.entries(QUOTE_CATALOG).forEach(([cat, data]) => {
    if (SVC_CATALOG_KEYS.includes(cat) || cat === 'Egen rad') return;
    if (data.products) {
      html += `<optgroup label="${cat}">`;
      data.products.forEach(p => {
        const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:cat,type:p.type||'product'}).replace(/"/g,'&quot;');
        html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
      });
      html += '</optgroup>';
    } else if (data.sub) {
      Object.entries(data.sub).forEach(([sub, prods]) => {
        html += `<optgroup label="${cat} — ${sub}">`;
        prods.forEach(p => {
          const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:`${cat} — ${sub}`,type:p.type||'product'}).replace(/"/g,'&quot;');
          html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
        });
        html += '</optgroup>';
      });
    }
  });
  return html;
}

function buildServiceCatalogOptions() {
  let html = '<option value="">+ Välj tjänst att lägga till</option>';
  Object.entries(QUOTE_CATALOG).forEach(([cat, data]) => {
    if (!SVC_CATALOG_KEYS.includes(cat)) return;
    if (data.products) {
      html += `<optgroup label="${cat}">`;
      data.products.forEach(p => {
        const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:'Tjänster',type:'service'}).replace(/"/g,'&quot;');
        html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
      });
      html += '</optgroup>';
    }
  });
  return html;
}

// Legacy alias
function buildCatalogOptions() { return buildProductCatalogOptions(); }

// ── Produkter-fliken: kategori → produkt picker ──────────────────────────────
function buildProdCatOptions() {
  return Object.keys(QUOTE_CATALOG)
    .filter(k => k !== 'Tillägg' && k !== 'Egen rad')
    .map(k => `<option value="${k}">${k}</option>`)
    .join('');
}

function prodPickCat() {
  const cat = document.getElementById('prod-cat-sel')?.value;
  const entry = QUOTE_CATALOG[cat];
  const subWrap = document.getElementById('prod-sub-wrap');
  const itemWrap = document.getElementById('prod-item-wrap');
  if (!entry) { subWrap.style.display = 'none'; itemWrap.style.display = 'none'; return; }
  if (entry.sub) {
    const subSel = document.getElementById('prod-sub-sel');
    subSel.innerHTML = '<option value="">— välj underkategori —</option>' +
      Object.keys(entry.sub).map(k => `<option value="${k}">${k}</option>`).join('');
    subWrap.style.display = '';
    itemWrap.style.display = 'none';
  } else if (entry.products) {
    subWrap.style.display = 'none';
    prodPopulateItems(entry.products);
    itemWrap.style.display = 'flex';
    itemWrap.style.alignItems = 'center';
  }
}

function prodPickSub() {
  const cat = document.getElementById('prod-cat-sel')?.value;
  const sub = document.getElementById('prod-sub-sel')?.value;
  const itemWrap = document.getElementById('prod-item-wrap');
  if (!cat || !sub) { itemWrap.style.display = 'none'; return; }
  const prods = QUOTE_CATALOG[cat]?.sub?.[sub] || [];
  prodPopulateItems(prods);
  if (prods.length) { itemWrap.style.display = 'flex'; itemWrap.style.alignItems = 'center'; }
  else { itemWrap.style.display = 'none'; }
}

function prodPopulateItems(prods) {
  const sel = document.getElementById('prod-item-sel');
  sel.innerHTML = '<option value="">— välj produkt —</option>' +
    prods.map(p => `<option value="${p.id}" data-price="${p.price}" data-name="${p.name.replace(/"/g,'&quot;')}">${p.name} — ${fmt(p.price)} kr</option>`).join('');
}

function prodPickerAdd() {
  const sel = document.getElementById('prod-item-sel');
  const opt = sel?.options[sel.selectedIndex];
  if (!opt || !opt.value) return;
  const cat = document.getElementById('prod-cat-sel')?.value || '';
  const p = { id: opt.value, name: opt.dataset.name || opt.textContent.split(' — ')[0], price: parseInt(opt.dataset.price) || 0, qty: 1, category: cat };
  const items = prodGetItems();
  const existing = items.find(i => i.id === p.id && !i.custom);
  if (existing) { existing.qty++; }
  else {
    const svcStart = items.findIndex(i => ['Tjänster','Tillägg'].includes(i.category));
    items.splice(svcStart === -1 ? items.length : svcStart, 0, p);
  }
  currentCart.items = items;
  renderTab('products');
  sel.selectedIndex = 0;
}

function catIcon(category) {
  const c = (category||'').toLowerCase();
  if (c.includes('scen'))    return { icon: '🎪', color: 'var(--blue)' };
  if (c.includes('ljud'))    return { icon: '🔊', color: 'var(--green)' };
  if (c.includes('ljus'))    return { icon: '💡', color: 'var(--amber)' };
  if (c.includes('dj'))      return { icon: '🎧', color: 'var(--brand-lav)' };
  if (c.includes('bild'))    return { icon: '📽', color: 'var(--blue)' };
  if (c.includes('tjänst') || c.includes('leverans') || c.includes('montering')) return { icon: '🚚', color: 'var(--gray)' };
  return { icon: '📦', color: 'var(--gray)' };
}

