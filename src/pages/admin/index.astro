      : `<div style="font-size:0.78rem;color:var(--text-faint);margin-top:4px">Artno: ${pid || '–'} · Kategori: ${item.category || '–'}</div>`;

    return separator + `<tr data-idx="${idx}" class="prod-row" draggable="true" ondragstart="prodDragStart(event,${idx})" ondragover="prodDragOver(event)" ondrop="prodDrop(event,${idx})" ondragend="prodDragEnd(event)" style="cursor:default">
