window.convertContactToOrder = convertContactToOrder;

// ── 48h PÅMINNELSE-SYSTEM ──────────────────────────────────────
// Cross-device-state: tidigare i localStorage ('sk_admin_reminders'),
// nu på cart-objektet i Supabase:
//   - admin_reminder_sent_at:        sätts av cart-message.js när action='yes'
//   - admin_reminder_dismissed_until: sätts av admin-reminder-dismiss.js (snooze)
// Snoozad-för-alltid använder sentinel 2099-12-31. Snoozad i 24h = NOW()+24h.
const REMINDER_HOURS = 48;
let _reminderQueue = [];  // carts som väntar på popup
let _reminderActive = null; // den cart som visas just nu
let _kanbanView = localStorage.getItem('sk_kanban_view') || 'compact'; // 'compact' | 'standard'

// ── KOLUMN-SORTERING ──────────────────────────────────────────
// Konfiguration per kolumn-status. Kolumner som saknas använder
// default-ordning från databasen (updated_at DESC).
//
// Helpers nedan; option-funktionerna måste vara definierade när de används.
function _byEventDateAsc(a, b) {
  if (!a.event_date && !b.event_date) return 0;
  if (!a.event_date) return 1;
  if (!b.event_date) return -1;
  return a.event_date < b.event_date ? -1 : 1;
}
function _byInvoiceDueAsc(a, b) {
  if (!a.invoice_due_date && !b.invoice_due_date) return 0;
  if (!a.invoice_due_date) return 1;
  if (!b.invoice_due_date) return -1;
  return a.invoice_due_date < b.invoice_due_date ? -1 : 1;
}
function _byUpdatedDesc(a, b) {
  return new Date(b.updated_at || b.created_at) - new Date(a.updated_at || a.created_at);
}
function _byUpdatedAsc(a, b) {
  return new Date(a.updated_at || a.created_at) - new Date(b.updated_at || b.created_at);
}
function _byConfirmedAsc(a, b) {
  return new Date(a.confirmed_at || a.updated_at || a.created_at)
       - new Date(b.confirmed_at || b.updated_at || b.created_at);
}

const COLUMN_SORTS = {
  waiting: {
    default: 'urgency',
    options: {
      urgency: { label: 'Brådast',    fn: (a,b) => urgencyScore(b) - urgencyScore(a) },
      event:   { label: 'Eventdatum', fn: _byEventDateAsc },
      sent:    { label: 'Äldst',      fn: _byUpdatedAsc },
    },
  },
  confirmed: {
    default: 'event',
    options: {
      event:    { label: 'Eventdatum',     fn: _byEventDateAsc },
      updated:  { label: 'Senast uppdat.', fn: _byUpdatedDesc },
      bekrold:  { label: 'Bekräftad äldst', fn: _byConfirmedAsc },
    },
  },
  fakturerad: {
    default: 'due',
    options: {
      due:     { label: 'Förfallodatum',  fn: _byInvoiceDueAsc },
      event:   { label: 'Eventdatum',     fn: _byEventDateAsc },
      updated: { label: 'Senast uppdat.', fn: _byUpdatedDesc },
    },
  },
};

// State per kolumn — initieras till default
const _columnSorts = {};
Object.entries(COLUMN_SORTS).forEach(([col, cfg]) => { _columnSorts[col] = cfg.default; });

// Returnerar true om popupen för denna cart är dismissad just nu.
function isReminderActive(c) {
  if (c.admin_reminder_sent_at) return false; // redan skickad
  if (c.admin_reminder_dismissed_until) {
    const until = new Date(c.admin_reminder_dismissed_until).getTime();
    if (until > Date.now()) return false; // dismissad, väntar på utgång
  }
  return true;
}

function checkReminderQueue() {
  const now = Date.now();
  const threshold = REMINDER_HOURS * 3600 * 1000;

  _reminderQueue = carts.filter(c => {
    if (c.status !== 'waiting') return false;
    // Kund har redan godkänt ordern digitalt — ingen påminnelse behövs
    if (c.confirmed_at) return false;
    if (!isReminderActive(c)) return false;
    // Offerten måste ha stått som waiting i minst 48h (proxy: updated_at)
    const age = now - new Date(c.updated_at || c.created_at).getTime();
    return age >= threshold;
  });

  if (_reminderQueue.length > 0 && !document.getElementById('reminder-overlay').style.display.includes('flex')) {
    showNextReminder();
  }
}

function showNextReminder() {
  // Race-skydd: filtrera mot färska carts-data (auto-refresh kan ha kört
  // mellan checkReminderQueue() och showNextReminder())
  while (_reminderQueue.length > 0) {
    const candidate = _reminderQueue.shift();
    const fresh = carts.find(c => c.id === candidate.id) || candidate;
    if (!isReminderActive(fresh)) continue;
    _reminderActive = fresh;
    break;
  }
  if (!_reminderActive) { closeReminderPopup(); return; }
  const c = _reminderActive;
  const hours = Math.round((Date.now() - new Date(c.updated_at || c.created_at).getTime()) / 3600000);
  const dateStr = c.event_date ? ` (event: ${fmtDate(c.event_date)})` : '';
  const companyStr = c.customer_company
    ? ` <span style="color:rgba(255,255,255,0.55);font-weight:400">(${c.customer_company})</span>`
    : '';

  // Lässtatus: visar om kunden har öppnat sin offertsida någon gång
  const lastRead = c.last_read_customer ? new Date(c.last_read_customer) : null;
  const readLine = lastRead
    ? `<div style="margin-top:10px;padding:8px 12px;background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.22);border-radius:6px;color:#4ade80;font-size:0.8rem;font-weight:600;">👁 Kunden har läst offerten ${readAgoText(lastRead)}</div>`
    : `<div style="margin-top:10px;padding:8px 12px;background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.22);border-radius:6px;color:#fbbf24;font-size:0.8rem;font-weight:600;">⏳ Kunden har <u>inte</u> öppnat offerten ännu</div>`;

  document.getElementById('reminder-msg').innerHTML =
    `Offerten till <strong style="color:#f0eeff">${c.customer_name || 'kunden'}</strong>${companyStr}${dateStr} har legat utan svar i <strong style="color:#c4b5f4">${hours} timmar</strong>.${readLine}<div style="margin-top:12px">Vill du skicka en påminnelse?</div>`;
  const overlay = document.getElementById('reminder-overlay');
  overlay.style.display = 'flex';
}

function closeReminderPopup() {
  document.getElementById('reminder-overlay').style.display = 'none';
  _reminderActive = null;
}

async function reminderAction(action) {
  if (!_reminderActive) return closeReminderPopup();
  const cartId = _reminderActive.id;

  if (action === 'yes') {
    // Skicka påminnelse via cart-message — backend sätter automatiskt
    // admin_reminder_sent_at på carten (cross-device)
    const defaultMsg = 'Hej! Vi vill bara påminna om offerten vi skickade – hör gärna av dig om du har frågor eller vill boka. 😊';
    const { ok } = await api('cart-message', {
      method: 'POST',
      body: JSON.stringify({ cart_id: cartId, body: defaultMsg, event_type: 'reminder_sent' })
    });
    if (ok) {
      toast('Påminnelse skickad! 📩 Syns i Chatt-fliken.');
      // Optimistisk lokal uppdatering — backend har redan satt fältet
      const cached = carts.find(c => c.id === cartId);
      if (cached) cached.admin_reminder_sent_at = new Date().toISOString();
    } else {
      toast('Kunde inte skicka påminnelse', 'error');
    }
  } else if (action === 'no' || action === 'snooze') {
    // Påminn imorgon (24h) eller aldrig igen (sentinel) — synkas till Supabase
    const dismissAction = action === 'snooze' ? 'snooze_forever' : 'snooze_24h';
    const { ok, data } = await api('admin-reminder-dismiss', {
      method: 'POST',
      body: JSON.stringify({ cart_id: cartId, action: dismissAction })
    });
    if (ok) {
      // Optimistisk lokal uppdatering
      const cached = carts.find(c => c.id === cartId);
      if (cached && data?.dismissed_until) cached.admin_reminder_dismissed_until = data.dismissed_until;
    } else {
      toast('Kunde inte spara dismiss-status', 'error');
    }
  }

  closeReminderPopup();
  // Visa nästa i kön om det finns fler
  if (_reminderQueue.length > 0) setTimeout(showNextReminder, 400);
}

window.reminderAction = reminderAction;

