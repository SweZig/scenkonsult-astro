async function adminSendSms(c) {
  const phone = c.customer_phone || '';
  const defMsg = c.cart_token
    ? `Hej ${(c.customer_name||'').split(' ')[0]}! Offert klar från Scenkonsult: https://scenkonsult.se/order/?cart=${c.id}&token=${c.cart_token}`
    : `Hej! Hör av dig till Scenkonsult Norden på 072-448 10 00.`;
  const msg = prompt(`SMS till ${phone}:`, defMsg);
  if (!msg) return;
  const { ok, data } = await api('sms-send', {
    method: 'POST',
    body: JSON.stringify({ cart_id: c.id, message: msg })
  });
  if (ok) toast('SMS skickat! ✓');
  else toast(data?.error || 'SMS-fel', 'error');
}

async function adminSendPickupLink(c) {
  const url = `https://scenkonsult.se/sign/?cart=${c.id}&token=${c.cart_token}`;

  // Kopiera länk alltid
  navigator.clipboard.writeText(url).catch(()=>{});

  // SMS-först eller mail — bestäms av backend (channel='auto')
  const hasPhone = !!c.customer_phone;
  const hasEmail = !!c.customer_email;
  if (hasPhone || hasEmail) {
    const wasSent = !!c.pickup_reminder_sent_at;
    const prevChannel = c.prepared_via === 'sms' ? 'SMS' : (c.prepared_via === 'email' ? 'mail' : 'länk');
    const targetDesc = hasPhone && hasEmail
      ? `SMS till ${c.customer_phone}, mail som fallback till ${c.customer_email}`
      : hasPhone
        ? `SMS till ${c.customer_phone}`
        : `mail till ${c.customer_email}`;
    const promptMsg = wasSent
      ? `Skicka NY påminnelse?\n\n${targetDesc}\n\n(${prevChannel === 'SMS' ? 'SMS' : 'Förberedelse-länk'} skickades senast ${new Date(c.pickup_reminder_sent_at).toLocaleString('sv-SE')})`
      : `Skicka förberedelse-länk?\n\n${targetDesc}\n\nKunden får en länk för att förbereda signatur och legitimation. Kvittensen aktiveras först när du motkvitterar vid utlämningen.`;
    if (confirm(promptMsg)) {
      const { ok: sent, data } = await api('pickup-reminder-trigger', {
        method: 'POST',
        body: JSON.stringify({ cart_id: c.id })
      });
      if (sent) {
        const via = data?.sms_sent ? 'SMS' : 'mail';
        const to  = data?.sms_sent ? (data?.to_phone || c.customer_phone) : (data?.to_email || c.customer_email);
        const fromInfo = data?.sms_sent && data?.sms_from ? ` (avs: ${data.sms_from})` : '';
        toast(`Förberedelse-länk skickad via ${via} till ${to}${fromInfo} ✓`);
        currentCart.pickup_reminder_sent_at = new Date().toISOString();
        if (data?.sms_sent)   currentCart.prepared_via = 'sms';
        else if (data?.email_sent) currentCart.prepared_via = 'email';
        loadCarts();
        renderPanelFooter();
        if (typeof renderTab === 'function') renderTab('info');
      } else {
        toast(data?.error || 'Utskick misslyckades', 'error');
      }
      return;
    }
  }
  // Varken telefon eller mail — länk kopierad
  toast('Förberedelse-länk kopierad till urklipp! (Kunden saknar telefon och e-post)');
}

