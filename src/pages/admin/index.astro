    // Remove any existing dialog
    document.getElementById('inv-confirm-dialog')?.remove();

    const dlg = document.createElement('div');
    dlg.id = 'inv-confirm-dialog';
    dlg.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem';
    dlg.innerHTML = `
      <div style="background:#1a1740;border:1px solid rgba(196,181,244,0.3);border-radius:16px;padding:1.75rem;max-width:420px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.5)">
        <div style="font-size:1rem;font-weight:700;color:#f0eeff;margin-bottom:1rem">🧾 Bekräfta fakturautskick</div>
        <div style="background:rgba(196,181,244,0.08);border:1px solid rgba(196,181,244,0.2);border-radius:10px;padding:1rem;margin-bottom:1.25rem">
          <div style="display:flex;justify-content:space-between;margin-bottom:0.5rem">
            <span style="color:rgba(255,255,255,0.5);font-size:0.85rem">Fakturanummer</span>
            <span style="color:#c4b5f4;font-weight:700;font-size:1rem">${invoiceNum}</span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:0.5rem">
            <span style="color:rgba(255,255,255,0.5);font-size:0.85rem">Belopp inkl. moms</span>
            <span style="color:#f0eeff;font-weight:600;font-size:0.9rem">${totalIncl.toLocaleString('sv-SE')} kr</span>
          </div>
          <div style="display:flex;justify-content:space-between">
            <span style="color:rgba(255,255,255,0.5);font-size:0.85rem">Mottagare</span>
            <span style="color:#f0eeff;font-size:0.85rem">${(currentCart.use_invoice_email && currentCart.invoice_email) ? currentCart.invoice_email : currentCart.customer_email}</span>
          </div>
        </div>
        <div style="margin-bottom:1.25rem">
          <label style="display:block;font-size:0.78rem;color:rgba(255,255,255,0.60);margin-bottom:4px">Justera fakturanummer (om fel)</label>
          <div style="display:flex;align-items:center;gap:6px">
            <span style="color:rgba(255,255,255,0.5);font-weight:600">K</span>
            <input id="inv-confirm-num" type="number" value="${invoiceNum.replace('K','')}" min="1"
              style="flex:1;font-size:0.9rem;padding:6px 10px;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(196,181,244,0.3);border-radius:7px;font-family:inherit">
          </div>
          <p style="font-size:0.72rem;color:rgba(255,255,255,0.60);margin-top:5px">Om du ändrar numret reserveras det föregående automatiskt.</p>
        </div>
        <div style="display:flex;gap:0.75rem">
          <button id="inv-confirm-cancel" style="flex:1;padding:0.75rem;background:transparent;border:1px solid rgba(255,255,255,0.15);border-radius:8px;color:rgba(255,255,255,0.6);cursor:pointer;font-family:inherit;font-size:0.85rem">Avbryt</button>
          <button id="inv-confirm-ok" style="flex:2;padding:0.75rem;background:#c4b5f4;border:none;border-radius:8px;color:#0c0a24;font-weight:700;cursor:pointer;font-family:inherit;font-size:0.9rem">Skicka faktura →</button>
        </div>
      </div>`;

    document.body.appendChild(dlg);

    dlg.querySelector('#inv-confirm-cancel').onclick = () => { dlg.remove(); resolve(null); };
    dlg.querySelector('#inv-confirm-ok').onclick = async () => {
      const inputNum = parseInt(dlg.querySelector('#inv-confirm-num').value);
      if (!inputNum || inputNum < 1) {
        toast('Ogiltigt fakturanummer', 'error');
        return;
      }
      const finalInvoiceNumber = 'K' + inputNum;
      const isOverride = finalInvoiceNumber !== invoiceNum;

      // Om numret ändrats: reservera serien så nästa auto-genererade nummer hoppar rätt
      if (isOverride) {
        try {
          await api('invoice-reserve', { method:'POST', body: JSON.stringify({ next_number: inputNum }) });
        } catch (e) {
          console.warn('invoice-reserve misslyckades — fortsätter ändå:', e.message);
        }
      }
      dlg.remove();
      // Returnera valt nummer atomiskt — invoice-send applicerar det
      resolve({ invoice_number: finalInvoiceNumber, override: isOverride });
    };
    dlg.onclick = e => { if (e.target === dlg) { dlg.remove(); resolve(null); } };
  });
}
window.showInvoiceConfirmDialog = showInvoiceConfirmDialog;

async function invSaveFields() {
  const updates = {
    cart_id: currentCart.id,
    invoice_date:     document.getElementById('inv-date')?.value || null,
    invoice_due_date: document.getElementById('inv-due')?.value || null,
    payment_terms_days: parseInt(document.getElementById('inv-terms')?.value || '5'),
  };
  const { ok } = await api('cart-update', { method: 'POST', body: JSON.stringify(updates) });
  if (ok) {
    Object.assign(currentCart, updates);
    toast('Fakturauppgifter sparade!');
    renderTab('faktura');
  } else toast('Kunde inte spara', 'error');
}

async function invSendEmail() {
  if (!currentCart.customer_email) { toast('Kunden saknar e-postadress', 'error'); return; }
  if (!confirm(`Skicka faktura till ${currentCart.customer_email}?`)) return;
  // Spara eventuella ändringar i fakturainfo först
  await invSaveFields().catch(() => {});
  const btn = document.querySelector('[onclick="invSendEmail()"]');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Genererar PDF…'; }
  try {
    const { ok, data } = await api('invoice-send', {
      method: 'POST',
      body: JSON.stringify({ cart_id: currentCart.id })
    });
    if (ok && !data.error) {
      currentCart.status = 'fakturerad';
      currentCart.invoice_sent_at = new Date().toISOString();
      currentCart.invoice_number = data.invoice_number;
      toast(`Faktura ${data.invoice_number} skickad! 📧`);
      loadCarts();
      renderTab('faktura');
      renderPanelFooter();
    } else {
      toast(data?.error || 'Fel vid utskick', 'error');
    }
  } catch (e) {
    toast('Nätverksfel: ' + e.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '📧 Skicka faktura via mail'; }
  }
}

async function invMarkPaid() {
  if (!confirm('Markera ordern som betald?')) return;
  const now = new Date().toISOString();

  // Auto-flytt till 'Avslutade' om eventet redan passerat (>1 dag sedan).
  // Annars stannar kortet i 'Fakturerad' med Betald-badge.
  let newStatus = currentCart.status;
  if (currentCart.event_date && currentCart.status === 'fakturerad') {
    const today = new Date(); today.setHours(0,0,0,0);
    const evDate = new Date(currentCart.event_date + 'T00:00:00');
    const daysSinceEvent = Math.round((today - evDate) / 86400000);
    if (daysSinceEvent > 1) newStatus = 'completed';
  }

  const payload = { cart_id: currentCart.id, invoice_paid_at: now };
  if (newStatus !== currentCart.status) payload.status = newStatus;

  const { ok } = await api('cart-update', { method: 'POST', body: JSON.stringify(payload) });
  if (ok) {
    currentCart.invoice_paid_at = now;
    currentCart.status = newStatus;
    toast(newStatus === 'completed' ? 'Markerad betald — flyttad till Avslutade 🏁' : 'Order markerad som betald! 💚');
    await loadCarts();
    if (currentCart) { renderTab('faktura'); renderPanelFooter(); }
  } else toast('Fel vid markering', 'error');
}

async function invUnmarkPaid() {
  if (!confirm('Avmarkera betald? Fakturan markeras som obetald igen.')) return;
  // Om kortet ligger i Avslutade (auto-promotat efter betalning) — återställ till Fakturerad
  let newStatus = currentCart.status;
  if (currentCart.status === 'completed') newStatus = 'fakturerad';

  const payload = { cart_id: currentCart.id, invoice_paid_at: null };
  if (newStatus !== currentCart.status) payload.status = newStatus;

  const { ok } = await api('cart-update', { method: 'POST', body: JSON.stringify(payload) });
  if (ok) {
    currentCart.invoice_paid_at = null;
    currentCart.status = newStatus;
    toast('Betalning avmarkerad');
    await loadCarts();
    if (currentCart) { renderTab('faktura'); renderPanelFooter(); }
  } else toast('Fel vid avmarkering', 'error');
}

async function invResend() {
  const invNum = currentCart.invoice_number;
  if (!invNum) { toast('Ingen faktura skapad än', 'error'); return; }
  if (!confirm(`Skicka om faktura ${invNum} till ${currentCart.customer_email}?`)) return;
  await invSaveFields();
  const btn = document.querySelector('[onclick="invResend()"]');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Skickar…'; }
  try {
    const { ok, data } = await api('invoice-send', {
      method: 'POST',
      body: JSON.stringify({ cart_id: currentCart.id, resend: true })
    });
    if (ok && !data.error) {
      toast('Faktura ' + invNum + ' skickad om! 📧');
    } else {
      toast(data?.error || 'Kunde inte skicka faktura', 'error');
    }
  } catch(e) { toast('Nätverksfel', 'error'); }
  renderTab('faktura');
}

// Visa preview-fakturanummer när Faktura-fliken öppnas och faktura ej skapad
async function invLoadPreviewNumber() {
  const el = document.getElementById('inv-preview-num');
  if (!el) return;
  try {
    const { ok, data } = await api('invoice-next-number');
    if (!ok || !data?.next_number) return;
    el.textContent = '→ tilldelas ' + data.next_number;
  } catch(e) { if (el) el.textContent = ''; }
}

// Uppdatera översiktskorten (Nästa nummer + Senast använt)
async function invLoadSerieOverview() {
  const nextEl = document.getElementById('inv-serie-next');
  const highEl = document.getElementById('inv-serie-highest');
  if (!nextEl && !highEl) return;
  try {
    const { ok, data } = await api('invoice-next-number');
    if (!ok || !data) return;
    if (nextEl) nextEl.textContent = data.next_number || '—';
    if (highEl) highEl.textContent = data.highest && data.highest !== 'K2009' ? data.highest : '—';
    // Pre-fylla input med ett vettigt defaultvärde (nästa nummer + 3, avrundat uppåt till jämnt 5-tal)
    const input = document.getElementById('inv-next-num');
    if (input && !input.value && data.next_num) {
      const suggest = Math.ceil((data.next_num + 3) / 5) * 5;
      input.placeholder = String(suggest);
    }
  } catch(e) { /* tyst */ }
}
window.invLoadSerieOverview = invLoadSerieOverview;

async function invLoadRecent() {
  const reservSection = document.getElementById('inv-reserv-section');
  const reservList    = document.getElementById('inv-reserv-list');
  const reservCount   = document.getElementById('inv-reserv-count');
  const recentEl      = document.getElementById('inv-recent-list');
  if (!recentEl) return;

  // Uppdatera även översiktskorten
  invLoadSerieOverview();

  recentEl.innerHTML = '<div style="color:var(--text-faint);padding:6px 0">Laddar…</div>';
  try {
    // Hämta fler rader så vi kan visa 5 riktiga fakturor + alla reservationer
    const { ok, data } = await api('invoice-list?limit=50');
    if (!ok) {
      recentEl.innerHTML = '<div style="color:var(--red)">Kunde inte ladda fakturor: ' + (data?.error || 'fel') + '</div>';
      return;
    }
    const allRows = data?.invoices || [];
    const reservations = allRows.filter(r => r.id?.startsWith('SK-RESERVE-'));
    const realInvoices = allRows.filter(r => !r.id?.startsWith('SK-RESERVE-')).slice(0, 5);

    // ── Reservationer-sektion ──
    if (reservSection) {
      if (reservations.length === 0) {
        reservSection.style.display = 'none';
      } else {
        reservSection.style.display = '';
        if (reservCount) reservCount.textContent = `(${reservations.length} st)`;
        if (reservList) {
          // Sortera K-nummer numeriskt stigande
          const sorted = reservations.slice().sort((a, b) => {
            const na = parseInt((a.invoice_number||'').slice(1)) || 0;
            const nb = parseInt((b.invoice_number||'').slice(1)) || 0;
            return na - nb;
          });
          reservList.innerHTML = sorted.map(r => {
            const cartIdAttr = encodeURIComponent(r.id);
            return `<div style="display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px dashed var(--border);font-size:0.74rem">
              <span style="font-weight:700;color:rgba(196,181,244,0.8);font-family:monospace;min-width:60px">${r.invoice_number}</span>
              <span style="color:var(--text-faint);flex:1;font-style:italic">Reserverat</span>
              <button onclick="invDeleteInvoice('${cartIdAttr}','${r.invoice_number}')" class="btn-action"
                style="font-size:0.66rem;padding:1px 7px;border-color:rgba(239,68,68,0.4);color:#f87171"
                title="Frigör numret">🗑</button>
            </div>`;
          }).join('');
        }
      }
    }

    // ── Riktiga fakturor ──
    if (realInvoices.length === 0) {
      recentEl.innerHTML = '<div style="color:var(--text-faint);font-style:italic;padding:6px 0">Inga fakturor i systemet ännu.</div>';
      return;
    }
    recentEl.innerHTML = realInvoices.map(r => {
      const total = r.total_excl ? Math.round(r.total_excl * 1.25 / 100).toLocaleString('sv-SE') + ' kr' : '—';
      const name = (r.customer_company ? r.customer_company + ' · ' : '') + (r.customer_name || '—');
      const date = r.invoice_sent_at
        ? fmtDate(r.invoice_sent_at)
        : (r.created_at ? fmtDate(r.created_at) : '—');
      const paid = r.invoice_paid_at ? ' <span style="color:var(--green);font-weight:600">· Betald</span>' : '';
      const cartIdAttr = encodeURIComponent(r.id);
      return `
        <div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border)">
          <div style="flex:1;min-width:0">
            <div style="font-weight:700;color:var(--brand-lav);font-size:0.82rem">${r.invoice_number}</div>
            <div style="color:var(--text-muted);font-size:0.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${name}</div>
            <div style="color:var(--text-faint);font-size:0.68rem">${date} · ${total}${paid}</div>
          </div>
          <div style="display:flex;gap:4px;flex-shrink:0">
            <button onclick="openDetail('${r.id}')" class="btn-action" style="font-size:0.68rem;padding:2px 7px;border-color:var(--border);color:var(--text-muted)" title="Öppna order">📂</button>
            <button onclick="invDeleteInvoice('${cartIdAttr}','${r.invoice_number}')" class="btn-action"
              style="font-size:0.68rem;padding:2px 8px;border-color:rgba(239,68,68,0.5);color:#f87171"
              title="Radera faktura och frigör numret">🗑 Radera</button>
          </div>
        </div>`;
    }).join('');
  } catch (e) {
    recentEl.innerHTML = '<div style="color:var(--red)">Fel: ' + e.message + '</div>';
  }
}

// Rensa alla SK-RESERVE-* rader i ett svep
async function invClearAllReservations() {
  try {
    const { ok, data } = await api('invoice-list?limit=100');
    if (!ok) { toast('Kunde inte ladda reservationer', 'error'); return; }
    const reservations = (data?.invoices || []).filter(r => r.id?.startsWith('SK-RESERVE-'));
    if (reservations.length === 0) { toast('Inga reservationer att rensa'); return; }

    if (!confirm(`Rensa alla ${reservations.length} reservationer?\n\nAlla K-nummer som för närvarande är reserverade (men ej tilldelade riktiga fakturor) frigörs. Luckorna fylls automatiskt vid nästa fakturagenerering.\n\nDetta kan INTE ångras.`)) return;

    let done = 0, failed = 0;
    for (const r of reservations) {
      try {
        const { ok: delOk, data: delData } = await api('invoice-delete', {
          method: 'POST', body: JSON.stringify({ cart_id: r.id })
        });
        if (delOk && !delData?.error) done++; else failed++;
      } catch(e) { failed++; }
    }
    if (failed === 0) toast(`${done} reservation${done!==1?'er':''} rensad${done!==1?'e':''}`);
    else toast(`${done} rensade, ${failed} misslyckades`, 'error');
    invLoadRecent();
  } catch(e) {
    toast('Nätverksfel: ' + e.message, 'error');
  }
}
window.invClearAllReservations = invClearAllReservations;
window.invLoadRecent = invLoadRecent;

