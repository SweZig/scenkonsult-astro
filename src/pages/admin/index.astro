// ── 48h PÅMINNELSE-SYSTEM ──────────────────────────────────────
const REMINDER_HOURS = 48;
const REMINDER_LS_KEY = 'sk_admin_reminders'; // { [cartId]: 'snoozed' | 'sent' | <iso-dismissed-ts> }
let _reminderQueue = [];  // carts som väntar på popup
let _reminderActive = null; // den cart som visas just nu
let _waitingSort = 'urgency'; // 'urgency' | 'event' | 'sent'
let _kanbanView = localStorage.getItem('sk_kanban_view') || 'compact'; // 'compact' | 'standard'

function getReminderState() {
  try { return JSON.parse(localStorage.getItem(REMINDER_LS_KEY) || '{}'); } catch { return {}; }
}
function setReminderState(s) { localStorage.setItem(REMINDER_LS_KEY, JSON.stringify(s)); }

function checkReminderQueue() {
  const now = Date.now();
  const state = getReminderState();
  const threshold = REMINDER_HOURS * 3600 * 1000;

  _reminderQueue = carts.filter(c => {
    if (c.status !== 'waiting') return false;
    // Kund har redan godkänt ordern digitalt — ingen påminnelse behövs
    if (c.confirmed_at) return false;
    const cartState = state[c.id];
    if (cartState === 'snoozed' || cartState === 'sent') return false;
    // Dismissad < 24h sedan → hoppa över
    if (cartState && (now - new Date(cartState).getTime()) < 24 * 3600 * 1000) return false;
    // Offerten måste ha stått som waiting i minst 48h (proxy: updated_at)
    const age = now - new Date(c.updated_at || c.created_at).getTime();
    return age >= threshold;
  });

  if (_reminderQueue.length > 0 && !document.getElementById('reminder-overlay').style.display.includes('flex')) {
    showNextReminder();
  }
}

function showNextReminder() {
  // Filtrera bort carts som redan hanterats (race condition-skydd)
  const currentState = getReminderState();
  while (_reminderQueue.length > 0) {
    const candidate = _reminderQueue.shift();
    const s = currentState[candidate.id];
    if (s === 'snoozed' || s === 'sent') continue; // redan hanterad
    if (s && (Date.now() - new Date(s).getTime()) < 24 * 3600 * 1000) continue; // nyligen dismissad
    _reminderActive = candidate;
    break;
  }
  if (!_reminderActive) { closeReminderPopup(); return; }
  const c = _reminderActive;
  const hours = Math.round((Date.now() - new Date(c.updated_at || c.created_at).getTime()) / 3600000);
  const dateStr = c.event_date ? ` (event: ${fmtDate(c.event_date)})` : '';
  const companyStr = c.customer_company
    ? ` <span style="color:rgba(255,255,255,0.55);font-weight:400">(${c.customer_company})</span>`
    : '';

  // Lässtatus: visar om kunden har öppnat sin offertsida någon gång
  const lastRead = c.last_read_customer ? new Date(c.last_read_customer) : null;
  const readLine = lastRead
    ? `<div style="margin-top:10px;padding:8px 12px;background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.22);border-radius:6px;color:#4ade80;font-size:0.8rem;font-weight:600;">👁 Kunden har läst offerten ${readAgoText(lastRead)}</div>`
    : `<div style="margin-top:10px;padding:8px 12px;background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.22);border-radius:6px;color:#fbbf24;font-size:0.8rem;font-weight:600;">⏳ Kunden har <u>inte</u> öppnat offerten ännu</div>`;

  document.getElementById('reminder-msg').innerHTML =
    `Offerten till <strong style="color:#f0eeff">${c.customer_name || 'kunden'}</strong>${companyStr}${dateStr} har legat utan svar i <strong style="color:#c4b5f4">${hours} timmar</strong>.${readLine}<div style="margin-top:12px">Vill du skicka en påminnelse?</div>`;
  const overlay = document.getElementById('reminder-overlay');
  overlay.style.display = 'flex';
}

function closeReminderPopup() {
  document.getElementById('reminder-overlay').style.display = 'none';
  _reminderActive = null;
}

async function reminderAction(action) {
  if (!_reminderActive) return closeReminderPopup();
  const cartId = _reminderActive.id;
  const state = getReminderState();

  if (action === 'yes') {
    // Skicka påminnelse via cart-message (samma som admin-notis)
    const defaultMsg = 'Hej! Vi vill bara påminna om offerten vi skickade – hör gärna av dig om du har frågor eller vill boka. 😊';
    const { ok } = await api('cart-message', {
      method: 'POST',
      body: JSON.stringify({ cart_id: cartId, body: defaultMsg, event_type: 'reminder_sent' })
    });
    if (ok) {
      toast('Påminnelse skickad! 📩 Syns i Chatt-fliken.');
      state[cartId] = 'sent';
    } else {
      toast('Kunde inte skicka påminnelse', 'error');
    }
  } else if (action === 'no') {
    // Påminn igen imorgon
    state[cartId] = new Date().toISOString();
  } else if (action === 'snooze') {
    // Visa aldrig igen för denna offert
    state[cartId] = 'snoozed';
  }

  setReminderState(state);
  closeReminderPopup();
  // Visa nästa i kön om det finns fler
  if (_reminderQueue.length > 0) setTimeout(showNextReminder, 400);
}

window.reminderAction = reminderAction;

function setKanbanView(mode) {
  _kanbanView = mode;
  localStorage.setItem('sk_kanban_view', mode);
