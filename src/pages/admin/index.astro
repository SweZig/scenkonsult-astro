    const isComplaint = c.bounce_status === 'complained';
    const isDelayed   = c.bounce_status === 'delayed';
    const bg     = isComplaint ? 'rgba(251,146,60,0.12)' : isDelayed ? 'rgba(251,191,36,0.10)' : 'rgba(239,68,68,0.12)';
    const border = isComplaint ? 'rgba(251,146,60,0.55)' : isDelayed ? 'rgba(251,191,36,0.45)' : 'rgba(239,68,68,0.6)';
    const color  = isComplaint ? '#fdba74' : isDelayed ? '#fbbf24' : '#fca5a5';
