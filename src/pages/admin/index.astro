// Exponera funktioner som används i onclick-attribut i dynamisk innerHTML
// ── PDF-NEDLADDNING ──────────────────────────────────────────────────────────
// Hjälpfunktion: hämtar PDF-blob från invoice-pdf-download och triggar nedladdning
async function _triggerPdfDownload(mode) {
  if (!currentCart) { toast('Ingen order vald', 'error'); return; }
  const btn = document.querySelector(`[onclick="${mode === 'order' ? 'prodDownloadOrderPdf' : 'invDownloadPdf'}()"]`);
  const origText = btn ? btn.textContent : '';
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Genererar PDF…'; }
  try {
    const { ok, data } = await api('invoice-pdf-download', {
      method: 'POST',
      body: JSON.stringify({ cart_id: currentCart.id, mode }),
    });
    if (!ok || data.error) {
      toast(data?.error || 'Fel vid PDF-generering', 'error');
      return;
    }
    // Konvertera base64 → Blob → <a download>
    const binary = atob(data.pdf_b64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    const blob = new Blob([bytes], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = data.filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 2000);

    if (mode === 'faktura' && data.invoice_number) {
      currentCart.invoice_number = data.invoice_number;
      toast(`PDF sparad: ${data.filename} (${data.invoice_number})`);
    } else {
      toast(`PDF sparad: ${data.filename}`);
    }
  } catch (e) {
    toast('Nätverksfel: ' + e.message, 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = origText; }
  }
}

async function prodDownloadOrderPdf() {
  await _triggerPdfDownload('order');
}

async function invDownloadPdf() {
  await _triggerPdfDownload('faktura');
}

