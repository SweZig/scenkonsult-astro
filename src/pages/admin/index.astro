        </div>
        <div style="margin-bottom:0.6rem">
          <label class="form-label" style="font-size:0.72rem">Panel</label>
          <select id="led-cfg-panel" onchange="adminLedConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem"></select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:0.6rem">
