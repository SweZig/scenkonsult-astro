  const EVENT_LABELS = {
    'offer_opened_first': { icon: '👁️', label: 'Kunden öppnade offerten (första gången)', color: 'var(--brand-lav)', highlight: true },
    'offer_opened':       { icon: '👁',  label: 'Kunden öppnade offerten igen', color: 'rgba(196,181,244,0.6)' },
