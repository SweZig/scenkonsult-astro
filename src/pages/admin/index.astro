  const items = allItems.filter(i => !i._note);
  const total = items.filter(i => i.name?.trim()).reduce((s,i) => s + ((i.price||0)*(i.qty||i.quantity||1)), 0);

  const SVC_CATS_DISPLAY = ['Tjänster', 'Tillägg'];
  const isSvcItem = i => i.type === 'service' || SVC_CATS_DISPLAY.includes(i.category);
  const firstSvcIdx = items.findIndex(i => isSvcItem(i));

  const rows = items.map((item, idx) => {
    const qty = item.qty || item.quantity || 1;
    const price = item.price || 0;
