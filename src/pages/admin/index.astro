  'offer_opened':               { icon: '👁',  label: 'Kunden öppnade offerten igen',           color: 'rgba(196,181,244,.6)' },
  'messages_read':              { icon: '✓✓', label: 'Kunden läste meddelanden',                color: 'rgba(255,255,255,.55)' },
  'message_sent':               { icon: '💬', label: 'Meddelande skickat',                      color: 'rgba(255,255,255,.65)' },
  'reminder_sent':              { icon: '⏰', label: 'Påminnelse skickad',                      color: 'var(--amber)' },
  'status_change':              { icon: '🔄', label: 'Status ändrad',                           color: 'var(--amber)' },
  'pickup_signed':              { icon: '✍️', label: 'Utlämning kvitterad',                    color: 'var(--green)' },
