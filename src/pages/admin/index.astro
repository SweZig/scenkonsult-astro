function openActivityDrawer() {
  const ov = document.getElementById('activity-overlay');
  const dr = document.getElementById('activity-drawer');
  if (!ov || !dr) return;
  ov.style.display = 'block';
  dr.style.pointerEvents = 'auto';
  requestAnimationFrame(() => { dr.style.transform = 'translateX(0)'; });
  _updateActivityFilterButtons();
  loadRecentActivity();
}

function closeActivityDrawer() {
  const ov = document.getElementById('activity-overlay');
  const dr = document.getElementById('activity-drawer');
  if (!ov || !dr) return;
  dr.style.transform = 'translateX(100%)';
  setTimeout(() => {
    ov.style.display = 'none';
    dr.style.pointerEvents = 'none';
  }, 250);
}

function setActivityFilter(f) {
  _activityFilter = f;
  _updateActivityFilterButtons();
  loadRecentActivity();
}

function _updateActivityFilterButtons() {
  document.querySelectorAll('[data-activity-filter]').forEach(b => {
    b.setAttribute('aria-pressed', b.dataset.activityFilter === _activityFilter ? 'true' : 'false');
  });
}

async function loadRecentActivity() {
  const body = document.getElementById('activity-body');
  if (!body) return;
  body.innerHTML = '<div style="padding:2rem;text-align:center;color:rgba(255,255,255,.4)">Laddar…</div>';
  const { ok: success, data } = await api(`admin-recent-activity?limit=80&type=${encodeURIComponent(_activityFilter)}`);
  if (!success) {
    body.innerHTML = '<div style="padding:1.5rem;text-align:center;color:var(--red)">Kunde inte ladda aktivitet</div>';
    return;
  }
  const items = data?.items || data?.messages || []; // bakåtkompat med gammalt fält
  if (!items.length) {
    body.innerHTML = '<div style="padding:2rem;text-align:center;color:rgba(255,255,255,.4);font-size:0.85rem">Inget att visa</div>';
    return;
  }
  body.innerHTML = items.map(i => i.kind === 'event' ? _activityEventRow(i) : _activityMessageRow(i)).join('');
}

function _activityMessageRow(m) {
  const isCust = m.sender === 'customer';
  const isUnread = isCust && !m.read_at;
  const senderLabel = isCust ? '👤 Kund' : '🛠 Vi';
  const senderColor = isCust ? '#c4b5f4' : 'rgba(255,255,255,.55)';
  const time = m.created_at ? new Date(m.created_at) : null;
  const timeStr = time ? _activityRelativeTime(time) : '';
  const cust = (m.customer_company || m.customer_name || 'Okänd kund');
  const snippet = (m.body || '').slice(0, 90).replace(/\s+/g, ' ').trim();
  const snippetExtra = (m.body || '').length > 90 ? '…' : '';
  const unreadDot = isUnread ? '<span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--red);margin-right:6px;vertical-align:middle"></span>' : '';
  const cartIdShort = (m.cart_id || '').replace(/^SK-/, '').slice(0, 12);
  return `
    <div onclick="openFromActivity('${m.cart_id}','chat')"
         style="padding:0.7rem 1rem;border-bottom:1px solid rgba(255,255,255,.05);cursor:pointer;transition:background .12s"
         onmouseover="this.style.background='rgba(196,181,244,.06)'"
         onmouseout="this.style.background='transparent'">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;margin-bottom:3px">
        <div style="font-weight:600;font-size:.88rem;color:#f0eeff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${unreadDot}${cust.replace(/</g,'&lt;')}</div>
        <div style="font-size:.7rem;color:rgba(255,255,255,.45);white-space:nowrap">${timeStr}</div>
      </div>
      <div style="display:flex;gap:.5rem;font-size:.78rem;color:rgba(255,255,255,.7);line-height:1.4">
        <span style="color:${senderColor};font-weight:500;white-space:nowrap">${senderLabel}:</span>
        <span style="flex:1;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">${snippet.replace(/</g,'&lt;')}${snippetExtra}</span>
      </div>
      <div style="font-size:.66rem;color:rgba(255,255,255,.3);margin-top:3px;font-family:monospace">${cartIdShort}</div>
    </div>`;
}

function _activityEventRow(e) {
  const meta = ACTIVITY_EVENT_LABELS[e.event_type] || { icon: '·', label: e.event_type || 'Händelse', color: 'rgba(255,255,255,.5)' };
  const time = e.created_at ? new Date(e.created_at) : null;
  const timeStr = time ? _activityRelativeTime(time) : '';
  const cust = (e.customer_company || e.customer_name || 'Okänd kund');
  const cartIdShort = (e.cart_id || '').replace(/^SK-/, '').slice(0, 12);

  // Förenkla payload till en utdrag-rad (för status_change visa from→to)
  let detail = '';
  if (e.payload && typeof e.payload === 'object') {
    if (e.event_type === 'status_change' && e.payload.from && e.payload.to) {
      detail = `${e.payload.from} → ${e.payload.to}`;
    } else if (e.payload.preview) {
      detail = `"${String(e.payload.preview).slice(0, 80)}"`;
    } else {
      const parts = Object.entries(e.payload)
        .filter(([k]) => !['preview'].includes(k))
        .slice(0, 2)
        .map(([k,v]) => `${k}: ${typeof v === 'object' ? JSON.stringify(v).slice(0,30) : String(v).slice(0,30)}`);
      detail = parts.join(' · ');
    }
  }
  const actorLabel = e.actor === 'customer' ? 'Kund' : e.actor === 'admin' ? 'Vi' : 'System';
  return `
    <div onclick="openFromActivity('${e.cart_id}','log')"
         style="padding:0.7rem 1rem;border-bottom:1px solid rgba(255,255,255,.05);cursor:pointer;transition:background .12s"
         onmouseover="this.style.background='rgba(196,181,244,.06)'"
         onmouseout="this.style.background='transparent'">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:.5rem;margin-bottom:3px">
        <div style="font-weight:600;font-size:.88rem;color:#f0eeff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${cust.replace(/</g,'&lt;')}</div>
        <div style="font-size:.7rem;color:rgba(255,255,255,.45);white-space:nowrap">${timeStr}</div>
      </div>
      <div style="display:flex;gap:.5rem;font-size:.78rem;color:${meta.color};line-height:1.4">
        <span style="white-space:nowrap">${meta.icon} ${meta.label}</span>
        ${detail ? `<span style="color:rgba(255,255,255,.5);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${String(detail).replace(/</g,'&lt;')}</span>` : ''}
      </div>
      <div style="font-size:.66rem;color:rgba(255,255,255,.3);margin-top:3px;font-family:monospace">${cartIdShort} · ${actorLabel}</div>
    </div>`;
}

function _activityRelativeTime(d) {
  const now = Date.now();
  const diff = now - d.getTime();
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1)   return 'nyss';
  if (minutes < 60)  return `${minutes}m sen`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24)    return `${hours}h sen`;
  const days = Math.floor(hours / 24);
  if (days < 7)      return `${days}d sen`;
  // Äldre: visa datum
  return d.toLocaleDateString('sv-SE', { month: 'short', day: 'numeric' });
}

function openFromActivity(cartId, tab) {
  if (!cartId) return;
  closeActivityDrawer();
  activeTab = tab || 'chat';
  openDetail(cartId);
}

