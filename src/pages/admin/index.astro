// ── Drag-and-drop reordering ─────────────────────────────────
let _dragSrcIdx = null;

function prodDragStart(e, idx) {
  _dragSrcIdx = idx;
  e.dataTransfer.effectAllowed = 'move';
  e.currentTarget.style.opacity = '0.4';
}

function prodDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  // Highlight drop target
  document.querySelectorAll('.prod-row').forEach(r => r.style.borderTop = '');
  e.currentTarget.style.borderTop = '2px solid var(--brand-lav)';
}

function prodDrop(e, dropIdx) {
  e.preventDefault();
  if (_dragSrcIdx === null || _dragSrcIdx === dropIdx) return;
  const items = prodGetItems();
  const dragged = items[_dragSrcIdx];
  items.splice(_dragSrcIdx, 1);
  const newPos = _dragSrcIdx < dropIdx ? dropIdx - 1 : dropIdx;
  items.splice(newPos, 0, dragged);
  currentCart.items = items;
  renderTab('products');
}

function prodDragEnd(e) {
  _dragSrcIdx = null;
  e.currentTarget.style.opacity = '';
  document.querySelectorAll('.prod-row').forEach(r => r.style.borderTop = '');
}
window.prodDragStart = prodDragStart;
window.prodDragOver  = prodDragOver;
window.prodDrop      = prodDrop;
window.prodDragEnd   = prodDragEnd;

function prodTogglePopout(idx) {
  const el = document.getElementById('po-' + idx);
  if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function prodAddFromCatalog(sel, isService) {
  if (!sel.value) return;
  try {
    const p = JSON.parse(sel.value.replace(/&quot;/g,'"'));
    const items = prodGetItems();
    const svcStart = items.findIndex(i => ['Tjänster','Tillägg'].includes(i.category));
    const newItem = { id: p.id||'', name: p.name||'', price: p.price||0, qty: 1, category: p.category||'', type: p.type||'product' };
    if (isService || svcStart === -1) {
      items.push(newItem); // tjänster alltid sist, eller om inga tjänster finns
    } else {
      items.splice(svcStart, 0, newItem); // produkter insertas före första tjänst
    }
    currentCart.items = items;
    renderTab('products');
  } catch(e) { toast('Fel vid tillägg', 'error'); }
  sel.value = '';
}

function prodAddFreeRow(isService) {
  const items = prodGetItems();
  const svcStart = items.findIndex(i => ['Tjänster','Tillägg'].includes(i.category));
  const newItem = { id: '', name: '', price: 0, qty: 1, category: isService ? 'Tjänster' : '' };
  if (isService || svcStart === -1) {
    items.push(newItem);
  } else {
    items.splice(svcStart, 0, newItem);
  }
  currentCart.items = items;
  renderTab('products');
}

function prodUpdateSvc() {
  // Remove existing service rows, add back selected ones
  const items = prodGetItems().filter(i => !['lev-standard','lev-skrymmande','lev-lastbil','lev-standard-e','montering','fakturaavgift',
    'lev-standard-e','lev-skrymmande-e','lev-lastbil-e'].some(sid => i.id === sid || i.id === sid + '-e'));
  
  const addSvc = (selId) => {
    const sel = document.getElementById(selId);
    if (!sel || !sel.value) return;
    const [name, price, id] = sel.value.split('|');
    if (name && price) items.push({ id, name, price: parseInt(price), qty: 1, category: 'Tjänster' });
  };
  addSvc('svc-leverans');
  addSvc('svc-montering');
  addSvc('svc-faktura');
  currentCart.items = items;
  renderTab('products');
}

