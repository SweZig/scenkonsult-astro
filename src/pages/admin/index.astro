        <div style="font-size:0.75rem;color:rgba(196,181,244,0.55);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;margin-bottom:0.5rem">Utlämning</div>
        <div style="background:rgba(0,0,0,0.2);border-radius:8px;padding:0.75rem 1rem;margin-bottom:1rem;font-size:0.85rem;line-height:1.65">
          📅 ${dateStr || 'Ej angivet'} kl ${timeStr}<br>
          📍 ${(c.event_location || 'Grimstagatan 164, Vällingby').replace(/</g,'&lt;')}
        </div>

        <div style="font-size:0.75rem;color:rgba(196,181,244,0.55);text-transform:uppercase;letter-spacing:0.05em;font-weight:700;margin-bottom:0.5rem">Utrustning att lämna ut (${items.length})</div>
        ${items.length ? `
        <table style="width:100%;border-collapse:collapse;background:rgba(0,0,0,0.2);border-radius:8px;overflow:hidden;margin-bottom:1rem">
          <tbody>${itemRows}${moreCount ? `<tr><td colspan="2" style="padding:5px 8px;font-size:0.8rem;color:rgba(255,255,255,0.5);font-style:italic">+ ${moreCount} till…</td></tr>` : ''}</tbody>
        </table>` : ''}

        <div style="background:rgba(251,191,36,0.06);border:1px solid rgba(251,191,36,0.2);border-radius:10px;padding:0.85rem 1rem;margin-bottom:1rem">
          <div style="font-weight:700;color:#fbbf24;font-size:0.9rem;margin-bottom:0.5rem">Har all utrustning överlämnats korrekt?</div>
          <div style="font-size:0.82rem;line-height:1.55;color:rgba(255,255,255,0.78);margin-bottom:0.75rem">
            När du klickar "Bekräfta utlämning" aktiveras kundens signatur som juridiskt bindande. PDF-kvitto skickas till kunden.
          </div>
          <label style="display:block;font-size:0.75rem;color:rgba(196,181,244,0.65);margin-bottom:0.35rem;text-transform:uppercase;letter-spacing:0.05em;font-weight:700">Anteckning om något avvek (frivilligt)</label>
          <textarea id="pc-note" rows="2" placeholder="Ex: 'Strömkabel extra utlånad', 'Ersatt mot likvärdig modell'..." style="width:100%;background:#0c0a24;color:#f0eeff;border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:0.5rem 0.65rem;font-size:0.85rem;font-family:inherit;resize:vertical;color-scheme:dark"></textarea>
        </div>
      </div>

      <div style="padding:0.85rem 1.25rem;border-top:1px solid rgba(255,255,255,0.08);display:flex;gap:0.5rem;justify-content:flex-end;flex-wrap:wrap">
        <button id="pc-cancel" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.85);padding:0.55rem 1.1rem;border-radius:8px;font-size:0.85rem;cursor:pointer">Avbryt</button>
        <button id="pc-confirm" style="background:#22c55e;border:none;color:#fff;padding:0.55rem 1.25rem;border-radius:8px;font-size:0.85rem;font-weight:700;cursor:pointer">✅ Bekräfta utlämning</button>
      </div>
    </div>`;

  document.body.appendChild(overlay);
  document.body.style.overflow = 'hidden';

  const close = () => { overlay.remove(); document.body.style.overflow = ''; };
  overlay.querySelector('#pc-close').onclick = close;
  overlay.querySelector('#pc-cancel').onclick = close;
  overlay.onclick = (e) => { if (e.target === overlay) close(); };

  overlay.querySelector('#pc-confirm').onclick = async () => {
    const note = overlay.querySelector('#pc-note').value.trim();
    const btn = overlay.querySelector('#pc-confirm');
    btn.disabled = true; btn.textContent = '⏳ Bekräftar…';
    const { ok, data } = await api('pickup-confirm', {
      method: 'POST',
      body: JSON.stringify({ cart_id: c.id, admin_note: note || null })
    });
    if (ok) {
      currentCart.pickup_confirmed_at = data?.confirmed_at || new Date().toISOString();
      if (note) currentCart.pickup_admin_note = note;
      toast('Utlämning bekräftad ✅ Kvittensen är nu juridiskt bindande');
      close();
      loadCarts();
      renderTab('info');
      renderPanelFooter();
    } else {
      btn.disabled = false; btn.textContent = '✅ Bekräfta utlämning';
      toast(data?.error || 'Kunde inte bekräfta', 'error');
    }
  };
}
window.adminOpenPickupConfirm = adminOpenPickupConfirm;

function adminShowPickup(c) {
  if (!c.pickup_signature) { toast('Ingen kvittens sparad', 'error'); return; }
  const w = window.open('', '_blank', 'width=480,height=640');
  const photoHtml = c.pickup_id_photo
    ? `<img src="${c.pickup_id_photo}" style="width:100%;border-radius:8px;margin-top:1rem">`
    : '<p style="color:#888;font-size:0.8rem">Inget legitimationsfoto</p>';
  w.document.write(`<!DOCTYPE html><html><head><title>Kvittens ${c.id}</title>
    <meta charset="UTF-8"><style>body{background:#0c0a24;color:#fff;font-family:Arial;padding:1.5rem;}</style></head>
    <body>
    <h2 style="font-size:1.1rem;margin-bottom:0.25rem">Utlämningskvittens</h2>
    <p style="color:#888;font-size:0.8rem;margin-bottom:1rem">${c.id} · ${c.customer_name} · ${new Date(c.pickup_signed_at).toLocaleString('sv-SE')}</p>
    <img src="${c.pickup_signature}" style="width:100%;border:1px solid rgba(255,255,255,0.15);border-radius:8px;background:#fff">
    <p style="color:#666;font-size:0.75rem;margin-top:0.5rem">IP: ${c.pickup_sign_ip || '–'}</p>
    ${photoHtml}
    </body></html>`);
}

function renderPanelFooter() {
  const c = currentCart;
  const footer = $('panel-footer');
  footer.innerHTML = '';

  const makeBtn = (label, cls, fn) => {
    const b = document.createElement('button');
    b.className = `btn-action ${cls}`;
    b.textContent = label;
    b.onclick = fn;
    footer.appendChild(b);
  };

  // "Skicka om offert" — knapp synlig för statusar där en offert redan skickats.
  // När bounce_status är satt visas knappen prominent i röd/orange för att
  // signalera att admin behöver agera.
  const hasBounce = ['bounced','complained'].includes(c.bounce_status);
  const resendBtnLabel = hasBounce
    ? (c.bounce_status === 'complained' ? '🚫 Skicka om offert (markerad som spam)' : '⚠ Skicka om offert (mailet studsade)')
    : '📤 Skicka om offert';
  const resendBtnCls = hasBounce ? 'btn-danger' : '';
  const showResend = ['waiting','confirmed','fakturerad','completed'].includes(c.status);

  // Context-sensitive buttons based on status
  if (c.status === 'new') {
    // Öppna offert-modalen direkt med varukorgens produkter förifyllda.
    // sendQuote() sätter automatiskt status new → waiting när mailet skickats.
    makeBtn('📤 Skapa & skicka offert', 'btn-success', () => openQuoteModalForCart(c));
    makeBtn('❌ Avvisa', 'btn-danger', cancelOrder);

  } else if (c.status === 'waiting') {
    makeBtn('✅ Bekräfta order', 'btn-success', confirmOrder);
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
    makeBtn('📩 Påminn kund', '', sendCustomerNotice);
    makeBtn('❌ Avbryt', 'btn-danger', cancelOrder);
  } else if (c.status === 'confirmed') {
    makeBtn('🧾 Skapa faktura', 'btn-success', () => renderTab('faktura'));
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status === 'fakturerad') {
    if (c.invoice_paid_at) {
      // Redan betald — visa avmarkera-knapp för rättning av miss-klick
      makeBtn('↩ Avmarkera betald', '', invUnmarkPaid);
    } else {
      makeBtn('💚 Markera betald', 'btn-success', invMarkPaid);
    }
    makeBtn('📩 Påminn om betalning', '', sendCustomerNotice);
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status === 'completed') {
    // Avslutade ordrar: minimala actions
    if (!c.invoice_paid_at) {
      // Edge case: order avslutad utan att fakturan är betald (manuellt flyttad?)
      makeBtn('💚 Markera betald', 'btn-success', invMarkPaid);
    } else {
      makeBtn('↩ Avmarkera betald', '', invUnmarkPaid);
    }
    if (showResend && hasBounce) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status !== 'cancelled') {
    makeBtn('✅ Bekräfta order', 'btn-success', confirmOrder);
    makeBtn('📤 Skicka offert', '', () => openQuoteModalForCart(c));
    makeBtn('❌ Avbryt', 'btn-danger', cancelOrder);
  }

  // Always: copy customer link if exists
  if (c.cart_token) {
    makeBtn('🔗 Kopiera kundlänk', '', () => {
      const url = `https://scenkonsult.se/order/?cart=${c.id}&token=${c.cart_token}`;
      navigator.clipboard.writeText(url);
      toast('Kundlänk kopierad!');
    });
  }

  // Återkommande kund: skapa ny offert med samma kundinfo förifylld.
  // Visas för alla statusar utom 'cancelled'.
  if (c.customer_name && c.customer_email && c.status !== 'cancelled') {
    makeBtn('📋 Ny offert till samma kund', '', () => cloneCustomerToNewQuote(c));
  }

  // SMS-knapp om telefonnummer finns
  if (c.customer_phone) {
    makeBtn('💬 Skicka SMS', '', () => adminSendSms(c));
  }

  // Utlämning — flerstegs-flöde (förberedelse-länk → förberedd → motkvittens)
  if (['confirmed','fakturerad','completed'].includes(c.status) && c.cart_token) {
    if (c.pickup_confirmed_at) {
      // Helt klart
      makeBtn('📋 Visa kvittens', '', () => adminShowPickup(c));
    } else if (c.pickup_signed_at) {
      // Kund har förberett — admin behöver motkvittera
      makeBtn('✅ Granska & motkvittera', 'btn-success', () => adminOpenPickupConfirm(c));
    } else if (c.pickup_reminder_sent_at) {
      // Länk skickad, kund har inte börjat
      makeBtn('📩 Skicka påminnelse', '', () => adminSendPickupLink(c));
    } else {
      // Inget skickat ännu (auto kl 19:00 kvällen innan utlämning)
      makeBtn('📦 Skicka förberedelse-länk nu', 'btn-success', () => adminSendPickupLink(c));
    }
  }
}

async function confirmOrder() {
  if (!confirm('Bekräfta ordern? Status ändras till Orderbekräftelse och TTL tas bort.')) return;
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, status: 'confirmed' })
  });
  if (ok) {
    currentCart.status = 'confirmed';
    toast('Order bekräftad! ✅');
    loadCarts();
    renderTab('info');
    renderPanelFooter();
  } else toast('Fel vid bekräftelse', 'error');
}

async function cancelOrder() {
  if (!confirm('Avbryt ordern? Den sparas i 90 dagar.')) return;
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, status: 'cancelled' })
  });
  if (ok) {
    currentCart.status = 'cancelled';
    toast('Order avbruten');
    await loadCarts();
    renderTab('info');
    renderPanelFooter();
  } else toast('Fel vid avbrytning', 'error');
}

// ── PERMANENT RADERING AV AVBRUTEN ORDER (quick-fix tills auto-TTL) ──────
// Endast tillgänglig på cancelled-kort. Confirm-dialog visar VAD som raderas
// så admin inte råkar trycka. Backend (admin-cart-delete.js) verifierar
// dubbelt att status='cancelled' innan radering — defensiv design.
async function deleteCancelledCart(cartId) {
  const c = carts.find(x => x.id === cartId);
  if (!c) { toast('Kunde inte hitta ordern', 'error'); return; }
  if (c.status !== 'cancelled') {
    toast('Endast avbrutna ordrar kan raderas permanent', 'error');
    return;
  }
  const customer = c.customer_name || c.customer_company || cartId;
  if (!confirm(
    `Radera "${customer}" permanent?\n\n` +
    `Detta tar bort:\n` +
    `• Ordern (${cartId})\n` +
    `• All chatthistorik\n` +
    `• Alla audit-loggar\n\n` +
    `Åtgärden kan INTE ångras.`
  )) return;

  const { ok, data } = await api('admin-cart-delete', {
    method: 'POST',
    body: JSON.stringify({ cart_id: cartId })
  });
  if (ok) {
    toast(`Order raderad: ${customer}`);
    // Om detaljpanelen råkar visa just denna cart — stäng den
    if (currentCart && currentCart.id === cartId) closePanel();
    loadCarts();
  } else {
    console.error('CART_DELETE_FAIL:', cartId, data);
    toast(data?.error || 'Kunde inte radera ordern', 'error');
  }
}
window.deleteCancelledCart = deleteCancelledCart;

// ── KLONA KUND TILL NY OFFERT ──────────────────────────────────
// Återanvänder kundinfo (namn, email, telefon, företag, plats osv) men
// lämnar datum, tider, produkter och anmärkning tomma. När admin klickar
// "✉ Skicka offert" i modalen skapas en helt ny cart i databasen — den
// gamla offerten lämnas orörd.
function cloneCustomerToNewQuote(c) {
  if (!c?.customer_name || !c?.customer_email) {
    toast('Kundinfo saknas — kan inte klona', 'error');
    return;
  }
  // Stäng detaljpanelen så fokus hamnar på offert-modalen
  closePanel();
  // VIKTIGT: nollställ currentCart så existing_cart_id blir null i sendQuote
  currentCart = null;
  // Förifyll endast kundrelaterad info — INGA items, INGET datum
  openQuoteModal({
    customer_name:    c.customer_name,
    customer_email:   c.customer_email,
    customer_phone:   c.customer_phone,
    customer_company: c.customer_company,
    customer_orgnr:   c.customer_orgnr,
    cc_email:         c.cc_email,
    event_location:   c.event_location,
    delivery_mode:    c.delivery_mode,
    // event_date, return_date, delivery_time, return_time, items, note utelämnas medvetet
  });
  // Tvinga ny order — openQuoteModal sätter denna baserat på (prefill === null),
  // så vi måste explicit sätta true här eftersom vi skickar in ett objekt.
  _quoteIsNewOrder = true;
  toast('Kundinfo förifylld — fyll i nytt datum & produkter');
}

// ── BOKNINGSFÖRFRÅGAN-TRIAGERING (status='new' utan produkter) ─────────────────
// Markera som hanterad — flyttar förfrågan till Avbruten.
async function handleContactRequest(cartId) {
  if (!cartId) return;
  if (!confirm('Markera kontaktförfrågan som hanterad? Den flyttas till "Avbruten".')) return;
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: cartId, status: 'cancelled' })
  });
  if (ok) {
    toast('Förfrågan markerad som hanterad');
