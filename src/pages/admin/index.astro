function urgencyScore(c) {
  const now = Date.now();
  const sentAge  = (now - new Date(c.updated_at || c.created_at).getTime()) / 86400000; // dagar sedan skickad
  const toEvent  = c.event_date
    ? (new Date(c.event_date + 'T00:00:00').getTime() - now) / 86400000
    : 999;
  // Hög poäng = mer brådskande
  const eventScore = toEvent < 7 ? 50 : toEvent < 14 ? 20 : toEvent < 30 ? 5 : 0;
  const sentScore  = sentAge  > 7 ? 40 : sentAge  > 3  ? 15 : sentAge > 1 ? 5 : 0;
  return eventScore + sentScore;
}

function urgencyClass(c) {
  if (c.status !== 'waiting' && c.status !== 'new') return 'urg-gray';
  const s = urgencyScore(c);
  if (s >= 40) return 'urg-red';
  if (s >= 15) return 'urg-amber';
  if (s >= 5)  return 'urg-green';
  return 'urg-gray';
}

function waitingEvBadge(c) {
  if (!c.event_date) return '';
  const today = new Date(); today.setHours(0,0,0,0);
  const diff = Math.round((new Date(c.event_date + 'T00:00:00') - today) / 86400000);
  const cls = diff < 0 ? 'badge-ev-gray' : diff <= 7 ? 'badge-ev-red' : diff <= 14 ? 'badge-ev-amber' : 'badge-ev-green';
  const sign = diff > 0 ? '+' : '';
  return `<span class="cc-ev-badge ${cls}">${sign}${diff}d</span>`;
}

// Visar om kunden har läst sin offert (visas för waiting/confirmed/fakturerad/betald)
// Semantik: "läst" = last_read_customer är satt (kunden har någon gång öppnat sin offertsida)
function readBadge(c, { compact = false } = {}) {
  if (!['waiting','confirmed','fakturerad','completed'].includes(c.status)) return '';
  const lastRead = c.last_read_customer ? new Date(c.last_read_customer) : null;

  if (lastRead) {
    const ago = readAgoText(lastRead);
    const title = `Kunden har läst offerten ${ago}`;
    return compact
      ? `<span class="read-badge read-badge-yes" title="${title}">👁</span>`
      : `<span class="read-badge read-badge-yes" title="${title}">👁 Läst</span>`;
  } else {
    // Visa bara "ej läst"-flagga för waiting (när vi väntar på svar)
    if (c.status !== 'waiting') return '';
    const title = 'Kunden har inte öppnat offerten ännu';
    return compact
      ? `<span class="read-badge read-badge-no" title="${title}">👁⃠</span>`
      : `<span class="read-badge read-badge-no" title="${title}">Ej läst</span>`;
  }
}

// Pickup-state-badge (kvittens-flödet)
//  - 'prepared': kund har signerat men ingen motkvitterad ännu (väntar på admin)
//  - 'activated': fullt motkvitterad — kvittens aktiv
function pickupBadge(c, { compact = false } = {}) {
  // Bara relevant för aktiva ordrar i utlämnings-flödet
  if (!['confirmed', 'fakturerad', 'completed'].includes(c.status)) return '';
  if (c.pickup_confirmed_at) {
    const when = fmtTime ? fmtTime(c.pickup_confirmed_at) : new Date(c.pickup_confirmed_at).toLocaleString('sv-SE');
    const title = `Kvittens aktiverad ${when}`;
    return compact
      ? `<span class="pickup-badge pickup-badge-activated" title="${title}">✓</span>`
      : `<span class="pickup-badge pickup-badge-activated" title="${title}">✓ Aktiverad</span>`;
  }
  if (c.pickup_signed_at) {
    const when = fmtTime ? fmtTime(c.pickup_signed_at) : new Date(c.pickup_signed_at).toLocaleString('sv-SE');
    const title = `Kund har förberett kvittens ${when} — väntar på din motkvittering`;
    return compact
      ? `<span class="pickup-badge pickup-badge-prepared" title="${title}">✍</span>`
      : `<span class="pickup-badge pickup-badge-prepared" title="${title}">✍ Förberedd</span>`;
  }
  return '';
}

function readAgoText(date) {
  const mins = Math.floor((Date.now() - date.getTime()) / 60000);
  if (mins < 1) return 'just nu';
  if (mins < 60) return `för ${mins} min sedan`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `för ${hours} ${hours === 1 ? 'timme' : 'timmar'} sedan`;
  const days = Math.floor(hours / 24);
  return `för ${days} ${days === 1 ? 'dag' : 'dagar'} sedan`;
}

function sortColumn(colStatus, arr) {
  const cfg = COLUMN_SORTS[colStatus];
  if (!cfg) return arr; // ingen sort-config → behåll DB-ordning (updated_at DESC)
  const key = _columnSorts[colStatus];
  const sortFn = cfg.options[key]?.fn;
  if (!sortFn) return arr;
  return [...arr].sort(sortFn);
}

// ── BOKNINGSFÖRFRÅGAN-KORT (status='new', utan produkter) ──────
// Förenklad vy med två tydliga triagering-knappar direkt på kortet.
// Hanterad → status: cancelled. Skapa manuell order → öppnar produkt-fliken.
function cartCardOpen(c) {
  const age = c.created_at ? Math.floor((Date.now() - new Date(c.created_at).getTime()) / 86400000) : null;
  const ageStr = age === 0 ? 'Idag' : age === 1 ? 'Igår' : age != null ? `${age}d sedan` : '';
  const msgRaw = (c.customer_message || '').trim();
  const msgEsc = msgRaw.replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const msgSnip = msgEsc.length > 140 ? msgEsc.slice(0, 137) + '…' : msgEsc;
  const nameEsc = (c.customer_name || 'Okänd kund').replace(/[<>"']/g, ch => ({'<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));

  return `
    <div class="cc-open" data-id="${c.id}" data-cart-id="${c.id}">
      <div class="cc-open-header">
        <span class="cc-open-name">${nameEsc}</span>
        ${ageStr ? `<span class="cc-open-age">${ageStr}</span>` : ''}
      </div>
      <div style="margin:1px 0 2px"><span class="req-badge req-booking">💬 Bokningsförfrågan</span></div>
      <div class="cc-open-meta">
        ${c.event_date ? `<span>📅 ${fmtDate(c.event_date)}</span>` : '<span style="color:rgba(255,255,255,0.35)">Inget datum</span>'}
        ${c.customer_email ? `<span style="color:rgba(255,255,255,0.5)">✉ ${c.customer_email}</span>` : ''}
      </div>
      ${msgSnip ? `<div class="cc-open-msg">"${msgSnip}"</div>` : ''}
      <div class="cc-open-actions">
        <button class="cc-open-btn cc-open-handled" data-action="handled" data-id="${c.id}">✓ Hanterad</button>
        <button class="cc-open-btn cc-open-convert" data-action="convert" data-id="${c.id}">📤 Skapa manuell order</button>
      </div>
    </div>`;
}

function cartCardCompact(c) {
  const now = Date.now();
  const sentDays = Math.floor((now - new Date(c.updated_at || c.created_at).getTime()) / 86400000);
  const total    = c.total_excl ? fmt(Math.round(c.total_excl/100)) + ' kr' : '–';
  const uCls     = urgencyClass(c);
  const evBadge  = waitingEvBadge(c);
  const rBadge   = readBadge(c, { compact: true });
  const pBadge   = pickupBadge(c, { compact: true });
  const reqB     = reqBadge(c);
  const paidB    = paidBadge(c);
  const overdueB = overdueFlag(c);
  const noDateB  = noDateFlag(c);
  const sentTxt  = sentDays === 0 ? 'Idag' : sentDays === 1 ? 'Igår' : `${sentDays}d sedan`;
  const unread   = c.unread_count > 0 ? `<span class="unread-pill">💬 ${c.unread_count}</span>` : '';
  const evTxt    = c.event_date ? `📅 ${fmtDate(c.event_date)}` : '';
  const loc      = c.event_location ? `· ${c.event_location}` : '';
  // Permanent-radera-knapp endast på cancelled-kort
  const delBtn   = c.status === 'cancelled'
    ? `<button class="cart-card-delete-btn" onclick="event.stopPropagation(); deleteCancelledCart('${c.id}')" title="Radera permanent">🗑</button>`
    : '';
  return `
    <div class="cc-compact ${uCls}" data-id="${c.id}" data-cart-id="${c.id}">
      ${delBtn}
      <div class="cc-row1">
        <span class="cc-name">${c.customer_name || 'Okänd kund'}</span>
        ${reqB}
        ${overdueB}
        ${noDateB}
        ${paidB}
        ${evBadge}
        ${pBadge}
        ${rBadge}
        ${unread}
      </div>
      <div class="cc-row2">
        <span>${evTxt}${loc ? ' ' + loc : ''}</span>
        <span>${sentTxt}</span>
      </div>
      <div class="cc-urgency-bar"></div>
    </div>`;
}

function renderKanban() {
  // Filtrera bort reservationsrader
  carts = carts.filter(c => !c.id?.startsWith('SK-RESERVE-') && c.customer_name !== '[Reserverat fakturanummer]');
  updateUnreadFilterBadge();
  const filtered = getFilteredCarts();
  const cols = ['new','waiting','confirmed','fakturerad','completed','cancelled'];
  const board = $('kanban-board');
  board.innerHTML = cols.map(status => {
    const s = STATUS_LABELS[status];
    let colCarts = filtered.filter(c => c.status === status);
    const sortCfg = COLUMN_SORTS[status];
    if (sortCfg) colCarts = sortColumn(status, colCarts);

    const sortBtnsHtml = sortCfg
      ? `<div class="waiting-sort">${
          Object.entries(sortCfg.options).map(([k, opt]) =>
            `<button class="wsort-btn${_columnSorts[status]===k?' active':''}" onclick="setColumnSort('${status}','${k}')">${opt.label}</button>`
          ).join('')
        }</div>`
      : '';

    return `
      <div class="kanban-col">
        <div class="kanban-col-header"${sortCfg ? ' style="flex-direction:column;align-items:flex-start;gap:0"' : ''}>
          <div${sortCfg ? ' style="display:flex;align-items:center;justify-content:space-between;width:100%"' : ' style="display:contents"'}>
            <div class="col-title ${s.cls}">${s.icon} ${s.label}</div>
            <div class="col-count">${colCarts.length}</div>
          </div>
          ${sortBtnsHtml}
        </div>
        <div class="kanban-cards">
          ${colCarts.length === 0
            ? '<div class="empty-col">Tom</div>'
            : colCarts.map(c => {
                // Bokningsförfrågan = status='new' UTAN produkter → triagerings-kort
                const isBookingRequest = status === 'new'
                  && (c.items || []).filter(i => !i._note && i.name?.trim()).length === 0;
                if (isBookingRequest) return cartCardOpen(c);
                return _kanbanView === 'compact' ? cartCardCompact(c) : cartCardHTML(c);
              }).join('')}
        </div>
      </div>`;
  }).join('');

  // Uppdatera toggle-knappar
  const kvc = document.getElementById('kv-compact');
  const kvs = document.getElementById('kv-standard');
  if (kvc && kvs) {
    kvc.style.background = _kanbanView === 'compact' ? 'var(--brand-lav)' : 'transparent';
    kvc.style.color      = _kanbanView === 'compact' ? '#0c0a24'          : 'var(--text-muted)';
    kvs.style.background = _kanbanView === 'standard' ? 'var(--brand-lav)' : 'transparent';
    kvs.style.color      = _kanbanView === 'standard' ? '#0c0a24'          : 'var(--text-muted)';
  }

  // Event delegation — survives re-renders
  board.onclick = e => {
    // Triagering-knappar på Kontaktförfrågan-kort har företräde framför öppna-detalj
    const actionBtn = e.target.closest('.cc-open-btn[data-action]');
    if (actionBtn) {
      e.stopPropagation();
      const cartId = actionBtn.dataset.id;
      if (actionBtn.dataset.action === 'handled')      handleContactRequest(cartId);
      else if (actionBtn.dataset.action === 'convert') convertContactToOrder(cartId);
      return;
    }
    const card = e.target.closest('.cart-card, .cc-compact, .cc-open');
    if (card) openDetail(card.dataset.id);
  };
}

// ── TELEFONBOK ────────────────────────────────────────────────
let _pbSort = 'alpha'; // 'alpha' | 'event' | 'status'
let _pbStatuses = new Set(['new','waiting','confirmed','fakturerad']);

function htmlEscape(s) {
  return String(s ?? '').replace(/[&<>"']/g, ch => (
    { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]
  ));
}

// Normalisera telefonnummer för sökning/matchning.
// Tar bort allt utom siffror. Normaliserar +46/0046 till 0.
function normalizePhone(s) {
  if (!s) return '';
  let digits = String(s).replace(/\D/g, '');
  // +46 / 0046 / 0046 → 0
  if (digits.startsWith('0046')) digits = '0' + digits.slice(4);
  else if (digits.startsWith('46') && digits.length >= 11) digits = '0' + digits.slice(2);
  return digits;
}

function renderPhonebook() {
  const list = $('pb-list');
  if (!list) return;

  // Filter på status
  let filtered = carts.filter(c => _pbStatuses.has(c.status));

  // Dedup på telefonnummer (eller email om phone saknas).
  // Senast uppdaterad cart vinner per unik kund.
  const seen = new Map();
  for (const c of filtered) {
    const key = (normalizePhone(c.customer_phone) || (c.customer_email || '').toLowerCase() || c.id || '');
    if (!key) continue;
    const existing = seen.get(key);
    if (!existing || new Date(c.updated_at || c.created_at) > new Date(existing.updated_at || existing.created_at)) {
      seen.set(key, c);
    }
  }
  let entries = Array.from(seen.values());

  // Sökning på namn, företag eller telefonnummer
  const searchRaw = ($('pb-search')?.value || '').trim();
  if (searchRaw) {
    const searchLower = searchRaw.toLowerCase();
    const searchDigits = normalizePhone(searchRaw);
    entries = entries.filter(c => {
      if ((c.customer_name || '').toLowerCase().includes(searchLower)) return true;
      if ((c.customer_company || '').toLowerCase().includes(searchLower)) return true;
      if ((c.customer_email || '').toLowerCase().includes(searchLower)) return true;
      if (searchDigits) {
        const phoneDigits = normalizePhone(c.customer_phone);
        if (phoneDigits && phoneDigits.includes(searchDigits)) return true;
      }
      return false;
    });
  }

  // Sortering
  const statusOrder = { new: 1, waiting: 2, confirmed: 3, fakturerad: 4 };
  if (_pbSort === 'alpha') {
    entries.sort((a, b) => (a.customer_name || '').localeCompare(b.customer_name || '', 'sv'));
  } else if (_pbSort === 'event') {
    entries.sort(_byEventDateAsc);
  } else if (_pbSort === 'status') {
    entries.sort((a, b) =>
      (statusOrder[a.status] || 99) - (statusOrder[b.status] || 99)
      || (a.customer_name || '').localeCompare(b.customer_name || '', 'sv')
    );
  }

  // Räknare i headern
  const cntEl = $('pb-count');
  if (cntEl) cntEl.textContent = entries.length ? `(${entries.length})` : '';

  if (entries.length === 0) {
    list.innerHTML = searchRaw
      ? `<div class="empty-col">Ingen kund matchar "${htmlEscape(searchRaw)}"</div>`
      : '<div class="empty-col">Inga kunder att visa</div>';
    return;
  }

  // Vid sortering på status: lägg in grupp-rubriker mellan blocken
  let html = '';
  let prevStatus = null;
  for (const c of entries) {
    if (_pbSort === 'status' && c.status !== prevStatus) {
      const s = STATUS_LABELS[c.status];
      html += `<div class="pb-group-heading">${s.icon} ${s.label}</div>`;
      prevStatus = c.status;
    }
    html += pbCardHTML(c);
  }
  list.innerHTML = html;
}

function pbCardHTML(c) {
  const name = htmlEscape(c.customer_name || '(saknar namn)');
  const company = c.customer_company
    ? `<div class="pb-company">${htmlEscape(c.customer_company)}</div>`
    : '';
  const phoneRaw = (c.customer_phone || '').trim();
  const phoneStrip = phoneRaw.replace(/[\s\-()]/g, '');
  const phoneHtml = phoneStrip
    ? `<a href="tel:${htmlEscape(phoneStrip)}" class="pb-phone" onclick="event.stopPropagation()">📞 ${htmlEscape(phoneRaw)}</a>`
    : '<span class="pb-phone-empty">📞 saknas</span>';
  const s = STATUS_LABELS[c.status];
  const statusBadge = `<span class="pb-status-badge ${s.cls}">${s.icon} ${s.label}</span>`;
  const event = c.event_date
    ? `<span class="pb-event">📅 ${c.event_date}</span>`
    : '';
  return `
    <div class="pb-card" data-id="${c.id}">
      <div class="pb-info">
        <div class="pb-name">${name}</div>
        ${company}
        ${phoneHtml}
      </div>
      <div class="pb-meta">
        ${statusBadge}
        ${event}
      </div>
    </div>`;
}

// Event-delegation för telefonbok-vyn
document.addEventListener('click', e => {
  const sortBtn = e.target.closest('[data-pb-sort]');
  if (sortBtn) {
    _pbSort = sortBtn.dataset.pbSort;
    document.querySelectorAll('[data-pb-sort]').forEach(b =>
      b.classList.toggle('active', b.dataset.pbSort === _pbSort)
    );
    renderPhonebook();
    return;
  }
  const statusBtn = e.target.closest('[data-pb-status]');
  if (statusBtn) {
    const s = statusBtn.dataset.pbStatus;
    if (_pbStatuses.has(s)) _pbStatuses.delete(s);
    else _pbStatuses.add(s);
    statusBtn.setAttribute('aria-pressed', _pbStatuses.has(s) ? 'true' : 'false');
    renderPhonebook();
    return;
  }
  // Klick på kort öppnar detalj (telefonlänken har egen stopPropagation)
  const pbCard = e.target.closest('.pb-card');
  if (pbCard) openDetail(pbCard.dataset.id);
});

// Sökruta — re-rendera vid input
$('pb-search')?.addEventListener('input', renderPhonebook);

// ── MARKERA KUNDMEDDELANDEN SOM LÄSTA ─────────────────────────
async function markAdminRead(cartId) {
  if (!cartId) return;
  const { ok: success } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: cartId, action: 'mark_admin_read' })
  });
  if (!success) return; // Tyst fel — ignorera
  // Uppdatera lokal kopia och badges omedelbart
  if (currentCart && currentCart.id === cartId) {
    const now = new Date().toISOString();
    currentMessages.forEach(m => { if (m.sender === 'customer' && !m.read_at) m.read_at = now; });
    // Dölj chat-badge i panel-fliken
    const chatBadge = $('chat-unread-badge');
    if (chatBadge) chatBadge.style.display = 'none';
    // Ta bort oläst-pill från kanban-kortet
    const pill = document.querySelector(`[data-cart-id="${cartId}"] .unread-pill`);
    if (pill) pill.remove();
    // Synka lokal cart-data
    const cartInList = carts.find(c => c.id === cartId);
    if (cartInList) cartInList.unread_count = 0;
    // Uppdatera filter-pill-räknaren (enda olästa-indikatorn nu)
    updateUnreadFilterBadge();
  }
}

function cartCardHTML(c) {
  const total = c.total_excl ? fmt(Math.round(c.total_excl/100)) + ' kr' : '–';
  const unread = c.unread_count > 0
    ? `<span class="unread-pill">💬 ${c.unread_count} ny${c.unread_count > 1 ? 'a' : 't'}</span>` : '';
  const rBadge = readBadge(c);
  const pBadge = pickupBadge(c);
  const age = c.created_at ? Math.floor((Date.now() - new Date(c.created_at)) / 86400000) : null;
  const ageStr = age === 0 ? 'Idag' : age === 1 ? 'Igår' : age != null ? `${age} dagar sedan` : '';
  const showBadge = ['new','waiting'].includes(c.status);
  const intentBadge = showBadge
    ? `<span style="background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.5);font-size:0.65rem;font-weight:600;padding:1px 6px;border-radius:4px">OFFERT</span>`
    : '';

  // Bounce-badge: röd vid bounced, orange vid complained (markerat som spam)
  let bounceBadge = '';
  let cardExtraStyle = '';
  if (c.bounce_status === 'bounced') {
    bounceBadge = `<div style="margin:6px 0 2px;padding:4px 8px;background:rgba(239,68,68,0.18);border:1px solid rgba(239,68,68,0.55);color:#fca5a5;border-radius:6px;font-size:0.72rem;font-weight:700;display:flex;align-items:center;gap:4px"><span>⚠</span> Mailet studsade — kontrollera adress</div>`;
    cardExtraStyle = 'border-color:rgba(239,68,68,0.6);box-shadow:0 0 0 1px rgba(239,68,68,0.25)';
  } else if (c.bounce_status === 'complained') {
    bounceBadge = `<div style="margin:6px 0 2px;padding:4px 8px;background:rgba(251,146,60,0.15);border:1px solid rgba(251,146,60,0.5);color:#fdba74;border-radius:6px;font-size:0.72rem;font-weight:700;display:flex;align-items:center;gap:4px"><span>🚫</span> Markerat som spam av mottagaren</div>`;
    cardExtraStyle = 'border-color:rgba(251,146,60,0.55)';
  } else if (c.bounce_status === 'delayed') {
    bounceBadge = `<div style="margin:6px 0 2px;padding:4px 8px;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.4);color:#fbbf24;border-radius:6px;font-size:0.72rem;font-weight:700;display:flex;align-items:center;gap:4px"><span>⏳</span> Leverans försenad</div>`;
  }

  // Dagar-kvar-flagga för bekräftade/fakturerade/avslutade ordrar med eventdatum
  let daysFlag = '';
  if (['confirmed','fakturerad','completed'].includes(c.status) && c.event_date) {
    const today = new Date(); today.setHours(0,0,0,0);
    const evDate = new Date(c.event_date + 'T00:00:00');
    const diff = Math.round((evDate - today) / 86400000);
    if (diff >= 0) {
      // Kommande event — gul→röd beroende på nearness
      const urgent = diff <= 3;
      const warn   = diff <= 7;
      const bg    = urgent ? 'rgba(239,68,68,0.85)' : warn ? 'rgba(251,191,36,0.85)' : 'rgba(74,222,128,0.75)';
      const col   = urgent || warn ? '#0c0a24' : '#0c0a24';
      daysFlag = `<span style="position:absolute;top:8px;right:8px;background:${bg};color:${col};font-size:0.62rem;font-weight:800;padding:2px 6px;border-radius:99px;font-family:'Space Grotesk',sans-serif;letter-spacing:0.03em">-${diff}d</span>`;
    } else {
      // Eventet har passerat
      daysFlag = `<span style="position:absolute;top:8px;right:8px;background:rgba(156,163,175,0.5);color:#fff;font-size:0.62rem;font-weight:800;padding:2px 6px;border-radius:99px;font-family:'Space Grotesk',sans-serif">+${Math.abs(diff)}d</span>`;
    }
  }

  const reqB  = reqBadge(c);
  const paidB = paidBadge(c);
  const overdueB = overdueFlag(c);
  const noDateB  = noDateFlag(c);
  // Permanent-radera-knapp endast på cancelled-kort
  const delBtn   = c.status === 'cancelled'
    ? `<button class="cart-card-delete-btn" onclick="event.stopPropagation(); deleteCancelledCart('${c.id}')" title="Radera permanent">🗑</button>`
    : '';

  return `
    <div class="cart-card" data-id="${c.id}" data-cart-id="${c.id}" style="position:relative;${cardExtraStyle}">
      ${delBtn}
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:3px">
        <div class="cart-card-name" style="margin:0">${c.customer_name || 'Okänd kund'}</div>
        ${intentBadge}
      </div>
      ${daysFlag}
      ${(reqB || paidB || overdueB || noDateB) ? `<div style="display:flex;gap:5px;flex-wrap:wrap;margin-bottom:4px">${reqB}${overdueB}${noDateB}${paidB}</div>` : ''}
      ${c.customer_company ? `<div style="font-size:0.78rem;color:rgba(196,181,244,0.75);font-weight:500;margin-bottom:2px">🏢 ${c.customer_company}</div>` : ''}
      <div class="cart-card-sub">${c.customer_email || ''}</div>
      ${bounceBadge}
      <div class="cart-card-meta">
        ${c.event_date ? `<span>📅 ${fmtDate(c.event_date)}</span>` : ''}
        ${c.event_location ? `<span>📍 ${c.event_location}</span>` : ''}
        ${ageStr ? `<span>🕐 ${ageStr}</span>` : ''}
      </div>
      <div class="cart-card-footer">
        <span class="cart-card-price">${total}</span>
        <span style="display:flex;align-items:center;gap:6px">${pBadge}${rBadge}${unread}</span>
      </div>
    </div>`;
}

// ── DETAIL PANEL ──────────────────────────────────────────────
async function openDetail(cartId) {
  // Om föregående panel hade osparade ändringar, varna innan vi byter
  if (panelDirty && currentCart && currentCart.id !== cartId) {
    if (!confirm('Du har osparade ändringar i den öppna ordern. Lämna ändå?\n\nOK = lämna utan att spara\nAvbryt = stanna kvar')) {
      return;
    }
  }
  clearPanelDirty();
  currentCart = null;
  currentMessages = [];
  currentAudit = [];
  activeTab = 'info';

  const overlay = $('detail-overlay');
  const panel   = $('detail-panel');
  overlay.classList.add('open');
  panel.classList.add('open');
  $('panel-body').innerHTML = '<div class="loading-center"><div class="spinner"></div></div>';
  $('panel-footer').innerHTML = '';
  $('panel-title').textContent = 'Laddar…';

  let ok, data;
  try {
    ({ ok, data } = await api(`admin-carts?id=${cartId}`));
  } catch(e) {
    toast('Kunde inte ladda varukorg: ' + e.message, 'error');
    closePanel(); return;
  }
  if (!ok) { toast('Kunde inte ladda varukorg', 'error'); closePanel(); return; }

  currentCart     = data.cart;
  currentMessages = data.messages || [];
  currentAudit    = data.audit_log || [];

  // Markera alla olästa kundmeddelanden som lästa när admin öppnar kortet
  const hasUnread = currentMessages.some(m => m.sender === 'customer' && !m.read_at);
  if (hasUnread) markAdminRead(currentCart.id);

  $('panel-title').textContent = `${currentCart.customer_name || 'Okänd'} — ${currentCart.id}`;
  updatePanelMarkReadBtn();
  // Add quick-action links to header
  const existingQuick = document.getElementById('panel-quick');
  if (existingQuick) existingQuick.remove();

  // Update unread badge on chat tab
  const unread = currentMessages.filter(m => m.sender === 'customer' && !m.read_at).length;
  const chatBadge = $('chat-unread-badge');
  if (unread > 0) { chatBadge.style.display = 'inline'; chatBadge.textContent = unread; }
  else chatBadge.style.display = 'none';

  renderPanelTabs();
  renderTab('info');
  renderPanelFooter();
}

function renderPanelTabs() {
  document.querySelectorAll('.panel-tab').forEach(tab => {
    tab.classList.toggle('active', tab.dataset.tab === activeTab);
    tab.onclick = async () => {
      const newTab = tab.dataset.tab;
      if (newTab === activeTab) return;
      // Vid osparade ändringar: 3-val (Spara först | Lämna utan | Avbryt)
      // Annars förlorar admin ändringar som senare ska synkroniseras till offert/mail.
      if (panelDirty) {
        const choice = await askDirtyChoice();
        if (choice === 'cancel')      return;
        if (choice === 'save') {
          const saved = await saveDirtyTabIfPossible();
          if (!saved) {
            // Spara misslyckades — stanna kvar så admin kan rätta
            toast('Kunde inte spara — flikbyte avbrutet', 'error');
            return;
          }
        }
        // 'discard' faller igenom
      }
      clearPanelDirty();
      activeTab = newTab;
      if (activeTab === 'chat') markAdminRead(currentCart?.id);
      renderPanelTabs();
      renderTab(activeTab);
    };
  });
}

// 3-vals dialog för osparade ändringar.
// Returnerar 'save' | 'discard' | 'cancel'.
function askDirtyChoice() {
  return new Promise(resolve => {
    // Bygg overlay inline för att slippa modal-infrastruktur
    const wrap = document.createElement('div');
    wrap.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(6,4,22,.78);display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(2px)';
    wrap.innerHTML = `
      <div style="background:#1a1740;border:1px solid rgba(196,181,244,.25);border-radius:14px;padding:1.5rem;max-width:420px;width:100%;color:#f0eeff;box-shadow:0 12px 40px rgba(0,0,0,.6)">
        <div style="font-size:1.4rem;margin-bottom:.5rem">⚠ Osparade ändringar</div>
        <p style="color:rgba(255,255,255,.72);font-size:.9rem;line-height:1.55;margin:0 0 1.2rem">
          Du har gjort ändringar i denna flik som inte är sparade. Vad vill du göra?
        </p>
        <div style="display:flex;flex-direction:column;gap:.6rem">
          <button data-action="save" style="background:#c4b5f4;color:#0c0a24;border:none;border-radius:8px;padding:.7rem 1rem;font-size:.9rem;font-weight:700;cursor:pointer;font-family:inherit">
            💾 Spara först &amp; byt flik
          </button>
          <button data-action="discard" style="background:rgba(255,255,255,.06);color:#f0eeff;border:1px solid rgba(255,255,255,.18);border-radius:8px;padding:.7rem 1rem;font-size:.9rem;font-weight:600;cursor:pointer;font-family:inherit">
            Lämna utan att spara
          </button>
          <button data-action="cancel" style="background:transparent;color:rgba(255,255,255,.55);border:1px solid transparent;border-radius:8px;padding:.6rem 1rem;font-size:.85rem;cursor:pointer;font-family:inherit">
            Avbryt — stanna kvar
          </button>
        </div>
      </div>`;
    document.body.appendChild(wrap);
    wrap.addEventListener('click', e => {
      const a = e.target.closest('[data-action]');
      if (!a && e.target !== wrap) return;
      const action = a ? a.dataset.action : 'cancel';
      wrap.remove();
      resolve(action);
    });
  });
}

// Försök spara aktuell flik (Info, Produkter etc) och returnera true vid framgång.
// Hittar rätt spara-knapp och klickar den programmatiskt så befintlig logik körs.
async function saveDirtyTabIfPossible() {
  if (activeTab === 'info') {
    const btn = document.getElementById('save-info-btn');
    if (btn && !btn.disabled) {
      btn.click();
      // Vänta tills knappen är klar (textinnehåll går tillbaka)
      await _waitForButton(btn, '💾 Spara kunduppgifter', 6000);
      return !panelDirty;
    }
  }
  if (activeTab === 'products') {
    await prodSave();
    return !panelDirty;
  }
  // Andra flikar har egen logik — fall tillbaka på discard
  return true;
}

function _waitForButton(btn, targetText, maxMs = 5000) {
  return new Promise(resolve => {
    const start = Date.now();
    const tick = () => {
      if (btn.textContent.includes(targetText) || !btn.disabled || Date.now() - start > maxMs) {
        resolve();
      } else {
        setTimeout(tick, 80);
      }
    };
    setTimeout(tick, 80);
  });
}

function renderTab(tab) {
  const body = $('panel-body');
  if (tab === 'info')     body.innerHTML = renderInfoTab();
  if (tab === 'products') {
    body.innerHTML = renderProductsTab();
    // Populera kategori-dropdown dynamiskt (undviker timing-problem med QUOTE_CATALOG)
    const catSel = document.getElementById('prod-cat-sel');
    if (catSel) {
      const catalog = window.__ADMIN_QUOTE_CATALOG__ || {};
      catSel.innerHTML = '<option value="">\u2014 välj kategori —</option>' +
        Object.keys(catalog)
          .filter(k => !['Egen rad'].includes(k))
          .map(k => `<option value="${k}">${k}</option>`)
          .join('');
    }
  }
  if (tab === 'faktura')  { body.innerHTML = renderFakturaTab(); invLoadPreviewNumber(); invLoadRecent(); }
  // Force browser to respect dark styling on form elements
  requestAnimationFrame(() => {
    document.querySelectorAll('.status-select, .admin-note-area, .prod-input, .chat-textarea').forEach(el => {
      el.style.setProperty('background', '#221f50', 'important');
      el.style.setProperty('color', '#f0eeff', 'important');
      el.style.setProperty('color-scheme', 'dark', 'important');
      if (el.tagName === 'SELECT' || el.classList.contains('admin-note-area')) {
        el.style.setProperty('border', '1px solid rgba(196,181,244,0.25)', 'important');
      }
    });
  });
  if (tab === 'chat')     renderChatTab();
  if (tab === 'log')      body.innerHTML = renderLogTab();

  // Nollställ dirty-flaggan — vi har just renderat färska värden från currentCart.
  // Eventuella ändringar EFTER detta sätter flaggan igen via input/change-lyssnarna.
  // Vi nollställer på nästa tick så att eventuella programmatiska input-events
  // (t.ex. setSelectionRange, value-tilldelning) inte triggar dirty direkt.
  setTimeout(clearPanelDirty, 0);

  // Bind status change
  if (tab === 'info') {
    $('status-select')?.addEventListener('change', async e => {
      const newStatus = e.target.value;
      if (!confirm(`Ändra status till "${STATUS_LABELS[newStatus]?.label}"?`)) {
        e.target.value = currentCart.status; return;
      }
      const { ok } = await api('cart-update', {
        method: 'POST',
        body: JSON.stringify({ cart_id: currentCart.id, status: newStatus })
      });
      if (ok) {
        currentCart.status = newStatus;
        toast('Status uppdaterad!');
        loadCarts();
        renderPanelFooter();
      } else toast('Fel vid statusändring', 'error');
    });

    // Save customer info fields
    // Faktura-mail toggle — uppdatera status-badge live
    function toggleInvoiceEmailActive(checked) {
      const emailVal = document.getElementById('edit-invoice-email')?.value.trim();
      const customerEmail = currentCart?.customer_email || 'saknas';
      const statusEl = document.getElementById('invoice-email-status');
      const checkbox = document.getElementById('use-invoice-email');
      if (checkbox) checkbox.checked = checked;
      if (statusEl) {
        if (checked && emailVal) {
          statusEl.style.cssText = 'margin-top:6px;font-size:0.78rem;padding:5px 10px;border-radius:6px;background:rgba(196,181,244,0.15);color:#c4b5f4';
          statusEl.innerHTML = '✓ Faktura skickas till: <strong>' + emailVal + '</strong>';
        } else {
          statusEl.style.cssText = 'margin-top:6px;font-size:0.78rem;padding:5px 10px;border-radius:6px;background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.60)';
          statusEl.innerHTML = '→ Faktura skickas till kundens mail: <strong>' + customerEmail + '</strong>';
        }
      }
    }
    window.toggleInvoiceEmailActive = toggleInvoiceEmailActive;

    // B2B/B2C toggle — show/hide org.nr fields
    document.querySelectorAll('input[name="ctype"]').forEach(r => {
      r.addEventListener('change', () => {
        const b2b = document.querySelector('input[name="ctype"]:checked')?.value === 'b2b';
        const el = document.getElementById('b2b-fields');
        if (el) el.style.display = b2b ? 'grid' : 'none';
      });
    });

    $('save-info-btn')?.addEventListener('click', async () => {
      const btn = $('save-info-btn');
      btn.disabled = true; btn.textContent = '⏳ Sparar…';
      // Antal gäster: heltal eller null
      const guestsRaw = ($('edit-guests')?.value || '').trim();
      const guestsNum = guestsRaw && /^\d+$/.test(guestsRaw) ? parseInt(guestsRaw, 10) : null;
      const dmRaw = $('edit-delivery-mode')?.value || '';
      const deliveryMode = (dmRaw === 'self_pickup' || dmRaw === 'delivery') ? dmRaw : null;
      const updates = {
        cart_id:        currentCart.id,
        customer_name:    $('edit-name')?.value.trim()     || null,
        customer_email:   $('edit-email')?.value.trim()    || null,
        customer_phone:   $('edit-phone')?.value.trim()    || null,
        event_date:       $('edit-date')?.value            || null,
        return_date:      $('edit-return-date')?.value     || null,
        event_location:   $('edit-location')?.value.trim() || null,
        customer_type:    document.querySelector('input[name="ctype"]:checked')?.value || 'b2c',
        customer_address: $('edit-address')?.value.trim()  || null,
        customer_orgnr:   $('edit-orgnr')?.value.trim()    || null,
        customer_company: $('edit-company')?.value.trim()   || null,
        customer_ref:     $('edit-custref')?.value.trim()   || null,
        delivery_time:    $('edit-delivery-time')?.value   || '13:00',
        return_time:      $('edit-return-time')?.value     || '11:00',
        invoice_email:    $('edit-invoice-email')?.value.trim() || null,
        use_invoice_email: $('use-invoice-email')?.checked ? true : false,
        cc_email:         $('edit-cc-email')?.value.trim()     || null,
        guests_count:     guestsNum,
        delivery_mode:    deliveryMode,
        referral_source:  $('edit-referral')?.value.trim()  || null,
      };
      const { ok } = await api('cart-update', { method: 'POST', body: JSON.stringify(updates) });
      if (ok) {
        // Synka HELA cart från servern — undviker att enskilda fält
        // (t.ex. return_date) hamnar i otakt med databasen vid flikbyte.
        await refreshCurrentCart();
        clearPanelDirty();
        $('panel-title').textContent = `${currentCart.customer_name || 'Okänd'} — ${currentCart.id}`;
        toast('Kunduppgifter sparade!');
        loadCarts();
      } else toast('Kunde inte spara', 'error');
      btn.disabled = false; btn.textContent = '💾 Spara kunduppgifter';
    });

    // Save admin notes
    $('save-notes-btn')?.addEventListener('click', async () => {
      const notes = $('admin-notes').value;
      const { ok } = await api('cart-update', {
        method: 'POST',
        body: JSON.stringify({ cart_id: currentCart.id, notes_admin: notes })
      });
      if (ok) { currentCart.notes_admin = notes; clearPanelDirty(); toast('Anteckning sparad!'); }
      else toast('Kunde inte spara', 'error');
    });
  }

  if (tab === 'chat') {
    $('chat-send-btn')?.addEventListener('click', sendMessage);
    $('chat-input')?.addEventListener('keydown', e => {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) sendMessage();
    });
    // ── Emoji-picker ─────────────────────────────────────────
    const emojiBtn   = document.getElementById('chat-emoji-btn');
    const emojiPanel = document.getElementById('chat-emoji-panel');
    if (emojiBtn && emojiPanel) {
      emojiBtn.addEventListener('click', e => {
        e.stopPropagation();
        emojiPanel.style.display = emojiPanel.style.display === 'none' ? 'block' : 'none';
      });
      // Klick utanför stänger pickern
      document.addEventListener('click', e => {
        if (!emojiPanel.contains(e.target) && e.target !== emojiBtn) {
          emojiPanel.style.display = 'none';
        }
      });
      // Klick på en emoji infogar vid markörens position
      emojiPanel.querySelectorAll('.chat-emoji-pick').forEach(btn => {
        btn.addEventListener('click', () => {
          const input = $('chat-input');
          if (!input) return;
          const emoji = btn.dataset.emoji || '';
          const start = input.selectionStart ?? input.value.length;
          const end   = input.selectionEnd   ?? input.value.length;
          input.value = input.value.slice(0, start) + emoji + input.value.slice(end);
          // Behåll markören efter den infogade emojin
          const newPos = start + emoji.length;
          input.focus();
          input.setSelectionRange(newPos, newPos);
          // Stäng inte pickern — användaren kan vilja lägga flera
        });
      });
    }
    // Snabbmalls-knappar — fyller textarea med fördefinierad text som admin kan redigera
    document.querySelectorAll('.chat-template-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.templateId;
        const tpl = currentChatTemplates.find(t => t.id === id);
        if (!tpl) return;
        const input = $('chat-input');
        if (!input) return;
        const existing = input.value.trim();
        if (existing && !confirm('Det finns redan text i meddelandet. Vill du ersätta den med mallen?')) return;
        // Ersätt variabler ({förnamn}, {namn}, etc.) med kundens data från currentCart
        input.value = renderTemplate(tpl.body, currentCart);
        input.focus();
        // Placera markören i slutet
        input.setSelectionRange(input.value.length, input.value.length);
      });
    });
    // "⚙️ Hantera"-knappen öppnar redigeringsmodalen
    $('chat-templates-manage')?.addEventListener('click', openChatTemplatesModal);
  }
}

// ── PRODUKTREDIGERING ─────────────────────────────────────────
const SVC_IDS_ALL = new Set(['lev-standard','lev-skrymmande','lev-lastbil','lev-bakgavel','montering','rigg-teknik','fakturaavgift-49']);
function prodGetItems() {
  // Read current values from DOM inputs
  const rows = document.querySelectorAll('#prod-tbody .prod-row');
  return Array.from(rows).map(row => {
    const get = field => row.querySelector(`[data-field="${field}"]`)?.value?.trim() || '';
    const qty = parseInt(get('qty')) || 1;
    const price = parseFloat(get('price')) || 0;
    const id = get('id');
    const rawCat = get('category');
    const rawType = get('type') || '';
    // Normalisera: kända tjänste-ID:n ska alltid ha type 'service'
    const type = rawType || (SVC_IDS_ALL.has(id) ? 'service' : 'product');
    const category = rawCat || (SVC_IDS_ALL.has(id) ? 'Tjänster' : '');
    return { id, name: get('name'), category, type, qty, price };
  }).filter(i => i.name?.trim()); // skip empty/whitespace rows
}

function prodUpdateSum(idx) {
  const row = document.querySelector(`[data-idx="${idx}"]`);
  if (!row) return;
  const qty = parseInt(row.querySelector('[data-field="qty"]')?.value) || 1;
  const price = parseFloat(row.querySelector('[data-field="price"]')?.value) || 0;
  const sumEl = document.getElementById(`prod-sum-${idx}`);
  if (sumEl) sumEl.textContent = fmt(qty * price);
  // Update totals
  const items = prodGetItems();
  const total = items.reduce((s,i) => s + i.price * i.qty, 0);
  const tfoot = document.getElementById('prod-tfoot');
  if (tfoot) tfoot.innerHTML = `<tr class="total-row"><td colspan="3">Totalt (exkl. moms)</td>
    <td style="text-align:right">${fmt(total)} kr</td><td></td></tr>
  <tr><td colspan="3" style="color:var(--text-faint);font-size:0.8rem">Inkl. 25% moms</td>
    <td style="text-align:right;color:var(--text-muted);font-size:0.85rem">${fmt(Math.round(total*1.25))} kr</td><td></td></tr>`;
  // Synka summary-div:en under tabellen
  const se = document.getElementById('prod-summary-excl');
  const sv = document.getElementById('prod-summary-vat');
  const si = document.getElementById('prod-summary-incl');
  if (se) se.textContent = fmt(total) + ' kr';
  if (sv) sv.textContent = fmt(Math.round(total*0.25)) + ' kr';
  if (si) si.textContent = fmt(Math.round(total*1.25)) + ' kr';
}

// Wire up live sum update on input change
document.addEventListener('input', e => {
  if (e.target.matches('.prod-qty, .prod-price')) {
    const idx = e.target.dataset.idx;
    if (idx !== undefined) prodUpdateSum(idx);
  }
});

function prodQty(idx, delta) {
  const input = document.querySelector(`[data-field="qty"][data-idx="${idx}"]`);
  if (!input) return;
  const newVal = Math.max(1, (parseInt(input.value) || 1) + delta);
  input.value = newVal;
  prodUpdateSum(idx);
}

function prodDelete(idx) {
  const row = document.querySelector(`[data-idx="${idx}"]`)?.closest('tr');
  if (row) { row.remove(); prodUpdateSum(-1); }
}

function prodAddRow() {
  const tbody = document.getElementById('prod-tbody');
  if (!tbody) return;
  const idx = Date.now(); // unique temp index
  const newRow = document.createElement('tr');
  newRow.className = 'prod-row';
  newRow.dataset.idx = idx;
  newRow.innerHTML = `
    <td>
      <input class="prod-input prod-name" value="" placeholder="Produktnamn" data-field="name" data-idx="${idx}" style="width:100%;font-size:0.875rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
      <input class="prod-input prod-meta" value="" placeholder="Kategori" data-field="category" data-idx="${idx}" style="width:55%;font-size:0.72rem;margin-top:3px;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
      <input class="prod-input prod-meta" value="" placeholder="ID (valfri)" data-field="id" data-idx="${idx}" style="width:40%;font-size:0.72rem;margin-top:3px;margin-left:3%;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
    </td>
    <td style="text-align:center;vertical-align:top;padding-top:0.75rem">
      <div style="display:flex;align-items:center;justify-content:center;gap:4px">
        <button class="qty-btn" onclick="prodQty(${idx},-1)">−</button>
        <input class="prod-input prod-qty" value="1" data-field="qty" data-idx="${idx}" style="width:44px;text-align:center;font-size:0.875rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
        <button class="qty-btn" onclick="prodQty(${idx},1)">＋</button>
      </div>
    </td>
    <td style="text-align:right;vertical-align:top;padding-top:0.75rem">
      <input class="prod-input prod-price" value="0" data-field="price" data-idx="${idx}" style="width:90px;text-align:right;font-size:0.875rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
    </td>
    <td style="text-align:right;vertical-align:top;padding-top:0.75rem;font-weight:600;color:var(--brand-lav)" id="prod-sum-${idx}">0</td>
    <td style="vertical-align:top;padding-top:0.75rem">
      <button class="qty-btn" style="color:var(--red);border-color:var(--red)" onclick="prodDelete(${idx})" title="Ta bort">×</button>
    </td>`;
  tbody.appendChild(newRow);
  newRow.querySelectorAll('.prod-input').forEach(el => {
    el.style.setProperty('background', '#221f50', 'important');
    el.style.setProperty('color', '#f0eeff', 'important');
    el.style.setProperty('color-scheme', 'dark', 'important');
  });
  newRow.querySelector('.prod-name')?.focus();
}

async function prodSave() {
  const btn = document.getElementById('save-items-btn');
  const status = document.getElementById('prod-save-status');
  // Hämta alla rader från DOM (produkter + tjänster i samma tabell)
  const items = prodGetItems();

  if (btn) { btn.disabled = true; btn.textContent = '⏳ Sparar…'; }

  // Lägg till _note om fältet har innehåll
  const noteText = document.getElementById('prod-note')?.value?.trim() || '';
  if (noteText) {
    items.push({ _note: true, id: '_note', name: noteText, price: 0, qty: 1 });
  }

  const total_excl = Math.round(items.filter(i => !i._note).reduce((s,i) => s + i.price * i.qty, 0) * 100);
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, items, total_excl })
  });
  if (ok) {
    // Synka HELA cart från servern — säkerställer att _note (Anmärkningar)
    // och övriga fält stämmer med databasen vid efterföljande flikbyten.
    await refreshCurrentCart();
    clearPanelDirty();
    if (status) { status.textContent = '✓ Sparat'; status.style.color = 'var(--green)'; }
    setTimeout(() => { if (status) status.textContent = ''; }, 3000);
    toast('Produkter uppdaterade!');
    // Re-render kanban card if visible
    renderKanban();
  } else {
    if (status) { status.textContent = '✗ Fel – kontrollera konsolen'; status.style.color = 'var(--red)'; }
    toast('Kunde inte spara', 'error');
  }
  if (btn) { btn.disabled = false; btn.textContent = '💾 Spara produkter'; }
}

function renderInfoTab() {
