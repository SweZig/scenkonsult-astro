async function adminSendSms(c) {
  const phone = c.customer_phone || '';
  const defMsg = c.cart_token
    ? `Hej ${(c.customer_name||'').split(' ')[0]}! Offert klar från Scenkonsult: https://scenkonsult.se/order/?cart=${c.id}&token=${c.cart_token}`
    : `Hej! Hör av dig till Scenkonsult Norden på 072-448 10 00.`;
  const msg = prompt(`SMS till ${phone}:`, defMsg);
  if (!msg) return;
  const { ok, data } = await api('sms-send', {
    method: 'POST',
    body: JSON.stringify({ cart_id: c.id, message: msg })
  });
  if (ok) toast('SMS skickat! ✓');
  else toast(data?.error || 'SMS-fel', 'error');
}

async function adminSendPickupLink(c) {
  const url = `https://scenkonsult.se/sign/?cart=${c.id}&token=${c.cart_token}`;

  // Kopiera länk alltid
  navigator.clipboard.writeText(url).catch(()=>{});

  if (c.customer_email) {
    if (confirm(`Skicka utlämningslänk via e-post till ${c.customer_email}?`)) {
      const { ok: sent, data } = await api('pickup-email', {
        method: 'POST',
        body: JSON.stringify({ cart_id: c.id })
      });
      if (sent) toast(`Utlämningslänk skickad till ${c.customer_email} ✓`);
      else toast(data?.error || 'E-postfel', 'error');
      return;
    }
  }
  // Inget mail — länk kopierad
  toast('Utlämningslänk kopierad till urklipp! (Kunden saknar e-post)');
}

function adminShowPickup(c) {
  if (!c.pickup_signature) { toast('Ingen kvittens sparad', 'error'); return; }
  const w = window.open('', '_blank', 'width=480,height=640');
  const photoHtml = c.pickup_id_photo
    ? `<img src="${c.pickup_id_photo}" style="width:100%;border-radius:8px;margin-top:1rem">`
    : '<p style="color:#888;font-size:0.8rem">Inget legitimationsfoto</p>';
  w.document.write(`<!DOCTYPE html><html><head><title>Kvittens ${c.id}</title>
    <meta charset="UTF-8"><style>body{background:#0c0a24;color:#fff;font-family:Arial;padding:1.5rem;}</style></head>
    <body>
    <h2 style="font-size:1.1rem;margin-bottom:0.25rem">Utlämningskvittens</h2>
    <p style="color:#888;font-size:0.8rem;margin-bottom:1rem">${c.id} · ${c.customer_name} · ${new Date(c.pickup_signed_at).toLocaleString('sv-SE')}</p>
    <img src="${c.pickup_signature}" style="width:100%;border:1px solid rgba(255,255,255,0.15);border-radius:8px;background:#fff">
    <p style="color:#666;font-size:0.75rem;margin-top:0.5rem">IP: ${c.pickup_sign_ip || '–'}</p>
    ${photoHtml}
    </body></html>`);
}

function renderPanelFooter() {
  const c = currentCart;
  const footer = $('panel-footer');
  footer.innerHTML = '';

  const makeBtn = (label, cls, fn) => {
    const b = document.createElement('button');
    b.className = `btn-action ${cls}`;
    b.textContent = label;
    b.onclick = fn;
    footer.appendChild(b);
  };

  // "Skicka om offert" — knapp synlig för statusar där en offert redan skickats.
  // När bounce_status är satt visas knappen prominent i röd/orange för att
  // signalera att admin behöver agera.
  const hasBounce = ['bounced','complained'].includes(c.bounce_status);
  const resendBtnLabel = hasBounce
    ? (c.bounce_status === 'complained' ? '🚫 Skicka om offert (markerad som spam)' : '⚠ Skicka om offert (mailet studsade)')
    : '📤 Skicka om offert';
  const resendBtnCls = hasBounce ? 'btn-danger' : '';
  const showResend = ['waiting','confirmed','fakturerad','betald'].includes(c.status);

  // Context-sensitive buttons based on status
  if (c.status === 'new') {
    makeBtn('📤 Skapa & skicka offert', 'btn-success', () => { renderTab('products'); });
    makeBtn('❌ Avvisa', 'btn-danger', cancelOrder);

  } else if (c.status === 'waiting') {
    makeBtn('✅ Bekräfta order', 'btn-success', confirmOrder);
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
    makeBtn('📩 Påminn kund', '', sendCustomerNotice);
    makeBtn('❌ Avbryt', 'btn-danger', cancelOrder);
  } else if (c.status === 'confirmed') {
    makeBtn('🧾 Skapa faktura', 'btn-success', () => renderTab('faktura'));
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status === 'fakturerad') {
    makeBtn('💚 Markera betald', 'btn-success', invMarkPaid);
    makeBtn('📩 Påminn om betalning', '', sendCustomerNotice);
    if (showResend) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status === 'betald') {
    if (showResend && hasBounce) makeBtn(resendBtnLabel, resendBtnCls, () => openQuoteModalForCart(c));
  } else if (c.status !== 'cancelled') {
    makeBtn('✅ Bekräfta order', 'btn-success', confirmOrder);
    makeBtn('📤 Skicka offert', '', () => openQuoteModalForCart(c));
    makeBtn('❌ Avbryt', 'btn-danger', cancelOrder);
  }

  // Always: copy customer link if exists
  if (c.cart_token) {
    makeBtn('🔗 Kopiera kundlänk', '', () => {
      const url = `https://scenkonsult.se/order/?cart=${c.id}&token=${c.cart_token}`;
      navigator.clipboard.writeText(url);
      toast('Kundlänk kopierad!');
    });
  }

  // SMS-knapp om telefonnummer finns
  if (c.customer_phone) {
    makeBtn('💬 Skicka SMS', '', () => adminSendSms(c));
  }

  // Utlämningslänk (betald eller confirmed)
  if (['confirmed','fakturerad','betald'].includes(c.status) && c.cart_token) {
    const icon = c.pickup_signed_at ? '✅ Kvitterad' : '📦 Skicka utlämningslänk';
    if (!c.pickup_signed_at) {
      makeBtn(icon, 'btn-success', () => adminSendPickupLink(c));
    } else {
      makeBtn('📋 Visa kvittens', '', () => adminShowPickup(c));
    }
  }
}

async function confirmOrder() {
  if (!confirm('Bekräfta ordern? Status ändras till Orderbekräftelse och TTL tas bort.')) return;
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, status: 'confirmed' })
  });
  if (ok) {
    currentCart.status = 'confirmed';
    toast('Order bekräftad! ✅');
    loadCarts();
    renderTab('info');
    renderPanelFooter();
  } else toast('Fel vid bekräftelse', 'error');
}

async function cancelOrder() {
  if (!confirm('Avbryt ordern? Den sparas i 90 dagar.')) return;
  const { ok } = await api('cart-update', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, status: 'cancelled' })
  });
  if (ok) {
    currentCart.status = 'cancelled';
    toast('Order avbruten');
