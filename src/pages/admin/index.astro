  'invoice_paid':               { icon: '💚', label: 'Faktura markerad betald',                 color: 'var(--green)' },
  'order_confirmed':            { icon: '✅', label: 'Order bekräftad av kund',                 color: 'var(--green)' },
  'order_confirmed_by_customer':{ icon: '✅', label: 'Order bekräftad av kund',                 color: 'var(--green)' },
