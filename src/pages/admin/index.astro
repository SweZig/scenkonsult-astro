// ── CHAT-SNABBMALLAR ──────────────────────────────────────────
// Mallar laddas från Supabase via /admin-chat-templates vid pageload.
// `currentChatTemplates` är en array med { id, label, title, body, sort_order }.
// Hårdkodad fallback används om endpoint:en fallerar (Supabase nere etc.).
const CHAT_TEMPLATES_FALLBACK = [
  {
    id: 'google-review',
    label: '⭐ Be om Google-recension',
    title: 'Vänlig förfrågan om kunden vill skriva en recension på Google',
    sort_order: 0,
    body: `Hej!

Om ni är nöjda med vår service eller produkter får ni jättegärna ta 2-3 minuter och skriva ett betyg på Google så andra kunder hittar till oss.

Här är en [direktlänk](https://search.google.com/local/writereview?placeid=ChIJuWsoFN2fX0YRzIoYyrIjdEY) till Google.

Tusen tack!
/Teamet på Scenkonsult`
  }
];

let currentChatTemplates = [...CHAT_TEMPLATES_FALLBACK];

// Tillgängliga variabler i chattmallar — visas också i mall-editorn
const TEMPLATE_VARIABLES = [
  { name: 'förnamn',     desc: 'Kundens förnamn (första ordet av namnet)' },
  { name: 'efternamn',   desc: 'Kundens efternamn (resten av namnet)' },
  { name: 'namn',        desc: 'Kundens fulla namn' },
  { name: 'företag',     desc: 'Företagsnamn (om angivet)' },
  { name: 'epost',       desc: 'Kundens e-postadress' },
  { name: 'telefon',     desc: 'Kundens telefonnummer' },
  { name: 'datum',       desc: 'Eventdatum (formaterat på svenska)' },
  { name: 'plats',       desc: 'Eventets plats / leveransadress' },
  { name: 'ordernummer', desc: 'Cart-ID (t.ex. SK-A1B2C3D4-E5F6)' },
];

// Ersätt variabler som {förnamn} med värden från currentCart.
// Okända variabler lämnas oförändrade så admin ser om hen skrivit fel.
function renderTemplate(body, cart) {
  if (!body) return '';
  if (!cart) return body;

  const fullName = (cart.customer_name || '').trim();
  const parts = fullName.split(/\s+/).filter(Boolean);
  const firstName = parts[0] || '';
  const lastName = parts.length > 1 ? parts.slice(1).join(' ') : '';

  const eventDate = cart.event_date
    ? new Date(cart.event_date).toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' })
    : '';

  const vars = {
    'förnamn':     firstName,
    'efternamn':   lastName,
    'namn':        fullName,
    'företag':     cart.customer_company || '',
    'epost':       cart.customer_email || '',
    'telefon':     cart.customer_phone || '',
    'datum':       eventDate,
    'plats':       cart.event_location || '',
    'ordernummer': cart.id || '',
  };

  // Matcha {nyckel} med svenska tecken. Okända lämnas oförändrade.
  return body.replace(/\{([a-zåäöA-ZÅÄÖ_]+)\}/g, (match, key) => {
    const val = vars[key.toLowerCase()];
    return val !== undefined ? val : match;
  });
}

async function loadChatTemplates() {
  try {
    const r = await fetch('/.netlify/functions/admin-chat-templates', {
      headers: { 'Authorization': `Bearer ${TOKEN}` },
    });
    if (!r.ok) return; // behåll fallback
    const data = await r.json();
    if (Array.isArray(data.templates) && data.templates.length > 0) {
      currentChatTemplates = data.templates;
    }
  } catch (e) {
    console.warn('loadChatTemplates failed, using fallback:', e.message);
  }
}

// ── Hantera-modal: lista, redigera, lägg till, ta bort ─────────
function openChatTemplatesModal() {
  let modal = document.getElementById('chat-templates-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'chat-templates-modal';
    modal.className = 'ct-modal-backdrop';
    modal.innerHTML = `
      <div class="ct-modal" role="dialog" aria-modal="true" aria-labelledby="ct-modal-title">
        <div class="ct-modal-header">
          <h3 id="ct-modal-title">Hantera snabbmallar</h3>
          <button type="button" class="ct-close" aria-label="Stäng">×</button>
        </div>
        <div class="ct-modal-body" id="ct-modal-body"></div>
        <div class="ct-modal-footer">
          <button type="button" class="ct-btn-secondary" id="ct-btn-cancel">Stäng</button>
          <button type="button" class="ct-btn-primary" id="ct-btn-new">+ Ny mall</button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
    modal.querySelector('.ct-close').addEventListener('click', closeChatTemplatesModal);
    modal.querySelector('#ct-btn-cancel').addEventListener('click', closeChatTemplatesModal);
    modal.querySelector('#ct-btn-new').addEventListener('click', () => renderChatTemplateEditor(null));
    modal.addEventListener('click', e => {
      if (e.target === modal) closeChatTemplatesModal();
    });
  }
  modal.style.display = 'flex';
  renderChatTemplatesList();
}

function closeChatTemplatesModal() {
  const modal = document.getElementById('chat-templates-modal');
  if (modal) modal.style.display = 'none';
}

function renderChatTemplatesList() {
  const body = document.getElementById('ct-modal-body');
  if (!body) return;
  if (currentChatTemplates.length === 0) {
    body.innerHTML = '<p class="ct-empty">Inga mallar — klicka "+ Ny mall" för att lägga till en.</p>';
    return;
  }
  body.innerHTML = `
    <ul class="ct-list">
      ${currentChatTemplates.map((t, i) => {
        const preview = (t.body || '').replace(/\n/g, ' ').slice(0, 90);
        return `
          <li class="ct-row" data-id="${t.id}">
            <div class="ct-row-info">
              <div class="ct-row-label">${escapeHtml(t.label)}</div>
              <div class="ct-row-preview">${escapeHtml(preview)}${t.body && t.body.length > 90 ? '…' : ''}</div>
            </div>
            <div class="ct-row-actions">
              <button type="button" class="ct-btn-up" data-i="${i}" title="Flytta upp" ${i === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" class="ct-btn-down" data-i="${i}" title="Flytta ner" ${i === currentChatTemplates.length - 1 ? 'disabled' : ''}>↓</button>
              <button type="button" class="ct-btn-edit" data-id="${t.id}">Redigera</button>
              <button type="button" class="ct-btn-delete" data-id="${t.id}">Ta bort</button>
            </div>
          </li>
        `;
      }).join('')}
    </ul>
  `;
  body.querySelectorAll('.ct-btn-edit').forEach(b => b.addEventListener('click', () => {
    const t = currentChatTemplates.find(x => x.id === b.dataset.id);
    if (t) renderChatTemplateEditor(t);
  }));
  body.querySelectorAll('.ct-btn-delete').forEach(b => b.addEventListener('click', () => deleteChatTemplate(b.dataset.id)));
  body.querySelectorAll('.ct-btn-up').forEach(b => b.addEventListener('click', () => moveChatTemplate(parseInt(b.dataset.i), -1)));
  body.querySelectorAll('.ct-btn-down').forEach(b => b.addEventListener('click', () => moveChatTemplate(parseInt(b.dataset.i), 1)));
}

function renderChatTemplateEditor(tpl) {
  const body = document.getElementById('ct-modal-body');
  if (!body) return;
  const t = tpl || { id: '', label: '', title: '', body: '' };
  body.innerHTML = `
    <div class="ct-editor">
      <p class="ct-editor-hint">${tpl ? 'Redigera mall' : 'Ny mall'} — alla fält sparas till databasen.</p>
      <label class="ct-field">
        <span>Label (knapptext)</span>
        <input type="text" id="ct-field-label" maxlength="80" value="${escapeHtml(t.label)}" placeholder="⭐ Be om Google-recension">
      </label>
      <label class="ct-field">
        <span>Tooltip (visas vid hover, valfri)</span>
        <input type="text" id="ct-field-title" maxlength="200" value="${escapeHtml(t.title || '')}" placeholder="Vänlig förfrågan om recension">
      </label>
      <label class="ct-field">
        <span>Meddelandetext (markdown-länkar stöds: <code>[text](url)</code>)</span>
        <textarea id="ct-field-body" rows="10" maxlength="5000" placeholder="Hej {förnamn}!&#10;...">${escapeHtml(t.body)}</textarea>
      </label>
      <div class="ct-vars-panel">
        <div class="ct-vars-label">Tillgängliga variabler — klicka för att infoga vid markörens position:</div>
        <div class="ct-vars-chips">
          ${TEMPLATE_VARIABLES.map(v =>
            `<button type="button" class="ct-var-chip" data-var="${v.name}" title="${escapeHtml(v.desc)}">{${v.name}}</button>`
          ).join('')}
        </div>
        <div class="ct-vars-hint">Variabler ersätts automatiskt med kundens data när admin klickar på mall-knappen i en chatt. Okända variabler lämnas oförändrade.</div>
      </div>
      <div class="ct-editor-actions">
        <button type="button" class="ct-btn-secondary" id="ct-editor-back">← Tillbaka</button>
        <button type="button" class="ct-btn-primary" id="ct-editor-save">${tpl ? 'Spara ändringar' : 'Skapa mall'}</button>
      </div>
    </div>
  `;
  body.querySelector('#ct-editor-back').addEventListener('click', renderChatTemplatesList);
  body.querySelector('#ct-editor-save').addEventListener('click', () => saveChatTemplate(tpl?.id || null));
  // Variabel-chips: infoga {variabel} vid markörens position i body-textareat
  body.querySelectorAll('.ct-var-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const textarea = body.querySelector('#ct-field-body');
      if (!textarea) return;
      const varName = chip.dataset.var;
      const insert = `{${varName}}`;
      const start = textarea.selectionStart || 0;
      const end = textarea.selectionEnd || 0;
      const before = textarea.value.slice(0, start);
      const after = textarea.value.slice(end);
      textarea.value = before + insert + after;
      const newPos = start + insert.length;
      textarea.focus();
      textarea.setSelectionRange(newPos, newPos);
    });
  });
}

async function saveChatTemplate(existingId) {
  const label = document.getElementById('ct-field-label')?.value?.trim();
  const title = document.getElementById('ct-field-title')?.value?.trim();
  const body  = document.getElementById('ct-field-body')?.value?.trim();
  if (!label) { alert('Label krävs'); return; }
  if (!body) { alert('Meddelandetext krävs'); return; }

  const sortOrder = existingId
    ? (currentChatTemplates.find(t => t.id === existingId)?.sort_order ?? 0)
    : currentChatTemplates.length;

  try {
    const r = await fetch('/.netlify/functions/admin-chat-templates', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'upsert',
        template: { id: existingId || undefined, label, title: title || null, body, sort_order: sortOrder },
      }),
    });
    if (!r.ok) {
      const e = await r.json().catch(() => ({}));
      alert('Kunde inte spara: ' + (e.error || r.status));
      return;
    }
    const data = await r.json();
    // Uppdatera local state: ersätt befintlig eller lägg till
    const idx = currentChatTemplates.findIndex(t => t.id === data.template.id);
    if (idx >= 0) currentChatTemplates[idx] = data.template;
    else currentChatTemplates.push(data.template);
    currentChatTemplates.sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
    renderChatTemplatesList();
    // Re-rendera Chatt-fliken om den är öppen så pill-knapparna uppdateras
    if (activeTab === 'chat' && currentCart) renderTab('chat');
  } catch (e) {
    alert('Nätverksfel: ' + e.message);
  }
}

async function deleteChatTemplate(id) {
  if (!confirm('Ta bort den här mallen? Detta går att ångra genom att skapa en ny med samma innehåll.')) return;
  try {
    const r = await fetch('/.netlify/functions/admin-chat-templates', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'delete', id }),
    });
    if (!r.ok) { alert('Kunde inte ta bort'); return; }
    currentChatTemplates = currentChatTemplates.filter(t => t.id !== id);
    renderChatTemplatesList();
    if (activeTab === 'chat' && currentCart) renderTab('chat');
  } catch (e) {
    alert('Nätverksfel: ' + e.message);
  }
}

async function moveChatTemplate(index, direction) {
  const newIndex = index + direction;
  if (newIndex < 0 || newIndex >= currentChatTemplates.length) return;
  // Byt plats i arrayen
  [currentChatTemplates[index], currentChatTemplates[newIndex]] = [currentChatTemplates[newIndex], currentChatTemplates[index]];
  renderChatTemplatesList();
  // Skicka ny ordning till servern
  try {
    await fetch('/.netlify/functions/admin-chat-templates', {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'reorder', ids: currentChatTemplates.map(t => t.id) }),
    });
    // Uppdatera lokal sort_order
    currentChatTemplates.forEach((t, i) => { t.sort_order = i; });
    if (activeTab === 'chat' && currentCart) renderTab('chat');
  } catch (e) {
    console.warn('Reorder failed:', e.message);
  }
}

