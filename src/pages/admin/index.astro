            </div>
          </div>
          <div style="display:flex;gap:6px;flex-wrap:wrap">
            ${c.credit_invoice_number
              ? `<button class="btn-action" onclick="invResendCredit()" style="font-size:0.75rem;border-color:rgba(239,68,68,0.5);color:#f87171">📤 Skicka om</button>`
              : `<button class="btn-action" onclick="invCreateCredit()" style="font-size:0.78rem;background:rgba(185,28,28,0.2);border-color:rgba(239,68,68,0.5);color:#fca5a5">↩ Skapa kreditfaktura</button>`}
          </div>
        </div>
      </div>
    ` : ''}

    <details style="margin-top:16px;border:1px solid var(--border);border-radius:8px;overflow:hidden">
      <summary style="padding:8px 12px;cursor:pointer;font-size:0.78rem;font-weight:600;color:var(--text-muted);background:var(--surface);list-style:none;display:flex;align-items:center;gap:6px">
        ⚙ Fakturaserie
      </summary>
      <div style="padding:14px;background:var(--bg);font-size:0.8rem">

        <!-- ═══ Översikt: Nästa + Senaste använt + Reservationer ═══ -->
        <div id="inv-serie-overview" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
          <div style="background:linear-gradient(135deg,rgba(196,181,244,0.12),rgba(196,181,244,0.04));border:1px solid rgba(196,181,244,0.3);border-radius:10px;padding:10px 12px">
            <div style="color:var(--text-faint);font-size:0.66rem;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px">Nästa nummer</div>
            <div id="inv-serie-next" style="color:var(--brand-lav);font-size:1.4rem;font-weight:700;line-height:1.1">…</div>
          </div>
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 12px">
            <div style="color:var(--text-faint);font-size:0.66rem;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:3px">Senast använt</div>
            <div id="inv-serie-highest" style="color:var(--text);font-size:1.4rem;font-weight:700;line-height:1.1">…</div>
          </div>
        </div>

        <!-- ═══ Hoppa till nummer ═══ -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:12px">
          <div style="color:var(--text);font-weight:600;font-size:0.8rem;margin-bottom:3px">Hoppa till nummer</div>
          <p style="color:var(--text-faint);font-size:0.72rem;margin:0 0 8px;line-height:1.4">
            Används när manuella fakturor skickats utanför systemet. Alla lediga nummer fram till valt nummer reserveras automatiskt.
          </p>
          <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
            <span style="color:var(--text-muted);font-size:0.9rem;font-weight:600">K</span>
            <input id="inv-next-num" type="number" min="2011" step="1" placeholder="2020"
              style="width:90px;font-size:0.85rem;padding:5px 9px;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;border:1px solid var(--border);border-radius:5px">
            <button class="btn-action" onclick="invSetNextNumber()" style="font-size:0.78rem">
              Reservera →
            </button>
            <span id="inv-maint-status" style="margin-left:4px;font-size:0.72rem;color:var(--text-faint);flex:1;min-width:140px"></span>
          </div>
        </div>

        <!-- ═══ Reservationer (visas bara om > 0) ═══ -->
        <div id="inv-reserv-section" style="display:none;margin-bottom:12px">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;gap:8px;flex-wrap:wrap">
            <div style="font-size:0.78rem;font-weight:700;color:var(--text)">
              Reservationer <span id="inv-reserv-count" style="color:var(--text-faint);font-weight:400"></span>
            </div>
            <button onclick="invClearAllReservations()" class="btn-action"
              style="font-size:0.7rem;padding:2px 9px;border-color:rgba(239,68,68,0.5);color:#f87171">
              🗑 Rensa alla
            </button>
          </div>
          <div id="inv-reserv-list" style="font-size:0.74rem;color:var(--text-muted);background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:4px 10px;max-height:200px;overflow-y:auto"></div>
        </div>

        <!-- ═══ Senaste fakturor (utan reservationer) ═══ -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
            <div style="font-size:0.78rem;font-weight:700;color:var(--text)">Senaste fakturor</div>
            <button onclick="invLoadRecent()" class="btn-action" style="font-size:0.7rem;padding:2px 8px">↻ Uppdatera</button>
          </div>
          <p style="color:var(--text-faint);font-size:0.7rem;margin:0 0 6px;font-style:italic;line-height:1.4">
            Radera en faktura för att frigöra K-numret — nyttigt för testfakturor. Luckor fylls automatiskt vid nästa fakturagenerering.
          </p>
          <div id="inv-recent-list" style="font-size:0.75rem;color:var(--text-muted)">Laddar…</div>
        </div>

      </div>
    </details>
  `;
}

async function invSetNextNumber() {
  const input = document.getElementById('inv-next-num');
  const status = document.getElementById('inv-maint-status');
  const num = parseInt(input?.value);
  if (!num || num < 1) { if(status) status.textContent = '⚠ Ange ett giltigt nummer'; return; }
  const reservedNum = 'K' + (num - 1); // Vi reserverar K(num-1) så nästa blir K(num)
  if(status) status.textContent = '⏳ Reserverar…';
  try {
    // Skapa en dummy-post i carts med detta invoice_number för att "ta" det ur serien
    // Enklare: POST till en dedikerad endpoint eller använd cart-update på currentCart
    // Vi använder supabase direkt via cart-update med ett dummy invoice_number
    const res = await fetch('/.netlify/functions/invoice-reserve', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${TOKEN}` },
      body: JSON.stringify({ next_number: num })
    });
    if (res.ok) {
      if(status) { status.style.color='var(--green)'; status.textContent = `✓ Nästa faktura blir K${num}`; }
      if(input) input.value = '';
      // Uppdatera översikt + listor direkt så användaren ser förändringen
      invLoadRecent();
    } else {
      const err = await res.json();
      if(status) { status.style.color='var(--red)'; status.textContent = '⚠ ' + (err.error||'Fel'); }
    }
  } catch(e) {
    if(status) { status.style.color='var(--red)'; status.textContent = '⚠ Nätverksfel'; }
  }
}
function qcAutoReturnDate(fromVal) {
  const toEl = document.getElementById('qc-date-to');
  if (!toEl || !fromVal) return;
  if (!toEl.value || toEl.value <= fromVal) {
    const d = new Date(fromVal);
    d.setDate(d.getDate() + 1);
    toEl.value = d.toISOString().slice(0, 10);
  }
}
function adminAutoReturnDate(fromVal) {
  const toEl = document.getElementById('edit-return-date');
  if (!toEl || !fromVal) return;
  if (!toEl.value || toEl.value <= fromVal) {
    const d = new Date(fromVal);
    d.setDate(d.getDate() + 1);
    toEl.value = d.toISOString().slice(0, 10);
  }
}
window.adminAutoReturnDate = adminAutoReturnDate;
window.qcAutoReturnDate = qcAutoReturnDate;

window.invSetNextNumber = invSetNextNumber;

function invUpdateDueDate() {
  const dateEl  = document.getElementById('inv-date');
  const dueEl   = document.getElementById('inv-due');
  const termsEl = document.getElementById('inv-terms');
  if (!dateEl || !dueEl || !termsEl) return;
  const base = new Date(dateEl.value || new Date().toISOString().slice(0,10));
  const days = parseInt(termsEl.value) || 5;
  base.setDate(base.getDate() + days);
  dueEl.value = base.toISOString().slice(0,10);
}

async function invCreateAndSend() {
  if (!currentCart.customer_email) { toast('Kunden saknar e-postadress', 'error'); return; }

  // Hämta nästa fakturanummer från servern — tar hänsyn till BÅDE riktiga
  // fakturor och reservationer (som admin-carts filtrerar bort).
  let previewNum = currentCart.invoice_number || '…';
  if (!currentCart.invoice_number) {
    try {
      const { ok: nextOk, data: nextData } = await api('invoice-next-number');
      if (nextOk && nextData?.next_number) {
        previewNum = nextData.next_number;
      }
    } catch(e) { /* fortsätt med fallback … */ }
  }

  // Visa bekräftelsedialog med fakturanummer
  const items = (currentCart.items||[]).filter(i=>!i._note&&i.name?.trim());
  const total = items.reduce((s,i)=>s+((i.price||0)*(i.qty||1)),0);
  const totalIncl = Math.round(total * 1.25);

  const confirmed = await showInvoiceConfirmDialog(previewNum, totalIncl);
  if (!confirmed) return;

  // Spara uppgifter först
  await invSaveFields();
  const btn = document.querySelector('[onclick="invCreateAndSend()"]');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Skapar faktura…'; }
  try {
    const sendBody = { cart_id: currentCart.id };
    // Skicka med override-numret atomiskt så invoice-send använder rätt K-nummer
    if (confirmed.override && confirmed.invoice_number) {
      sendBody.override_invoice_number = confirmed.invoice_number;
    }
    const { ok, data, status } = await api('invoice-send', {
      method: 'POST',
      body: JSON.stringify(sendBody)
    });
    if (ok && !data.error) {
      currentCart.status = 'fakturerad';
      currentCart.invoice_sent_at = new Date().toISOString();
      currentCart.invoice_number = data.invoice_number;
      toast('Faktura ' + data.invoice_number + ' skapad och skickad! 📧');
      await loadCarts();
      renderTab('faktura');
      renderPanelFooter();
    } else {
      toast(data?.error || `Fel ${status} vid fakturering`, 'error');
      if (btn) { btn.disabled = false; btn.textContent = '🧾 Skapa & skicka faktura'; }
    }
  } catch (e) {
    toast('Nätverksfel: ' + e.message, 'error');
    if (btn) { btn.disabled = false; btn.textContent = '🧾 Skapa & skicka faktura'; }
  }
}

function showInvoiceConfirmDialog(invoiceNum, totalIncl) {
