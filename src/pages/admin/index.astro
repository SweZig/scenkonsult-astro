    'order_confirmed':    { icon: '✅', label: 'Order bekräftad av kund', color: 'var(--green)' },
    'items_updated':      { icon: '📦', label: 'Produkter uppdaterade', color: 'var(--text-muted)' },
  };

  let html = '<div class="section-label">Händelselogg (senaste 50)</div><div style="display:flex;flex-direction:column;gap:0.4rem">';
  logs.forEach(function(l) {
    const ev = EVENT_LABELS[l.event_type] || { icon: '·', label: l.event_type, color: 'var(--text-faint)', highlight: false };
    const actorLabel = l.actor === 'customer' ? 'Kund' : l.actor === 'admin' ? 'Admin' : 'System';
    const payloadStr = l.payload && Object.keys(l.payload).length
      ? (l.payload.preview
          ? `"${l.payload.preview}"`
          : Object.entries(l.payload).filter(function(e){ return e[0] !== 'preview'; }).map(function(e){ return e[0] + ': ' + e[1]; }).join(' · '))
      : '';
    const border = ev.highlight ? ';border:1px solid rgba(196,181,244,0.2)' : '';
    const bg = ev.highlight ? 'rgba(196,181,244,0.06)' : 'var(--bg)';
    html += '<div style="background:' + bg + ';border-radius:8px;padding:0.65rem 0.75rem;display:flex;gap:0.75rem;align-items:flex-start' + border + '">';
