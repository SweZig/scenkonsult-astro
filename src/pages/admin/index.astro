function renderCalendar() {
  const months = ['Januari','Februari','Mars','April','Maj','Juni','Juli','Augusti','September','Oktober','November','December'];
  $('cal-month-label').textContent = `${months[calMonth]} ${calYear}`;

  const firstDay = new Date(calYear, calMonth, 1);
  const lastDay  = new Date(calYear, calMonth + 1, 0);
  const today    = new Date();

  // Mon=0 offset
  let startDow = firstDay.getDay() - 1;
  if (startDow < 0) startDow = 6;

  const days = $('cal-days');
  days.innerHTML = '';

  const totalCells = Math.ceil((startDow + lastDay.getDate()) / 7) * 7;

  // Helper: format ISO date YYYY-MM-DD
  const toIso = (d) => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;

  // Visning sträcker sig från cell 0 till sista cell
  const viewStart = new Date(calYear, calMonth, 1 - startDow);
  const viewEnd   = new Date(calYear, calMonth, totalCells - startDow - 1);
  const viewStartStr = toIso(viewStart);
  const viewEndStr   = toIso(viewEnd);

  // Filtrera bokningar som överlappar visningen.
  // Använd kanban-statusar (STATUS_LABELS) för att fånga okända/legacy ghost-rader,
  // men exkludera 'open' (kontaktförfrågningar) och 'cancelled' — kalendern visar
  // bara faktisk bearbetad pipeline. Open-förfrågningar syns i kanban-kolumnen.
  const KNOWN_STATUSES = new Set(Object.keys(STATUS_LABELS));
  const CALENDAR_STATUSES = new Set(['new','waiting','confirmed','fakturerad','betald']);
  const unknownInCalendar = carts.filter(c => c.event_date && !KNOWN_STATUSES.has(c.status));
  if (unknownInCalendar.length) {
    console.warn(
      `[Calendar] ${unknownInCalendar.length} cart(s) med okänd status hoppas över. ` +
      `Städa upp i Supabase eller mappa till en känd status:`,
      unknownInCalendar.map(c => ({ id: c.id, status: c.status, event_date: c.event_date, customer: c.customer_name }))
    );
  }
  const visible = carts
    .filter(c => c.event_date && CALENDAR_STATUSES.has(c.status))
    .map(c => ({
      cart: c,
      start: c.event_date,
      end:   c.return_date && c.return_date >= c.event_date ? c.return_date : c.event_date,
      pickupTime: c.delivery_time || '13:00',
      returnTime: c.return_time   || '11:00',
    }))
    .filter(b => b.start <= viewEndStr && b.end >= viewStartStr);

  // Lane-allokering: greedy efter startdatum, längre bokningar först vid lika start
  const sorted = [...visible].sort((a, b) => {
    if (a.start !== b.start) return a.start < b.start ? -1 : 1;
    return a.end > b.end ? -1 : 1;
  });
  const laneEnds = []; // laneEnds[i] = senaste end-datumet i lane i
  for (const b of sorted) {
    let lane = -1;
    for (let i = 0; i < laneEnds.length; i++) {
      if (laneEnds[i] < b.start) { lane = i; break; }
    }
    if (lane === -1) { lane = laneEnds.length; laneEnds.push(b.end); }
    else laneEnds[lane] = b.end;
    b.lane = lane;
  }
  const maxLane = laneEnds.length;
  const LANE_H  = 22; // px per lane

  // Index: vilka bokningar finns på varje datum
  const byDate = {};
  for (const b of visible) {
    let d = new Date(b.start + 'T00:00:00');
    const endD = new Date(b.end + 'T00:00:00');
    while (d <= endD) {
      const k = toIso(d);
      (byDate[k] = byDate[k] || []).push(b);
      d.setDate(d.getDate() + 1);
    }
  }

  for (let i = 0; i < totalCells; i++) {
    const dayOffset = i - startDow + 1;
    const date      = new Date(calYear, calMonth, dayOffset);
    const isOther   = dayOffset < 1 || dayOffset > lastDay.getDate();
    const isToday   = !isOther && date.toDateString() === today.toDateString();
    const dateStr   = toIso(date);

    const dow = (date.getDay() + 6) % 7; // Mon=0 ... Sun=6
    const isWeekStart = dow === 0;
    const isWeekEnd   = dow === 6;

    const cell = document.createElement('div');
    cell.className = `cal-day${isOther ? ' other-month' : ''}${isToday ? ' today' : ''}`;

    // Day number
    const dayNum = document.createElement('div');
    dayNum.className = 'cal-day-num';
    dayNum.textContent = date.getDate();
    cell.appendChild(dayNum);

    // Bands-area — höjd reserveras så cellerna håller jämn höjd
    const bandsArea = document.createElement('div');
    bandsArea.className = 'cal-bands';
    bandsArea.style.height = `${Math.max(maxLane, 1) * LANE_H}px`;

    const todays = (byDate[dateStr] || []);
    for (const b of todays) {
      const isStart = b.start === dateStr;
      const isEnd   = b.end   === dateStr;

      const band = document.createElement('div');
      band.className = `cal-band s-${b.cart.status}`;
      band.dataset.id = b.cart.id;

      // Position
      band.style.top = `${b.lane * LANE_H}px`;

      // Kant-i-kant: extend 0.4rem (cell-padding) för att täcka cellgränserna
      // i mittendagar; rounded corners endast på faktiska start/slut
      band.style.left  = isStart      ? '0.4rem' : '0';
      band.style.right = isEnd        ? '0.4rem' : '0';
      band.style.borderTopLeftRadius     = isStart ? '6px' : '0';
      band.style.borderBottomLeftRadius  = isStart ? '6px' : '0';
      band.style.borderTopRightRadius    = isEnd   ? '6px' : '0';
      band.style.borderBottomRightRadius = isEnd   ? '6px' : '0';

      // Inga vänster/höger borders mitt-i-segmentet — för sömlös ribbon
      if (!isStart) band.style.borderLeft  = 'none';
      if (!isEnd)   band.style.borderRight = 'none';

      // Innehåll: text endast på start (och ev. på vecko-kontinuationer)
      const customerName = b.cart.customer_company || b.cart.customer_name || b.cart.id;
      const totalKr = b.cart.total_excl ? Math.round(b.cart.total_excl/100).toLocaleString('sv-SE') + ' kr' : '';

      let html = '';
      if (isStart) {
        html += `<span class="cal-band-time">${b.pickupTime}</span>`;
        html += `<span class="cal-band-name">${escapeHtml(customerName)}</span>`;
      } else if (isWeekStart) {
        // Forts. från föregående vecka
        html += `<span class="cal-band-cont-arrow">→</span>`;
        html += `<span class="cal-band-name">${escapeHtml(customerName)}</span>`;
      }

      if (isEnd && !isStart) {
        html += `<span class="cal-band-return">↩ ${b.returnTime}</span>`;
      } else if (isStart && isEnd && totalKr) {
        // Single-day: visa totalpris istället för returpil
        html += `<span class="cal-band-total">${totalKr}</span>`;
      } else if (isStart && !isEnd && totalKr) {
        // Flerdagsbokning: visa totalpris diskret efter namn
        html += `<span class="cal-band-total">${totalKr}</span>`;
      }

      // Tooltip
      const tipParts = [
        customerName,
        `${b.pickupTime} → ${b.returnTime}`,
        `${b.start}${b.end !== b.start ? ' – ' + b.end : ''}`,
      ];
      if (b.cart.event_location) tipParts.push(b.cart.event_location);
      if (totalKr) tipParts.push(totalKr);
      band.title = tipParts.join('\n');

      band.innerHTML = html;
      band.addEventListener('click', e => {
        e.stopPropagation();
        openDetail(b.cart.id);
      });
      bandsArea.appendChild(band);
    }

    cell.appendChild(bandsArea);
    days.appendChild(cell);
  }

  // Visa feed-URL om CALENDAR_FEED_TOKEN är konfigurerat på servern
  // Hämtas via skyddad endpoint så feed-token aldrig syns i admin-HTML innan auth
  const feedBox = $('cal-feed-box');
  if (feedBox && !feedBox.dataset.loaded) {
    feedBox.dataset.loaded = '1';
    api('admin-calendar-feed-url').then(({ ok: o, data }) => {
      if (o && data?.configured && data?.url) {
        $('cal-feed-url').textContent = data.url;
        feedBox.dataset.webcal = data.webcal_url || '';
        feedBox.style.display = 'flex';
      } else {
        // Visa en informativ hint istället för att dölja helt
        $('cal-feed-url').textContent = data?.message || 'CALENDAR_FEED_TOKEN saknas i Netlify-env';
        feedBox.style.display = 'flex';
        feedBox.style.opacity = '0.7';
        $('cal-feed-copy').disabled = true;
        $('cal-feed-open').style.display = 'none';
      }
    }).catch(() => {
      feedBox.style.display = 'none';
    });
  }
}

// Liten hjälpfunktion för band-text (undviker XSS från kundnamn)
function escapeHtml(s) {
  return String(s||'').replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}

