<!-- ── OFFERT-MODAL ──────────────────────────────────────────── -->
<div class="modal-overlay" id="quote-overlay">
  <div class="modal" style="max-width:920px">
    <div class="modal-head">
      <div class="modal-title">✉ Skicka offert till kund</div>
      <button class="panel-close" id="quote-close">✕</button>
    </div>
    <div class="modal-body" id="quote-body">

      <!-- Kunduppgifter -->
      <div class="section-label" style="margin-top:0">Kunduppgifter</div>
      <div class="form-row">
        <div><label class="form-label">Namn *</label><input class="form-input" id="qc-name" placeholder="För- och efternamn" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
        <div><label class="form-label">E-post *</label><input class="form-input" type="email" id="qc-email" placeholder="kund@exempel.se" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
      </div>
      <div class="form-row">
        <div><label class="form-label">Telefon</label><input class="form-input" id="qc-phone" placeholder="070 000 00 00" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
        <div><label class="form-label">CC-kopia <span style="font-size:0.72rem;color:rgba(196,181,244,0.55);font-weight:400">(kopia på alla mail)</span></label><input class="form-input" type="email" id="qc-cc" placeholder="cc@foretag.se" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
      </div>
      <div class="form-row">
        <div><label class="form-label">Datum, från *</label><input class="form-input" type="date" id="qc-date" onchange="qcAutoReturnDate(this.value)" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
        <div><label class="form-label">Datum, till</label><input class="form-input" type="date" id="qc-date-to" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
      </div>
      <div class="form-row">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;grid-column:1/-1">
          <div><label class="form-label">Utlämning</label><input class="form-input" type="time" id="qc-time-from" value="13:00" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
          <div><label class="form-label">Återlämning</label><input class="form-input" type="time" id="qc-time-to" value="11:00" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
        </div>
      </div>
      <div class="form-row">
        <div><label class="form-label">Företagsnamn</label><input class="form-input" id="qc-company" placeholder="Företag / organisation" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;" oninput="const v=this.value.trim();document.getElementById('qc-b2b-fields').style.display=v?'block':'none';document.getElementById('qc-b2b-placeholder').style.display=v?'none':''"></div>
        <div><label class="form-label">Organisationsnummer</label><div id="qc-b2b-fields" style="display:none"><input class="form-input" id="qc-orgnr" placeholder="556xxx-xxxx" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div><div id="qc-b2b-placeholder" style="color:rgba(255,255,255,0.55);font-size:0.8rem;padding:0.4rem 0">Fylls i när företag anges</div></div>
      </div>
      <div class="form-row full" style="margin-bottom:0">
        <div><label class="form-label">Plats / Adress</label><input class="form-input" id="qc-location" placeholder="Lokal eller adress" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;"></div>
      </div>
      <div class="form-row full" style="margin-bottom:0">
        <div><label class="form-label">Hämtning eller leverans</label>
          <select class="form-input" id="qc-delivery-mode" style="background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;">
            <option value="">— välj —</option>
            <option value="self_pickup">📦 Hämtar och lämnar själv</option>
            <option value="delivery">🚚 Önskar leverans och upphämtning</option>
          </select>
        </div>
      </div>

      <!-- Produktväljare -->
      <div class="section-label">Lägg till produkter</div>

      <!-- Snabbsök på produktnamn eller artno -->
      <div style="position:relative;margin-bottom:0.75rem">
        <input id="qp-search" type="text" placeholder="🔍 Snabbsök produkt eller artno (t.ex. 'subwoofer' eller 'SK-LJD-MIK-0014')"
          autocomplete="off"
          oninput="quoteSearchInput(this.value)"
          onkeydown="quoteSearchKey(event)"
          onfocus="quoteSearchInput(this.value)"
          onblur="setTimeout(() => { const r = document.getElementById('qp-search-results'); if (r) r.style.display = 'none'; }, 200)"
          style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(196,181,244,0.35);border-radius:8px;padding:0.55rem 0.75rem;font-family:inherit;font-size:0.85rem">
        <div id="qp-search-results" style="display:none;position:absolute;top:100%;left:0;right:0;background:#1a1640;border:1px solid rgba(196,181,244,0.3);border-radius:8px;margin-top:4px;max-height:340px;overflow-y:auto;z-index:50;box-shadow:0 6px 24px rgba(0,0,0,0.4)"></div>
      </div>

      <!-- Konfigurator-knappar -->
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.75rem">
        <button class="btn-action" onclick="document.getElementById('quote-picker-row').style.display = document.getElementById('quote-picker-row').style.display === 'none' ? 'grid' : 'none'" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.95);background:rgba(196,181,244,0.08)" title="Visa/dölj traditionell kategori-väljare">▾ Kategori-väljare</button>
        <button class="btn-action" onclick="adminScenConfigOpen()" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.95);background:rgba(196,181,244,0.08)">🎭 Konfigurera scen</button>
        <button class="btn-action" onclick="adminLedConfigOpen()" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.95);background:rgba(196,181,244,0.08)">📺 Konfigurera LED-vägg</button>
        <button class="btn-action" onclick="adminFraktConfigOpen()" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.95);background:rgba(196,181,244,0.08)">🚚 Frakt</button>
        <button class="btn-action" onclick="adminMonteringConfigOpen()" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.95);background:rgba(196,181,244,0.08)">🔧 Montering</button>
        <button class="btn-action" onclick="quoteAddCustomRow()" style="font-size:0.78rem;padding:0.35rem 0.8rem;border-color:rgba(196,181,244,0.35);color:rgba(196,181,244,0.8);background:rgba(196,181,244,0.06)">✏ Fritext-rad</button>
      </div>

      <!-- Scen-konfigurator (kollapsad som standard) -->
      <div id="admin-scen-config" style="display:none;background:rgba(196,181,244,0.05);border:1px solid rgba(196,181,244,0.25);border-radius:10px;padding:0.85rem;margin-bottom:0.75rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.7rem">
          <strong style="color:rgba(196,181,244,0.95);font-size:0.85rem">🎭 Konfigurera scen</strong>
          <button onclick="adminScenConfigClose()" style="background:none;border:none;color:rgba(255,255,255,0.5);font-size:1.2rem;cursor:pointer;padding:0 0.3rem">×</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:0.5rem;margin-bottom:0.6rem">
          <div>
            <label class="form-label" style="font-size:0.72rem">Bredd (m)</label>
            <input type="number" id="scen-cfg-w" min="2" max="12" step="1" value="4" oninput="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
          </div>
          <div>
            <label class="form-label" style="font-size:0.72rem">Djup (m)</label>
            <input type="number" id="scen-cfg-d" min="2" max="8" step="1" value="2" oninput="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
          </div>
        </div>
        <div style="margin-bottom:0.6rem">
          <label class="form-label" style="font-size:0.72rem">Plattformsyta</label>
          <select id="scen-cfg-yta" onchange="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem"></select>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.5rem;margin-bottom:0.6rem">
          <div>
            <label class="form-label" style="font-size:0.72rem">Höjd</label>
            <select id="scen-cfg-h" onchange="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
              <option value="40">40 cm</option>
              <option value="60">60 cm</option>
            </select>
          </div>
          <div>
            <label class="form-label" style="font-size:0.72rem">Trappor</label>
            <input type="number" id="scen-cfg-trapp" min="0" max="4" step="1" value="0" oninput="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
          </div>
          <div>
            <label class="form-label" style="font-size:0.72rem">Tak</label>
            <select id="scen-cfg-tak" onchange="adminScenConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
              <option value="">— Inget tak —</option>
            </select>
          </div>
        </div>
        <div id="scen-cfg-preview" style="background:rgba(0,0,0,0.25);border-radius:6px;padding:0.6rem 0.75rem;margin-bottom:0.6rem;font-size:0.78rem;color:rgba(255,255,255,0.78);font-family:'Space Grotesk',sans-serif"></div>
        <div id="scen-cfg-warn" style="color:#ff9b9b;font-size:0.75rem;margin-bottom:0.6rem;display:none"></div>
        <button onclick="adminScenConfigAdd()" id="scen-cfg-add-btn" class="btn-action btn-success" style="width:100%;padding:0.5rem;font-size:0.85rem">Lägg till rader i offerten</button>
      </div>

      <!-- LED-vägg-konfigurator (kollapsad som standard) -->
      <div id="admin-led-config" style="display:none;background:rgba(196,181,244,0.05);border:1px solid rgba(196,181,244,0.25);border-radius:10px;padding:0.85rem;margin-bottom:0.75rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.7rem">
          <strong style="color:rgba(196,181,244,0.95);font-size:0.85rem">📺 Konfigurera LED-vägg</strong>
