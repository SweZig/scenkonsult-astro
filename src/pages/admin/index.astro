// ── API ───────────────────────────────────────────────────────
// Robust fetch-wrapper:
//   - AbortController med 20s timeout (Netlify cold-start kan ta 10+ sek)
//   - Nätverks-/timeout-fel returneras som { ok:false, status:0, data:{error} }
//     istället för throw. Callers slipper try-catch på fetch.
//   - 401 → invalidera session och throw 'Unauthorized' (oförändrat beteende)
//   - opts.silent: callers (t.ex. auto-refresh) som inte vill visa toast
//     vid nätverksfel kan kolla data.netError efter retur.
async function api(path, opts = {}) {
  const timeoutMs = opts.timeoutMs ?? 20000;
  const ctrl = new AbortController();
  const tid = setTimeout(() => ctrl.abort(), timeoutMs);

  let res;
  try {
    res = await fetch(`/.netlify/functions/${path}`, {
      ...opts,
      signal: ctrl.signal,
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${TOKEN}`,
        ...(opts.headers || {})
      }
    });
  } catch (e) {
    clearTimeout(tid);
    const isTimeout = e.name === 'AbortError';
    const reason    = isTimeout ? `timeout efter ${timeoutMs}ms` : (e.message || 'okänt');
    console.error(`API_NET_ERR[${path}]:`, reason);
    return {
      ok: false,
      status: 0,
      netError: true,
      data: {
        error: isTimeout
          ? 'Servern svarar inte (timeout) — kontrollera anslutningen'
          : 'Nätverksfel — försök igen'
      }
    };
  }
  clearTimeout(tid);

  let data = {};
  try {
    const txt = await res.text();
    data = txt ? JSON.parse(txt) : {};
  } catch (e) {
    console.error(`API_PARSE_ERR[${path}]:`, res.status, res.url, e.message);
    data = { error: `Servern returnerade ett ogiltigt svar (HTTP ${res.status})` };
  }
  if (res.status === 401) {
    sessionStorage.removeItem('sk_admin_token');
    TOKEN = '';
    $('app').style.display = 'none';
    $('login-screen').style.display = 'flex';
    $('login-error').style.display = 'block';
    $('login-error').textContent = 'Fel lösenord, försök igen.';
    $('login-pw').value = '';
    $('login-pw').focus();
    throw new Error('Unauthorized');
  }
  return { ok: res.ok, status: res.status, data };
}

// ── LOAD CARTS ────────────────────────────────────────────────
// ── currentCart-synk efter modifiering ────────────────────────
// Efter varje admin-spara måste vi hämta hela cart-objektet på nytt
// från servern, annars hamnar lokala fält i otakt med databasen.
// Detta löser bl.a. att return_date "ändras tillbaka" och att
// anmärkningar (_note) försvinner från Produkter-fliken.
async function refreshCurrentCart() {
  if (!currentCart?.id) return;
  try {
    const { ok, data } = await api(`admin-carts?id=${currentCart.id}`);
    if (ok && data?.cart) {
      currentCart     = data.cart;
      currentMessages = data.messages || currentMessages;
      currentAudit    = data.audit_log || currentAudit;
    }
  } catch (e) {
    console.warn('REFRESH_CURRENT_CART: kunde inte synka', e.message);
  }
}

async function loadCarts() {
  const { ok, data, netError } = await api('admin-carts');
  if (!ok) {
    // Nätverksfel under auto-refresh ska INTE spamma toasts — tyst log
    if (netError) {
      console.warn('LOAD_CARTS: nätverksfel under polling — försöker igen om 30s');
      return;
    }
    if (data.error === 'Ej behörig') {
      $('login-error').style.display = 'block';
      $('login-error').textContent = 'Fel lösenord.';
      $('app').style.display = 'none';
      $('login-screen').style.display = 'flex';
      sessionStorage.removeItem('sk_admin_token');
      return;
    }
    toast('Kunde inte hämta varukorgar', 'error');
    return;
  }
  carts = data.carts || [];
  renderKanban();
  if ($('view-calendar').classList.contains('active'))  renderCalendar();
  if ($('view-phonebook').classList.contains('active')) renderPhonebook();
  checkReminderQueue();
}

// ── KANBAN ────────────────────────────────────────────────────
// "Oläst" = endera (a) admin har olästa kundmeddelanden eller
//          (b) kunden har inte öppnat sin offert än
function isCartUnread(c) {
  const adminHasUnread = (c.unread_count || 0) > 0;
  const customerNotRead = ['waiting','confirmed','fakturerad'].includes(c.status) && !c.last_read_customer;
  return adminHasUnread || customerNotRead;
}

function getFilteredCarts() {
  const search = $('filter-search').value.toLowerCase().trim();
  const from   = $('filter-from').value;
  const to     = $('filter-to').value;
  return carts.filter(c => {
    if (search && !((c.customer_name || '').toLowerCase().includes(search) || (c.id || '').toLowerCase().includes(search))) return false;
    if (from && c.event_date && c.event_date < from) return false;
    if (to   && c.event_date && c.event_date > to)   return false;
    if (_unreadFilter && !isCartUnread(c)) return false;
    return true;
  });
}

