async function sendMessage() {
  const input = $('chat-input');
  const btn   = $('chat-send-btn');
  const text  = input?.value.trim();
  if (!text) return;

  btn.disabled = true;
  btn.textContent = 'Skickar…';

  const { ok, data, netError } = await api('cart-message', {
    method: 'POST',
    body: JSON.stringify({ cart_id: currentCart.id, body: text })
  });

  if (ok) {
    currentMessages.push({
      id: data.message?.id || Date.now(),
      cart_id: currentCart.id,
      sender: 'admin',
      body: text,
      read_at: null,
      created_at: new Date().toISOString()
    });
    input.value = '';
    renderTab('chat');
    toast('Meddelande skickat!');
    loadCarts();
  } else if (netError) {
    // Anslutningen failade men servern har troligen redan tagit emot
    // requesten (cart-message tar 2-5s pga 600ms Resend rate-limit-sleeps).
    // Återhämta cart från servern och kolla om meddelandet finns där.
    console.warn('SEND_MESSAGE: nätverksfel — verifierar om meddelandet kom fram');
    btn.textContent = 'Verifierar…';
    const cartId = currentCart.id;
    const { ok: refetchOk, data: refetchData } = await api(`admin-carts?id=${cartId}`, { timeoutMs: 15000 });
    if (refetchOk && Array.isArray(refetchData.messages)) {
      // Senaste admin-meddelandet, jämför body
      const recent = refetchData.messages
        .filter(m => m.sender === 'admin')
        .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))[0];
      if (recent && recent.body === text &&
          (Date.now() - new Date(recent.created_at).getTime()) < 60000) {
        // Meddelandet kom fram trots nätverksfel — synka lokal state
        currentMessages = refetchData.messages;
        input.value = '';
        renderTab('chat');
        toast('✓ Meddelandet skickades (anslutningen var långsam)');
        loadCarts();
        return;
      }
    }
    // Meddelandet kom INTE fram, eller verifieringen failade också
    toast('Anslutningsproblem — försök skicka igen', 'error');
    btn.disabled = false;
    btn.textContent = 'Skicka till kund →';
  } else {
    console.error('SEND_MESSAGE: serverfel', data);
    toast(data.error || 'Kunde inte skicka', 'error');
    btn.disabled = false;
    btn.textContent = 'Skicka till kund →';
  }
}

