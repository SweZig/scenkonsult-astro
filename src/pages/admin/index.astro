          </div>
          <div>
            <label class="form-label" style="font-size:0.72rem">Rader (rows)</label>
            <input type="number" id="led-cfg-rows" min="1" max="20" step="1" value="3" oninput="adminLedConfigUpdate()" style="width:100%;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:0.4rem 0.6rem;font-size:0.85rem">
