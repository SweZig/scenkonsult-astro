<script>
// ── STATE ──────────────────────────────────────────────────── v2
let TOKEN = '';
let carts = [];
let currentCart = null;

// ── DIRTY-TRACKING I DETALJPANELEN ────────────────────────────
// Sätts till true när användaren ändrar något i Info/Produkter/Faktura.
// Vid flikbyte eller stäng-panel varnar vi om osparade ändringar.
let panelDirty = false;
function markPanelDirty()  { panelDirty = true; }
function clearPanelDirty() { panelDirty = false; }
// Bind: lyssna globalt på input/change i panel-body — sätt dirty om
// händelsen kommer från ett redigerbart fält i panelen
document.addEventListener('input', e => {
  const inPanel = e.target.closest?.('#panel-body');
  if (!inPanel) return;
  // Hoppa över chat — där sparas via Skicka-knapp, inte via Spara
  if (e.target.closest('.chat-input-wrap')) return;
  // Hoppa över "Anmärkningar (intern)" som har egen spara-knapp men
  // det skadar inte om den också flaggas — vi behåller den enkel:
  panelDirty = true;
});
document.addEventListener('change', e => {
  const inPanel = e.target.closest?.('#panel-body');
  if (!inPanel) return;
  if (e.target.closest('.chat-input-wrap')) return;
  panelDirty = true;
});
let currentMessages = [];
let currentAudit = [];
let activeTab = 'info';
let calYear = new Date().getFullYear();
let calMonth = new Date().getMonth();
let refreshTimer = null;

// ── HELPERS ───────────────────────────────────────────────────
const $ = id => document.getElementById(id); // admin v2
const fmt = n => typeof n === 'number' ? n.toLocaleString('sv-SE') : '–';
const fmtDate = d => d ? new Date(d).toLocaleDateString('sv-SE') : '–';
const fmtTime = d => d ? new Date(d).toLocaleString('sv-SE', { dateStyle:'short', timeStyle:'short', hour12:false }) : '–';
const fmtPrice = p => p ? fmt(Math.round(p/100)) + ' kr' : '–';

function toast(msg, type = 'success') {
  const el = $('toast');
  el.textContent = (type === 'success' ? '✓ ' : '✕ ') + msg;
  el.className = `show ${type}`;
  clearTimeout(el._t);
  el._t = setTimeout(() => el.className = '', 3000);
}

const STATUS_LABELS = {
  new:        { icon: '📬', label: 'Inkommen',       cls: 's-new'        },
  waiting:    { icon: '⏳', label: 'Offert skickad', cls: 's-waiting'    },
  confirmed:  { icon: '✅', label: 'Bekräftad',      cls: 's-confirmed'  },
  fakturerad: { icon: '🧾', label: 'Fakturerad',     cls: 's-fakturerad' },
  completed:  { icon: '🏁', label: 'Avslutade',      cls: 's-completed'  },
  cancelled:  { icon: '❌', label: 'Avbruten',       cls: 's-cancelled'  },
};

// Hjälpfunktion: returnerar badge för Inkommen-kort baserat på om kunden har produkter i varukorgen
function reqBadge(c) {
  if (c.status !== 'new') return '';
  const hasItems = (c.items || []).filter(i => !i._note && i.name?.trim()).length > 0;
  return hasItems
    ? '<span class="req-badge req-order">🛒 Orderförfrågan</span>'
    : '<span class="req-badge req-booking">💬 Bokningsförfrågan</span>';
}

// Hjälpfunktion: returnerar Betald-badge om fakturan är betald
function paidBadge(c) {
  return c.invoice_paid_at ? '<span class="req-badge req-paid">💚 Betald</span>' : '';
}

// Hjälpfunktion: returnerar förfallen-flagga för obetalda fakturor
// Regel: 0–2 dagar förfallen → ingen flagga, 3–7 dagar → gul, 8+ dagar → röd
function overdueFlag(c) {
  if (c.status !== 'fakturerad' || c.invoice_paid_at) return '';
  if (!c.invoice_due_date) return '';
  const today = new Date(); today.setHours(0,0,0,0);
  const due = new Date(c.invoice_due_date + 'T00:00:00');
  const daysOverdue = Math.floor((today - due) / 86400000);
  if (daysOverdue < 3) return '';
  if (daysOverdue < 8) return `<span class="req-badge req-overdue-warn">⚠ Förfallen ${daysOverdue}d</span>`;
  return `<span class="req-badge req-overdue-crit">🚨 Förfallen ${daysOverdue}d</span>`;
}

// Hjälpfunktion: varnar när bekräftade/fakturerade ordrar saknar event_date.
// Sådana ordrar är osynliga i kalendern och riskerar att missas helt.
function noDateFlag(c) {
  if (!['confirmed', 'fakturerad'].includes(c.status)) return '';
  if (c.event_date) return '';
  return '<span class="req-badge req-overdue-warn" title="Eventdatum saknas — ordern syns inte i kalendern. Lägg till datum i Info-fliken.">⚠ Datum saknas</span>';
}

// ── AUTH ──────────────────────────────────────────────────────
const ADMIN_TOKEN_TTL_MS = 30 * 24 * 60 * 60 * 1000; // 30 dagar (rolling)

function checkAuth() {
  // Försök sessionStorage (samma flik) först, sedan localStorage (korsfliks-token)
  let t = sessionStorage.getItem('sk_admin_token');
  if (!t) {
    try {
      const ls = JSON.parse(localStorage.getItem('sk_admin_mode') || '{}');
      if (ls.token && ls.ts && (Date.now() - ls.ts) < ADMIN_TOKEN_TTL_MS) {
        t = ls.token;
        sessionStorage.setItem('sk_admin_token', t); // cachelagra för fliken
        // Rolling refresh: skriv tillbaka med ny ts så att 30-dagars-fönstret
        // räknas från senaste användning, inte första inloggning
        localStorage.setItem('sk_admin_mode', JSON.stringify({ ts: Date.now(), token: t }));
      }
    } catch {}
  }
  if (t) { TOKEN = t; showApp(); }
}

$('login-pw').addEventListener('keydown', e => e.key === 'Enter' && doLogin());
$('login-btn').addEventListener('click', doLogin);

function doLogin() {
  const pw = $('login-pw').value.trim();
  if (!pw) return;
  TOKEN = pw;
  sessionStorage.setItem('sk_admin_token', pw);
  // Brygga till sitewide badge — sparar token för korsfliks-auth
  localStorage.setItem('sk_admin_mode', JSON.stringify({ ts: Date.now(), token: pw }));
  showApp();
}

function showApp() {
  $('login-screen').style.display = 'none';
  $('app').style.display = 'flex';
  _liftConfigPanelsToBody();
  loadCarts();
  loadChatTemplates();
  startRefreshTimer();
}

// Lyfter de fyra config-panelerna ur quote-overlay (där de bor i HTML)
// till document.body som modal-paneler. Då fungerar de både från quote-modalen
// och från Produkter-fliken på kundkortet. Idempotent — kollar parentNode.
function _liftConfigPanelsToBody() {
  const ids = ['admin-scen-config','admin-led-config','admin-frakt-config','admin-montering-config'];
  // Skapa gemensam backdrop som visas när någon panel är öppen
  if (!document.getElementById('admin-config-backdrop')) {
    const bd = document.createElement('div');
    bd.id = 'admin-config-backdrop';
    bd.style.cssText = 'display:none;position:fixed;inset:0;background:rgba(6,4,22,.78);z-index:8800;backdrop-filter:blur(2px)';
    bd.addEventListener('click', () => {
      // Stäng alla paneler vid backdrop-klick
      ids.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
      bd.style.display = 'none';
    });
    document.body.appendChild(bd);
  }
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (!el || el.parentNode === document.body) return;
    // Modal-styling: centrerad, fixed, högt z-index
    el.style.position    = 'fixed';
    el.style.top         = '50%';
    el.style.left        = '50%';
    el.style.transform   = 'translate(-50%,-50%)';
    el.style.maxWidth    = '480px';
    el.style.width       = 'calc(100vw - 2rem)';
    el.style.maxHeight   = '90vh';
    el.style.overflowY   = 'auto';
    el.style.zIndex      = '8900';
    el.style.boxShadow   = '0 12px 40px rgba(0,0,0,.6)';
    document.body.appendChild(el);
  });
}

