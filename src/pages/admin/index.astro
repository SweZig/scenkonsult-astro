// ── CALENDAR ──────────────────────────────────────────────────
$('cal-prev').addEventListener('click',  () => { if (--calMonth < 0)  { calMonth = 11; calYear--; } renderCalendar(); });
$('cal-next').addEventListener('click',  () => { if (++calMonth > 11) { calMonth = 0;  calYear++; } renderCalendar(); });
$('cal-today').addEventListener('click', () => { calYear = new Date().getFullYear(); calMonth = new Date().getMonth(); renderCalendar(); });

function renderCalendar() {
  const months = ['Januari','Februari','Mars','April','Maj','Juni','Juli','Augusti','September','Oktober','November','December'];
  $('cal-month-label').textContent = `${months[calMonth]} ${calYear}`;

  const firstDay = new Date(calYear, calMonth, 1);
  const lastDay  = new Date(calYear, calMonth + 1, 0);
  const today    = new Date();

  // Mon=0 offset
  let startDow = firstDay.getDay() - 1;
  if (startDow < 0) startDow = 6;

  const days = $('cal-days');
  days.innerHTML = '';

  const totalCells = Math.ceil((startDow + lastDay.getDate()) / 7) * 7;

  for (let i = 0; i < totalCells; i++) {
    const dayOffset = i - startDow + 1;
    const date = new Date(calYear, calMonth, dayOffset);
    const isOther = dayOffset < 1 || dayOffset > lastDay.getDate();
    const isToday = !isOther && date.toDateString() === today.toDateString();
    const dateStr = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;

    // Utlämningsdagar (event_date) för denna dag
    const pickupCarts = carts.filter(c => c.event_date === dateStr && c.status !== 'cancelled');
    // Returdagar (return_date) — separata markeringar
    const returnCarts = carts.filter(c => {
      const ret = c.return_date || c.event_date;
      return ret === dateStr && c.event_date !== dateStr && c.status !== 'cancelled';
    });
    // Perioden pågår — dagar MELLAN event_date och return_date
    const inPeriodCarts = carts.filter(c => {
      if (!c.event_date || c.status === 'cancelled') return false;
      const ret = c.return_date || c.event_date;
      return dateStr > c.event_date && dateStr < ret;
    });

    const hasPeriod = inPeriodCarts.length > 0;
    const cell = document.createElement('div');
    cell.className = `cal-day${isOther ? ' other-month' : ''}${isToday ? ' today' : ''}${hasPeriod ? ' has-period' : ''}`;

    // Pågående period — diskret bakgrundslinje
    const periodLines = inPeriodCarts.map(c =>
      `<div style="height:3px;border-radius:2px;margin:1px 0;background:${
        c.status==='confirmed'?'rgba(74,222,128,0.35)':
        c.status==='waiting'?'rgba(251,191,36,0.35)':'rgba(196,181,244,0.2)'
      }" title="${c.customer_name||c.id}"></div>`
    ).join('');

    // Utlämning — med tid 13:00 och totalpris
    const pickupHTML = pickupCarts.map(c => {
      const dlTime  = c.delivery_time || '13:00';
      const totalKr = c.total_excl ? Math.round(c.total_excl/100).toLocaleString('sv-SE')+' kr' : '';
      return `<div class="cal-event s-${c.status}" data-id="${c.id}">
        <span class="cal-event-time">${dlTime}</span>${STATUS_LABELS[c.status]?.icon||''} ${c.customer_name||c.id}${totalKr ? `<span style="float:right;color:rgba(196,181,244,0.7);font-size:0.6rem;margin-left:3px">${totalKr}</span>` : ''}
      </div>`;
    }).join('');

    // Retur — med tid 11:00, streckad kant
    const returnHTML = returnCarts.map(c => {
      const rtTime = c.return_time || '11:00';
      return `<div class="cal-event is-return s-${c.status}" data-id="${c.id}">
        <span class="cal-event-time">${rtTime}↩</span>${c.customer_name||c.id}
      </div>`;
    }).join('');

    cell.innerHTML = `<div class="cal-day-num">${date.getDate()}</div>
      ${periodLines}${pickupHTML}${returnHTML}`;

    cell.querySelectorAll('.cal-event').forEach(el => {
      el.addEventListener('click', e => { e.stopPropagation(); openDetail(el.dataset.id); });
    });
    days.appendChild(cell);
  }
}

