// ── HAMBURGER MENY (mobil) ────────────────────────────────────
// Bygger om drawer varje gång den öppnas så att t.ex. unread-badge alltid
// reflekterar aktuell status. Klick på drawer-knapp proxas via .click() till
// originalet i topbar-right, så alla event-handlers är intakta.
function buildBurgerDrawer() {
  const drawer = $('topbar-drawer');
  drawer.innerHTML = '';

  // Explicit stäng-knapp överst i drawer — backup om burger-toggle inte
  // fungerar i iOS-PWA av nån anledning
  const closeBtn = document.createElement('button');
  closeBtn.className = 'btn-sm topbar-drawer-close';
  closeBtn.type = 'button';
  closeBtn.innerHTML = '✕ Stäng meny';
  closeBtn.addEventListener('click', closeBurgerDrawer);
  drawer.appendChild(closeBtn);

  const actions = $('topbar-actions');
  Array.from(actions.children).forEach(orig => {
    const clone = orig.cloneNode(true);
    clone.removeAttribute('id'); // id-collision-skydd
    if (clone.tagName === 'BUTTON') {
      clone.addEventListener('click', e => {
        e.preventDefault();
        closeBurgerDrawer();
        orig.click();
      });
    } else {
      // Anchor → låt browsern hantera, men stäng drawer
      clone.addEventListener('click', closeBurgerDrawer);
    }
    drawer.appendChild(clone);
  });
}
function openBurgerDrawer() {
  buildBurgerDrawer();
  $('topbar-drawer').classList.add('is-open');
  $('topbar-backdrop').classList.add('is-open');
  $('topbar-burger').setAttribute('aria-expanded', 'true');
}
function closeBurgerDrawer() {
  $('topbar-drawer').classList.remove('is-open');
  $('topbar-backdrop').classList.remove('is-open');
  $('topbar-burger').setAttribute('aria-expanded', 'false');
}
$('topbar-burger')?.addEventListener('click', e => {
  e.stopPropagation();
  const open = $('topbar-burger').getAttribute('aria-expanded') === 'true';
  if (open) closeBurgerDrawer(); else openBurgerDrawer();
});
$('topbar-backdrop')?.addEventListener('click', closeBurgerDrawer);
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && $('topbar-drawer')?.classList.contains('is-open')) closeBurgerDrawer();
});
window.addEventListener('resize', () => {
  if (window.innerWidth > 600 && $('topbar-drawer')?.classList.contains('is-open')) closeBurgerDrawer();
});

// ── UPPDATERA / LADDA OM ──────────────────────────────────────
// Vanligt klick   = mjuk refresh (loadCarts).
// Shift-klick     = hård reload (location.reload med cache-bust) — efter deploy.
// Höger-klick     = samma som shift-klick (för mobil-långpress kan utvecklas).
