window.handleContactRequest = handleContactRequest;

// Skapa manuell order — öppnar detaljpanelen i produkt-fliken så admin kan
// bygga en offert utifrån kundens uppgifter. När admin sedan skickar offerten
// via "Skicka offert"-knappen sätts status automatiskt till 'waiting'.
async function convertContactToOrder(cartId) {
  if (!cartId) return;
  // Öppna detaljpanelen och hoppa direkt till produkt-fliken
  await openDetail(cartId);
  // openDetail laddar via async — vänta tills currentCart är satt innan vi byter flik
