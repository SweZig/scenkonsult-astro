// ─────────────────────────────────────────────────────────────
// SNABBSÖK i quote-picker
// Skannar QUOTE_CATALOG rekursivt och matchar fritext mot namn + id (artno).
// ─────────────────────────────────────────────────────────────
let _quoteSearchFlat = null;

// Helper: infoga en hårdvaru-rad före första tjänst (samma logik som
// quotePickerAdd) så tjänster alltid ligger sist i listan.
const _QUOTE_SVC_DISPLAY = ['Tjänster', 'Tillägg', 'Leverans'];
function _quoteIsSvc(i) {
  return i?.type === 'service' || _QUOTE_SVC_DISPLAY.includes(i?.category);
}
function _quoteInsertHardware(item) {
  const svcStart = quoteItems.findIndex(_quoteIsSvc);
  if (svcStart === -1) quoteItems.push(item);
  else quoteItems.splice(svcStart, 0, item);
}

// ─────────────────────────────────────────────────────────────
// TARGET-CONTEXT för konfiguratorer + sök
// Vid 'quote' (default) jobbar config/sök mot quoteItems (Ny manuell offert-modalen).
// Vid 'productsTab' jobbar de mot currentCart.items (kundkortets Produkter-flik).
// Sätts av "öppna config från produkter-fliken"-knapparna och nollställs när
// quote-modalen öppnas.
// ─────────────────────────────────────────────────────────────
let _configTarget = 'quote';

function _commitTargetItem(item) {
  if (_configTarget === 'productsTab') {
    // Skriv direkt på currentCart.items + uppdatera DOM via renderTab.
    // prodGetItems() läser DOM så vi måste synka items till DOM först
    // (renderTab('products') gör detta).
    const items = (typeof prodGetItems === 'function')
      ? prodGetItems()
      : (currentCart.items || []);
    const isSvc = _quoteIsSvc(item);
    if (isSvc) {
      items.push(item);
    } else {
      const svcStart = items.findIndex(_quoteIsSvc);
      if (svcStart === -1) items.push(item);
      else items.splice(svcStart, 0, item);
    }
    currentCart.items = items;
    renderTab('products');
    markPanelDirty();
  } else {
    // Default: quote-modalen
    if (_quoteIsSvc(item)) {
      quoteItems.push(item);
    } else {
      _quoteInsertHardware(item);
    }
    quoteRenderTable();
  }
}

function _targetRender() {
  if (_configTarget === 'productsTab') renderTab('products');
  else quoteRenderTable();
}

function _buildQuoteSearchIndex() {
  if (_quoteSearchFlat) return _quoteSearchFlat;
  const flat = [];
  const cat = window.__ADMIN_QUOTE_CATALOG__ || {};
  for (const [catName, catEntry] of Object.entries(cat)) {
    if (catEntry?.products) {
      for (const p of catEntry.products) {
        if (!p.custom && p.id) flat.push({ ...p, _cat: catName, _sub: null });
      }
    }
    if (catEntry?.sub) {
      for (const [subName, prods] of Object.entries(catEntry.sub)) {
        for (const p of (prods || [])) {
          if (!p.custom && p.id) flat.push({ ...p, _cat: catName, _sub: subName });
        }
      }
    }
  }
  _quoteSearchFlat = flat;
  return flat;
}

// Helper: vilken results-box som ska användas baserat på var sökfältet finns.
// Vi väljer baserat på _configTarget istället för DOM-discovery för enkelhet.
function _searchResultsBoxId() {
  return _configTarget === 'productsTab' ? 'prod-search-results' : 'qp-search-results';
}
function _searchInputId() {
  return _configTarget === 'productsTab' ? 'prod-search' : 'qp-search';
}

function quoteSearchInput(query) {
  const resBox = document.getElementById(_searchResultsBoxId());
  if (!resBox) return;
  const q = (query || '').trim().toLowerCase();
  if (!q) {
    resBox.style.display = 'none';
    return;
  }
  const flat = _buildQuoteSearchIndex();
  // Match på namn ELLER id (artno) — case-insensitive substring
  const hits = flat.filter(p => {
    const name = (p.name || '').toLowerCase();
    const id   = (p.id   || '').toLowerCase();
    return name.includes(q) || id.includes(q);
  }).slice(0, 12);

  if (!hits.length) {
    resBox.innerHTML = `<div style="padding:0.7rem 0.85rem;color:rgba(255,255,255,0.5);font-size:0.82rem">Inga träffar för "${q.replace(/</g,'&lt;')}"</div>`;
    resBox.style.display = 'block';
    return;
  }

  resBox.innerHTML = hits.map((p, i) => `
    <div class="qp-search-hit" data-idx="${i}" onmousedown="quoteSearchPick(${i})" style="padding:0.55rem 0.85rem;cursor:pointer;border-bottom:1px solid rgba(255,255,255,0.04);display:flex;justify-content:space-between;align-items:center;gap:0.6rem">
      <div style="flex:1;min-width:0">
        <div style="font-size:0.85rem;color:#f0eeff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${p.name}</div>
        <div style="font-size:0.7rem;color:rgba(196,181,244,0.7);margin-top:1px">${p.id}${p._sub ? ' · ' + p._sub : (p._cat ? ' · ' + p._cat : '')}</div>
      </div>
      <div style="font-size:0.82rem;color:#c4b5f4;font-weight:600;white-space:nowrap">${(p.price||0).toLocaleString('sv')} kr</div>
    </div>
  `).join('');
  resBox.style.display = 'block';
  // Spara senaste hits för pick-funktionen
  resBox._hits = hits;
}

function quoteSearchKey(e) {
  if (e.key === 'Escape') {
    document.getElementById(_searchResultsBoxId()).style.display = 'none';
    e.target.blur();
  } else if (e.key === 'Enter') {
    e.preventDefault();
    const resBox = document.getElementById(_searchResultsBoxId());
    if (resBox?._hits?.length) quoteSearchPick(0);
  }
}

// Sätt target före search (anropas från focus/input på prod-search)
function prodSearchSetTarget() { _configTarget = 'productsTab'; }
function quoteSearchSetTarget() { _configTarget = 'quote'; }

function quoteSearchPick(idx) {
  const resBox = document.getElementById(_searchResultsBoxId());
  const hits = resBox?._hits;
  if (!hits || !hits[idx]) return;
  const p = hits[idx];
  // Klassificera som tjänst eller hårdvara
  const SVC_IDS = new Set(['lev-standard','lev-skrymmande','lev-lastbil','lev-bakgavel','montering','rigg-teknik','fakturaavgift-49']);
  const isSvc = SVC_CATALOG_KEYS.includes(p._cat) || SVC_IDS.has(p.id);

  // Hitta befintlig rad i aktiv target-array och öka qty om träff
  const targetItems = _configTarget === 'productsTab'
    ? ((typeof prodGetItems === 'function') ? prodGetItems() : (currentCart.items || []))
    : quoteItems;
  const existing = targetItems.find(i => i.id === p.id && !i.custom);
  if (existing) {
    existing.qty++;
    if (_configTarget === 'productsTab') {
      currentCart.items = targetItems;
      renderTab('products');
      markPanelDirty();
    } else {
      quoteRenderTable();
    }
  } else {
    _commitTargetItem({
      id: p.id,
      name: p.name,
      price: p.price || 0,
      qty: 1,
      category: isSvc ? 'Tjänster' : '',
      type: isSvc ? 'service' : 'product',
    });
  }

  // Töm sökfältet och göm dropdown (samma element-ID i båda contexterna)
  const inpId = _configTarget === 'productsTab' ? 'prod-search' : 'qp-search';
  const inp = document.getElementById(inpId);
  if (inp) { inp.value = ''; inp.focus(); }
  resBox.style.display = 'none';
}

// ─────────────────────────────────────────────────────────────
// SCEN-KONFIGURATOR i admin
// Mini-version av DynamicPaketCard-logiken: räkna moduler från
// bredd × djup × yta, lägg till plattformar + trappor + tak.
// Matematik dubblerad från DynamicPaketCard.astro — håll synk vid
// prisändringar i scenes.json (priserna läses dynamiskt så det
// fungerar automatiskt; bara om regler ändras behövs synk).
// ─────────────────────────────────────────────────────────────
function _scenModuleCount(w, d, surface) {
  const area = w * d;
  return surface === '1x1-halkfri' ? area : Math.floor(area / 2);
}

function _scenSurfaceValid(w, d, surface) {
  if (surface === '1x1-halkfri') return w * d <= 20;
  return (w % 2 === 0) || (d % 2 === 0);
}

function _scenSurfaceKey(m) {
  const sizeKey = (m.size || '').replace(/\s*m\b/i, '').replace(/\s/g, '').replace(/×/g, 'x');
  const surf = m.surface === 'slät' ? 'slat' : 'halkfri';
  return `${sizeKey}-${surf}`;
}

function adminScenConfigOpen() {
  const panel = document.getElementById('admin-scen-config');
  if (!panel) return;
  // Init ytor-dropdown från scenConfig.modules (dynamisk)
  const cfg = window.__ADMIN_SCEN_CONFIG__ || {};
  const sel = document.getElementById('scen-cfg-yta');
  sel.innerHTML = (cfg.modules || []).map(m => {
    const key = _scenSurfaceKey(m);
    return `<option value="${key}" data-artno="${m.artno}" data-price="${m.price}" data-name="${m.name.replace(/"/g,'&quot;')}">${m.name} — ${m.price} kr/dygn</option>`;
  }).join('');
  // Pre-select 1x2-slät om det finns
  const slatOpt = Array.from(sel.options).find(o => o.value === '1x2-slat');
  if (slatOpt) slatOpt.selected = true;
  // Init tak-dropdown
  const takSel = document.getElementById('scen-cfg-tak');
  takSel.innerHTML = '<option value="">— Inget tak —</option>' +
    (cfg.tak || []).map(t => `<option value="${t.artno}" data-price="${t.price}" data-name="${t.name.replace(/"/g,'&quot;')}">${t.name} — ${(t.price||0).toLocaleString('sv')} kr/dygn</option>`).join('');
  panel.style.display = 'block';
  document.getElementById('admin-led-config').style.display = 'none';
  const fc = document.getElementById('admin-frakt-config'); if (fc) fc.style.display = 'none';
  const mc = document.getElementById('admin-montering-config'); if (mc) mc.style.display = 'none';
  adminScenConfigUpdate();
}

function adminScenConfigClose() {
  document.getElementById('admin-scen-config').style.display = 'none';
  _showConfigBackdrop(false);
}

function adminScenConfigUpdate() {
  const w = parseInt(document.getElementById('scen-cfg-w').value) || 0;
  const d = parseInt(document.getElementById('scen-cfg-d').value) || 0;
  const surface = document.getElementById('scen-cfg-yta').value;
  const trapp = parseInt(document.getElementById('scen-cfg-trapp').value) || 0;
  const preview = document.getElementById('scen-cfg-preview');
  const warn = document.getElementById('scen-cfg-warn');
  const btn = document.getElementById('scen-cfg-add-btn');

  const cfg = window.__ADMIN_SCEN_CONFIG__ || {};
  const modOpt = document.getElementById('scen-cfg-yta').options[document.getElementById('scen-cfg-yta').selectedIndex];
  const modPrice = parseFloat(modOpt?.dataset.price) || 0;
  const modName  = modOpt?.dataset.name || '';

  // Validering
  let warning = '';
  if (w < 2 || w > 12 || d < 2 || d > 8) {
    warning = 'Mått utanför tillåtet intervall (min 2 m, max 12×8 m).';
  } else if (!_scenSurfaceValid(w, d, surface)) {
    warning = surface === '1x1-halkfri'
      ? `1×1-yta stöder max 20 m² (du valt ${w * d} m²). Välj 1×2-yta eller minska måtten.`
      : '1×2-yta kräver att bredd eller djup är jämn (eller välj 1×1).';
  }
  warn.textContent = warning;
  warn.style.display = warning ? 'block' : 'none';
  btn.disabled = !!warning;

  if (warning) {
    preview.innerHTML = `<span style="color:rgba(255,255,255,0.5)">—</span>`;
    return;
  }

  // Räkna ut rader
  const mc = _scenModuleCount(w, d, surface);
  const area = w * d;
  let modSubtotal = mc * modPrice;
  let trappSubtotal = 0;
  let takSubtotal = 0;
  const lines = [];

  lines.push(`<div style="font-size:0.82rem;color:rgba(196,181,244,0.95);font-weight:700;margin-bottom:0.35rem">📐 ${w} × ${d} m = ${area} m²</div>`);
  lines.push(`${mc} × ${modName} (${(modPrice||0).toLocaleString('sv')} kr) = <strong style="color:#c4b5f4">${(modSubtotal||0).toLocaleString('sv')} kr</strong>`);

  if (trapp > 0) {
    const height = parseInt(document.getElementById('scen-cfg-h').value) || 40;
    const trappRow = (cfg.trappor || []).find(t => t.height === height);
    if (trappRow) {
      trappSubtotal = trapp * trappRow.price;
      lines.push(`${trapp} × ${trappRow.name} (${trappRow.price.toLocaleString('sv')} kr) = <strong style="color:#c4b5f4">${trappSubtotal.toLocaleString('sv')} kr</strong>`);
    }
  }

  const takVal = document.getElementById('scen-cfg-tak').value;
  if (takVal) {
    const takOpt = document.getElementById('scen-cfg-tak').options[document.getElementById('scen-cfg-tak').selectedIndex];
    takSubtotal = parseFloat(takOpt.dataset.price) || 0;
    lines.push(`1 × ${takOpt.dataset.name} = <strong style="color:#c4b5f4">${takSubtotal.toLocaleString('sv')} kr</strong>`);
  }

  const total = modSubtotal + trappSubtotal + takSubtotal;
  lines.push(`<div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid rgba(255,255,255,0.1)"><strong style="color:white">Totalt: ${(total||0).toLocaleString('sv')} kr/dygn</strong> <span style="color:rgba(255,255,255,0.5);font-size:0.7rem">exkl. transport/montering</span></div>`);
  preview.innerHTML = lines.join('<br>');
}

function adminScenConfigAdd() {
  const w = parseInt(document.getElementById('scen-cfg-w').value) || 0;
  const d = parseInt(document.getElementById('scen-cfg-d').value) || 0;
  const surface = document.getElementById('scen-cfg-yta').value;
  const trapp = parseInt(document.getElementById('scen-cfg-trapp').value) || 0;
  const height = parseInt(document.getElementById('scen-cfg-h').value) || 40;
  const takVal = document.getElementById('scen-cfg-tak').value;

  if (!_scenSurfaceValid(w, d, surface)) return;
  const mc = _scenModuleCount(w, d, surface);
  if (mc < 1) return;

  const cfg = window.__ADMIN_SCEN_CONFIG__ || {};
  const modOpt = document.getElementById('scen-cfg-yta').options[document.getElementById('scen-cfg-yta').selectedIndex];
  const modPrice = parseFloat(modOpt?.dataset.price) || 0;
  const modArtno = modOpt?.dataset.artno || '';
  const modName  = modOpt?.dataset.name || '';

  const prefix = `[Scen ${w}×${d}·${height}cm]`;

  // 1) Plattforms-rad
  _commitTargetItem({
    id:    modArtno,
    name:  `${prefix} ${modName}`,
    price: modPrice,
    qty:   mc,
    category: 'Scen',
    type: 'product',
  });

  // 2) Trapp-rad (om antal > 0)
  if (trapp > 0) {
    const trappRow = (cfg.trappor || []).find(t => t.height === height);
    if (trappRow) {
      _commitTargetItem({
        id:    trappRow.artno,
        name:  `${prefix} ${trappRow.name}`,
        price: trappRow.price,
        qty:   trapp,
        category: 'Scen',
        type: 'product',
      });
    }
  }

  // 3) Tak-rad (om vald)
  if (takVal) {
    const takOpt = document.getElementById('scen-cfg-tak').options[document.getElementById('scen-cfg-tak').selectedIndex];
    _commitTargetItem({
      id:    takVal,
      name:  `${prefix} ${takOpt.dataset.name}`,
      price: parseFloat(takOpt.dataset.price) || 0,
      qty:   1,
      category: 'Scen',
      type: 'product',
    });
  }

  _targetRender();
  adminScenConfigClose();
  toast?.(`✓ Lade till ${trapp > 0 ? '2–3' : '1–2'} rader (Scen ${w}×${d}·${height}cm)`);
}

// ─────────────────────────────────────────────────────────────
// LED-VÄGG-KONFIGURATOR i admin
// Räknar paneler, processor (auto-välj från pixels), upphängning.
// Matematik dubblerad från hyra-bild-led-vagg/index.astro.
// ─────────────────────────────────────────────────────────────
function adminLedConfigOpen() {
  const panel = document.getElementById('admin-led-config');
  if (!panel) return;
  const cfg = window.__ADMIN_LED_CONFIG__ || {};
  const sel = document.getElementById('led-cfg-panel');
  sel.innerHTML = (cfg.paneler || []).map(p =>
    `<option value="${p.artno}" data-name="${p.name.replace(/"/g,'&quot;')}" data-price="${p.price_per_day_excl}" data-w-mm="${p.panel_w_mm}" data-h-mm="${p.panel_h_mm}" data-px-w="${p.pixels_w || 0}" data-px-h="${p.pixels_h || 0}">${p.name} (${p.panel_w_mm}×${p.panel_h_mm} mm) — ${p.price_per_day_excl} kr/dygn</option>`
  ).join('');
  panel.style.display = 'block';
  document.getElementById('admin-scen-config').style.display = 'none';
  const fc = document.getElementById('admin-frakt-config'); if (fc) fc.style.display = 'none';
  const mc = document.getElementById('admin-montering-config'); if (mc) mc.style.display = 'none';
  adminLedConfigUpdate();
}

function adminLedConfigClose() {
  document.getElementById('admin-led-config').style.display = 'none';
  _showConfigBackdrop(false);
}

function adminLedConfigUpdate() {
  const cols = parseInt(document.getElementById('led-cfg-cols').value) || 0;
  const rows = parseInt(document.getElementById('led-cfg-rows').value) || 0;
  const mount = document.getElementById('led-cfg-mount').value;
  const cfg = window.__ADMIN_LED_CONFIG__ || {};
  const panelOpt = document.getElementById('led-cfg-panel').options[document.getElementById('led-cfg-panel').selectedIndex];
  const panelPrice = parseFloat(panelOpt?.dataset.price) || 0;
  const panelName  = panelOpt?.dataset.name || '';
  const panelPxW   = parseInt(panelOpt?.dataset.pxW) || 0;
  const panelPxH   = parseInt(panelOpt?.dataset.pxH) || 0;
  const panelWmm   = parseInt(panelOpt?.dataset.wMm) || 0;
  const panelHmm   = parseInt(panelOpt?.dataset.hMm) || 0;

  const preview = document.getElementById('led-cfg-preview');
  if (!cols || !rows) {
    preview.innerHTML = `<span style="color:rgba(255,255,255,0.5)">Ange kolumner och rader</span>`;
    return;
  }

  const totalPanels = cols * rows;
  const panelSubtotal = totalPanels * panelPrice;
  const actualW_mm = cols * panelWmm;
  const actualH_mm = rows * panelHmm;
  const totalPixels = totalPanels * panelPxW * panelPxH;

  // Processor: liten eller stor beroende på pixels
  const psmall = cfg.tillbehor?.processor_small;
  const plarge = cfg.tillbehor?.processor_large;
  const proc = (totalPixels <= (psmall?.max_pixels || 2600000)) ? psmall : plarge;
  const procPrice = proc?.price_per_day_excl || 0;

  // Mount
  const mountRow = mount === 'tross' ? cfg.tillbehor?.tross : cfg.tillbehor?.rigg;
  const mountPrice = (mountRow?.price_per_column || 0) * cols;

  const total = panelSubtotal + procPrice + mountPrice;
  const dimStr = `${(actualW_mm/1000).toFixed(2).replace(/\.?0+$/,'')}×${(actualH_mm/1000).toFixed(2).replace(/\.?0+$/,'')} m`;
  const m2 = ((actualW_mm * actualH_mm) / 1000000).toFixed(2).replace(/\.?0+$/,'');

  preview.innerHTML = `
    <div style="font-size:0.82rem;color:rgba(196,181,244,0.95);font-weight:700;margin-bottom:0.35rem">📐 ${dimStr} = ${m2} m² · ${(totalPixels/1e6).toFixed(2)} Mpx</div>
    <div>${totalPanels} × ${panelName} = <strong style="color:#c4b5f4">${(panelSubtotal||0).toLocaleString('sv')} kr</strong></div>
    <div>1 × ${proc?.name || 'Processor'} = <strong style="color:#c4b5f4">${procPrice.toLocaleString('sv')} kr</strong></div>
    <div>1 × ${mountRow?.name || ''} (${cols} kolumner) = <strong style="color:#c4b5f4">${mountPrice.toLocaleString('sv')} kr</strong></div>
    <div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid rgba(255,255,255,0.1)"><strong style="color:white">Totalt: ${(total||0).toLocaleString('sv')} kr/dygn</strong> <span style="color:rgba(255,255,255,0.5);font-size:0.7rem">exkl. transport/montering</span></div>
  `;
}

function adminLedConfigAdd() {
  const cols = parseInt(document.getElementById('led-cfg-cols').value) || 0;
  const rows = parseInt(document.getElementById('led-cfg-rows').value) || 0;
  const mount = document.getElementById('led-cfg-mount').value;
  const cfg = window.__ADMIN_LED_CONFIG__ || {};
  const panelOpt = document.getElementById('led-cfg-panel').options[document.getElementById('led-cfg-panel').selectedIndex];
  if (!cols || !rows || !panelOpt) return;

  const panelArtno = panelOpt.value;
  const panelPrice = parseFloat(panelOpt.dataset.price) || 0;
  const panelName  = panelOpt.dataset.name || '';
  const panelPxW   = parseInt(panelOpt.dataset.pxW) || 0;
  const panelPxH   = parseInt(panelOpt.dataset.pxH) || 0;
  const totalPanels = cols * rows;
  const totalPixels = totalPanels * panelPxW * panelPxH;
  const actualW_mm = cols * (parseInt(panelOpt.dataset.wMm) || 0);
  const actualH_mm = rows * (parseInt(panelOpt.dataset.hMm) || 0);
  const dimStr = `${(actualW_mm/1000).toFixed(2).replace(/\.?0+$/,'')}×${(actualH_mm/1000).toFixed(2).replace(/\.?0+$/,'')} m`;

  // 1) Panel-rad
  _commitTargetItem({
    id:    panelArtno + '__' + cols + 'x' + rows,
    name:  `${panelName} — ${cols}×${rows} = ${totalPanels} st · ${dimStr}`,
    price: panelPrice,
    qty:   totalPanels,
    category: 'LED-vägg',
    type: 'product',
  });

  // 2) Processor
  const psmall = cfg.tillbehor?.processor_small;
  const plarge = cfg.tillbehor?.processor_large;
  const proc = (totalPixels <= (psmall?.max_pixels || 2600000)) ? psmall : plarge;
  if (proc) {
    _commitTargetItem({
      id:    proc.artno,
      name:  proc.name,
      price: proc.price_per_day_excl,
      qty:   1,
      category: 'LED-vägg',
      type: 'product',
    });
  }

  // 3) Mount (ground/tross)
  const mountRow = mount === 'tross' ? cfg.tillbehor?.tross : cfg.tillbehor?.rigg;
  if (mountRow) {
    _commitTargetItem({
      id:    mountRow.artno + '__' + cols + 'kol',
      name:  `${mountRow.name} (${cols} kolumner)`,
      price: (mountRow.price_per_column || 0) * cols,
      qty:   1,
      category: 'LED-vägg',
      type: 'product',
    });
  }

  _targetRender();
  adminLedConfigClose();
  toast?.(`✓ Lade till 3 rader (LED-vägg ${cols}×${rows})`);
}

// ─────────────────────────────────────────────────────────────
// FRAKT-KONFIGURATOR i admin
// Läser leverans-alternativ från tjanster.json. Föreslår fordon
// baserat på selection_rules (samma logik som kund-cart, fast utan
// bulkyCount eftersom admin manuellt väljer).
// ─────────────────────────────────────────────────────────────
function _fraktAnalyzeQuote() {
  // Analysera target-items för att föreslå fraktalternativ. Räkna:
  //  - antal scen-rader (SK-SCN-*)
  //  - antal LED-paneler (qty från SK-BLD-LED-P*)
  //  - om någon rad är ett 'Concert', 'Line Array' (line array kräver lastbil)
  //  - bulkyCount-uppskattning
  const items = _configTarget === 'productsTab'
    ? ((typeof prodGetItems === 'function') ? prodGetItems() : (currentCart.items || []))
    : quoteItems;
  let scenRows = 0, ledPanels = 0, hasLineArray = false, hasTak = false;
  for (const it of items) {
    const id = (it.id || it.artno || '').toUpperCase();
    const name = (it.name || '').toUpperCase();
    if (id.startsWith('SK-SCN-MOD') || id.startsWith('SK-SCN-0')) scenRows++;
    if (id.startsWith('SK-SCN-TAK') || name.includes('SCENTAK')) hasTak = true;
    if (id.startsWith('SK-BLD-LED-P')) ledPanels += (it.qty || 1);
    if (name.includes('LINE ARRAY') || name.includes('CONCERT')) hasLineArray = true;
  }
  return { scenRows, ledPanels, hasLineArray, hasTak };
}

function _fraktRecommendKey(analysis) {
  // Heuristik baserat på selection_rules-anda:
  //  - LED-paneler eller tak eller line array → lastbil
  //  - 2+ scen-rader eller skrymmande gods → storbil_slap
  //  - 1 scen-rad → skrymmande
  //  - inget bulky → standard
  if (analysis.hasLineArray || analysis.hasTak || analysis.ledPanels > 0) return 'lastbil';
  if (analysis.scenRows >= 2) return 'storbil_slap';
  if (analysis.scenRows >= 1) return 'skrymmande';
  return 'standard';
}

function adminFraktConfigOpen() {
  const panel = document.getElementById('admin-frakt-config');
  if (!panel) return;
  // Stäng andra paneler
  document.getElementById('admin-scen-config').style.display = 'none';
  document.getElementById('admin-led-config').style.display = 'none';
  document.getElementById('admin-montering-config').style.display = 'none';

  const cfg = window.__ADMIN_FRAKT_CONFIG__ || {};
  const lev = cfg.leverans || {};
  // Bygg dropdown från alla giltiga leveransalternativ (utöver _comment etc.)
  const opts = [];
  for (const [key, item] of Object.entries(lev)) {
    if (!item || typeof item !== 'object' || !item.artno) continue;
    opts.push({ key, artno: item.artno, label: item.label || key, pris: item.pris || 0, enkel: item.enkel });
  }

  // Rekommendation
  const analysis = _fraktAnalyzeQuote();
  const recKey = _fraktRecommendKey(analysis);
  const recItem = opts.find(o => o.key === recKey);
  const recEl = document.getElementById('frakt-cfg-rec');
  if (recItem) {
    const parts = [];
    if (analysis.scenRows > 0) parts.push(`${analysis.scenRows} scen-rad${analysis.scenRows > 1 ? 'er' : ''}`);
    if (analysis.ledPanels > 0) parts.push(`${analysis.ledPanels} LED-paneler`);
    if (analysis.hasTak) parts.push('tak');
    if (analysis.hasLineArray) parts.push('Line Array');
    const basis = parts.length ? parts.join(', ') : 'inga skrymmande produkter';
    recEl.innerHTML = `💡 <strong>Förslag baserat på offert (${basis}):</strong> ${recItem.label} — ${recItem.pris.toLocaleString('sv')} kr`;
  } else {
    recEl.innerHTML = `💡 Välj leveranstyp manuellt nedan.`;
  }

  // Bygg select
  const sel = document.getElementById('frakt-cfg-type');
  sel.innerHTML = opts.map(o =>
    `<option value="${o.key}" data-artno="${o.artno}" data-label="${o.label.replace(/"/g,'&quot;')}" data-pris="${o.pris}" data-enkel-artno="${o.enkel?.artno || ''}" data-enkel-label="${(o.enkel?.label || '').replace(/"/g,'&quot;')}" data-enkel-pris="${o.enkel?.pris || ''}" ${o.key === recKey ? 'selected' : ''}>${o.label} — ${o.pris.toLocaleString('sv')} kr</option>`
  ).join('');

  panel.style.display = 'block';
  _showConfigBackdrop(true);
  adminFraktConfigUpdate();
}

function adminFraktConfigClose() {
  document.getElementById('admin-frakt-config').style.display = 'none';
  _showConfigBackdrop(false);
}

function adminFraktConfigUpdate() {
  const sel = document.getElementById('frakt-cfg-type');
  const trip = document.getElementById('frakt-cfg-trip').value;
  const opt  = sel.options[sel.selectedIndex];
  if (!opt) return;
  const priceField = document.getElementById('frakt-cfg-price');
  // Sätt pris baserat på vald typ + enkel/retur
  if (trip === 'enkel' && opt.dataset.enkelPris) {
    priceField.value = opt.dataset.enkelPris;
  } else {
    priceField.value = opt.dataset.pris || 0;
  }
}

function adminFraktConfigAdd() {
  const sel = document.getElementById('frakt-cfg-type');
  const trip = document.getElementById('frakt-cfg-trip').value;
  const opt  = sel.options[sel.selectedIndex];
  if (!opt) return;
  const priceField = document.getElementById('frakt-cfg-price');
  const price = parseInt(priceField.value) || 0;

  // Använd enkel-artno om trip='enkel' och det finns
  const useEnkel = trip === 'enkel' && opt.dataset.enkelArtno;
  const artno = useEnkel ? opt.dataset.enkelArtno : opt.dataset.artno;
  const label = useEnkel ? opt.dataset.enkelLabel : opt.dataset.label;

  _commitTargetItem({
    id:    artno,
    name:  label,
    price: price,
    qty:   1,
    category: 'Leverans',
    type: 'service',
  });
  adminFraktConfigClose();
  toast?.(`✓ Lade till frakt-rad: ${label}`);
}

// ─────────────────────────────────────────────────────────────
// MONTERING-KONFIGURATOR i admin
// 600 kr/tim, minimum 15 min, kan multiplicieras med antal personer.
// Demontering räknas normalt 2× monteringstiden i kund-cart men i
// admin specar admin direkt totaltiden (montering + demontering).
// ─────────────────────────────────────────────────────────────
function adminMonteringConfigOpen() {
  const panel = document.getElementById('admin-montering-config');
  if (!panel) return;
  document.getElementById('admin-scen-config').style.display = 'none';
  document.getElementById('admin-led-config').style.display = 'none';
  document.getElementById('admin-frakt-config').style.display = 'none';

  const cfg = window.__ADMIN_MONTERING_CONFIG__ || {};
  const ruleEl = document.getElementById('mon-cfg-rule');
  ruleEl.innerHTML = `💡 <strong>Regel:</strong> ${cfg.prisPerTimme || 600} kr/tim, minimum ${cfg.minDebiteringMin || 15} min. Total tid = montering + demontering.`;

  panel.style.display = 'block';
  _showConfigBackdrop(true);
  adminMonteringConfigUpdate();
}

function adminMonteringConfigClose() {
  document.getElementById('admin-montering-config').style.display = 'none';
  _showConfigBackdrop(false);
}

function adminMonteringConfigUpdate() {
  const cfg = window.__ADMIN_MONTERING_CONFIG__ || {};
  const hours = parseFloat(document.getElementById('mon-cfg-hours').value) || 0;
  const pers = parseInt(document.getElementById('mon-cfg-pers').value) || 1;
  const prisPerTim = cfg.prisPerTimme || 600;

  const preview = document.getElementById('mon-cfg-preview');
  if (hours <= 0) {
    preview.innerHTML = `<span style="color:rgba(255,255,255,0.5)">Ange antal timmar</span>`;
    return;
  }

  const totalHours = hours * pers;
  const totalPris = Math.round(totalHours * prisPerTim);
  preview.innerHTML = `
    <div>${pers} pers × ${hours} tim × ${prisPerTim} kr/tim</div>
    <div style="margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid rgba(255,255,255,0.1)"><strong style="color:white">Totalt: ${totalPris.toLocaleString('sv')} kr</strong> (${totalHours} debiterade timmar)</div>
  `;
}

function adminMonteringConfigAdd() {
  const cfg = window.__ADMIN_MONTERING_CONFIG__ || {};
  const hours = parseFloat(document.getElementById('mon-cfg-hours').value) || 0;
  const pers = parseInt(document.getElementById('mon-cfg-pers').value) || 1;
  const prisPerTim = cfg.prisPerTimme || 600;
  if (hours <= 0) return;

  const totalHours = hours * pers;
  const totalPris = Math.round(totalHours * prisPerTim);
  const labelExtra = pers > 1 ? ` (${pers} pers × ${hours} tim)` : ` (${hours} tim)`;

  _commitTargetItem({
    id:    cfg.artno || 'SK-TJN-0001',
    name:  (cfg.name || 'Montering & demontering') + labelExtra,
    price: totalPris,
    qty:   1,
    category: 'Tjänster',
    type: 'service',
  });
  adminMonteringConfigClose();
  toast?.(`✓ Lade till monterings-rad: ${totalPris.toLocaleString('sv')} kr`);
}

