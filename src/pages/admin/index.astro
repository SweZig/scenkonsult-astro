  $('qc-email').value    = prefill?.customer_email || '';
  $('qc-phone').value    = prefill?.customer_phone || '';
  if ($('qc-cc')) $('qc-cc').value = prefill?.cc_email || '';
  $('qc-date').value     = prefill?.event_date || '';
  if ($('qc-date-to'))   $('qc-date-to').value   = prefill?.return_date   || '';
  if ($('qc-time-from')) $('qc-time-from').value = prefill?.delivery_time || '13:00';
  if ($('qc-time-to'))   $('qc-time-to').value   = prefill?.return_time   || '11:00';
  $('qc-location').value = prefill?.event_location || '';
  $('qc-company').value  = prefill?.customer_company || '';
  if ($('qc-orgnr')) $('qc-orgnr').value = prefill?.customer_orgnr || '';
  // Show/hide orgnr based on company
  const b2bFlds = document.getElementById('qc-b2b-fields');
  const b2bPh   = document.getElementById('qc-b2b-placeholder');
  const hasCompany = !!(prefill?.customer_company);
  if (b2bFlds) b2bFlds.style.display = hasCompany ? 'grid' : 'none';
  if (b2bPh)  b2bPh.style.display   = hasCompany ? 'none' : '';
  $('qc-note').value     = '';
  $('quote-error').style.display = 'none';
  $('quote-send-btn').disabled = false;
  $('quote-send-btn').textContent = '✉ Skicka offert';

  // Pre-fill items from existing cart
  const SVC_IDS_PREFILL = new Set(['lev-standard','lev-skrymmande','lev-lastbil','lev-bakgavel','montering','rigg-teknik','fakturaavgift-49']);
  if (prefill?.items?.length) {
    prefill.items.filter(i => !i._note).forEach(i => {
      const cat = i.category || (SVC_IDS_PREFILL.has(i.id) ? 'Tjänster' : '');
      quoteItems.push({ id: i.id||'', name: i.name, price: i.price||0, qty: i.qty||1, category: cat });
    });
    const note = prefill.items.find(i => i._note);
    if (note) $('qc-note').value = note.name;
  }

  // Init picker
  const catSel = $('qp-cat');
  catSel.innerHTML = '<option value="">— välj kategori —</option>' +
    Object.keys(QUOTE_CATALOG).map(k => `<option value="${k}">${k}</option>`).join('');
  $('qp-sub-wrap').style.display = 'none';
  $('qp-prod').innerHTML = '<option value="">— välj kategori —</option>';

  quoteRenderTable();
  $('quote-overlay').classList.add('open');
  $('qc-name').focus();
}

function openQuoteModalForCart(cart) {
  openQuoteModal(cart);
}

function closeQuoteModal() {
  $('quote-overlay').classList.remove('open');
}

function quotePickerCat() {
  const cat = $('qp-cat').value;
  const entry = QUOTE_CATALOG[cat];
  const subWrap = $('qp-sub-wrap');
  const prodSel = $('qp-prod');

  if (!entry) {
    subWrap.style.display = 'none';
    prodSel.innerHTML = '<option value="">— välj kategori —</option>';
    return;
  }

  if (entry.sub) {
    // Has sub-categories
    const subSel = $('qp-sub');
    subSel.innerHTML = '<option value="">— välj underkategori —</option>' +
      Object.keys(entry.sub).map(k => `<option value="${k}">${k}</option>`).join('');
    subWrap.style.display = '';
    prodSel.innerHTML = '<option value="">— välj underkategori —</option>';
  } else {
    subWrap.style.display = 'none';
    quotePopulateProducts(entry.products);
  }
}

function quotePickerSub() {
  const cat = $('qp-cat').value;
  const sub = $('qp-sub').value;
  const entry = QUOTE_CATALOG[cat];
  if (!entry?.sub || !sub) return;
  quotePopulateProducts(entry.sub[sub] || []);
}

function quotePopulateProducts(prods) {
  const prodSel = $('qp-prod');
  prodSel.innerHTML = '<option value="">— välj produkt —</option>' +
    prods.map(p => {
      const label = p.custom ? '✏ Skriv in benämning och pris själv' : `${p.name} — ${p.price.toLocaleString('sv')} kr`;
      return `<option value="${p.id}" data-price="${p.price}" data-name="${p.name.replace(/"/g,'&quot;')}" data-custom="${p.custom||false}">${label}</option>`;
    }).join('');
}

function quoteAddCustomRow() {
  quoteItems.push({ id: 'custom-' + Date.now(), name: '', price: 0, qty: 1, custom: true });
  quoteRenderTable();
  setTimeout(() => {
    const inputs = document.querySelectorAll('.quote-custom-name');
    if (inputs.length) inputs[inputs.length - 1].focus();
  }, 50);
}

function quotePickerAdd() {
  const prodSel = $('qp-prod');
  const opt = prodSel.options[prodSel.selectedIndex];
  if (!opt || !opt.value) return;

  const isCustom = opt.dataset.custom === 'true';

  if (isCustom) {
    // Lägg till en tom custom-rad direkt i tabellen
    quoteItems.push({ id: 'custom-' + Date.now(), name: '', price: 0, qty: 1, custom: true });
    quoteRenderTable();
    // Fokusera på namnfältet i den nya raden
    setTimeout(() => {
      const inputs = document.querySelectorAll('.quote-custom-name');
      if (inputs.length) inputs[inputs.length - 1].focus();
    }, 50);
    return;
  }

  const name     = opt.dataset.name || opt.textContent.split(' — ')[0];
  const price    = parseInt(opt.dataset.price) || 0;
  const id       = opt.value;
  const selCat   = $('qp-cat')?.value || '';
  const SVC_IDS = new Set(['lev-standard','lev-skrymmande','lev-lastbil','lev-bakgavel','montering','rigg-teknik','fakturaavgift-49']);
  const isSvc    = SVC_CATALOG_KEYS.includes(selCat) || SVC_IDS.has(id);

  // Om samma produkt redan finns, öka antal
  const existing = quoteItems.find(i => i.id === id && !i.custom);
  if (existing) { existing.qty++; }
  else {
    const newItem = { id, name, price, qty: 1, category: isSvc ? 'Tjänster' : '', type: isSvc ? 'service' : 'product' };
    if (isSvc) {
      quoteItems.push(newItem); // tjänster alltid sist
    } else {
      // Produkter insertas före första tjänst
      const svcStart = quoteItems.findIndex(i => SVC_CATALOG_KEYS.includes(i._cat || '') || 
        ['lev-standard','lev-skrymmande','lev-lastbil','lev-bakgavel','montering','rigg-teknik','faktura'].some(s => i.id === s));
      if (svcStart === -1) quoteItems.push(newItem);
      else quoteItems.splice(svcStart, 0, newItem);
    }
  }

  quoteRenderTable();
  prodSel.selectedIndex = 0;
}

function quoteRenderTable() {
  const tbody = $('quote-prod-tbody');
  const tfoot = $('quote-prod-tfoot');
  if (!tbody) return;
  tbody.innerHTML = quoteItems.map((item, idx) => {
    const nameCell = item.custom
      ? `<input class="prod-input quote-custom-name" value="${item.name.replace(/"/g,'&quot;')}" placeholder="Ange benämning..." onchange="quoteEditName(${idx},this.value)"
           style="width:100%;font-size:0.82rem;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border-radius:5px;border:1px solid rgba(196,181,244,0.3);padding:0.2rem 0.5rem;">`
      : `<span style="font-size:0.82rem">${item.name}</span>`;
    return `
    <tr data-qidx="${idx}" draggable="true"
        ondragstart="quoteDragStart(event,${idx})" ondragover="quoteDragOver(event)"
        ondrop="quoteDrop(event,${idx})" ondragend="quoteDragEnd(event)"
        style="cursor:default">
      <td style="width:18px;padding:0 2px 0 0.5rem;cursor:grab;color:rgba(196,181,244,0.4);font-size:1rem;text-align:center;user-select:none" title="Drag för att ändra ordning">⠿</td>
      <td>${nameCell}</td>
      <td style="text-align:center">
        <div style="display:flex;align-items:center;justify-content:center;gap:3px">
          <button class="qty-btn" onclick="quoteQtyIdx(${idx},-1)" style="width:22px;height:22px;font-size:0.9rem">−</button>
          <span style="min-width:24px;text-align:center;font-size:0.82rem">${item.qty}</span>
          <button class="qty-btn" onclick="quoteQtyIdx(${idx},1)" style="width:22px;height:22px;font-size:0.9rem">＋</button>
        </div>
      </td>
      <td style="text-align:right">
        <input class="prod-input" value="${item.price}" onchange="quoteEditPrice(${idx},this.value)"
          style="width:80px;text-align:right;font-size:0.82rem;background:#0f0d2a!important;color:#f0eeff!important;color-scheme:dark;border-radius:5px;border:1px solid transparent;padding:0.2rem 0.4rem;">
      </td>
      <td style="text-align:right;font-size:0.82rem;font-weight:600;color:var(--brand-lav);white-space:nowrap">${fmt(item.price * item.qty)} kr</td>
      <td><button class="qty-btn" style="color:var(--red);border-color:var(--red);width:22px;height:22px" onclick="quoteDelIdx(${idx})">×</button></td>
    </tr>`;
  }).join('');

  const total = quoteItems.reduce((s,i) => s + i.price * i.qty, 0);
  tfoot.innerHTML = quoteItems.length
    ? `<tr><td colspan="3" style="font-weight:700;padding-top:0.5rem;font-size:0.82rem">Totalt (exkl. moms)</td>
       <td style="text-align:right;font-weight:700;color:var(--brand-lav);font-size:0.82rem">${fmt(total)} kr</td><td></td></tr>
       <tr><td colspan="3" style="color:var(--text-faint);font-size:0.72rem">Inkl. 25% moms</td>
       <td style="text-align:right;color:var(--text-muted);font-size:0.72rem">${fmt(Math.round(total*1.25))} kr</td><td></td></tr>`
    : '';
}

function quoteQtyIdx(idx, delta) {
  if (!quoteItems[idx]) return;
  quoteItems[idx].qty = Math.max(1, quoteItems[idx].qty + delta);
  quoteRenderTable();
}

function quoteEditName(idx, val) {
  if (!quoteItems[idx]) return;
  quoteItems[idx].name = val;
}

function quoteEditPrice(idx, val) {
  if (!quoteItems[idx]) return;
  quoteItems[idx].price = parseFloat(val) || 0;
  quoteRenderTable();
}

function quoteDelIdx(idx) {
  quoteItems.splice(idx, 1);
  quoteRenderTable();
}

// ── Drag-and-drop för quote-tabellen ─────────────────────────
let _quoteDragSrc = null;

function quoteDragStart(e, idx) {
  _quoteDragSrc = idx;
  e.dataTransfer.effectAllowed = 'move';
  e.currentTarget.style.opacity = '0.4';
}

function quoteDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  document.querySelectorAll('#quote-prod-tbody tr').forEach(r => r.style.borderTop = '');
  e.currentTarget.style.borderTop = '2px solid var(--brand-lav)';
}

function quoteDrop(e, dropIdx) {
  e.preventDefault();
  if (_quoteDragSrc === null || _quoteDragSrc === dropIdx) return;
  const dragged = quoteItems[_quoteDragSrc];
  quoteItems.splice(_quoteDragSrc, 1);
  const newPos = _quoteDragSrc < dropIdx ? dropIdx - 1 : dropIdx;
  quoteItems.splice(newPos, 0, dragged);
  quoteRenderTable();
}

function quoteDragEnd(e) {
  _quoteDragSrc = null;
  e.currentTarget.style.opacity = '';
  document.querySelectorAll('#quote-prod-tbody tr').forEach(r => r.style.borderTop = '');
}

window.quoteDragStart = quoteDragStart;
window.quoteDragOver  = quoteDragOver;
window.quoteDrop      = quoteDrop;
window.quoteDragEnd   = quoteDragEnd;

// ── PDF-BIFOGNING ─────────────────────────────────────────────
let _quotePdfData = null; // base64-sträng
let _quotePdfName = null;

function quotePdfSelected(input) {
  const file = input.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) {
    toast('PDF är för stor (max 5 MB)', 'error');
    input.value = '';
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    // Hämta ren base64 utan data:...-prefix
    _quotePdfData = e.target.result.split(',')[1];
    _quotePdfName = file.name;
    $('quote-pdf-label').textContent = `📎 ${file.name} (${Math.round(file.size/1024)} KB)`;
    $('quote-pdf-label').style.color = '#c4b5f4';
    $('quote-pdf-clear').style.display = 'block';
  };
  reader.readAsDataURL(file);
}

function quotePdfClear() {
  _quotePdfData = null; _quotePdfName = null;
  $('quote-pdf-input').value = '';
  $('quote-pdf-label').textContent = 'Bifoga PDF (valfritt — t.ex. skiss)';
  $('quote-pdf-label').style.color = '';
  $('quote-pdf-clear').style.display = 'none';
}

async function sendQuote() {
  const name  = $('qc-name').value.trim();
  const email = $('qc-email').value.trim();
  const errEl = $('quote-error');
  errEl.style.display = 'none';

  if (!name)  { errEl.textContent = 'Namn krävs.'; errEl.style.display = 'block'; $('qc-name').focus(); return; }
  if (!email || !email.includes('@')) { errEl.textContent = 'Giltig e-post krävs.'; errEl.style.display = 'block'; $('qc-email').focus(); return; }
  if (quoteItems.length === 0) { errEl.textContent = 'Lägg till minst en produkt.'; errEl.style.display = 'block'; return; }

  const btn = $('quote-send-btn');
  btn.disabled = true; btn.textContent = '⏳ Skickar…';

  const payload = {
    existing_cart_id: (!_quoteIsNewOrder && currentCart?.id) ? currentCart.id : null,
    customer: {
      name, email,
      phone:    $('qc-phone').value.trim()   || null,
      cc_email: $('qc-cc')?.value.trim()     || null,
      date:          $('qc-date').value           || null,
      return_date:   $('qc-date-to')?.value         || null,
      delivery_time: $('qc-time-from')?.value        || '13:00',
      return_time:   $('qc-time-to')?.value          || '11:00',
      location:      $('qc-location').value.trim()   || null,
      company:  $('qc-company')?.value.trim() || null,
      orgnr:    $('qc-orgnr')?.value.trim()   || null,
    },
    items: quoteItems,
    note: $('qc-note').value.trim() || null,
    pdf_attachment: _quotePdfData ? { content: _quotePdfData, filename: _quotePdfName } : null,
  };

  try {
    const { ok: success, data } = await api('admin-send-quote', { method: 'POST', body: JSON.stringify(payload) });
    if (success) {
      const sentNote = $('qc-note').value.trim();
      closeQuoteModal();
      quotePdfClear();
      toast(`Offert skickad till ${email}! 🎉`);
      // Sätt status → waiting så kunden ser bekräftelseknappen på /order/
      if (currentCart?.id && currentCart.status === 'new') {
        await api('cart-update', {
          method: 'POST',
          body: JSON.stringify({ cart_id: currentCart.id, status: 'waiting' })
        });
        currentCart.status = 'waiting';
      }
      await loadCarts();
      // Synka noten till prod-note om panelen är öppen
      if (sentNote && currentCart) {
        const noteEl = $('prod-note');
        if (noteEl) noteEl.value = sentNote;
      }
    } else {
      errEl.textContent = data?.error || 'Kunde inte skicka offert.';
      errEl.style.display = 'block';
      btn.disabled = false; btn.textContent = '✉ Skicka offert';
    }
  } catch (e) {
    errEl.textContent = 'Nätverksfel — försök igen.';
    errEl.style.display = 'block';
    btn.disabled = false; btn.textContent = '✉ Skicka offert';
  }
}

