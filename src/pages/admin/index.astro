const SVC_CATALOG_KEYS = ['Tjänster', 'Tillägg'];

function buildProductCatalogOptions() {
  let html = '<option value="">+ Välj produkt att lägga till</option>';
  Object.entries(QUOTE_CATALOG).forEach(([cat, data]) => {
    if (SVC_CATALOG_KEYS.includes(cat) || cat === 'Egen rad') return;
    if (data.products) {
      html += `<optgroup label="${cat}">`;
      data.products.forEach(p => {
        const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:cat,type:p.type||'product'}).replace(/"/g,'&quot;');
        html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
      });
      html += '</optgroup>';
    } else if (data.sub) {
      Object.entries(data.sub).forEach(([sub, prods]) => {
        html += `<optgroup label="${cat} — ${sub}">`;
        prods.forEach(p => {
          const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:`${cat} — ${sub}`,type:p.type||'product'}).replace(/"/g,'&quot;');
          html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
        });
        html += '</optgroup>';
      });
    }
  });
  return html;
}

function buildServiceCatalogOptions() {
  let html = '<option value="">+ Välj tjänst att lägga till</option>';
  Object.entries(QUOTE_CATALOG).forEach(([cat, data]) => {
    if (!SVC_CATALOG_KEYS.includes(cat)) return;
    if (data.products) {
      html += `<optgroup label="${cat}">`;
      data.products.forEach(p => {
        const v = JSON.stringify({id:p.id,name:p.name,price:p.price,category:'Tjänster',type:'service'}).replace(/"/g,'&quot;');
        html += `<option value="${v}">${p.name} — ${fmt(p.price)} kr</option>`;
      });
      html += '</optgroup>';
    }
  });
  return html;
}

// Legacy alias
function buildCatalogOptions() { return buildProductCatalogOptions(); }

// ── Produkter-fliken: kategori → produkt picker ──────────────────────────────
function buildProdCatOptions() {
  return Object.keys(QUOTE_CATALOG)
    .filter(k => k !== 'Tillägg' && k !== 'Egen rad')
    .map(k => `<option value="${k}">${k}</option>`)
    .join('');
}

function prodPickCat() {
  const cat = document.getElementById('prod-cat-sel')?.value;
  const entry = QUOTE_CATALOG[cat];
  const subWrap = document.getElementById('prod-sub-wrap');
  const itemWrap = document.getElementById('prod-item-wrap');
  if (!entry) { subWrap.style.display = 'none'; itemWrap.style.display = 'none'; return; }
  if (entry.sub) {
    const subSel = document.getElementById('prod-sub-sel');
    subSel.innerHTML = '<option value="">— välj underkategori —</option>' +
      Object.keys(entry.sub).map(k => `<option value="${k}">${k}</option>`).join('');
    subWrap.style.display = '';
    itemWrap.style.display = 'none';
  } else if (entry.products) {
    subWrap.style.display = 'none';
    prodPopulateItems(entry.products);
    itemWrap.style.display = 'flex';
    itemWrap.style.alignItems = 'center';
  }
}

function prodPickSub() {
  const cat = document.getElementById('prod-cat-sel')?.value;
  const sub = document.getElementById('prod-sub-sel')?.value;
  const itemWrap = document.getElementById('prod-item-wrap');
  if (!cat || !sub) { itemWrap.style.display = 'none'; return; }
  const prods = QUOTE_CATALOG[cat]?.sub?.[sub] || [];
  prodPopulateItems(prods);
  if (prods.length) { itemWrap.style.display = 'flex'; itemWrap.style.alignItems = 'center'; }
  else { itemWrap.style.display = 'none'; }
}

function prodPopulateItems(prods) {
  const sel = document.getElementById('prod-item-sel');
  sel.innerHTML = '<option value="">— välj produkt —</option>' +
    prods.map(p => `<option value="${p.id}" data-price="${p.price}" data-name="${p.name.replace(/"/g,'&quot;')}">${p.name} — ${fmt(p.price)} kr</option>`).join('');
}

function prodPickerAdd() {
  const sel = document.getElementById('prod-item-sel');
  const opt = sel?.options[sel.selectedIndex];
  if (!opt || !opt.value) return;
  const cat = document.getElementById('prod-cat-sel')?.value || '';
  const p = { id: opt.value, name: opt.dataset.name || opt.textContent.split(' — ')[0], price: parseInt(opt.dataset.price) || 0, qty: 1, category: cat };
  const items = prodGetItems();
  const existing = items.find(i => i.id === p.id && !i.custom);
  if (existing) { existing.qty++; }
  else {
    const svcStart = items.findIndex(i => ['Tjänster','Tillägg'].includes(i.category));
    items.splice(svcStart === -1 ? items.length : svcStart, 0, p);
  }
  currentCart.items = items;
  renderTab('products');
  sel.selectedIndex = 0;
}

function catIcon(category) {
  const c = (category||'').toLowerCase();
  if (c.includes('scen'))    return { icon: '🎪', color: 'var(--blue)' };
  if (c.includes('ljud'))    return { icon: '🔊', color: 'var(--green)' };
  if (c.includes('ljus'))    return { icon: '💡', color: 'var(--amber)' };
  if (c.includes('dj'))      return { icon: '🎧', color: 'var(--brand-lav)' };
  if (c.includes('bild'))    return { icon: '📽', color: 'var(--blue)' };
  if (c.includes('tjänst') || c.includes('leverans') || c.includes('montering')) return { icon: '🚚', color: 'var(--gray)' };
  return { icon: '📦', color: 'var(--gray)' };
}

function renderProductsTab() {
  const allItems = (currentCart.items || []);
  const noteItem = allItems.find(i => i._note);
  // Visa ALLA items i en flat tabell — produkter och tjänster ihop
  const items = allItems.filter(i => !i._note);
  const total = items.filter(i => i.name?.trim()).reduce((s,i) => s + ((i.price||0)*(i.qty||i.quantity||1)), 0);

  const SVC_CATS_DISPLAY = ['Tjänster', 'Tillägg'];
  const isSvcItem = i => i.type === 'service' || SVC_CATS_DISPLAY.includes(i.category);
  const firstSvcIdx = items.findIndex(i => isSvcItem(i));

  const rows = items.map((item, idx) => {
    const qty = item.qty || item.quantity || 1;
    const price = item.price || 0;
    const sub = qty * price;
    const {icon, color} = catIcon(item.category);
    const isSvc = isSvcItem(item);
    // Separator-rad före första tjänst
    const separator = (idx === firstSvcIdx && firstSvcIdx > 0)
      ? `<tr><td colspan="5" style="padding:4px 0 2px"><div style="border-top:1px dashed rgba(196,181,244,0.25);margin:2px 0"></div><div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:rgba(196,181,244,0.4);padding:2px 4px">Tjänster</div></td></tr>`
      : '';
    const pid = item.id || '';
    const desc = (typeof PROD_DESC !== 'undefined' && PROD_DESC[pid]) ? PROD_DESC[pid] : null;
    const popoutContent = desc
      ? `<div style="font-size:0.78rem;color:var(--text-muted);line-height:1.5;margin-top:4px">${desc.desc||''}</div>${desc.includes?.length ? '<ul style="font-size:0.72rem;color:var(--text-faint);padding-left:14px;margin-top:3px">' + desc.includes.map(s=>`<li>${s}</li>`).join('') + '</ul>' : ''}`
      : `<div style="font-size:0.78rem;color:var(--text-faint);margin-top:4px">Artno: ${pid || '–'} · Kategori: ${item.category || '–'}</div>`;

    return separator + `<tr data-idx="${idx}" class="prod-row" draggable="true" ondragstart="prodDragStart(event,${idx})" ondragover="prodDragOver(event)" ondrop="prodDrop(event,${idx})" ondragend="prodDragEnd(event)" style="cursor:default">
      <td style="vertical-align:top;padding:8px 6px">
        <div style="display:flex;align-items:flex-start;gap:6px">
          <span style="flex-shrink:0;width:16px;display:flex;flex-direction:column;justify-content:center;gap:3px;padding-top:6px;cursor:grab;opacity:0.35" title="Dra för att flytta">⠿</span>
          <button onclick="prodTogglePopout(${idx})" style="flex-shrink:0;width:28px;height:28px;border-radius:6px;border:1px solid var(--border);background:rgba(0,0,0,.2);color:${color};cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center" title="Produktinfo">${icon}</button>
          <div style="flex:1;min-width:0">
            <input class="prod-input prod-name" value="${(item.name||'').replace(/"/g,'&quot;')}" placeholder="Produktnamn" data-field="name" data-idx="${idx}" style="width:100%;font-size:0.85rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
            <input type="hidden" data-field="category" data-idx="${idx}" value="${(item.category||'').replace(/"/g,'&quot;')}">
            <input type="hidden" data-field="id" data-idx="${idx}" value="${(item.id||'').replace(/"/g,'&quot;')}">
            <input type="hidden" data-field="type" data-idx="${idx}" value="${item.type||'product'}">
            <div id="po-${idx}" style="display:none">${popoutContent}</div>
          </div>
        </div>
      </td>
      <td style="text-align:center;vertical-align:top;padding-top:10px">
        <div style="display:flex;align-items:center;justify-content:center;gap:2px">
          <button class="qty-btn" onclick="prodQty(${idx},-1)">−</button>
          <input class="prod-input prod-qty" value="${qty}" data-field="qty" data-idx="${idx}" style="width:38px;text-align:center;font-size:0.85rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
          <button class="qty-btn" onclick="prodQty(${idx},1)">＋</button>
        </div>
      </td>
      <td style="text-align:right;vertical-align:top;padding-top:10px">
        <input class="prod-input prod-price" value="${price}" data-field="price" data-idx="${idx}" style="width:78px;text-align:right;font-size:0.85rem;background:#221f50!important;color:#f0eeff!important;color-scheme:dark;">
      </td>
      <td style="text-align:right;vertical-align:top;padding-top:10px;font-weight:600;color:var(--brand-lav);font-size:0.85rem" id="prod-sum-${idx}">${fmt(sub)} kr</td>
      <td style="vertical-align:top;padding-top:10px">
        <button class="qty-btn" style="color:var(--red);border-color:var(--red)" onclick="prodDelete(${idx})" title="Ta bort">×</button>
      </td>
    </tr>`;
  }).join('');

  return `
    <div class="section-label">Produkter &amp; tjänster (${items.length} st)</div>
    <table class="product-table" id="prod-edit-table">
      <thead><tr>
        <th>Produkt</th>
        <th style="text-align:center;width:88px">Antal</th>
