// ── MARKERA OFFERT SOM LÄST AV KUND (manuell override) ────────
// Används när admin vet att kunden sett offerten via annan kanal (telefon,
// vidarebefordrat mail etc.) men last_read_customer inte är satt automatiskt.
// Tar bort 'Oläst'-flaggan på kortet i kanban.
async function markCustomerAsReadManually() {
  // Delegera till den fullständiga funktionen som täcker båda fallen
  return markCartAsReadFull();
}

// Markera ett kort som "läst" — täcker BÅDA orsaker till 'Oläst'-flagga:
//   (a) admin har olästa kundmeddelanden  → markAdminRead sätter unread_count=0
//   (b) kunden har inte öppnat offerten   → sätter last_read_customer=now()
// Knappen finns i panel-header (alltid synlig när isCartUnread=true) och
// som komplement i Info-flikens 'Kund senast aktiv'-fält.
async function markCartAsReadFull() {
  if (!currentCart?.id) return;
  if (!confirm('Markera detta kort som läst?\n\nTar bort "Oläst"-flaggan på kanban-kortet:\n• Om kunden inte öppnat offerten markeras den som öppnad\n• Olästa kundmeddelanden markeras som lästa\n\nAnvänd när du vet att kunden hört av sig via annan kanal (telefon, vidarebefordrat mail etc).')) return;

  const tasks = [];

  // (b) Sätt last_read_customer om null
  if (!currentCart.last_read_customer) {
    const nowIso = new Date().toISOString();
    tasks.push(
      api('cart-update', {
        method: 'POST',
        body: JSON.stringify({ cart_id: currentCart.id, last_read_customer: nowIso }),
      }).then(({ ok }) => { if (ok) currentCart.last_read_customer = nowIso; })
    );
  }

  // (a) Markera olästa kundmeddelanden som lästa
  if ((currentCart.unread_count || 0) > 0) {
    tasks.push(markAdminRead(currentCart.id));
  }

  if (!tasks.length) {
    toast('Inget att markera — kortet är redan läst');
    return;
  }

  await Promise.all(tasks);
  await refreshCurrentCart();
  renderTab(activeTab);
  renderKanban();
  updateUnreadFilterBadge();
  updatePanelMarkReadBtn();
  toast('✓ Markerad som läst');
}

// Visar/döljer 'Markera som läst'-knappen i panel-header baserat på
// om aktuellt kort är flaggat som oläst.
