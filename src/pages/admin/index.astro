function prodTotals() {
  const total = (currentCart.items||[]).filter(i => !i._note && i.name?.trim()).reduce((s,i) => s + ((i.price||0)*(i.qty||i.quantity||1)), 0);
  return `<tr class="total-row"><td colspan="3">Totalt (exkl. moms)</td>
