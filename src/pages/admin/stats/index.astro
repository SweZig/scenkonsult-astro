---
// /admin/stats/ — Trafik & SEO-dashboard (GA4 v1)
// Hämtar via /.netlify/functions/stats-ga4 (server-side, dolda credentials).
// GSC + Google Ads adderas i kommande faser.
---
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Statistik — Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0c0a24; color: #f0eeff; font-family: 'Space Grotesk', system-ui, sans-serif; min-height: 100vh; }

    .topbar { background: rgba(30,24,80,0.97); border-bottom: 1px solid rgba(196,181,244,0.15); padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1rem; position: sticky; top: 0; z-index: 100; }
    .topbar a { color: rgba(196,181,244,0.6); font-size: 0.85rem; text-decoration: none; }
    .topbar a:hover { color: #c4b5f4; }
    .topbar h1 { font-size: 1.1rem; font-weight: 700; color: #c4b5f4; }
    .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }

    .wrap { max-width: 1180px; margin: 0 auto; padding: 1.5rem; }

    /* Period-toggle */
    .period-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .period-row .label { font-size: 0.78rem; color: rgba(255,255,255,0.60); }
    .pill-row { display: flex; gap: 4px; }
    .pill { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); border-radius: 20px; color: rgba(255,255,255,0.60); font-size: 0.78rem; padding: 4px 14px; cursor: pointer; transition: all 0.15s; font-family: inherit; }
    .pill:hover { border-color: rgba(196,181,244,0.4); color: rgba(196,181,244,0.85); }
    .pill.active { background: rgba(196,181,244,0.15); border-color: #c4b5f4; color: #c4b5f4; font-weight: 600; }
    .meta { margin-left: auto; font-size: 0.72rem; color: rgba(255,255,255,0.40); font-family: monospace; }

    /* Tabs */
    .tab-row { display: flex; gap: 4px; margin-bottom: 1rem; border-bottom: 1px solid rgba(196,181,244,0.15); }
    .tab-btn { background: transparent; border: none; color: rgba(255,255,255,0.60); padding: 10px 18px; cursor: pointer; font-size: 0.85rem; font-family: inherit; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.15s; }
    .tab-btn:hover { color: rgba(196,181,244,0.85); }
    .tab-btn.active { color: #c4b5f4; border-bottom-color: #c4b5f4; font-weight: 600; }

    /* Kanal-filter */
    .channel-filter-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .channel-filter-row .label { font-size: 0.78rem; color: rgba(255,255,255,0.60); white-space: nowrap; }
    .channel-chips { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; }
    .ch-chip { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; color: rgba(255,255,255,0.50); font-size: 0.73rem; padding: 3px 11px; cursor: pointer; transition: all 0.15s; font-family: inherit; display: flex; align-items: center; gap: 6px; }
    .ch-chip:hover { color: rgba(255,255,255,0.85); border-color: rgba(196,181,244,0.40); }
    .ch-chip.on { color: #f0eeff; background: rgba(196,181,244,0.10); border-color: rgba(196,181,244,0.45); }
    .ch-chip .ch-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; opacity: 0.4; transition: opacity 0.15s; }
    .ch-chip.on .ch-dot { opacity: 1; }
    .chip-toggle-all { background: transparent; border: 1px solid rgba(255,255,255,0.15); border-radius: 14px; color: rgba(255,255,255,0.50); font-size: 0.72rem; padding: 3px 10px; cursor: pointer; font-family: inherit; transition: all 0.15s; }
    .chip-toggle-all:hover { color: rgba(196,181,244,0.85); border-color: rgba(196,181,244,0.40); }

    /* KPI-rad */
    .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.75rem; margin-bottom: 1.25rem; }
    .kpi-card { background: #1e1850; border: 1px solid rgba(196,181,244,0.15); border-radius: 12px; padding: 0.9rem 1.1rem; }
    .kpi-lbl { font-size: 0.7rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem; }
    .kpi-val { font-size: 1.85rem; font-weight: 800; color: #c4b5f4; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .kpi-delta { font-size: 0.75rem; margin-top: 4px; font-variant-numeric: tabular-nums; }
    .delta-up   { color: #6ee7b7; }
    .delta-down { color: #fca5a5; }
    .delta-flat { color: rgba(255,255,255,0.45); }

    /* Sektion */
    .section { background: #1e1850; border: 1px solid rgba(196,181,244,0.15); border-radius: 14px; padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
    .sec-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.85rem; }
    .sec-title { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(196,181,244,0.6); }
    .sec-sub { font-size: 0.7rem; color: rgba(255,255,255,0.45); }

    /* Linjediagram-wrap (Chart.js) */
    .chart-wrap { position: relative; width: 100%; height: 240px; }

    /* Två-kolumns under */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 760px) { .grid-2 { grid-template-columns: 1fr; } }

    /* Donut + legend */
    .donut-wrap { display: flex; gap: 1rem; align-items: center; }
    .donut-canvas { position: relative; width: 130px; height: 130px; flex-shrink: 0; }
    .legend { display: flex; flex-direction: column; gap: 6px; font-size: 0.8rem; flex: 1; }
    .legend-row { display: flex; justify-content: space-between; align-items: center; }
    .legend-left { display: flex; align-items: center; gap: 8px; }
    .legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }
    .legend-val { font-variant-numeric: tabular-nums; color: rgba(255,255,255,0.7); font-size: 0.75rem; }

    /* Tabell */
    .tbl { width: 100%; border-collapse: collapse; }
    .tbl th { font-size: 0.7rem; color: rgba(196,181,244,0.55); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; text-align: left; padding: 6px 8px; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .tbl th.num { text-align: right; }
    .tbl td { padding: 7px 8px; font-size: 0.83rem; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
    .tbl td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .tbl tr:last-child td { border-bottom: none; }
    .tbl tr:hover td { background: rgba(196,181,244,0.04); }
    .path-cell { font-family: 'Source Sans 3', system-ui, sans-serif; color: rgba(255,255,255,0.85); max-width: 380px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .path-cell a { color: rgba(196,181,244,0.7); text-decoration: none; }
    .path-cell a:hover { color: #c4b5f4; text-decoration: underline; }
    .muted { color: rgba(255,255,255,0.45); }

    /* Top-queries lista */
    .qlist { display: flex; flex-direction: column; gap: 0.5rem; }
    .qrow { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; font-size: 0.85rem; border-bottom: 1px dashed rgba(255,255,255,0.05); }
    .qrow:last-child { border-bottom: none; }

    /* Loading + error */
    .loading { padding: 1.5rem; text-align: center; color: rgba(196,181,244,0.55); font-size: 0.85rem; }
    .error-banner { background: rgba(248,113,113,0.10); border: 1px solid rgba(248,113,113,0.30); border-radius: 10px; padding: 0.9rem 1.1rem; margin-bottom: 1rem; color: #fca5a5; font-size: 0.85rem; }
    .error-banner strong { color: #fca5a5; }
    .error-banner code { background: rgba(0,0,0,0.30); padding: 1px 6px; border-radius: 4px; font-size: 0.78rem; }
    .placeholder-box { background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.08); border-radius: 10px; padding: 1rem 1.2rem; color: rgba(255,255,255,0.45); font-size: 0.8rem; line-height: 1.5; }
    .placeholder-box strong { color: rgba(196,181,244,0.7); }

    /* Auth-skärm */
    #auth-screen { position: fixed; inset: 0; background: #0c0a24; display: flex; align-items: center; justify-content: center; z-index: 999; }
    .auth-box { background: #1e1850; border: 1px solid rgba(196,181,244,0.2); border-radius: 16px; padding: 2rem; width: 320px; text-align: center; }
    .auth-box h2 { color: #c4b5f4; margin-bottom: 1.25rem; font-size: 1.1rem; }
    .auth-input { width: 100%; background: #0c0a24; border: 1px solid rgba(196,181,244,0.2); border-radius: 8px; padding: 0.6rem 0.875rem; color: #f0eeff; font-size: 0.9rem; margin-bottom: 0.75rem; font-family: inherit; }
    .auth-btn { width: 100%; background: #c4b5f4; color: #0c0a24; font-weight: 700; border: none; border-radius: 8px; padding: 0.65rem; cursor: pointer; font-size: 0.9rem; font-family: inherit; }
    .auth-err { color: #f87171; font-size: 0.8rem; margin-top: 0.5rem; min-height: 20px; }
  </style>
</head>
<body>

<!-- Auth-skärm -->
<div id="auth-screen">
  <div class="auth-box">
    <h2>📈 Statistik</h2>
    <input type="password" class="auth-input" id="pw-input" placeholder="Adminlösenord" autocomplete="current-password">
    <button class="auth-btn" id="pw-btn">Logga in</button>
    <div class="auth-err" id="pw-err"></div>
  </div>
</div>

<div id="main-content" style="display:none">
  <div class="topbar">
    <a href="/admin/">← Admin</a>
    <h1>📈 Statistik</h1>
    <div class="topbar-right">
      <span class="meta" id="last-updated"></span>
    </div>
  </div>

  <div class="wrap">

    <!-- Period-toggle -->
    <div class="period-row">
      <span class="label">Period:</span>
      <div class="pill-row" id="period-pills">
        <button class="pill" data-period="7">7 dagar</button>
        <button class="pill active" data-period="28">28 dagar</button>
        <button class="pill" data-period="90">90 dagar</button>
      </div>
      <span class="meta" id="period-range">–</span>
    </div>

    <div id="error-zone"></div>

    <!-- Tabs -->
    <div class="tab-row">
      <button class="tab-btn active" data-tab="overview">📊 Översikt</button>
      <button class="tab-btn" data-tab="weekly">🗓️ Vecka för vecka</button>
    </div>

    <!-- ═══════════ ÖVERSIKT-VYN ═══════════ -->
    <div id="tab-overview" class="tab-content">

      <!-- KPI-rad -->
      <div class="kpi-row" id="kpi-row">
        <div class="kpi-card"><div class="kpi-lbl">Sessioner</div><div class="kpi-val" id="kpi-sessions">–</div><div class="kpi-delta delta-flat" id="kpi-sessions-delta">&nbsp;</div></div>
        <div class="kpi-card"><div class="kpi-lbl">Sidvisningar</div><div class="kpi-val" id="kpi-pageviews">–</div><div class="kpi-delta delta-flat" id="kpi-pageviews-delta">&nbsp;</div></div>
        <div class="kpi-card"><div class="kpi-lbl">Användare</div><div class="kpi-val" id="kpi-users">–</div><div class="kpi-delta delta-flat" id="kpi-users-delta">&nbsp;</div></div>
        <div class="kpi-card"><div class="kpi-lbl">Konverteringar</div><div class="kpi-val" id="kpi-conv">–</div><div class="kpi-delta delta-flat" id="kpi-conv-delta">&nbsp;</div></div>
        <div class="kpi-card"><div class="kpi-lbl">Engagemang</div><div class="kpi-val" id="kpi-engage">–</div><div class="kpi-delta delta-flat" id="kpi-engage-sub">&nbsp;</div></div>
      </div>

      <!-- Kanal-filter -->
      <div class="channel-filter-row">
        <span class="label">Trafikkällor:</span>
        <div class="channel-chips" id="channel-chips">
          <!-- chips renderas av JS -->
        </div>
        <button class="chip-toggle-all" id="chip-toggle-all" title="Markera/avmarkera alla">Alla</button>
      </div>

      <!-- Tidsserie -->
      <div class="section">
        <div class="sec-head">
          <span class="sec-title">Sessioner per dag</span>
          <span class="sec-sub" id="trend-sub">denna period vs föregående lika långa</span>
        </div>
        <div class="chart-wrap"><canvas id="trafficChart"></canvas></div>
      </div>

    <!-- Trafik per sida -->
    <div class="section">
      <div class="sec-head">
        <span class="sec-title">Trafik per sida</span>
        <span class="sec-sub">topp 30 — GA4-sessioner joinas med GSC-klick</span>
      </div>
      <table class="tbl" id="pages-tbl">
        <thead>
          <tr>
            <th>Sökväg</th>
            <th class="num">Sess.</th>
            <th class="num">Sidvisn.</th>
            <th class="num" title="Användare (GA4)">Anv.</th>
            <th class="num" title="Klick från Google-sök (Search Console)">GSC klick</th>
            <th class="num" title="Genomsnittsposition i sökresultaten">Pos.</th>
            <th class="num">Konv.</th>
          </tr>
        </thead>
        <tbody id="pages-tbody">
          <tr><td colspan="7" class="loading">Laddar…</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Två-kolumns: kanaler + planerad GSC/Ads -->
    <div class="grid-2">
      <div class="section">
        <div class="sec-head">
          <span class="sec-title">Trafikkällor</span>
          <span class="sec-sub">GA4 channel groups</span>
        </div>
        <div class="donut-wrap">
          <div class="donut-canvas"><canvas id="channelChart"></canvas></div>
          <div class="legend" id="channel-legend"></div>
        </div>
      </div>

      <div class="section">
        <div class="sec-head">
          <span class="sec-title">Sökord (GSC)</span>
          <span class="sec-sub">topp 25 — klick · visn. · pos.</span>
        </div>
        <div id="queries-zone" class="qlist">
          <div class="muted" style="font-size:0.8rem">Laddar…</div>
        </div>
      </div>
    </div>

      <!-- Google Ads placeholder -->
      <div class="section">
        <div class="sec-head">
          <span class="sec-title">Google Ads</span>
          <span class="sec-sub">kommer i fas 3 — väntar på Developer Token</span>
        </div>
        <div class="placeholder-box">
          Google Ads-integrationen kräver Developer Token (1–3 arbetsdagars
          granskning hos Google) + OAuth2-flöde (ej Service Account).
          Sätts in när konv/månad &gt; 15 och justerar bidstrategin motiverar
          kostnads-/konverterings-data per landningssida. Under tiden:
          <a href="https://ads.google.com/aw/overview?ocid=20679801278" target="_blank" rel="noopener" style="color:#c4b5f4">öppna Google Ads-dashboard →</a>
        </div>
      </div>

    </div><!-- /tab-overview -->

    <!-- ═══════════ VECKA FÖR VECKA-VYN ═══════════ -->
    <div id="tab-weekly" class="tab-content" style="display:none">
      <div class="section">
        <div class="sec-head">
          <span class="sec-title">Vecka för vecka</span>
          <span class="sec-sub">ISO-veckor — sessioner, användare, konverteringar</span>
        </div>
        <table class="tbl" id="weekly-tbl">
          <thead>
            <tr>
              <th>Vecka</th>
              <th>Datumintervall</th>
              <th class="num">Sessioner</th>
              <th class="num">Användare</th>
              <th class="num">Sidvisn.</th>
              <th class="num">Konv.</th>
            </tr>
          </thead>
          <tbody id="weekly-tbody">
            <tr><td colspan="6" class="loading">Laddar…</td></tr>
          </tbody>
        </table>
      </div>
    </div><!-- /tab-weekly -->

  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
// ── Auth (matchar /admin/ — klartext-lösenord, ingen hashning) ────────
const ADMIN_KEY = 'sk_admin_token';
let adminToken = sessionStorage.getItem(ADMIN_KEY) || '';

async function tryLogin(pw) {
  try {
    const res = await fetch('/api/admin-auth?_=' + Date.now(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-cache' },
      body: JSON.stringify({ password: pw }),
    });
    const j = await res.json().catch(() => ({}));
    return !!j.ok;
  } catch (e) {
    return false;
  }
}

document.getElementById('pw-btn').onclick = async () => {
  const pw = document.getElementById('pw-input').value.trim();
  if (!pw) return;
  const okResp = await tryLogin(pw);
  if (okResp) {
    adminToken = pw;
    sessionStorage.setItem(ADMIN_KEY, pw);
    document.getElementById('auth-screen').style.display = 'none';
    document.getElementById('main-content').style.display = 'block';
    init();
  } else {
    document.getElementById('pw-err').textContent = 'Fel lösenord';
  }
};
document.getElementById('pw-input').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('pw-btn').click(); });

// Om redan inloggad — försök auto-logga in
if (adminToken) {
  tryLogin(adminToken).then(okResp => {
    if (okResp) {
      document.getElementById('auth-screen').style.display = 'none';
      document.getElementById('main-content').style.display = 'block';
      init();
    } else {
      sessionStorage.removeItem(ADMIN_KEY);
      adminToken = '';
    }
  });
}

// ── State ─────────────────────────────────────────────────────────────
let currentPeriod = parseInt(sessionStorage.getItem('sk_stats_period') || '28', 10);
let currentTab    = sessionStorage.getItem('sk_stats_tab') || 'overview';
let trafficChart  = null;
let channelChart  = null;
let activeChannels = null;  // Set<string> eller null = alla
let lastPayload    = null;  // sista hämtade datan — för re-render vid filter-byte

const CACHE_KEY_PREFIX = 'sk-stats-cache-v3-';
const CACHE_TTL_MS = 15 * 60 * 1000; // 15 min

// Kanalfärger — matchar donut-paletten
const CHANNEL_PALETTE = ['#c4b5f4', '#7c3aed', '#5dcaa5', '#facc15', '#94a3b8', '#fb923c', '#60a5fa', '#f472b6', '#34d399'];
const channelColor = (name, allChannels) => {
  const idx = allChannels.indexOf(name);
  return CHANNEL_PALETTE[idx % CHANNEL_PALETTE.length];
};

// ── ISO-vecka (svenska veckonummer) ──────────────────────────────────
// ISO 8601: vecka börjar måndag, vecka 1 = veckan med 4 jan (= veckan
// med första torsdagen). Identisk med "svensk vecka".
function isoWeek(date) {
  const d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  const day = d.getUTCDay() || 7;
  d.setUTCDate(d.getUTCDate() + 4 - day);
  const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
  const weekNum = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
  return { year: d.getUTCFullYear(), week: weekNum };
}
function isoWeekKey(date) {
  const { year, week } = isoWeek(date);
  return `${year}-W${String(week).padStart(2, '0')}`;
}
// Måndag i en ISO-vecka
function mondayOfIsoWeek(year, week) {
  const jan4 = new Date(Date.UTC(year, 0, 4));
  const jan4Day = jan4.getUTCDay() || 7;
  const monday = new Date(jan4);
  monday.setUTCDate(jan4.getUTCDate() - jan4Day + 1 + (week - 1) * 7);
  return monday;
}
function fmtDateShort(d) {
  return d.toLocaleDateString('sv-SE', { day: 'numeric', month: 'short' });
}

function fmtNum(n) {
  if (n === null || n === undefined) return '–';
  return new Intl.NumberFormat('sv-SE').format(Math.round(n));
}
function fmtPct(n) {
  if (n === null || n === undefined || !Number.isFinite(n)) return '–';
  return n.toFixed(1).replace('.', ',') + ' %';
}
function setDelta(elId, deltaPct) {
  const el = document.getElementById(elId);
  if (!el) return;
  if (deltaPct === null || deltaPct === undefined || !Number.isFinite(deltaPct)) {
    el.textContent = '\u00a0';
    el.className = 'kpi-delta delta-flat';
    return;
  }
  const arrow = deltaPct > 0 ? '↑' : deltaPct < 0 ? '↓' : '→';
  el.textContent = `${arrow} ${Math.abs(deltaPct).toFixed(1).replace('.', ',')} % vs föregående`;
  el.className = 'kpi-delta ' + (deltaPct > 0 ? 'delta-up' : deltaPct < 0 ? 'delta-down' : 'delta-flat');
}

// ── Fetch + cache ─────────────────────────────────────────────────────
// Hämtar GA4 + GSC parallellt. Returnerar { ga4, gsc, gscError } där gsc
// kan vara null om bara GSC failat (GA4 är obligatorisk för KPI/grafer).
async function fetchEndpoint(url) {
  const res = await fetch(url, {
    headers: { 'Authorization': 'Bearer ' + adminToken, 'Cache-Control': 'no-cache' },
  });
  if (!res.ok) {
    const text = await res.text();
    let msg = `Status ${res.status}`;
    try { msg = JSON.parse(text).error || msg; } catch (e) {}
    throw new Error(msg);
  }
  return res.json();
}

async function fetchStats(period) {
  const cacheKey = CACHE_KEY_PREFIX + period;
  try {
    const raw = sessionStorage.getItem(cacheKey);
    if (raw) {
      const obj = JSON.parse(raw);
      if (Date.now() - obj.t < CACHE_TTL_MS) return obj.data;
    }
  } catch (e) {}

  const cb = Date.now();
  const ga4Url = `/.netlify/functions/stats-ga4?period=${period}&compare=1&_=${cb}`;
  const gscUrl = `/.netlify/functions/stats-gsc?period=${period}&_=${cb}`;

  // GA4 är kritisk → fail i sin helhet om den failar
  // GSC är komplement → samla felet men släpp ej igenom
  const [ga4, gscSettled] = await Promise.all([
    fetchEndpoint(ga4Url),
    fetchEndpoint(gscUrl).then(d => ({ ok: true, data: d }))
                          .catch(e => ({ ok: false, error: e?.message || String(e) })),
  ]);

  const out = {
    ga4,
    gsc: gscSettled.ok ? gscSettled.data : null,
    gscError: gscSettled.ok ? null : gscSettled.error,
  };
  try {
    sessionStorage.setItem(cacheKey, JSON.stringify({ t: Date.now(), data: out }));
  } catch (e) {}
  return out;
}

function showError(message) {
  const zone = document.getElementById('error-zone');
  zone.innerHTML = `
    <div class="error-banner">
      <strong>Kunde inte hämta data från GA4</strong><br>
      ${message}<br><br>
      Vanliga orsaker:<br>
      • OAuth-env vars saknas i Netlify (<code>GA4_OAUTH_CLIENT_ID</code>, <code>GA4_OAUTH_CLIENT_SECRET</code>, <code>GA4_OAUTH_REFRESH_TOKEN</code>)<br>
      • Refresh token är återkallad eller utgången — kör om <code>scripts/get-ga4-refresh-token.mjs</code> lokalt<br>
      • GA4 Data API inte aktiverat i Google Cloud-projektet
    </div>`;
}

function showGscError(message) {
  const zone = document.getElementById('error-zone');
  zone.insertAdjacentHTML('beforeend', `
    <div class="error-banner" style="border-color:rgba(250,204,21,0.30);background:rgba(250,204,21,0.06);color:#fde68a">
      <strong style="color:#fde68a">GSC-data kunde inte hämtas</strong> (GA4-data visas ändå)<br>
      ${message}<br>
      Kontrollera att Search Console API är aktiverat och att <code>per.sigvardsson@gmail.com</code> har behörighet på property <code>sc-domain:scenkonsult.se</code>.
    </div>`);
}

function clearError() {
  document.getElementById('error-zone').innerHTML = '';
}

// ── Render ────────────────────────────────────────────────────────────
function render(payload) {
  lastPayload = payload;  // spara för re-render vid filter-byte
  const ga4 = payload.ga4;
  const gsc = payload.gsc;

  // Period-range
  document.getElementById('period-range').textContent = `${ga4.period.start} → ${ga4.period.end}`;
  document.getElementById('last-updated').textContent =
    'uppdaterad ' + new Date(ga4.fetchedAt).toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });

  // Initiera activeChannels första gången — alla aktiva som default
  if (activeChannels === null) {
    activeChannels = new Set(ga4.channels.map(c => c.channel));
  } else {
    // Lägg till eventuellt nya kanaler som dykt upp efter period-byte
    for (const c of ga4.channels) if (!activeChannels.has(c.channel)) activeChannels.add(c.channel);
  }

  // KPI (alltid total, inte filtrerat)
  document.getElementById('kpi-sessions').textContent  = fmtNum(ga4.summary.sessions);
  document.getElementById('kpi-pageviews').textContent = fmtNum(ga4.summary.pageviews);
  document.getElementById('kpi-users').textContent     = fmtNum(ga4.summary.users);
  document.getElementById('kpi-conv').textContent      = fmtNum(ga4.summary.conversions);
  document.getElementById('kpi-engage').textContent    = fmtPct(ga4.summary.engagementRate);
  setDelta('kpi-sessions-delta',  ga4.summary.deltaSessions);
  setDelta('kpi-pageviews-delta', ga4.summary.deltaPageviews);
  setDelta('kpi-users-delta',     ga4.summary.deltaUsers);
  setDelta('kpi-conv-delta',      ga4.summary.deltaConversions);
  document.getElementById('kpi-engage-sub').textContent = `andel engagerade sessioner`;

  // Kanal-chips
  renderChannelChips(ga4.channels);

  // Filtrerade vyer
  renderFilteredViews();

  // Kanaler-donut (alltid total fördelning)
  renderChannels(ga4.channels);

  // Sökord (GSC)
  if (gsc) {
    renderQueries(gsc.queries);
  } else {
    document.getElementById('queries-zone').innerHTML =
      '<div class="muted" style="font-size:0.8rem">Sökord ej tillgängliga — se varning ovan</div>';
  }

  // Weekly-vyn
  renderWeekly(ga4.daily);

  // GSC-fel separat banner
  if (payload.gscError) showGscError(payload.gscError);
}

// Re-render delar som påverkas av kanal-filtret
function renderFilteredViews() {
  if (!lastPayload || !lastPayload.ga4) return;
  const ga4 = lastPayload.ga4;
  const gsc = lastPayload.gsc;

  renderTrafficChart(ga4.daily, ga4.dailyByChannel || []);
  renderPagesTable(ga4.pages, ga4.pagesByChannel || [], gsc?.pages || []);
}

// ── Kanal-chips ──────────────────────────────────────────────────────
function renderChannelChips(channels) {
  const wrap = document.getElementById('channel-chips');
  const allNames = channels.map(c => c.channel);
  wrap.innerHTML = channels.map(c => {
    const on = activeChannels.has(c.channel);
    const color = channelColor(c.channel, allNames);
    return `<button class="ch-chip ${on ? 'on' : ''}" data-channel="${c.channel.replace(/"/g, '&quot;')}"
              title="${fmtNum(c.sessions)} sessioner">
        <span class="ch-dot" style="background:${color}"></span>${c.channel}
      </button>`;
  }).join('');

  wrap.querySelectorAll('.ch-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const name = btn.dataset.channel;
      if (activeChannels.has(name)) activeChannels.delete(name);
      else activeChannels.add(name);
      btn.classList.toggle('on');
      renderFilteredViews();
    });
  });

  // Toggle-all-knapp
  const toggleBtn = document.getElementById('chip-toggle-all');
  toggleBtn.onclick = () => {
    if (activeChannels.size === allNames.length) {
      activeChannels.clear();
    } else {
      activeChannels = new Set(allNames);
    }
    renderChannelChips(channels);
    renderFilteredViews();
  };
}

function renderTrafficChart(daily, dailyByChannel) {
  const ctx = document.getElementById('trafficChart');
  if (trafficChart) trafficChart.destroy();

  // Bestäm om filter är aktivt (alla kanaler aktiva = inget filter)
  const allChannels = new Set(dailyByChannel.map(r => r.channel));
  const filterActive = activeChannels.size < allChannels.size;

  const labels = daily.map(d => {
    const dt = new Date(d.date);
    return dt.toLocaleDateString('sv-SE', { day: 'numeric', month: 'short' });
  });

  let sessions;
  if (filterActive) {
    // Aggregera dailyByChannel per dag, bara aktiva kanaler
    const byDate = new Map();
    for (const r of dailyByChannel) {
      if (!activeChannels.has(r.channel)) continue;
      byDate.set(r.date, (byDate.get(r.date) || 0) + r.sessions);
    }
    sessions = daily.map(d => byDate.get(d.date) || 0);
  } else {
    sessions = daily.map(d => d.sessions);
  }
  const compare = daily.map(d => d.compareSessions);

  // Uppdatera sub-text för att markera filterläge
  document.getElementById('trend-sub').textContent = filterActive
    ? `filtrerat på ${activeChannels.size}/${allChannels.size} kanaler · jämförelse visas totalt`
    : 'denna period vs föregående lika långa';

  trafficChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [
        {
          label: filterActive ? 'Valda kanaler' : 'Denna period',
          data: sessions,
          borderColor: '#c4b5f4',
          backgroundColor: 'rgba(196,181,244,0.10)',
          borderWidth: 2,
          tension: 0.32,
          pointRadius: 0,
          pointHoverRadius: 4,
          fill: true,
        },
        {
          label: filterActive ? 'Totalt' : 'Föregående period',
          data: filterActive ? daily.map(d => d.sessions) : compare,
          borderColor: 'rgba(255,255,255,0.40)',
          borderDash: [5, 4],
          borderWidth: 1,
          tension: 0.32,
          pointRadius: 0,
          pointHoverRadius: 3,
          fill: false,
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: {
          display: true,
          position: 'bottom',
          labels: { color: 'rgba(255,255,255,0.6)', font: { size: 11, family: 'Space Grotesk' }, boxWidth: 18, boxHeight: 2, padding: 14 }
        },
        tooltip: {
          backgroundColor: '#0c0a24',
          borderColor: 'rgba(196,181,244,0.3)',
          borderWidth: 1,
          titleColor: '#c4b5f4',
          bodyColor: '#f0eeff',
          padding: 10,
        }
      },
      scales: {
        x: {
          ticks: { color: 'rgba(255,255,255,0.45)', font: { size: 10 }, maxRotation: 0, autoSkipPadding: 16 },
          grid: { display: false },
        },
        y: {
          beginAtZero: true,
          ticks: { color: 'rgba(255,255,255,0.45)', font: { size: 10 }, },
          grid: { color: 'rgba(255,255,255,0.05)' },
        }
      }
    }
  });
}

function renderPagesTable(pagesTotal, pagesByChannel, gscPages) {
  const tbody = document.getElementById('pages-tbody');

  // Bestäm filterläge
  const allChannels = new Set(pagesByChannel.map(r => r.channel));
  const filterActive = allChannels.size > 0 && activeChannels.size < allChannels.size;

  let pages;
  if (filterActive) {
    // Aggregera pagesByChannel per path, bara aktiva kanaler
    const agg = new Map();
    for (const r of pagesByChannel) {
      if (!activeChannels.has(r.channel)) continue;
      const e = agg.get(r.path) || { path: r.path, sessions: 0, pageviews: 0, users: 0, conversions: 0, engagementRate: 0 };
      e.sessions    += r.sessions;
      e.pageviews   += r.pageviews;
      e.users       += r.users;
      e.conversions += r.conversions;
      agg.set(r.path, e);
    }
    pages = Array.from(agg.values()).sort((a, b) => b.sessions - a.sessions).slice(0, 30);
  } else {
    pages = pagesTotal;
  }

  if (!pages || !pages.length) {
    tbody.innerHTML = '<tr><td colspan="7" class="muted" style="text-align:center;padding:1rem">Ingen data för perioden</td></tr>';
    return;
  }

  // GSC-lookup
  const stripSlash = (s) => (s && s !== '/' && s.endsWith('/')) ? s.slice(0, -1) : s;
  const gscMap = new Map();
  for (const g of (gscPages || [])) gscMap.set(stripSlash(g.path || ''), g);

  tbody.innerHTML = pages.map(p => {
    const safePath = p.path.replace(/</g, '&lt;');
    const href = p.path.startsWith('/') ? `https://scenkonsult.se${p.path}` : '#';
    const gsc = gscMap.get(stripSlash(p.path)) || null;
    const gscClicks = gsc ? fmtNum(gsc.clicks) : '<span class="muted">–</span>';
    const gscPos    = gsc && gsc.position > 0
      ? `<span title="Snittposition · CTR ${gsc.ctr.toFixed(1).replace('.',',')} %">${gsc.position.toFixed(1).replace('.',',')}</span>`
      : '<span class="muted">–</span>';
    return `
      <tr>
        <td class="path-cell" title="${safePath}"><a href="${href}" target="_blank" rel="noopener">${safePath || '/'}</a></td>
        <td class="num">${fmtNum(p.sessions)}</td>
        <td class="num">${fmtNum(p.pageviews)}</td>
        <td class="num">${fmtNum(p.users)}</td>
        <td class="num">${gscClicks}</td>
        <td class="num">${gscPos}</td>
        <td class="num">${p.conversions > 0 ? fmtNum(p.conversions) : '<span class="muted">0</span>'}</td>
      </tr>`;
  }).join('');
}

function renderQueries(queries) {
  const zone = document.getElementById('queries-zone');
  if (!queries || !queries.length) {
    zone.innerHTML = '<div class="muted" style="font-size:0.8rem">Ingen sökordsdata för perioden</div>';
    return;
  }
  zone.innerHTML = queries.map(q => {
    const safeQ = (q.query || '').replace(/</g, '&lt;');
    const posTxt = q.position > 0 ? `#${q.position.toFixed(1).replace('.', ',')}` : '–';
    return `
      <div class="qrow">
        <span style="color:rgba(255,255,255,0.85);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:60%" title="${safeQ}">${safeQ}</span>
        <span class="legend-val">${fmtNum(q.clicks)} klick · ${posTxt}</span>
      </div>`;
  }).join('');
}

// ── Weekly-vy: aggregera daily per ISO-vecka ───────────────────────────
function renderWeekly(daily) {
  const tbody = document.getElementById('weekly-tbody');
  if (!daily || !daily.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;padding:1rem">Ingen data för perioden</td></tr>';
    return;
  }

  // Bucketing per ISO-vecka
  const buckets = new Map(); // key 'YYYY-Www' → { year, week, sessions, users, pageviews, conversions, firstDate, lastDate }
  for (const d of daily) {
    const dt = new Date(d.date + 'T00:00:00Z');
    const { year, week } = isoWeek(dt);
    const key = `${year}-W${String(week).padStart(2, '0')}`;
    const e = buckets.get(key) || {
      year, week, key,
      sessions: 0, users: 0, pageviews: 0, conversions: 0,
      firstDate: dt, lastDate: dt,
    };
    e.sessions    += d.sessions || 0;
    e.users       += d.users || 0;
    e.pageviews   += d.pageviews || 0;
    e.conversions += d.conversions || 0;
    if (dt < e.firstDate) e.firstDate = dt;
    if (dt > e.lastDate)  e.lastDate  = dt;
    buckets.set(key, e);
  }

  // Sortera nyaste vecka först
  const rows = Array.from(buckets.values()).sort((a, b) => {
    if (a.year !== b.year) return b.year - a.year;
    return b.week - a.week;
  });

  // Hitta nuvarande ISO-vecka för att markera
  const nowIso = isoWeek(new Date());
  const nowKey = `${nowIso.year}-W${String(nowIso.week).padStart(2, '0')}`;

  tbody.innerHTML = rows.map(r => {
    // Visa måndag–söndag oavsett vilka dagar som ligger i bucket (perioden kan
    // delvis täcka en vecka — då räknar siffrorna bara på dagarna i perioden)
    const monday = mondayOfIsoWeek(r.year, r.week);
    const sunday = new Date(monday); sunday.setUTCDate(monday.getUTCDate() + 6);
    const partial = (r.firstDate > monday) || (r.lastDate < sunday);
    const range = `${fmtDateShort(r.firstDate)} – ${fmtDateShort(r.lastDate)}` +
                  (partial ? ' <span class="muted" style="font-size:0.7rem">(del av vecka)</span>' : '');
    const isCurrent = r.key === nowKey;
    return `
      <tr ${isCurrent ? 'style="background:rgba(196,181,244,0.06)"' : ''}>
        <td><strong style="color:#c4b5f4">v.${r.week}</strong> <span class="muted" style="font-size:0.75rem">${r.year}</span>${isCurrent ? ' <span style="font-size:0.65rem;color:#c4b5f4;background:rgba(196,181,244,0.15);padding:1px 6px;border-radius:8px;margin-left:4px">nu</span>' : ''}</td>
        <td style="color:rgba(255,255,255,0.65);font-size:0.8rem">${range}</td>
        <td class="num">${fmtNum(r.sessions)}</td>
        <td class="num">${fmtNum(r.users)}</td>
        <td class="num">${fmtNum(r.pageviews)}</td>
        <td class="num">${r.conversions > 0 ? fmtNum(r.conversions) : '<span class="muted">0</span>'}</td>
      </tr>`;
  }).join('');
}

function renderChannels(channels) {
  if (channelChart) channelChart.destroy();
  if (!channels || !channels.length) {
    document.getElementById('channel-legend').innerHTML = '<div class="muted" style="font-size:0.8rem">Ingen data</div>';
    return;
  }

  // Färgpalett: lavendel → mörkare violet → teal → amber → grå
  const palette = ['#c4b5f4', '#7c3aed', '#5dcaa5', '#facc15', '#94a3b8', '#fb923c', '#60a5fa'];

  const labels = channels.map(c => c.channel);
  const data   = channels.map(c => c.sessions);
  const total  = data.reduce((a, b) => a + b, 0) || 1;

  channelChart = new Chart(document.getElementById('channelChart'), {
    type: 'doughnut',
    data: {
      labels,
      datasets: [{
        data,
        backgroundColor: labels.map((_, i) => palette[i % palette.length]),
        borderColor: '#1e1850',
        borderWidth: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '65%',
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0c0a24',
          borderColor: 'rgba(196,181,244,0.3)',
          borderWidth: 1,
          titleColor: '#c4b5f4',
          bodyColor: '#f0eeff',
          callbacks: {
            label: (ctx) => `${ctx.label}: ${fmtNum(ctx.parsed)} (${((ctx.parsed / total) * 100).toFixed(1)} %)`,
          }
        }
      }
    }
  });

  const legend = document.getElementById('channel-legend');
  legend.innerHTML = channels.map((c, i) => {
    const color = palette[i % palette.length];
    const pct = (c.sessions / total) * 100;
    return `
      <div class="legend-row">
        <div class="legend-left">
          <span class="legend-dot" style="background:${color}"></span>
          <span>${c.channel}</span>
        </div>
        <span class="legend-val">${fmtNum(c.sessions)} · ${pct.toFixed(1).replace('.', ',')} %</span>
      </div>`;
  }).join('');
}

// ── Init + period-toggle ──────────────────────────────────────────────
async function load(period) {
  clearError();
  document.getElementById('pages-tbody').innerHTML = '<tr><td colspan="7" class="loading">Laddar…</td></tr>';
  document.getElementById('weekly-tbody').innerHTML = '<tr><td colspan="6" class="loading">Laddar…</td></tr>';
  try {
    const data = await fetchStats(period);
    render(data);
  } catch (e) {
    showError(e.message || 'Okänt fel');
  }
}

function setTab(tab) {
  currentTab = tab;
  sessionStorage.setItem('sk_stats_tab', tab);
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  document.getElementById('tab-overview').style.display = (tab === 'overview') ? '' : 'none';
  document.getElementById('tab-weekly').style.display   = (tab === 'weekly')   ? '' : 'none';
}

function init() {
  // Period-toggle
  document.querySelectorAll('#period-pills .pill').forEach(b => {
    b.classList.toggle('active', parseInt(b.dataset.period, 10) === currentPeriod);
    b.addEventListener('click', () => {
      currentPeriod = parseInt(b.dataset.period, 10);
      sessionStorage.setItem('sk_stats_period', String(currentPeriod));
      document.querySelectorAll('#period-pills .pill').forEach(x => x.classList.toggle('active', x === b));
      // Behåll filter mellan period-byten — om kanalerna ändras hanteras det i render()
      load(currentPeriod);
    });
  });

  // Tab-toggle
  document.querySelectorAll('.tab-btn').forEach(b => {
    b.addEventListener('click', () => setTab(b.dataset.tab));
  });
  setTab(currentTab);

  load(currentPeriod);
}
</script>
</body>
</html>
