---
// /admin/stats/forsaljning/ — Försäljningsstatistik
// Fakturerad omsättning (exkl. moms) med avdrag för krediteringar.
// Data via /.netlify/functions/admin-stats-sales (server-side, service key).
// Vyer: Månad / Kvartal / År. Bottom-up: total → kategori → produkt.
---
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Försäljning — Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0c0a24; color: #f0eeff; font-family: 'Space Grotesk', system-ui, sans-serif; min-height: 100vh; }

    .topbar { background: rgba(30,24,80,0.97); border-bottom: 1px solid rgba(196,181,244,0.15); padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1rem; position: sticky; top: 0; z-index: 100; }
    .topbar a { color: rgba(196,181,244,0.6); font-size: 0.85rem; text-decoration: none; }
    .topbar a:hover { color: #c4b5f4; }
    .topbar h1 { font-size: 1.1rem; font-weight: 700; color: #c4b5f4; }
    .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }
    .meta { font-size: 0.72rem; color: rgba(255,255,255,0.40); font-family: monospace; }

    .wrap { max-width: 1180px; margin: 0 auto; padding: 1.5rem; }

    /* Vy-toggle (månad/kvartal/år) */
    .period-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .period-row .label { font-size: 0.78rem; color: rgba(255,255,255,0.60); }
    .pill-row { display: flex; gap: 4px; }
    .pill { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); border-radius: 20px; color: rgba(255,255,255,0.60); font-size: 0.78rem; padding: 5px 16px; cursor: pointer; transition: all 0.15s; font-family: inherit; }
    .pill:hover { border-color: rgba(196,181,244,0.4); color: rgba(196,181,244,0.85); }
    .pill.active { background: rgba(196,181,244,0.15); border-color: #c4b5f4; color: #c4b5f4; font-weight: 600; }

    /* Period-väljare (vilken månad/kvartal/år) */
    .period-select { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }
    .period-select select { background: #221f50; color: #f0eeff; border: 1px solid rgba(196,181,244,0.25); border-radius: 8px; padding: 5px 10px; font-family: inherit; font-size: 0.8rem; color-scheme: dark; }

    /* KPI-rad */
    .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
    .kpi-card { background: #1e1850; border: 1px solid rgba(196,181,244,0.15); border-radius: 12px; padding: 1rem 1.2rem; }
    .kpi-lbl { font-size: 0.7rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem; }
    .kpi-val { font-size: 1.9rem; font-weight: 800; color: #c4b5f4; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .kpi-unit { font-size: 0.85rem; font-weight: 600; color: rgba(196,181,244,0.7); margin-left: 4px; }
    .kpi-delta { font-size: 0.75rem; margin-top: 5px; font-variant-numeric: tabular-nums; }
    .delta-up   { color: #6ee7b7; }
    .delta-down { color: #fca5a5; }
    .delta-flat { color: rgba(255,255,255,0.45); }

    /* Sektioner */
    .section { background: #15123a; border: 1px solid rgba(196,181,244,0.12); border-radius: 14px; padding: 1.1rem 1.25rem; margin-bottom: 1.25rem; }
    .sec-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.9rem; }
    .sec-title { font-size: 0.95rem; font-weight: 700; color: #e2dcfb; }
    .sec-sub { font-size: 0.72rem; color: rgba(255,255,255,0.45); }

    /* Kategori-rader (bottom-up nivå 1) */
    .cat-bar { display: grid; grid-template-columns: 130px 1fr 110px 70px; align-items: center; gap: 0.75rem; padding: 7px 0; cursor: pointer; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .cat-bar:last-child { border-bottom: none; }
    .cat-bar:hover .cat-name { color: #c4b5f4; }
    .cat-name { font-size: 0.85rem; font-weight: 600; color: #f0eeff; display: flex; align-items: center; gap: 6px; }
    .cat-caret { font-size: 0.65rem; color: rgba(196,181,244,0.6); transition: transform 0.15s; display: inline-block; width: 10px; }
    .cat-bar.open .cat-caret { transform: rotate(90deg); }
    .bar-track { background: rgba(255,255,255,0.06); border-radius: 6px; height: 22px; overflow: hidden; position: relative; }
    .bar-fill { height: 100%; border-radius: 6px; transition: width 0.4s ease; }
    .cat-rev { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; font-size: 0.88rem; color: #e2dcfb; }
    .cat-cnt { text-align: right; font-variant-numeric: tabular-nums; font-size: 0.8rem; color: rgba(255,255,255,0.55); }

    /* Produkt-drilldown (nivå 2) */
    .prod-wrap { display: none; padding: 4px 0 10px 18px; }
    .prod-wrap.open { display: block; }
    .prod-row { display: grid; grid-template-columns: 1fr 100px 60px; gap: 0.75rem; padding: 4px 0; font-size: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .prod-name { color: rgba(255,255,255,0.78); }
    .prod-artno { color: rgba(255,255,255,0.35); font-family: monospace; font-size: 0.72rem; }
    .prod-rev { text-align: right; font-variant-numeric: tabular-nums; color: #c4b5f4; }
    .prod-cnt { text-align: right; font-variant-numeric: tabular-nums; color: rgba(255,255,255,0.5); }

    /* Trend-tabell (alla perioder) */
    .tbl { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    .tbl th { text-align: left; padding: 8px 10px; color: rgba(255,255,255,0.5); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid rgba(196,181,244,0.15); }
    .tbl td { padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,0.05); font-variant-numeric: tabular-nums; }
    .tbl tr:hover td { background: rgba(196,181,244,0.04); }
    .tbl .num { text-align: right; }
    .tbl .cur { color: #c4b5f4; font-weight: 600; }
    .tbl tr.active-period td { background: rgba(196,181,244,0.10); }
    .tbl tr.active-period td:first-child { border-left: 2px solid #c4b5f4; }

    .empty { text-align: center; color: rgba(255,255,255,0.4); padding: 2.5rem; font-size: 0.9rem; }
    .warn { background: rgba(252,165,165,0.08); border: 1px solid rgba(252,165,165,0.25); border-radius: 8px; padding: 8px 12px; font-size: 0.76rem; color: #fca5a5; margin-bottom: 1rem; }
    .spin { text-align: center; padding: 3rem; color: rgba(196,181,244,0.6); }

    /* Auth */
    #auth-screen { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .auth-box { background: #1e1850; border: 1px solid rgba(196,181,244,0.2); border-radius: 16px; padding: 2rem; width: 320px; }
    .auth-box h2 { color: #c4b5f4; font-size: 1.1rem; margin-bottom: 1rem; }
    .auth-box input { width: 100%; background: #221f50; color: #f0eeff; border: 1px solid rgba(196,181,244,0.25); border-radius: 8px; padding: 10px 12px; font-family: inherit; margin-bottom: 0.75rem; color-scheme: dark; }
    .auth-box button { width: 100%; background: #c4b5f4; color: #1a1430; border: none; border-radius: 8px; padding: 10px; font-weight: 700; cursor: pointer; font-family: inherit; }
    .auth-box button:hover { background: #e2dcfb; }
    .auth-err { color: #fca5a5; font-size: 0.8rem; margin-top: 0.5rem; min-height: 1rem; }

    .toggle-excl { font-size: 0.72rem; color: rgba(255,255,255,0.4); }
  </style>
</head>
<body>

<div id="auth-screen">
  <div class="auth-box">
    <h2>Försäljningsstatistik</h2>
    <input type="password" id="pw-input" placeholder="Adminlösenord" autocomplete="current-password" />
    <button id="pw-btn">Logga in</button>
    <div class="auth-err" id="pw-err"></div>
  </div>
</div>

<div id="main-content" style="display:none">
  <div class="topbar">
    <a href="/admin/">← Admin</a>
    <a href="/admin/stats/">📈 Trafik &amp; SEO</a>
    <h1>💰 Försäljning</h1>
    <div class="topbar-right">
      <span class="toggle-excl">Belopp exkl. moms</span>
      <span class="meta" id="last-updated"></span>
    </div>
  </div>

  <div class="wrap">

    <div class="period-row">
      <span class="label">Vy:</span>
      <div class="pill-row" id="view-pills">
        <button class="pill active" data-view="month">Månad</button>
        <button class="pill" data-view="quarter">Kvartal</button>
        <button class="pill" data-view="year">År</button>
      </div>
      <div class="period-select">
        <span class="label">Period:</span>
        <select id="period-select"></select>
      </div>
    </div>

    <div id="warn-zone"></div>
    <div id="content-zone">
      <div class="spin">Laddar försäljningsdata…</div>
    </div>

  </div>
</div>

<script>
// ── Auth (matchar /admin/ + /admin/stats/ — klartext-lösenord) ──────────
const ADMIN_KEY = 'sk_admin_token';
let adminToken = sessionStorage.getItem(ADMIN_KEY) || '';

async function tryLogin(pw) {
  try {
    const res = await fetch('/api/admin-auth?_=' + Date.now(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-cache' },
      body: JSON.stringify({ password: pw }),
    });
    const j = await res.json().catch(() => ({}));
    return !!j.ok;
  } catch (e) { return false; }
}

document.getElementById('pw-btn').onclick = async () => {
  const pw = document.getElementById('pw-input').value.trim();
  if (!pw) return;
  if (await tryLogin(pw)) {
    adminToken = pw;
    sessionStorage.setItem(ADMIN_KEY, pw);
    document.getElementById('auth-screen').style.display = 'none';
    document.getElementById('main-content').style.display = 'block';
    init();
  } else {
    document.getElementById('pw-err').textContent = 'Fel lösenord';
  }
};
document.getElementById('pw-input').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('pw-btn').click(); });

if (adminToken) {
  tryLogin(adminToken).then(okResp => {
    if (okResp) {
      document.getElementById('auth-screen').style.display = 'none';
      document.getElementById('main-content').style.display = 'block';
      init();
    } else {
      sessionStorage.removeItem(ADMIN_KEY); adminToken = '';
    }
  });
}

// ── State ───────────────────────────────────────────────────────────────
let currentView = sessionStorage.getItem('sk_sales_view') || 'month';
let currentPeriodKey = null;       // vald period inom vyn (t.ex. '2026-06')
let payload = null;                 // hela svaret från functionen

// Färger per toppkategori (matchar varumärket; lavendel-skala + accenter)
const CAT_COLOR = {
  'Scen':       '#c4b5f4',
  'Ljud':       '#a78bfa',
  'Bild':       '#818cf8',
  'Ljus':       '#f0abfc',
  'DJ':         '#67e8f9',
  'Karaoke':    '#fcd34d',
  'El & ström': '#86efac',
  'Tjänster':   'rgba(255,255,255,0.35)',
  'Okänt':      '#fca5a5',
};

const fmtKr = (n) => (n || 0).toLocaleString('sv-SE') + ' kr';
const VIEW_LABEL = { month: 'månad', quarter: 'kvartal', year: 'år' };

// Människovänlig etikett för periodnyckel
function periodLabel(view, key) {
  if (view === 'year') return key;
  if (view === 'quarter') return key.replace('-Q', ' Q');
  // month: 2026-06 → "Juni 2026"
  const [y, m] = key.split('-');
  const months = ['Januari','Februari','Mars','April','Maj','Juni','Juli','Augusti','September','Oktober','November','December'];
  return `${months[parseInt(m,10)-1]} ${y}`;
}

// ── Hämta data ──────────────────────────────────────────────────────────
async function loadData() {
  const res = await fetch('/.netlify/functions/admin-stats-sales', {
    headers: { 'Authorization': 'Bearer ' + adminToken, 'Cache-Control': 'no-cache' },
  });
  if (res.status === 401) {
    sessionStorage.removeItem(ADMIN_KEY);
    location.reload();
    return null;
  }
  if (!res.ok) throw new Error('Serverfel ' + res.status);
  return res.json();
}

// ── Rendering ───────────────────────────────────────────────────────────
function render() {
  const zone = document.getElementById('content-zone');
  if (!payload) { zone.innerHTML = '<div class="spin">Laddar…</div>'; return; }

  const dimData = payload.data[currentView] || {};
  const keys = Object.keys(dimData).sort().reverse(); // senaste först

  // Fyll periodväljare
  const sel = document.getElementById('period-select');
  sel.innerHTML = keys.map(k => `<option value="${k}">${periodLabel(currentView, k)}</option>`).join('');
  if (!currentPeriodKey || !keys.includes(currentPeriodKey)) currentPeriodKey = keys[0] || null;
  sel.value = currentPeriodKey || '';

  if (!currentPeriodKey) {
    zone.innerHTML = '<div class="empty">Ingen fakturerad försäljning i denna vy ännu.</div>';
    return;
  }

  const cur = dimData[currentPeriodKey];
  const allKeys = Object.keys(dimData).sort();
  const idx = allKeys.indexOf(currentPeriodKey);
  const prev = idx > 0 ? dimData[allKeys[idx - 1]] : null;

  // Delta-beräkning
  const deltaHtml = (now, before, unit) => {
    if (before == null) return '<span class="kpi-delta delta-flat">&nbsp;</span>';
    const diff = now - before;
    if (before === 0 && now === 0) return '<span class="kpi-delta delta-flat">&nbsp;</span>';
    const pct = before === 0 ? null : Math.round(diff / before * 100);
    const cls = diff > 0 ? 'delta-up' : diff < 0 ? 'delta-down' : 'delta-flat';
    const arrow = diff > 0 ? '▲' : diff < 0 ? '▼' : '–';
    const pctTxt = pct == null ? '' : ` (${pct > 0 ? '+' : ''}${pct}%)`;
    return `<span class="kpi-delta ${cls}">${arrow} ${diff > 0 ? '+' : ''}${unit === 'kr' ? fmtKr(diff) : diff}${pctTxt} vs föreg.</span>`;
  };

  // KPI:er
  const kpis = `
    <div class="kpi-row">
      <div class="kpi-card">
        <div class="kpi-lbl">Omsättning</div>
        <div class="kpi-val">${(cur.total.omsattning || 0).toLocaleString('sv-SE')}<span class="kpi-unit">kr</span></div>
        ${deltaHtml(cur.total.omsattning, prev ? prev.total.omsattning : null, 'kr')}
      </div>
      <div class="kpi-card">
        <div class="kpi-lbl">Antal uthyrningar</div>
        <div class="kpi-val">${cur.total.antal || 0}</div>
        ${deltaHtml(cur.total.antal, prev ? prev.total.antal : null, '')}
      </div>
      <div class="kpi-card">
        <div class="kpi-lbl">Snitt per uthyrning</div>
        <div class="kpi-val">${cur.total.antal ? Math.round(cur.total.omsattning / cur.total.antal).toLocaleString('sv-SE') : '–'}<span class="kpi-unit">kr</span></div>
        <span class="kpi-delta delta-flat">&nbsp;</span>
      </div>
    </div>`;

  // Kategori-staplar (bottom-up nivå 1, klickbara → produkter)
  const maxRev = Math.max(1, ...cur.categories.map(c => Math.abs(c.omsattning)));
  const catRows = cur.categories.map(c => {
    const color = CAT_COLOR[c.category] || '#c4b5f4';
    const w = Math.max(2, Math.round(Math.abs(c.omsattning) / maxRev * 100));
    const prods = (cur.products || []).filter(p => p.category === c.category);
    const prodRows = prods.map(p => `
      <div class="prod-row">
        <div><span class="prod-name">${escapeHtml(p.name)}</span> <span class="prod-artno">${escapeHtml(p.artno || '')}</span></div>
        <div class="prod-rev">${fmtKr(p.omsattning)}</div>
        <div class="prod-cnt">${p.antal} st</div>
      </div>`).join('') || '<div class="prod-row"><div class="prod-name" style="opacity:.5">Inga produktrader</div><div></div><div></div></div>';
    return `
      <div class="cat-bar" data-cat="${escapeHtml(c.category)}">
        <div class="cat-name"><span class="cat-caret">▶</span>${escapeHtml(c.category)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${w}%;background:${color}"></div></div>
        <div class="cat-rev">${fmtKr(c.omsattning)}</div>
        <div class="cat-cnt">${c.antal} st</div>
      </div>
      <div class="prod-wrap" data-cat-prods="${escapeHtml(c.category)}">${prodRows}</div>`;
  }).join('');

  const catSection = `
    <div class="section">
      <div class="sec-head">
        <span class="sec-title">Omsättning per kategori</span>
        <span class="sec-sub">${periodLabel(currentView, currentPeriodKey)} · klicka för produkter</span>
      </div>
      ${cur.categories.length ? catRows : '<div class="empty">Inga rader.</div>'}
    </div>`;

  // Trend-tabell (alla perioder i vyn)
  const trendRows = allKeys.slice().reverse().map(k => {
    const d = dimData[k];
    const active = k === currentPeriodKey ? ' class="active-period"' : '';
    return `<tr${active} data-jump="${k}" style="cursor:pointer">
      <td>${periodLabel(currentView, k)}</td>
      <td class="num cur">${fmtKr(d.total.omsattning)}</td>
      <td class="num">${d.total.antal} st</td>
      <td class="num">${d.total.antal ? Math.round(d.total.omsattning / d.total.antal).toLocaleString('sv-SE') + ' kr' : '–'}</td>
    </tr>`;
  }).join('');

  const trendSection = `
    <div class="section">
      <div class="sec-head">
        <span class="sec-title">Alla ${VIEW_LABEL[currentView]}er</span>
        <span class="sec-sub">klicka på en rad för att växla period</span>
      </div>
      <table class="tbl">
        <thead><tr><th>Period</th><th class="num">Omsättning</th><th class="num">Uthyrningar</th><th class="num">Snitt</th></tr></thead>
        <tbody>${trendRows}</tbody>
      </table>
    </div>`;

  zone.innerHTML = kpis + catSection + trendSection;

  // Bind: kategori-klick → toggla produkter
  zone.querySelectorAll('.cat-bar').forEach(bar => {
    bar.addEventListener('click', () => {
      const cat = bar.dataset.cat;
      const pw = zone.querySelector(`[data-cat-prods="${cssEsc(cat)}"]`);
      bar.classList.toggle('open');
      if (pw) pw.classList.toggle('open');
    });
  });
  // Bind: trend-rad → hoppa till period
  zone.querySelectorAll('[data-jump]').forEach(tr => {
    tr.addEventListener('click', () => {
      currentPeriodKey = tr.dataset.jump;
      render();
    });
  });

  // Meta
  document.getElementById('last-updated').textContent =
    `${payload.invoice_count} fakturor · uppdaterad ${new Date(payload.generated_at).toLocaleString('sv-SE')}`;

  // Varning för okänd omsättning (oklassificerade artiklar)
  const warnZone = document.getElementById('warn-zone');
  if (payload.meta && payload.meta.unknown_revenue_kr) {
    warnZone.innerHTML = `<div class="warn">⚠ ${fmtKr(payload.meta.unknown_revenue_kr)} kunde inte kategoriseras (okända artikel-ID: ${(payload.meta.unknown_ids||[]).join(', ') || '—'}). Visas i kategorin "Okänt".</div>`;
  } else {
    warnZone.innerHTML = '';
  }
}

function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function cssEsc(s) { return String(s).replace(/["\\]/g, '\\$&'); }

// ── Init + bindningar ───────────────────────────────────────────────────
function bindControls() {
  document.querySelectorAll('#view-pills .pill').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('#view-pills .pill').forEach(x => x.classList.remove('active'));
      p.classList.add('active');
      currentView = p.dataset.view;
      currentPeriodKey = null; // välj senaste i nya vyn
      sessionStorage.setItem('sk_sales_view', currentView);
      render();
    });
  });
  document.getElementById('period-select').addEventListener('change', e => {
    currentPeriodKey = e.target.value;
    render();
  });
}

let _inited = false;
async function init() {
  if (_inited) return;
  _inited = true;
  // sätt aktiv pill enligt sparat state
  document.querySelectorAll('#view-pills .pill').forEach(p =>
    p.classList.toggle('active', p.dataset.view === currentView));
  bindControls();
  try {
    payload = await loadData();
    render();
  } catch (e) {
    document.getElementById('content-zone').innerHTML =
      `<div class="empty">Kunde inte ladda försäljningsdata: ${escapeHtml(e.message)}</div>`;
  }
}
</script>
</body>
</html>
