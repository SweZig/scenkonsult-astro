---
// /admin/sven/ — Sven Analytics
---
<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow" />
  <title>Sven Analytics — Admin</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0c0a24; color: #f0eeff; font-family: 'Space Grotesk', system-ui, sans-serif; min-height: 100vh; }
    .topbar { background: rgba(30,24,80,0.97); border-bottom: 1px solid rgba(196,181,244,0.15); padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1rem; position: sticky; top: 0; z-index: 100; }
    .topbar a { color: rgba(196,181,244,0.6); font-size: 0.85rem; text-decoration: none; }
    .topbar a:hover { color: #c4b5f4; }
    .topbar h1 { font-size: 1.1rem; font-weight: 700; color: #c4b5f4; }
    .wrap { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }
    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem; }
    .stat-card { background: #1e1850; border: 1px solid rgba(196,181,244,0.15); border-radius: 12px; padding: 1rem 1.25rem; }
    .stat-val  { font-size: 2rem; font-weight: 800; color: #c4b5f4; line-height: 1; margin-bottom: 0.2rem; }
    .stat-lbl  { font-size: 0.75rem; color: rgba(255,255,255,0.60); text-transform: uppercase; letter-spacing: 0.05em; }
    .section   { background: #1e1850; border: 1px solid rgba(196,181,244,0.15); border-radius: 14px; padding: 1.25rem; margin-bottom: 1rem; }
    .sec-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(196,181,244,0.6); margin-bottom: 1rem; }
    .chart-wrap { position: relative; width: 100%; height: 160px; }
    .bar-col { display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0; }
    .bar { background: linear-gradient(180deg, #c4b5f4, #7c3aed); border-radius: 3px 3px 0 0; width: 100%; transition: opacity 0.15s; min-height: 2px; }
    .bar:hover { opacity: 0.75; }
    .bar-lbl { font-size: 0.6rem; color: rgba(255,255,255,0.60); margin-top: 4px; white-space: nowrap; }
    .bar-val  { font-size: 0.65rem; color: rgba(196,181,244,0.7); margin-bottom: 2px; }
    .q-table { width: 100%; border-collapse: collapse; }
    .q-table th { font-size: 0.72rem; color: rgba(196,181,244,0.5); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; text-align: left; padding: 0 0.75rem 0.6rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .q-table td { padding: 1rem 0.75rem; font-size: 0.83rem; border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; }
    .q-table tr:last-child td { border-bottom: none; }
    .q-table tr:hover td { background: rgba(196,181,244,0.04); }
    .q-table tr[data-session] { transition: background 0.12s; }
    .tag { display: inline-block; font-size: 0.68rem; padding: 2px 7px; border-radius: 20px; font-weight: 600; }
    .tag-co { background: rgba(59,130,246,0.15); color: #93c5fd; }
    .tag-pr { background: rgba(16,185,129,0.15); color: #6ee7b7; }
    .tag-or { background: rgba(245,158,11,0.15); color: #fcd34d; }
    .tag-un { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.60); }
    .page-tag { font-size: 0.7rem; color: rgba(255,255,255,0.60); font-family: monospace; }
    .filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .filter-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; color: rgba(255,255,255,0.6); font-size: 0.78rem; padding: 4px 12px; cursor: pointer; transition: all 0.15s; }
    .filter-btn.active { background: rgba(196,181,244,0.15); border-color: #c4b5f4; color: #c4b5f4; }
    .filter-btn:hover { border-color: rgba(196,181,244,0.4); color: rgba(196,181,244,0.8); }
    .stat-card.is-rating { display: flex; flex-direction: column; gap: 0.35rem; }
    .stat-card.is-rating .stat-val { margin-bottom: 0; }
    .stat-card.is-rating .stat-meta { font-size: 0.7rem; color: rgba(255,255,255,0.55); }
    .stat-rating-stars { font-size: 1.1rem; letter-spacing: 0.08em; line-height: 1; color: #fbbf24; text-shadow: 0 0 12px rgba(251,191,36,0.35); margin-top: 0.25rem; }
    .stat-rating-stars .empty { color: rgba(255,255,255,0.18); text-shadow: none; }

    /* Inline-badges för rating + indikatorer i tabellradern */
    .row-badges { display: inline-flex; gap: 6px; margin-left: 8px; vertical-align: middle; }
    .row-rating { display: inline-flex; align-items: center; gap: 3px; padding: 1px 8px; border-radius: 9px; font-size: 0.7rem; font-weight: 700; line-height: 1.4; }
    .row-rating.r5 { background: rgba(34,197,94,0.18); color: #86efac; }
    .row-rating.r4 { background: rgba(132,204,22,0.18); color: #bef264; }
    .row-rating.r3 { background: rgba(251,191,36,0.18); color: #fde047; }
    .row-rating.r2 { background: rgba(249,115,22,0.18); color: #fdba74; }
    .row-rating.r1 { background: rgba(239,68,68,0.18); color: #fca5a5; }
    .row-flag-forward { display: inline-block; background: rgba(196,181,244,0.18); border: 1px solid rgba(196,181,244,0.4); color: #c4b5f4; font-size: 0.65rem; font-weight: 700; padding: 1px 7px; border-radius: 9px; line-height: 1.4; }
    .row-flag-promise { display: inline-block; background: rgba(251,146,60,0.15); border: 1px solid rgba(251,146,60,0.4); color: #fdba74; font-size: 0.65rem; font-weight: 700; padding: 1px 7px; border-radius: 9px; line-height: 1.4; }
    .row-msgcount { display: inline-block; background: rgba(196,181,244,0.15); color: #c4b5f4; font-size: 0.65rem; padding: 1px 7px; border-radius: 9px; margin-left: 6px; vertical-align: middle; font-weight: 600; }

    .filter-btn small { opacity: 0.7; margin-left: 4px; font-weight: 400; }
    .reply-preview { font-size: 0.75rem; color: rgba(255,255,255,0.58); margin-top: 5px; padding-left: 0.6rem; border-left: 2px solid rgba(196,181,244,0.25); line-height: 1.45; }
    .bubble-a .sven-link { color: #c4b5f4; text-decoration: underline; text-underline-offset: 2px; }
    .bubble-a .sven-link:hover { color: #e2dcfb; }
    .bubble-a .sven-bullet { color: rgba(196,181,244,0.7); margin-right: 2px; }
    #auth-screen { position: fixed; inset: 0; background: #0c0a24; display: flex; align-items: center; justify-content: center; z-index: 999; }
    .auth-box { background: #1e1850; border: 1px solid rgba(196,181,244,0.2); border-radius: 16px; padding: 2rem; width: 320px; text-align: center; }
    .auth-box h2 { color: #c4b5f4; margin-bottom: 1.25rem; }
    .auth-input { width: 100%; background: #0c0a24; border: 1px solid rgba(196,181,244,0.2); border-radius: 8px; padding: 0.6rem 0.875rem; color: #f0eeff; font-size: 0.9rem; margin-bottom: 0.75rem; }
    .auth-btn { width: 100%; background: #c4b5f4; color: #0c0a24; font-weight: 700; border: none; border-radius: 8px; padding: 0.65rem; cursor: pointer; font-size: 0.9rem; }
    .auth-err { color: #f87171; font-size: 0.8rem; margin-top: 0.5rem; min-height: 20px; }
    .empty { padding: 2rem; text-align: center; color: rgba(255,255,255,0.60); font-size: 0.85rem; }
    .loading { padding: 2rem; text-align: center; color: rgba(196,181,244,0.5); }
    .pagination { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 0.75rem; align-items: center; }
    .pg-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; color: rgba(255,255,255,0.6); font-size: 0.8rem; padding: 4px 10px; cursor: pointer; }
    .pg-btn:disabled { opacity: 0.3; cursor: default; }
    .pg-info { font-size: 0.78rem; color: rgba(255,255,255,0.60); }

    /* ── Konversations-modal ─────────────────────────────────────── */
    .q-table tr[data-session] { cursor: pointer; }
    .q-table tr[data-session]:hover td:first-child::before { content: '👁  '; color: rgba(196,181,244,0.6); }

    .modal-backdrop { position: fixed; inset: 0; background: rgba(12,10,36,0.85); backdrop-filter: blur(4px); z-index: 200; display: none; align-items: center; justify-content: center; padding: 1rem; }
    .modal-backdrop.open { display: flex; }
    .modal-box { background: #1e1850; border: 1px solid rgba(196,181,244,0.25); border-radius: 16px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
    .modal-head { padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
    .modal-head-title { font-size: 1rem; font-weight: 700; color: #c4b5f4; margin-bottom: 0.5rem; }
    .modal-meta { display: flex; gap: 0.75rem; flex-wrap: wrap; font-size: 0.72rem; color: rgba(255,255,255,0.60); }
    .modal-meta strong { color: rgba(196,181,244,0.85); font-weight: 600; }
    .modal-close { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 1.1rem; line-height: 1; flex-shrink: 0; }
    .modal-close:hover { background: rgba(255,255,255,0.12); }
    .modal-body { padding: 1.25rem; overflow-y: auto; flex: 1; }
    .bubble-row { margin-bottom: 1rem; }
    .bubble-row:last-child { margin-bottom: 0; }
    .bubble-time { font-size: 0.65rem; color: rgba(255,255,255,0.40); margin-bottom: 4px; padding: 0 0.25rem; }
    .bubble-q { background: #0c0a24; border: 1px solid rgba(255,255,255,0.08); border-radius: 12px 12px 12px 2px; padding: 0.7rem 0.95rem; font-size: 0.88rem; color: #f0eeff; line-height: 1.5; max-width: 85%; white-space: pre-wrap; word-break: break-word; }
    .bubble-q.is-chip { background: rgba(196,181,244,0.06); font-style: italic; color: rgba(255,255,255,0.72); }
    .bubble-q-label { font-size: 0.65rem; color: rgba(196,181,244,0.55); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px; padding: 0 0.25rem; }
    .bubble-a { background: rgba(196,181,244,0.08); border: 1px solid rgba(196,181,244,0.18); border-radius: 12px 12px 2px 12px; padding: 0.7rem 0.95rem; font-size: 0.85rem; color: rgba(255,255,255,0.92); line-height: 1.5; max-width: 85%; margin-left: auto; white-space: pre-wrap; word-break: break-word; }
    .bubble-a-label { font-size: 0.65rem; color: rgba(196,181,244,0.55); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px; padding: 0 0.25rem; text-align: right; }
    .bubble-a .tag-cart, .bubble-a .tag-forward { display: inline-block; background: rgba(196,181,244,0.18); border: 1px solid rgba(196,181,244,0.35); color: #c4b5f4; font-size: 0.7rem; font-weight: 600; padding: 1px 7px; border-radius: 6px; margin: 0 2px; font-family: 'JetBrains Mono', ui-monospace, monospace; }
    .bubble-a .tag-forward { background: rgba(196,181,244,0.28); }
    .modal-banner { padding: 0.7rem 1rem; border-radius: 10px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; }
    .modal-banner.is-rating { background: rgba(196,181,244,0.08); border: 1px solid rgba(196,181,244,0.25); }
    .modal-banner.is-forward { background: rgba(196,181,244,0.10); border: 1px solid rgba(196,181,244,0.4); color: #e2dcfb; }
    .modal-banner.is-promise { background: rgba(251,146,60,0.10); border: 1px solid rgba(251,146,60,0.4); color: #fdba74; }
    .modal-banner-stars { font-size: 1.4rem; letter-spacing: 0.06em; line-height: 1; }
    .modal-banner-stars.r5 { color: #86efac; }
    .modal-banner-stars.r4 { color: #bef264; }
    .modal-banner-stars.r3 { color: #fde047; }
    .modal-banner-stars.r2 { color: #fdba74; }
    .modal-banner-stars.r1 { color: #fca5a5; }
    .modal-empty { padding: 2rem; text-align: center; color: rgba(255,255,255,0.6); font-size: 0.85rem; }
    .modal-loading { padding: 2rem; text-align: center; color: rgba(196,181,244,0.5); font-size: 0.85rem; }
  </style>
</head>
<body>

<!-- Auth-skärm -->
<div id="auth-screen">
  <div class="auth-box">
    <h2>🤖 Sven Analytics</h2>
    <input type="password" class="auth-input" id="pw-input" placeholder="Adminlösenord" autocomplete="current-password">
    <button class="auth-btn" id="pw-btn">Logga in</button>
    <div class="auth-err" id="pw-err"></div>
  </div>
</div>

<div id="main-content" style="display:none">
  <div class="topbar">
    <a href="/admin/">← Admin</a>
    <h1>🤖 Sven Analytics</h1>
  </div>
  <div class="wrap">

    <!-- Stat-kort -->
    <div class="stats-row" id="stats-row">
      <div class="stat-card"><div class="stat-val" id="s-today">–</div><div class="stat-lbl">Idag</div></div>
      <div class="stat-card"><div class="stat-val" id="s-week">–</div><div class="stat-lbl">Senaste 7 dagar</div></div>
      <div class="stat-card"><div class="stat-val" id="s-month">–</div><div class="stat-lbl">Senaste 30 dagar</div></div>
      <div class="stat-card"><div class="stat-val" id="s-avg">–</div><div class="stat-lbl">Snitt/dag (30 d)</div></div>
      <div class="stat-card is-rating">
        <div>
          <div class="stat-val" id="s-rating">–</div>
          <div class="stat-lbl">Snittbetyg</div>
        </div>
        <div class="stat-rating-stars" id="s-rating-stars">☆☆☆☆☆</div>
        <div class="stat-meta" id="s-rating-meta">Inga bedömningar än</div>
      </div>
    </div>

    <!-- Dagligt diagram -->
    <div class="section">
      <div class="sec-title">Meddelanden per dag — senaste 30 dagar</div>
      <div class="chart-wrap" id="daily-chart"><div class="loading">Laddar…</div></div>
    </div>

    <!-- Frågtabell -->
    <div class="section">
      <div class="sec-title">Inkommande frågor</div>
      <div class="filters">
        <button class="filter-btn active" data-filter="real" onclick="setFilter('real')">Specifika frågor</button>
        <button class="filter-btn" data-filter="all" onclick="setFilter('all')">Alla meddelanden</button>
        <button class="filter-btn" data-filter="chips" onclick="setFilter('chips')">Chips/knappar</button>
        <button class="filter-btn" data-filter="rated" onclick="setFilter('rated')">Med betyg <small id="ct-rated"></small></button>
        <button class="filter-btn" data-filter="lowrated" onclick="setFilter('lowrated')">Lågt betyg <small id="ct-low"></small></button>
        <button class="filter-btn" data-filter="forward" onclick="setFilter('forward')">🤖 Sven-ärenden <small id="ct-fwd"></small></button>
        <button class="filter-btn" data-filter="promise" onclick="setFilter('promise')">⚠ Otaggade löften <small id="ct-pr"></small></button>
        <select id="type-filter" style="background:#0c0a24;border:1px solid rgba(255,255,255,0.1);border-radius:20px;color:rgba(255,255,255,0.6);font-size:0.78rem;padding:4px 10px;cursor:pointer" onchange="loadLogs()">
          <option value="">Alla kundtyper</option>
          <option value="company">Företag</option>
          <option value="private">Privatperson</option>
          <option value="org">Förening/org</option>
          <option value="unknown">Okänd</option>
        </select>
      </div>
      <div id="q-loading" class="loading" style="display:none">Laddar…</div>
      <table class="q-table" id="q-table">
        <thead><tr>
          <th style="width:130px">Tid</th>
          <th>Fråga</th>
          <th style="width:90px">Kundtyp</th>
          <th style="width:120px">Sida</th>
        </tr></thead>
        <tbody id="q-tbody"><tr><td colspan="4" class="empty">Laddar…</td></tr></tbody>
      </table>
      <div class="pagination">
        <button class="pg-btn" id="pg-prev" onclick="changePage(-1)">←</button>
        <span class="pg-info" id="pg-info"></span>
        <button class="pg-btn" id="pg-next" onclick="changePage(1)">→</button>
      </div>
    </div>

  </div>
</div>

<!-- Konversations-modal -->
<div class="modal-backdrop" id="thread-modal" onclick="closeThread(event)">
  <div class="modal-box" onclick="event.stopPropagation()">
    <div class="modal-head">
      <div>
        <div class="modal-head-title">Konversation</div>
        <div class="modal-meta" id="thread-meta">–</div>
      </div>
      <button class="modal-close" onclick="closeThread()" title="Stäng (Esc)">✕</button>
    </div>
    <div class="modal-body" id="thread-body">
      <div class="modal-loading">Laddar tråd…</div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
// ── Auth (klartext-lösenord, matchar /admin/) ────────────────────────────────
const ADMIN_KEY = 'sk_admin_token';
let adminToken = sessionStorage.getItem(ADMIN_KEY) || '';

async function tryLogin(pw) {
  try {
    const res = await fetch('/api/admin-auth?_=' + Date.now(), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-cache' },
      body: JSON.stringify({ password: pw }),
    });
    const j = await res.json().catch(() => ({}));
    return !!j.ok;
  } catch (e) { return false; }
}

document.getElementById('pw-btn').onclick = async () => {
  const pw = document.getElementById('pw-input').value.trim();
  if (!pw) return;
  const ok = await tryLogin(pw);
  if (ok) {
    adminToken = pw;
    sessionStorage.setItem(ADMIN_KEY, pw);
    document.getElementById('auth-screen').style.display = 'none';
    document.getElementById('main-content').style.display = 'block';
    init();
  } else {
    document.getElementById('pw-err').textContent = 'Fel lösenord';
  }
};
document.getElementById('pw-input').addEventListener('keydown', e => { if (e.key === 'Enter') document.getElementById('pw-btn').click(); });

// ── Helpers ───────────────────────────────────────────────────────────────────
function fmtTime(ts) {
  if (!ts) return '–';
  const d = new Date(ts);
  return d.toLocaleDateString('sv-SE',{month:'short',day:'numeric'}) + ' ' +
         d.toLocaleTimeString('sv-SE',{hour:'2-digit',minute:'2-digit'});
}
function fmtDate(ts) {
  return new Date(ts).toLocaleDateString('sv-SE',{month:'short',day:'numeric'});
}
function typeTag(t) {
  if (t==='company') return '<span class="tag tag-co">Företag</span>';
  if (t==='private') return '<span class="tag tag-pr">Privat</span>';
  if (t==='org')     return '<span class="tag tag-or">Förening</span>';
  return '<span class="tag tag-un">Okänd</span>';
}

// ── State ─────────────────────────────────────────────────────────────────────
let allLogs = [];
let filter = 'real';
let page = 0;
const PAGE_SIZE = 30;

// ── Fetch ─────────────────────────────────────────────────────────────────────
async function api(fn, body) {
  const res = await fetch(`/.netlify/functions/${fn}`, {
    method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + adminToken },
    body: JSON.stringify(body),
  });
  return res.json().catch(() => ({}));
}

async function loadStats() {
  const data = await api('sven-stats', {});
  if (!data) return;
  document.getElementById('s-today').textContent  = data.today  ?? '0';
  document.getElementById('s-week').textContent   = data.week   ?? '0';
  document.getElementById('s-month').textContent  = data.month  ?? '0';
  document.getElementById('s-avg').textContent    = data.avg    ?? '0';

  // Rating-kort: värde, stjärnor och antal bedömningar
  const rEl = document.getElementById('s-rating');
  const rMeta = document.getElementById('s-rating-meta');
  const rStars = document.getElementById('s-rating-stars');
  if (data.rating && data.ratingCount > 0) {
    rEl.textContent = data.rating.toFixed(1);
    rMeta.textContent = `${data.ratingCount} bedömning${data.ratingCount === 1 ? '' : 'ar'} (30 d)`;
    const full = Math.round(data.rating);
    rStars.innerHTML = '★'.repeat(full) + '<span class="empty">' + '★'.repeat(5 - full) + '</span>';
  } else {
    rEl.textContent = '–';
    rMeta.textContent = 'Inga bedömningar än';
    rStars.innerHTML = '<span class="empty">★★★★★</span>';
  }

  renderChart(data.daily || []);
}

function renderChart(daily) {
  const wrap = document.getElementById('daily-chart');
  if (!daily.length) { wrap.innerHTML = '<div class="empty">Ingen data ännu</div>'; return; }

  // Säkerställ canvas-element
  wrap.innerHTML = '<canvas id="daily-canvas"></canvas>';
  const ctx = document.getElementById('daily-canvas');

  const labels = daily.map(d => {
    const dt = new Date(d.date);
    return dt.toLocaleDateString('sv-SE', { day: 'numeric', month: 'short' });
  });
  const counts = daily.map(d => d.count || 0);

  if (window._dailyChart) window._dailyChart.destroy();
  window._dailyChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: 'Meddelanden',
        data: counts,
        backgroundColor: 'rgba(196,181,244,0.55)',
        hoverBackgroundColor: '#c4b5f4',
        borderRadius: 4,
        borderSkipped: false,
        maxBarThickness: 22,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0c0a24',
          borderColor: 'rgba(196,181,244,0.3)',
          borderWidth: 1,
          titleColor: '#c4b5f4',
          bodyColor: '#f0eeff',
          padding: 10,
          displayColors: false,
          callbacks: { label: (c) => `${c.parsed.y} meddelande${c.parsed.y === 1 ? '' : 'n'}` }
        }
      },
      scales: {
        x: {
          ticks: { color: 'rgba(255,255,255,0.45)', font: { size: 10 }, maxRotation: 0, autoSkipPadding: 14 },
          grid: { display: false }
        },
        y: {
          beginAtZero: true,
          ticks: { color: 'rgba(255,255,255,0.45)', font: { size: 10 }, precision: 0 },
          grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false }
        }
      }
    }
  });
}

async function loadLogs() {
  document.getElementById('q-loading').style.display = 'block';
  document.getElementById('q-table').style.display = 'none';
  const customerType = document.getElementById('type-filter').value;
  const data = await api('sven-stats', { getLogs: true, customerType });
  allLogs = data.logs || [];
  page = 0;
  document.getElementById('q-loading').style.display = 'none';
  document.getElementById('q-table').style.display = 'table';
  updateFilterCounts();
  renderTable();
}

function setFilter(f) {
  filter = f;
  page = 0;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === f));
  renderTable();
}

function filteredLogs() {
  // Bas-loggar för "rated/lowrated/forward/promise" filtreras EFTER session-dedup
  // eftersom de aggregeras på sessionsnivå.
  let base;
  if (filter === 'real')       base = allLogs.filter(l => !l.is_chip);
  else if (filter === 'chips') base = allLogs.filter(l => l.is_chip);
  else                          base = allLogs;
  const sessions = dedupBySession(base);

  if (filter === 'rated')    return sessions.filter(s => s._rating);
  if (filter === 'lowrated') return sessions.filter(s => s._rating && s._rating <= 2);
  if (filter === 'forward')  return sessions.filter(s => s._forwardTag);
  if (filter === 'promise')  return sessions.filter(s => s._promiseDetected);
  return sessions;
}

// Uppdatera badge-räknare på filterknappar
function updateFilterCounts() {
  const sessions = dedupBySession(allLogs);
  const rated = sessions.filter(s => s._rating).length;
  const low   = sessions.filter(s => s._rating && s._rating <= 2).length;
  const fwd   = sessions.filter(s => s._forwardTag).length;
  const pr    = sessions.filter(s => s._promiseDetected).length;
  document.getElementById('ct-rated').textContent = rated ? `(${rated})` : '';
  document.getElementById('ct-low').textContent   = low ? `(${low})` : '';
  document.getElementById('ct-fwd').textContent   = fwd ? `(${fwd})` : '';
  document.getElementById('ct-pr').textContent    = pr ? `(${pr})` : '';
}

// Gruppera meddelanden per session_id — en rad per konversation.
// "Subject" = första frågan i konversationen. Tid = senaste aktivitet.
// Lägger till _msgCount så vi kan visa en badge i tabellen.
// Meddelanden utan session_id lämnas orörda (en rad per stycken).
function dedupBySession(logs) {
  // logs är sorterade DESC (nyaste först)
  const sessionMap = new Map(); // sid → { msgs: [] }
  const noSession  = [];

  for (const l of logs) {
    if (!l.session_id) {
      noSession.push(l);
      continue;
    }
    if (!sessionMap.has(l.session_id)) {
      sessionMap.set(l.session_id, []);
    }
    sessionMap.get(l.session_id).push(l);
  }

  const sessionRows = [];
  for (const [sid, msgs] of sessionMap) {
    // msgs är i DESC ordning (nyaste först)
    const newest = msgs[0];
    const oldest = msgs[msgs.length - 1];

    // Aggregera flaggor/rating på sessionsnivå
    const rating = msgs.find(m => m.rating !== null && m.rating !== undefined)?.rating ?? null;
    const forwardTag = msgs.find(m => m.forward_tag)?.forward_tag ?? null;
    const promiseDetected = msgs.some(m => m.promise_detected);

    sessionRows.push({
      ...newest,                         // använd nyaste meta (page, customer_type)
      message: oldest.message,           // visa första frågan som "ämne"
      reply_preview: oldest.reply_preview,
      created_at: newest.created_at,     // tid = senaste aktivitet
      _msgCount: msgs.length,
      _firstAt: oldest.created_at,
      _lastAt:  newest.created_at,
      _rating: rating,
      _forwardTag: forwardTag,
      _promiseDetected: promiseDetected,
    });
  }

  // Kombinera + sortera efter senaste aktivitet DESC
  const combined = [...sessionRows, ...noSession];
  combined.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  return combined;
}

function renderTable() {
  const logs = filteredLogs();
  const start = page * PAGE_SIZE;
  const slice = logs.slice(start, start + PAGE_SIZE);
  const tbody = document.getElementById('q-tbody');

  if (logs.length === 0) {
    tbody.innerHTML = '<tr><td colspan="4" class="empty">Inga meddelanden ännu</td></tr>';
    document.getElementById('pg-info').textContent = '';
    return;
  }

  tbody.innerHTML = slice.map(l => {
    const msgBadge = l._msgCount > 1
      ? `<span class="row-msgcount">${l._msgCount}</span>`
      : '';

    // Bygg badges (rating + forward + promise) som visas inline efter ämnet
    const badges = [];
    if (l._rating) {
      const r = l._rating;
      badges.push(`<span class="row-rating r${r}" title="Kunden gav ${r} av 5 stjärnor">${'★'.repeat(r)}<span style="opacity:0.3">${'★'.repeat(5-r)}</span></span>`);
    }
    if (l._forwardTag) {
      const labels = { offert: 'Offert', ring: 'Uppringning', fraga: 'Fråga' };
      badges.push(`<span class="row-flag-forward" title="Sven skapade ärende: ${labels[l._forwardTag]}">🤖 ${labels[l._forwardTag]}</span>`);
    }
    if (l._promiseDetected) {
      badges.push(`<span class="row-flag-promise" title="Sven lovade något utan att tagga FORWARD">⚠ Otaggat löfte</span>`);
    }
    const badgesHtml = badges.length ? `<span class="row-badges">${badges.join('')}</span>` : '';

    return `
    <tr ${l.session_id ? `data-session="${l.session_id}" onclick="openThread('${l.session_id}')"` : ''} title="${l.session_id ? 'Klicka för hela konversationen' : ''}">
      <td style="color:rgba(255,255,255,0.60);font-size:0.78rem;white-space:nowrap">${fmtTime(l.created_at)}</td>
      <td>
        <div>${escapeHtml(l.message || '–')}${msgBadge}${badgesHtml}</div>
        ${l.reply_preview ? (() => { const p = previewText(l.reply_preview); return `<div class="reply-preview">↳ ${escapeHtml(p).substring(0,140)}${p.length > 140 ? '…' : ''}</div>`; })() : ''}
      </td>
      <td>${typeTag(l.customer_type)}</td>
      <td><span class="page-tag">${(l.page_url||'–').replace('/vara-tjanster','').replace('/for/','/')}</span></td>
    </tr>`;
  }).join('');

  const total = logs.length;
  const pages = Math.ceil(total / PAGE_SIZE);
  document.getElementById('pg-info').textContent = `${start+1}–${Math.min(start+PAGE_SIZE,total)} av ${total}`;
  document.getElementById('pg-prev').disabled = page === 0;
  document.getElementById('pg-next').disabled = page >= pages - 1;
}

function changePage(dir) { page += dir; renderTable(); }

// ── Konversations-modal (klickbar rad → hela tråden) ─────────────────────────
function escapeHtml(s) {
  return String(s ?? '')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

async function openThread(sessionId) {
  if (!sessionId) return;
  const modal = document.getElementById('thread-modal');
  const body  = document.getElementById('thread-body');
  const meta  = document.getElementById('thread-meta');
  body.innerHTML = '<div class="modal-loading">Laddar tråd…</div>';
  meta.textContent = '';
  modal.classList.add('open');
  document.body.style.overflow = 'hidden';

  const data = await api('sven-stats', { getThread: true, session_id: sessionId });
  const thread = (data && data.thread) || [];

  if (!thread.length) {
    body.innerHTML = '<div class="modal-empty">Hittade inga meddelanden för denna session.</div>';
    return;
  }

  // Metadata + aggregat
  const first = thread[0];
  const last  = thread[thread.length - 1];
  const minutes = Math.round((new Date(last.created_at) - new Date(first.created_at)) / 60000);
  const pages = [...new Set(thread.map(t => t.page_url).filter(Boolean))];

  // Aggregera flaggor från hela tråden
  const rating = thread.find(t => t.rating !== null && t.rating !== undefined)?.rating ?? null;
  const forwardTag = thread.find(t => t.forward_tag)?.forward_tag ?? null;
  const promiseDetected = thread.some(t => t.promise_detected);

  meta.innerHTML = [
    `<span><strong>${thread.length}</strong> meddelanden</span>`,
    `<span>Kundtyp: ${typeTag(first.customer_type)}</span>`,
    `<span>Startade: <strong>${fmtTime(first.created_at)}</strong></span>`,
    minutes > 0 ? `<span>Längd: <strong>${minutes} min</strong></span>` : '',
    pages.length ? `<span>Sida: <strong style="font-family:monospace;font-size:0.7rem">${pages[0].replace('/vara-tjanster','').replace('/for/','/')}</strong>${pages.length > 1 ? ` (+${pages.length - 1})` : ''}</span>` : '',
    `<span style="color:rgba(255,255,255,0.4);font-family:monospace;font-size:0.65rem">${sessionId}</span>`,
  ].filter(Boolean).join(' · ');

  // Banners överst i body — rating, forward, promise
  const banners = [];
  if (rating) {
    banners.push(`<div class="modal-banner is-rating">
      <span class="modal-banner-stars r${rating}">${'★'.repeat(rating)}<span style="opacity:0.25">${'★'.repeat(5-rating)}</span></span>
      <span><strong>${rating} av 5 stjärnor</strong> — kunden betygsatte konversationen</span>
    </div>`);
  }
  if (forwardTag) {
    const fwdLabels = { offert: '✉ Offert', ring: '📞 Uppringning', fraga: '❓ Fråga' };
    banners.push(`<div class="modal-banner is-forward">
      <span style="font-size:1.2rem">🤖</span>
      <span>Sven skapade ärende: <strong>${fwdLabels[forwardTag] || forwardTag}</strong> — kunden klickade FORWARD-knappen</span>
    </div>`);
  }
  if (promiseDetected) {
    banners.push(`<div class="modal-banner is-promise">
      <span style="font-size:1.2rem">⚠</span>
      <span>Sven lovade något <strong>utan att tagga FORWARD</strong> — kontrollera om uppföljning behövs</span>
    </div>`);
  }

  // Rendera trådbubblor. Format Svens svar:
  //   [CART:...] → 🛒 pill
  //   [FORWARD:type] → 🤖 pill
  body.innerHTML = banners.join('') + thread.map(t => {
    let svenHtml = '';
    if (t.reply_preview) {
      const formatted = formatSvenReply(t.reply_preview);
      svenHtml = `
        <div class="bubble-a-label" style="margin-top:0.6rem">Sven</div>
        <div class="bubble-a">${formatted}</div>`;
    }
    return `
    <div class="bubble-row">
      <div class="bubble-time">${fmtTime(t.created_at)}${t.is_chip ? ' · 💬 chip-svar' : ''}${t.rating ? ` · ⭐ ${t.rating}/5` : ''}${t.forward_tag ? ` · 🤖 FORWARD:${t.forward_tag}` : ''}${t.promise_detected ? ' · ⚠ otaggat löfte' : ''}</div>
      <div class="bubble-q-label">Kund</div>
      <div class="bubble-q ${t.is_chip ? 'is-chip' : ''}">${escapeHtml(t.message || '–')}</div>
      ${svenHtml}
    </div>`;
  }).join('');

  body.scrollTop = 0;
}

// Kort, ren förhandsvisning för tabellraden: tar bort taggar och markdown och
// ersätter dem med små ikoner så previewen blir läsbar i stället för brusig.
function previewText(text) {
  let s = String(text || '')
    .replace(/\s*(?:\n)?\s*CHIPS:\s*\[[\s\S]*?\]\s*$/i, '')
    .replace(/\[CART:[^\]]+\]/g, '🛒')
    .replace(/\[FORWARD:(?:offert|ring|fraga)\]/gi, '🤖')
    .replace(/\[([^\]]+)\]\((?:https?:\/\/|\/)[^)\s]+\)/g, '$1') // länk → bara texten
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
  return s;
}

// Renderar Svens svarstext: escapar, tar bort CHIPS-rader (extra säkerhet om
// någon gammal logg har dem kvar) och färgkodar [CART]/[FORWARD]-taggar.
// Renderar även markdown-länkar, fetstil och punktlistor så att admin ser
// ungefär det kunden såg i widgeten — inte rå markdown.
function formatSvenReply(text) {
  // Ta bort ev. trailing CHIPS-rad om historisk data har den (nya inläggen
  // har strippats redan i backend men ev. gamla rader kan ha den kvar)
  let cleaned = String(text || '').replace(/\s*(?:\n)?\s*CHIPS:\s*\[[\s\S]*?\]\s*$/i, '').trim();
  let html = escapeHtml(cleaned);
  // Färgkoda taggar (görs FÖRE länk-regex så att URL-parentes inte krockar)
  html = html.replace(/\[CART:([^\]]+)\]/g, (_, ids) => `<span class="tag-cart" title="Sven la till produkter i varukorgen">🛒 CART:${escapeHtml(ids)}</span>`);
  html = html.replace(/\[FORWARD:(offert|ring|fraga)\]/gi, (_, t) => `<span class="tag-forward" title="Sven taggade för admin-uppföljning">🤖 FORWARD:${t}</span>`);
  // Markdown-länkar [text](/url) → klickbar <a>. Texten är redan escapad ovan,
  // så vi matchar mot escapade tecken. URL valideras grovt (intern/extern).
  html = html.replace(/\[([^\]]+)\]\(((?:https?:\/\/|\/)[^)\s]+)\)/g,
    (_, label, url) => `<a href="${url}" target="_blank" rel="noopener" class="sven-link">${label}</a>`);
  // Fetstil **text**
  html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  // Punktlistor: rader som börjar med "- " eller "• " → radbrytning med bullet
  html = html.replace(/^[\-•]\s+(.+)$/gm, '<span class="sven-bullet">•</span> $1');
  return html;
}

function closeThread(e) {
  if (e && e.target && e.target.id !== 'thread-modal' && !e.target.classList.contains('modal-close')) {
    if (e.type === 'click' && e.target.closest('.modal-box')) return;
  }
  document.getElementById('thread-modal').classList.remove('open');
  document.body.style.overflow = '';
}

// Esc stänger modalen
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && document.getElementById('thread-modal').classList.contains('open')) {
    closeThread();
  }
});

// Exponera för dynamiska onclick (Astro <script> är ES-modul)
window.openThread  = openThread;
window.closeThread = closeThread;
window.setFilter   = setFilter;
window.changePage  = changePage;
window.loadLogs    = loadLogs;

async function init() {
  await Promise.all([loadStats(), loadLogs()]);
}

// Polling var 10:e minut så nya betyg/loggar/chattar dyker upp utan
// manuell siduppdatering. Pausar när fliken är inaktiv (visibilitychange)
// för att spara API-anrop.
let _svenPollTimer = null;
function startPolling() {
  stopPolling();
  _svenPollTimer = setInterval(() => {
    // Stoppa om tråd-modalen är öppen — vi vill inte uppdatera mitt i läsning
    const modalOpen = document.getElementById('thread-modal')?.classList.contains('open');
    if (modalOpen || document.hidden) return;
    loadStats();
    loadLogs();
  }, 10 * 60 * 1000); // 10 min
}
function stopPolling() {
  if (_svenPollTimer) { clearInterval(_svenPollTimer); _svenPollTimer = null; }
}
document.addEventListener('visibilitychange', () => {
  if (document.hidden) stopPolling();
  else if (adminToken) startPolling();
});

// Auto-login om token finns
if (adminToken) {
  document.getElementById('auth-screen').style.display = 'none';
  document.getElementById('main-content').style.display = 'block';
  init().then(startPolling);
}
</script>
</body>
</html>
