---
import Layout from '../../../layouts/Layout.astro';
import KunskapBlock from '../../../components/KunskapBlock.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import KundRad from '../../../components/event/KundRad.astro';
import EventBilder from '../../../components/EventBilder.astro';
import bildData from '../../../data/bild.json';
import ljudData from '../../../data/ljud.json';
import tjansterData from '../../../data/tjanster.json';
import { KONFERENS_PAKET, KONFERENS_TILLVAL } from '../../../data/konferensPaket';
import { buildPaket3 } from '../../../utils/paket';

// Uppslag på artikelnummer i alla listor sidan läser ur (se "Katalogfilerna har två former").
const _alla: any[] = [
  ...(ljudData as any).mikrofoner ?? [],
  ...(ljudData as any).tillbehor_mikrofon ?? [],
  ...(ljudData.portable.products as any[]),
  ...bildData.products,
  ...(bildData as any).dukar ?? [],
  ...bildData.tillbehor,
  ...(tjansterData as any).services ?? [],
];
const p = (artno: string) => _alla.find((x) => x.artno === artno && x.active !== false);
const rad = (artno: string, not: string, kategori: string) => ({ produkt: p(artno), not, kategori });

const paket = buildPaket3(KONFERENS_PAKET);

const tillvalNot: Record<string, string> = {
  'SK-TJN-0002': 'Kör ljud, bild och presentationer — minst 2 timmar',
  'SK-BLD-ACC-0033': 'Växla mellan datorer och video utan svart bild',
  'SK-BLD-ACC-0030': 'Klar för presentationer, HDMI ut',
};
const tillval = KONFERENS_TILLVAL.map((a) => rad(a, tillvalNot[a], a.startsWith('SK-TJN') ? 'Tjänster' : 'Bild'));

const mikrofoner = [
  rad('SK-LJD-MIK-0023', 'Talaren rör sig fritt, händerna lediga', 'Ljud'),
  rad('SK-LJD-MIK-0024', 'Diskret headset som knappt syns på bild', 'Ljud'),
  rad('SK-LJD-MIK-0022', 'Mygga på kavajslaget — för panel och moderator', 'Ljud'),
  rad('SK-LJD-MIK-0028', 'Två talare eller moderator och gäst', 'Ljud'),
  rad('SK-LJD-MIK-0016', 'Handmikrofon för publikfrågor', 'Ljud'),
];
const bild = [
  rad('SK-BLD-0002', 'Full HD, 3 200 lumen — för de flesta rum', 'Bild'),
  rad('SK-BLD-0014', 'Full HD med inbyggd streaming', 'Bild'),
  rad('SK-BLD-0007', '4K, 3 200 lumen — för stor duk', 'Bild'),
  rad('SK-BLD-ACC-0002', 'Upp till ca 40 deltagare', 'Bild'),
  rad('SK-BLD-0010', 'Ramduk 365×210 cm — 40–100 deltagare', 'Bild'),
  rad('SK-BLD-0016', 'Ramduk 443×249 cm — 100 deltagare och fler', 'Bild'),
  rad('SK-BLD-0003', 'För ljusa rum, upp till ca 50 personer', 'Bild'),
  rad('SK-BLD-0004', 'För ljusa rum, upp till ca 80 personer', 'Bild'),
  rad('SK-BLD-ACC-0003', 'Golvstativ till 65″–85″ skärm', 'Bild'),
];
const presentation = [
  rad('SK-BLD-ACC-0031', 'Talaren ser bilden, manus och nedräkning', 'Bild'),
  rad('SK-BLD-ACC-0033', 'Fyra HDMI-ingångar, sömlösa byten', 'Bild'),
  rad('SK-BLD-ACC-0030', 'Bärbar dator för presentationer', 'Bild'),
  rad('SK-BLD-ACC-0009', 'Trådlös presenter för mindre rum', 'Bild'),
  rad('SK-BLD-ACC-0012', 'Ca 75 m räckvidd — aula och kongress', 'Bild'),
  rad('SK-BLD-ACC-0001', 'Stabilt bord för projektorn', 'Bild'),
  rad('SK-BLD-ACC-0004', 'Från talarens dator till projektorn', 'Bild'),
];
const ljud = [
  rad('SK-LJD-POR-0003', 'Kolumnhögtalare, 40–80 deltagare', 'Ljud'),
  rad('SK-LJD-POR-0004', 'Kolumnhögtalare, 60–100 deltagare', 'Ljud'),
  rad('SK-LJD-POR-0006', 'Kolumnhögtalare, 80–120 deltagare', 'Ljud'),
  rad('SK-LJD-POR-0011', 'Två kolumner, 100–240 deltagare', 'Ljud'),
];

// Från-priset är billigaste projektor eller skärm — inte ett tillbehör.
const _fran = Math.min(...bildData.products.filter((x: any) => x.active !== false).map((x: any) => x.price));

const faq = [
  { q: 'Vad ingår i konferensutrustning för ett event?', a: 'Vanligtvis behöver ni tre delar: ljud (kolumnhögtalare eller PA-system), mikrofon (trådlöst headset, mygga eller handmikrofon) och bild (projektor med duk eller storbildsskärm). Paketen ovan är tre utgångspunkter efter antal deltagare — vi justerar dem efter er lokal.' },
  { q: 'Vilken mikrofon passar bäst för konferens och föreläsning?', a: 'För en talare som rör sig fritt är trådlöst headset eller myggmikrofon bäst — händerna är fria och mikrofonen sitter nära munnen. Shure SLXD är krypterad och har ca 100 m räckvidd. För panel har vi system med två headset, och för publikfrågor en trådlös handmikrofon. Fler kanaler offereras vid behov.' },
  { q: 'Projektor eller storbildsskärm — vad ska jag välja?', a: 'Projektor med duk ger störst bild för pengarna och passar rum som går att dämpa — 100″ duk för ca 40 deltagare, 166″ upp till ca 100 och 200″ för fler. Storbildsskärm 65–75″ passar ljusa rum och mindre grupper. För scen och utomhus finns LED-vägg.' },
  { q: 'Hur får vi sömlösa byten mellan presentationer och video?', a: 'Med en bildmixer kopplas flera datorer och videokällor in samtidigt, och bilden växlar direkt utan svart skärm. Med tekniker på plats sköter vi bytena åt er under hela eventet.' },
  { q: 'Kan jag hyra konferensutrustning för bara en dag?', a: 'Ja — alla priser är per dygn och du kan hyra från ett dygn. Transport och eventuell montering tillkommer och offereras separat utifrån er adress och setup.' },
  { q: 'Levererar ni och ställer upp utrustningen?', a: 'Ja, vi levererar och hämtar i hela Storstockholm, monterar och kan ha en tekniker på plats under evenemanget. Transport, montering och tekniker tillkommer och offereras separat.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const kr = (n: number) => n.toLocaleString('sv-SE');
---
<Layout
  title="Hyra Konferensutrustning Stockholm — Mikrofon, Projektor & Ljud | Scenkonsult"
  description="Hyr konferensutrustning i Stockholm. Trådlösa mikrofoner, projektorer, storbildsskärmar och PA-system. Komplett konferensteknik från 399 kr/dygn. Leverans i hela Storstockholm. Sedan 1986."
  schemaExtra={faqSchema}
>

  <ModernHero
    bild={{ src: '/images/event/kundevent_hilton_content_creation.webp', w: 1600, h: 1200, pos: '32% 50%', alt: 'Konferenssal på Hilton i Stockholm med scen i scenkjol, kolumnhögtalare och stolsrader inför Content Creation Conference', text: 'Content Creation Conference — Hilton, Stockholm' }}
    knappar={[{ label: 'Se konferenspaketen', href: '#paket' }, { label: 'Begär offert', href: '/varukorg/' }]}
    eyebrow="Konferensutrustning · Komplett paket"
    h1="Konferensutrustning"
    h1Accent="Stockholm"
    intro="Hyr komplett konferensutrustning i Stockholm — trådlösa mikrofoner, projektor, storbildsskärm och diskret PA-ljud. Konferensteknik som fungerar från första minuten, levererad och uppställd av tekniker. AV-utrustning för 20–500 deltagare, i hela Storstockholm."
    breadcrumbs={[
      { label: 'Hem', href: '/' },
      { label: 'Våra tjänster', href: '/vara-tjanster/' },
      { label: 'Konferensutrustning' },
    ]}
    chips={[
      { html: `Från <span data-exkl="${_fran}">${kr(_fran)}</span>&nbsp;kr / dygn` },
      'Trådlösa mikrofoner',
      'Projektor & storbildsskärm',
      'Diskret PA-ljud',
      'Tekniker på plats',
      'Sedan 1986',
    ]}
  />

  <EventPaket
    eyebrow="Konferenspaket"
    rubrik="Rätt paket för er storlek"
    lead="Tre utgångspunkter efter antal deltagare. Lägg paketet i varukorgen som det är, eller begär offert så justerar vi efter lokalen."
    paket={paket}
    notis="Priserna är summan av paketets artiklar per dygn. Leverans, montering och tekniker tillkommer och offereras separat."
  />

  <ProduktRader
    eyebrow="Tillval"
    rubrik="Vi kör eventet åt er"
    lead="Tekniker på plats sköter ljud, bild och presentationsbyten från första talare till sista. Med bildmixer och våra datorer går bytena mellan talare och video utan avbrott."
    rader={tillval}
    lankar={[{ label: 'Ljudtekniker', href: '/vara-tjanster/hyra-ljudtekniker/' }]}
  />

  <ProduktRader
    id="mikrofoner"
    eyebrow="Ljud"
    rubrik="Trådlösa mikrofoner"
    lead="Shure SLXD med AES-256-kryptering och ca 100 m räckvidd — industristandard för konferens och föreläsning."
    rader={mikrofoner}
  />

  <ProduktRader
    id="projektor"
    eyebrow="Bild"
    rubrik="Projektor, duk och skärm"
    lead="Projektor med duk för stor bild i rum som går att dämpa, storbildsskärm för ljusa rum. Dukens storlek styrs av hur många som sitter längst bak."
    rader={bild}
    lankar={[{ label: 'Hela bildsortimentet', href: '/vara-tjanster/hyra-bild-projektorer-skarmar/' }]}
  />

  <ProduktRader
    id="presentation"
    eyebrow="På scenen"
    rubrik="Presentation och scenmonitor"
    lead="Scenmonitor så att talaren ser bilden, bildmixer för sömlösa byten och clickers för alla rumsstorlekar."
    rader={presentation}
  />

  <ProduktRader
    id="ljud"
    eyebrow="Ljud"
    rubrik="PA-ljud för konferens"
    lead="Diskreta kolumnhögtalare — smal design, jämn ljudspridning och minimalt eko i konferenslokalen."
    rader={ljud}
    lankar={[{ label: 'Alla kolumnhögtalare', href: '/vara-tjanster/hyra-ljud/kolumnhogtalare/' }]}
  />

  <EventBilder kategori="konferens" />

  <KundRad rubrik="Anlitade av bland annat" />

  <EventFaq rubrik="Vanliga frågor" faq={faq} />

  <SlutRuta rubrik="Berätta om er konferens — vi föreslår en lösning." text="Antal deltagare, lokal och datum räcker. Kostnadsfritt och inte bindande." />

  <KunskapBlock
    guides={[
      { href: '/for/guider/konferens-av-checklista/', label: 'Konferens AV — checklista' },
      { href: '/for/guider/hyra-tradlos-mikrofon/', label: 'Hyra trådlös mikrofon' },
      { href: '/for/guider/hyra-projektor-pris/', label: 'Hyra projektor — pris' },
      { href: '/for/guider/hur-stor-pa/', label: 'Hur stor PA behöver jag?' },
    ]}
    videos={[
      { slug: 'kontakter-ljud', label: 'Kontakter inom ljud' },
      { slug: 'kontakter-bild', label: 'Kontakter inom bild' },
      { slug: 'hur-det-fungerar', label: 'Hur det fungerar att hyra hos oss' },
    ]}
  />

</Layout>
