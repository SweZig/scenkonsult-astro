---
import Layout from '../../../layouts/Layout.astro';
import KunskapBlock from '../../../components/KunskapBlock.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ElTillbehorCard from '../../../components/ElTillbehorCard.astro';
import ScenkjolCard from '../../../components/ScenkjolCard.astro';
import CartButton from '../../../components/CartButton.astro';
import SceneConfigurator from '../../../components/SceneConfigurator.astro';
import DynamicPaketCard from '../../../components/DynamicPaketCard.astro';
import YtaJamforelse from '../../../components/YtaJamforelse.astro';
import scenData from '../../../data/scenes.json';
import EventBilder from '../../../components/EventBilder.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import { HOJDER, hojdText } from '../../../utils/scenHojder';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Scenpaket för uthyrning i Stockholm",
  "description": scenData.intro,
  "numberOfItems": scenData.products.length,
  "itemListElement": scenData.products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "name": `${p.name} – ${p.size}`,
      "description": p.description,
      "image": `https://scenkonsult.se${p.image || '/images/hero/scen3_hero.webp'}`,
      "brand": { "@type": "Brand", "name": "Scenkonsult Norden" },
      "offers": {
        "@type": "Offer",
        "price": String(p.price),
        "priceCurrency": "SEK",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "seller": { "@type": "Organization", "name": "Scenkonsult Norden" },
        "url": `https://scenkonsult.se/vara-tjanster/hyra-scen/#${p.id}`,
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "SE" },
          "shippingRate": { "@type": "MonetaryAmount", "currency": "SEK", "value": "0" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "SE",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 1,
          "returnMethod": "https://schema.org/ReturnInStore",
          "returnFees": "https://schema.org/FreeReturn"
        }
      }
    }
  }))
};
const _low = (items: any[]) => Math.min(...items.filter((x: any) => x?.price).map((x: any) => x.price));
const _heroFranExcl = _low((scenData as any).products);
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);
// Antalet scenpaket räknas ur datan — ingressen sa "Tolv" när det fanns elva.
const _ORD = ['Noll','Ett','Två','Tre','Fyra','Fem','Sex','Sju','Åtta','Nio','Tio','Elva','Tolv','Tretton','Fjorton','Femton','Sexton','Sjutton','Arton','Nitton','Tjugo'];
const _antalPaket = (scenData.products as any[]).filter((p: any) => p.active !== false).length;
const _antalPaketText = _ORD[_antalPaket] ?? String(_antalPaket);
// Alla scenkjolar (skirtHeight satt) visas i ett samlat kort i en egen sektion — inte i tillbehörsgriden.
const _skirtItems = (scenData.tillbehor as any[]).filter(t => typeof t.skirtHeight === 'number');
---

<Layout
  title={scenData.metaTitle}
  description={scenData.metaDescription}
  schemaExtra={{
    "@context": "https://schema.org",
    "@graph": [
      pageSchema,
      {
        "@type": "FAQPage",
        "mainEntity": scenData.faq.map((f: {q:string,a:string}) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  }}
>

  <!-- HERO -->
  <ModernHero
    bild={{ src: "/images/event/kundevent_tele2_scenpodie.webp", w: 1050, alt: "Scenpodie med ridå och storbild hos Tele2", text: "Tele2 — scenpodie" }}
    knappar={[{ label: "Se scenpaketen", href: "#scenpaket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="Scen · Modulär plattform"
    h1="Hyra scen i"
    h1Accent="Stockholm"
    intro={scenData.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyra scen" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "Halkfri eller slät yta",
      "Bygg din egen från 2×2 m",
      "Leverans i Storstockholm",
      "Sedan 1986",
    ]}
  />

  <!-- HUVUDSEKTION — färdiga paket först, konfigurator under -->
  <article style="background:#0c0a24;padding:clamp(2.5rem,5vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1180px;margin:0 auto;">

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- YTA-JÄMFÖRELSE — hjälper kunden välja yta innan paket/konfig    -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <YtaJamforelse />

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- FÄRDIGA SCENPAKET — snabbval                                    -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="scenpaket" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <SectionHeader
          eyebrow="Snabbval"
          h2="Färdiga scenpaket"
          leadHtml={`${_antalPaketText} färdigkomponerade scenpaket — från Small (2×2 m) till XL+ (8×6 m), inklusive paket med tak. Välj yta och antal trappor i kortet — pris och illustration uppdateras direkt. <strong>Priserna är exkl. transport och montering, som tillkommer separat.</strong> Vid scen över 16 m² sköter våra tekniker alltid montering — för säker hantering och stabilitet.`}
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {scenData.products.map(p => <DynamicPaketCard paket={p} />)}
        </div>

        <!-- Tips-banner: leder till tillbehörsavsnittet -->
        <a href="#scenkjol" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin:2.5rem 0 0;padding:1rem 1.4rem;background:rgba(196,181,244,0.07);border:1px solid rgba(196,181,244,0.22);border-radius:12px;text-decoration:none;transition:background 0.18s, border-color 0.18s;" onmouseover="this.style.background='rgba(196,181,244,0.12)';this.style.borderColor='rgba(196,181,244,0.4)'" onmouseout="this.style.background='rgba(196,181,244,0.07)';this.style.borderColor='rgba(196,181,244,0.22)'">
          <span style="display:flex;align-items:center;gap:0.7rem;color:rgba(255,255,255,0.82);font-size:0.92rem;line-height:1.5;">
            <span aria-hidden="true" style="font-size:1.15rem;line-height:1;flex-shrink:0;">💡</span>
            <span><strong style="color:white;font-weight:600;">Glöm inte tillbehören</strong> — trappor, scenkjol, backdrop, skyddsräcke och ködelare kompletterar scenen.</span>
          </span>
          <span style="display:inline-flex;align-items:center;gap:0.4rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;flex-shrink:0;">
            Se tillbehör
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
          </span>
        </a>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- SCENKONFIGURATOR — bygg din egen                                -->
      <!-- (Har egen intern eyebrow + h2 i komponenten)                    -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="scen-konfigurator" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <SceneConfigurator />
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- TILLBEHÖR                                                       -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- SCENKJOL — ett samlat kort, egen sektion                        -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="scenkjol" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <SectionHeader
          eyebrow="Tillval"
          h2="Scenkjol"
          lead="Döljer ben och teknik under scenen och ger ett färdigt intryck. Välj höjd efter scenen och modell efter look — rak för en stram front, veckad för en festligare känsla."
        />
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="lg:col-span-2"><ScenkjolCard skirts={_skirtItems} large /></div>
          <div class="skirt-info">
            <p class="skirt-info-title">Så hyr du scenkjol</p>
            <table class="skirt-info-table">
              <thead><tr><th>Höjd</th><th>Rak</th><th>Veckad</th></tr></thead>
              <tbody>
                {[20, 40, 60].map(h => {
                  const r = _skirtItems.find(x => x.skirtHeight === h && x.skirtStyle === 'rak');
                  const v = _skirtItems.find(x => x.skirtHeight === h && x.skirtStyle === 'veckad');
                  return (
                    <tr>
                      <td>{h} cm</td>
                      <td>{r ? <span><span data-exkl={r.price}>{r.price}</span> kr / {r.segmentMeters} m</span> : '—'}</td>
                      <td>{v ? <span><span data-exkl={v.price}>{v.price}</span> kr / {v.segmentMeters} m</span> : '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <p class="skirt-info-text">Kjolen hyrs i hela längder. Räkna scenens sidor och avrunda uppåt — en 6 m lång framkant behöver två raka (4 m) eller tre veckade (2 m).</p>
            <p class="skirt-info-text">Bygger du scenen i <a href="#scen-konfigurator">konfiguratorn</a> räknas kjolen ut automatiskt per sida.</p>
          </div>
        </div>
      </section>

      <section id="tillbehor" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <SectionHeader
          eyebrow="Komplettera"
          h2="Scentillbehör"
          lead="Trappor, räcken, rullstolsramp, backdrop, filtmatta, ködelare och tälttak — tillval för att färdigställa scenen efter behov."
        />
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {scenData.tillbehor.filter((a: any) => typeof a.skirtHeight !== 'number').map(a => (
            <ElTillbehorCard
              img={a.image}
              name={a.name}
              excl={a.price}
              desc={a.description}
              category="Scen tillbehör"
              artno={a.artno}
              slug={a.slug}
              priceNote={a.priceNote}
              bulky={a.bulky}
            />
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- GENERELL INFO + CTA                                             -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section style="margin-bottom:1rem;">
        <SectionHeader
          eyebrow="Bra att veta"
          h2="Generell information om våra scener"
          marginBottom="1.25rem"
        />
        <div class="scen-info">
          <div style="color:rgba(255,255,255,0.7);font-size:0.95rem;line-height:1.7;display:flex;flex-direction:column;gap:0.75rem;">
            <p>Kontakta oss för hjälp med att planera eventet så det blir optimalt. Alla scener har halkfria ytor som standard (slät yta finns för 1×2-moduler om matta läggs ovanpå) och passar för inomhus- och utomhusbruk.</p>
            <p>Scener med 1×2 m-podier finns i {hojdText(HOJDER['1x2-halkfri'] || [], 'och')} höjd — 20 cm passar som lågt podium för talare eller DJ (ingen trappa behövs). 1×1 m-podier finns i {hojdText(HOJDER['1x1-halkfri'] || [], 'och')}. Större scener (över 16 m²) kräver alltid montering av vår personal. Monteringskostnaden räknas fram i kassan utifrån scenens delar och förutsätter plant underlag (se nedan).</p>
            <p>Scentak ingår i Scenpaket Large+ inkl. tak. Som prisvärt alternativ finns tälttak 4×4 m bland tillbehören — det ställs på scenen eller intill den och ger skugga och vindskydd, men skyddar inte alltid mot regn. Övriga takkonfigurationer offereras separat — kontakta oss för specifika önskemål.</p>
            <p style="color:rgba(255,255,255,0.85);font-weight:500;">Alla priser gäller hyra per dygn (22 timmar). Hämtning från kl 13:00, återlämning innan kl 11:00 nästkommande dag. Längre perioder offereras separat.</p>
          </div>
          <div id="underlag" style="scroll-margin-top:calc(var(--nav-offset,166px) + 1rem);margin-top:1.5rem;background:rgba(196,181,244,0.07);border:1px solid rgba(196,181,244,0.3);border-left:3px solid #c4b5f4;border-radius:10px;padding:1.1rem 1.25rem;">
            <p style="font-family:'Space Grotesk',sans-serif;font-weight:700;color:white;font-size:1rem;margin:0 0 0.5rem;">Plant underlag = snabbare montering</p>
            <div style="color:rgba(255,255,255,0.72);font-size:0.92rem;line-height:1.65;display:flex;flex-direction:column;gap:0.6rem;">
              <p style="margin:0;">Monteringstiden vi räknar fram utgår från ett plant och fast underlag, till exempel asfalt, betong, trägolv eller en jämn, kortklippt gräsmatta. Är höjdskillnaden över scenens yta mer än ca 5 cm räknas underlaget som ojämnt.</p>
              <p style="margin:0;">Då använder vi justerbara ben så att scenen står säkert och plant. <strong style="color:rgba(255,255,255,0.9);">Berätta det när du bokar</strong>, så tar vi med benen och räknar in det i offerten. Upptäcker vi det först på plats kan det bli en extra leverans och längre monteringstid, som debiteras som montering.</p>
              <p style="margin:0;"><strong style="color:rgba(255,255,255,0.9);">Osäker?</strong> Skicka gärna en bild på platsen när du bokar, så berättar vi om något behöver förberedas.</p>
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.8rem;margin-top:1.5rem;align-items:center;">
            <a href="/bokningssida/" class="sk-knapp sk-knapp-p">Boka scen</a>
            <a href="/kontakt/" class="sk-knapp">Fråga om offert</a>
            <a href="/hyresvillkor/" class="scen-villkor">Läs hyresvillkoren →</a>
          </div>
        </div>
      </section>

    </div>
  </article>

  <EventBilder kategori="scen" />



  <KunskapBlock
    guides={[
    { href: "/for/guider/hur-stor-scen/", label: "Hur stor scen behöver jag?" },
    { href: "/for/guider/hyra-scen-pris/", label: "Vad kostar det att hyra scen?" },
    { href: "/for/guider/checklista-event/", label: "Komplett event-checklista" }
  ]}
    videos={[
    { slug: "hur-det-fungerar", label: "Hur det fungerar att hyra hos oss" },
    { slug: "kontakter-ljud", label: "Kontakter inom ljud" }
  ]}
  />

  <SlutRuta rubrik="Osäkra på storleken? Vi föreslår en scen." />

</Layout>

<style>
  .scen-info { max-width: 860px; border-radius: 22px; border: 1px solid rgba(255,255,255,0.1); padding: clamp(1.5rem, 3vw, 2.25rem); }
  .scen-villkor { color: rgba(255,255,255,0.6); font-size: 0.9rem; text-decoration: none; }
  .scen-villkor:hover { color: #c4b5f4; }
  .skirt-info { background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:1rem; padding:1.25rem; color:rgba(255,255,255,0.72); font-size:0.88rem; line-height:1.55; }
  .skirt-info-title { color:white; font-weight:700; font-size:1rem; margin:0 0 0.75rem; }
  .skirt-info-table { width:100%; border-collapse:collapse; margin-bottom:0.9rem; font-size:0.82rem; }
  .skirt-info-table th { text-align:left; color:rgba(255,255,255,0.55); font-family:'Space Grotesk',sans-serif; font-size:0.66rem; letter-spacing:0.08em; text-transform:uppercase; padding:0 0 0.4rem; border-bottom:1px solid rgba(255,255,255,0.1); }
  .skirt-info-table td { padding:0.45rem 0; border-bottom:1px solid rgba(255,255,255,0.06); }
  .skirt-info-table td:first-child { color:white; font-weight:600; }
  .skirt-info-text { margin:0 0 0.6rem; }
  .skirt-info-text a { color:#c4b5f4; text-decoration:underline; }
</style>
