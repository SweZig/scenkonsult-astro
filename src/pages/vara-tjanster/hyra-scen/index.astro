---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ElTillbehorCard from '../../../components/ElTillbehorCard.astro';
import CartButton from '../../../components/CartButton.astro';
import SceneConfigurator from '../../../components/SceneConfigurator.astro';
import DynamicPaketCard from '../../../components/DynamicPaketCard.astro';
import scenData from '../../../data/scenes.json';

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Scenpaket för uthyrning i Stockholm",
  "description": scenData.intro,
  "numberOfItems": scenData.products.length,
  "itemListElement": scenData.products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "name": `${p.name} – ${p.size}`,
      "description": p.description,
      "image": `https://scenkonsult.se${p.image || '/images/hero/scen3_hero.webp'}`,
      "brand": { "@type": "Brand", "name": "Scenkonsult Norden" },
      "offers": {
        "@type": "Offer",
        "price": String(p.price),
        "priceCurrency": "SEK",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "seller": { "@type": "Organization", "name": "Scenkonsult Norden" },
        "url": `https://scenkonsult.se/vara-tjanster/hyra-scen/#${p.id}`,
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "SE" },
          "shippingRate": { "@type": "MonetaryAmount", "currency": "SEK", "value": "0" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "SE",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 1,
          "returnMethod": "https://schema.org/ReturnInStore",
          "returnFees": "https://schema.org/FreeReturn"
        }
      }
    }
  }))
};
---

<Layout
  title={scenData.metaTitle}
  description={scenData.metaDescription}
  schemaExtra={{
    "@context": "https://schema.org",
    "@graph": [
      pageSchema,
      {
        "@type": "FAQPage",
        "mainEntity": scenData.faq.map((f: {q:string,a:string}) => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      }
    ]
  }}
>

  <!-- HERO — LED-stil: inline gradient + eyebrow + serif h1 + pris-chips -->
  <div style="background:linear-gradient(135deg,#1e1850 0%,#0c0a24 60%);padding-top:calc(36px + 130px + clamp(2rem,4vw,3.5rem));padding-bottom:clamp(2.5rem,5vw,4rem);padding-inline:clamp(1rem,5vw,5rem);position:relative;overflow:hidden;">
    <div style="max-width:920px;margin:0 auto;position:relative;z-index:2;">
      <nav aria-label="Brödsmulor" style="margin-bottom:1.5rem;">
        <ol style="display:flex;flex-wrap:wrap;gap:0.35rem;list-style:none;margin:0;padding:0;font-size:0.78rem;color:rgba(255,255,255,0.60);">
          <li><a href="/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Hem</a> <span style="opacity:0.3;">/</span></li>
          <li><a href="/vara-tjanster/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Våra tjänster</a> <span style="opacity:0.3;">/</span></li>
          <li style="color:white;">Hyra scen</li>
        </ol>
      </nav>
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.6rem;">Scen · Modulär plattform</p>
      <h1 style="font-family:'DM Serif Display',serif;font-size:clamp(2rem,5vw,3.25rem);line-height:1.1;color:white;margin:0 0 1rem;">Hyra scen i <span style="color:#c4b5f4;font-style:italic;">Stockholm</span></h1>
      <p style="color:rgba(255,255,255,0.6);font-size:clamp(0.95rem,2vw,1.1rem);line-height:1.75;margin:0 0 1.25rem;">{scenData.intro}</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Från <span class="sk-price-excl">400 kr</span><span class="sk-price-incl hidden">500 kr</span> / dygn</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Halkfri eller slät yta</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Bygg din egen från 2×2 m</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Leverans i Storstockholm</span>
      </div>
    </div>
  </div>

  <!-- HUVUDSEKTION — färdiga paket först, konfigurator under -->
  <article style="background:#0c0a24;padding:clamp(2.5rem,5vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1180px;margin:0 auto;">

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- FÄRDIGA SCENPAKET — snabbval                                    -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="scenpaket" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 0.6rem;">Snabbval</p>
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,3.5vw,2.2rem);color:white;margin:0 0 0.75rem;line-height:1.2;">Färdiga scenpaket</h2>
        <p style="color:rgba(255,255,255,0.6);font-size:0.95rem;line-height:1.7;margin:0 0 2rem;max-width:760px;">Tolv färdigkomponerade scenpaket — från Small (2×2 m) till XL+ (8×6 m), inklusive paket med tak. Välj yta och antal trappor i kortet — pris och illustration uppdateras direkt. <strong style="color:rgba(255,255,255,0.78);">Priserna är exkl. transport och montering, som tillkommer separat.</strong> Vid scen över 16 m² sköter våra tekniker alltid montering — för säker hantering och stabilitet.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {scenData.products.map(p => <DynamicPaketCard paket={p} />)}
        </div>

        <!-- Tips-banner: leder till tillbehörsavsnittet -->
        <a href="#tillbehor" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin:2.5rem 0 0;padding:1rem 1.4rem;background:rgba(196,181,244,0.07);border:1px solid rgba(196,181,244,0.22);border-radius:12px;text-decoration:none;transition:background 0.18s, border-color 0.18s;" onmouseover="this.style.background='rgba(196,181,244,0.12)';this.style.borderColor='rgba(196,181,244,0.4)'" onmouseout="this.style.background='rgba(196,181,244,0.07)';this.style.borderColor='rgba(196,181,244,0.22)'">
          <span style="display:flex;align-items:center;gap:0.7rem;color:rgba(255,255,255,0.82);font-size:0.92rem;line-height:1.5;">
            <span aria-hidden="true" style="font-size:1.15rem;line-height:1;flex-shrink:0;">💡</span>
            <span><strong style="color:white;font-weight:600;">Glöm inte tillbehören</strong> — trappor, scenkjol, backdrop, skyddsräcke och ködelare kompletterar scenen.</span>
          </span>
          <span style="display:inline-flex;align-items:center;gap:0.4rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;flex-shrink:0;">
            Se tillbehör
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
          </span>
        </a>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- SCENKONFIGURATOR — bygg din egen                                -->
      <!-- (Har egen intern eyebrow + h2 i komponenten)                    -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="scen-konfigurator" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <SceneConfigurator />
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- TILLBEHÖR                                                       -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="tillbehor" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 0.6rem;">Komplettera</p>
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,3.5vw,2.2rem);color:white;margin:0 0 0.75rem;line-height:1.2;">Scentillbehör</h2>
        <p style="color:rgba(255,255,255,0.6);font-size:0.95rem;line-height:1.7;margin:0 0 2rem;max-width:720px;">Trappor, scenkjol, backdrop, skyddsräcke och ködelare — tillval för att färdigställa scenen efter behov.</p>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {scenData.tillbehor.map(a => (
            <ElTillbehorCard
              img={a.image}
              name={a.name}
              excl={a.price}
              desc={a.description}
              category="Scen tillbehör"
              artno={a.artno}
              slug={a.slug}
            />
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- GENERELL INFO + CTA                                             -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section style="margin-bottom:1rem;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 0.6rem;">Bra att veta</p>
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,3.5vw,2.2rem);color:white;margin:0 0 1.25rem;line-height:1.2;">Generell information om våra scener</h2>
        <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:clamp(1.5rem,3vw,2rem);max-width:820px;">
          <div style="color:rgba(255,255,255,0.7);font-size:0.95rem;line-height:1.7;display:flex;flex-direction:column;gap:0.75rem;">
            <p>Kontakta oss för hjälp med att planera eventet så det blir optimalt. Alla scener har halkfria ytor som standard (slät yta finns för 1×2-moduler om matta läggs ovanpå) och passar för inomhus- och utomhusbruk.</p>
            <p>Standardhöjder är 40 cm eller 60 cm. Större scener (över 16 m²) kräver alltid montering av vår personal — beräknad uppställningstid är ca 15 min per modul.</p>
            <p>Scentak finns till våra större paket (Medium+ inkl. tak, Large+ inkl. tak). Övriga konfigurationer offereras separat — kontakta oss för specifika önskemål.</p>
            <p style="color:rgba(255,255,255,0.85);font-weight:500;">Alla priser gäller hyra per dygn (22 timmar). Hämtning från kl 13:00, återlämning innan kl 11:00 nästkommande dag. Längre perioder offereras separat.</p>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:0.8rem;margin-top:1.5rem;align-items:center;">
            <a href="/bokningssida/" style="background:#c4b5f4;color:#0c0a24;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.85rem;letter-spacing:0.05em;padding:0.75rem 1.5rem;border-radius:10px;text-decoration:none;transition:background 0.15s;" onmouseover="this.style.background='#e2dcfb'" onmouseout="this.style.background='#c4b5f4'">Boka scen</a>
            <a href="/kontakt/" style="border:1px solid rgba(255,255,255,0.3);color:white;font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:0.85rem;padding:0.75rem 1.5rem;border-radius:10px;text-decoration:none;transition:background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background='transparent'">Fråga om offert</a>
            <a href="/hyresvillkor/" style="color:rgba(255,255,255,0.55);font-size:0.85rem;text-decoration:none;transition:color 0.15s;" onmouseover="this.style.color='#c4b5f4'" onmouseout="this.style.color='rgba(255,255,255,0.55)'">Läs hyresvillkoren →</a>
          </div>
        </div>
      </section>

    </div>
  </article>


  <!-- Guider & resurser -->
  <section style="background:#0c0a24;border-top:1px solid rgba(255,255,255,0.06);padding:2.5rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1.25rem;">📖 Guider för scen</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
        <a href="/for/guider/hur-stor-scen/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hur stor scen behöver du?</a>
        <a href="/for/guider/hyra-scen-pris/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hyra scen — vad kostar det?</a>
        <a href="/for/guider/dj-eller-liveband/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>DJ eller liveband?</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
