---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import CartButton from '../../../components/CartButton.astro';
import ProductCard from '../../../components/ProductCard.astro';
import karaoke from '../../../data/karaoke.json';
import bild from '../../../data/bild.json';
import ljud from '../../../data/ljud.json';
import ljus from '../../../data/ljus.json';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": karaoke.faq.map((f: { q: string; a: string }) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

// Lös upp tillbehörsreferenser från sina källfiler.
// Söker rekursivt i respektive JSON efter matchande artno.
function findByArtno(obj: any, target: string): any {
  if (obj && typeof obj === 'object') {
    if (obj.artno === target) return obj;
    for (const v of Object.values(obj)) {
      const r = findByArtno(v, target);
      if (r) return r;
    }
  } else if (Array.isArray(obj)) {
    for (const v of obj) {
      const r = findByArtno(v, target);
      if (r) return r;
    }
  }
  return null;
}
const sourceMap: Record<string, any> = { bild, ljud, ljus };
const tillbehor = karaoke.tillbehor
  .map((ref: { source: string; artno: string }) => {
    const src = sourceMap[ref.source];
    const obj = src ? findByArtno(src, ref.artno) : null;
    return obj ? { ...obj, _category: ref.source } : null;
  })
  .filter(Boolean);
---
<Layout
  schemaExtra={faqSchema}
  title={karaoke.metaTitle}
  description={karaoke.metaDescription}
>

  <ModernHero
    eyebrow="Karaoke · Singa-integration"
    h1="Hyr karaoke-utrustning i"
    h1Accent="Stockholm"
    intro={karaoke.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyr karaoke-utrustning" }
    ]}
    chips={[
      { html: 'Från <span class="sk-price-excl">699 kr</span><span class="sk-price-incl hidden">874 kr</span> / dygn' },
      "6 färdiga paket",
      "Trådlösa mikar",
      "80 000+ låtar via Singa",
      "Sångtexter på skärm",
    ]}
  />

  <!-- Snabbnavigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-6">
    <div class="flex flex-wrap gap-3 text-xs text-gray-300 items-center">
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        🎤 Paket från
        <span class="sk-price-excl font-semibold text-brand-orange">699 kr</span>
        <span class="sk-price-incl hidden font-semibold text-brand-orange">874 kr</span>
        /dygn
      </span>
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        📺 Med 65″ skärm från
        <span class="sk-price-excl font-semibold text-brand-orange">4 999 kr</span>
        <span class="sk-price-incl hidden font-semibold text-brand-orange">6 249 kr</span>
        /dygn
      </span>
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        🚚 Leverans i Stockholm
      </span>
      <a href="#karaoke-tillbehor" class="ml-auto text-brand-orange/80 hover:text-brand-orange text-xs font-semibold transition-colors flex items-center gap-1">
        Tillbehör ↓
      </a>
    </div>
  </div>

  <!-- KARAOKEPAKET -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="mb-6">
      <SectionHeader eyebrow="Snabbval" h2="Kompletta karaokepaket" lead="Sex färdiga paket — välj efter publik och ambitionsnivå. Resa tillkommer." />
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {karaoke.packages.map(pkg => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl overflow-hidden flex flex-col hover:border-brand-orange/50 transition-colors">
          <!-- Bild -->
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img
              src={pkg.image}
              alt={pkg.name}
              width="1024"
              height="853"
              loading="lazy"
              class="w-full h-full object-contain"
            />
          </div>
          <!-- Innehåll -->
          <div class="p-5 flex flex-col flex-1">
            <div class="mb-3">
              <div class="text-brand-orange/80 text-xs font-semibold uppercase tracking-wide mb-1">{pkg.tagline}</div>
              <h3 class="text-white font-bold text-lg">{pkg.name}</h3>
            </div>
            <ul class="space-y-1.5 mb-4 flex-1">
              {pkg.includes.map(item => (
                <li class="flex gap-2 text-xs text-gray-300">
                  <span class="text-green-400 shrink-0">✓</span>{item}
                </li>
              ))}
            </ul>
            <div class="border-t border-white/10 pt-3 mt-auto">
              <div class="mb-3">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{pkg.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{pkg.priceInkl.toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs ml-1">/dygn</span>
              </div>
              <CartButton
                id={pkg.artno}
                name={pkg.name}
                price={pkg.price}
                category="Karaoke"
                size="md"
                image={pkg.image}
                forceLeverans={pkg.forceLeverans}
              />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SINGA KARAOKE-APP -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="bg-gradient-to-br from-[#2a1e50] to-[#1e1850] border border-brand-orange/20 rounded-2xl p-6 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-6 items-start">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🎵</span>
            <h2 class="text-xl sm:text-2xl font-bold text-white">{karaoke.singa.title}</h2>
          </div>
          <p class="text-gray-300 text-sm leading-relaxed mb-5 max-w-3xl">{karaoke.singa.intro}</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 mb-5">
            {karaoke.singa.bullets.map(b => (
              <li class="flex gap-2 text-xs text-gray-300">
                <span class="text-brand-orange shrink-0">▸</span>{b}
              </li>
            ))}
          </ul>
          <div class="bg-white/5 border border-white/10 rounded-xl p-4 mb-4">
            <p class="text-gray-200 text-xs font-semibold mb-2 uppercase tracking-wide">{karaoke.singa.step_title}</p>
            <ol class="space-y-1.5">
              {karaoke.singa.steps.map((s, i) => (
                <li class="flex gap-2 text-xs text-gray-300">
                  <span class="text-brand-orange font-bold shrink-0">{i + 1}.</span>{s}
                </li>
              ))}
            </ol>
          </div>
          <p class="text-gray-400 text-xs italic">{karaoke.singa.note}</p>
        </div>
        <div class="flex flex-col gap-2 lg:min-w-[180px]">
          {karaoke.singa.links.map(l => (
            <a href={l.url} target="_blank" rel="noopener" class="bg-brand-orange hover:bg-brand-orange-light text-brand-dark text-xs font-semibold px-4 py-2.5 rounded-lg text-center transition-colors">
              {l.label} →
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TILLBEHÖR -->
  <section id="karaoke-tillbehor" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="mb-6">
      <SectionHeader eyebrow="Komplettera" h2="Bra tillbehör till karaokepaketet" lead="Lägg till efter behov — projektorduk om du saknar fri vägg, ljuspaket för fest-känslan." />
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {tillbehor.map(t => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={t.image} alt={t.name} width="1024" height="853" loading="lazy"
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 flex flex-col flex-1">
            <h3 class="font-bold text-white text-xs mb-2 leading-tight">{t.name}</h3>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-2 gap-2">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-sm">{t.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-sm">{Math.round(t.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-[10px]">/dygn</span>
              </div>
              <CartButton id={t.artno} name={t.name} price={t.price} category="Tillbehör" size="sm" iconOnly={true} image={t.image} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader eyebrow="Vanliga frågor" h2="Vanliga frågor om karaokeuthyrning" marginBottom="1.5rem" />
    <div class="space-y-3">
      {karaoke.faq.map(f => (
        <details class="bg-brand-navy border border-white/10 rounded-xl overflow-hidden group">
          <summary class="px-5 py-4 text-white font-semibold cursor-pointer text-sm hover:text-brand-orange transition-colors list-none flex justify-between items-center">
            {f.q}
            <span class="text-brand-orange text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-gray-400 text-sm leading-relaxed border-t border-white/10 pt-3">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Guider -->
  <section style="background:#0c0a24;border-top:1px solid rgba(255,255,255,0.06);padding:2.5rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1.25rem;">📖 Relaterade guider</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
          <a href="/for/guider/hur-stor-pa/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hur stor PA-anläggning?</a>
          <a href="/for/guider/ljussattning-tips/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljussättning för fest</a>
          <a href="/for/guider/checklista-event/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Komplett event-checklista</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
