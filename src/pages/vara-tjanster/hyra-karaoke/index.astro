---
import Layout from '../../../layouts/Layout.astro';
import KunskapBlock from '../../../components/KunskapBlock.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import KaraokeBuilder from '../../../components/KaraokeBuilder.astro';
import karaoke from '../../../data/karaoke.json';
import bild from '../../../data/bild.json';
import ljud from '../../../data/ljud.json';
import ljus from '../../../data/ljus.json';
import dj from '../../../data/dj.json';
import scenes from '../../../data/scenes.json';
import tjanster from '../../../data/tjanster.json';
import el from '../../../data/el.json';
import { resolveBuilder, minTotal } from '../../../lib/karaoke-builder.mjs';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": karaoke.faq.map((f: { q: string; a: string }) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

// Från-pris = billigaste möjliga uppsättning i byggaren (räknas ur datafilerna)
const _resolved = resolveBuilder(karaoke, { karaoke, ljud, ljus, bild, dj, scenes, tjanster, el });
const _heroFranExcl = minTotal(_resolved);
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);
const _fran = _heroFranExcl.toLocaleString('sv-SE');
---
<Layout
  schemaExtra={faqSchema}
  title={karaoke.metaTitle.replace('{fran}', _fran)}
  description={karaoke.metaDescription.replace('{fran}', _fran)}
>

  <ModernHero
    bild={{ src: "/images/tjanster/plugg_karaoke_sang.webp", w: 819, alt: "Kvinna sjunger karaoke med mikrofon under neonskylt" }}
    knappar={[{ label: "Bygg er karaoke", href: "#bygg" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="Karaoke · Singa-integration"
    h1="Hyr karaoke-utrustning i"
    h1Accent="Stockholm"
    intro={karaoke.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyr karaoke-utrustning" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "Bygg själv eller välj snabbval",
      "Trådlösa mikar",
      "80 000+ låtar via Singa",
      "Sångtexter på skärm",
    ]}
  />

  <KaraokeBuilder />

  <!-- SINGA KARAOKE-APP -->
  <section class="sk-band">
    <div class="ka-singa">
      <div>
        <p class="sk-eyebrow">Låtarna</p>
        <h2 class="sk-h2">{karaoke.singa.title}</h2>
        <p class="ka-lead">{karaoke.singa.intro}</p>
        <div class="ka-lankar">
          {karaoke.singa.links.map((l: any) => <a href={l.url} target="_blank" rel="noopener" class="sk-knapp">{l.label} →</a>)}
        </div>
      </div>
      <div>
        <ul class="ka-punkter">{karaoke.singa.bullets.map((b: string) => <li>{b}</li>)}</ul>
        <div class="ka-steg">
          <p>{karaoke.singa.step_title}</p>
          <ol>{karaoke.singa.steps.map((st: string, i: number) => <li><span>{String(i + 1).padStart(2, '0')}</span>{st}</li>)}</ol>
        </div>
        <p class="ka-not">{karaoke.singa.note}</p>
      </div>
    </div>
  </section>

  <EventFaq rubrik="Vanliga frågor om karaokeuthyrning" faq={karaoke.faq} />

  <KunskapBlock
    guides={[
    { href: "/for/guider/hyra-tradlos-mikrofon/", label: "Hyra trådlös mikrofon" },
    { href: "/for/guider/ljud-foretagsfest/", label: "Ljud till företagsfest" },
    { href: "/for/guider/hur-stor-pa/", label: "Hur stor PA behöver jag?" },
    { href: "/for/guider/ljussattning-tips/", label: "Ljussättning för fest" },
    { href: "/for/guider/checklista-event/", label: "Komplett event-checklista" }
  ]}
    videos={[
    { slug: "kontakter-ljud", label: "Kontakter inom ljud" },
    { slug: "koppla-in-ljudsystem", label: "Koppla in ett hyrt ljudsystem" },
    { slug: "hur-det-fungerar", label: "Hur det fungerar att hyra hos oss" }
  ]}
  />

  <SlutRuta rubrik="Osäkra på vad ni behöver? Vi sätter ihop er karaoke." />

</Layout>

<style>
  .ka-singa { max-width: 80rem; margin: 0 auto; padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .ka-lead { margin: 1rem 0 0; color: rgba(255,255,255,0.72); line-height: 1.6; }
  .ka-lankar { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .ka-punkter { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; overflow: hidden; }
  .ka-punkter li { background: #110f30; padding: 1rem 1.15rem; color: rgba(255,255,255,0.82); font-size: 0.95rem; line-height: 1.45; }
  .ka-punkter li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .ka-steg { margin-top: 1.25rem; border-left: 3px solid #c4b5f4; padding: 0.25rem 0 0.25rem 1.25rem; }
  .ka-steg > p { margin: 0 0 0.6rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #c4b5f4; }
  .ka-steg ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .ka-steg li { display: grid; grid-template-columns: 2rem 1fr; color: rgba(255,255,255,0.8); font-size: 0.95rem; }
  .ka-steg li span { font-family: 'Space Grotesk', sans-serif; font-weight: 700; color: #c4b5f4; }
  .ka-not { margin: 1rem 0 0; font-size: 0.88rem; font-style: italic; color: rgba(255,255,255,0.55); }
  @media (max-width: 900px) { .ka-singa { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .ka-punkter { grid-template-columns: minmax(0, 1fr); } }
</style>
