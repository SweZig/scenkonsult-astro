---
import LjudLjusPromo from '../../../components/LjudLjusPromo.astro';
import KunskapBlock from '../../../components/KunskapBlock.astro';
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import KategoriKort from '../../../components/KategoriKort.astro';
import ljusData from '../../../data/ljus.json';
import elData from '../../../data/el.json';
import tjanster from '../../../data/tjanster.json';
import PopularaPaket from '../../../components/PopularaPaket.astro';
import EventBilder from '../../../components/EventBilder.astro';
import LeveransMonteringEl from '../../../components/LeveransMonteringEl.astro';

// Praktiska frågor — belopp och gästantal läses ur datafilerna, aldrig handskrivna.
const _fmt = (n: number) => n.toLocaleString('sv-SE').replace(/\u00a0/g, ' ');
const _ljusProd = (a: string) => (ljusData as any).paket.products.find((p: any) => p.artno === a);
const _gaster = (a: string) => (String(_ljusProd(a)?.persons ?? '').match(/\d+/g) ?? ['0']).map(Number);
const _maxGaster = (a: string) => Math.max(..._gaster(a));
const _minGaster = (a: string) => Math.min(..._gaster(a));
const _elverk = (elData as any).products.find((p: any) => p.artno === 'SK-EL-0012')?.price;
const _lev = (tjanster as any).leverans;
const praktiskFaq = [
  { q: "Hur mycket ljus behöver vi till vår fest?", a: `Utgå från hur många ni blir. Ett stativ med effekter räcker till ${_maxGaster('SK-LJS-PAK-0018')}–${_maxGaster('SK-LJS-PAK-0001')} gäster, två stativ (Duo) till ungefär ${_maxGaster('SK-LJS-PAK-0022')}, och från ${_minGaster('SK-LJS-PAK-0007')} gäster väljer ni Large med moving heads och tross. Gästantalet står på varje paket. Vill ni ha ljud också svarar ni på tre frågor på sidan Hyra ljud och ljus, så får ni ett färdigt förslag.` },
  { q: "Räcker ett vanligt eluttag till ljuset?", a: `Ja, i de flesta fall räcker ett vanligt 10 A-uttag. Hyr ni ett stort paket med både ljud, ljus och rök rekommenderar vi att ni tar el från minst två olika eluttag på olika faser. Utomhus utan el hyr ni ett elverk från ${_fmt(_elverk)} kr/dygn exkl. moms.` },
  { q: "När kan vi hämta och lämna tillbaka utrustningen?", a: `Ett hyresdygn är 22 timmar: hämtning i Vällingby från kl 13:00 och återlämning senast kl 11:00 nästa dag. Vill ni ha det levererat kör vi ut och hämtar i hela Storstockholm – från ${_fmt(_lev.standard.pris)} kr tur och retur exkl. moms, och fordonet väljs efter vad ni hyr.` },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Hyra ljus Stockholm – paket och effekter",
  "description": ljusData.intro,
  "numberOfItems": ljusData.categories.length,
  "itemListElement": ljusData.categories.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": c.name,
      "url": `https://scenkonsult.se/vara-tjanster/hyra-ljus/${c.slug}/`
    }
  }))
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [...ljusData.faq, ...praktiskFaq].map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
const _low = (items: any[]) => Math.min(...items.filter((x: any) => x?.price).map((x: any) => x.price));
const _heroFranExcl = _low(((ljusData as any).paket.products ?? []).filter((p: any) => p.active !== false));
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);
---

<Layout title={ljusData.metaTitle} description={ljusData.metaDescription} schemaExtra={[pageSchema, faqSchema]}>

  <ModernHero
    bild={{ src: "/images/event/installation_german_beerhall_1.webp", w: 1050, alt: "Blått ljus och LED-ramper i taket på German Beer Hall", text: "German Beer Hall" }}
    knappar={[{ label: "Se ljuspaketen", href: "#sortiment" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="Ljus · Effekt & atmosfär"
    h1="Hyra ljus i"
    h1Accent="Stockholm"
    intro={ljusData.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyra ljus" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "Färdiga paket – plug & play",
      "DMX med automatisk eller manuell styrning",
      "Tekniker tillgänglig",
      "Leverans i Storstockholm",
    ]}
  />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader id="sortiment" eyebrow="Sortiment" h2="Välj typ av ljus" lead="Färdiga paket, lösa effekter, rök och stativ — allt går att kombinera." />
    <KategoriKort data={ljusData} />
  </section>

  <LjudLjusPromo />

  <PopularaPaket data={ljusData} kategori="ljus" category="Ljus" />

  <EventBilder kategori="ljus" />

  <LeveransMonteringEl data={ljusData} typ="ljus" exempel={['SK-LJS-PAK-0001', 'SK-LJS-PAK-0023', 'SK-LJS-PAK-0007']} />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="border border-white/10 rounded-3xl p-8" style="background:#14113a">
      <h2 class="sk-h2s mb-4">Vad ingår alltid?</h2>
      <div class="text-gray-400 text-sm leading-relaxed space-y-3">
        <p>Alla ljuspaket levereras komplett med stativer, kablar och adaptrar – testat och kalibrerat. Färdiga festpaket har automatiska program som kör sig självt, utan behov av ljustekniker.</p>
        <p>Vill du ha mer kontroll finns DMX-kontroller att hyra, och vi erbjuder ljustekniker för professionella events. Vi levererar till hela Storstockholm.</p>
        <p class="font-medium text-gray-300">Alla priser gäller per dygn (22 timmar). Hämtning från kl 13:00, återlämning innan kl 11:00 nästa dag.</p>
      </div>
      <div class="flex flex-wrap gap-4 mt-6">
        <a href="/bokningssida/" class="sk-knapp sk-knapp-p">Boka ljusutrustning</a>
        <a href="/kontakt/" class="sk-knapp">Fråga om offert</a>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader eyebrow="Vanliga frågor" h2="Vanliga frågor om ljushyrning" />
    <div class="space-y-4">
      {[...ljusData.faq, ...praktiskFaq].map(f => (
        <details class="bg-brand-navy border border-white/10 rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-white hover:text-brand-orange transition-colors list-none">
            {f.q}
            <span class="text-brand-orange ml-4 shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="px-5 pb-5 text-gray-400 text-sm leading-relaxed border-t border-white/10 pt-4">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-brand-navy border-t border-white/10 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl text-white mb-6" style="font-family:'DM Serif Display',serif;">Komplettera med</h2>
      <div class="flex flex-wrap gap-4">
        <a href="/vara-tjanster/hyra-ljud-och-ljus/" class="border border-brand-orange/60 text-white hover:bg-brand-orange hover:text-brand-dark px-5 py-3 rounded-xl text-sm font-semibold transition-all">✨ Hyra ljud och ljus i ett paket</a>
        <a href="/vara-tjanster/hyra-scen/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🎭 Hyra scen</a>
        <a href="/vara-tjanster/hyra-ljud/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🔊 Hyra ljud</a>
        <a href="/vara-tjanster/hyra-dj/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🎛 Hyra DJ-utrustning</a>
        <a href="/vara-tjanster/hyra-bild/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">📽 Hyra bild</a>
      </div>
    </div>
  </section>



  <KunskapBlock
    guides={[
    { href: "/for/guider/dmx-styrning-guide/", label: "DMX-styrning — komplett guide" },
    { href: "/for/guider/ljussattning-tips/", label: "Ljussättningstips för event" },
    { href: "/for/guider/hyra-uplights/", label: "Hyra uplights — guide" },
    { href: "/for/guider/hyra-rokmaskin/", label: "Hyra rökmaskin" },
    { href: "/for/guider/ljus-brollop/", label: "Ljus till bröllop" }
  ]}
    videos={[
    { slug: "led-teknik", label: "LED-teknik — egenskaper & funktioner" },
    { slug: "hur-det-fungerar", label: "Hur det fungerar att hyra hos oss" }
  ]}
  />

</Layout>
