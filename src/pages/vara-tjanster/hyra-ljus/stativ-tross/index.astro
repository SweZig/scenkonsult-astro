---
import Layout from '../../../../layouts/Layout.astro';
import CategoryHero from '../../../../components/CategoryHero.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import ljusData from '../../../../data/ljus.json';
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": ljusData.stativ.faq.map((f: {q:string,a:string}) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

---
<Layout
  schemaExtra={faqSchema}
  title="Hyr Ljusstativ & Trosstorn Stockholm – T-bar, Tross & Traverser | Scenkonsult"
  description="Hyr ljusstativ med T-bar, vevstativ, trosstorn och trossryggar i Stockholm. Stativ fr 40 kr/dygn, trossbåge fr 1500 kr/dygn. Leverans i hela Storstockholm."
>

  <CategoryHero
    h1="Stativ & Tross"
    h1Accent="Stockholm"
    intro="Stativ och tross är grunden för alla häftiga ljusupplevelser. Hyr ljusstativ med T-bar, vevstativ, trosstorn och kompletta trossbågar i Stockholm – från 40 kr/dygn. Välj stativ och tross först för att se hur många effekter du får plats med, välj sedan vilka armaturer du vill ha. Allt från enkla stativ till 6 m breda trossbågar för konserter. Leverans i hela Storstockholm."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljus", href: "/vara-tjanster/hyra-ljus/" },
      { label: "Stativ & Tross" }
    ]}
    badges={[
      "T-bar & vevstativ",
      "Trosstorn & traverser",
      "Passar alla effekter",
      "Leverans i Storstockholm",
    ]}
    priceFrom={40}
  />

  <!-- STATIV -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Ljusstativ med T-bar</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {ljusData.stativ.products.filter((p:any) => parseInt(p.artno.slice(-4)) <= 4).map((p: any) => (
        <ProductCard artno={p.artno} name={p.name} price={p.price} priceNote="/dygn" image={p.image} description={p.description} specs={p.specs ?? []} category="Stativ & tross" />
      ))}
    </div>
  </section>

  <!-- TROSSTORN -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Trosstorn</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {ljusData.stativ.products.filter((p:any) => parseInt(p.artno.slice(-4)) >= 5 && parseInt(p.artno.slice(-4)) <= 7).map((p: any) => (
        <ProductCard artno={p.artno} name={p.name} price={p.price} priceNote="/dygn" image={p.image} description={p.description} specs={p.specs ?? []} category="Stativ & tross" />
      ))}
    </div>
  </section>

  <!-- TROSSTRAVERSER & TROSSBÅGAR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Trosstraverser &amp; Trossbågar</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {ljusData.stativ.products.filter((p:any) => parseInt(p.artno.slice(-4)) >= 8).map((p: any) => (
        <ProductCard artno={p.artno} name={p.name} price={p.price} priceNote="/dygn" image={p.image} description={p.description} specs={p.specs ?? []} category="Stativ & tross" />
      ))}
    </div>
  </section>

  <!-- TILLBEHÖR FÄSTEN & DMX -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-4 border-b border-white/10 pb-3">Tillbehör – Fästen, Trossöverdrag &amp; DMX</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(ljusData.stativ?.tillbehor ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="Stativ tillbehör" artno={p.artno} />
      ))}
      {(ljusData.dmx?.tillbehor?.filter((p:any) => parseInt(p.artno.slice(-4)) >= 6) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="DMX-tillbehör" artno={p.artno} />
      ))}
    </div>
  </section>

  <!-- EL-TILLBEHÖR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-4 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(ljusData.el ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="El-tillbehör" artno={p.artno} />
      ))}
      {(ljusData.rok?.tillbehor?.slice(0,2) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="El-tillbehör" artno={p.artno} />
      ))}
    </div>
  </section>

  <!-- STÖRRE EVENT CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="bg-brand-navy border border-white/10 rounded-2xl overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2">
        <div class="p-8">
          <h2 class="text-2xl font-bold text-white mb-3">Scenljus för konserter eller större event</h2>
          <p class="text-gray-300 mb-2">Vi har scenljus för alla ändamål – vitt och färgat ljus på travers eller tross.</p>
          <p class="text-gray-400 text-sm mb-6">Kontakta oss och beskriv ditt behov så tar vi fram en lösning. Större ljusriggar kräver transport och montering — tillkommer som tillägg.</p>
          <a href="/kontakt/" class="inline-block bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl font-semibold text-sm transition-colors">Begär offert</a>
        </div>
        <div class="hidden md:block">
          <img src="/images/ljus/pp_ljus_storre_event.webp" alt="Scenljus för konserter" width="600" height="400" loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljus/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till hyra ljus</a>
    <a href="/vara-tjanster/hyra-ljus/ljuseffekter/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">Lösa effekter</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
  </div>

  <!-- Guider & Svens Kunskapsskola -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;">
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1rem;">Läs mer & förbered dig</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Guider</p>
        <a href="/for/guider/ljussattning-tips/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljussättningstips för event</a>
        <a href="/for/guider/hur-stor-scen/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hur stor scen behöver du?</a>
        <a href="/for/guider/hyra-uplights/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Guide: Hyra uplights</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
        <a href="/svens-kunskapsskola/#led-teknik" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: LED-teknik — egenskaper och funktioner</a>
        <a href="/svens-kunskapsskola/#kontakter-bild" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Kontakter inom bild</a>
          <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
