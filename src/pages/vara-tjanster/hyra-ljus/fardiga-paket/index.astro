---
import Layout from '../../../../layouts/Layout.astro';
import CategoryHero from '../../../../components/CategoryHero.astro';
import MediaCard from '../../../../components/MediaCard.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import ljusData from '../../../../data/ljus.json';

// Artno lookup: title → artno
const _artnoMap = Object.fromEntries(
  (ljusData.paket?.products || []).map(p => [p.name, p.artno]).filter(([,a]) => a)
);

const WP = '/videos';
const paket = [
  {
    title: 'Ljuspaket, Small',
    id: 'ljus-small',
    artno: 'SK-LJS-PAK-0001',
    img: '/images/ljus/pp_ljus_small.png',
    excl: 399,
    videos: [`${WP}/stairville_led_boss_fx-2_pro_01.mp4`],
    persons: '10–30 pers',
    bullets: ['LED T-bar med 4 PAR-armaturer på stativ','12×9W RGB LED','Synkroniseras med musik automatiskt','Montering: 8–12 min, vikt: 16 kg'],
  },
  {
    title: 'Ljuspaket, Small+',
    id: 'ljus-small-plus',
    artno: 'SK-LJS-PAK-0002',
    img: '/images/ljus/pp_ljus_small_plus.png',
    excl: 599,
    videos: [`${WP}/LB100A.mp4`],
    persons: '20–40 pers',
    bullets: ['Trosstorn med Moving Head 100W COB på toppen','540°/180° rotation','DMX eller automatik till musik','Montering: 10–15 min, vikt: 28 kg'],
  },
  {
    title: 'Ljuspaket, Small++',
    id: 'ljus-small-pp',
    artno: 'SK-LJS-PAK-0003',
    img: '/images/ljus/pp_ljus_small_plusplus.png',
    excl: 799,
    videos: [`${WP}/stairville_led_boss_fx-2_pro_01.mp4`],
    persons: '20–60 pers',
    bullets: ['2 stativ med T-bars, 4 olika effekttyper','24×9W PAR + roterande + stroboskop + UV + laser + scanners','Montering: 10–15 min, vikt: 30 kg'],
  },
  {
    title: 'Ljuspaket, Medium',
    id: 'ljus-medium',
    artno: 'SK-LJS-PAK-0004',
    img: '/images/ljus/pp_ljus_medium.png',
    excl: 1199,
    videos: [`${WP}/Big-Dipper-LM120-introduction-720p.mp4`],
    persons: '40–80 pers',
    bullets: ['2 trosstorn med Moving Head (120W COB + 26×2W RGBW)','540°/270° rotation, motoriserad zoom','DMX eller automatik till musik','Montering: 15–20 min, vikt: 52 kg'],
  },
  {
    title: 'Ljuspaket, Medium+',
    id: 'ljus-medium-plus',
    artno: 'SK-LJS-PAK-0005',
    img: '/images/ljus/pp_ljus_medium_plus.png',
    excl: 1299,
    videos: [`${WP}/stairville_led_boss_fx-2_pro_01.mp4`, `${WP}/stairville_matrixx-sc-100_dmx_led_03.mp4`],
    persons: '40–100 pers',
    bullets: ['3 stativ, 5 effekttyper förmonterade','24×9W PAR + roterande + stroboskop + UV + laser + 2 scanners','Montering: 20–25 min, vikt: 30 kg'],
  },
  {
    title: 'Ljuspaket, Medium++',
    id: 'ljus-medium-pp',
    artno: 'SK-LJS-PAK-0006',
    img: '/images/ljus/pp_ljus_medium_plusplus.png',
    excl: 1499,
    videos: [`${WP}/Big-Dipper-LM120-introduction-720p.mp4`, `${WP}/LB100A.mp4`],
    persons: '50–120 pers',
    bullets: ['2 stativ med 8 effekter','4×PAR + 2×Moving Head Wash + 2×Moving Head Beam','Musikstyrning automatik eller DMX','Montering: 30–40 min, vikt: 30 kg'],
  },
  {
    title: 'Ljuspaket, Large',
    id: 'ljus-large',
    artno: 'SK-LJS-PAK-0007',
    img: '/images/ljus/pp_ljus_large.png',
    excl: 1999,
    videos: [`${WP}/Big-Dipper-LM120-introduction-720p.mp4`, `${WP}/LB100A.mp4`, `${WP}/stairville_matrixx-sc-100_dmx_led_03.mp4`],
    persons: '60–140 pers',
    bullets: ['2 stativ med 2m tross, 5 effekttyper','1×Scanner + 2×Moving Head Wash + 2×Moving Head Beam','Musikstyrning automatik eller DMX','Montering: 40–45 min, vikt: 30 kg'],
  },
  {
    title: 'Ljuspaket, Large+',
    id: 'ljus-large-plus',
    artno: 'SK-LJS-PAK-0008',
    img: '/images/ljus/pp_ljus_large_plus.png',
    excl: 2299,
    videos: [`${WP}/Big-Dipper-LM120-introduction-720p.mp4`, `${WP}/LB100A.mp4`],
    persons: '60–160 pers',
    bullets: ['4 trosstorn med Moving Heads','2×Wash 120W COB + 2×Beam 100W COB','DMX eller automatik till musik','Montering: 25–30 min, vikt: 30 kg'],
  },
  {
    title: 'Ljuspaket, Large++',
    id: 'ljus-large-pp',
    artno: 'SK-LJS-PAK-0009',
    img: '/images/ljus/pp_ljus_large_plusplus.png',
    excl: 2999,
    videos: [`${WP}/stairville_led_boss_fx-2_pro_01.mp4`, `${WP}/stairville_matrixx-sc-100_dmx_led_03.mp4`, `${WP}/cameo_wookie-400-RGB.mp4`, `${WP}/adj_fog_fury_jett-04.mp4`],
    persons: '80–160 pers',
    bullets: ['5 stativ, 6 effekttyper + 2 rökmaskiner med ljus','24×9W PAR + stroboskop + UV + scanner + laser + rökmaskiner','CO₂ rökvätska ingår (2L)','Montering: 35–50 min, vikt: 66 kg'],
  },
  {
    title: 'Ljuspaket, XL',
    artno: 'SK-LJS-PAK-0010',
    img: '/images/ljus/pp_ljus_xl.png',
    excl: 4999,
    videos: [`${WP}/LM1915Z.mp4`, `${WP}/LB100A.mp4`, `${WP}/adj_fog_fury_jett-04.mp4`],
    persons: '100–180 pers',
    bullets: ['Trossvägg 2,5×2,0m med 8 Moving Heads','4×Wash 19×15W RGBW + 4×Beam 100W COB + 2 rökmaskiner','CO₂ rökvätska ingår (2L)','Montering: 45–60 min, vikt: 50 kg'],
  },
  {
    title: 'Ljuspaket, XL+',
    artno: 'SK-LJS-PAK-0011',
    img: '/images/ljus/pp_ljus_xl_plus.png',
    excl: 5999,
    videos: [`${WP}/LM1915Z.mp4`, `${WP}/LB100A.mp4`, `${WP}/stairville_matrixx-sc-100_dmx_led_03.mp4`, `${WP}/Betopper_L1015_short_720p.mp4`],
    persons: '100–250 pers',
    bullets: ['Trossbåge 2,5×4,0m med 8+4 armaturer','2×Wash + 4×Beam + 2×Scanner + 2×LED Bar + 4 rökmaskiner','CO₂ rökvätska ingår (4L)','Montering: 60–90 min, vikt: 60 kg'],
  },
  {
    title: 'Scenpaket',
    artno: 'SK-LJS-PAK-0016',
    img: '/images/ljus/pp_ljus_scen_bundle.png',
    excl: 1499,
    videos: [`${WP}/Stairville_CLB5_RGB_WW_Compact_LED_Bar.mp4`],
    persons: 'Konserter',
    bullets: ['8 armaturer – varmvitt eller färgat ljus på stativ','56×4W LED WW/RGB per armatur','DMX-styrenhet inkluderad','Montering: 20–30 min, vikt: 40 kg'],
  },
];
---
<Layout
  title="Hyra Färdiga Ljuspaket Stockholm – Small till XL+ | Scenkonsult"
  description="Hyr färdiga ljuspaket i Stockholm från 399 kr/dygn. Small till XL+ – 12 paket för 10–250 personer. LED PAR, Moving Heads, Strobe, Laser. Leverans Storstockholm."
>

  <CategoryHero
    h1="Färdiga Ljuspaket"
    h1Accent="Stockholm"
    intro="Hyr färdiga ljuspaket för fest, bröllop och event i Stockholm. Tolv paket från Small till XL+ – för 10 till 250 personer. Plug & play med automatisk musiksynk, ingen DMX-kunskap krävs. Leverans i hela Storstockholm."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljus", href: "/vara-tjanster/hyra-ljus/" },
      { label: "Färdiga ljuspaket" }
    ]}
    badges={[
      "Plug & play",
      "Automatisk musiksynk",
      "DMX eller automatik",
      "Leverans i Storstockholm",
    ]}
    priceFrom={399}
  />


  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {paket.map(p => (
        <MediaCard
          id={p.artno || p.id}
          title={p.title}
          images={[p.img]}
          videos={p.videos ?? []}
          priceExcl={p.excl}
          bullets={p.bullets}
          artno={p.artno}
          tag={p.persons}
          category="Färdiga ljuspaket"
        />
      ))}
    </div>
  </section>


  <!-- LJUSSTYRNING (DMX) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Ljusstyrning (DMX)</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {(ljusData.dmx?.tillbehor ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="DMX-styrning" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? []} />
      ))}
    </div>
  </section>

  <!-- EL-TILLBEHÖR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {[
        ...(ljusData.el?.filter((p:any) => ['SK-LJS-EL-0001','SK-LJS-EL-0003','SK-LJS-EL-0002'].includes(p.artno))
          .sort((a:any,b:any) => ['SK-LJS-EL-0001','SK-LJS-EL-0003','SK-LJS-EL-0002'].indexOf(a.artno) - ['SK-LJS-EL-0001','SK-LJS-EL-0003','SK-LJS-EL-0002'].indexOf(b.artno)) ?? []),
        ...(ljusData.el?.filter((p:any) => !['SK-LJS-EL-0001','SK-LJS-EL-0002','SK-LJS-EL-0003'].includes(p.artno)) ?? []),
      ].map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.desc ?? ''} category="El-tillbehör" artno={p.artno} />
      ))}
    </div>
  </section>

  <!-- TEKNIKER & TJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Tekniker & tjänster</h2>
    <p class="text-gray-400 text-sm mb-6">Kombinera ditt ljuspaket med en professionell tekniker eller scenengineer som sätter upp och kör utrustningen på plats.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {ljusData.services?.map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljus/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till ljus</a>
    <a href="/vara-tjanster/hyra-ljus/ljuseffekter/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Lösa effekter →</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
  </div>

  <!-- Guider & Svens Kunskapsskola -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;">
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1rem;">Läs mer & förbered dig</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Guider</p>
        <a href="/for/guider/ljussattning-tips/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljussättningstips för event</a>
        <a href="/for/guider/ljus-brollop/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljus till bröllop</a>
        <a href="/for/guider/hyra-uplights/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Guide: Hyra uplights</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.4);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
        <a href="/svens-kunskapsskola/#led-teknik" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: LED-teknik — egenskaper och funktioner</a>
        <a href="/svens-kunskapsskola/#kontakter-bild" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Kontakter inom bild</a>
          <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
