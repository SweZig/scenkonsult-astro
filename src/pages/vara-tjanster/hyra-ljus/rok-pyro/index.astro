---
import Layout from '../../../../layouts/Layout.astro';
import KunskapBlock from '../../../../components/KunskapBlock.astro';
import ModernHero from '../../../../components/ModernHero.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import MediaCard from '../../../../components/MediaCard.astro';
import ljusData from '../../../../data/ljus.json';
import _elData from '../../../../data/el.json';

// Volymrad-helper — läser från JSON, inga hårdkodade priser i mallen
const _rokVolMap: Record<string, {minQty:number,unitPrice:number}[]> = Object.fromEntries(
  (ljusData.rok?.products ?? [])
    .filter((p: any) => p.volumePricing?.length)
    .map((p: any) => [p.artno, p.volumePricing])
);
function volRowsRok(artno: string) {
  const tiers = _rokVolMap[artno];
  if (!tiers?.length) return [];
  return [{ label: 'Volympriser', rows: tiers.map((t: any) => {
    const total = t.unitPrice * t.minQty;
    return `${t.minQty} st – <span data-exkl="${total}">${total.toLocaleString('sv')}</span> kr`;
  }) }];
}

const forbr = ljusData.rok.tillbehor.filter(t =>
  !t.slug?.startsWith('ackrylatbensin')
);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": ljusData.rok.faq.map((f: {q:string,a:string}) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const _low = (items: any[]) => Math.min(...items.filter((x: any) => x?.price).map((x: any) => x.price));
const _heroFranExcl = _low((ljusData as any).rok.products ?? (ljusData as any).rok);
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);
---
<Layout
  schemaExtra={faqSchema}
  title="Hyr Rökmaskin & Kallgnistmaskin Stockholm – Granulat & Rökvätska | Scenkonsult"
  description="Hyr rökmaskin, kallgnistmaskin, hazer och konfettiavfyrare i Stockholm. Tungrök/Low Fog, rökvätska, granulat och ackrylatbensin. Leverans i hela Storstockholm."
>

  <ModernHero
    eyebrow="Ljus · Rök & pyro"
    h1="Rök & pyroteknik i"
    h1Accent="Stockholm"
    intro="Hyr rökmaskin, kallgnistmaskin och konfettiavfyrare i Stockholm. Våra rökmaskiner har inbyggt RGB-ljus och fyller lokalen snabbt – perfekt till bröllop, konserter och företagsevent. Kallgnistmaskiner (Cold Spark) producerar kalla gnistor som är helt säkra inomhus, kräver inget tillstånd och ger ett professionellt scen-intryck. Rök och pyro-effekter förstärker alla ljuspaket och gör stor skillnad i upplevelsen. Leverans i hela Storstockholm."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljus", href: "/vara-tjanster/hyra-ljus/" },
      { label: "Rök & Pyroteknik" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "Rökmaskin & kallgnistmaskin",
      "Konfettiavfyrare",
      "Volymrabatt",
      "Leverans i Storstockholm",
    ]}
  />

  <!-- ① RÖKMASKINER, HAZER, KALLGNIST, KONFETTI -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

      {ljusData.rok.products.map((p: any) => (
        <MediaCard
          title={p.name}
          images={[p.image]}
          videos={p.video ? [p.video] : []}
          priceExcl={p.price}
          priceSuffix={p.priceNote ?? '/st/dygn'}
          artno={p.artno}
          category="Rök & pyro"
          bullets={p.specs ?? []}
          rows={[
            ...volRowsRok(p.artno),
            ...(p.extraRows ?? [])
          ]}
          manualUrl={p.manualUrl}
        />
      ))}

      <!-- Inforuta: Ansvarsfull användning -->
      <div class="col-span-full mt-2 mb-4 flex gap-3 items-start bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-sm text-gray-400">
        <svg class="flex-shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <p class="leading-relaxed">
          <strong class="text-white font-semibold">Ansvarsfull användning:</strong>{" "}
          Kontrollera att lokalen tillåter öppen låga, ha en brandsläckare tillgänglig och utse en ansvarig person på plats som kan agera om det behövs.
          Scenkonsult hyr ut utrustningen — användning sker på hyrestagarens eget ansvar.
        </p>
      </div>

    </div>
  </section>

  <!-- ② LJUSSTYRNING (DMX) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Ljusstyrning (DMX)</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {(ljusData.dmx?.tillbehor?.filter((p:any) => parseInt(p.artno.slice(-4)) <= 5) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="DMX-styrning" artno={p.artno} modal={true} specs={p.specs ?? [p.description ?? p.desc ?? '']} manualUrl={p.manualUrl} />
      ))}
    </div>
  </section>

  <!-- ③ FÖRBRUKNINGSARTIKLAR: Rökvätska & Granulat -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Förbrukningsartiklar</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {forbr.map(t => (
        <ElTillbehorCard
          img={t.image}
          name={t.name}
          excl={t.price}
          desc={t.desc}
          category="Förbrukningsartiklar"
          artno={t.artno}
          priceNote={t.priceNote ?? '/st'}
        />
      ))}
    </div>
  </section>

  <!-- ⑤ EL-TILLBEHÖR + Ackrylatbensin sist -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-4 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {[
        ...(_elData.products.filter((p:any) => !p.categories || p.categories.includes('ljus'))?.filter((p:any) => ['SK-EL-0001','SK-EL-0003','SK-EL-0002'].includes(p.artno))
          .sort((a:any,b:any) => ['SK-EL-0001','SK-EL-0003','SK-EL-0002'].indexOf(a.artno) - ['SK-EL-0001','SK-EL-0003','SK-EL-0002'].indexOf(b.artno)) ?? []),
        ...(_elData.products.filter((p:any) => !p.categories || p.categories.includes('ljus'))?.filter((p:any) => !['SK-EL-0001','SK-EL-0002','SK-EL-0003'].includes(p.artno)) ?? []),
      ].map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="El-tillbehör" artno={p.artno} priceNote={p.priceNote ?? '/dygn'} />
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljus/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till hyra ljus</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
    <a href="/kontakt/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Fråga om offert</a>
  </div>


  <KunskapBlock
    guides={[
    { href: "/for/guider/dmx-styrning-guide/", label: "DMX-styrning — komplett guide" },
    { href: "/for/guider/hyra-rokmaskin/", label: "Hyra rökmaskin" },
    { href: "/for/guider/rokvatska-guide/", label: "Rökvätska — vilken typ?" },
    { href: "/for/guider/ljussattning-tips/", label: "Ljussättningstips för event" }
  ]}
    videos={[
    { slug: "hur-det-fungerar", label: "Hur det fungerar att hyra hos oss" },
    { slug: "kontakter-ljud", label: "Kontakter inom ljud" }
  ]}
  />

</Layout>
