---
import Layout from '../../../layouts/Layout.astro';
import CategoryHero from '../../../components/CategoryHero.astro';
import CartButton from '../../../components/CartButton.astro';
import MediaCard from '../../../components/MediaCard.astro';
import dj from '../../../data/dj.json';
---
<Layout
  title={dj.metaTitle}
  description={dj.metaDescription}
>

  <CategoryHero
    h1="Hyr DJ eller DJ-utrustning"
    h1Accent="Stockholm"
    intro={dj.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyr DJ" }
    ]}
    badges={[
      "10+ professionella DJs",
      "Alla genrer",
      "70-tal till idag"
    ]}
    priceFrom={1999}
    priceSuffix="/2 tim"
  />

  <!-- USP-rad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-2 pb-6">
    <div class="flex flex-wrap gap-3 text-xs text-gray-300">
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        🎛️ DJ-controller från
        <span class="sk-price-excl font-semibold text-brand-orange">799 kr</span>
        <span class="sk-price-incl hidden font-semibold text-brand-orange">999 kr</span>
        /dygn
      </span>
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        🎤 DJ-tjänst från
        <span class="sk-price-excl font-semibold text-brand-orange">1 999 kr</span>
        <span class="sk-price-incl hidden font-semibold text-brand-orange">2 499 kr</span>
        /2 tim
      </span>
      <span class="bg-brand-navy border border-white/10 rounded-full px-3 py-1">
        📦 Komplett DJ-paket från
        <span class="sk-price-excl font-semibold text-brand-orange">4 797 kr</span>
        <span class="sk-price-incl hidden font-semibold text-brand-orange">5 996 kr</span>
      </span>
    </div>
  </div>

  <!-- HYR PROFESSIONELL DJ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

      <!-- VÄNSTER: DJ-bild + info -->
      <div>
        <div class="rounded-2xl overflow-hidden bg-brand-dark border border-white/10 sk-zoomable" style="aspect-ratio:4/3;cursor:zoom-in">
          <img src={dj.djService.image} alt={dj.djService.alt}
            width="800" height="600" loading="eager" class="w-full h-full object-cover" />
        </div>
        <div class="mt-4">
          <p class="text-gray-400 text-sm leading-relaxed">{dj.djService.description}</p>
          <ul class="mt-3 space-y-1 text-xs text-gray-400">
            {dj.djService.includes.map(item => (
              <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
            ))}
          </ul>
          <p class="mt-3 text-xs text-gray-400 italic">{dj.djService.note}</p>
        </div>
      </div>

      <!-- HÖGER: Prisbord -->
      <div>
        <h2 class="text-2xl font-bold text-white mb-2">HYR PROFESSIONELL DJ</h2>
        <p class="text-gray-300 text-sm mb-5">
          Vi har ett 10-tal professionella DJs med mångårig erfarenhet från nattklubbar, bröllop, studentfester
          och företagsevent. Vi spelar 70/80/90/00/10/20-tals musik i alla genre – Disco, R&amp;B, Dance,
          House, Rock, Schlager, Hip-Hop, Soul, Italo Disco, Euro, EDM m.m.
          Vi utformar kvällen efter önskemål i samråd med kunden.
        </p>
        <p class="text-xs text-gray-400 mb-4">
          Alla tider är effektiva speltimmar. DJ-hårdvara ingår. Resa, scen, ljud och ljus tillkommer.
          <br />¹Digital utrustning kräver fungerande internetanslutning.
        </p>

        <div class="bg-[#1a1a1a] rounded-2xl overflow-hidden border border-white/10">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/10">
                <th class="text-left px-3 py-3 text-gray-400 font-semibold text-xs">Speltid</th>
                <th class="text-center px-2 py-3 text-gray-300 font-semibold text-xs">Junior DJ</th>
                <th class="text-center px-2 py-3 text-gray-300 font-semibold text-xs">Senior DJ</th>
                <th class="text-center px-2 py-3 text-gray-300 font-semibold text-xs">PRO DJ</th>
              </tr>
            </thead>
            <tbody>
              {dj.djService.priceTable.map((row, i) => (
                <tr class={`border-b border-white/5 ${i % 2 === 0 ? '' : 'bg-white/5'}`}>
                  <td class="px-3 py-3 text-gray-300 text-xs font-medium whitespace-nowrap">{row.hours}</td>
                  <td class="px-2 py-3">
                    <div class="flex flex-col items-center gap-1.5">
                      <div class="leading-none text-center">
                        <div class="text-white font-bold text-sm">
                          <span class="sk-price-excl">{row.junior.toLocaleString('sv')} kr</span>
                          <span class="sk-price-incl hidden">{row.juniorInkl.toLocaleString('sv')} kr</span>
                        </div>
                        <div class="text-gray-400 text-[10px] sk-price-excl">exkl moms</div>
                        <div class="text-gray-400 text-[10px] sk-price-incl hidden">inkl moms</div>
                      </div>
                      <CartButton id={`dj-junior-${row.hours.replace(' ','')}`} name={`DJ Junior – ${row.hours}`} price={row.junior} category="DJ-tjänst" size="sm" iconOnly={true} />
                    </div>
                  </td>
                  <td class="px-2 py-3">
                    <div class="flex flex-col items-center gap-1.5">
                      <div class="leading-none text-center">
                        <div class="text-white font-bold text-sm">
                          <span class="sk-price-excl">{row.senior.toLocaleString('sv')} kr</span>
                          <span class="sk-price-incl hidden">{row.seniorInkl.toLocaleString('sv')} kr</span>
                        </div>
                        <div class="text-gray-400 text-[10px] sk-price-excl">exkl moms</div>
                        <div class="text-gray-400 text-[10px] sk-price-incl hidden">inkl moms</div>
                      </div>
                      <CartButton id={`dj-senior-${row.hours.replace(' ','')}`} name={`DJ Senior – ${row.hours}`} price={row.senior} category="DJ-tjänst" size="sm" iconOnly={true} />
                    </div>
                  </td>
                  <td class="px-2 py-3 text-center">
                    <div class="text-white font-bold text-sm italic mb-1">Offert</div>
                    <a href="/kontakt/" class="text-brand-orange text-[10px] hover:underline">Kontakta oss</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <a href="/kontakt/" class="mt-5 inline-block bg-brand-orange hover:bg-brand-orange-light text-white px-6 py-3 rounded-lg font-semibold transition-colors text-sm">
          Boka DJ
        </a>
      </div>
    </div>
  </section>

  <!-- DJ-PAKET -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-white mb-2">Kompletta DJ-paket</h2>
      <p class="text-gray-400 text-sm">DJ + ljud + ljus i ett paket. Resa tillkommer, transport tillkommer på XL.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {dj.packages.map((pkg, i) => (
        <div class={`bg-brand-navy border rounded-2xl p-5 flex flex-col hover:border-brand-orange/50 transition-colors ${i === 1 ? 'border-brand-orange/60 relative' : 'border-white/10'}`}>
          {i === 1 && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-orange text-white text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wide whitespace-nowrap">
              Populärast
            </div>
          )}
          <div class="mb-3">
            <div class="text-brand-orange/80 text-xs font-semibold uppercase tracking-wide mb-1">{pkg.tagline}</div>
            <h3 class="text-white font-bold text-base">{pkg.name}</h3>
            <div class="text-gray-400 text-xs mt-1">{pkg.hours} speltid</div>
          </div>
          <ul class="space-y-1.5 mb-4 flex-1">
            {pkg.includes.map(item => (
              <li class="flex gap-2 text-xs text-gray-300">
                <span class="text-green-400 shrink-0">✓</span>{item}
              </li>
            ))}
          </ul>
          <div class="border-t border-white/10 pt-3 mt-auto">
            <div class="mb-3">
              <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{pkg.price.toLocaleString('sv')} kr</span>
              <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{pkg.priceInkl.toLocaleString('sv')} kr</span>
              <span class="text-gray-400 text-xs ml-1 sk-price-excl">exkl. moms</span>
              <span class="text-gray-400 text-xs ml-1 sk-price-incl hidden">inkl. moms</span>
            </div>
            <div class="text-gray-500 text-[10px] italic mb-3">{pkg.note}</div>
            <CartButton id={pkg.artno} name={pkg.name} price={pkg.price} category="DJ-paket" size="md" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- KARUSELL: VÅRA DJs -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-xl font-bold text-white mb-4">BOKA ETT URVAL AV VÅRA DJs</h2>
    <div class="relative">
      <div id="dj-carousel" class="flex overflow-x-auto gap-4 snap-x snap-mandatory scroll-smooth pb-3"
        style="scrollbar-width:thin; scrollbar-color: rgba(196,181,244,0.3) transparent;">
        {dj.djPhotos.map(d => (
          <div class="snap-center shrink-0 w-full rounded-2xl overflow-hidden border border-white/10 bg-brand-navy hover:border-brand-orange/50 transition-all">
            <img src={d.img} alt={d.name} width="2560" height="654" loading="lazy"
              class="w-full h-auto block" style="aspect-ratio:2560/654; object-fit:cover" />
          </div>
        ))}
      </div>
      <button onclick="document.getElementById('dj-carousel').scrollBy({left:-document.getElementById('dj-carousel').offsetWidth, behavior:'smooth'})"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-3 bg-brand-dark/80 hover:bg-brand-navy border border-white/20 text-white w-9 h-9 rounded-full flex items-center justify-center text-lg transition-colors hidden sm:flex">‹</button>
      <button onclick="document.getElementById('dj-carousel').scrollBy({left:document.getElementById('dj-carousel').offsetWidth, behavior:'smooth'})"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-3 bg-brand-dark/80 hover:bg-brand-navy border border-white/20 text-white w-9 h-9 rounded-full flex items-center justify-center text-lg transition-colors hidden sm:flex">›</button>
    </div>
    <div class="flex justify-center gap-2 mt-3">
      {dj.djPhotos.map((_, i) => (
        <button onclick={`const c=document.getElementById('dj-carousel');c.scrollTo({left:c.offsetWidth*${i},behavior:'smooth'})`}
          class="w-2 h-2 rounded-full bg-white/20 hover:bg-brand-orange transition-colors" aria-label={`Bild ${i+1}`}></button>
      ))}
    </div>

    <!-- Är du DJ? CTA -->
    <div class="mt-6 bg-brand-navy/50 border border-white/10 rounded-xl px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <p class="text-white text-sm font-semibold">Är du erfaren DJ och vill listas hos oss?</p>
        <p class="text-gray-400 text-xs mt-0.5">Vi utökar kontinuerligt vår DJ-databas — hör av dig om du har erfarenhet av event, bröllop eller företagsgig.</p>
      </div>
      <a href="/kontakt/" class="shrink-0 bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-xs font-semibold transition-colors whitespace-nowrap">
        Kontakta oss →
      </a>
    </div>
  </section>

  <!-- TEMATISERING -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-2">DJ till ditt event</h2>
    <p class="text-gray-400 text-sm mb-8">Vi anpassar musik och upplägg efter just ert event.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {dj.themes.map(theme => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl p-6 hover:border-brand-orange/40 transition-colors flex flex-col">
          <div class="text-3xl mb-3">{theme.icon}</div>
          <h3 class="text-white font-bold text-lg mb-2">{theme.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-4">{theme.description}</p>
          <ul class="space-y-1.5 mb-5 flex-1">
            {theme.bullets.map(b => (
              <li class="flex gap-2 text-xs text-gray-300">
                <span class="text-brand-orange/80 shrink-0">▸</span>{b}
              </li>
            ))}
          </ul>
          <a href="/kontakt/" class="text-brand-orange text-xs font-semibold hover:underline mt-auto">
            {theme.cta} →
          </a>
        </div>
      ))}
    </div>
    <!-- Student - neutral note -->
    <div class="mt-5 bg-white/5 border border-white/10 rounded-xl px-5 py-3 flex gap-3 items-start">
      <span class="text-xl shrink-0">🎓</span>
      <p class="text-gray-400 text-sm">
        <span class="text-gray-300 font-semibold">Studentflak & studentfest</span> — vi kan lösa DJ till studentfiranden och kan spela utomhus.
        <a href="/kontakt/" class="text-brand-orange hover:underline ml-1">Kontakta oss för mer info →</a>
      </p>
    </div>
  </section>

  <!-- RECENSIONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-xl font-bold text-white mb-4">Så här säger kunder som bokat DJ</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {[
        { text: "Hej Scenkonsult och tack, blev ju en riktigt lyckad kväll!", name: "Åsa P, Stockholm" },
        { text: "DJ Måns gjorde kvällen till en succé och ingen ville lämna dansgolvet! Grymt smidigt och bra kommunikation hela vägen. Kan varmt rekommenderas!", name: "Charlotte A, Linköping" },
        { text: "Tack för i Lördags, Allt var toppen! Så bra drag på dansgolvet.", name: "Jenny L, Stockholm" },
        { text: "Riktigt professionella, gjorde min fest till succé!", name: "Roger L, Täby" },
        { text: "Så värt att hyra in en DJ till festen, precis som krogen på 90-talet", name: "Jonas A, Stockholm" },
      ].map(r => (
        <div class="bg-brand-navy/60 border border-white/10 rounded-xl p-4">
          <div class="flex gap-0.5 mb-2"><span class="text-brand-orange text-sm">★★★★★</span></div>
          <p class="text-gray-300 text-sm italic mb-2">"{r.text}"</p>
          <p class="text-gray-400 text-xs font-semibold">{r.name}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- DECENNIER + SPECIALGENRER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-2">Musik per decennium & genre</h2>
    <p class="text-gray-400 text-sm mb-6">Vi spelar hela spannet — från klassiska decennier till specialgenrer som Italo Disco, Schlager och Dansband.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {dj.decades.map((d) => (
        <div class="bg-brand-navy border border-white/10 rounded-2xl p-5 hover:border-brand-orange/40 transition-colors border-l-2 border-l-brand-orange/60">
          <div class="text-3xl font-extrabold mb-3 text-brand-orange/90 tracking-tight">{d.decade}</div>
          <p class="text-gray-300 text-sm leading-relaxed mb-3">{d.history}</p>
          <p class="text-gray-400 text-xs leading-relaxed mb-3 border-t border-white/10 pt-3">
            <span class="text-gray-300 font-semibold">Artister: </span>{d.artists}
          </p>
          <p class="text-gray-400 text-xs italic">{d.ageGroup}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- HYR DJ-UTRUSTNING -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-2">Hyr DJ-utrustning</h2>
    <p class="text-gray-400 text-sm mb-6">Hyr controllers, DJ-bord och tillbehör — perfekt om du vill mixa själv.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {dj.equipment.filter(p => ['SK-DJ-0001','SK-DJ-0002','SK-DJ-0003','SK-DJ-0004','SK-DJ-0005','SK-DJ-0006'].includes(p.artno)).map(p => (
        <MediaCard
          id={p.artno || `dj-utr-${p.slug}`}
          title={p.name}
          images={[p.image]}
          priceExcl={p.price}
          priceSuffix={p.priceNote}
          artno={p.artno}
          category="DJ-utrustning"
          bullets={p.includes ?? []}
        />
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6">Vanliga frågor om DJ-uthyrning</h2>
    <div class="space-y-3">
      {dj.faq.map(f => (
        <details class="bg-brand-navy border border-white/10 rounded-xl overflow-hidden group">
          <summary class="px-5 py-4 text-white font-semibold cursor-pointer text-sm hover:text-brand-orange transition-colors list-none flex justify-between items-center">
            {f.q}
            <span class="text-brand-orange text-lg">+</span>
          </summary>
          <div class="px-5 pb-4 text-gray-400 text-sm leading-relaxed border-t border-white/10 pt-3">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- Guider & resurser -->
  <section style="background:#0c0a24;border-top:1px solid rgba(255,255,255,0.06);padding:2.5rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.35);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1.25rem;">📖 Guider för DJ & musik</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
        <a href="/for/guider/dj-eller-liveband/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>DJ eller liveband?</a>
        <a href="/for/guider/varfor-numark-denon-rane/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Varför Numark & Denon?</a>
        <a href="/for/guider/dj-brollop-pris/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>DJ till bröllop — pris</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.4);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
