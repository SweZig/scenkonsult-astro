---
import Layout from '../../../layouts/Layout.astro';
import CategoryHero from '../../../components/CategoryHero.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CartButton from '../../../components/CartButton.astro';
import ElTillbehorCard from '../../../components/ElTillbehorCard.astro';
import bildData from '../../../data/bild.json';
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": bildData.faq.map((f: {q:string,a:string}) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

---
<Layout
  schemaExtra={faqSchema}
  title="Hyr Projektor & Storbildsskärm Stockholm – LED-vägg & Trailerscen | Scenkonsult"
  description="Hyr projektor, storbildsskärm, LED-vägg och trailerscen för event och konferenser i Stockholm. Projektor fr 299 kr/dygn. Leverans i hela Storstockholm."
>

  <CategoryHero
    h1="Hyr Projektor & Skärm"
    h1Accent="Stockholm"
    intro="Hyr projektor, storbildsskärm eller moduluppbyggd LED-vägg för konferens, presentation och event i Stockholm. Vi levererar hela lösningen med stativ, duk och kablar. Transport och montering finns som tilläggstjänst."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyr bild, projektorer & skärmar" }
    ]}
    badges={[
      "3 500–12 000 ANSI lumen",
      "Full HD och 4K",
      "LED-vägg & trailerscen",
      "Leverans i Storstockholm"
    ]}
    priceFrom={299}
  />

  <!-- LED-VÄGG CTA-BANNER — leder till konfigurator -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <a href="/vara-tjanster/hyra-bild-led-vagg/" class="led-cta-banner" aria-label="Bygg din egen LED-vägg">
      <div class="led-cta-bg" aria-hidden="true"></div>
      <div class="led-cta-images" aria-hidden="true">
        <img src="/images/bild/pp_bld_led_500x500.png" alt="" loading="lazy" class="led-cab-1" width="180" height="180" />
        <img src="/images/bild/pp_bld_led_500x1000.png" alt="" loading="lazy" class="led-cab-2" width="120" height="240" />
      </div>
      <div class="led-cta-content">
        <span class="led-cta-tag">Nytt · Bild & video</span>
        <h2 class="led-cta-title">Hyr LED-vägg — bygg den exakt som du vill</h2>
        <p class="led-cta-desc">Modulära kabinett för indoor och outdoor. Räkna ut storlek, upplösning, effekt och pris i vår konfigurator.</p>
        <ul class="led-cta-bullets">
          <li><strong>Indoor</strong> P1.95 / P2.604 från <strong>290 kr/dygn</strong></li>
          <li><strong>Outdoor</strong> P3.91 IP65 från <strong>580 kr/dygn</strong></li>
          <li>Ground support <strong>ingår</strong> — tross-alternativ finns</li>
        </ul>
        <span class="led-cta-btn">
          Bygg din LED-vägg
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </div>
    </a>
  </section>

  <!-- PRODUKTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {bildData.products.map(p => (
        <ProductCard
          id={p.artno}
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt}
          description={p.description}
          specs={p.includes}
          category="Projektor & skärm"
          bulky={p.bulky}
        />
      ))}
    </div>
  </section>

  <!-- TILLBEHÖR BILD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {bildData.tillbehor.map(t => (
        <ElTillbehorCard img={t.image} name={t.name} excl={t.price} desc={t.desc} category="Projektor tillbehör" artno={t.artno} slug={t.slug}  />
      ))}
    </div>
  </section>



  <!-- MEDIA & INNEHÅLLSTJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Media & innehållstjänster</h2>
    <p class="text-gray-400 text-sm mb-6">Hyr foto, video och AI-specialister för rörligt innehåll till era skärmar, LED-väggar och presentationer. Priser per timme.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {bildData.services?.map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till tjänster</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
    <a href="/kontakt/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Fråga om offert</a>
  </div>

  <!-- Guider & resurser -->
  <section style="background:#0c0a24;border-top:1px solid rgba(255,255,255,0.06);padding:2.5rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.35);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1.25rem;">📖 Guider för projektor & skärm</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
        <a href="/for/guider/hyra-projektor-pris/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hyra projektor — guide & priser</a>
        <a href="/for/guider/konferens-av-checklista/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Konferens AV checklista</a>
        <a href="/for/guider/ljud-foretagsfest/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljud till företagsfest</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.4);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      <div style="flex:1;min-width:220px;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
        <a href="/svens-kunskapsskola/#kontakter-bild" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Kontakter inom bild — HDMI, VGA m.m.</a>
        <a href="/svens-kunskapsskola/#led-teknik" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: LED-teknik — egenskaper & funktioner</a>
        <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
      </div>
      </div>
    </div>
  </section>

<style>
  .led-cta-banner {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(135deg, #2a1f6b 0%, #1e1850 50%, #0c0a24 100%);
    border: 1px solid rgba(196, 181, 244, 0.25);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  .led-cta-banner:hover {
    border-color: rgba(196, 181, 244, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 12px 48px rgba(196, 181, 244, 0.15);
  }
  .led-cta-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(196, 181, 244, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(196, 181, 244, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .led-cta-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(196, 181, 244, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(196, 181, 244, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }
  .led-cta-images {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3.5rem);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    pointer-events: none;
  }
  .led-cab-1 {
    height: clamp(120px, 18vw, 200px);
    width: auto;
    filter: drop-shadow(0 8px 24px rgba(196, 181, 244, 0.3));
    opacity: 0.95;
  }
  .led-cab-2 {
    height: clamp(160px, 24vw, 280px);
    width: auto;
    filter: drop-shadow(0 8px 24px rgba(196, 181, 244, 0.3));
    opacity: 0.95;
  }
  @media (max-width: 768px) {
    .led-cta-images { display: none; }
  }
  .led-cta-content {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    max-width: 65%;
  }
  @media (max-width: 768px) {
    .led-cta-content { max-width: 100%; }
  }
  .led-cta-tag {
    display: inline-block;
    background: rgba(196, 181, 244, 0.18);
    color: #c4b5f4;
    padding: 0.35rem 0.85rem;
    border-radius: 99px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid rgba(196, 181, 244, 0.3);
    margin-bottom: 1rem;
  }
  .led-cta-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: white;
    margin: 0 0 0.75rem;
  }
  .led-cta-desc {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }
  .led-cta-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .led-cta-bullets li {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.88rem;
    padding-left: 1.25rem;
    position: relative;
  }
  .led-cta-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #c4b5f4;
    font-weight: 700;
  }
  .led-cta-bullets strong {
    color: white;
    font-weight: 600;
  }
  .led-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #c4b5f4;
    color: #0c0a24;
    padding: 0.85rem 1.5rem;
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: background 0.2s, transform 0.2s;
  }
  .led-cta-banner:hover .led-cta-btn {
    background: #e2dcfb;
    transform: translateX(4px);
  }
</style>
</Layout>
