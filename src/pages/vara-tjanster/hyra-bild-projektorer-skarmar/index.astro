---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CartButton from '../../../components/CartButton.astro';
import ElTillbehorCard from '../../../components/ElTillbehorCard.astro';
import TrossPromoBanner from '../../../components/TrossPromoBanner.astro';
import bildData from '../../../data/bild.json';
import _tjansterData from '../../../data/tjanster.json';
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": bildData.faq.map((f: {q:string,a:string}) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  schemaExtra={faqSchema}
  title="Hyr Projektor & Storbildsskärm Stockholm – LED-vägg & Trailerscen | Scenkonsult"
  description="Hyr projektor, storbildsskärm, LED-vägg och trailerscen för event och konferenser i Stockholm. Projektor fr 299 kr/dygn. Leverans i hela Storstockholm."
>

  <ModernHero
    eyebrow="Bild · Projektor & skärm"
    h1="Hyr projektor & skärm i"
    h1Accent="Stockholm"
    intro="Hyr projektor, storbildsskärm eller moduluppbyggd LED-vägg för konferens, presentation och event i Stockholm. Vi levererar hela lösningen med stativ, duk och kablar. Transport och montering tillkommer separat."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyra bild", href: "/vara-tjanster/hyra-bild/" },
      { label: "Projektor & skärm" }
    ]}
    chips={[
      { html: 'Från <span class="sk-price-excl">299&nbsp;kr</span><span class="sk-price-incl hidden">374&nbsp;kr</span> / dygn' },
      "Klarar dagsljus",
      "Full HD och 4K",
      "LED-vägg & trailerscen",
      "Leverans i Storstockholm",
    ]}
  />

  <!-- PROJEKTORER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-10">
    <SectionHeader
      eyebrow="Sortiment"
      h2="Projektorer"
      lead="Från kompakta XGA-projektorer för möteslokaler till 4K UHD-projektorer som klarar dagsljus och stora bildytor."
      marginBottom="1.5rem"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {bildData.products.filter(p => p.section === 'projektor').map(p => (
        <ProductCard
          id={p.artno}
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt}
          description={p.description}
          specs={p.includes}
          category="Projektor & skärm"
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- LED SKÄRMAR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <SectionHeader
      eyebrow="Sortiment"
      h2="LED Skärmar"
      lead="Professionella 4K-skärmar från Samsung i 65&quot;, 75&quot; och 85&quot; för konferens, mässa, showroom och event."
      marginBottom="1.5rem"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {bildData.products.filter(p => p.section === 'skarm').map(p => (
        <ProductCard
          id={p.artno}
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt}
          description={p.description}
          specs={p.includes}
          category="Projektor & skärm"
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- LED-VÄGG — kampanjbanner (mellan LED-skärmar och trailer) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <SectionHeader
      eyebrow="Sortiment"
      h2="LED-vägg"
      lead="Sömlös storbild för konferens, mässa och event — färdig kampanjlösning på tross, eller bygg din egen modulvägg i konfiguratorn."
      marginBottom="1.5rem"
    />
    <TrossPromoBanner />
  </section>

  <!-- LED-VÄGG CTA-BANNER — leder till konfigurator -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <a href="/vara-tjanster/hyra-bild-led-vagg/" class="led-cta-banner" aria-label="Bygg din egen LED-vägg">
      <div class="led-cta-bg" aria-hidden="true"></div>
      <div class="led-cta-images" aria-hidden="true">
        <img src="/images/bild/pp_bld_led_500x500.webp" alt="" loading="lazy" class="led-cab-1" width="180" height="180" />
        <img src="/images/bild/pp_bld_led_500x1000.webp" alt="" loading="lazy" class="led-cab-2" width="120" height="240" />
      </div>
      <div class="led-cta-content">
        <span class="led-cta-tag">Bygg din egen · Bild & video</span>
        <h2 class="led-cta-title">Hyr LED-vägg — bygg den exakt som du vill</h2>
        <p class="led-cta-desc">Modulära kabinett för indoor och outdoor. Räkna ut storlek, upplösning, effekt och pris i vår konfigurator.</p>
        <ul class="led-cta-bullets">
          <li><strong>Indoor</strong> P1.95 / P2.604 från <strong>290 kr/dygn</strong></li>
          <li><strong>Outdoor</strong> P3.91 IP65 från <strong>580 kr/dygn</strong></li>
          <li>Ground support <strong>1 500 kr</strong> eller tross-rigg från <strong>1 800 kr</strong></li>
        </ul>
        <span class="led-cta-btn">
          Bygg din LED-vägg
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </div>
    </a>
  </section>

  <!-- MOBILA LED SKÄRMAR PÅ TRAILER -->
  <section id="led-trailer" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10" style="scroll-margin-top:180px">
    <SectionHeader
      eyebrow="Sortiment"
      h2="Mobila LED skärmar på Trailer"
      lead="Storbildslösningar för utomhusevent, festival och sportarrangemang. Levereras färdigriggat på trailer — 7 m², 15 m² eller 28 m² LED-yta med pixelpitch P3.9."
      marginBottom="1.5rem"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {bildData.products.filter(p => p.section === 'trailer').map(p => (
        <ProductCard
          id={p.artno}
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt}
          description={p.description}
          specs={p.includes}
          videoSrc={p.video}
          category="Projektor & skärm"
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- PROJEKTORDUKAR -->
  <section id="projektorduk" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16" style="scroll-margin-top:180px">
    <SectionHeader
      eyebrow="Sortiment"
      h2="Projektordukar"
      lead="Pull-up-dukar för konferensrum upp till stora ramdukar för scen och mässa. Klicka på en duk för full information."
      marginBottom="1.5rem"
    />
    <div class="duk-grid">
      {bildData.dukar?.map((d, i) => (
        <article class="duk-card group" data-duk-idx={i} tabindex="0" role="button" aria-label={`Visa info om ${d.name}`}>
          <div class="duk-card-img bg-brand-dark overflow-hidden">
            <img src={d.image} alt={d.alt ?? d.name} loading="lazy"
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="duk-card-body">
            <h3 class="duk-card-title">{d.name}</h3>
            <p class="duk-card-tagline">{d.includes?.[0] ?? ''}</p>
            <div class="duk-card-foot">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-lg">{d.price.toLocaleString('sv')}&nbsp;kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-lg">{Math.round(d.price * 1.25).toLocaleString('sv')}&nbsp;kr</span>
                <span class="text-gray-400 text-xs">{d.priceNote ?? '/dygn'}</span>
              </div>
              <CartButton id={d.artno} artno={d.artno} name={d.name} price={d.price} priceNote={d.priceNote ?? '/dygn'} category="Projektorduk" image={d.image} bulky={d.bulky} size="sm" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- DUK MODAL -->
  <div id="duk-modal" class="duk-modal" role="dialog" aria-modal="true" aria-labelledby="duk-modal-title" aria-hidden="true">
    <div class="duk-modal-backdrop" data-duk-close></div>
    <div class="duk-modal-panel" role="document">
      <button class="duk-modal-close" data-duk-close aria-label="Stäng">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="duk-modal-grid">
        <div class="duk-modal-img bg-brand-dark">
          <img id="duk-modal-image" src="" alt="" />
        </div>
        <div class="duk-modal-info">
          <h3 id="duk-modal-title" class="duk-modal-title"></h3>
          <p id="duk-modal-artno" class="artno-badge"></p>
          <p id="duk-modal-desc" class="duk-modal-desc"></p>
          <ul id="duk-modal-includes" class="duk-modal-includes"></ul>
          <div class="duk-modal-foot">
            <div class="leading-none">
              <span id="duk-modal-price-excl" class="sk-price-excl text-brand-orange font-extrabold text-2xl"></span>
              <span id="duk-modal-price-incl" class="sk-price-incl hidden text-brand-orange font-extrabold text-2xl"></span>
              <span class="text-gray-400 text-sm">/dygn</span>
            </div>
            <button id="duk-modal-cart" class="duk-modal-cta">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span id="duk-modal-cart-label">Lägg i varukorgen</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- TILLBEHÖR BILD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader
      eyebrow="Komplettera"
      h2="Tillbehör"
      marginBottom="1.5rem"
    />
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {bildData.tillbehor.map(t => (
        <ElTillbehorCard img={t.image} name={t.name} excl={t.price} desc={t.desc} category="Projektor tillbehör" artno={t.artno} slug={t.slug}  />
      ))}
    </div>
  </section>



  <!-- MEDIA & INNEHÅLLSTJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader
      eyebrow="Tjänster"
      h2="Media & innehållstjänster"
      lead="Hyr foto, video och AI-specialister för rörligt innehåll till era skärmar, LED-väggar och presentationer. Priser per timme."
      marginBottom="1.5rem"
    />
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {_tjansterData.services?.filter((s:any) => s.categories?.includes('bild')).map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            {svc.artno && <p class="artno-badge mb-2">{svc.artno}</p>}
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')}&nbsp;kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')}&nbsp;kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till tjänster</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
    <a href="/kontakt/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Fråga om offert</a>
  </div>

  <!-- Guider & resurser -->
  <section style="background:#0c0a24;border-top:1px solid rgba(255,255,255,0.06);padding:2.5rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1.25rem;">📖 Guider för projektor & skärm</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
        <a href="/for/guider/hyra-projektor-pris/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hyra projektor — guide & priser</a>
        <a href="/for/guider/konferens-av-checklista/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Konferens AV checklista</a>
        <a href="/for/guider/ljud-foretagsfest/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljud till företagsfest</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
      <div style="flex:1;min-width:220px;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
        <a href="/svens-kunskapsskola/#kontakter-bild" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Kontakter inom bild — HDMI, VGA m.m.</a>
        <a href="/svens-kunskapsskola/#led-teknik" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: LED-teknik — egenskaper & funktioner</a>
        <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
      </div>
      </div>
    </div>
  </section>

<style>
  .led-cta-banner {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(135deg, #2a1f6b 0%, #1e1850 50%, #0c0a24 100%);
    border: 1px solid rgba(196, 181, 244, 0.25);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
  .led-cta-banner:hover {
    border-color: rgba(196, 181, 244, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 12px 48px rgba(196, 181, 244, 0.15);
  }
  .led-cta-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(196, 181, 244, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(196, 181, 244, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .led-cta-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(196, 181, 244, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(196, 181, 244, 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }
  .led-cta-images {
    position: absolute;
    right: clamp(1.5rem, 4vw, 3.5rem);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: flex-end;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    pointer-events: none;
  }
  .led-cab-1 {
    height: clamp(120px, 18vw, 200px);
    width: auto;
    filter: drop-shadow(0 8px 24px rgba(196, 181, 244, 0.3));
    opacity: 0.95;
  }
  .led-cab-2 {
    height: clamp(160px, 24vw, 280px);
    width: auto;
    filter: drop-shadow(0 8px 24px rgba(196, 181, 244, 0.3));
    opacity: 0.95;
  }
  @media (max-width: 768px) {
    .led-cta-images { display: none; }
  }
  .led-cta-content {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    max-width: 65%;
  }
  @media (max-width: 768px) {
    .led-cta-content { max-width: 100%; }
  }
  .led-cta-tag {
    display: inline-block;
    background: rgba(196, 181, 244, 0.18);
    color: #c4b5f4;
    padding: 0.35rem 0.85rem;
    border-radius: 99px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid rgba(196, 181, 244, 0.3);
    margin-bottom: 1rem;
  }
  .led-cta-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: white;
    margin: 0 0 0.75rem;
  }
  .led-cta-desc {
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.9rem, 1.6vw, 1rem);
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }
  .led-cta-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .led-cta-bullets li {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.88rem;
    padding-left: 1.25rem;
    position: relative;
  }
  .led-cta-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #c4b5f4;
    font-weight: 700;
  }
  .led-cta-bullets strong {
    color: white;
    font-weight: 600;
  }
  .led-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #c4b5f4;
    color: #0c0a24;
    padding: 0.85rem 1.5rem;
    border-radius: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    transition: background 0.2s, transform 0.2s;
  }
  .led-cta-banner:hover .led-cta-btn {
    background: #e2dcfb;
    transform: translateX(4px);
  }

  /* ── PROJEKTORDUKAR — Grid + kort ───────────────────────────── */
  .duk-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 640px) {
    .duk-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .duk-grid { grid-template-columns: repeat(5, 1fr); gap: 1.25rem; }
  }
  .duk-card {
    background: #1e1850;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .duk-card:hover,
  .duk-card:focus-visible {
    border-color: rgba(196, 181, 244, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    outline: none;
  }
  .duk-card-img {
    aspect-ratio: 1024 / 853;
  }
  .duk-card-body {
    padding: 0.85rem 0.9rem 0.9rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.4rem;
  }
  .duk-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    color: white;
    font-size: 0.95rem;
    line-height: 1.25;
    margin: 0;
  }
  .duk-card-tagline {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    line-height: 1.35;
    margin: 0;
    flex: 1;
  }
  .duk-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-top: 0.55rem;
    margin-top: 0.25rem;
    gap: 0.5rem;
  }

  /* ── DUK MODAL ──────────────────────────────────────────────── */
  .duk-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .duk-modal[aria-hidden="false"] {
    display: flex;
  }
  .duk-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 22, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .duk-modal-panel {
    position: relative;
    background: #15123a;
    border: 1px solid rgba(196, 181, 244, 0.25);
    border-radius: 1.25rem;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
    max-width: 980px;
    width: 100%;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    animation: dukModalIn 0.22s ease-out;
  }
  @keyframes dukModalIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  .duk-modal-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(12, 10, 36, 0.6);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .duk-modal-close:hover {
    background: rgba(196, 181, 244, 0.18);
    border-color: rgba(196, 181, 244, 0.5);
    color: #e2dcfb;
  }
  .duk-modal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 768px) {
    .duk-modal-grid { grid-template-columns: 1.1fr 1fr; }
  }
  .duk-modal-img {
    aspect-ratio: 1024 / 853;
    overflow: hidden;
    border-top-left-radius: 1.25rem;
    border-top-right-radius: 1.25rem;
  }
  @media (min-width: 768px) {
    .duk-modal-img {
      border-top-right-radius: 0;
      border-bottom-left-radius: 1.25rem;
      aspect-ratio: auto;
      height: 100%;
    }
  }
  .duk-modal-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .duk-modal-info {
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .duk-modal-title {
    font-family: 'DM Serif Display', serif;
    color: white;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    line-height: 1.2;
    margin: 0;
  }
  .duk-modal-desc {
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }
  .duk-modal-includes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-top: 0.85rem;
  }
  .duk-modal-includes li {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    display: flex;
    gap: 0.5rem;
    line-height: 1.4;
  }
  .duk-modal-includes li::before {
    content: "▸";
    color: #4ade80;
    flex-shrink: 0;
  }
  .duk-modal-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    padding-top: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .duk-modal-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #c4b5f4;
    color: #0c0a24;
    padding: 0.85rem 1.4rem;
    border: none;
    border-radius: 0.7rem;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .duk-modal-cta:hover {
    background: #e2dcfb;
    transform: translateX(2px);
  }
  .duk-modal-cta.added {
    background: #4ade80;
    color: #0c0a24;
  }
</style>

<script define:vars={{ dukar: bildData.dukar || [] }}>
  (function() {
    const modal = document.getElementById('duk-modal');
    if (!modal || !dukar.length) return;

    const elImg     = document.getElementById('duk-modal-image');
    const elTitle   = document.getElementById('duk-modal-title');
    const elArtno   = document.getElementById('duk-modal-artno');
    const elDesc    = document.getElementById('duk-modal-desc');
    const elInc     = document.getElementById('duk-modal-includes');
    const elPriceEx = document.getElementById('duk-modal-price-excl');
    const elPriceIn = document.getElementById('duk-modal-price-incl');
    const elCart    = document.getElementById('duk-modal-cart');

    let currentDuk = null;
    let lastFocused = null;

    function fmt(n) {
      return Number(n).toLocaleString('sv-SE');
    }

    function openModal(idx) {
      const d = dukar[idx];
      if (!d) return;
      currentDuk = d;
      lastFocused = document.activeElement;

      elImg.src = d.image;
      elImg.alt = d.alt || d.name;
      elTitle.textContent = d.name;
      elArtno.textContent = d.artno || '';
      elArtno.style.display = d.artno ? '' : 'none';
      elDesc.textContent = d.description || '';
      elInc.innerHTML = '';
      (d.includes || []).forEach(item => {
        const li = document.createElement('li');
        li.textContent = item;
        elInc.appendChild(li);
      });
      elPriceEx.textContent = fmt(d.price) + ' kr';
      elPriceIn.textContent = fmt(Math.round(d.price * 1.25)) + ' kr';

      // Reset cart-knapp
      elCart.classList.remove('added');
      const cartLabel = document.getElementById('duk-modal-cart-label');
      if (cartLabel) cartLabel.textContent = 'Lägg i varukorgen';

      // Re-applicera moms
      if (window.skApplyVat) window.skApplyVat();

      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Fokus till stäng-knappen för tillgänglighet
      modal.querySelector('.duk-modal-close')?.focus();
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      currentDuk = null;
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    // Klick på dukkort
    document.querySelectorAll('.duk-card[data-duk-idx]').forEach(card => {
      const idx = parseInt(card.getAttribute('data-duk-idx'), 10);
      card.addEventListener('click', (e) => {
        // Ignorera klick på cart-knappen (har egen handler i sk-cart globalt)
        if (e.target.closest('.cart-add-btn')) return;
        openModal(idx);
      });
      card.addEventListener('keydown', (e) => {
        // Ignorera om fokus ligger på cart-knappen
        if (e.target.closest('.cart-add-btn')) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModal(idx);
        }
      });
    });

    // Stäng på backdrop / X / data-duk-close
    modal.querySelectorAll('[data-duk-close]').forEach(el => {
      el.addEventListener('click', closeModal);
    });

    // ESC stänger
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });

    // Lägg i varukorgen
    elCart.addEventListener('click', () => {
      if (!currentDuk || !window.skCart) return;
      window.skCart.add({
        id:       currentDuk.artno,
        artno:    currentDuk.artno,
        name:     currentDuk.name,
        price:    currentDuk.price,
        category: 'Projektorduk',
        image:    currentDuk.image,
        qty:      1
      });
      // Bekräftelse
      elCart.classList.add('added');
      const cartLabel2 = document.getElementById('duk-modal-cart-label');
      if (cartLabel2) cartLabel2.textContent = 'Tillagd ✓';
      // Auto-stäng efter 1.2 sek
      setTimeout(closeModal, 1200);
    });
  })();
</script>
</Layout>
