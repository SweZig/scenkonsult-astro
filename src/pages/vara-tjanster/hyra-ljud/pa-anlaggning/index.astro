---
import Layout from '../../../../layouts/Layout.astro';
import CategoryHero from '../../../../components/CategoryHero.astro';
import CartButton from '../../../../components/CartButton.astro';
import ljudData from '../../../../data/ljud.json';

// Plocka ut ett representativt paket per kategori (det första/enklaste)
const eventSmall    = ljudData.event.products[0];
const portableSmall = ljudData.portable.products[0];
const musicSmall    = ljudData.music.products[0];
const liveSmall     = ljudData.live.products[0];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Vad kostar det att hyra en PA-anläggning i Stockholm?",
      "acceptedAnswer": { "@type": "Answer", "text": "En PA-anläggning hyrs från 599 kr/dygn för mindre evenemang upp till 60 personer. Större system för 100–500 personer kostar 1 199–3 199 kr/dygn. Konsertsystem och line arrays offerteras separat. Transport tillkommer." }
    },
    {
      "@type": "Question",
      "name": "Vilken PA-anläggning behöver jag?",
      "acceptedAnswer": { "@type": "Answer", "text": "Det beror på antal gäster och typ av event. Upp till 100 pers: Event Small (799 kr). 100–280 pers: Event Medium–Large (1 199–2 399 kr). Liveband och konserter: Music eller Live-serien. Utomhus: räkna med ett steg upp i effekt." }
    },
    {
      "@type": "Question",
      "name": "Ingår uppriggning och support i hyran?",
      "acceptedAnswer": { "@type": "Answer", "text": "Grundpriset gäller utrustningen. Leverans, montering och teknisk support tillkommer och offerteras separat baserat på ditt event. Vi har personal som kan assistera hela evenemanget om du önskar." }
    },
    {
      "@type": "Question",
      "name": "Kan jag hyra PA-anläggning utan att ha teknisk kunskap?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja — alla våra PA-system levereras konfigurerade och klara att använda. Portable-serien är speciellt enkel med inbyggd Bluetooth och färre kablar. Vi erbjuder alltid en genomgång vid leverans." }
    },
    {
      "@type": "Question",
      "name": "Levererar ni PA-anläggningar i Stockholm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja, vi levererar och hämtar i hela Storstockholm. Transport tillkommer. Vi har hyrt ut PA-anläggningar i Stockholm sedan 1986." }
    }
  ]
};

// Kategorikort med data
const categories = [
  {
    title: "Event PA",
    subtitle: "Tal, musik & fest",
    desc: "Fullrange PA-system för fest, bröllop och konferens. Ger tydligt tal och musikaliskt ljud utan subwoofer.",
    persons: "Upp till 100–560 pers.",
    price: ljudData.event.products[0].price,
    priceTo: ljudData.event.products[ljudData.event.products.length - 2].price,
    href: "/vara-tjanster/hyra-ljud/event/",
    icon: "🎤",
    tags: ["Tal & musik", "Med eller utan sub", "Enkelt setup"],
    artno: ljudData.event.products[0].artno,
    name: ljudData.event.products[0].name,
    image: ljudData.event.products[0].image,
  },
  {
    title: "Portable PA",
    subtitle: "Batteridrift & Bluetooth",
    desc: "Trådlösa och batteridrivna system — inga kablar behövs. Perfekt för utomhus, studentflak och mobila event.",
    persons: "20–200 pers.",
    price: ljudData.portable.products[0].price,
    priceTo: ljudData.portable.products[ljudData.portable.products.length - 1].price,
    href: "/vara-tjanster/hyra-ljud/portable/",
    icon: "🔋",
    tags: ["Batteridrift", "Bluetooth", "Utomhus"],
    artno: ljudData.portable.products[0].artno,
    name: ljudData.portable.products[0].name,
    image: ljudData.portable.products[0].image,
  },
  {
    title: "Music PA",
    subtitle: "För liveband & artister",
    desc: "Kraftfulla PA-system optimerade för levande musik med full bas och hög SPL. Sub ingår i de flesta paket.",
    persons: "20–3 000 pers.",
    price: ljudData.music.products[0].price,
    priceTo: ljudData.music.products[2].price,
    href: "/vara-tjanster/hyra-ljud/music/",
    icon: "🎸",
    tags: ["Sub ingår", "Hög SPL", "Liveband"],
    artno: ljudData.music.products[0].artno,
    name: ljudData.music.products[0].name,
    image: ljudData.music.products[0].image,
  },
  {
    title: "Live PA",
    subtitle: "Scen & konsert",
    desc: "Scenanpassade PA-system med subwoofer för konserter, festivaler och stora evenemang. Line array-system tillgängliga.",
    persons: "20–3 000 pers.",
    price: ljudData.live.products[0].price,
    priceTo: ljudData.live.products[2].price,
    href: "/vara-tjanster/hyra-ljud/live/",
    icon: "🎵",
    tags: ["Sub ingår", "Line array", "Festival"],
    artno: ljudData.live.products[0].artno,
    name: ljudData.live.products[0].name,
    image: ljudData.live.products[0].image,
  }
];
---
<Layout
  title="Hyra PA-anläggning Stockholm — Alla Storlekar från 599 kr | Scenkonsult"
  description="Hyr PA-anläggning i Stockholm från 599 kr/dygn. Event, Portable, Music och Live PA för 20–3 000 personer. Leverans och montering i hela Storstockholm sedan 1986."
  schemaExtra={faqSchema}
>

  <CategoryHero
    h1="Hyra PA-anläggning"
    h1Accent="Stockholm"
    intro="Hyr PA-anläggning i Stockholm från 599 kr/dygn — för allt från litet möte till stor konsert. Vi har rätt system för ditt event oavsett storlek, inomhus eller utomhus. Leverans i hela Storstockholm."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" },
      { label: "PA-anläggning" }
    ]}
    badges={[
      "Från 599 kr/dygn",
      "20–3 000 personer",
      "Inomhus & utomhus",
      "Batteridrift tillgängligt",
      "Leverans i Storstockholm",
    ]}
    priceFrom={599}
  />

  <!-- Vad är en PA-anläggning -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <div class="bg-brand-navy border border-white/10 rounded-2xl p-8">
      <h2 class="text-xl font-bold text-white mb-3">Vad är en PA-anläggning?</h2>
      <p class="text-gray-400 leading-relaxed">
        PA-anläggning (Public Address) är ett komplett ljudsystem med förstärkare och högtalare för att förstärka ljud till en publik. Vi erbjuder fyra typer — <strong class="text-white">Event PA</strong> för tal och festmusik, <strong class="text-white">Portable PA</strong> för batteridriven flexibilitet, <strong class="text-white">Music PA</strong> för liveband och <strong class="text-white">Live PA</strong> för konserter och scenevent.
      </p>
    </div>
  </section>

  <!-- Kategori-kort -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-8">Välj PA-system efter ditt event</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {categories.map(cat => (
        <a href={cat.href} class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img
              src={cat.image}
              alt={cat.title}
              width="512" height="427"
              loading="lazy"
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-3xl">{cat.icon}</span>
              <div>
                <h3 class="font-bold text-white text-xl">{cat.title}</h3>
                <p class="text-brand-orange text-sm">{cat.subtitle}</p>
              </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 flex-1">{cat.desc}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {cat.tags.map(tag => (
                <span class="bg-white/5 border border-white/10 text-gray-400 text-xs px-3 py-1 rounded-full">{tag}</span>
              ))}
            </div>
            <div class="flex items-center justify-between border-t border-white/10 pt-4">
              <div>
                <span class="text-gray-400 text-xs block">{cat.persons}</span>
                <span class="text-brand-orange font-bold text-lg">{cat.price.toLocaleString('sv-SE')}–{cat.priceTo.toLocaleString('sv-SE')} kr</span>
                <span class="text-gray-400 text-xs">/dygn</span>
              </div>
              <span class="text-brand-orange text-sm font-semibold group-hover:underline">Se alla paket →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Välj rätt PA-guide -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="bg-brand-navy border border-white/10 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-6">Vilken PA-anläggning passar dig?</h2>
      <div class="space-y-4">
        {[
          { persons: "Upp till 60 pers.", rec: "Portable Small eller Event Small", price: "599–799 kr/dygn", use: "Möten, mindre fester, utomhus utan el" },
          { persons: "60–150 pers.", rec: "Event Medium eller Music Small", price: "1 199–1 499 kr/dygn", use: "Bröllop, företagsfest, liveband i liten lokal" },
          { persons: "150–300 pers.", rec: "Event Large eller Music Medium", price: "1 599–1 899 kr/dygn", use: "Konferens, konsert, studentflak" },
          { persons: "300–600 pers.", rec: "Event Large+ eller Music Large", price: "1 899–3 199 kr/dygn", use: "Stor fest, utomhuskonsert, festival" },
          { persons: "600+ pers.", rec: "Live XL / Line Array", price: "Offert", use: "Konsert, festival, stor scen" },
        ].map(row => (
          <div class="flex items-start gap-4 border-b border-white/5 pb-4 last:border-0 last:pb-0">
            <div class="bg-brand-orange/10 border border-brand-orange/20 rounded-lg px-3 py-2 shrink-0 text-center min-w-[100px]">
              <span class="text-brand-orange font-bold text-sm">{row.persons}</span>
            </div>
            <div class="flex-1">
              <div class="text-white font-semibold text-sm">{row.rec}</div>
              <div class="text-gray-400 text-xs mt-0.5">{row.use}</div>
            </div>
            <div class="text-gray-400 text-xs shrink-0 text-right">{row.price}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6">Vanliga frågor om PA-anläggning</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map((f: any) => (
        <details class="bg-brand-navy border border-white/10 rounded-xl p-5 group">
          <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
            {f.name}
            <span class="text-brand-orange text-lg ml-4 shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-gray-400 mt-3 text-sm leading-relaxed">{f.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 text-center">
    <div class="bg-brand-navy border border-brand-orange/20 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-3">Osäker på vilken PA-anläggning du behöver?</h2>
      <p class="text-gray-400 mb-6">Vi hjälper dig välja rätt system för ditt event — oavsett om det är ett bröllop för 50 personer eller en konsert för 1 000. Ring oss eller skicka ett meddelande.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/kontakt/" class="inline-block bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-bold px-8 py-3 rounded-xl transition-colors">
          Kontakta oss
        </a>
        <a href="/vara-tjanster/hyra-ljud/" class="inline-block border border-white/20 hover:border-brand-orange/40 text-white font-bold px-8 py-3 rounded-xl transition-colors">
          Se alla ljudpaket
        </a>
      </div>
    </div>
  </section>


  <!-- Guider & Svens Kunskapsskola -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;">
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1rem;">Läs mer & förbered dig</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Guider</p>
        <a href="/for/guider/hur-stor-pa/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hur stor PA behöver du?</a>
        <a href="/for/guider/hyra-pa-system/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Guide: Hyra PA-system</a>
        <a href="/for/guider/ljud-foretagsfest/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljud till företagsfest</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.60);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
        </div>
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Svens Kunskapsskola</p>
        <a href="/svens-kunskapsskola/#koppla-in-ljudsystem" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Koppla in ett hyrt ljudsystem</a>
        <a href="/svens-kunskapsskola/#kontakter-ljud" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>Video: Kontakter inom ljud</a>
          <a href="/svens-kunskapsskola/" style="display:inline-block;margin-top:0.6rem;color:#c4b5f4;font-size:0.8rem;font-weight:600;text-decoration:none;">Alla videoguider →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
