---
import Layout from '../../../../layouts/Layout.astro';
import KunskapBlock from '../../../../components/KunskapBlock.astro';
import ModernHero from '../../../../components/ModernHero.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import MixerVariantCard from '../../../../components/MixerVariantCard.astro';
import MixerModelCard from '../../../../components/MixerModelCard.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import _ljudData from '../../../../data/ljud.json';
import _elData from '../../../../data/el.json';
import _ljusData from '../../../../data/ljus.json';
import _tjansterData from '../../../../data/tjanster.json';
const _artnoAliases: Record<string,string> = {
  'XLR Multikabel 15 m, 6 kan.':          'SK-LJD-MIK-0014',
  'XLR Multikabel 25 m, 8 kan.':          'SK-LJD-MIK-0015',
  'XLR Multikabel 15 m, 24+8 kan.':       'SK-LJD-MIK-0020',
  'Instrumentmikrofon, blås':              'SK-LJD-MIK-0008',
  'Instrumentmikrofoner, slagverk':        'SK-LJD-MIK-0019',
  'Shure SLXD – trådlöst system, 2 mik':  'SK-LJD-MIK-0026',
  'Shure SLXD – trådlöst system, 2 myggmikrofon': 'SK-LJD-MIK-0027',
  'XLR-kablar':                            'SK-LJD-MIK-0002',
  'Bluetooth-mottagare pro':               'SK-LJD-MIK-0011',
  'Trådlöst mikrofonset 8 kan.':           'SK-LJD-MIK-0030',
  'Trådlöst IEM':                          'SK-LJD-MIK-0018',
  // El-tillbehör förkortade namn
  'Grenuttag 1,5 m': 'SK-EL-0003',
  'Förlängning 10 m': 'SK-EL-0004',
  'Grenuttag på rulle 10 m': 'SK-EL-0007',
  'Grenuttag på rulle 25 m': 'SK-EL-0008',
  'Förlängning 3-fas 16A': 'SK-EL-0009',
  'Förlängning 3-fas 20 m 16A':    'SK-EL-0009',
  'Förlängning 3-fas 20 m 32A':    'SK-EL-0011',
  'Förlängning 3-fas 32A': 'SK-EL-0011',
  'Strömomvandlare 3-fas→1-fas': 'SK-EL-0010',
  'Strömomvandlare 3-fas>1-fas': 'SK-EL-0010',
  'Överkörningsskydd 1 m': 'SK-EL-0006',
  'Elgenerator 2 200 W': 'SK-EL-0012',
  'Elgenerator 6 000 W': 'SK-EL-0013',
  'Regnskydd till högtalare': 'SK-EL-0014',
  'Elgenerator 7700W': 'SK-EL-0013',
  'Elgenerator, 2200W': 'SK-EL-0012',
};
const artnoByName: Record<string,string> = {..._artnoAliases, ...Object.fromEntries(
  [...(_ljudData.mikrofoner||[]), ...(_ljudData.tillbehor_mikrofon||[]), ...(_ljudData.tillbehor_ljud||[]), ...(_elData.products||[]), ...(_ljudData.mixers||[])]
    .filter((p:any) => p.artno)
    .map((p:any) => [p.name, p.artno])
)};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": _ljudData.live.faq.map((f: {q:string,a:string}) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

---
<Layout
  schemaExtra={faqSchema}
  title="Hyra Liveljud Stockholm – PA-system för Konsert & Trubadur | Scenkonsult"
  description="Hyr liveljud för konserter, trubadurer och liveband i Stockholm från 499 kr/dygn. Sub-basar och fullrange paket — Line Array Large täcker upp till 4 000 personer. Leverans i hela Storstockholm."
>

  <ModernHero
    eyebrow="Ljud · Live & konsert"
    h1="Liveljud & konsert i"
    h1Accent="Stockholm"
    intro="Hyr liveljud för konsert, trubadur och liveband i Stockholm. Kraftfulla sub-basar och fullrange högtalarpaket — Line Array Large täcker upp till 4 000 personer. Komplettera med mixerbord och mikrofoner nedan."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" },
      { label: "Live & Konsert" }
    ]}
    chips={[
      { html: 'Från <span class="sk-price-excl">499&nbsp;kr</span><span class="sk-price-incl hidden">624&nbsp;kr</span> / dygn' },
      "Sub-basar & line array",
      "20–4 000 personer",
      "Leverans i Storstockholm",
      "Sedan 1986",
    ]}
  />

  <!-- PAKET -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        ..._ljudData.live.products,
        ..._ljudData.music.products.filter((p: any) => Array.isArray(p.categories) && p.categories.includes('live'))
      ].map((p: any) => (
        <ProductCard
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt ?? p.name}
          description={p.description}
          persons={p.persons}
          specs={p.specs ?? []}
          category="Ljud live"
          monteringMin={p.monteringMin}
          manualUrl={p.manualUrl}
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- VIDEO: SVEN VISAR INKOPPLING -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center bg-brand-navy border border-white/10 rounded-2xl overflow-hidden p-6 lg:p-8">
      <div
        class="sk-video-embed relative rounded-xl overflow-hidden cursor-pointer bg-brand-dark group"
        style="aspect-ratio:16/9"
        data-video-id="gpu903eACmo"
        role="button"
        tabindex="0"
        aria-label="Spela video: Sven visar hur du kopplar in Music & Live-ljudpaketet"
      >
        <img
          src="https://i.ytimg.com/vi/gpu903eACmo/hqdefault.jpg"
          alt="Förhandsvisning: inkoppling av Music & Live-ljudpaket"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <span class="absolute inset-0 flex items-center justify-center bg-black/25 group-hover:bg-black/15 transition-colors">
          <span class="flex items-center justify-center rounded-full" style="width:68px;height:68px;background:rgba(196,181,244,0.92);box-shadow:0 6px 24px rgba(0,0,0,0.35);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="#0c0a24" style="margin-left:3px;"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </span>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white mb-3">Sven visar dig hur du kopplar in ljudpaketet</h2>
        <p class="text-gray-400 mb-5" style="color:rgba(255,255,255,0.72)">Sven går steg för steg igenom hur du kopplar in Live- och Music-paketet, vad de olika kontakterna och reglagen gör och hur du undviker de vanligaste misstagen. Inga förkunskaper krävs.</p>
        <a href="/svens-kunskapsskola/" class="inline-flex items-center gap-2 text-brand-orange font-semibold text-sm" style="color:#c4b5f4;text-decoration:none;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          Fler videoguider i Svens Kunskapsskola →
        </a>
      </div>
    </div>
  </section>

  <!-- MIXERBORD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Mixerbord</h2>
    <p class="text-gray-400 mb-8 text-sm">Koppla in mikrofoner och musikspelare. Mixerbord hyrs separat och ansluts till högtalarpaket.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {(_ljudData.mixerLayout ?? []).map((slot: any) => {
        const byArtno = (a: string) => _ljudData.mixers.find((m: any) => m.artno === a);
        if (slot.type === 'group') {
          const members = slot.members.map((a: string) => byArtno(a)).filter(Boolean).map((m: any) => ({
            artno: m.artno, name: m.name, price: m.price, image: m.image,
            alt: m.alt ?? m.name, description: m.description, specs: m.specs ?? [],
            manualUrl: m.manualUrl, bulky: m.bulky, forceLeverans: m.forceLeverans,
            shortLabel: m.name.includes(',') ? m.name.split(',').slice(1).join(',').trim() : m.name,
          }));
          return <MixerModelCard title={slot.title} selectLabel={slot.selectLabel ?? 'Välj modell'} category="Mixerbord" models={members} />;
        }
        const p = byArtno(slot.artno);
        if (!p) return null;
        if (slot.type === 'variant' && p.variantOption) {
          const v = byArtno(p.variantOption.artno) ?? {};
          return (
            <MixerVariantCard
              artno={p.artno} name={p.name} price={p.price} image={p.image}
              alt={p.alt ?? p.name} description={p.description} specs={p.specs ?? []}
              category="Mixerbord" manualUrl={p.manualUrl} variant={p.variantOption}
              variantName={v.name ?? p.variantOption.comboLabel}
              variantImage={v.image ?? p.image} variantBulky={v.bulky ?? false}
            />
          );
        }
        return (
          <ProductCard
            artno={p.artno} name={p.name} price={p.price} image={p.image}
            alt={p.alt ?? p.name} description={p.description} specs={p.specs ?? []}
            category="Mixerbord" manualUrl={p.manualUrl} bulky={p.bulky} forceLeverans={p.forceLeverans}
          />
        );
      })}
    </div>
  </section>

  <!-- MIKROFONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Mikrofoner</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_ljudData.mikrofoner ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="Mikrofon" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? (p.description ? [p.description] : [])} />
      ))}
    </div>
  </section>

  <!-- TILLBEHÖR TILL MIKROFONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Tillbehör till mikrofoner</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_ljudData.tillbehor_mikrofon?.filter((p:any) => !p.artno?.startsWith('SK-LJD-UPG')) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="Mikrofon tillbehör" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? (p.description ? [p.description] : [])} />
      ))}
    </div>
  </section>

  <!-- ÖVRIGA TILLBEHÖR LJUD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Övriga tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_ljudData.tillbehor_ljud ?? []).filter((p:any) => !p.categories || p.categories.includes('live')).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="Ljud tillbehör" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? (p.description ? [p.description] : [])} />
      ))}
    </div>
  </section>

  <!-- EL-TILLBEHÖR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_elData.products ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="El-tillbehör" artno={p.artno} />
      ))}
      {(_ljusData.rok?.tillbehor?.filter((p:any) => ['SK-LJS-ROK-ACC-0001','SK-LJS-ROK-ACC-0002'].includes(p.artno)) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="El-tillbehör" artno={p.artno} priceNote={p.priceNote ?? '/st'} />
      ))}
    </div>
  </section>

  <!-- TEKNIKER & TJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Tekniker & tjänster</h2>
    <p class="text-gray-400 text-sm mb-6">Behöver du en professionell tekniker på plats? Vi hyr ut scenengineers som hanterar ljud, ljus och bild under hela eventet.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {_tjansterData.services?.filter((s:any) => s.categories?.includes('ljud')).map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            {svc.artno && <p class="artno-badge mb-2">{svc.artno}</p>}
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljud/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till hyra ljud</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
    <a href="/kontakt/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Fråga om offert</a>
  </div>

  <KunskapBlock
    guides={[
    { href: "/for/guider/hyra-pa-system/", label: "Hyra PA-system — guide" },
    { href: "/for/guider/hur-stor-pa/", label: "Hur stor PA behöver jag?" },
    { href: "/for/guider/ljud-utomhus/", label: "Ljud utomhus" }
  ]}
    videos={[
    { slug: "ljudpaket-music-live", label: "Koppla in Music & Live-paketet" },
    { slug: "kontakter-ljud", label: "Kontakter inom ljud" },
    { slug: "koppla-in-ljudsystem", label: "Koppla in ett hyrt ljudsystem" }
  ]}
  />


<script>
  document.querySelectorAll('.sk-video-embed').forEach((el) => {
    const play = () => {
      const id = el.getAttribute('data-video-id');
      if (!id || el.dataset.loaded) return;
      el.dataset.loaded = '1';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = 'Videoguide';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      el.innerHTML = '';
      el.appendChild(iframe);
    };
    el.addEventListener('click', play);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(); }
    });
  });
</script>

<!-- rebuild: 2026-05-21 GSC unstuck -->
</Layout>
