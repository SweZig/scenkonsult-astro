---
import Layout from '../../../../layouts/Layout.astro';
import CategoryHero from '../../../../components/CategoryHero.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import _ljudData from '../../../../data/ljud.json';
const _artnoAliases: Record<string,string> = {
  'XLR Multikabel 15 m, 6 kan.':          'SK-LJD-MIK-0014',
  'XLR Multikabel 25 m, 8 kan.':          'SK-LJD-MIK-0015',
  'XLR Multikabel 15 m, 24+8 kan.':       'SK-LJD-MIK-0020',
  'Instrumentmikrofon, blås':              'SK-LJD-MIK-0008',
  'Instrumentmikrofoner, slagverk':        'SK-LJD-MIK-0019',
  'Shure SLXD – trådlöst system, 2 mik':  'SK-LJD-MIK-0026',
  'Shure SLXD – trådlöst system, 2 myggmikrofon': 'SK-LJD-MIK-0027',
  'XLR-kablar':                            'SK-LJD-MIK-0002',
  'Bluetooth-mottagare pro':               'SK-LJD-MIK-0011',
  'Trådlöst mikrofonset 8 kan.':           'SK-LJD-MIK-0030',
  'Trådlöst IEM':                          'SK-LJD-MIK-0018',
  // El-tillbehör förkortade namn
  'Grenuttag 1,5 m': 'SK-LJD-EL-0001',
  'Förlängning 10 m': 'SK-LJD-EL-0002',
  'Grenuttag på rulle 10 m': 'SK-LJD-EL-0003',
  'Grenuttag på rulle 25 m': 'SK-LJD-EL-0004',
  'Förlängning 3-fas 16A': 'SK-LJD-EL-0005',
  'Förlängning 3-fas 20 m 16A':    'SK-LJD-EL-0005',
  'Förlängning 3-fas 20 m 32A':    'SK-LJD-EL-0006',
  'Förlängning 3-fas 32A': 'SK-LJD-EL-0006',
  'Strömomvandlare 3-fas→1-fas': 'SK-LJD-EL-0007',
  'Strömomvandlare 3-fas>1-fas': 'SK-LJD-EL-0007',
  'Överkörningsskydd 1 m': 'SK-LJD-EL-0008',
  'Elgenerator 2 200 W': 'SK-LJD-EL-0010',
  'Elgenerator 7 700 W': 'SK-LJD-EL-0011',
  'Regnskydd till högtalare': 'SK-LJD-EL-0009',
  'Elgenerator 7700W': 'SK-LJD-EL-0011',
  'Elgenerator, 2200W': 'SK-LJD-EL-0010',
};
const artnoByName: Record<string,string> = {..._artnoAliases, ...Object.fromEntries(
  [...(_ljudData.tillbehor_mikrofon||[]), ...(_ljudData.tillbehor_el||[]), ...(_ljudData.mixers||[])]
    .filter((p:any) => p.artno)
    .map((p:any) => [p.name, p.artno])
)};
---
<Layout
  title="Hyra Liveljud Stockholm – PA-system för Konsert & Trubadur | Scenkonsult"
  description="Hyr liveljud för konserter, trubadurer och liveband i Stockholm från 599 kr/dygn. Sub-basar och fullrange paket för 20–1 500 personer. Leverans i hela Storstockholm."
>

  <CategoryHero
    h1="Liveljud & Konsert"
    h1Accent="Stockholm"
    intro="Hyr liveljud för konsert, trubadur och liveband i Stockholm. Kraftfulla sub-basar och fullrange högtalarpaket för 20–1 500 personer. Komplettera med mixerbord och mikrofoner nedan."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" },
      { label: "Live & Konsert" }
    ]}
    badges={[
      "Sub-basar & line array",
      "20–1 500 personer",
      "Leverans i Storstockholm",
    ]}
    priceFrom={599}
  />

  <!-- PAKET -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {_ljudData.live.products.map((p: any) => (
        <ProductCard
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt ?? p.name}
          description={p.description}
          persons={p.persons}
          specs={p.specs ?? []}
          category="Ljud live"
          monteringMin={p.monteringMin}
          manualUrl={p.manualUrl}
        />
      ))}
    </div>
  </section>
  <!-- MIXERBORD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Mixerbord</h2>
    <p class="text-gray-400 mb-8 text-sm">Koppla in mikrofoner och musikspelare. Mixerbord hyrs separat och ansluts till högtalarpaket.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {_ljudData.mixers.map((p: any) => (
        <ProductCard
          artno={p.artno}
          name={p.name}
          price={p.price}
          image={p.image}
          alt={p.alt ?? p.name}
          description={p.description}
          specs={p.specs ?? []}
          category="Mixerbord"
          manualUrl={p.manualUrl}
        />
      ))}
    </div>
  </section>

  <!-- MIKROFONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Mikrofoner &amp; tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {[
        { id:"SK-LJD-MIK-0001", name:"Högtalarstativ Gravity",        desc:"Max last 30 kg, vikt 3,7 kg",  price:40,  img:"/images/ljud/pp_ljud_stativ-gravity.png" },
        { id:"SK-LJD-MIK-0003", name:"Högtalarstativ K&M",             desc:"Max last 30 kg, vikt 3,7 kg",  price:50,  img:"/images/ljud/pp_ljud_stativ-km.png" },
        { id:"SK-LJD-MIK-0005", name:"Högtalarstativ Gravity Premium",  desc:"Max last 50 kg, vikt 6,4 kg",  price:60,  img:"/images/ljud/pp_ljud_stativ-gravity-premium.png" },
        { id:"SK-LJD-MIK-0010", name:"Högtalarstativ Gravity med vev",  desc:"Max last 50 kg, vikt 9,1 kg",  price:120, img:"/images/ljud/pp_ljud_stativ-gravity-vev.png" },
        { id:"SK-LJD-EL-0012", name:"Lyfttorn för line array",            desc:"Max last 200 kg, höjd upp till 6 m", price:2999, img:"/images/ljud/pp_ljud_lift.png" },
        { id:"SK-LJD-MIK-0004", name:"Mikrofonstativ",                  desc:"Justerbar höjd",                     price:60,   img:"/images/ljud/pp_ljud_tillbehor06.png" },
        { id:"SK-LJD-MIK-0002", name:"XLR-kablar",                      desc:"1–15 m, fr 40 kr",                  price:40,   img:"/images/ljud/pp_ljud_tillbehor07.png" },
        { id:"SK-LJD-MIK-0014", name:"XLR Multikabel 15 m, 6 kan.",    desc:"Stagebox, 6 kanaler",                price:276,  img:"/images/ljud/pp_ljud_tillbehor_MK-small.png" },
        { id:"SK-LJD-MIK-0014", name:"XLR Multikabel 25 m, 8 kan.",    desc:"Stagebox, 8 kanaler",                price:384,  img:"/images/ljud/pp_ljud_tillbehor_MK-medium.png" },
        { id:"SK-LJD-MIK-0014", name:"XLR Multikabel 15 m, 24+8 kan.", desc:"Stagebox stor, 24+8 kanaler",        price:632,  img:"/images/ljud/pp_ljud_tillbehor_MK-large.png" },
        { id:"SK-LJD-MIK-0012", name:"DI-box (passiv)",                 desc:"2-kan, XLR ut / 6,35 mm in",         price:160,  img:"/images/ljud/pp_ljud_tillbehor_DI-passiv.png" },
        { id:"SK-LJD-MIK-0013", name:"DI-box (aktiv)",                  desc:"1-kan, XLR ut / 6,35 mm in, 9V",    price:240,  img:"/images/ljud/pp_ljud_tillbehor_DI-aktiv.png" },
        { id:"SK-LJD-MIK-0007", name:"Bluetooth-mottagare",             desc:"Trådlös anslutning till PA",         price:100,  img:"/images/ljud/pp_ljud_tillbehor04.png" },
        { id:"SK-LJD-MIK-0011", name:"Bluetooth-mottagare pro",         desc:"Längre räckvidd",                    price:140,  img:"/images/ljud/pp_ljud_tillbehor_BT-pro.png" },
        { id:"SK-LJD-MIK-0009", name:"Instrumentmikrofon",              desc:"Gitarr, blås m.m., inkl XLR",        price:64,   img:"/images/ljud/pp_ljud_mik02.png" },
        { id:"SK-LJD-MIK-0008", name:"Instrumentmikrofon, blås",        desc:"Blåsinstrument, inkl XLR",           price:80,   img:"/images/ljud/pp_ljud_mik04.png" },
        { id:"SK-LJD-MIK-0006", name:"Handmikrofon",                    desc:"Inkl 6 m XLR-kabel",                 price:80,   img:"/images/ljud/pp_ljud_mik01.png" },
        { id:"SK-LJD-MIK-0019", name:"Instrumentmikrofoner, slagverk",  desc:"Trumset, inkl XLR-kablar",           price:480,  img:"/images/ljud/pp_ljud_mik03.png" },
        { id:"SK-LJD-MIK-0016", name:"Trådlös handmikrofon",            desc:"Ca 30 m räckvidd",                   price:400,  img:"/images/ljud/pp_ljud_mik05.png" , specs:['UHF trådlös, ca 30 m räckvidd', 'Mottagarenhet ingår', 'Kräver AA-batteri', 'Plug & play']},
        { id:"SK-LJD-MIK-0017", name:"Trådlöst headset",                desc:"Ca 30 m räckvidd",                   price:480,  img:"/images/ljud/pp_ljud_mik06.png" , specs:['UHF trådlös, ca 30 m räckvidd', 'Bodypack + headset ingår', 'Kräver AA-batteri']},
        { id:"SK-LJD-MIK-0018", name:"Trådlöst IEM",                    desc:"In-ear monitor, ca 30 m",            price:480,  img:"/images/ljud/pp_ljud_tillbehor01.png" },
        { id:"SK-LJD-MIK-0021", name:"Shure SLXD – trådlöst system, 1 mik",          desc:"Digitalt, AES-256, 1× SM58-kapsel, ca 100 m",        price:699,  img:"/images/ljud/pp_ljud_mik09.png" , specs:['Digitalt AES-256 krypterat', 'SM58-kapsel (vokal)', 'Räckvidd ca 100 m', 'Auto-scan frekvens', 'Rack-monterbar mottagare']},
        { id:"SK-LJD-MIK-0022", name:"Shure SLXD – trådlöst system, 1 myggmikrofon", desc:"Digitalt, AES-256, 1× bodypack + myggmik, ca 100 m",  price:699,  img:"/images/ljud/pp_ljud_mik13.png" , specs:['Digitalt AES-256 krypterat', 'Bodypack + myggmikrofon', 'Räckvidd ca 100 m', 'Auto-scan frekvens', 'Rack-monterbar mottagare']},
        { id:"SK-LJD-MIK-0023", name:"Shure SLXD – trådlöst system, 1 headset",      desc:"Digitalt, AES-256, 1× bodypack + headset, ca 100 m",  price:749,  img:"/images/ljud/pp_ljud_mik12.png" , specs:['Digitalt AES-256 krypterat', 'Bodypack + headset', 'Räckvidd ca 100 m', 'Auto-scan frekvens', 'Rack-monterbar mottagare']},
        { id:"SK-LJD-MIK-0024", name:"Shure SLXD – trådlöst system, 1 lågprofil headset", desc:"Digitalt, AES-256, 1× bodypack + öronhängande headset, ca 100 m", price:799, img:"/images/ljud/pp_ljud_mik14.png" , specs:['Digitalt AES-256 krypterat', 'Bodypack + öronhängande headset', 'Räckvidd ca 100 m', 'Diskret lågprofil-design']},
        { id:"SK-LJD-MIK-0025", name:"Effektrack med matrix & feedback-suppressor",   desc:"5-zon ART-matrix + Klark Teknik DP1000",              price:1036, img:"/images/ljud/pp_ljud_effektrack.png" , specs:['5-zon ART-matrix', 'Klark Teknik DP1000 feedback-suppressor', 'Förhindrar rundgång', 'Rack-monterat 19\"']},
        { id:"SK-LJD-MIK-0021", name:"Shure SLXD – trådlöst system, 2 mik",          desc:"Digitalt, AES-256, 2× SM58, ca 100 m",               price:1299, img:"/images/ljud/pp_ljud_mik-shure-slxd4d.png" , specs:['Digitalt AES-256 krypterat', '2× SM58 handhållna mikrofoner', 'Dual-channel mottagare', 'Räckvidd ca 100 m']},
        { id:"SK-LJD-MIK-0021", name:"Shure SLXD – trådlöst system, 2 myggmikrofon", desc:"Digitalt, AES-256, 2× bodypack + myggmik, ca 100 m",  price:1299, img:"/images/ljud/pp_ljud_mik10.png" , specs:['Digitalt AES-256 krypterat', '2× bodypack + myggmikrofon', 'Dual-channel mottagare', 'Räckvidd ca 100 m']},
        { id:"SK-LJD-MIK-0028", name:"Shure SLXD – trådlöst system, 2 headset",      desc:"Digitalt, AES-256, 2× bodypack + headset, ca 100 m",  price:1399, img:"/images/ljud/pp_ljud_mik08.png" , specs:['Digitalt AES-256 krypterat', '2× bodypack + headset', 'Dual-channel mottagare', 'Räckvidd ca 100 m']},
        { id:"SK-LJD-MIK-0029", name:"Shure SLXD – trådlöst system, 2 lågprofil headset", desc:"Digitalt, AES-256, 2× bodypack + öronhängande headset, ca 100 m", price:1499, img:"/images/ljud/pp_ljud_mik11.png" , specs:['Digitalt AES-256 krypterat', '2× bodypack + lågprofil headset', 'Dual-channel mottagare', 'Räckvidd ca 100 m']},
        { id:"SK-LJD-MIK-0030", name:"Trådlöst mikrofonset 8 kan.",                   desc:"4 hand + 4 headset, antennsplitter",                 price:3999, img:"/images/ljud/pp_ljud_tillbehor20.png" , specs:['4× handmikrofon + 4× headset', 'Antennsplitter ingår', '823–832 MHz band', 'Räckvidd upp till 50 m', '8 oberoende kanaler']},
      
      
      
      
      
      
      
      ].map(item => (
        <ElTillbehorCard img={item.img} name={item.name} excl={item.price} desc={item.desc} category="Ljud tillbehör" artno={artnoByName[item.name]} modal={item.price >= 400} specs={item.specs ?? (item.desc ? [item.desc] : [])} />
      ))}
    </div>
  </section>

  <!-- EL-TILLBEHÖR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {[
        { img:"/images/ljus/pp_el_grenuttag_sm.png",    name:"Grenuttag 1,5 m",             excl:20,  desc:"Jordat, 3–5 uttag, 16A" },
        { img:"/images/ljus/pp_el_forlangning.png",     name:"Förlängning 10 m",            excl:48,  desc:"1-fas, 16A, IP44" },
        { img:"/images/ljus/pp_el_overloppsskydd.png",  name:"Överkörningsskydd 1 m",       excl:80,  desc:"Kabelramp, 2 kanaler" },
        { img:"/images/ljus/pp_el_grenuttag_lg.png",    name:"Grenuttag på rulle 10 m",     excl:100, desc:"4 uttag, 16A, IP44" },
        { img:"/images/ljus/pp_el_grenuttag_25m.png",   name:"Grenuttag på rulle 25 m",     excl:159, desc:"4 uttag, 16A, IP44" },
        { img:"/images/ljus/pp_el_forlangning_20m.png", name:"Förlängning 3-fas 20 m 16A",  excl:236, desc:"3-fas, 16A, IP44" },
        { img:"/images/ljus/pp_el_omvandlare.png",      name:"Strömomvandlare 3-fas→1-fas", excl:320, desc:"32A 3-fas till 1-fas uttag" },
        { img:"/images/ljus/pp_el_forlangning_20m.png", name:"Förlängning 3-fas 20 m 32A",  excl:396, desc:"3-fas, 32A, IP44" },
        { img:"/images/ljud/pp_ljud_tillbehor_elverk-small.png", name:"Elgenerator 2 200 W",       excl:799, desc:"1 900 W kontinuerlig, bensin 4-takt" },
        { img:"/images/ljud/pp_ljud_elverk-kipor.png", name:"Elgenerator 7 700 W",       excl:1799, desc:"7 000 W kontinuerlig, bensin 4-takt. Kipor IG6000." },
        { img:"/images/ljus/pp_ljus_ackrylatbensin_1L.png", name:"Ackrylatbensin 1 l", excl:59,  desc:"Aspen 4 · 4-taktsmotorer" },
        { img:"/images/ljus/pp_ljus_ackrylatbensin_5L.png", name:"Ackrylatbensin 5 l", excl:239, desc:"Aspen 4 · 4-taktsmotorer" },
      ].map(t => (
        <ElTillbehorCard img={t.img} name={t.name} excl={t.excl} desc={t.desc} category="El-tillbehör" artno={artnoByName[t.name]} />
      ))}
    </div>
  </section>

  <!-- TEKNIKER & TJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Tekniker & tjänster</h2>
    <p class="text-gray-400 text-sm mb-6">Behöver du en professionell tekniker på plats? Vi hyr ut scenengineers som hanterar ljud, ljus och bild under hela eventet.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {_ljudData.services?.map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljud/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till hyra ljud</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
    <a href="/kontakt/" class="border border-white/30 text-white hover:bg-white/10 px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Fråga om offert</a>
  </div>

  <!-- Guider & Svens Kunskapsskola -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;">
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 1rem;">Läs mer & förbered dig</p>
      <div style="display:flex;flex-wrap:wrap;gap:2.5rem;">
        <div style="flex:1;min-width:220px;">
          <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin:0 0 0.5rem;">Guider</p>
        <a href="/for/guider/hur-stor-pa/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Hur stor PA behöver du?</a>
        <a href="/for/guider/hyra-pa-system/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Guide: Hyra PA-system</a>
        <a href="/for/guider/ljud-utomhus/" style="display:flex;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.7);font-size:0.88rem;text-decoration:none;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);transition:color 0.15s;" onmouseenter="this.style.color='#c4b5f4'" onmouseleave="this.style.color='rgba(255,255,255,0.7)'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>Ljud utomhus — tips & råd</a>
          <a href="/for/guider/" style="display:inline-block;margin-top:0.6rem;color:rgba(255,255,255,0.4);font-size:0.8rem;text-decoration:none;">Alla guider →</a>
