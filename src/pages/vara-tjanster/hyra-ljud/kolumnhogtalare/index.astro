---
import Layout from '../../../../layouts/Layout.astro';
import KunskapBlock from '../../../../components/KunskapBlock.astro';
import ModernHero from '../../../../components/ModernHero.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import MixerVariantCard from '../../../../components/MixerVariantCard.astro';
import MixerModelCard from '../../../../components/MixerModelCard.astro';
import CartButton from '../../../../components/CartButton.astro';
import ElTillbehorCard from '../../../../components/ElTillbehorCard.astro';
import _ljudData from '../../../../data/ljud.json';
import _elData from '../../../../data/el.json';
import _ljusData from '../../../../data/ljus.json';
import _tjansterData from '../../../../data/tjanster.json';

// ── Produkter: no-mic-kolumner (egen array, läcker aldrig till portable) ──
const kolumner = _ljudData.kolumnNoMic ?? [];
const singelKolumner = kolumner.filter((p:any) => !p.name.includes('Duo'));
const duoKolumner    = kolumner.filter((p:any) =>  p.name.includes('Duo'));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Vad är en kolumnhögtalare och vad passar den till?",
      "acceptedAnswer": { "@type": "Answer", "text": "En kolumnhögtalare är ett smalt PA-system med bred, jämn ljudspridning. Diskret stativlös design passar konferenser, bröllop och event där utseendet spelar roll." }
    },
    {
      "@type": "Question",
      "name": "Vad är skillnaden mot en vanlig PA-högtalare?",
      "acceptedAnswer": { "@type": "Answer", "text": "Traditionella PA-system placeras på stativ och syns tydligt i lokalen. Kolumnhögtalare är smalare, snyggare och mer diskreta — perfekta när ljudet ska finnas där utan att ta plats visuellt. De ger också jämnare ljudspridning horisontellt, vilket minskar eko och rundgång i hårdare lokaler." }
    },
    {
      "@type": "Question",
      "name": "Ingår mikrofon i kolumnhögtalarna?",
      "acceptedAnswer": { "@type": "Answer", "text": "Dessa paket levereras utan mikrofon, vilket håller priset nere. Behöver du tala eller sjunga lägger du enkelt till en trådlös handmikrofon eller headset som tillval — eller väljer någon av våra mikrofoner längre ned på sidan." }
    },
    {
      "@type": "Question",
      "name": "Vad kostar det att hyra kolumnhögtalare i Stockholm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Kolumnhögtalare utan mikrofon hyrs från 699 kr/dygn (singel). Duo-system (2 kolumner) kostar 1 299–2 199 kr/dygn och täcker upp till 240 personer. Transport tillkommer." }
    },
    {
      "@type": "Question",
      "name": "Har ni kolumnhögtalare som liknar Bose L1?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja — vi hyr ut Alto TS108C, Alto TS112C och LD Systems Maui 28 G2. Professionella alternativ med inbyggd förstärkare, Bluetooth och app-styrning. Från 699 kr/dygn." }
    },
    {
      "@type": "Question",
      "name": "Kan man köra kolumnhögtalare utan tekniker?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja — alla våra kolumnsystem har inbyggd mixer med Bluetooth och är konstruerade för enkel hantering. Anslut telefon eller dator via Bluetooth eller kabel, sätt volymen och ni är igång. Vi ger alltid en genomgång vid leverans." }
    }
  ]
};
const _low = (items: any[]) => Math.min(...items.filter((x: any) => x?.price).map((x: any) => x.price));
const _heroFranExcl = _low((_ljudData as any).kolumnNoMic);
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);
---
<Layout
  title="Hyr Kolumnhögtalare Stockholm — Diskret & Elegant PA från 699 kr | Scenkonsult"
  description="Hyr kolumnhögtalare i Stockholm från 699 kr/dygn. Alto och LD Systems — smal, diskret design för konferens, bröllop och event. Stockholms största utbud. Leverans i hela Storstockholm."
  schemaExtra={faqSchema}
>

  <ModernHero
    eyebrow="Ljud · Kolumnhögtalare"
    h1="Hyra kolumnhögtalare i"
    h1Accent="Stockholm"
    intro="Hyr kolumnhögtalare i Stockholm — smal, diskret design som låter bra utan att synas. Perfekt för konferens, bröllop och event där utseendet spelar roll. Professionella Alto och LD Systems."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" },
      { label: "Kolumnhögtalare" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "Stockholms största utbud",
      "Alto & LD Systems",
      "Bluetooth & inbyggd mixer",
      "Leverans i Storstockholm",
    ]}
  />

  <!-- Singel kolumner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Kolumnhögtalare — singel</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {singelKolumner.map((p:any) => (
        <ProductCard
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt ?? p.name}
          description={p.description}
          persons={p.persons}
          specs={p.specs ?? []}
          category="Ljud kolumnhögtalare"
          monteringMin={p.monteringMin}
          manualUrl={p.manualUrl}
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- Duo kolumner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Kolumnhögtalare — duo (2 kolumner)</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {duoKolumner.map((p:any) => (
        <ProductCard
          artno={p.artno}
          name={p.name}
          price={p.price}
          priceNote={p.priceNote}
          image={p.image}
          alt={p.alt ?? p.name}
          description={p.description}
          persons={p.persons}
          specs={p.specs ?? []}
          category="Ljud kolumnhögtalare"
          monteringMin={p.monteringMin}
          manualUrl={p.manualUrl}
          bulky={p.bulky}
          forceLeverans={p.forceLeverans}
        />
      ))}
    </div>
  </section>

  <!-- VIDEO: SVEN VISAR INKOPPLING -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center bg-brand-navy border border-white/10 rounded-2xl overflow-hidden p-6 lg:p-8">
      <div
        class="sk-video-embed relative rounded-xl overflow-hidden cursor-pointer bg-brand-dark group"
        style="aspect-ratio:16/9"
        data-video-id="LSnzgiwDRMA"
        role="button"
        tabindex="0"
        aria-label="Spela video: Sven visar hur du kopplar in kolumnhögtalarna"
      >
        <img
          src="https://i.ytimg.com/vi/LSnzgiwDRMA/hqdefault.jpg"
          alt="Förhandsvisning: inkoppling av kolumnhögtalare"
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
        <span class="absolute inset-0 flex items-center justify-center bg-black/25 group-hover:bg-black/15 transition-colors">
          <span class="flex items-center justify-center rounded-full" style="width:68px;height:68px;background:rgba(196,181,244,0.92);box-shadow:0 6px 24px rgba(0,0,0,0.35);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="#0c0a24" style="margin-left:3px;"><path d="M8 5v14l11-7z"/></svg>
          </span>
        </span>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-white mb-3">Sven visar dig hur du kopplar in kolumnhögtalarna</h2>
        <p class="text-gray-400 mb-5" style="color:rgba(255,255,255,0.72)">Sven visar steg för steg hur du själv kopplar in kolumnhögtalarna, vad de olika kontakterna och reglagen gör och hur du kommer igång. Inga förkunskaper krävs.</p>
        <a href="/svens-kunskapsskola/" class="inline-flex items-center gap-2 text-brand-orange font-semibold text-sm" style="color:#c4b5f4;text-decoration:none;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#c4b5f4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          Fler videoguider i Svens Kunskapsskola →
        </a>
      </div>
    </div>
  </section>

  <!-- MIXERBORD -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Mixerbord</h2>
    <p class="text-gray-400 mb-8 text-sm">Koppla in mikrofoner och musikspelare. Mixerbord hyrs separat och ansluts till högtalarpaket.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {(_ljudData.mixerLayout ?? []).map((slot: any) => {
        const byArtno = (a: string) => _ljudData.mixers.find((m: any) => m.artno === a);
        if (slot.type === 'group') {
          const members = slot.members.map((a: string) => byArtno(a)).filter(Boolean).map((m: any) => ({
            artno: m.artno, name: m.name, price: m.price, image: m.image,
            alt: m.alt ?? m.name, description: m.description, specs: m.specs ?? [],
            manualUrl: m.manualUrl, bulky: m.bulky, forceLeverans: m.forceLeverans,
            shortLabel: m.name.includes(',') ? m.name.split(',').slice(1).join(',').trim() : m.name,
          }));
          return <MixerModelCard title={slot.title} selectLabel={slot.selectLabel ?? 'Välj modell'} category="Mixerbord" models={members} />;
        }
        const p = byArtno(slot.artno);
        if (!p) return null;
        if (slot.type === 'variant' && p.variantOption) {
          const v = byArtno(p.variantOption.artno) ?? {};
          return (
            <MixerVariantCard
              artno={p.artno} name={p.name} price={p.price} image={p.image}
              alt={p.alt ?? p.name} description={p.description} specs={p.specs ?? []}
              category="Mixerbord" manualUrl={p.manualUrl} variant={p.variantOption}
              variantName={v.name ?? p.variantOption.comboLabel}
              variantImage={v.image ?? p.image} variantBulky={v.bulky ?? false}
            />
          );
        }
        return (
          <ProductCard
            artno={p.artno} name={p.name} price={p.price} image={p.image}
            alt={p.alt ?? p.name} description={p.description} specs={p.specs ?? []}
            category="Mixerbord" manualUrl={p.manualUrl} bulky={p.bulky} forceLeverans={p.forceLeverans}
          />
        );
      })}
    </div>
  </section>

  <!-- MIKROFONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Mikrofoner</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_ljudData.mikrofoner ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="Mikrofon" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? (p.description ? [p.description] : [])} />
      ))}
    </div>
  </section>

  <!-- TILLBEHÖR TILL MIKROFONER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">Tillbehör till mikrofoner</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_ljudData.tillbehor_mikrofon?.filter((p:any) => !p.artno?.startsWith('SK-LJD-UPG')) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="Mikrofon tillbehör" artno={p.artno} modal={(p.price ?? 0) >= 400} specs={p.specs ?? (p.description ? [p.description] : [])} />
      ))}
    </div>
  </section>

  <!-- EL-TILLBEHÖR -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-3">El-tillbehör</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
      {(_elData.products ?? []).filter((p:any) => !['SK-EL-0001','SK-EL-0002','SK-EL-0005'].includes(p.artno)).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="El-tillbehör" artno={p.artno} />
      ))}
      {(_ljusData.rok?.tillbehor?.filter((p:any) => ['SK-EL-0016','SK-EL-0017'].includes(p.artno)) ?? []).map((p: any) => (
        <ElTillbehorCard img={p.image} name={p.name} excl={p.price} desc={p.description ?? p.desc ?? ''} category="El-tillbehör" artno={p.artno} priceNote={p.priceNote ?? '/st'} />
      ))}
    </div>
  </section>

  <!-- TEKNIKER & TJÄNSTER -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-2 border-b border-white/10 pb-3">Tekniker &amp; tjänster</h2>
    <p class="text-gray-400 text-sm mb-6">Behöver du hjälp på plats? Vi erbjuder tekniker och scenengineers som hanterar ljud, ljus och AV under hela eventet.</p>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {_tjansterData.services?.filter((s:any) => s.categories?.includes('ljud')).map((svc: any) => (
        <article class="bg-brand-navy border border-white/10 hover:border-brand-orange/40 rounded-2xl overflow-hidden transition-all group flex flex-col">
          <div class="bg-brand-dark overflow-hidden" style="aspect-ratio:1024/853">
            <img src={svc.image} alt={svc.alt ?? svc.name} width="800" height="665" loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-bold text-white text-lg mb-2">{svc.name}</h3>
            {svc.artno && <p class="artno-badge mb-2">{svc.artno}</p>}
            <p class="text-gray-400 text-sm mb-3 flex-1">{svc.description}</p>
            <ul class="space-y-1 mb-4 text-xs text-gray-400 border-t border-white/10 pt-3">
              {svc.includes?.map((item: string) => (
                <li class="flex gap-1.5"><span class="text-green-400">▸</span>{item}</li>
              ))}
            </ul>
            <div class="mt-auto flex items-center justify-between border-t border-white/10 pt-3 gap-3">
              <div class="leading-none">
                <span class="sk-price-excl text-brand-orange font-extrabold text-xl">{svc.price.toLocaleString('sv')} kr</span>
                <span class="sk-price-incl hidden text-brand-orange font-extrabold text-xl">{Math.round(svc.price * 1.25).toLocaleString('sv')} kr</span>
                <span class="text-gray-400 text-xs">{svc.priceNote ?? '/tim'}</span>
              </div>
              <CartButton id={svc.artno} name={svc.name} price={svc.price} category="Tjänster" artno={svc.artno} image={svc.image} size="md" iconOnly={true} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Vad är kolumnhögtalare -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <div class="bg-brand-navy border border-white/10 rounded-2xl p-8">
      <h2 class="text-xl font-bold text-white mb-3">Vad är en kolumnhögtalare?</h2>
      <p class="text-gray-400 leading-relaxed mb-4">
        En kolumnhögtalare är ett kompakt PA-system med en <strong class="text-white">smal kolumn</strong> med flera diskanthögtalare och en separat basenhet — allt i ett snyggt, diskret paket utan stativ. Jämn, bred ljudspridning med minimalt eko gör den perfekt för <strong class="text-white">konferenser, bröllop, företagsevent och lokaler</strong> där utseendet spelar roll lika mycket som ljudet.
      </p>
      <p class="text-gray-400 leading-relaxed">
        Kolumnhögtalare är kända från varumärket Bose L1 — vi hyr ut <strong class="text-white">Alto TS108C, Alto TS112C och LD Systems Maui 28 G2</strong>, professionella alternativ med samma diskreta design och liknande prestanda.
      </p>
    </div>
  </section>

  <!-- Jämförelse PA vs Kolumn -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <h2 class="text-2xl font-bold text-white mb-6">Kolumnhögtalare vs traditionellt PA-system</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-brand-navy border border-brand-orange/30 rounded-2xl p-6">
        <h3 class="font-bold text-brand-orange text-lg mb-4">✓ Kolumnhögtalare passar när...</h3>
        <ul class="space-y-2 text-gray-400 text-sm">
          {[
            "Utseendet och diskretionen spelar roll",
            "Lokalen är hård med eko-problem",
            "Ni vill undvika synliga stativ",
            "Konferenser med talaramplifiering",
            "Bröllop, mingel och företagsfest",
            "Enkel installation utan tekniker"
          ].map(i => <li class="flex gap-2"><span class="text-green-400 shrink-0">✓</span>{i}</li>)}
        </ul>
      </div>
      <div class="bg-brand-navy border border-white/10 rounded-2xl p-6">
        <h3 class="font-bold text-white text-lg mb-4">→ Traditionellt PA passar bättre när...</h3>
        <ul class="space-y-2 text-gray-400 text-sm">
          {[
            "Ni behöver maximalt antal decibel",
            "Utomhus med stort avstånd till publiken",
            "Liveband med trummor och gitarr",
            "Fler än 240 personer",
            "Ni behöver separata subwoofers",
            "Festival eller stor scenproduktion"
          ].map(i => <li class="flex gap-2"><span class="text-brand-orange shrink-0">→</span>{i}</li>)}
        </ul>
      </div>
    </div>
    <p class="text-gray-400 text-sm mt-4 text-center">Osäker på vad som passar? <a href="/kontakt/" class="text-brand-orange hover:underline">Kontakta oss</a> eller se <a href="/vara-tjanster/hyra-ljud/" class="text-brand-orange hover:underline">alla ljudsystem →</a></p>
  </section>

  <!-- Välj rätt storlek -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="bg-brand-navy border border-white/10 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-6">Välj rätt kolumnhögtalare</h2>
      <div class="space-y-4">
        {[
          { persons: "Upp till 80 pers.", rec: "Kolumn Small",      use: "Tal, konferens, mingel, liten fest" },
          { persons: "60–100 pers.",      rec: "Kolumn Medium",     use: "Bröllop, företagsfest, föreläsning" },
          { persons: "80–120 pers.",      rec: "Kolumn Large",      use: "Konferens, utomhusevent, stor lokal" },
          { persons: "60–100 pers.",      rec: "Kolumn Small Duo",  use: "Bröllop med stereo, dansgolv, fest" },
          { persons: "100–200 pers.",     rec: "Kolumn Medium Duo", use: "Stor konferens, bröllop, kickoff" },
          { persons: "100–240 pers.",     rec: "Kolumn Large Duo",  use: "Stor fest, utomhus, festivalmingel" },
        ].map(row => {
          const _kp = ((_ljudData as any).kolumnNoMic as any[]).find(k => k.name === row.rec)?.price;
          const price = _kp ? `${_kp.toLocaleString('sv')} kr/dygn` : '';
          return (
          <div class="flex items-start gap-4 border-b border-white/5 pb-4 last:border-0 last:pb-0">
            <div class="bg-brand-orange/10 border border-brand-orange/20 rounded-lg px-3 py-2 shrink-0 text-center min-w-[100px]">
              <span class="text-brand-orange font-bold text-xs">{row.persons}</span>
            </div>
            <div class="flex-1">
              <div class="text-white font-semibold text-sm">{row.rec}</div>
              <div class="text-gray-400 text-xs mt-0.5">{row.use}</div>
            </div>
            <div class="text-gray-400 text-xs shrink-0 text-right">{price}</div>
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-2xl font-bold text-white mb-6">Vanliga frågor om kolumnhögtalare</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map((f: any) => (
        <details class="bg-brand-navy border border-white/10 rounded-xl p-5 group">
          <summary class="font-semibold text-white cursor-pointer list-none flex justify-between items-center">
            {f.name}
            <span class="text-brand-orange text-lg ml-4 shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="text-gray-400 mt-3 text-sm leading-relaxed">{f.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA + navigering -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-wrap gap-4">
    <a href="/vara-tjanster/hyra-ljud/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">← Tillbaka till hyra ljud</a>
    <a href="/vara-tjanster/hyra-ljud/portable/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🔋 Portabelt ljud (med mik)</a>
    <a href="/bokningssida/" class="bg-brand-orange hover:bg-brand-orange-light text-white px-5 py-3 rounded-xl text-sm font-semibold transition-colors">Boka nu</a>
