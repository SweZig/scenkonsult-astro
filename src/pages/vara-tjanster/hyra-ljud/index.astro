---
import LjudLjusPromo from '../../../components/LjudLjusPromo.astro';
import KunskapBlock from '../../../components/KunskapBlock.astro';
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import TreSteg from '../../../components/TreSteg.astro';
import KategoriKort from '../../../components/KategoriKort.astro';
import ljudData from '../../../data/ljud.json';
import elData from '../../../data/el.json';
import tjanster from '../../../data/tjanster.json';
import PopularaPaket from '../../../components/PopularaPaket.astro';
import EventBilder from '../../../components/EventBilder.astro';
import LeveransMonteringEl from '../../../components/LeveransMonteringEl.astro';


const categoryIcons = ["◎", "◈", "♫", "⬡"];
const categoryGradients = [
  "from-brand-orange/20 to-transparent",
  "from-violet-500/15 to-transparent",
  "from-blue-500/15 to-transparent",
  "from-emerald-500/15 to-transparent",
];

const extraFaq = [
  { q: "Vad är skillnaden mellan Event-, Live- och Music-system?", a: "Event-system är optimerat för tal och konferens – tydlig mellanregisterstyrka och jämn täckning. Live-system har monitorhögtalare för musiker och klarar höga volymkrav från instrument. Music-system (DJ/dans) har kraftiga subwoofers för djup bas och fullrange för att fylla ett dansgolv." },
  { q: "Hur tidigt behöver jag boka?", a: "Populära helger (midsommar, jul, nyår, studentflak) bokas ofta 2–4 månader i förväg. Vardagar och off-peak kan vi ofta ordna med 1–2 veckors varsel. Ring oss för att kolla tillgänglighet." },
  { q: "Kan jag boka tekniker separat?", a: "Ja – vi erbjuder tekniker för installation, soundcheck och körning under eventet som tillägg. Tekniker finns att boka till alla systemstorlekar, oavsett om du hyr Event, Live eller Music-system." },
  { q: "Vad händer om något går sönder under eventet?", a: "Vi har jourtjänst kvällstid. Ring 072-448 10 00 och vi hjälper dig – antingen via telefon eller med utryckning om det behövs. Ansvar för skador regleras i hyresvillkoren." },
];
const _low = (items: any[]) => Math.min(...items.filter((x: any) => x?.price).map((x: any) => x.price));
const _heroFranExcl = Math.min(_low((ljudData as any).portable.products),_low((ljudData as any).event.products),_low((ljudData as any).music.products),_low((ljudData as any).live.products));
const _heroFranInkl = Math.round(_heroFranExcl * 1.25);

// Priser slås upp på artno — aldrig index (listorna omordnas i admin).
const _byArtno = (artno: string) =>
  ['event', 'music', 'live', 'portable']
    .flatMap((k) => (ljudData as any)[k].products)
    .find((p: any) => p.artno === artno)?.price;
const _fmt = (n: number) => n.toLocaleString('sv-SE').replace(/\u00a0/g, ' ');
extraFaq.unshift({
  q: "Vad kostar det att hyra högtalare till en fest för 100 personer?",
  a: `För fest och dans med upp till 100 gäster räcker Music Small+ med subwoofer, för ${_fmt(_byArtno('SK-LJD-MUS-0002'))} kr/dygn exkl. moms. Ska det bara vara tal eller bakgrundsmusik räcker Event Small från ${_fmt(_byArtno('SK-LJD-EVE-0001'))} kr. Leverans tillkommer om du inte hämtar själv i Vällingby.`,
});

// Praktiska frågor — belopp och batteritid läses ur datafilerna.
const _elverk = (elData as any).products.find((p: any) => p.artno === 'SK-EL-0012')?.price;
const _lev = (tjanster as any).leverans;
const _batteri = Math.max(...(ljudData as any).portable.products
  .filter((p: any) => p.active !== false)
  .flatMap((p: any) => (p.specs ?? []).map((t: string) => Number((t.match(/Batteridrift upp till (\d+) tim/) ?? [])[1] ?? 0))));
extraFaq.push(
  { q: "Räcker ett vanligt eluttag till högtalarna?", a: `Ja, i de flesta fall räcker ett vanligt 10 A-uttag. Till stora ljudpaket med flera subbasar rekommenderar vi att ni tar el från minst två olika eluttag på olika faser – samma sak om ni hyr ett stort paket med ljud, ljus och rök. Utan el: våra batteridrivna högtalare går upp till ${_batteri} timmar, eller hyr ett elverk från ${_fmt(_elverk)} kr/dygn exkl. moms.` },
  { q: "När kan vi hämta och lämna tillbaka utrustningen?", a: `Ett hyresdygn är 22 timmar: hämtning i Vällingby från kl 13:00 och återlämning senast kl 11:00 nästa dag. Vill ni ha det levererat kör vi ut och hämtar i hela Storstockholm – från ${_fmt(_lev.standard.pris)} kr tur och retur exkl. moms, och fordonet väljs efter vad ni hyr.` },
);

const metaDescription = ljudData.metaDescription.replace('{fran}', _fmt(_heroFranExcl));

// FAQ-schemat speglar exakt de frågor som visas på sidan.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [...ljudData.faq, ...extraFaq].map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout title={ljudData.metaTitle} description={metaDescription} schemaExtra={faqSchema}>

  <ModernHero
    bild={{ src: "/images/event/festival_hard_rock_rising_2.webp", w: 1050, alt: "Rockband på scenen under Hard Rock Rising", text: "Hard Rock Rising — Hard Rock Café" }}
    knappar={[{ label: "Se ljudpaketen", href: "#sortiment" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="Ljud · PA & högtalare"
    h1="Hyra högtalare & ljud i"
    h1Accent="Stockholm"
    intro={ljudData.intro}
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Hyra ljud" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${_heroFranExcl.toLocaleString('sv')}&nbsp;kr</span><span class="sk-price-incl hidden">${_heroFranInkl.toLocaleString('sv')}&nbsp;kr</span> / dygn` },
      "20–4 000 personer",
      "Testkört och kalibrerat",
      "Tekniker tillgänglig",
      "Leverans i Storstockholm",
    ]}
  />

  <!-- KATEGORI-GRID (3 + 2) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader id="sortiment" eyebrow="Sortiment" h2="Välj typ av ljud" lead="Välj efter vad som ska låta. Gästantalet står på varje paket inne på sidan." />
    <KategoriKort data={ljudData} />
  </section>

  

  <LjudLjusPromo />

  <TreSteg rubrik="Hur väljer du rätt PA-system?" lead="Tre frågor som avgör vilket system du behöver." steg={[
    { rubrik: "Räkna gästerna", text: "Tumregel: 1 watt per person inomhus, 2–3 watt utomhus. Men akustiken i lokalen spelar lika stor roll – ring oss så hjälper vi dig räkna ut det exakt." },
          { rubrik: "Vad ska ljuda?", text: "Tal och konferens → Event-system. Dansmusik → Music-system med sub. Live band → Live-system med monitor. Utomhus utan el → Portabelt system." },
          { rubrik: "Vill du ha hjälp?", text: "Vi erbjuder tekniker för installation, soundcheck och körning under eventet. Priserna är lägre än du tror – och resultatet är bättre än du tror." }
  ]}>
        <a data-tel="MDcyNDQ4MTAwMA==" data-label="072-448 10 00" href="#tel" class="sk-knapp sk-knapp-p" style="cursor:pointer"><noscript>072-448 10 00</noscript></a>
        <a href="/bokningssida/" class="sk-knapp">Boka online</a>
      </TreSteg>

  <!-- POPULÄRASTE PAKETEN — grupper ur Supabase via src/data/popular.json -->
  <PopularaPaket data={ljudData} kategori="ljud" category="Ljud" />

  <EventBilder kategori="ljud" />

  <!-- LEVERANS, MONTERING & EL — belopp ur tjanster.json, montering.cjs och el.json -->
  <LeveransMonteringEl data={ljudData} typ="ljud" exempel={['SK-LJD-EVE-0001', 'SK-LJD-MUS-0002', 'SK-LJD-LIV-0003']} />

  <!-- VAD INGÅR ALLTID -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-14">
    <div class="border border-white/10 rounded-3xl p-8" style="background:#14113a">
      <h2 class="sk-h2s mb-4">Vad ingår alltid?</h2>
      <div class="text-gray-400 text-sm leading-relaxed space-y-3">
        <p>Alla ljudsystem levereras kompletta med stativ, kablar och adaptrar – testade och kalibrerade. Du behöver inte ta med någonting extra.</p>
        <p>Soundcheck och grundinställning ingår i alla hyror. Vill du ha tekniker som stannar under hela eventet bokas det som tillägg — läs mer om att <a href="/vara-tjanster/hyra-ljudtekniker/" class="text-brand-orange hover:underline">hyra ljudtekniker</a>.</p>
        <p class="font-medium text-gray-300">Alla priser gäller per dygn (22 timmar). Hämtning från kl 13:00, återlämning senast kl 11:00 nästa dag.</p>
      </div>
      <div class="flex flex-wrap gap-4 mt-6">
        <a href="/bokningssida/" class="sk-knapp sk-knapp-p">Boka ljudutrustning</a>
        <a href="/kontakt/" class="sk-knapp">Fråga om offert</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <SectionHeader eyebrow="Vanliga frågor" h2="Vanliga frågor om ljudhyrning" />
    <div class="space-y-4">
      {[...ljudData.faq, ...extraFaq].map(f => (
        <details class="bg-brand-navy border border-white/10 rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-semibold text-white hover:text-brand-orange transition-colors list-none">
            {f.q}
            <span class="text-brand-orange ml-4 shrink-0 group-open:rotate-45 transition-transform duration-200">+</span>
          </summary>
          <div class="px-5 pb-5 text-gray-400 text-sm leading-relaxed border-t border-white/10 pt-4">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- KOMPLETTERA MED -->
  <section class="bg-brand-navy border-t border-white/10 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl text-white mb-6" style="font-family:'DM Serif Display',serif;">Komplettera med</h2>
      <div class="flex flex-wrap gap-4">
        <a href="/vara-tjanster/hyra-ljud-och-ljus/" class="border border-brand-orange/60 text-white hover:bg-brand-orange hover:text-brand-dark px-5 py-3 rounded-xl text-sm font-semibold transition-all">✨ Hyra ljud och ljus i ett paket</a>
        <a href="/vara-tjanster/hyra-scen/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🎭 Hyra scen</a>
        <a href="/vara-tjanster/hyra-ljus/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">💡 Hyra ljus</a>
        <a href="/vara-tjanster/hyra-dj/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">🎛 Hyra DJ-utrustning</a>
        <a href="/vara-tjanster/hyra-bild/" class="border border-white/20 text-gray-300 hover:border-brand-orange hover:text-brand-orange px-5 py-3 rounded-xl text-sm font-semibold transition-all">📽 Hyra bild</a>
      </div>
    </div>
  </section>



<!-- rebuild: 2026-05-21 GSC unstuck -->
  <KunskapBlock
    guides={[
    { href: "/for/guider/hur-stor-pa/", label: "Hur stor PA behöver jag?" },
    { href: "/for/guider/hyra-pa-system/", label: "Hyra PA-system — guide" },
    { href: "/for/guider/ljud-utomhus/", label: "Ljud utomhus" },
    { href: "/for/guider/ljud-foretagsfest/", label: "Ljud till företagsfest" }
  ]}
    videos={[
    { slug: "koppla-in-ljudsystem", label: "Koppla in ett hyrt ljudsystem" },
    { slug: "kontakter-ljud", label: "Kontakter inom ljud" },
    { slug: "hur-det-fungerar", label: "Hur det fungerar att hyra hos oss" }
  ]}
  />

</Layout>
