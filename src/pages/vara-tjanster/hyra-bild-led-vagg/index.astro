---
import Layout from '../../../layouts/Layout.astro';
import ledData from '../../../data/led-paneler.json';

const paneler = ledData.paneler;
const faq = ledData.faq;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  title="Hyr LED-vägg Stockholm — bygg din egen storbildsskärm | Scenkonsult"
  description="Hyr LED-vägg i Stockholm. Bygg din egen konfiguration: indoor P2.604, P1.95 eller outdoor P3.91. Pris från 290 kr per kabinett/dygn. Inkl. processor, ground support & tekniker — Scenkonsult sedan 1986."
  schemaExtra={faqSchema}
>
  <div style="background:linear-gradient(135deg,#1e1850 0%,#0c0a24 60%);padding-top:calc(36px + 130px + clamp(2rem,4vw,3.5rem));padding-bottom:clamp(2.5rem,5vw,4rem);padding-inline:clamp(1rem,5vw,5rem);">
    <div style="max-width:920px;margin:0 auto;">
      <nav aria-label="Brödsmulor" style="margin-bottom:1.5rem;">
        <ol style="display:flex;flex-wrap:wrap;gap:0.35rem;list-style:none;margin:0;padding:0;font-size:0.78rem;color:rgba(255,255,255,0.4);">
          <li><a href="/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Hem</a> <span style="opacity:0.3;">/</span></li>
          <li><a href="/vara-tjanster/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Våra tjänster</a> <span style="opacity:0.3;">/</span></li>
          <li><a href="/vara-tjanster/hyra-bild-projektorer-skarmar/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Bild</a> <span style="opacity:0.3;">/</span></li>
          <li style="color:white;">LED-vägg</li>
        </ol>
      </nav>
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.6rem;">Bild · Storbildsskärm</p>
      <h1 style="font-family:'DM Serif Display',serif;font-size:clamp(2rem,5vw,3.25rem);line-height:1.1;color:white;margin:0 0 1rem;">Hyr LED-vägg <span style="color:#c4b5f4;">Stockholm</span></h1>
      <p style="color:rgba(255,255,255,0.6);font-size:clamp(0.95rem,2vw,1.1rem);line-height:1.75;margin:0 0 1.25rem;">Bygg din egen LED-vägg av modulära kabinett. Tre paneltyper för indoor och outdoor — P1.95 (premium indoor), P2.604 (event indoor) eller P3.91 (utomhus). Konfigurera storlek, se exakt specifikation och pris, och lägg i varukorgen direkt.</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Från <span class="sk-price-excl">290 kr</span><span class="sk-price-incl hidden">363 kr</span> / kabinett / dygn</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Indoor & outdoor (IP65)</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Ground support 1 500 kr/dygn</span>
        <span style="background:rgba(196,181,244,0.12);color:#c4b5f4;padding:0.35rem 0.75rem;border-radius:99px;font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:600;letter-spacing:0.04em;border:1px solid rgba(196,181,244,0.25);">Leverans i Storstockholm</span>
      </div>
    </div>
  </div>

  <article style="background:#0c0a24;padding:clamp(2.5rem,5vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1180px;margin:0 auto;">

      <!-- Kabinettsbild — visar 500x500 och 500x1000 sida vid sida, skalenligt -->
      <div style="margin-bottom:1.5rem;background:#1e1850;border:1px solid rgba(196,181,244,0.15);border-radius:14px;padding:1.5rem 1rem 1rem;">
        <div style="display:flex;align-items:flex-end;justify-content:center;gap:clamp(2rem,6vw,4rem);min-height:240px;">
          <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
            <img src="/images/bild/pp_bld_led_500x500.webp" alt="LED-kabinett 500x500 mm — indoor P1.95 och P2.604" width="399" height="399" loading="lazy" decoding="async" style="display:block;width:auto;height:120px;object-fit:contain;" />
            <div style="text-align:center;">
              <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:600;">500 × 500 mm</div>
              <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.15rem;">Indoor · P1.95 & P2.604</div>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
            <img src="/images/bild/pp_bld_led_500x1000.webp" alt="LED-kabinett 500x1000 mm — outdoor P3.91" width="223" height="446" loading="lazy" decoding="async" style="display:block;width:auto;height:240px;object-fit:contain;" />
            <div style="text-align:center;">
              <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:600;">500 × 1000 mm</div>
              <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.15rem;">Outdoor · P3.91</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Novastar processor info-ruta -->
      <div style="margin-bottom:1.5rem;background:#1e1850;border:1px solid rgba(196,181,244,0.15);border-radius:14px;padding:1.5rem clamp(1rem,3vw,1.75rem);">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 1rem;">Videoprocessor — ingår i alla väggar</p>
        <div style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(1.25rem,3vw,2rem);align-items:center;" id="led-novastar-grid">
          <div style="background:#0c0a24;border-radius:10px;padding:1rem;display:flex;align-items:center;justify-content:center;">
            <img id="led-novastar-img" src="/images/bild/pp_bld_led_vx400pro.webp" alt="Novastar VX-processor" width="2083" height="454" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;max-height:70px;object-fit:contain;" />
          </div>
          <div>
            <div id="led-novastar-name" style="color:white;font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:700;margin-bottom:0.65rem;">Novastar VX400 Pro</div>
            <div id="led-novastar-specs" style="display:flex;flex-direction:column;gap:0.4rem;font-size:0.82rem;"></div>
            <p id="led-novastar-desc" style="color:rgba(255,255,255,0.55);font-size:0.78rem;line-height:1.5;margin:0.85rem 0 0;"></p>
          </div>
        </div>
      </div>

      <!-- KALKYLATOR-CARD -->
      <div id="led-calc" style="background:#1e1850;border:1px solid rgba(196,181,244,0.25);border-radius:16px;padding:clamp(1.25rem,3vw,2.25rem);margin-bottom:3rem;">

        <!-- Input-grid -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem;margin-bottom:1.75rem;">

          <!-- Panel-väljare -->
          <div>
            <label for="led-panel" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Panelmodell</label>
            <select id="led-panel" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;">
              {paneler.map((p, i) => (
                <option
                  value={p.artno}
                  selected={i === 0}
                  data-pw={p.panel_w_mm}
                  data-ph={p.panel_h_mm}
                  data-pxw={p.pixels_w}
                  data-pxh={p.pixels_h}
                  data-pitch={p.pixel_pitch_mm}
                  data-kg={p.weight_kg}
                  data-ptyp={p.power_typ_w}
                  data-pmax={p.power_max_w}
                  data-price={p.price_per_day_excl}
                  data-indoor={p.indoor_outdoor}
                  data-image={p.image}
                  data-name={p.name}
                  data-brightness={p.brightness_nits}
                  data-refresh={p.refresh_hz}
                  data-protection={p.protection_tech}
                  data-fcap={p.flightcase_capacity}
                  data-viewangle={p.view_angle}
                  data-modsize={p.module_size_mm}
                  data-modres={p.module_resolution}
                  data-modqty={p.modules_per_cabinet}
                  data-ledpkg={p.led_packaging}
                  data-pxdens={p.pixel_density_per_sqm}
                  data-scanmode={p.scanning_mode}
                >{p.name} — {p.price_per_day_excl} kr/dygn</option>
              ))}
            </select>
          </div>

          <!-- Input-läge -->
          <div>
            <label style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Ange storlek som</label>
            <div id="led-mode-tabs" role="tablist" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.35rem;background:#221f50;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.25rem;">
              <button type="button" role="tab" aria-selected="true" data-mode="meter" class="led-mode-btn active" style="padding:0.55rem 0.5rem;font-size:0.78rem;font-family:'Space Grotesk',sans-serif;font-weight:600;color:#f0eeff;background:#c4b5f4;color:#0c0a24;border:none;border-radius:6px;cursor:pointer;">B × H</button>
              <button type="button" role="tab" aria-selected="false" data-mode="diagonal" class="led-mode-btn" style="padding:0.55rem 0.5rem;font-size:0.78rem;font-family:'Space Grotesk',sans-serif;font-weight:600;color:#f0eeff;background:transparent;border:none;border-radius:6px;cursor:pointer;">Diagonal</button>
              <button type="button" role="tab" aria-selected="false" data-mode="panels" class="led-mode-btn" style="padding:0.55rem 0.5rem;font-size:0.78rem;font-family:'Space Grotesk',sans-serif;font-weight:600;color:#f0eeff;background:transparent;border:none;border-radius:6px;cursor:pointer;">Antal paneler</button>
            </div>
          </div>
        </div>

        <!-- Input-blocks per mode -->
        <div id="led-inputs" style="margin-bottom:1.75rem;">

          <!-- Mode: meter -->
          <div data-input="meter" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
            <div>
              <label for="led-w-m" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Önskad bredd (meter)</label>
              <input id="led-w-m" type="number" step="0.1" min="0.5" max="30" value="4.0" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;" />
            </div>
            <div>
              <label for="led-h-m" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Önskad höjd (meter)</label>
              <input id="led-h-m" type="number" step="0.1" min="0.5" max="15" value="2.5" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;" />
            </div>
          </div>

          <!-- Mode: diagonal -->
          <div data-input="diagonal" style="display:none;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
            <div>
              <label for="led-diag" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Diagonal (tum)</label>
              <input id="led-diag" type="number" step="10" min="60" max="800" value="180" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;" />
            </div>
            <div>
              <label for="led-ratio" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Aspect ratio</label>
              <select id="led-ratio" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;">
                <option value="16:9" selected>16:9 (widescreen)</option>
                <option value="21:9">21:9 (ultrawide/cinema)</option>
                <option value="4:3">4:3 (traditionell)</option>
                <option value="1:1">1:1 (kvadrat)</option>
                <option value="2:1">2:1 (scenbakgrund)</option>
                <option value="3:1">3:1 (bred scenbakgrund)</option>
              </select>
            </div>
          </div>

          <!-- Mode: panels -->
          <div data-input="panels" style="display:none;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;">
            <div>
              <label for="led-cols" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Antal paneler bredd</label>
              <input id="led-cols" type="number" step="1" min="1" max="60" value="8" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;" />
            </div>
            <div>
              <label for="led-rows" style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.5rem;">Antal paneler höjd</label>
              <input id="led-rows" type="number" step="1" min="1" max="30" value="5" style="width:100%;background:#221f50;color:#f0eeff;color-scheme:dark;border:1px solid rgba(255,255,255,0.15);border-radius:8px;padding:0.75rem 0.85rem;font-size:0.95rem;font-family:inherit;" />
            </div>
          </div>
        </div>

        <!-- Extras -->
        <div style="margin-bottom:1.75rem;padding:1rem 1.25rem;background:rgba(12,10,36,0.4);border-radius:10px;border:1px solid rgba(255,255,255,0.06);display:flex;flex-direction:column;gap:0.85rem;">
          <div>
            <span style="display:block;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.55rem;">Upphängning</span>
            <div id="led-mount-tabs" role="tablist" style="display:grid;grid-template-columns:1fr 1fr;gap:0.35rem;background:#221f50;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.25rem;max-width:480px;">
              <button type="button" role="tab" aria-selected="true" data-mount="ground" class="led-mount-btn active" style="padding:0.55rem 0.5rem;font-size:0.8rem;font-family:'Space Grotesk',sans-serif;font-weight:600;background:#c4b5f4;color:#0c0a24;border:none;border-radius:6px;cursor:pointer;">Ground support <span style="opacity:0.6;font-size:0.72rem;">· 1 500 kr</span></button>
              <button type="button" role="tab" aria-selected="false" data-mount="tross" class="led-mount-btn" style="padding:0.55rem 0.5rem;font-size:0.8rem;font-family:'Space Grotesk',sans-serif;font-weight:600;background:transparent;color:#f0eeff;border:none;border-radius:6px;cursor:pointer;">Trosslösning <span style="opacity:0.6;font-size:0.72rem;">· +5 500 kr</span></button>
            </div>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:1.25rem;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.06);">
            <label style="display:flex;align-items:center;gap:0.6rem;color:rgba(255,255,255,0.8);font-size:0.9rem;cursor:pointer;">
              <input id="led-incl-montering" type="checkbox" checked style="width:18px;height:18px;accent-color:#c4b5f4;cursor:pointer;" />
              <span>Inkludera tekniker (8 tim)</span>
            </label>
            <label style="display:flex;align-items:center;gap:0.6rem;color:rgba(255,255,255,0.8);font-size:0.9rem;cursor:pointer;">
              <input id="led-incl-processor" type="checkbox" checked style="width:18px;height:18px;accent-color:#c4b5f4;cursor:pointer;" />
              <span>Inkludera LED-processor</span>
            </label>
          </div>
        </div>

        <!-- Resultat-grid -->
        <div style="display:grid;grid-template-columns:minmax(280px,1fr) minmax(260px,1fr);gap:1.5rem;align-items:start;" id="led-result-grid">

          <!-- Visuell preview -->
          <div>
            <!-- Main-tabs: visuell vs teknisk -->
            <div id="led-view-tabs" role="tablist" style="display:grid;grid-template-columns:1fr 1fr;gap:0.35rem;background:#221f50;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.25rem;margin-bottom:0.75rem;">
              <button type="button" role="tab" aria-selected="true" data-view="visual" class="led-view-btn active" style="padding:0.5rem 0.5rem;font-size:0.75rem;font-family:'Space Grotesk',sans-serif;font-weight:600;background:#c4b5f4;color:#0c0a24;border:none;border-radius:6px;cursor:pointer;">Visuell vy</button>
              <button type="button" role="tab" aria-selected="false" data-view="technical" class="led-view-btn" style="padding:0.5rem 0.5rem;font-size:0.75rem;font-family:'Space Grotesk',sans-serif;font-weight:600;background:transparent;color:#f0eeff;border:none;border-radius:6px;cursor:pointer;">Teknisk (pixel-grid)</button>
            </div>

            <!-- Toggles för visuella vyn (scen/golv, publik) -->
            <div id="led-visual-opts" style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.6rem;font-size:0.78rem;color:rgba(255,255,255,0.75);">
              <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;">
                <input id="led-opt-stage" type="checkbox" checked style="width:15px;height:15px;accent-color:#c4b5f4;cursor:pointer;" />
                <span>Scen</span>
              </label>
              <label style="display:flex;align-items:center;gap:0.4rem;cursor:pointer;">
                <input id="led-opt-audience" type="checkbox" style="width:15px;height:15px;accent-color:#c4b5f4;cursor:pointer;" />
                <span>Publik framför</span>
              </label>
            </div>

            <div style="background:#0c0a24;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem;display:flex;align-items:center;justify-content:center;min-height:240px;">
              <svg id="led-preview" viewBox="0 0 400 300" style="width:100%;height:auto;max-height:320px;display:block;" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
            <p id="led-preview-caption" style="color:rgba(255,255,255,0.4);font-size:0.78rem;margin:0.5rem 0 0;text-align:center;"></p>
          </div>

          <!-- Specifikation -->
          <div>
            <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 0.6rem;">Specifikation</p>
            <div id="led-specs" style="background:#0c0a24;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem 1.15rem;display:flex;flex-direction:column;gap:0.55rem;font-size:0.88rem;"></div>

            <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:1.25rem 0 0.6rem;">Pris per dygn</p>
            <div style="background:#0c0a24;border:1px solid rgba(196,181,244,0.25);border-radius:10px;padding:1rem 1.15rem;">
              <div id="led-price-rows" style="display:flex;flex-direction:column;gap:0.4rem;font-size:0.85rem;color:rgba(255,255,255,0.7);"></div>
              <div style="border-top:1px solid rgba(255,255,255,0.1);margin-top:0.75rem;padding-top:0.75rem;display:flex;justify-content:space-between;align-items:baseline;">
                <span style="color:white;font-weight:600;">Totalt</span>
                <div style="text-align:right;">
                  <span class="sk-price-excl" id="led-total-excl" style="color:#c4b5f4;font-size:1.45rem;font-weight:800;">0</span>
                  <span class="sk-price-incl hidden" id="led-total-incl" style="color:#c4b5f4;font-size:1.45rem;font-weight:800;">0</span>
                  <span style="color:rgba(255,255,255,0.5);font-size:0.8rem;"> kr/dygn</span>
                </div>
              </div>
              <p style="margin:0.85rem 0 0;padding-top:0.7rem;border-top:1px solid rgba(255,255,255,0.06);color:rgba(255,255,255,0.45);font-size:0.72rem;line-height:1.5;display:flex;align-items:flex-start;gap:0.4rem;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;color:rgba(196,181,244,0.7);"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <span>Signal- och el-kablage tillkommer på dessa priser och offereras separat utifrån specifik installation.</span>
              </p>
            </div>

            <button id="led-add-cart" type="button" style="margin-top:1rem;width:100%;padding:0.85rem 1rem;background:#c4b5f4;color:#0c0a24;border:none;border-radius:10px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.95rem;cursor:pointer;transition:background 0.2s;display:flex;align-items:center;justify-content:center;gap:0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
              </svg>
              Lägg konfigurationen i varukorgen
            </button>
            <p id="led-cart-feedback" style="color:#c4b5f4;font-size:0.82rem;text-align:center;margin:0.6rem 0 0;min-height:1.1em;"></p>
          </div>
        </div>

        <!-- Varningar -->
        <div id="led-warnings" style="margin-top:1.25rem;display:none;"></div>
      </div>

      <!-- FAQ -->
      <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,3vw,1.9rem);color:white;margin:2rem 0 1.25rem;">Vanliga frågor om LED-väggar</h2>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
        {faq.map(f => (
          <details style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem 1.25rem;">
            <summary style="color:white;font-weight:600;cursor:pointer;list-style:none;font-size:0.95rem;">{f.q}</summary>
            <p style="color:rgba(255,255,255,0.65);margin:0.75rem 0 0;font-size:0.92rem;line-height:1.7;">{f.a}</p>
          </details>
        ))}
      </div>

      <!-- CTA -->
      <div style="background:linear-gradient(135deg,#1e1850 0%,#2a2470 100%);border:1px solid rgba(196,181,244,0.25);border-radius:14px;padding:clamp(1.5rem,3vw,2.25rem);text-align:center;">
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.3rem,2.5vw,1.7rem);color:white;margin:0 0 0.75rem;">Behöver du hjälp att välja?</h2>
        <p style="color:rgba(255,255,255,0.65);margin:0 0 1.25rem;font-size:0.95rem;line-height:1.7;">Kalkylatorn ger dig en solid startpunkt — men vi hjälper gärna till att dimensionera rätt paneltyp, rigg och tekniker för just ditt event.</p>
        <a href="/kontakt/" style="display:inline-block;background:#c4b5f4;color:#0c0a24;padding:0.85rem 1.75rem;border-radius:10px;text-decoration:none;font-weight:700;font-family:'Space Grotesk',sans-serif;">Kontakta oss för offert →</a>
      </div>

    </div>
  </article>

  <script is:inline define:vars={{ ledData }}>
    (function() {
      'use strict';

      const PANELS = ledData.paneler;
      const TILL = ledData.tillbehor;

      const $ = (id) => document.getElementById(id);
      const panelSel = $('led-panel');
      const modeTabsContainer = $('led-mode-tabs');
      const inputsRoot = $('led-inputs');
      const specsEl = $('led-specs');
      const priceRowsEl = $('led-price-rows');
      const totalExcl = $('led-total-excl');
      const totalIncl = $('led-total-incl');
      const preview = $('led-preview');
      const previewCaption = $('led-preview-caption');
      const warningsEl = $('led-warnings');
      const addBtn = $('led-add-cart');
      const feedbackEl = $('led-cart-feedback');

      const wM = $('led-w-m');
      const hM = $('led-h-m');
      const diag = $('led-diag');
      const ratio = $('led-ratio');
      const cols = $('led-cols');
      const rows = $('led-rows');

      const inclMontering = $('led-incl-montering');
      const inclProcessor = $('led-incl-processor');

      let mode = 'meter';
      let view = 'visual';        // 'visual' | 'technical'
      let mount = 'ground';       // 'ground' | 'tross'
      let showStage = true;
      let showAudience = false;
      let lastCalc = null;

      const mountTabs = $('led-mount-tabs');
      const novastarImg = $('led-novastar-img');
      const novastarName = $('led-novastar-name');
      const novastarSpecs = $('led-novastar-specs');
      const novastarDesc = $('led-novastar-desc');

      const viewTabs = $('led-view-tabs');
      const visualOpts = $('led-visual-opts');
      const optStage = $('led-opt-stage');
      const optAudience = $('led-opt-audience');

      function getPanel() {
        const opt = panelSel.options[panelSel.selectedIndex];
        return {
          artno: opt.value,
          name: opt.dataset.name,
          pw: +opt.dataset.pw,
          ph: +opt.dataset.ph,
          pxw: +opt.dataset.pxw,
          pxh: +opt.dataset.pxh,
          pitch: +opt.dataset.pitch,
          kg: +opt.dataset.kg,
          ptyp: +opt.dataset.ptyp,
          pmax: +opt.dataset.pmax,
          price: +opt.dataset.price,
          indoor: opt.dataset.indoor,
          image: opt.dataset.image,
          brightness: +opt.dataset.brightness,
          refresh: +opt.dataset.refresh,
          protection: opt.dataset.protection,
          fcap: +opt.dataset.fcap,
          viewangle: opt.dataset.viewangle,
          modsize: opt.dataset.modsize,
          modres: opt.dataset.modres,
          modqty: +opt.dataset.modqty,
          ledpkg: opt.dataset.ledpkg,
          pxdens: +opt.dataset.pxdens,
          scanmode: opt.dataset.scanmode,
        };
      }

      function aspectRatio(s) {
        const [a, b] = s.split(':').map(Number);
        return a / b;
      }

      function calcPanels() {
        const p = getPanel();
        let targetW, targetH;

        if (mode === 'meter') {
          targetW = (+wM.value || 0) * 1000;
          targetH = (+hM.value || 0) * 1000;
        } else if (mode === 'diagonal') {
          const dMm = (+diag.value || 0) * 25.4;
          const ar = aspectRatio(ratio.value);
          const h = dMm / Math.sqrt(ar * ar + 1);
          const w = h * ar;
          targetW = w;
          targetH = h;
        } else {
          const c = Math.max(1, +cols.value || 1);
          const r = Math.max(1, +rows.value || 1);
          return { panel: p, cols: c, rows: r, actualW: c * p.pw, actualH: r * p.ph };
        }

        const c = Math.max(1, Math.round(targetW / p.pw));
        const r = Math.max(1, Math.round(targetH / p.ph));
        return { panel: p, cols: c, rows: r, actualW: c * p.pw, actualH: r * p.ph, targetW, targetH };
      }

      function fmtMm(v) {
        const m = v / 1000;
        return m >= 1 ? m.toFixed(2).replace(/\.?0+$/, '') + ' m' : Math.round(v) + ' mm';
      }

      function fmtKr(v) {
        return new Intl.NumberFormat('sv-SE').format(Math.round(v)) + ' kr';
      }

      function pickProcessor(totalPixels, indoorOutdoor) {
        // Outdoor (P3.91) använder alltid VX400 Pro per leverantörens rekommendation.
        // Indoor (P1.95, P2.604) använder VX1000 Pro pga högre upplösning, men VX400
        // räcker för mindre indoor-väggar.
        if (indoorOutdoor === 'outdoor') return TILL.processor_small;
        if (totalPixels <= TILL.processor_small.max_pixels) return TILL.processor_small;
        return TILL.processor_large;
      }

      function specRow(label, value, strong) {
        return `<div style="display:flex;justify-content:space-between;gap:0.75rem;">
          <span style="color:rgba(255,255,255,0.55);">${label}</span>
          <span style="color:${strong ? 'white' : 'rgba(255,255,255,0.85)'};font-weight:${strong ? 600 : 500};text-align:right;">${value}</span>
        </div>`;
      }

      function specSection(label) {
        return `<div style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-top:0.4rem;padding-top:0.4rem;border-top:1px solid rgba(255,255,255,0.06);">${label}</div>`;
      }

      function priceRow(label, value, sub) {
        return `<div style="display:flex;justify-content:space-between;gap:0.75rem;align-items:baseline;">
          <span>${label}${sub ? `<span style="color:rgba(255,255,255,0.4);font-size:0.78rem;margin-left:0.4rem;">${sub}</span>` : ''}</span>
          <span style="color:rgba(255,255,255,0.9);font-weight:500;white-space:nowrap;">${value}</span>
        </div>`;
      }

      function render() {
        const r = calcPanels();
        const p = r.panel;
        const totalPanels = r.cols * r.rows;
        const totalKg = totalPanels * p.kg;
        const totalTypW = totalPanels * p.ptyp;
        const totalMaxW = totalPanels * p.pmax;
        const pixelsW = r.cols * p.pxw;
        const pixelsH = r.rows * p.pxh;
        const totalPixels = pixelsW * pixelsH;
        const diagonalMm = Math.sqrt(r.actualW * r.actualW + r.actualH * r.actualH);
        const diagonalIn = diagonalMm / 25.4;
        const circuits16A = Math.ceil(totalMaxW / 3500);
        const minViewingM = p.pitch;
        const recViewingM = p.pitch * 2;

        // Antal flightcases — avrundas uppåt baserat på panelens kapacitet
        const flightcases = p.fcap > 0 ? Math.ceil(totalPanels / p.fcap) : 0;

        // Spec-block — gruppindelat med subheaders
        const totalModules = totalPanels * p.modqty;
        specsEl.innerHTML = [
          specSection('Vägg'),
          specRow('Panelmodell', p.name, true),
          specRow('Antal kabinett', `${r.cols} × ${r.rows} = ${totalPanels} st`, true),
          specRow('Antal moduler', `${totalModules} st (${p.modqty}/kab)`),
          specRow('Faktisk storlek', `${fmtMm(r.actualW)} × ${fmtMm(r.actualH)}`, true),
          specRow('Diagonal', `${Math.round(diagonalIn)}″ (${fmtMm(diagonalMm)})`),
          specRow('Vikt', `${totalKg.toFixed(1)} kg`),
          specSection('Bild'),
          specRow('Upplösning', `${pixelsW} × ${pixelsH} px`, true),
          specRow('Total pixlar', `${(totalPixels / 1e6).toFixed(2).replace(/\.?0+$/, '')} MP`),
          specRow('Pixeltäthet', `${p.pxdens.toLocaleString('sv-SE')} px/m²`),
          specRow('Ljusstyrka', `${p.brightness} cd/m² (nits)`),
          specRow('Refresh', `≥ ${p.refresh} Hz`),
          specRow('Synvinkel', p.viewangle),
          specSection('Konstruktion'),
          specRow('Modulstorlek', `${p.modsize} mm`),
          specRow('LED-paketering', p.ledpkg),
          specRow('Skyddsteknik', p.protection),
          specSection('Drift'),
          specRow('Effekt typisk', `${(totalTypW / 1000).toFixed(2)} kW`),
          specRow('Effekt max', `${(totalMaxW / 1000).toFixed(2)} kW`),
          specRow('16A-kretsar', `${circuits16A} st`),
          specSection('Avstånd & transport'),
          specRow('Optimalt visningsavstånd', `≥ ${minViewingM.toFixed(1)} m`),
          specRow('Rekommenderat avstånd', `från ~${recViewingM.toFixed(1)} m`),
          specRow('Flightcases', `${flightcases} st (${p.fcap} kab/case)`),
        ].join('');

        // Priser
        const priceLines = [];
        const panelCost = totalPanels * p.price;
        priceLines.push({ label: `${p.name}`, value: panelCost, sub: `${totalPanels} × ${fmtKr(p.price)}`, key: 'panels' });

        let processorObj = null;
        if (inclProcessor.checked) {
          processorObj = pickProcessor(totalPixels, p.indoor);
          priceLines.push({
            label: processorObj.name,
            value: processorObj.price_per_day_excl,
            sub: '',
            key: 'processor',
          });
        }

        // Dynamisk monteringstid: 6 tim grund + 10 min per panel.
        // Avrundad uppåt till närmaste halvtimme (för rena timpriser i offerter).
        let monteringHours = 0;
        let monteringCost = 0;
        if (inclMontering.checked) {
          const rawMin = 6 * 60 + 10 * totalPanels;       // grund + 10 min/panel
          const roundedMin = Math.ceil(rawMin / 30) * 30;  // upp till närmaste halvtimme
          monteringHours = roundedMin / 60;
          monteringCost = TILL.montering.price_per_hour_excl * monteringHours;
          const hoursLabel = Number.isInteger(monteringHours)
            ? `${monteringHours} tim`
            : `${monteringHours.toFixed(1).replace('.', ',')} tim`;
          priceLines.push({
            label: TILL.montering.name,
            value: monteringCost,
            sub: `${hoursLabel} (6 tim + 10 min × ${totalPanels})`,
            key: 'montering',
          });
        }

        // Upphängning: Ground support eller tross — båda kostar nu (1500 / 5500 kr)
        let mountCost = 0;
        if (mount === 'ground') {
          mountCost = TILL.rigg.price_per_day_excl;
          priceLines.push({ label: TILL.rigg.name, value: mountCost, sub: '', key: 'mount' });
        } else {
          mountCost = TILL.tross.price_per_day_excl;
          priceLines.push({ label: TILL.tross.name, value: mountCost, sub: '', key: 'mount' });
        }

        // Transport — alltid lätt lastbil m. bakgavellift för LED-vägg
        const transportCost = TILL.transport.price_per_day_excl;
        priceLines.push({
          label: TILL.transport.name,
          value: transportCost,
          sub: 'obligatoriskt för LED-vägg',
          key: 'transport',
        });

        priceRowsEl.innerHTML = priceLines.map(l => {
          let valStr;
          if (l.value === null) valStr = '<em style="color:rgba(255,255,255,0.5);">separat</em>';
          else if (l.value === 0) valStr = '<span style="color:rgba(143,214,148,0.85);font-style:italic;">ingår</span>';
          else valStr = fmtKr(l.value);
          return priceRow(l.label, valStr, l.sub);
        }).join('');

        const totalExclVal = panelCost + (processorObj ? processorObj.price_per_day_excl : 0) + monteringCost + mountCost + transportCost;
        totalExcl.textContent = fmtKr(totalExclVal);
        totalExcl.setAttribute('data-exkl', String(totalExclVal));
        totalIncl.textContent = fmtKr(totalExclVal * 1.25);

        // Om applyVat finns globalt, kör den så incl/excl-toggle uppdateras konsekvent
        if (typeof window.applyVat === 'function') {
          try { window.applyVat(); } catch(e) {}
        }

        // Preview-SVG — teknisk eller visuell baserat på view-state
        if (view === 'technical') {
          renderPreview(r.cols, r.rows, r.actualW, r.actualH);
          previewCaption.textContent = `${r.cols} × ${r.rows} paneler · ${fmtMm(r.actualW)} × ${fmtMm(r.actualH)}`;
        } else {
          renderVisualPreview(r.actualW, r.actualH, showStage, showAudience);
          const scaleHint = showStage ? 'scen 1 m hög · person 1,80 m' : 'person 1,80 m för skala';
          previewCaption.textContent = `${fmtMm(r.actualW)} × ${fmtMm(r.actualH)} · ${scaleHint}`;
        }

        // Varningar
        const warnings = [];
        if (mode === 'meter' && r.targetW) {
          const diffW = Math.abs(r.actualW - r.targetW);
          const diffH = Math.abs(r.actualH - r.targetH);
          if (diffW > 10 || diffH > 10) {
            warnings.push(`Faktisk storlek avviker från önskad — paneler måste vara hela enheter. Justeringen blev ${Math.round(r.actualW - r.targetW)} mm bredd och ${Math.round(r.actualH - r.targetH)} mm höjd.`);
          }
        }
        if (totalPanels > 400) {
          warnings.push('Mycket stor vägg (>400 paneler) — rekommenderar att ni kontaktar oss för dimensionering av rigg, ström och processor.');
        }
        if (p.indoor === 'indoor' && mode === 'meter' && (+wM.value > 6 || +hM.value > 4)) {
          warnings.push('Stor indoor-vägg — överväg outdoor-paneler om eventet är utomhus eller i starkt dagsljus.');
        }
        if (warnings.length) {
          warningsEl.style.display = 'block';
          warningsEl.innerHTML = warnings.map(w =>
            `<div style="background:rgba(196,181,244,0.08);border:1px solid rgba(196,181,244,0.25);border-radius:8px;padding:0.75rem 1rem;margin-top:0.5rem;color:rgba(255,255,255,0.75);font-size:0.85rem;line-height:1.55;">
              <strong style="color:#c4b5f4;">OBS:</strong> ${w}
            </div>`
          ).join('');
        } else {
          warningsEl.style.display = 'none';
          warningsEl.innerHTML = '';
        }

        // Spara senaste kalkylation för varukorgs-åtgärder
        lastCalc = {
          panel: p,
          cols: r.cols,
          rows: r.rows,
          totalPanels,
          actualW: r.actualW,
          actualH: r.actualH,
          pixelsW,
          pixelsH,
          processor: processorObj,
          monteringHours: monteringHours,
          mount,
          mountCost,
          totalExclVal,
        };

        // Uppdatera Novastar-info-rutan baserat på vald processor (eller default)
        renderNovastar(processorObj || pickProcessor(totalPixels, p.indoor));
      }

      function renderPreview(c, r, mmW, mmH) {
        const vbW = 400;
        const vbH = 300;
        const pad = 20;
        const availW = vbW - pad * 2;
        const availH = vbH - pad * 2;
        const scale = Math.min(availW / mmW, availH / mmH);
        const drawW = mmW * scale;
        const drawH = mmH * scale;
        const offX = (vbW - drawW) / 2;
        const offY = (vbH - drawH) / 2;

        let rects = '';
        const panelW = drawW / c;
        const panelH = drawH / r;
        for (let i = 0; i < c; i++) {
          for (let j = 0; j < r; j++) {
            rects += `<rect x="${offX + i * panelW}" y="${offY + j * panelH}" width="${panelW}" height="${panelH}" fill="#221f50" stroke="#c4b5f4" stroke-width="0.8" stroke-opacity="0.4"/>`;
          }
        }

        const outerBorder = `<rect x="${offX}" y="${offY}" width="${drawW}" height="${drawH}" fill="none" stroke="#c4b5f4" stroke-width="2"/>`;

        // Skala-etikett under
        const scaleLabel = `<text x="${vbW / 2}" y="${vbH - 4}" text-anchor="middle" font-family="'Space Grotesk',sans-serif" font-size="10" fill="rgba(255,255,255,0.4)">${(mmW / 1000).toFixed(2).replace(/\.?0+$/, '')} m × ${(mmH / 1000).toFixed(2).replace(/\.?0+$/, '')} m</text>`;

        preview.innerHTML = rects + outerBorder + scaleLabel;
      }

      // Visuell preview: scen + LED-vägg + person (180 cm), valfritt publik
      function renderVisualPreview(wallMmW, wallMmH, withStage, withAudience) {
        // Verklig-till-SVG-skala beräknas så att scen + vägg + person får plats.
        // Världsenhet: mm. SVG viewBox: 400 × 300.
        const vbW = 400;
        const vbH = 300;
        const padTop = 15;
        const padSide = 25;
        const padBottomBase = 20;
        const audienceHeightMm = withAudience ? 1700 : 0;  // publik tar plats framför
        const audiencePadMm = withAudience ? 200 : 0;       // luft mellan publik och scen
        const stageHeightMm = withStage ? 1000 : 0;         // 1 m hög scen
        const personHeightMm = 1800;                        // referensperson

        // Total verklig höjd som ska få plats (mm): publik (om på) → scen → vägg (+ person står PÅ scenen bredvid väggen)
        // Person-höjd kan vara högre än vägg om väggen är låg, så jag tar max(väggH, personH) ovanför scenen.
        const topContentMm = Math.max(wallMmH, personHeightMm);
        const worldH = audienceHeightMm + audiencePadMm + stageHeightMm + topContentMm;

        // Bredd: vägg + utrymme för person bredvid (ca 0.8 m) + marginaler
        const personSlotMm = 800;
        const worldW = wallMmW + personSlotMm + 400;  // 400 mm total luft

        // Skala så att världen får plats i SVG-ytan
        const availW = vbW - padSide * 2;
        const availH = vbH - padTop - padBottomBase;
        const scale = Math.min(availW / worldW, availH / worldH);

        // Skalade mått
        const sWallW = wallMmW * scale;
        const sWallH = wallMmH * scale;
        const sStageH = stageHeightMm * scale;
        const sPersonH = personHeightMm * scale;
        const sAudH = audienceHeightMm * scale;
        const sAudPad = audiencePadMm * scale;
        const sPersonSlot = personSlotMm * scale;

        // Total ritad höjd & centrering
        const drawnH = sAudH + sAudPad + sStageH + Math.max(sWallH, sPersonH);
        const drawnW = sWallW + sPersonSlot + 80 * scale;
        const worldOriginX = (vbW - drawnW) / 2;
        const groundY = padTop + (availH - drawnH) / 2 + drawnH;  // nederkant på scenens golv

        // Y-koordinater (SVG Y växer neråt)
        const audienceTopY = groundY - sAudH;
        const audienceBottomY = groundY;
        const stageTopY = groundY - sAudH - sAudPad - sStageH;
        const stageBottomY = stageTopY + sStageH;
        const aboveStageFloorY = stageTopY;  // där person och vägg står
        const wallTopY = aboveStageFloorY - sWallH;
        const personTopY = aboveStageFloorY - sPersonH;

        // X-koordinater: vägg till vänster, person bredvid till höger
        const wallLeftX = worldOriginX + 40 * scale;
        const wallRightX = wallLeftX + sWallW;
        const personX = wallRightX + (sPersonSlot * 0.5);

        const parts = [];

        // Bakgrundsglöd från LED-väggen (subtil lavendel-aura)
        const glowR = Math.max(sWallW, sWallH) * 0.9;
        parts.push(`<defs>
          <radialGradient id="ledGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c4b5f4" stop-opacity="0.18"/>
            <stop offset="70%" stop-color="#c4b5f4" stop-opacity="0.05"/>
            <stop offset="100%" stop-color="#c4b5f4" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="ledScreen" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2a2470"/>
            <stop offset="100%" stop-color="#1a1540"/>
          </linearGradient>
          <linearGradient id="stageGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2a2470"/>
            <stop offset="100%" stop-color="#151040"/>
          </linearGradient>
        </defs>`);

        // Glow bakom väggen
        const wallCx = wallLeftX + sWallW / 2;
        const wallCy = wallTopY + sWallH / 2;
        parts.push(`<ellipse cx="${wallCx}" cy="${wallCy}" rx="${glowR}" ry="${glowR * 0.7}" fill="url(#ledGlow)"/>`);

        // Scen (trapetsoid för lite perspektiv) — bara om toggle
        if (withStage) {
          const stageInset = Math.min(sStageH * 0.4, 15);  // lite perspektiv
          parts.push(`<polygon points="${worldOriginX + stageInset},${stageTopY} ${worldOriginX + drawnW - stageInset},${stageTopY} ${worldOriginX + drawnW},${stageBottomY} ${worldOriginX},${stageBottomY}" fill="url(#stageGrad)" stroke="rgba(196,181,244,0.3)" stroke-width="0.8"/>`);
          // Scenkant-linje ovanpå
          parts.push(`<line x1="${worldOriginX + stageInset}" y1="${stageTopY}" x2="${worldOriginX + drawnW - stageInset}" y2="${stageTopY}" stroke="#c4b5f4" stroke-width="0.8" stroke-opacity="0.5"/>`);
        } else {
          // Platt golv istället — tunn linje
          parts.push(`<line x1="${worldOriginX}" y1="${groundY}" x2="${worldOriginX + drawnW}" y2="${groundY}" stroke="rgba(196,181,244,0.25)" stroke-width="1"/>`);
        }

        // Publik — enkla huvud-siluetter
        if (withAudience) {
          const audienceCount = 9;
          const audienceAreaW = drawnW;
          const headR = Math.min(sAudH * 0.18, 6);
          for (let i = 0; i < audienceCount; i++) {
            const ax = worldOriginX + (audienceAreaW / (audienceCount + 1)) * (i + 1);
            const depthJitter = (i % 3) * (sAudH * 0.12);
            const ay = audienceBottomY - sAudH * 0.55 + depthJitter;
            // Huvud
            parts.push(`<circle cx="${ax}" cy="${ay}" r="${headR}" fill="rgba(255,255,255,0.35)"/>`);
            // Axlar/kropp
            parts.push(`<path d="M ${ax - headR * 1.3} ${audienceBottomY} Q ${ax} ${ay + headR * 1.3} ${ax + headR * 1.3} ${audienceBottomY} Z" fill="rgba(255,255,255,0.22)"/>`);
          }
        }

        // LED-vägg — ram + skärmyta + subtil innehåll
        parts.push(`<rect x="${wallLeftX}" y="${wallTopY}" width="${sWallW}" height="${sWallH}" fill="url(#ledScreen)" stroke="#c4b5f4" stroke-width="1.5"/>`);

        // "Innehåll" i skärmen — abstrakta diagonaler för att antyda bild
        const clipId = 'ledClip' + Date.now();
        parts.push(`<defs><clipPath id="${clipId}"><rect x="${wallLeftX}" y="${wallTopY}" width="${sWallW}" height="${sWallH}"/></clipPath></defs>`);
        parts.push(`<g clip-path="url(#${clipId})" opacity="0.5">
          <circle cx="${wallLeftX + sWallW * 0.35}" cy="${wallTopY + sWallH * 0.4}" r="${Math.min(sWallW, sWallH) * 0.25}" fill="#c4b5f4" opacity="0.25"/>
          <circle cx="${wallLeftX + sWallW * 0.7}" cy="${wallTopY + sWallH * 0.6}" r="${Math.min(sWallW, sWallH) * 0.18}" fill="#e2dcfb" opacity="0.18"/>
        </g>`);

        // Måttband vid väggen — höjdangivelse
        const measureX = wallLeftX - 8;
        parts.push(`<line x1="${measureX}" y1="${wallTopY}" x2="${measureX}" y2="${aboveStageFloorY}" stroke="#c4b5f4" stroke-width="0.6" stroke-opacity="0.6"/>`);
        parts.push(`<line x1="${measureX - 3}" y1="${wallTopY}" x2="${measureX + 3}" y2="${wallTopY}" stroke="#c4b5f4" stroke-width="0.6" stroke-opacity="0.6"/>`);
        parts.push(`<line x1="${measureX - 3}" y1="${aboveStageFloorY}" x2="${measureX + 3}" y2="${aboveStageFloorY}" stroke="#c4b5f4" stroke-width="0.6" stroke-opacity="0.6"/>`);
        const wallHm = (wallMmH / 1000).toFixed(2).replace(/\.?0+$/, '');
        parts.push(`<text x="${measureX - 5}" y="${wallTopY + sWallH / 2 + 3}" text-anchor="end" font-family="'Space Grotesk',sans-serif" font-size="8" fill="rgba(196,181,244,0.9)">${wallHm} m</text>`);

        // Person — stiliserad siluett, 1,80 m. Realistiska proportioner:
        //   - Huvud (kronan till haka): ~23 cm = pH * 0.127
        //   - Axelbredd: ~46 cm = pH * 0.256
        //   - Höftbredd: ~38 cm = pH * 0.211
        //   - Benlängd (från höft till mark): ~90 cm = pH * 0.5
        //   - Midja-höjd från marken: ~108 cm = pH * 0.6
        // Alla mått skalas med samma `scale` som resten av scenen.
        const pH = sPersonH;
        const headH = pH * 0.127;              // huvudhöjd i SVG-enheter
        const headR = headH / 2;                // huvudradie
        const shoulderW = pH * 0.256;
        const hipW = pH * 0.211;
        const shoulderToHipH = pH * 0.273;      // ~49 cm
        const legH = pH * 0.5;                  // ~90 cm
        const neckH = pH * 0.04;
        const pHeadCx = personX;
        const pHeadCy = personTopY + headR;
        const pShoulderY = personTopY + headH + neckH;
        const pHipY = pShoulderY + shoulderToHipH;
        const pFootY = aboveStageFloorY;

        // Huvud
        parts.push(`<circle cx="${pHeadCx}" cy="${pHeadCy}" r="${headR}" fill="rgba(255,255,255,0.9)"/>`);

        // Hals + bål (axlar bredare än höft, rundade axlar)
        const sL = pHeadCx - shoulderW / 2;
        const sR = pHeadCx + shoulderW / 2;
        const hL = pHeadCx - hipW / 2;
        const hR = pHeadCx + hipW / 2;
        const neckL = pHeadCx - headR * 0.35;
        const neckR = pHeadCx + headR * 0.35;
        const shoulderCurve = shoulderW * 0.15;  // hur rundade axlarna är
        parts.push(`<path d="M ${neckL} ${pShoulderY - neckH}
          L ${neckL} ${pShoulderY}
          Q ${sL - shoulderCurve * 0.3} ${pShoulderY + shoulderCurve * 0.2} ${sL} ${pShoulderY + shoulderCurve}
          L ${hL} ${pHipY}
          L ${hR} ${pHipY}
          L ${sR} ${pShoulderY + shoulderCurve}
          Q ${sR + shoulderCurve * 0.3} ${pShoulderY + shoulderCurve * 0.2} ${neckR} ${pShoulderY}
          L ${neckR} ${pShoulderY - neckH}
          Z" fill="rgba(255,255,255,0.9)"/>`);

        // Ben — två smala rektanglar med liten delning i mitten
        const legEach = hipW * 0.44;
        const legGap = hipW * 0.12;
        parts.push(`<rect x="${pHeadCx - legEach - legGap / 2}" y="${pHipY}" width="${legEach}" height="${pFootY - pHipY}" fill="rgba(255,255,255,0.9)" rx="${legEach * 0.15}"/>`);
        parts.push(`<rect x="${pHeadCx + legGap / 2}" y="${pHipY}" width="${legEach}" height="${pFootY - pHipY}" fill="rgba(255,255,255,0.9)" rx="${legEach * 0.15}"/>`);

        // Måttband vid person
        const pMx = personX + shoulderW / 2 + 6;
        parts.push(`<line x1="${pMx}" y1="${personTopY}" x2="${pMx}" y2="${aboveStageFloorY}" stroke="rgba(255,255,255,0.6)" stroke-width="0.6"/>`);
        parts.push(`<line x1="${pMx - 3}" y1="${personTopY}" x2="${pMx + 3}" y2="${personTopY}" stroke="rgba(255,255,255,0.6)" stroke-width="0.6"/>`);
        parts.push(`<line x1="${pMx - 3}" y1="${aboveStageFloorY}" x2="${pMx + 3}" y2="${aboveStageFloorY}" stroke="rgba(255,255,255,0.6)" stroke-width="0.6"/>`);
        parts.push(`<text x="${pMx + 5}" y="${personTopY + sPersonH / 2 + 3}" text-anchor="start" font-family="'Space Grotesk',sans-serif" font-size="8" fill="rgba(255,255,255,0.75)">1,80 m</text>`);

        // Breddmått under väggen
        const wMy = groundY + 8;
        parts.push(`<line x1="${wallLeftX}" y1="${wMy}" x2="${wallRightX}" y2="${wMy}" stroke="rgba(196,181,244,0.5)" stroke-width="0.6"/>`);
        parts.push(`<line x1="${wallLeftX}" y1="${wMy - 3}" x2="${wallLeftX}" y2="${wMy + 3}" stroke="rgba(196,181,244,0.5)" stroke-width="0.6"/>`);
        parts.push(`<line x1="${wallRightX}" y1="${wMy - 3}" x2="${wallRightX}" y2="${wMy + 3}" stroke="rgba(196,181,244,0.5)" stroke-width="0.6"/>`);
        const wallWm = (wallMmW / 1000).toFixed(2).replace(/\.?0+$/, '');
        parts.push(`<text x="${(wallLeftX + wallRightX) / 2}" y="${wMy + 10}" text-anchor="middle" font-family="'Space Grotesk',sans-serif" font-size="8" fill="rgba(196,181,244,0.9)">${wallWm} m</text>`);

        preview.innerHTML = parts.join('');
      }

      // Mode-tab-byte
      modeTabsContainer.addEventListener('click', (e) => {
        const btn = e.target.closest('.led-mode-btn');
        if (!btn) return;
        mode = btn.dataset.mode;
        modeTabsContainer.querySelectorAll('.led-mode-btn').forEach(b => {
          const active = b === btn;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.classList.toggle('active', active);
          b.style.background = active ? '#c4b5f4' : 'transparent';
          b.style.color = active ? '#0c0a24' : '#f0eeff';
        });
        inputsRoot.querySelectorAll('[data-input]').forEach(el => {
          el.style.display = el.dataset.input === mode ? 'grid' : 'none';
        });
        render();
      });

      // Mount-tabs (ground vs tross)
      mountTabs.addEventListener('click', (e) => {
        const btn = e.target.closest('.led-mount-btn');
        if (!btn) return;
        mount = btn.dataset.mount;
        mountTabs.querySelectorAll('.led-mount-btn').forEach(b => {
          const active = b === btn;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.classList.toggle('active', active);
          b.style.background = active ? '#c4b5f4' : 'transparent';
          b.style.color = active ? '#0c0a24' : '#f0eeff';
        });
        render();
      });

      // Rendera Novastar-info-rutan
      function renderNovastar(proc) {
        if (!proc) return;
        novastarImg.src = proc.image || '';
        novastarImg.alt = proc.name || 'Novastar processor';
        novastarName.textContent = proc.name.replace(' (videoprocessor)', '');
        const mp = (proc.max_pixels / 1e6).toFixed(1).replace(/\.?0+$/, '');
        novastarSpecs.innerHTML = [
          specRow('Loading capacity', `${mp} MP`, true),
          specRow('Max upplösning', `${proc.max_width_px.toLocaleString('sv-SE')} × ${proc.max_height_px.toLocaleString('sv-SE')} px`),
          specRow('Ethernet outputs', `${proc.ethernet_outputs} portar`),
          specRow('OPT outputs', `${proc.opt_outputs} portar`),
          specRow('Layers', proc.layers),
          specRow('Presets', `${proc.presets} st`),
        ].join('');
        novastarDesc.textContent = proc.description || '';
      }

      // View-tab-byte (visual <-> technical)
      viewTabs.addEventListener('click', (e) => {
        const btn = e.target.closest('.led-view-btn');
        if (!btn) return;
        view = btn.dataset.view;
        viewTabs.querySelectorAll('.led-view-btn').forEach(b => {
          const active = b === btn;
          b.setAttribute('aria-selected', active ? 'true' : 'false');
          b.classList.toggle('active', active);
          b.style.background = active ? '#c4b5f4' : 'transparent';
          b.style.color = active ? '#0c0a24' : '#f0eeff';
        });
        visualOpts.style.display = view === 'visual' ? 'flex' : 'none';
        render();
      });

      // Visuella toggles
      optStage.addEventListener('change', () => { showStage = optStage.checked; render(); });
      optAudience.addEventListener('change', () => { showAudience = optAudience.checked; render(); });

      // Input-förändringar
      [panelSel, wM, hM, diag, ratio, cols, rows, inclMontering, inclProcessor].forEach(el => {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
      });

      // Lägg i varukorg
      addBtn.addEventListener('click', () => {
        if (!lastCalc || !window.skCart || typeof window.skCart.add !== 'function') {
          feedbackEl.textContent = 'Kunde inte lägga i varukorgen — ladda om sidan och försök igen.';
          feedbackEl.style.color = '#ff9b9b';
          return;
        }

        const c = lastCalc;
        const panelDesc = `${c.cols}×${c.rows} = ${c.totalPanels} st · ${(c.actualW / 1000).toFixed(2).replace(/\.?0+$/, '')}×${(c.actualH / 1000).toFixed(2).replace(/\.?0+$/, '')} m · ${c.pixelsW}×${c.pixelsH} px`;

        // Panel-rad (qty = antal paneler).
        // Flaggor till varukorgen:
        //   requiresBakgavel: true   → välj automatiskt "Lätt lastbil m. bakgavellift" som leverans
        //   assemblyMinutesTotal: N  → fast monteringstid i minuter, oavsett antal paneler
        //                              (om kunden valt tekniker — annars 0)
        const cartAssembly = c.monteringHours > 0 ? c.monteringHours * 60 : 0;
        window.skCart.add({
          id: c.panel.artno + '__' + c.cols + 'x' + c.rows,
          artno: c.panel.artno,
          name: c.panel.name + ' — ' + panelDesc,
          price: c.panel.price,
          priceNote: '/dygn',
          category: 'LED-vägg',
          image: c.panel.image,
          bulky: true,
          requiresBakgavel: true,
          assemblyMinutesTotal: cartAssembly,
          qty: c.totalPanels,
        });

        // Processor
        if (c.processor) {
          window.skCart.add({
            id: c.processor.artno,
            artno: c.processor.artno,
            name: c.processor.name,
            price: c.processor.price_per_day_excl,
            priceNote: '/dygn',
            category: 'LED-vägg',
            bulky: false,
            qty: 1,
          });
        }

        // Tekniker hanteras automatiskt av varukorgen via assemblyMinutesTotal-flaggan
        // på panel-raden ovan. Ingen separat produktrad behövs.

        // Upphängning: ground support (1500 kr) eller tross (5500 kr) — alltid en separat rad
        if (c.mount === 'ground') {
          window.skCart.add({
            id: TILL.rigg.artno,
            artno: TILL.rigg.artno,
            name: TILL.rigg.name,
            price: TILL.rigg.price_per_day_excl,
            priceNote: '/dygn',
            category: 'LED-vägg',
            bulky: true,
            qty: 1,
          });
        } else {
          window.skCart.add({
            id: TILL.tross.artno,
            artno: TILL.tross.artno,
            name: TILL.tross.name,
            price: TILL.tross.price_per_day_excl,
            priceNote: '/dygn',
            category: 'LED-vägg',
            bulky: true,
            qty: 1,
          });
        }

        // Transport hanteras automatiskt av varukorgen via requiresBakgavel-flaggan på panel-raden
        // — ingen separat produktrad behövs här.

        feedbackEl.textContent = '✓ Lagt i varukorgen — öppna varukorgen för att gå vidare till offert.';
        feedbackEl.style.color = '#8fd694';

        // Dölj feedback efter 5 sek
        setTimeout(() => { feedbackEl.textContent = ''; }, 5000);
      });

      // Initial render
      render();
    })();
  </script>

  <style is:global>
    .led-mode-btn.active,
    .led-view-btn.active,
    .led-mount-btn.active {
      background: #c4b5f4 !important;
      color: #0c0a24 !important;
    }
    @media (max-width: 640px) {
      #led-novastar-grid {
        grid-template-columns: 1fr !important;
      }
    }
    #led-calc details summary::-webkit-details-marker { display: none; }
    #led-calc details[open] summary { color: #c4b5f4; }
    @media (max-width: 640px) {
      #led-result-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</Layout>
