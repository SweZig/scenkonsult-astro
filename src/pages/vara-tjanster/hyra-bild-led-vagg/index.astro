---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import TrossPromoBanner from '../../../components/TrossPromoBanner.astro';
import ledData from '../../../data/led-paneler.json';
import tjansterData from '../../../data/tjanster.json';

const paneler = ledData.paneler;
const paket = ledData.paket || [];
// Leveranspriser från tjanster.json — single source of truth
const LEVERANSER = {
  storbil_slap: { artno: tjansterData.leverans.storbil_slap.artno, name: tjansterData.leverans.storbil_slap.label, pris: tjansterData.leverans.storbil_slap.pris },
  lastbil:      { artno: tjansterData.leverans.lastbil.artno,      name: tjansterData.leverans.lastbil.label,      pris: tjansterData.leverans.lastbil.pris },
};
const faq = ledData.faq;

// Härledda värden för rubriker (synkat med led-paneler.json)
const minPanelPris = Math.min(...paneler.map((p: any) => p.price_per_day_excl));
const minPanelPrisInkl = Math.round(minPanelPris * 1.25);
const riggPris = ledData.tillbehor.rigg.price_per_day_excl;
const trossPris = ledData.tillbehor.tross.price_per_day_excl;
const fmtKr = (n: number) => new Intl.NumberFormat('sv-SE').format(n) + ' kr';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---
<Layout
  title="Hyr LED-vägg Stockholm — bygg din egen storbildsskärm | Scenkonsult"
  description={`Hyr LED-vägg i Stockholm. Bygg din egen konfiguration: indoor P2.604, P1.95 eller outdoor P3.91. Pris från ${minPanelPris} kr per kabinett/dygn. Inkl. processor, ground support & tekniker — Scenkonsult sedan 1986.`}
  schemaExtra={faqSchema}
>
  <ModernHero
    eyebrow="Bild · Storbildsskärm"
    h1="Hyr LED-vägg"
    h1Accent="Stockholm"
    intro="Bygg din egen LED-vägg av modulära kabinett. Tre paneltyper för indoor och outdoor — P1.95 (premium indoor), P2.604 (event indoor) eller P3.91 (utomhus). Konfigurera storlek, se exakt specifikation och pris, och lägg i varukorgen direkt."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "Våra tjänster", href: "/vara-tjanster/" },
      { label: "Bild", href: "/vara-tjanster/hyra-bild/" },
      { label: "LED-vägg" }
    ]}
    chips={[
      { html: `Från <span class="sk-price-excl">${fmtKr(minPanelPris)}</span><span class="sk-price-incl hidden">${fmtKr(minPanelPrisInkl)}</span> / kabinett / dygn` },
      "Indoor & outdoor (IP65)",
      `Ground support ${fmtKr(riggPris)}/dygn`,
      "Leverans i Storstockholm",
    ]}
  />

  <article style="background:#0c0a24;padding:clamp(2.5rem,5vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1180px;margin:0 auto;">

      <!-- KAMPANJ: Färdig LED-vägg på tross (delad komponent TrossPromoBanner) -->
      <section style="margin-bottom:3.5rem;">
        <SectionHeader
          eyebrow="Kampanj"
          h2="Färdig LED-vägg på tross"
          lead="Vill du ha en komplett, driftklar lösning istället för att bygga själv? Hyr vår LED-vägg på trossystem — allt inkluderat."
          marginBottom="1.5rem"
        />
        <TrossPromoBanner />
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- PANEL-JÄMFÖRELSE — visa kabinettstorlek + paneltyper överst     -->
      <!-- Hjälper kunden förstå skillnaden mellan indoor och outdoor      -->
      <!-- innan de väljer paket eller använder konfiguratorn.             -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section style="margin-bottom:3.5rem;">
        <div style="text-align:center;margin-bottom:1.6rem;">
          <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,2.6vw,1.9rem);color:white;margin:0 0 0.55rem;line-height:1.2;">Indoor eller outdoor — vilken panel passar?</h2>
          <p style="color:rgba(255,255,255,0.55);font-size:0.95rem;max-width:720px;margin:0 auto;">Två kabinettstorlekar i tre upplösningar. Inomhus väljer du mellan P1.95 (premium) och P2.604 (event). Utomhus är P3.91 med IP65-skydd standard.</p>
        </div>
        <div style="background:#1e1850;border:1px solid rgba(196,181,244,0.18);border-radius:16px;padding:1.75rem 1rem 1.4rem;">
          <div style="display:flex;align-items:flex-end;justify-content:center;gap:clamp(1rem,3.5vw,2.5rem);min-height:280px;flex-wrap:wrap;">
            <!-- Vänster: 500x500 indoor (framsida) -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
              <img src="/images/bild/pp_bld_led_500x500.webp" alt="LED-kabinett 500x500 mm indoor — framsida med bildmotiv" width="399" height="399" loading="lazy" decoding="async" style="display:block;width:auto;height:160px;object-fit:contain;" />
              <div style="text-align:center;">
                <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.92rem;font-weight:600;">500 × 500 mm</div>
                <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.2rem;">Indoor · P1.95 & P2.604</div>
              </div>
            </div>
            <!-- Mitt: 500x500 baksida — rigging & anslutningar -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
              <img src="/images/bild/pp_bld_led_500x500_back.webp" alt="LED-kabinett 500x500 mm — baksida med hängbeslag och anslutningar" width="403" height="497" loading="lazy" decoding="async" style="display:block;width:auto;height:160px;object-fit:contain;" />
              <div style="text-align:center;">
                <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.92rem;font-weight:600;">500 × 500 mm</div>
                <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.2rem;">Baksida &middot; Hängbeslag &amp; anslutningar</div>
              </div>
            </div>
            <!-- Höger: 500x1000 outdoor framsida -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
              <img src="/images/bild/pp_bld_led_500x1000.webp" alt="LED-kabinett 500x1000 mm — outdoor P3.91 med IP65-skydd" width="223" height="446" loading="lazy" decoding="async" style="display:block;width:auto;height:260px;object-fit:contain;" />
              <div style="text-align:center;">
                <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.92rem;font-weight:600;">500 × 1000 mm</div>
                <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.2rem;">Outdoor · P3.91</div>
              </div>
            </div>
            <!-- Längst höger: 500x1000 outdoor baksida -->
            <div style="display:flex;flex-direction:column;align-items:center;gap:0.6rem;">
              <img src="/images/bild/pp_bld_led_500x1000_back.webp" alt="LED-kabinett 500x1000 mm outdoor — baksida med hängbeslag och anslutningar" width="222" height="466" loading="lazy" decoding="async" style="display:block;width:auto;height:260px;object-fit:contain;" />
              <div style="text-align:center;">
                <div style="color:white;font-family:'Space Grotesk',sans-serif;font-size:0.92rem;font-weight:600;">500 × 1000 mm</div>
                <div style="color:rgba(196,181,244,0.85);font-size:0.72rem;font-family:'Space Grotesk',sans-serif;letter-spacing:0.05em;text-transform:uppercase;margin-top:0.2rem;">Baksida &middot; Hängbeslag &amp; anslutningar</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- FÄRDIGA PAKET — 6 förkonfigurerade LED-väggar med togglar       -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="led-paket" style="margin-bottom:3.5rem;scroll-margin-top:180px;">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 0.6rem;">Snabbval</p>
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,3.5vw,2.2rem);color:white;margin:0 0 0.75rem;line-height:1.2;">Färdiga paket</h2>
        <p style="color:rgba(255,255,255,0.6);font-size:0.95rem;line-height:1.7;margin:0 0 2rem;max-width:720px;">Sex förkonfigurerade LED-vägg-paket — från liten podium-bakgrund (3,75 m²) till festival-huvudscen (34 m²). Välj paneltyp och upphängning per paket — pris uppdateras direkt. <strong style="color:rgba(255,255,255,0.78);">Priserna är exkl. transport och montering, som tillkommer separat.</strong> Vi monterar alltid LED-väggar själva — det säkrar stabil rigg, korrekt kalibrering och bästa bildkvalitet.</p>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem;">
          {paket.map((pkt: any) => {
            const variants = pkt.variants;
            // Default = P26 (alltid tillgänglig för alla paket)
            const defV = variants.P26;
            const aspectW = defV.cols;
            const aspectH = defV.rows;
            const visW = 280;
            const visH = Math.round(visW * aspectH / aspectW);
            return (
              <article
                class="led-paket-card"
                data-paket-id={pkt.id}
                data-paket-artno={pkt.artno_base}
                data-paket-size={pkt.size_m2}
                data-paket-dim={pkt.dimensions_label}
                data-paket-image={pkt.image}
                data-paket-variants={JSON.stringify(variants)}
                style="background:#1e1850;border:1px solid rgba(196,181,244,0.18);border-radius:16px;padding:1.5rem;display:flex;flex-direction:column;gap:1rem;transition:border-color 0.2s,transform 0.15s;"
              >
                {/* Visuell representation: rektangel med personreferens (1,75 m) */}
                <div style="background:#0c0a24;border-radius:10px;padding:1rem;display:flex;align-items:flex-end;justify-content:center;min-height:160px;border:1px solid rgba(255,255,255,0.04);">
                  <svg data-paket-svg viewBox={`0 0 ${visW + 60} ${visH + 30}`} style="width:100%;height:auto;max-height:200px;display:block;" aria-label={`LED-vägg ${pkt.dimensions_label}`}>
                    <rect data-svg-wall x="0" y="10" width={visW} height={visH} fill="#0a0820" stroke="#c4b5f4" stroke-width="1.5" rx="2" />
                    <rect data-svg-grid x="3" y="13" width={visW - 6} height={visH - 6} fill="url(#led-grid-pattern)" opacity="0.3" rx="1" />
                    <text data-svg-w-label x={visW / 2} y={visH + 25} text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="'Space Grotesk',sans-serif" font-size="11" font-weight="600">{pkt.dimensions_label.split(' × ')[0]} m</text>
                    <text data-svg-h-label x={visW + 8} y={(visH + 10) / 2} text-anchor="start" dominant-baseline="middle" fill="rgba(255,255,255,0.55)" font-family="'Space Grotesk',sans-serif" font-size="11" font-weight="600">{pkt.dimensions_label.split(' × ')[1]}</text>
                    <g data-svg-person transform={`translate(${visW + 32}, ${visH + 10 - (1.75 / (defV.rows * 0.5)) * visH})`}>
                      <circle cx="0" cy="6" r="3.5" fill="rgba(196,181,244,0.6)" />
                      <line x1="0" y1="10" x2="0" y2={(1.75 / (defV.rows * 0.5)) * visH - 4} stroke="rgba(196,181,244,0.6)" stroke-width="2" stroke-linecap="round" />
                    </g>
                  </svg>
                  <svg width="0" height="0" style="position:absolute;">
                    <defs>
                      <pattern id="led-grid-pattern" width="6" height="6" patternUnits="userSpaceOnUse">
                        <rect width="6" height="6" fill="#0a0820" />
                        <circle cx="3" cy="3" r="0.7" fill="#c4b5f4" />
                      </pattern>
                    </defs>
                  </svg>
                </div>

                <div style="display:flex;flex-direction:column;gap:0.4rem;">
                  <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0;">{pkt.tagline}</p>
                  <h3 style="font-family:'DM Serif Display',serif;font-size:1.5rem;color:white;margin:0;line-height:1.15;">{pkt.size_m2.toString().replace('.',',')} m²</h3>
                  <p style="color:rgba(255,255,255,0.6);font-family:'Space Grotesk',sans-serif;font-size:0.85rem;margin:0;"><span data-paket-dim-label>{pkt.dimensions_label}</span> · <span data-paket-panels-label>{defV.label}</span></p>
                </div>

                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.35rem;">
                  {pkt.use_cases.map((u: string) => (
                    <li style="color:rgba(255,255,255,0.7);font-size:0.85rem;line-height:1.4;display:flex;gap:0.5rem;align-items:flex-start;">
                      <span style="color:#7dd3a7;flex-shrink:0;">✓</span>
                      <span>{u}</span>
                    </li>
                  ))}
                </ul>

                {/* Toggle: paneltyp */}
                <div>
                  <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 0.4rem;">Paneltyp</p>
                  <div role="radiogroup" aria-label="Paneltyp" style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                    <button type="button" class="led-pill" data-pill-panel="P26" aria-pressed="true" style="flex:1;min-width:90px;background:#c4b5f4;color:#0c0a24;border:1px solid rgba(196,181,244,0.6);border-radius:8px;padding:0.5rem 0.6rem;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;cursor:pointer;transition:all 0.15s;">P2.604</button>
                    <button type="button" class="led-pill" data-pill-panel="P19" aria-pressed="false" disabled={variants.P19 === null} style={`flex:1;min-width:90px;background:transparent;color:${variants.P19 === null ? 'rgba(255,255,255,0.25)' : 'rgba(255,255,255,0.85)'};border:1px solid ${variants.P19 === null ? 'rgba(255,255,255,0.08)' : 'rgba(196,181,244,0.3)'};border-radius:8px;padding:0.5rem 0.6rem;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;cursor:${variants.P19 === null ? 'not-allowed' : 'pointer'};transition:all 0.15s;`} title={variants.P19 === null ? 'P1.95 ger för många pixlar för denna storlek — använd konfiguratorn nedan' : 'Premium indoor — skarpare bild'}>P1.95</button>
                    <button type="button" class="led-pill" data-pill-panel="P39" aria-pressed="false" disabled={variants.P39 === null} style={`flex:1;min-width:90px;background:transparent;color:${variants.P39 === null ? 'rgba(255,255,255,0.25)' : 'rgba(255,255,255,0.85)'};border:1px solid ${variants.P39 === null ? 'rgba(255,255,255,0.08)' : 'rgba(196,181,244,0.3)'};border-radius:8px;padding:0.5rem 0.6rem;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;cursor:${variants.P39 === null ? 'not-allowed' : 'pointer'};transition:all 0.15s;`} title={variants.P39 === null ? 'P3.91 passar inte exakt i denna storlek — använd konfiguratorn nedan' : 'Outdoor — IP65, dagsljus'}>P3.91</button>
                  </div>
                </div>

                {/* Toggle: mount */}
                <div>
                  <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 0.4rem;">Upphängning</p>
                  <div role="radiogroup" aria-label="Upphängning" style="display:flex;gap:0.4rem;">
                    <button type="button" class="led-pill" data-pill-mount="ground" aria-pressed="true" style="flex:1;background:#c4b5f4;color:#0c0a24;border:1px solid rgba(196,181,244,0.6);border-radius:8px;padding:0.5rem 0.6rem;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Ground support</button>
                    <button type="button" class="led-pill" data-pill-mount="tross" aria-pressed="false" style="flex:1;background:transparent;color:rgba(255,255,255,0.85);border:1px solid rgba(196,181,244,0.3);border-radius:8px;padding:0.5rem 0.6rem;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;cursor:pointer;transition:all 0.15s;">Tross</button>
                  </div>
                </div>

                {/* Pris-breakdown — bara HÅRDVARA. Frakt + montering visas inte. */}
                <div style="background:#0c0a24;border-radius:10px;padding:0.85rem 1rem;display:flex;flex-direction:column;gap:0.35rem;">
                  <div style="display:flex;justify-content:space-between;font-size:0.82rem;color:rgba(255,255,255,0.65);">
                    <span><span data-row-panels-label>{defV.totalPanels}</span> paneler</span>
                    <span><span class="sk-price-excl" data-row-panels-excl></span><span class="sk-price-incl hidden" data-row-panels-incl></span></span>
                  </div>
                  <div style="display:flex;justify-content:space-between;font-size:0.82rem;color:rgba(255,255,255,0.65);">
                    <span data-row-mount-label>Ground support</span>
                    <span><span class="sk-price-excl" data-row-mount-excl></span><span class="sk-price-incl hidden" data-row-mount-incl></span></span>
                  </div>
                  <div style="display:flex;justify-content:space-between;font-size:0.82rem;color:rgba(255,255,255,0.65);">
                    <span data-row-proc-label>Videoprocessor</span>
                    <span><span class="sk-price-excl" data-row-proc-excl></span><span class="sk-price-incl hidden" data-row-proc-incl></span></span>
                  </div>
                  <div style="border-top:1px solid rgba(255,255,255,0.1);margin-top:0.35rem;padding-top:0.5rem;display:flex;justify-content:space-between;font-size:0.95rem;color:white;font-weight:700;">
                    <span>Hårdvara</span>
                    <span><span class="sk-price-excl" data-row-total-excl></span><span class="sk-price-incl hidden" data-row-total-incl></span> <span style="color:rgba(255,255,255,0.5);font-weight:400;font-size:0.78rem;">/dygn</span></span>
                  </div>
                  <p data-paket-frakt-note style="color:rgba(255,255,255,0.45);font-size:0.7rem;line-height:1.4;margin:0.4rem 0 0;">+ Montering &amp; demontering 5 100 kr &amp; transport 2 998 kr (Lätt lastbil) tillkommer i kassan</p>
                </div>

                <button
                  type="button"
                  data-led-paket-add
                  style="background:#c4b5f4;color:#0c0a24;border:none;border-radius:10px;padding:0.85rem 1rem;font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:0.5rem;transition:background 0.15s,transform 0.1s;"
                  aria-label={`Lägg ${pkt.tagline} i varukorgen`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                  </svg>
                  <span>Lägg i varukorgen</span>
                </button>
              </article>
            );
          })}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!-- KONFIGURATOR: bygg din egen LED-vägg fritt                      -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <section id="led-bygg-egen">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 0.6rem;">Bygg själv</p>
        <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,3.5vw,2.2rem);color:white;margin:0 0 0.75rem;line-height:1.2;">Konfigurera fritt</h2>
        <p style="color:rgba(255,255,255,0.6);font-size:0.95rem;line-height:1.7;margin:0 0 2rem;max-width:720px;">Välj exakt yta, paneltyp (P1.95 / P2.604 / P3.91), upphängning och tillbehör. Live-pris och visualisering uppdateras direkt.</p>
      </section>

      <!-- Novastar processor info-ruta -->
      <div style="margin-bottom:1.5rem;background:#1e1850;border:1px solid rgba(196,181,244,0.15);border-radius:14px;padding:1.5rem clamp(1rem,3vw,1.75rem);">
        <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin:0 0 1rem;">Videoprocessor — ingår i alla väggar</p>
        <div style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(1.25rem,3vw,2rem);align-items:center;" id="led-novastar-grid">
          <div style="background:#0c0a24;border-radius:10px;padding:1rem;display:flex;align-items:center;justify-content:center;">
            <img id="led-novastar-img" src="/images/bild/pp_bld_led_vx400pro.webp" alt="Novastar VX-processor" width="2083" height="454" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;max-height:70px;object-fit:contain;" />
          </div>
          <div>
