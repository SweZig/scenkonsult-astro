---
import SlutRuta from '../../components/event/SlutRuta.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import Layout from '../../layouts/Layout.astro';
import YouTubeKlick from '../../components/YouTubeKlick.astro';

const filmer = [
  {
    id: "hmIlyWm69nI",
    titel: "Hur det fungerar att hyra hos oss",
    beskrivning: "En snabb genomgång av hela uthyrningsprocessen — från att du kontaktar oss till att utrustningen är levererad och riggad. Perfekt om du aldrig hyrt AV-utrustning förut.",
    tags: ["Kom igång", "Uthyrning"],
    slug: "hur-det-fungerar"
  },
  {
    id: "05nTsqFyjwM",
    titel: "Hur man kopplar in ett hyrt ljudsystem",
    beskrivning: "Steg för steg: hur du kopplar in PA-systemet du hyrt, vad som kopplas var och hur du undviker de vanligaste misstagen. Inga förkunskaper krävs.",
    tags: ["Ljud", "Installation"],
    slug: "koppla-in-ljudsystem"
  },
  {
    id: "nBwdoFUn8uk",
    titel: "Kontakter inom ljud — vad heter vad?",
    beskrivning: "Lär dig känna igen och namnge de vanligaste kontakterna inom ljud — XLR, jack, RCA och mer. Bra att ha koll på innan du hyr PA-utrustning.",
    tags: ["Ljud", "Kontakter", "Teknik"],
    slug: "kontakter-ljud"
  },
  {
    id: "NtYcryqyfsw",
    titel: "Kontakter inom bild — vad heter vad?",
    beskrivning: "De vanligaste kontakterna för projektorer och skärmar — HDMI, DisplayPort, VGA, SDI och mer. Vet du vilken kabel du behöver innan du hyr?",
    tags: ["Bild", "Kontakter", "Projektor", "Skärm"],
    slug: "kontakter-bild"
  },
  {
    id: "R-GMd6uMNVY",
    titel: "LED-teknik — egenskaper och funktioner hos olika LED-skärmar",
    beskrivning: "Vad skiljer olika LED-skärmar åt? Sven går igenom pixelpitch, ljusstyrka, inomhus vs utomhus och vad du bör tänka på när du hyr LED-utrustning.",
    tags: ["Bild", "LED", "Skärm", "Teknik"],
    slug: "led-teknik"
  },
  {
    id: "JkanC_CMmLY",
    titel: "Så kopplar du in Event-ljudpaketet",
    beskrivning: "Sven går steg för steg igenom hur du kopplar in vårt Event-ljudpaket: vad som ansluts var och hur du undviker de vanligaste misstagen. Perfekt för fester, mottagningar och mindre tillställningar.",
    tags: ["Ljud", "Ljudpaket", "Event", "Installation"],
    slug: "ljudpaket-event"
  },
  {
    id: "LSnzgiwDRMA",
    titel: "Så kopplar du in kolumnhögtalarna",
    beskrivning: "Sven visar hur du själv kopplar in våra kolumnhögtalare, vad de olika kontakterna och reglagen gör och hur du kommer igång. Inga förkunskaper krävs.",
    tags: ["Ljud", "Ljudpaket", "Kolumn", "Installation"],
    slug: "ljudpaket-kolumn"
  },
  {
    id: "gpu903eACmo",
    titel: "Så kopplar du in Music & Live-ljudpaketet",
    beskrivning: "Sven visar hur du kopplar in våra Music- och Live-ljudpaket för band och artister, vad de olika kontakterna och reglagen gör och hur du undviker de vanligaste misstagen.",
    tags: ["Ljud", "Ljudpaket", "Music", "Live", "Installation"],
    slug: "ljudpaket-music-live"
  },
  {
    id: "mr-1UM2YbJo",
    titel: "Så kopplar du in Portable-ljudpaketet",
    beskrivning: "Sven visar hur du själv kopplar in vårt Portable-ljudpaket, vad de olika kontakterna och reglagen gör och hur du kommer igång — var du än är. Inga förkunskaper krävs.",
    tags: ["Ljud", "Ljudpaket", "Portable", "Installation"],
    slug: "ljudpaket-portable"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Svens Kunskapsskola — videoguider om AV-teknik",
  "description": "Videoguider om ljud, kontakter och uthyrning av AV-utrustning från Scenkonsult Norden.",
  "itemListElement": filmer.map((f, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "VideoObject",
      "name": f.titel,
      "embedUrl": `https://www.youtube.com/embed/${f.id}`
    }
  }))
};
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'Svens Kunskapsskola' }];
---

<Layout breadcrumbs={pageBreadcrumbs}
  title="Svens Kunskapsskola — Videoguider om AV-teknik | Scenkonsult"
  description="Lär dig koppla in ljud, förstå kontakter och hyra AV-utrustning rätt. Korta, konkreta videoguider från Scenkonsult Nordens intendent Sven."
  schemaExtra={schema}
>

  <SidHuvud
    brod={pageBreadcrumbs}
    eyebrow="Sven Intendenten presenterar"
    h1="Svens"
    h1Accent="Kunskapsskola"
    intro="Korta, konkreta videoguider om ljud-teknik, kontakter och hur du hyr utrustning rätt. Inga förkunskaper krävs — Sven förklarar som om du aldrig sett en XLR-kabel förut."
    meta="”Hade jag fått välja hade jag stått på scen. Nu förklarar jag hur den kopplas in istället.” — Sven"
  />

  <!-- Video-grid -->
  <section style="padding:clamp(1rem,3vw,2rem) clamp(1rem,3vw,2rem) clamp(3rem,6vw,5rem);">
    <div style="max-width:1200px;margin:0 auto;display:flex;flex-direction:column;gap:4rem;">

      {filmer.map((film, i) => (
        <div id={film.slug} style={`display:grid;grid-template-columns:${i % 2 === 0 ? '1.3fr 1fr' : '1fr 1.3fr'};gap:clamp(2rem,5vw,4rem);align-items:center;`} class="film-row">

          <!-- Video (alternerande vänster/höger) -->
          <div style={i % 2 !== 0 ? 'order:2' : ''} class="film-video">
            <div style="border-radius:22px;overflow:hidden;border:1px solid rgba(255,255,255,0.08);background:#000;aspect-ratio:16/9;">
              <YouTubeKlick id={film.id} title={film.titel} />
            </div>
          </div>

          <!-- Text -->
          <div style={i % 2 !== 0 ? 'order:1' : ''} class="film-text">
            <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:1rem;">
              <span style="background:rgba(196,181,244,0.15);color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.72rem;font-weight:700;letter-spacing:0.08em;padding:0.2rem 0.6rem;border-radius:4px;">AVSNITT {String(i + 1).padStart(2,'0')}</span>
            </div>
            <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,2.5vw,2rem);color:white;margin:0 0 1rem;line-height:1.2;">{film.titel}</h2>
            <p style="color:rgba(255,255,255,0.55);font-size:clamp(0.9rem,1.5vw,1rem);line-height:1.75;margin:0 0 1.5rem;">{film.beskrivning}</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
              {film.tags.map(t => (
                <span style="background:rgba(196,181,244,0.1);color:#c4b5f4;font-size:0.7rem;font-weight:600;padding:0.2rem 0.6rem;border-radius:9999px;">{t}</span>
              ))}
            </div>
          </div>
        </div>
      ))}

    </div>
  </section>

  <SlutRuta rubrik="Nu vet du hur det fungerar — dags att boka" text="Sven och teamet hjälper dig välja rätt utrustning och svarar på frågor — utan krångel." />
</Layout>

<style>
@media (max-width: 768px) {
  .film-row {
    grid-template-columns: 1fr !important;
  }
  .film-video { order: 1 !important; }
  .film-text  { order: 2 !important; }
}
</style>
