<script define:vars={{ ORDER_CATALOG: orderCatalog }}>
// Exponera på window direkt — gör ORDER_CATALOG tillgänglig globalt
// oberoende av IIFE-scope och async timing
window._SK_ORDER_CATALOG = ORDER_CATALOG;
const STATUS = {
  new:         { icon: '📬', label: 'Förfrågan mottagen',  desc: 'Vi har tagit emot din förfrågan och återkommer inom kort.',                   cls: 's-open'      },
  open:        { icon: '📬', label: 'Förfrågan mottagen',  desc: 'Vi har tagit emot din förfrågan och återkommer inom kort.',                   cls: 's-open'      },
  proposal:    { icon: '📤', label: 'Offert skickad',      desc: 'Vi har skickat ett offert — se produkter och priser nedan.',                  cls: 's-proposal'  },
  waiting:     { icon: '⏳', label: 'Offert klar',         desc: 'Gå igenom uppgifterna nedan. Om allt stämmer kan ni bekräfta ordern direkt med knappen här under — annars hör gärna av er via meddelanderutan.', cls: 's-waiting'   },
  confirmed:   { icon: '✅', label: 'Order bekräftad',     desc: 'Ordern är bekräftad av Scenkonsult Norden.',                                  cls: 's-confirmed' },
  fakturerad:  { icon: '🧾', label: 'Faktura skickad',     desc: 'En faktura har skickats till din e-post. Välkommen på eventet!',              cls: 's-fakturerad'},
  completed:   { icon: '🏁', label: 'Avslutad — tack!',    desc: 'Eventet är genomfört och betalningen är registrerad. Tack för förtroendet!',  cls: 's-completed' },
  betald:      { icon: '💚', label: 'Betald — klart!',     desc: 'Tack! Betalning mottagen. Vi ses på eventet!',                               cls: 's-completed' },
  cancelled:   { icon: '❌', label: 'Avbruten',             desc: 'Den här ordern är avbruten. Kontakta oss om du har frågor.',                  cls: 's-cancelled' },
};

const fmt     = n  => typeof n === 'number' ? n.toLocaleString('sv-SE') : '–';
const fmtDate = d  => d ? new Date(d).toLocaleDateString('sv-SE', { year:'numeric', month:'long', day:'numeric' }) : null;
const fmtTime = d  => d ? new Date(d).toLocaleString('sv-SE', { dateStyle:'short', timeStyle:'short' }) : '';

// Produktbild-karta: id → sökväg

// ORDER_CATALOG exponeras via window._SK_ORDER_CATALOG (define:vars + window assignment)
// Indexeras på artno (SK-SCN-0002) primärt, med slug-alias för bakåtkompatibilitet
// Kända legacy-alias för gamla ordrar
const _ID_ALIASES = {
  // Gamla artno-som-slug från before migreringen
  'SK-SCN-ACC-0001': 'SK-SCN-ACC-0001',  // redan artno, men alias för säkerhets skull
  'montering-tim':   'montering',
};
function _lookupOrderProduct(item) {
  const cat = window._SK_ORDER_CATALOG || {};
  const rawId = item.id || '';
  // 1. Direktmatchning (artno eller slug-alias)
  if (cat[rawId]) return cat[rawId];
  // 2. Legacy-alias
  const aliasId = _ID_ALIASES[rawId];
  if (aliasId && cat[aliasId]) return cat[aliasId];
  // 3. Gamla prefix (bakåtkompatibilitet)
  const stripped = rawId.replace(/^(scen-|dj-utr-|ljud-|ljus-|acc-)/,'');
  if (cat[stripped]) return cat[stripped];
  // 4. Namnbaserad sökning som sista fallback
  if (item.name) {
    const nameNorm = item.name.toLowerCase()
      .replace(/[åä]/g,'a').replace(/ö/g,'o')
      .replace(/[^a-z0-9]+/g,'-').replace(/-+$/,'');
    const nameMap = window._SK_ORDER_CATALOG_NAME_MAP;
    if (nameMap && nameMap[nameNorm]) return cat[nameMap[nameNorm]] || {};
  }
  return {};
}
// Bygg namnkarta en gång
window._SK_ORDER_CATALOG_NAME_MAP = null;
function _ensureNameMap() {
  if (window._SK_ORDER_CATALOG_NAME_MAP) return;
  const m = {};
  for (const [key, entry] of Object.entries(window._SK_ORDER_CATALOG || {})) {
    if (entry.name) {
      const norm = entry.name.toLowerCase()
        .replace(/[åä]/g,'a').replace(/ö/g,'o')
        .replace(/[^a-z0-9]+/g,'-').replace(/-+$/,'');
      if (!m[norm]) m[norm] = key;
    }
  }
  window._SK_ORDER_CATALOG_NAME_MAP = m;
}

function _getOrderType(item) {
  // Katalogen är sanningskällan — item.type är bara hint för framtida ordrar
  const info = _lookupOrderProduct(item);
  return info.type || item.type || 'product';
}

function _getOrderImg(item) {
  // Katalogen är sanningskällan för bild
  const info = _lookupOrderProduct(item);
  return info.image || item.image || null;
}

function openOrderProductModal(item) {
  if (!window.skModalOpen) return;
  const info   = _lookupOrderProduct(item);
  const imgSrc = _getOrderImg(item);

  // ── Bygg info-rader för alla kategorier ──
  const rows = [];
  const specRows = [];

  // Scen-specifika fält
  if (info.size)       specRows.push(`<span style="color:rgba(255,255,255,.55)">📐 Yta:</span> <strong style="color:#fff">${info.size}</strong>`);
  if (info.dimensions) specRows.push(`<span style="color:rgba(255,255,255,.55)">📏 Mått:</span> <strong style="color:#fff">${info.dimensions}</strong>`);
  if (info.capacity)   specRows.push(`<span style="color:rgba(255,255,255,.55)">👥 Plats för:</span> <strong style="color:#fff">${info.capacity}</strong>`);

  // Ljud/ljus/dj-fält (persons är "20–80 pers.")
  if (info.persons && !info.capacity) {
    specRows.push(`<span style="color:rgba(255,255,255,.55)">👥 Räcker för:</span> <strong style="color:#fff">${info.persons}</strong>`);
  }

  // Montering (ljud/ljus-paket)
  if (info.monteringMin) {
    specRows.push(`<span style="color:rgba(255,255,255,.55)">⏱️ Montering:</span> <strong style="color:#fff">~${info.monteringMin} min</strong>`);
  }

  // Transport (scen)
  if (info.transport === 'krävs') {
    specRows.push(`<span style="color:rgba(255,255,255,.55)">🚚 Transport:</span> <strong style="color:#fbbf24">krävs (tillkommer)</strong>`);
  } else if (info.transport === 'tillägg') {
    specRows.push(`<span style="color:rgba(255,255,255,.55)">🚚 Transport:</span> <strong style="color:#fff">tillkommer som tillägg</strong>`);
  } else if (info.bulky === true) {
    // Bulky-flagga för ljud/ljus utan explicit transport-fält
    specRows.push(`<span style="color:rgba(255,255,255,.55)">📦 Skrymmande:</span> <strong style="color:#fff">större bil krävs</strong>`);
  }

  if (specRows.length) rows.push({ label: 'Specifikation', rows: specRows });

  // Scen-userCase: full bredd
  if (info.useCase) {
    rows.push({ label: 'Bra för', rows: [info.useCase], fullWidth: true });
  }

  // Volymrabatt (ljus-effekter)
  if (Array.isArray(info.volumePricing) && info.volumePricing.length > 1) {
    const vpRows = info.volumePricing.map(v =>
      `<span style="color:rgba(255,255,255,.55)">Från ${v.minQty} st:</span> <strong style="color:#c4b5f4">${v.unitPrice} kr/st</strong>`
    );
    rows.push({ label: 'Volymrabatt', rows: vpRows });
  }

  // Manual-länk om finns (för kund-referens)
  if (info.manualUrl) {
    rows.push({
      label: 'Produktmanual',
      rows: [`<a href="${info.manualUrl}" target="_blank" rel="noopener" style="color:#c4b5f4;text-decoration:underline;font-size:11.5px">📄 Öppna manual (PDF) ↗</a>`],
      fullWidth: true,
    });
  }

  // Includes/specs → specs-lista med ▸ (modalens befintliga rendering via desc-prop)
  const itemSpecs = info.specs || [];
  const includesStr = itemSpecs.join('||');

  window.skModalOpen({
    name:      item.name,
    artno:     item.artno || info.artno || '',
    descText:  info.desc || '',         // fri beskrivning som paragraph
    desc:      includesStr,             // specs-lista (||-separerat)
    rows:      rows,
    price:     item.price,
    priceNote: info.priceNote || '/dygn',
    category:  item.category || info.catName || '',
    cartId:    '',
    images:    imgSrc ? [imgSrc] : [],
    videos:    [],
    persons:   info.tagline || '',
    hideCart:  true,
  });
}
window.openOrderProductModal = openOrderProductModal;

let cartId    = null;
let cartToken = null;
let messages  = [];

function show(id) {
  ['stateLoading','stateError','stateOrder'].forEach(s => {
    document.getElementById(s).classList.toggle('active', s === id);
  });
}

async function loadOrder() {
  const params = new URLSearchParams(location.search);
  cartId    = params.get('cart');
  cartToken = params.get('token');

  if (!cartId || !cartToken) { show('stateError'); return; }

  try {
    const res  = await fetch(`/.netlify/functions/cart-get?id=${cartId}&token=${cartToken}`);
    const data = await res.json();
    if (!res.ok) { show('stateError'); return; }
    renderOrder(data.cart);
    messages = data.messages || [];
    renderMessages();
    show('stateOrder');
    // Djuplänk från bekräftelsemail: scrolla till fakturasektionen
    if (location.hash === '#invoiceSection') {
      setTimeout(() => {
        const sec = document.getElementById('invoiceSection');
        if (sec && sec.style.display !== 'none') {
          sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          const editBtn = document.getElementById('invEditBtn');
          if (editBtn) editBtn.click();
        }
      }, 300);
    }
  } catch {
    show('stateError');
  }
}

function renderOrder(c) {
  // Header
  document.getElementById('orderId').textContent    = c.id;
  document.getElementById('orderTitle').textContent = `Hej ${c.customer_name?.split(' ')[0] || 'där'}!`;

  // B2B-badge: visa företagsnamn tydligt om det finns
  const companyBadge = document.getElementById('orderCompanyBadge');
  if (companyBadge) {
    if (c.customer_company) {
      const orgnrPart = c.customer_orgnr ? ` <span class="ocb-orgnr">· Org.nr ${c.customer_orgnr}</span>` : '';
      companyBadge.innerHTML = `<span class="ocb-label">🏢 Offert till företag</span><span class="ocb-name">${c.customer_company}</span>${orgnrPart}`;
      companyBadge.style.display = '';
    } else {
      companyBadge.style.display = 'none';
    }
  }

  // B2B fakturauppgifter-sektion
  renderInvoiceSection(c);

  // Visa eventinfo i subtitle (företagsnamn flyttat till badge)
  const subtitleParts = [];
  if (c.event_date) subtitleParts.push(`Order för event ${fmtDate(c.event_date)}${c.event_location ? ' · ' + c.event_location : ''}`);
  else subtitleParts.push('Här kan du följa status på din order och skicka meddelanden till oss.');
  document.getElementById('orderSubtitle').textContent = subtitleParts.join(' · ');

  // Status
  const s = STATUS[c.status] || STATUS.open;
  const banner = document.getElementById('statusBanner');
  banner.className = `status-banner ${s.cls}`;
  document.getElementById('statusIcon').textContent  = s.icon;
  document.getElementById('statusLabel').textContent = s.label;
  document.getElementById('statusDesc').textContent  = s.desc;

  // Status-specifikt CTA-block
  const ctaEl = document.getElementById('statusCta');
  ctaEl.innerHTML = '';
  ctaEl.style.display = 'none';
  banner.style.borderRadius = '';

  if (c.confirmed_at) {
    // Kund har redan bekräftat digitalt
    banner.style.borderRadius = '12px 12px 0 0';
    ctaEl.style.display = '';
    ctaEl.innerHTML = `
      <div style="margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:10px">
        <span style="font-size:1.4rem">✅</span>
        <div>
          <div style="color:rgba(255,255,255,0.9);font-size:0.9rem;font-weight:600">Digitalt bekräftad</div>
          <div style="color:rgba(255,255,255,0.5);font-size:0.8rem">Du godkände denna order ${fmtTime(c.confirmed_at)}</div>
        </div>
      </div>`;
  } else if (c.status === 'confirmed' || c.status === 'waiting') {
    // Offert klar — kund kan bekräfta digitalt
    banner.style.borderRadius = '12px 12px 0 0';
    ctaEl.style.display = '';
    ctaEl.innerHTML = renderConfirmBox(c);
  } else if (c.status === 'proposal' || c.status === 'open' || c.status === 'new' /* 'proposal'/'open' = legacy-alias pre-2026-04-05, nu alltid 'new' */) {
    // Vi håller på att se över förfrågan
    banner.style.borderRadius = '12px 12px 0 0';
    ctaEl.style.display = '';
    ctaEl.innerHTML = `
      <div style="margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.08);">
        <p style="color:rgba(255,255,255,0.6);font-size:0.9rem;margin:0;">Vi ser över din förfrågan och återkommer med en offert. Frågor? Ring oss på
          <a href="tel:0724481000" style="color:#c4b5f4;">072-448 10 00</a>.
        </p>
      </div>`;
  }

  // Sätt Cart-objekt globalt för bekräftelseflödet
  window._currentCart = c;

  // Event info visas nu inne i productTableWrap (order-times-row)

  // Separera produkter och tjänster via katalogen (sanningskällan)
  const SVC_CATS_ORDER = ['Tjänster', 'Tillägg'];
  const isService = i => _getOrderType(i) === 'service' || SVC_CATS_ORDER.includes(i.category);
  const items     = c.items || [];
  const realItems = items.filter(i => !i._note);
  const noteItem  = items.find(i => i._note);
  const prodItems = realItems.filter(i => !isService(i) && !(i.id && i.id.startsWith('fakturaavgift')));
  const svcItems  = realItems.filter(i => isService(i) && !(i.id && i.id.startsWith('fakturaavgift')));
  const feeItem   = realItems.find(i => i.id && i.id.startsWith('fakturaavgift'));

  const prodTotal = prodItems.reduce((s, i) => s + ((i.price||0) * (i.qty||i.quantity||1)), 0);
  const svcTotal  = svcItems.reduce((s, i) => s + ((i.price||0) * (i.qty||i.quantity||1)), 0);
  const feeTotal  = feeItem ? (feeItem.price||0) * (feeItem.qty||1) : 0;
  const grandExcl = prodTotal + svcTotal + feeTotal;
  const moms      = Math.round(grandExcl * 0.25);
  const grandIncl = grandExcl + moms;

  // ── Bygg checkout-inspirerade rader ──
  const SVC_ICONS = {
    lev_standard:   { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>', bg: '#3730a3' },
    lev_skrymmande: { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 4v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/><rect x="19" y="5" width="4" height="6" rx="0.5" fill="rgba(255,255,255,0.3)"/></svg>', bg: '#4338ca' },
    lev_lastbil:    { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h16v13H1z"/><path d="M17 8h4l2 3v6h-6V8z"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg>', bg: '#1d4ed8' },
    montering:      { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>', bg: '#5b21b6' },
    teknik:         { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a6 6 0 0 1 12 0v2"/></svg>', bg: '#6d28d9' },
    faktura:        { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>', bg: '#4c1d95' },
    dj:             { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>', bg: '#991b1b' },
    dj_utr:         { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M7 21h10M12 17v4"/><circle cx="8" cy="10" r="2"/><circle cx="16" cy="10" r="2"/></svg>', bg: '#b91c1c' },
    media:          { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>', bg: '#c2410c' },
    default:        { svg: '<svg width="36" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>', bg: '#3730a3' },
  };

  // Produktkategori → emoji (för prod-rader utan bild)
  const PROD_CAT_EMOJI = {
    'SK-SCN':     { e:'🎭', bg:'#4c1d95' },
    'SK-LJD-EL':  { e:'🔌', bg:'#1e3a8a' },
    'SK-LJD-MIK': { e:'🎤', bg:'#1e40af' },
    'SK-LJD-MIX': { e:'🎚️', bg:'#1e40af' },
    'SK-LJD':     { e:'🔊', bg:'#1d4ed8' },
    'SK-LJS-DMX': { e:'🕹️', bg:'#78350f' },
    'SK-LJS-ROK': { e:'💨', bg:'#92400e' },
    'SK-LJS-EFF': { e:'✨', bg:'#78350f' },
    'SK-LJS-STV': { e:'🏗️', bg:'#78350f' },
    'SK-LJS':     { e:'💡', bg:'#92400e' },
    'SK-BLD':     { e:'🖥️', bg:'#064e3b' },
    'SK-DJ':      { e:'🎧', bg:'#7f1d1d' },
  };

  function _prodEmoji(item) {
    const artno = item.artno || item.id || '';
    for (const [pfx, ico] of Object.entries(PROD_CAT_EMOJI)) {
      if (artno.startsWith(pfx)) return ico;
    }
    const cat = (item.category||'').toLowerCase();
    if (cat.includes('scen'))    return PROD_CAT_EMOJI['SK-SCN'];
    if (cat.includes('ljud'))    return PROD_CAT_EMOJI['SK-LJD'];
    if (cat.includes('ljus'))    return PROD_CAT_EMOJI['SK-LJS'];
    if (cat.includes('bild'))    return PROD_CAT_EMOJI['SK-BLD'];
    if (cat.includes('dj'))      return PROD_CAT_EMOJI['SK-DJ'];
    return { e:'📦', bg:'#1e293b' };
  }

  const svcIcon = (id, name) => {
    const s = ((id||'')+(name||'')).toLowerCase();
    if (s.includes('lastbil') || s.includes('bakgavel')) return SVC_ICONS.lev_lastbil;
    if (s.includes('skrymmande') || s.includes('slap'))  return SVC_ICONS.lev_skrymmande;
    if (s.includes('lev') || s.includes('transport'))    return SVC_ICONS.lev_standard;
    if (s.includes('monter') || s.includes('rigg'))      return SVC_ICONS.montering;
    if (s.includes('teknik') || s.includes('engineer'))  return SVC_ICONS.teknik;
    if (s.includes('faktura'))                           return SVC_ICONS.faktura;
    if (s.includes('media') || s.includes('rörlig'))     return SVC_ICONS.media;
    if (s.includes('dj') && (s.includes('bord') || s.includes('controller') || s.includes('system'))) return SVC_ICONS.dj_utr;
    if (s.includes('dj'))                                return SVC_ICONS.dj;
    return SVC_ICONS.default;
  };

  // Lagra items för popup-referens
  window._orderItems = window._orderItems || {};

  const mkProdRow = (i, globalIdx) => {
    const qty    = i.qty || i.quantity || 1;
    const total  = (i.price||0) * qty;
    const imgSrc = _getOrderImg(i);
    const info   = _lookupOrderProduct(i);
    // Visa popup bara om vi har faktiskt produktinnehåll (bild eller specs)
    const hasInfo = !!(info.desc || info.catName || imgSrc);
    // Store item for onclick reference
    const key = 'p' + globalIdx;
    window._orderItems[key] = i;
    const imgEl = imgSrc
      ? `<div class="row-img${hasInfo?' row-img-clickable':''}"><img src="${imgSrc}" alt="" loading="lazy" onerror="this.style.display='none'"></div>`
      : (() => { const pe=_prodEmoji(i); return `<div class="row-img" style="background:${pe.bg};font-size:1.5rem;display:flex;align-items:center;justify-content:center">${pe.e}</div>`; })();
    const infoHint = hasInfo ? ` <span class="row-info-hint">ℹ</span>` : '';
    const clickProps = hasInfo ? `onclick="openOrderProductModal(window._orderItems['${key}'])" title="Klicka för mer info"` : '';
    return `<div class="order-cart-row${hasInfo?' order-cart-row-clickable':''}" ${clickProps}>
      ${imgEl}
      <div><div class="row-name">${i.name||'–'}${infoHint}</div>${info.artno ? `<div class="row-cat">${info.artno}</div>` : ''}</div>
      <div class="row-qty">${qty > 1 ? qty + ' st' : '1 st'}</div>
      <div class="row-price">${fmt(i.price)} kr</div>
      <div class="row-total">${fmt(total)} kr</div>
    </div>`;
  };

  const mkSvcRow = i => {
    const qty    = i.qty || i.quantity || 1;
    const total  = (i.price||0) * qty;
    const iconDef = svcIcon(i.id);
    return `<div class="order-cart-row svc-row">
      <div class="row-img" style="background:${iconDef.bg};padding:10px">${iconDef.svg}</div>
      <div><div class="row-name">${i.name||'–'}</div><div class="row-cat">Tilläggstjänst</div></div>
      <div class="row-qty">${qty > 1 ? qty + ' st' : '1 st'}</div>
      <div class="row-price">${fmt(i.price)} kr</div>
      <div class="row-total">${fmt(total)} kr</div>
    </div>`;
  };

  let html = '';
  window._orderItems = {};
  let _rowIdx = 0;

  if (prodItems.length > 0) {
    html += `<div class="order-sec-label">Utrustning</div>`;
    html += prodItems.map(i => mkProdRow(i, _rowIdx++)).join('');
  }
  if (svcItems.length > 0) {
    html += `<div class="order-sec-label">Tilläggstjänster</div>`;
    html += svcItems.map(mkSvcRow).join('');
  }
  if (feeItem) {
    html += `<div class="order-sec-label">Bokningsavgift</div>`;
    html += mkSvcRow(feeItem);
  }
  if (noteItem) {
    html += `<div style="padding:0.6rem 1.25rem;font-size:0.8rem;color:rgba(255,255,255,0.60);font-style:italic;border-top:1px dashed rgba(255,255,255,0.06)">📝 ${noteItem.name}</div>`;
  }

  // Tidpunkter
  if (c.event_date) {
    const dlTime  = c.delivery_time || '13:00';
    const rtTime  = c.return_time   || '11:00';
    const retDate = c.return_date   || c.event_date;
    html += `<div class="order-times">
      <div class="order-time-item">
        <span class="order-time-label">📅 Utlämning</span>
        <span class="order-time-value">${fmtDate(c.event_date)} kl ${dlTime}</span>
      </div>
      <div class="order-time-item">
        <span class="order-time-label">📅 Återlämning</span>
        <span class="order-time-value">${fmtDate(retDate)} kl ${rtTime}</span>
      </div>
      ${c.event_location ? `<div class="order-time-item"><span class="order-time-label">📍 Eventplats</span><span class="order-time-value">${c.event_location}</span></div>` : ''}
    </div>`;
  }

  // ── Leverans- / hämtningsblock (tydlig adress + beskrivning) ──
  const dm = c.delivery_mode;
  if (dm === 'self_pickup') {
    html += `<div class="order-delivery order-delivery-pickup">
      <div class="odel-icon">📦</div>
      <div class="odel-body">
        <div class="odel-title">Självhämtning</div>
        <div class="odel-text">Ni hämtar och lämnar tillbaka utrustningen själva hos oss.</div>
        <div class="odel-addr">
          <span class="odel-addr-label">Adress för hämtning &amp; återlämning</span>
          <a class="odel-addr-link" href="https://maps.google.com/?q=Grimstagatan+164,+162+58+V%C3%A4llingby" target="_blank" rel="noopener">
            <strong>Grimstagatan 164, 162 58 Vällingby</strong>
            <span class="odel-addr-arrow">↗ Visa på karta</span>
          </a>
        </div>
        <div class="odel-note">Ring 072-448 10 00 strax innan ni kommer så har vi allt klart.</div>
      </div>
    </div>`;
  } else if (dm === 'delivery') {
    html += `<div class="order-delivery order-delivery-truck">
      <div class="odel-icon">🚚</div>
      <div class="odel-body">
        <div class="odel-title">Vi levererar &amp; hämtar tillbaka</div>
        <div class="odel-text">Vår personal kör ut utrustningen till er på utlämningstiden och hämtar den vid återlämningen.</div>
        <div class="odel-addr">
          <span class="odel-addr-label">Leveransadress</span>
          ${c.event_location
            ? `<a class="odel-addr-link" href="https://maps.google.com/?q=${encodeURIComponent(c.event_location)}" target="_blank" rel="noopener">
                 <strong>${c.event_location}</strong>
                 <span class="odel-addr-arrow">↗ Visa på karta</span>
               </a>`
            : `<strong style="color:#fbbf24">Adress ej angiven — vänligen meddela oss i chatten nedan.</strong>`}
        </div>
        <div class="odel-note">Vi ringer 30 min innan ankomst. Leveranskostnaden specificeras i offerten ovan.</div>
      </div>
    </div>`;
  } else if (c.event_date) {
    // Leveranssätt ännu inte valt — låt kunden välja direkt
    html += `<div class="order-delivery order-delivery-tbd">
      <div class="odel-icon">🚚</div>
      <div class="odel-body">
        <div class="odel-title">Hur vill ni ha utrustningen?</div>
        <div class="odel-text">Välj om ni hämtar själva hos oss eller om vi ska köra ut utrustningen. Ni kan ändra er genom att höra av er i chatten.</div>
        <div class="odel-choices">
          <button type="button" class="odel-choice" onclick="window.setDeliveryMode('self_pickup')">
            <span class="odel-choice-ic">📦</span>
            <span class="odel-choice-tx"><strong>Vi hämtar själva</strong><span>Hos er på Grimstagatan 164, Vällingby</span></span>
          </button>
          <button type="button" class="odel-choice" onclick="window.setDeliveryMode('delivery')">
            <span class="odel-choice-ic">🚚</span>
            <span class="odel-choice-tx"><strong>Ni levererar till oss</strong><span>Leveranskostnad specificeras i offerten</span></span>
          </button>
        </div>
        <div id="delModeMsg" style="margin-top:0.6rem;font-size:0.82rem"></div>
      </div>
    </div>`;
  }

  document.getElementById('prodTableWrap').innerHTML = html;

  // Totals box
  const totalsEl = document.getElementById('orderTotals');
  if (totalsEl && grandExcl > 0) {
    document.getElementById('totalsExcl').innerHTML  = `<span>Exkl. moms</span><span>${fmt(grandExcl)} kr</span>`;
    document.getElementById('totalsMoms').innerHTML  = `<span>Moms 25%</span><span>${fmt(moms)} kr</span>`;
    document.getElementById('totalsGrand').innerHTML = `<span>Totalt inkl. moms</span><span>${fmt(grandIncl)} kr</span>`;
    const noteEl = document.getElementById('totalsNote');
    if (noteEl) noteEl.style.display = svcItems.length > 0 ? '' : 'none';

    // Bokningsavgift-notis: visa bara om korgen INTE redan innehåller en fakturaavgift-rad
    const feeNoteEl = document.getElementById('totalsFeeNote');
    if (feeNoteEl) feeNoteEl.style.display = feeItem ? 'none' : '';

    totalsEl.style.display = '';
  }
}

function renderMessages() {
  const container = document.getElementById('chatMessages');
  const unread    = messages.filter(m => m.sender === 'admin' && !m.read_at);

  // Unread badge
  const badge = document.getElementById('unreadBadge');
  if (unread.length > 0) {
    badge.style.display = 'inline';
    badge.textContent   = `${unread.length} ny${unread.length > 1 ? 'a' : 't'}`;
  } else {
    badge.style.display = 'none';
  }

  if (messages.length === 0) {
    container.innerHTML = '<div class="chat-empty">Inga meddelanden ännu. Hör gärna av dig om du har frågor!</div>';
    return;
  }

  container.innerHTML = messages.map(m => `
    <div class="msg-wrap ${m.sender}">
      <div class="msg-sender-label">${m.sender === 'admin' ? '🎭 Scenkonsult Norden' : '👤 Du'}</div>
      <div class="msg-bubble">${m.body.replace(/\n/g,'<br>').replace(/\[([^\]]+)\]\(([^)]+)\)/g,'<a href="$2" style="color:#c4b5f4">$1</a>')}</div>
      <div class="msg-meta">${fmtTime(m.created_at)}</div>
    </div>`).join('');

  // Scroll to bottom
  setTimeout(() => container.scrollTop = container.scrollHeight, 50);
}

function renderConfirmBox(c) {
  const total = (c.items||[]).filter(i=>!i._note).reduce((s,i)=>s+((i.price||0)*(i.qty||1)),0);
  // Leveranssätt-rad i sammanfattningen
  const dmLine = (() => {
    if (c.delivery_mode === 'self_pickup') {
      return `<br>Hämtas av er på <strong style="color:#fff">Grimstagatan 164, Vällingby</strong>`;
    } else if (c.delivery_mode === 'delivery') {
      return c.event_location
        ? `<br>Levereras av oss till <strong style="color:#fff">${c.event_location}</strong>`
        : `<br><strong style="color:#fbbf24">Leverans — adress meddelas i chatten</strong>`;
    }
    return '';
  })();
  return `
    <div style="margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.08)">
      <div style="color:rgba(255,255,255,0.9);font-size:0.95rem;font-weight:600;margin-bottom:0.5rem">
        Bekräfta din order
      </div>
      <p style="color:rgba(255,255,255,0.6);font-size:0.83rem;line-height:1.55;margin:0 0 0.85rem">Granska uppgifterna ovan. När allt ser rätt ut — bocka i hyresvillkoren och tryck på knappen nedan så registreras ordern direkt hos oss.</p>
      <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem;margin-bottom:1rem;font-size:0.85rem;color:rgba(255,255,255,0.7);line-height:1.6">
        ${(() => {
          const _prod = (c.items||[]).filter(i => !i._note && !['Tjänster','Tillägg'].includes(i.category) && !(i.id&&i.id.startsWith('fakturaavgift')));
          const _svc  = (c.items||[]).filter(i => !i._note && ['Tjänster','Tillägg'].includes(i.category) && !(i.id&&i.id.startsWith('fakturaavgift')));
          const parts = [];
          if (_prod.length) parts.push(_prod.length + ' produkt' + (_prod.length>1?'er':''));
          if (_svc.length)  parts.push(_svc.length + ' tjänst' + (_svc.length>1?'er':''));
          const dlTime = c.delivery_time || '13:00';
          const rtTime = c.return_time   || '11:00';
          const retDate = c.return_date  || c.event_date;
          const dateStr = c.event_date ? `${fmtDate(c.event_date)} kl ${dlTime}` : null;
          const retStr  = retDate ? `${fmtDate(retDate)} kl ${rtTime}` : null;
          return `Ordern avser <strong style="color:#fff">${parts.join(' och ') || 'produkter'}</strong>`
            + (c.event_location ? ` för event på <strong style="color:#fff">${c.event_location}</strong>` : '')
            + (dateStr ? `.<br>Utlämning <strong style="color:#fff">${dateStr}</strong>` : '')
            + (retStr  ? ` · Återlämning <strong style="color:#fff">${retStr}</strong>` : '')
            + dmLine
            + `.<br>Totalt <strong style="color:#c4b5f4">${Math.round(total*1.25).toLocaleString('sv-SE')} kr inkl. moms</strong>.`;
        })()}
      </div>
      <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;margin-bottom:1rem">
        <input type="checkbox" id="confirm-tos" onchange="document.getElementById('confirm-btn').disabled=!this.checked"
          style="margin-top:2px;accent-color:#c4b5f4;width:16px;height:16px;flex-shrink:0">
        <span style="color:rgba(255,255,255,0.7);font-size:0.85rem;line-height:1.5">
          Jag har läst och godkänner
          <a href="/hyresvillkor/" target="_blank" style="color:#c4b5f4">Scenkonsult Nordens allmänna hyresvillkor §1–§15</a>
          och bekräftar denna order.
        </span>
      </label>
      <button id="confirm-btn" disabled onclick="confirmOrder()"
        style="width:100%;padding:0.875rem;background:#c4b5f4;color:#0c0a24;border:none;border-radius:10px;font-size:0.95rem;font-weight:700;cursor:pointer;transition:opacity .2s;font-family:inherit">
        ✅ Bekräfta order
      </button>
      <p style="color:rgba(255,255,255,0.60);font-size:0.75rem;margin-top:0.75rem;text-align:center">
        Din bekräftelse loggas med tidsstämpel och IP-adress som bindande avtal.
      </p>
    </div>`;
}

async function confirmOrder() {
  const btn = document.getElementById('confirm-btn');
  if (!btn || btn.disabled) return;
  btn.disabled = true;
  btn.textContent = '⏳ Bekräftar…';

  try {
    const c = window._currentCart;
    if (!c) throw new Error('Order ej laddad — ladda om sidan och försök igen.');
    if (!cartToken) throw new Error('Token saknas — öppna länken från mailet igen.');

    const total = (c.items||[]).filter(i=>!i._note).reduce((s,i)=>s+((i.price||0)*(i.qty||1)),0);
    const confirmationText = `Order ${c.id} bekräftad av kund. Hyresvillkor §1–§15 godkända. Totalt ${total} kr exkl. moms.`;

    const res = await fetch('/.netlify/functions/cart-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        token:             cartToken,
        cart_id:           cartId,
        action:            'customer_confirm',
        confirmation_text: confirmationText,
      })
    });
    const data = await res.json();
    if (res.ok && !data.error) {
      // Update UI — show signed state
      const ctaEl = document.getElementById('statusCta');
      ctaEl.innerHTML = `
        <div style="margin-top:1.25rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,0.08);">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:0.75rem">
            <span style="font-size:1.5rem">✅</span>
            <div>
              <div style="color:rgba(255,255,255,0.9);font-size:0.95rem;font-weight:700">Order digitalt bekräftad!</div>
              <div style="color:rgba(255,255,255,0.5);font-size:0.8rem">Tack! Vi bekräftar via e-post och ses på eventet.</div>
            </div>
          </div>
          <div style="font-size:0.8rem;color:rgba(255,255,255,0.60);font-family:monospace">
            Ref: ${c.id} · ${new Date().toLocaleString('sv-SE')}
          </div>
        </div>`;
    } else {
      alert(data.error || data.message || `Fel ${res.status}: Något gick fel. Försök igen eller kontakta oss.`);
      btn.disabled = false;
      btn.textContent = '✅ Bekräfta order';
    }
  } catch(e) {
    alert(e.message || 'Nätverksfel — kontrollera din anslutning och försök igen.');
    btn.disabled = false;
    btn.textContent = '✅ Bekräfta order';
  }
}

async function sendMessage() {
  const input = document.getElementById('chatInput');
  const btn   = document.getElementById('chatSendBtn');
  const text  = input?.value.trim();
  if (!text) return;

  btn.disabled      = true;
  btn.textContent   = 'Skickar…';

  try {
    const res  = await fetch('/.netlify/functions/cart-message', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ cart_id: cartId, token: cartToken, body: text })
    });
    const data = await res.json();

    if (res.ok) {
      messages.push({
        id:         data.message?.id || Date.now(),
        sender:     'customer',
        body:       text,
        read_at:    null,
        created_at: new Date().toISOString()
      });
      input.value = '';
      renderMessages();
    } else {
      alert(data.error || 'Kunde inte skicka meddelandet. Försök igen.');
    }
  } catch {
    alert('Nätverksfel — kontrollera din anslutning och försök igen.');
  }

  btn.disabled    = false;
  btn.textContent = 'Skicka meddelande →';
}

document.getElementById('chatSendBtn').addEventListener('click', sendMessage);
document.getElementById('chatInput').addEventListener('keydown', e => {
  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) sendMessage();
});

// ── B2B FAKTURAUPPGIFTER ─────────────────────────────────────────
function _isB2B(c) {
  return c && (c.customer_type === 'b2b' || (!c.customer_type && c.customer_company));
}

function renderInvoiceSection(c) {
  const sec = document.getElementById('invoiceSection');
  if (!sec) return;
  if (!_isB2B(c)) { sec.style.display = 'none'; return; }
  sec.style.display = '';
  window._currentCart = c; // säkerställ referens innan ev. spara

  const locked = !!c.invoice_number; // faktura skapad → låst
  const lockBadge = document.getElementById('invoiceLockBadge');
  if (lockBadge) lockBadge.style.display = locked ? '' : 'none';

  const esc = s => String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  const row = (k, v) => {
    const empty = v == null || v === '';
    return `<div class="inv-view-row"><span class="inv-view-k">${k}</span><span class="inv-view-v${empty?' inv-view-empty':''}">${empty ? 'Ej angivet' : esc(v)}</span></div>`;
  };

  const eInvoiceShown = (c.use_invoice_email && c.invoice_email) ? c.invoice_email : null;
  const peppolFlag = c.wants_peppol
    ? `<div class="inv-peppol-flag">⚡ E-faktura via Peppol/EDI önskas${c.peppol_id ? ' · ' + esc(c.peppol_id) : ''}</div>`
    : '';

  const view = document.getElementById('invoiceView');
  view.innerHTML =
    row('Företag', c.customer_company) +
    row('Organisationsnummer', c.customer_orgnr) +
    row('Fakturareferens / PO', c.customer_ref) +
    row('Fakturaadress', c.customer_invoice_address || (c.customer_address ? c.customer_address + ' (samma som kontakt)' : null)) +
    row('E-faktura skickas till', eInvoiceShown || (c.customer_email ? c.customer_email + ' (vanlig e-post)' : null)) +
    peppolFlag +
    (locked
      ? `<p style="margin:0.9rem 0 0;color:rgba(255,255,255,0.55);font-size:0.82rem">Fakturan är skapad och uppgifterna är låsta. Kontakta oss på <a href="tel:0724481000" style="color:#c4b5f4">072-448 10 00</a> för ändringar.</p>`
      : `<button class="inv-btn-edit" id="invEditBtn">✎ Redigera / komplettera</button>`);

  document.getElementById('invoiceEdit').style.display = 'none';
  view.style.display = '';

  if (!locked) {
    const editBtn = document.getElementById('invEditBtn');
    if (editBtn) editBtn.onclick = () => openInvoiceEdit(c);
  }
}

function openInvoiceEdit(c) {
  document.getElementById('invoiceView').style.display = 'none';
  document.getElementById('invoiceEdit').style.display = '';
  document.getElementById('invMsg').textContent = '';

  document.getElementById('invCompany').value = c.customer_company || '';
  document.getElementById('invOrgnr').value = c.customer_orgnr || '';
  document.getElementById('invRef').value   = c.customer_ref || '';

  // Adress: bockad = samma som kontakt
  const hasSepAddr = !!c.customer_invoice_address;
  document.getElementById('invAddrSame').checked = !hasSepAddr;
  document.getElementById('invAddrField').style.display = hasSepAddr ? '' : 'none';
  document.getElementById('invAddr').value = c.customer_invoice_address || '';

  // E-post: bockad = vanlig e-post
  const hasSepEmail = !!(c.use_invoice_email && c.invoice_email);
  document.getElementById('invEmailSame').checked = !hasSepEmail;
  document.getElementById('invEmailField').style.display = hasSepEmail ? '' : 'none';
  document.getElementById('invEmail').value = c.invoice_email || '';

  // Peppol
  const wantsPeppol = !!c.wants_peppol;
  document.getElementById('invPeppol').checked = wantsPeppol;
  document.getElementById('invPeppolField').style.display = wantsPeppol ? '' : 'none';
  document.getElementById('invPeppolId').value = c.peppol_id || '';

  // Toggle-bindningar
  document.getElementById('invAddrSame').onchange = e =>
    document.getElementById('invAddrField').style.display = e.target.checked ? 'none' : '';
  document.getElementById('invEmailSame').onchange = e =>
    document.getElementById('invEmailField').style.display = e.target.checked ? 'none' : '';
  document.getElementById('invPeppol').onchange = e =>
    document.getElementById('invPeppolField').style.display = e.target.checked ? '' : 'none';

  document.getElementById('invCancelBtn').onclick = () => renderInvoiceSection(c);
  document.getElementById('invSaveBtn').onclick = () => saveInvoiceDetails(c);
}

async function saveInvoiceDetails(c) {
  const btn = document.getElementById('invSaveBtn');
  const msg = document.getElementById('invMsg');
  msg.textContent = '';
  msg.style.color = 'rgba(255,255,255,0.7)';

  const addrSame  = document.getElementById('invAddrSame').checked;
  const emailSame = document.getElementById('invEmailSame').checked;
  const wantsPeppol = document.getElementById('invPeppol').checked;

  const payload = {
    token:   cartToken,
    cart_id: cartId,
    action:  'update_invoice_details',
    customer_company: document.getElementById('invCompany').value.trim(),
    customer_orgnr: document.getElementById('invOrgnr').value.trim(),
    customer_ref:   document.getElementById('invRef').value.trim(),
    customer_invoice_address: addrSame ? null : document.getElementById('invAddr').value.trim(),
    invoice_email:  emailSame ? null : document.getElementById('invEmail').value.trim(),
    use_invoice_email: !emailSame && !!document.getElementById('invEmail').value.trim(),
    wants_peppol: wantsPeppol,
    peppol_id: wantsPeppol ? document.getElementById('invPeppolId').value.trim() : null,
  };

  btn.disabled = true;
  btn.textContent = '⏳ Sparar…';
  try {
    const res = await fetch('/.netlify/functions/cart-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (res.ok && !data.error) {
      // Uppdatera lokal cart och rendera om i visningsläge
      Object.assign(c, {
        customer_company: payload.customer_company || null,
        customer_orgnr: payload.customer_orgnr || null,
        customer_ref:   payload.customer_ref || null,
        customer_invoice_address: payload.customer_invoice_address,
        invoice_email:  payload.invoice_email,
        use_invoice_email: payload.use_invoice_email,
        wants_peppol:   payload.wants_peppol,
        peppol_id:      payload.peppol_id,
      });
      renderInvoiceSection(c);
      // Uppdatera företagsbadge i headern om namnet ändrats
      const cb = document.getElementById('orderCompanyBadge');
      if (cb) {
        if (c.customer_company) {
          const op = c.customer_orgnr ? ` <span class="ocb-orgnr">· Org.nr ${c.customer_orgnr}</span>` : '';
          cb.innerHTML = `<span class="ocb-label">🏢 Offert till företag</span><span class="ocb-name">${c.customer_company}</span>${op}`;
          cb.style.display = '';
        } else {
          cb.style.display = 'none';
        }
      }
      const ok = document.createElement('div');
      ok.style.cssText = 'margin-top:0.8rem;padding:8px 12px;background:rgba(134,239,172,0.12);border:1px solid rgba(134,239,172,0.4);border-radius:8px;color:#86efac;font-size:0.85rem;font-weight:600';
      ok.textContent = '✓ Fakturauppgifterna är sparade. Tack!';
      const v = document.getElementById('invoiceView');
      v.appendChild(ok);
      setTimeout(() => { ok.style.transition = 'opacity 0.5s'; ok.style.opacity = '0'; setTimeout(() => ok.remove(), 500); }, 4000);
    } else {
      msg.style.color = '#f87171';
      msg.textContent = data.error || data.message || `Fel ${res.status}: kunde inte spara. Försök igen.`;
      btn.disabled = false;
      btn.textContent = 'Spara uppgifter';
    }
  } catch (e) {
    msg.style.color = '#f87171';
    msg.textContent = e.message || 'Nätverksfel — kontrollera din anslutning och försök igen.';
    btn.disabled = false;
    btn.textContent = 'Spara uppgifter';
  }
}

// Kund väljer leveranssätt direkt på orderkortet
async function setDeliveryMode(mode) {
  const msg = document.getElementById('delModeMsg');
  const btns = document.querySelectorAll('.odel-choice');
  btns.forEach(b => b.disabled = true);
  if (msg) { msg.style.color = 'rgba(255,255,255,0.7)'; msg.textContent = '⏳ Sparar val…'; }
  try {
    const res = await fetch('/.netlify/functions/cart-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token: cartToken, cart_id: cartId, action: 'set_delivery_mode', delivery_mode: mode }),
    });
    const data = await res.json();
    if (res.ok && !data.error) {
      const c = window._currentCart;
      if (c) { c.delivery_mode = mode; renderOrder(c); }
    } else {
      btns.forEach(b => b.disabled = false);
      if (msg) { msg.style.color = '#f87171'; msg.textContent = data.error || 'Kunde inte spara valet. Försök igen.'; }
    }
  } catch (e) {
    btns.forEach(b => b.disabled = false);
    if (msg) { msg.style.color = '#f87171'; msg.textContent = 'Nätverksfel — försök igen.'; }
  }
}

// Exponera funktioner som anropas via onclick i dynamisk HTML
window.confirmOrder = confirmOrder;
window.renderInvoiceSection = renderInvoiceSection;
window.setDeliveryMode = setDeliveryMode;

_ensureNameMap();
loadOrder();
</script>

</Layout>
