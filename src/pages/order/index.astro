---
import Layout from '../../layouts/Layout.astro';
import orderCatalog from '../../data/order-catalog-flat.json';
---
<Layout
  title="Din order – Scenkonsult Norden"
  description="Följ status på din order och chatta med oss direkt."
  noindex={true}
>

<style is:global>
  .order-page {
    min-height: 100vh;
    padding-top: calc(var(--nav-offset, 166px) + 2.5rem);
    padding-bottom: 4rem;
  }
  .order-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.25rem;
    color: #f0eeff;
  }

  /* ── STATES ───────────────────────────────────────────── */
  .state { display: none; }
  .state.active { display: block; }

  /* Loading */
  .loading-box {
    text-align: center;
    padding: 4rem 2rem;
    color: rgba(255,255,255,0.60);
  }
  .spinner {
    width: 36px; height: 36px;
    border: 3px solid rgba(196,181,244,0.2);
    border-top-color: #c4b5f4;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Error */
  .error-box {
    background: rgba(248,113,113,0.08);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
    color: #f87171;
  }
  .error-box h2 { margin-bottom: 0.5rem; }
  .error-box p { color: rgba(255,255,255,0.5); font-size: 0.9rem; }

  /* ── ORDER CARD ────────────────────────────────────────── */
  .order-header { margin-bottom: 2rem; }
  .order-company-badge {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin: 0.5rem 0 0.25rem;
    padding: 7px 12px;
    background: rgba(196,181,244,0.10);
    border: 1px solid rgba(196,181,244,0.28);
    border-radius: 8px;
    font-size: 0.9rem;
  }
  .order-company-badge .ocb-label {
    color: rgba(255,255,255,0.55);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }
  .order-company-badge .ocb-name {
    color: #f0eeff;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .order-company-badge .ocb-orgnr {
    color: rgba(255,255,255,0.55);
    font-size: 0.78rem;
  }
  /* ── B2B FAKTURAUPPGIFTER ──────────────────────────────── */
  .inv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  @media (max-width: 560px) { .inv-grid { grid-template-columns: 1fr; } }
  .inv-field { display: flex; flex-direction: column; gap: 0.3rem; }
  .inv-label {
    font-size: 0.72rem; font-weight: 700; color: rgba(255,255,255,0.72);
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .inv-input {
    background: #0f0d2a; color: #f0eeff; color-scheme: dark;
    border: 1px solid rgba(255,255,255,0.14); border-radius: 8px;
    padding: 0.5rem 0.7rem; font-family: inherit; font-size: 0.9rem; width: 100%;
  }
  .inv-input:focus { outline: none; border-color: rgba(196,181,244,0.55); }
  .inv-textarea { resize: vertical; min-height: 64px; }
  .inv-hint { display: block; margin-top: 0.35rem; font-size: 0.76rem; color: rgba(255,255,255,0.5); line-height: 1.4; }
  .inv-check {
    display: flex; align-items: flex-start; gap: 0.55rem; cursor: pointer;
    font-size: 0.86rem; color: rgba(255,255,255,0.8); line-height: 1.4;
  }
  .inv-check input { accent-color: #c4b5f4; width: 15px; height: 15px; margin-top: 2px; flex-shrink: 0; }
  .inv-actions { display: flex; gap: 0.6rem; margin-top: 1.2rem; flex-wrap: wrap; }
  .inv-btn-save {
    background: #c4b5f4; color: #0c0a24; border: none; border-radius: 8px;
    padding: 0.6rem 1.4rem; font-weight: 700; font-size: 0.9rem; cursor: pointer;
    font-family: inherit; transition: background 0.15s;
  }
  .inv-btn-save:hover { background: #e2dcfb; }
  .inv-btn-save:disabled { opacity: 0.6; cursor: default; }
  .inv-btn-cancel {
    background: transparent; color: rgba(255,255,255,0.7);
    border: 1px solid rgba(255,255,255,0.18); border-radius: 8px;
    padding: 0.6rem 1.2rem; font-weight: 600; font-size: 0.9rem; cursor: pointer; font-family: inherit;
  }
  .inv-btn-cancel:hover { color: #fff; border-color: rgba(255,255,255,0.35); }
  .inv-btn-edit {
    background: rgba(196,181,244,0.12); color: #c4b5f4;
    border: 1px solid rgba(196,181,244,0.3); border-radius: 8px;
    padding: 0.5rem 1.1rem; font-weight: 700; font-size: 0.85rem; cursor: pointer;
    font-family: inherit; margin-top: 0.9rem; transition: background 0.15s;
  }
  .inv-btn-edit:hover { background: rgba(196,181,244,0.2); }
  .inv-view-row { display: flex; gap: 0.6rem; padding: 0.4rem 0; font-size: 0.88rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .inv-view-row:last-child { border-bottom: none; }
  .inv-view-k { color: rgba(255,255,255,0.55); min-width: 160px; flex-shrink: 0; }
  .inv-view-v { color: #f0eeff; font-weight: 600; }
  .inv-view-empty { color: rgba(255,255,255,0.4); font-style: italic; font-weight: 400; }
  .inv-peppol-flag {
    display: inline-block; margin-top: 0.5rem; padding: 4px 10px;
    background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.4);
    border-radius: 6px; color: #fbbf24; font-size: 0.78rem; font-weight: 600;
  }
  .order-id {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.60);
    margin-bottom: 0.5rem;
  }
  .order-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .order-subtitle { color: rgba(255,255,255,0.5); font-size: 0.95rem; }

  /* Status banner */
  .status-banner {
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    border: 1px solid transparent;
  }
  .status-banner.s-open       { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.08); }
  .status-banner.s-proposal   { background: rgba(96,165,250,0.08);  border-color: rgba(96,165,250,0.2);  }
  .status-banner.s-waiting    { background: rgba(251,191,36,0.08);  border-color: rgba(251,191,36,0.2);  }
  .status-banner.s-confirmed  { background: rgba(74,222,128,0.08);  border-color: rgba(74,222,128,0.25); }
  .status-banner.s-fakturerad { background: rgba(196,181,244,0.10); border-color: rgba(196,181,244,0.3); }
  .status-banner.s-completed  { background: rgba(74,222,128,0.10);  border-color: rgba(74,222,128,0.35); }
  .status-banner.s-cancelled  { background: rgba(248,113,113,0.08); border-color: rgba(248,113,113,0.2); }
  .status-icon { font-size: 2rem; flex-shrink: 0; }
  .status-label {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }
  .status-desc { color: rgba(255,255,255,0.5); font-size: 0.875rem; }

  /* ── SECTION ───────────────────────────────────────────── */
  .section {
    background: #1a1740;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    margin-bottom: 1.25rem;
    overflow: hidden;
  }
  .section-head {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    font-weight: 700;
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .section-body { padding: 1.25rem 1.25rem; }

  /* Info grid */
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .info-field { }
  .info-label { font-size: 0.75rem; color: rgba(255,255,255,0.60); margin-bottom: 0.2rem; }
  .info-value { font-size: 0.95rem; font-weight: 500; color: #f0eeff; }

  /* Product table */
  /* ── CHECKOUT-INSPIRERAD LAYOUT ──────────────────────────── */

  /* Orderrader — likt varukorg */
  .order-cart-wrap {
    background: #151333;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }
  .order-cart-header {
    padding: 0.75rem 1.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(196,181,244,0.6);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    display: grid;
    grid-template-columns: 64px 1fr 60px 72px 80px;
    gap: 0.5rem;
    align-items: center;
  }
  .order-cart-row {
    display: grid;
    grid-template-columns: 64px 1fr 60px 72px 80px;
    gap: 0.5rem;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .order-cart-row:last-child { border-bottom: none; }
  .order-cart-row.svc-row { background: rgba(255,255,255,0.015); }
  .row-img {
    width: 56px; height: 48px;
    border-radius: 8px;
    overflow: hidden;
    background: #0c0a24;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .row-img img { width:100%;height:100%;object-fit:cover; }
  .row-img svg { width:100%;height:100%;display:block; }
  .row-img-clickable { cursor: zoom-in; }
  .order-cart-row-clickable:hover .row-img { transform: scale(1.06); }
  .order-cart-row-clickable:hover { background: rgba(196,181,244,0.05); }
  .order-cart-row-clickable { transition: background 0.15s; }
  .row-info-hint {
    display: inline-flex; align-items: center; justify-content: center;
    width: 15px; height: 15px; border-radius: 50%;
    background: rgba(196,181,244,0.2);
    color: #c4b5f4; font-size: 0.6rem; font-weight: 700;
    margin-left: 5px; vertical-align: middle;
    font-style: normal;
  }
  .row-name   { font-weight: 600; font-size: 0.9rem; color: #f0eeff; display: flex; align-items: center; }
  .row-cat    { font-size: 0.72rem; color: rgba(255,255,255,0.60); margin-top:1px; }
  .row-qty    { text-align: center; color: rgba(255,255,255,0.6); font-size: 0.88rem; }
  .row-price  { text-align: right; color: rgba(255,255,255,0.5); font-size: 0.88rem; }
  .row-total  { text-align: right; color: #c4b5f4; font-weight: 700; font-size: 0.9rem; }

  /* Section separator */
  .order-sec-label {
    padding: 0.45rem 1.25rem 0.3rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(196,181,244,0.5);
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(196,181,244,0.03);
  }
  .order-sec-label:first-child { border-top: none; background: transparent; }

  /* Tidpunkter */
  .order-times {
    display: flex;
    gap: 1.5rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(196,181,244,0.04);
    flex-wrap: wrap;
  }
  .order-time-item { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .order-time-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing:0.07em; color: rgba(255,255,255,0.60); }
  .order-time-value { font-size: 0.88rem; font-weight: 600; color: #f0eeff; }

  /* Leverans- / hämtningsblock */
  .order-delivery {
    display: flex;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    align-items: flex-start;
  }
  .order-delivery-pickup { background: rgba(74,222,128,0.07); border-left: 3px solid rgba(74,222,128,0.55); }
  .order-delivery-truck  { background: rgba(74,222,128,0.07); border-left: 3px solid rgba(74,222,128,0.55); }
  .order-delivery-tbd    { background: rgba(251,191,36,0.07); border-left: 3px solid rgba(251,191,36,0.55); }
  .odel-icon { font-size: 1.55rem; flex-shrink: 0; line-height: 1.2; }
  .odel-body { flex: 1; min-width: 0; }
  .odel-title {
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 0.25rem;
  }
  .odel-text {
    font-size: 0.83rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.55;
    margin-bottom: 0.7rem;
  }
  .odel-addr {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    margin-bottom: 0.55rem;
  }
  .odel-addr-label {
    display: block;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.60);
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .odel-addr-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #f0eeff;
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .odel-addr-link strong { color: #f0eeff; font-weight: 700; }
  .odel-addr-arrow {
    color: #c4b5f4;
    font-size: 0.75rem;
    margin-top: 0.15rem;
    font-weight: 600;
  }
  .odel-addr-link:hover .odel-addr-arrow { text-decoration: underline; }
  .odel-note {
    font-size: 0.76rem;
    color: rgba(255,255,255,0.60);
    line-height: 1.55;
    font-style: italic;
  }
  /* Leveranssätt-val (kund väljer direkt) */
  .odel-choices { display: flex; gap: 0.6rem; margin-top: 0.85rem; flex-wrap: wrap; }
  .odel-choice {
    flex: 1; min-width: 180px;
    display: flex; align-items: center; gap: 0.6rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px; padding: 0.7rem 0.9rem;
    cursor: pointer; text-align: left;
    font-family: inherit; color: #f0eeff;
    transition: background 0.15s, border-color 0.15s;
  }
  .odel-choice:hover { background: rgba(196,181,244,0.12); border-color: rgba(196,181,244,0.45); }
  .odel-choice:disabled { opacity: 0.55; cursor: default; }
  .odel-choice-ic { font-size: 1.4rem; flex-shrink: 0; }
  .odel-choice-tx { display: flex; flex-direction: column; gap: 1px; }
  .odel-choice-tx strong { font-size: 0.9rem; font-weight: 700; }
  .odel-choice-tx span { font-size: 0.76rem; color: rgba(255,255,255,0.6); line-height: 1.35; }

  /* Totals box */
  .order-totals {
    background: #1a1740;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 1.1rem 1.25rem;
    margin-bottom: 1.25rem;
  }
  .totals-row {
    display: flex; justify-content: space-between;
    font-size: 0.875rem; color: rgba(255,255,255,0.5);
    margin-bottom: 0.4rem;
  }
  .totals-row.grand {
    font-size: 1.1rem; font-weight: 700; color: #c4b5f4;
    margin-top: 0.6rem; padding-top: 0.6rem;
    border-top: 1px solid rgba(196,181,244,0.2);
    margin-bottom: 0;
  }
  .totals-note { font-size: 0.75rem; color: rgba(255,255,255,0.60); margin-top:0.5rem; font-style:italic; }
  .totals-fee-note {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.72);
    margin-top: 0.75rem;
    padding: 8px 12px;
    background: rgba(196,181,244,0.06);
    border-left: 3px solid rgba(196,181,244,0.45);
    border-radius: 0 6px 6px 0;
    line-height: 1.55;
  }

  @media (max-width:480px) {
    .order-cart-header { display: none; }
    .order-cart-row { grid-template-columns: 56px 1fr 60px; }
    .row-price { display: none; }
  }


  /* ── CHATT ─────────────────────────────────────────────── */
  .chat-messages { display: flex; flex-direction: column; gap: 0.875rem; margin-bottom: 1.25rem; }
  .chat-empty { color: rgba(255,255,255,0.60); font-size: 0.9rem; font-style: italic; padding: 0.5rem 0; }
  .msg-wrap { display: flex; flex-direction: column; }
  .msg-wrap.admin    { align-items: flex-start; }
  .msg-wrap.customer { align-items: flex-end; }
  .msg-sender-label { font-size: 0.7rem; font-weight: 700; color: rgba(255,255,255,0.60); margin-bottom: 0.2rem; padding: 0 0.25rem; }
  .msg-bubble {
    max-width: 82%;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .msg-wrap.admin    .msg-bubble { background: #221f50; color: #f0eeff; border-bottom-left-radius: 4px; }
  .msg-wrap.customer .msg-bubble { background: #332885; color: #fff; border-bottom-right-radius: 4px; }
  .msg-meta { font-size: 0.7rem; color: rgba(255,255,255,0.60); margin-top: 0.25rem; padding: 0 0.25rem; }

  .chat-input-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 1rem;
  }
  .chat-textarea {
    width: 100%;
    box-sizing: border-box;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #f0eeff;
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    resize: vertical;
    min-height: 80px;
    transition: border-color 0.15s;
    color-scheme: dark;
  }
  .chat-textarea:focus { outline: none; border-color: rgba(196,181,244,0.4); }
  .chat-textarea::placeholder { color: rgba(255,255,255,0.55); }
  .chat-send-btn {
    align-self: flex-end;
    background: #c4b5f4;
    color: #0c0a24;
    border: none;
    border-radius: 8px;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }
  .chat-send-btn:hover { background: #e2dcfb; }
  .chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

</style>

<div class="order-page">

<!-- Admin-banner — synlig bara i sk-admin-läge -->
<div class="sk-admin-only" id="admin-order-banner" style="background:rgba(196,181,244,0.1);border-bottom:1px solid rgba(196,181,244,0.25);padding:0.6rem 1.25rem;display:flex;align-items:center;gap:1rem;font-size:0.82rem;font-family:'Space Grotesk',sans-serif;">
  <span style="color:#c4b5f4;font-weight:700;">⚙ Admin</span>
  <span style="color:rgba(255,255,255,0.5)" id="admin-cart-id-label">–</span>
  <a id="admin-open-kanban" href="/admin/" target="_blank"
    style="color:#c4b5f4;text-decoration:none;border:1px solid rgba(196,181,244,0.3);border-radius:6px;padding:0.2rem 0.6rem;font-size:0.78rem;">
    Öppna i admin →
  </a>
</div>

<div class="order-wrap">

  <!-- LOADING -->
  <div class="state active" id="stateLoading">
    <div class="loading-box">
      <div class="spinner"></div>
      Hämtar din order…
    </div>
  </div>

  <!-- ERROR -->
  <div class="state" id="stateError">
    <div class="error-box">
      <h2>Länken är ogiltig</h2>
      <p>Orderinformationen kunde inte hittas. Kontrollera att du använder rätt länk från bekräftelsemailet.</p>
      <p style="margin-top:1.5rem">
        Frågor? Ring oss på <a href="tel:0724481000" style="color:#f87171">072-448 10 00</a>
      </p>
    </div>
  </div>

  <!-- ORDER -->
  <div class="state" id="stateOrder">

    <!-- Header -->
    <div class="order-header">
      <div class="order-id" id="orderId"></div>
      <div id="orderCompanyBadge" class="order-company-badge" style="display:none"></div>
      <h1 class="order-title" id="orderTitle">Din order</h1>
      <p class="order-subtitle" id="orderSubtitle"></p>
    </div>

    <!-- Status banner -->
    <div class="status-banner" id="statusBanner">
      <div class="status-icon" id="statusIcon"></div>
      <div style="flex:1">
        <div class="status-label" id="statusLabel"></div>
        <div class="status-desc" id="statusDesc"></div>
      </div>
    </div>
    <div id="statusCta" style="display:none"></div>

    <!-- Products + event info combined checkout-style -->
    <div class="order-cart-wrap" id="orderCartWrap">
      <div class="order-cart-header">
        <span></span>
        <span>Produkt / Tjänst</span>
        <span style="text-align:center">Antal</span>
        <span style="text-align:right">À-pris</span>
        <span style="text-align:right">Summa</span>
      </div>
      <div id="prodTableWrap"></div>
    </div>

    <!-- Totals -->
    <div class="order-totals" id="orderTotals" style="display:none">
