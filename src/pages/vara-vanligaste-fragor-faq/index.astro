---
import SidHuvud from '../../components/SidHuvud.astro';
import SlutRuta from '../../components/event/SlutRuta.astro';
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": site.faq.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Vanliga frågor (FAQ)' }];
---

<Layout breadcrumbs={pageBreadcrumbs}
  title="Vanliga frågor om hyra scen, ljud & bild i Stockholm | Scenkonsult FAQ"
  description="Svar på de vanligaste frågorna om att hyra scen, ljud och bild i Stockholm. Hyresperiod, installation, leverans, priser och bokning. Scenkonsult sedan 1986."
  schemaExtra={faqSchema}
>

  <SidHuvud
    brod={[{ label: 'Hem', href: '/' }, { label: 'Vanliga frågor (FAQ)' }]}
    eyebrow="FAQ"
    h1="Vanliga"
    h1Accent="frågor"
    introHtml={'Här svarar vi på de frågor vi får mest – om bokning, installation, leverans och mer. Hittar du inte svar på din fråga? <a href="/kontakt/">Kontakta oss</a>.'}
  />

  <section class="fq-wrap">
    <div class="fq-sida">
      <p class="sk-eyebrow">Fortfarande osäker?</p>
      <p class="fq-lead">Fråga Sven, vår digitala intendent, när som helst — eller ring oss.</p>
      <button type="button" class="sk-knapp" data-sven-oppna>Fråga Sven</button>
    </div>
    <div class="fq-lista">
      {site.faq.map((f) => (
        <details class="bg-brand-navy">
          <summary class="flex items-center justify-between cursor-pointer list-none">
            <h2>{f.q}</h2>
            <span aria-hidden="true">+</span>
          </summary>
          <div><p set:html={f.a}></p></div>
        </details>
      ))}
    </div>
  </section>

  <SlutRuta rubrik="Har du fler frågor?" text="Välkommen att höra av dig — eller fråga Sven, vår digitala intendent, när som helst." />
</Layout>

<style>
  .fq-wrap { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  .fq-sida { position: sticky; top: calc(var(--nav-offset, 166px) - 30px); }
  .fq-lead { margin: 0 0 1.2rem; color: rgba(255,255,255,0.72); line-height: 1.55; }
  .fq-lista summary h2 { margin: 0; font-family: 'Source Sans 3', sans-serif; font-size: 1.1rem; font-weight: 600; color: #fff; }
  .fq-lista :global(a) { color: #c4b5f4; }
  @media (max-width: 900px) { .fq-wrap { grid-template-columns: minmax(0, 1fr); } .fq-sida { position: static; order: 2; } }
</style>
<script>
  document.querySelectorAll('[data-sven-oppna]').forEach((b) => {
    if ((b as HTMLElement).dataset.svenKopplad) return;
    (b as HTMLElement).dataset.svenKopplad = '1';
    b.addEventListener('click', () => document.getElementById('sven-toggle')?.click());
  });
</script>
