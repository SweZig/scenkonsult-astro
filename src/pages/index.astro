---
// Startsidan — redesign 2026-10 (designytan "Scenkonsult startsida — redesign").
// Ordning: hero → faktarad → kategorikort → topplista → referenser och
// logotyper → omdömen → så funkar det → slutruta.
// Alla priser, tider och listor räknas ur datafilerna; inget skrivs in här.
import Layout from '../layouts/Layout.astro';
import YouTubeKlick from '../components/YouTubeKlick.astro';
import CartButton from '../components/CartButton.astro';
import djData from '../data/dj.json';
import scenesData from '../data/scenes.json';
import ljudData from '../data/ljud.json';
import bildData from '../data/bild.json';
import ljusData from '../data/ljus.json';
import siteData from '../data/site.json';
import popular from '../data/popular.json';
import eventCases from '../data/event-cases.json';
import reviewsData from '../data/reviews.json';
import ljudLjusConfig from '../data/ljud-ljus.json';
import _karaokeData from '../data/karaoke.json';
import _tjData from '../data/tjanster.json';
import _elData from '../data/el.json';
import { resolveBuilder as _kbResolve, minTotal as _kbMin } from '../lib/karaoke-builder.mjs';
import { resolveLjudLjus, minRecommended } from '../lib/ljud-ljus-builder.mjs';
import { getSummary, getReviews } from '../utils/reviews';
import { nyckel } from '../scripts/recensioner-live';
import { KUNDLOGOTYPER } from '../utils/clients';
import { produktLank } from '../utils/produktLank';
import { telefon, helg } from '../utils/hours';

const fmt = (n: number) => n.toLocaleString('sv-SE');
const inkl = (n: number) => Math.round(n * 1.25);
const _low = (items: any[]) => Math.min(...items.filter((p: any) => p?.price && p.active !== false).map((p: any) => p.price));
const _alla = { karaoke: _karaokeData, ljud: ljudData, ljus: ljusData, bild: bildData, dj: djData, scenes: scenesData, tjanster: _tjData, el: _elData };

// ── Från-priser ur katalogen ────────────────────────────────────────────────
const _scenAktiva = ((scenesData as any).products as any[]).filter((p: any) => p.active !== false);
const _scenYtor = _scenAktiva.map((p: any) => parseFloat(String(p.size))).filter((n: number) => !isNaN(n));
const scenFran = _low(_scenAktiva);
const ljudFran = _low(['portable', 'event', 'music', 'live'].flatMap((k) => (ljudData as any)[k]?.products ?? []));
const ljusFran = _low((ljusData as any).paket?.products ?? []);
const bildFran = _low((bildData as any).products);
const kbFran = _kbMin(_kbResolve(_karaokeData, _alla));
const llFran = minRecommended(resolveLjudLjus(ljudLjusConfig, _alla));
// DJ-utrustning: billigaste controller/system (samma urval som DJ-utrustningssidan)
const djUtrFran = Math.min(...((djData as any).equipment as any[]).filter((p: any) => /controller|rane|system/i.test(p.name) && p.price && p.active !== false).map((p: any) => p.price));

// ── Företagsfakta ───────────────────────────────────────────────────────────
const grundat = Number((siteData as any).company?.founded) || 1986;
const arIBranschen = new Date().getFullYear() - grundat;
const betyg = getSummary();
const googleUrl = (reviewsData as any)._placeUrl as string;

// ── Hero: fyra uppdrag som växlar ───────────────────────────────────────────
type Bild = { src: string; w: number; alt: string; text: string; pos?: string };
const srcset = (b: { src: string; w: number }) => `${b.src.replace(/\.webp$/, '-640w.webp')} 640w, ${b.src} ${b.w}w`;
const HERO: Bild[] = [
  { src: '/images/event/uf_strawberry_arena_1.webp', w: 1050, alt: 'Scenkonsults talarpodium på Strawberry Arena', text: 'Strawberry Arena — Ung Företagsamhet' },
  { src: '/images/event/kundevent_lakarforbundet.webp', w: 1050, alt: 'Dansgolv och DJ i festvåning hos Läkarförbundet', text: 'Läkarförbundet — Östermalm' },
  { src: '/images/event/festival_vinterviken_2.webp', w: 1400, alt: 'Publik framför scenen på festivalen i Vinterviken', text: 'Festival — Vinterviken' },
  { src: '/images/event/festival_hard_rock_rising.webp', w: 1050, alt: 'Liveband på Hard Rock Café under Hard Rock Rising', text: 'Hard Rock Café — Hard Rock Rising' },
];

// ── Kategorikort ────────────────────────────────────────────────────────────
const V = '/vara-tjanster';
const KORT = [
  { namn: 'Ljud', href: `${V}/hyra-ljud/`, desc: 'Högtalare och PA för fest, tal och liveband.', fran: ljudFran,
    bild: { src: '/images/event/festival_hard_rock_rising.webp', w: 1050, alt: 'Liveband på Hard Rock Café', pos: '50% 50%' },
    chips: [['Portable', `${V}/hyra-ljud/portable/`], ['Kolumn', `${V}/hyra-ljud/kolumnhogtalare/`], ['Event', `${V}/hyra-ljud/event/`], ['Musik', `${V}/hyra-ljud/music/`], ['Live', `${V}/hyra-ljud/live/`], ['Ljudtekniker', `${V}/hyra-ljudtekniker/`]] },
  { namn: 'Ljus', href: `${V}/hyra-ljus/`, desc: 'Från festljus till moving heads och DMX.', fran: ljusFran,
    bild: { src: '/images/event/installation_german_beerhall_1.webp', w: 1050, alt: 'Blått ljus och LED-ramper i taket på German Beer Hall', pos: '50% 35%' },
    chips: [['Färdiga paket', `${V}/hyra-ljus/fardiga-paket/`], ['Effekter', `${V}/hyra-ljus/ljuseffekter/`], ['Moving heads', `${V}/hyra-ljus/moving-heads/`], ['Rök & pyro', `${V}/hyra-ljus/rok-pyro/`], ['Stativ & tross', `${V}/hyra-ljus/stativ-tross/`]] },
  { namn: 'Ljud & ljus', tag: 'Bygg ert paket', href: `${V}/hyra-ljud-och-ljus/`, desc: 'Tre frågor — sedan ett färdigt förslag med ljud och ljus.', fran: llFran,
    bild: { src: '/images/event/kundevent_systembolaget_3.webp', w: 1050, alt: 'Högtalare och uplights i festvåning hos Systembolaget', pos: '50% 55%' },
    chips: [['Starta konfiguratorn', `${V}/hyra-ljud-och-ljus/#bygg`], ['Bröllop', '/for/brollop/'], ['Företagsfest', '/for/foretagsfest/']] },
  { namn: 'Konferens', href: `${V}/konferens-av/`, desc: 'Ljud, bild, scen och tekniker för möten och kickoffer.', fran: bildFran,
    bild: { src: '/images/event/kundevent_solna_naringsliv.webp', w: 1600, alt: 'Konferenssal med tre skärmar hos Solna Näringsliv', pos: '50% 50%' },
    chips: [['Mikrofoner', `${V}/konferens-av/#mikrofoner`], ['Projektor', `${V}/konferens-av/#projektor`], ['Bild & skärm', `${V}/hyra-bild-projektorer-skarmar/`], ['Ljudtekniker', `${V}/hyra-ljudtekniker/`]] },
  { namn: 'Bild', href: `${V}/hyra-bild/`, desc: 'Projektor, skärmar, LED-vägg och LED-trailer.', fran: bildFran,
    bild: { src: '/images/event/kundevent_emberlin_2.webp', w: 1050, alt: 'Skärm på golvstativ i restaurangmiljö hos Emberlin', pos: '50% 45%' },
    chips: [['Projektor & skärm', `${V}/hyra-bild-projektorer-skarmar/`], ['LED-vägg', `${V}/hyra-bild-led-vagg/`], ['LED-trailer', `${V}/hyra-bild-projektorer-skarmar/#led-trailer`], ['Projektorduk', `${V}/hyra-bild-projektorer-skarmar/#projektorduk`]] },
  { namn: 'Scen', href: `${V}/hyra-scen/`, desc: `${_scenAktiva.length} scenpaket, ${Math.min(..._scenYtor)}–${Math.max(..._scenYtor)} m², med eller utan tak.`, fran: scenFran,
    bild: { src: '/images/event/kundevent_tele2_scenpodie.webp', w: 1050, alt: 'Scenpodie med ridå och storbild hos Tele2', pos: '50% 60%' },
    chips: [['Scenpaket', `${V}/hyra-scen/#scenpaket`], ['Bygg din scen', `${V}/hyra-scen/#scen-konfigurator`], ['Pipe & drape', `${V}/hyra-scen/pipe-drape/`], ['Tillbehör', `${V}/hyra-scen/#tillbehor`]] },
  { namn: 'Karaoke', tag: 'Bygg er karaoke', href: `${V}/hyra-karaoke/`, desc: 'Högtalare, mikrofoner, skärm och ljus — välj själv.', fran: kbFran,
    bild: { src: '/images/tjanster/plugg_karaoke_sang.webp', w: 819, alt: 'Kvinna sjunger karaoke med mikrofon under neonskylt', pos: '50% 30%' },
    chips: [['Starta byggaren', `${V}/hyra-karaoke/#bygg`]] },
  { namn: 'DJ-utrustning', href: `${V}/hyra-dj-utrustning/`, desc: 'Controllers, mixer och DJ-bord. Boka DJ också.', fran: djUtrFran,
    bild: { src: '/images/event/kundevent_swedish_taste_1.webp', w: 1050, alt: 'DJ vid controller hos Swedish Taste', pos: '50% 50%' },
    chips: [['Controllers', `${V}/hyra-dj-utrustning/#sk-dj-0001`], ['DJ-bord', `${V}/hyra-dj-utrustning/#sk-dj-0006`], ['Boka DJ', `${V}/hyra-dj/`]] },
].map((k: any) => ({ ...k, srcset: k.bild.srcset ?? srcset(k.bild) }));
// Mobilen visar snabblänkarna i en egen rad under korten
const SNABBVAL: [string, string][] = [
  ['LED-trailer', `${V}/hyra-bild-projektorer-skarmar/#led-trailer`], ['Ljudtekniker', `${V}/hyra-ljudtekniker/`],
  ['Konferens-AV', `${V}/konferens-av/`], ['Projektor & skärm', `${V}/hyra-bild-projektorer-skarmar/`],
  ['Mikrofoner', `${V}/konferens-av/#mikrofoner`], ['LED-vägg', `${V}/hyra-bild-led-vagg/`],
  ['Boka DJ', `${V}/hyra-dj/`], ['Pipe & drape', `${V}/hyra-scen/pipe-drape/`],
];

// ── Topplista: en rad per tillfälle ur popular.json (kurerat i admin) ───────
// Raden visar gruppens första produkt. Ljud & ljus visar första ljud- och
// första ljusprodukten som ett par. Uppslag alltid på artno.
const KATALOGER: [any, string][] = [[ljudData, 'Ljud'], [ljusData, 'Ljus'], [bildData, 'Bild'], [scenesData, 'Scen'], [djData, 'DJ']];
const ALLA: any[] = KATALOGER.flatMap(([d, kat]) => Object.values(d).flatMap((v: any) => {
  if (Array.isArray(v)) return v.filter((p: any) => p && typeof p === 'object' && p.artno);
  // En serie kan ha flera listor (ljud.live har products och lineArray) — ta alla.
  if (v && typeof v === 'object') return Object.values(v).filter(Array.isArray).flat().filter((p: any) => p && typeof p === 'object' && p.artno);
  return [];
}).map((p: any) => ({ ...p, _kat: kat })));
const hitta = (a: string) => ALLA.find((p) => p.artno === a && p.active !== false);
const TOPP_FLIKAR: [string, string, string][] = [
  ['ljud', 'Ljud', `${V}/hyra-ljud/`],
  ['ljus', 'Ljus', `${V}/hyra-ljus/`],
  ['ljud-och-ljus', 'Ljud & ljus', `${V}/hyra-ljud-och-ljus/`],
  ['bild', 'Bild', `${V}/hyra-bild/`],
  ['konferens', 'Konferens', `${V}/konferens-av/`],
];
const topplista = TOPP_FLIKAR.map(([nyckel, etikett, sida]) => {
  const cfg = (popular as Record<string, any>)[nyckel] ?? {};
  const rader = (cfg.grupper ?? []).map((g: any) => {
    const prod = (g.artnos ?? []).map(hitta).filter(Boolean);
    let valda = prod.slice(0, 1);
    if (nyckel === 'ljud-och-ljus') {
      const ljud = prod.find((p: any) => p._kat === 'Ljud');
      const ljus = prod.find((p: any) => p._kat === 'Ljus');
      valda = ljud && ljus ? [ljud, ljus] : prod.slice(0, 1);
    }
    if (!valda.length) return null;
    const pris = valda.reduce((s: number, p: any) => s + p.price, 0);
    return {
      tillfalle: [g.rubrik, g.gaster].filter(Boolean).join(' · '),
      namn: valda.map((p: any) => p.name).join(' + '),
      lank: valda.length === 1 ? produktLank(valda[0].artno) : sida,
      pris, produkter: valda,
    };
  }).filter(Boolean);
  return { nyckel, etikett, sida, rader };
}).filter((f) => f.rader.length);

// ── Referenser: hubbraden "start" ur event-cases.json (kurerat i admin) ─────
const _caseTag = new Map(((eventCases as any).cases as any[]).map((c) => [c.id, c.tag]));
const referenser = (((eventCases as any).hub?.start ?? []) as any[]).map((r) => ({ ...r, tag: _caseTag.get(r.caseId) ?? '' }));

// ── Omdömen: alla ur reviews.json i kurerad ordning ─────────────────────────
const omdomen = getReviews().filter((r) => r.rating >= 5 && r.text && r.text.trim().length > 0);
const _manad = (d: string) => new Date(d).toLocaleDateString('sv-SE', { month: 'short', year: 'numeric' }).replace('.', '');

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Vad kan man hyra av Scenkonsult Norden?", "acceptedAnswer": { "@type": "Answer", "text": "Vi hyr ut scen, ljud (PA-system), ljus (LED PAR, moving heads, laser), bild (projektorer och LED-skärmar), konferensteknik, karaoke och DJ-utrustning. Leverans och montering kan bokas till i hela Storstockholm." } },
    { "@type": "Question", "name": "Var i Stockholm levererar Scenkonsult?", "acceptedAnswer": { "@type": "Answer", "text": "Vi levererar inom ca 4 mils radie från Vällingby — det täcker hela Storstockholm inklusive Solna, Sundbyberg, Nacka, Huddinge, Täby och angränsande kommuner. Längre transporter offereras separat." } },
    { "@type": "Question", "name": "Hur lång är hyresperioden?", "acceptedAnswer": { "@type": "Answer", "text": "Normal hyresperiod är 22 timmar — hämtning eller leverans kl 13:00 och återlämning kl 11:00 påföljande dag. Längre perioder kan arrangeras mot tillägg." } },
    { "@type": "Question", "name": "Vad kostar leverans av utrustning?", "acceptedAnswer": { "@type": "Answer", "text": `Leverans med vanlig bil kostar ${fmt((_tjData as any).leverans?.standard?.pris)} kr tur och retur, stor bil ${fmt((_tjData as any).leverans?.storbil?.pris)} kr och lätt lastbil ${fmt((_tjData as any).leverans?.lastbil?.pris)} kr. Fordonet väljs efter hur mycket och hur skrymmande utrustningen är. Hämtar du själv i Vällingby är det gratis. Priser exkl. moms.` } },
    { "@type": "Question", "name": "Sedan när har Scenkonsult Norden funnits?", "acceptedAnswer": { "@type": "Answer", "text": `Scenkonsult Norden grundades ${grundat} och levererar scen, ljud och ljus till över hundra event per år i Storstockholm.` } }
  ]
};
---

<Layout
  alternates={[{ hreflang: 'en', href: '/en/' }]}
  schemaExtra={homeSchema}
  mobilBar={true}
  title="Hyra Scen, Ljud & Ljus Stockholm | Scenkonsult – Sedan 1986"
  description="Hyr scen, ljud, ljus och bild i Stockholm – för event, konferens, bröllop och fest. Färdiga paket med pris direkt, leverans och montering bokas till. Sedan 1986."
>

<!-- ── HERO ── -->
<section class="st-hero" style="padding-top:calc(var(--nav-offset,166px) + var(--st-luft, 2.5rem))">
  <div class="st-wrap st-hero-grid">
    <div class="st-hero-text">
      <p class="st-eyebrow">Uthyrning i hela Storstockholm · sedan {grundat}</p>
      <h1 class="st-h1">Hyra scen, ljud, ljus &amp; bild i <em>Stockholm</em></h1>
      <p class="st-lead">Klart till ert event. Hyr färdiga paket eller bygg ert eget i konfiguratorn. Priset räknas direkt i varukorgen — leverans och montering bokas till om ni vill.</p>
      <div class="st-knappar">
        <a href="#tjanster" class="st-btn st-btn-p">Se paket och priser</a>
        <a href="/varukorg/" class="st-btn st-btn-g">Begär offert</a>
      </div>
      <ul class="st-prischips" aria-label="Från-priser">
        <li>Ljus från <b><span class="sk-price-excl">{fmt(ljusFran)}</span><span class="sk-price-incl hidden">{fmt(inkl(ljusFran))}</span> kr</b>/dygn</li>
        <li>Ljud från <b><span class="sk-price-excl">{fmt(ljudFran)}</span><span class="sk-price-incl hidden">{fmt(inkl(ljudFran))}</span> kr</b>/dygn</li>
        <li>Scen från <b><span class="sk-price-excl">{fmt(scenFran)}</span><span class="sk-price-incl hidden">{fmt(inkl(scenFran))}</span> kr</b>/dygn</li>
        <li class="st-moms"><span class="sk-price-excl">exkl. moms</span><span class="sk-price-incl hidden">inkl. moms</span></li>
      </ul>
    </div>
    <figure class="st-hero-fig" data-vaxla="hero">
      {HERO.map((b, i) => (
        <img
          class:list={['st-slide', { 'is-aktiv': i === 0 }]}
          src={i === 0 ? b.src : undefined}
          srcset={i === 0 ? srcset(b) : undefined}
          data-src={i === 0 ? undefined : b.src}
          data-srcset={i === 0 ? undefined : srcset(b)}
          sizes="(max-width: 900px) 100vw, 42vw"
          alt={b.alt}
          width="1050" height="1400"
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
          aria-hidden={i === 0 ? undefined : 'true'}
        />
      ))}
      <figcaption class="st-hero-cap">
        <span class="st-hero-text-cap" aria-live="polite">{HERO[0].text}</span>
        <span class="st-prickar" role="group" aria-label="Välj bild">
          {HERO.map((b, i) => (
            <button type="button" class:list={['st-prick', { 'is-aktiv': i === 0 }]} data-index={i} data-text={b.text} aria-label={`Visa ${b.text}`} aria-pressed={i === 0 ? 'true' : 'false'}><span></span></button>
          ))}
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<!-- ── FAKTARAD ── -->
<section class="st-wrap st-fakta-wrap" aria-label="Fakta om oss">
  <div class="st-fakta">
    <a class="st-fakta-ruta" href={googleUrl} target="_blank" rel="noopener">
      <span class="st-fakta-n" data-rec-snitt>{betyg.ratingStr}</span>
      <span class="st-fakta-t"><span class="st-stjarnor" aria-hidden="true">★★★★★</span><br><u><span data-rec-antal>{betyg.count}</span> omdömen på Google ↗</u></span>
    </a>
    <a class="st-fakta-ruta" href="/om-oss/#historia">
      <span class="st-fakta-n">{arIBranschen} år</span>
      <span class="st-fakta-t">I branschen sedan {grundat}<br><u>Läs vår historia →</u></span>
    </a>
    <div class="st-fakta-ruta">
      <span class="st-fakta-n">100+</span>
      <span class="st-fakta-t">event per år,<br>20–2&nbsp;000 gäster</span>
    </div>
    <a class="st-fakta-ruta" href="/referenser/">
      <span class="st-fakta-n">100+</span>
      <span class="st-fakta-t">referenskunder: företag,<br>kommuner och ambassader</span>
    </a>
  </div>
</section>

<!-- ── KATEGORIER ── -->
<section id="tjanster" class="st-wrap st-sektion">
  <div class="st-rubrikrad">
    <h2 class="st-h2">Vad ska ni hyra?</h2>
    <p class="st-ingress">Från-priserna räknas ur vår katalog och gäller per dygn <span class="sk-price-excl">exkl.</span><span class="sk-price-incl hidden">inkl.</span> moms.</p>
  </div>
  <div class="st-kort-grid">
    {KORT.map((k: any) => (
      <article class="st-kort" data-helkort>
        <img src={k.bild.src} srcset={k.srcset} sizes="(max-width: 720px) 50vw, (max-width: 1100px) 33vw, 300px" alt={k.bild.alt} loading="lazy" decoding="async" style={`object-position:${k.bild.pos}`} />
        <div class="st-kort-ton" aria-hidden="true"></div>
        <div class="st-kort-text">
          <span class:list={['st-tag', { 'st-dold': !k.tag }]}>{k.tag ?? ''}</span>
          <h3 class="st-kort-namn"><a href={k.href} class="st-kort-lank">{k.namn}</a></h3>
          <p class="st-kort-desc">{k.desc}</p>
          <span class="st-kort-pris">från <b><span class="sk-price-excl">{fmt(k.fran)} kr</span><span class="sk-price-incl hidden">{fmt(inkl(k.fran))} kr</span></b> /dygn</span>
          <nav class="st-chips" aria-label={`${k.namn} — undersidor`}>
            {k.chips.map(([t, h]: [string, string]) => <a href={h}>{t}</a>)}
          </nav>
        </div>
      </article>
    ))}
  </div>
  <p class="st-snabbval-rubrik">Snabbval</p>
  <nav class="st-snabbval" aria-label="Snabbval">
    {SNABBVAL.map(([t, h]) => <a href={h}>{t}</a>)}
  </nav>
</section>

<!-- ── TOPPLISTA ── -->
{topplista.length > 0 && (
<section id="topplista" class="st-band">
  <div class="st-wrap st-topp">
    <div class="st-topp-sida">
      <p class="st-eyebrow">Topplista</p>
      <h2 class="st-h2">Våra mest bokade paket</h2>
      <p class="st-ingress">Det kunderna oftast hyr för varje typ av event. Lägg i varukorgen direkt, eller öppna produkten och läs mer.</p>
      <div class="st-flikar" role="tablist" aria-label="Kategori" aria-orientation="vertical">
        {topplista.map((f, i) => (
          <button type="button" role="tab" id={`tab-${f.nyckel}`} aria-controls={`panel-${f.nyckel}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="st-flik">
            <span>{f.etikett}</span><span aria-hidden="true">›</span>
          </button>
        ))}
      </div>
    </div>
    <div class="st-topp-lista">
      {topplista.map((f, i) => (
        <div class="st-panel" role="tabpanel" id={`panel-${f.nyckel}`} aria-labelledby={`tab-${f.nyckel}`} hidden={i !== 0}>
          <ol>
            {f.rader.map((r: any, j: number) => (
              <li class="st-rad" data-helkort>
                <span class="st-rang">{String(j + 1).padStart(2, '0')}</span>
                <span class="st-tummar">
                  {r.produkter.map((p: any) => p.image && <img src={p.image} alt="" width="128" height="107" loading="lazy" decoding="async" />)}
                </span>
                <span class="st-rad-text">
