  .st-omd-betyg span:first-child { font-family: 'DM Serif Display', serif; font-size: 5.25rem; color: #fff; line-height: 1; }
  .st-omd-betyg .st-stjarnor { font-size: 1.35rem; letter-spacing: 3px; }
  .st-omd-sida p { margin: 0.5rem 0 0; color: rgba(255,255,255,0.72); }
  .st-usp { list-style: none; margin: 2.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; color: rgba(255,255,255,0.72); }
  .st-usp li::before { content: '✓'; color: #c4b5f4; margin-right: 0.6rem; }
  .st-omd-scen { position: relative; min-height: 330px; border-radius: 22px; background: #0c0a24; border: 1px solid rgba(255,255,255,0.08); overflow: hidden; }
  .st-citattecken { position: absolute; top: -1.75rem; left: 1.9rem; font-family: 'DM Serif Display', serif; font-size: 13.75rem; line-height: 1; color: rgba(196,181,244,0.12); pointer-events: none; }
  .st-omd-kort { position: absolute; inset: 0; margin: 0; padding: 3.5rem 3.5rem 2.75rem; display: flex; flex-direction: column; justify-content: center; gap: 1.35rem; opacity: 0; transform: translateY(12px); transition: opacity 0.8s ease, transform 0.8s ease; pointer-events: none; }
  .st-omd-kort.is-aktiv { opacity: 1; transform: none; pointer-events: auto; }
  .st-omd-kort blockquote { margin: 0; font-family: 'DM Serif Display', serif; font-size: 1.875rem; line-height: 1.3; color: #fff; }
  .st-omd-kort.is-lang blockquote { font-size: 1.4rem; }
  .st-omd-kort figcaption { font-family: 'Space Grotesk', sans-serif; font-size: 0.875rem; color: rgba(255,255,255,0.6); }
  .st-omd-kort figcaption b { color: #fff; }
  .st-omd-kontroll { display: flex; align-items: center; justify-content: space-between; margin-top: 1rem; gap: 1rem; }
  .st-omd-kontroll .st-prickar { flex-wrap: wrap; }
  .st-pilar { display: flex; gap: 0.6rem; }
  .st-pil { width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.25); background: transparent; color: #fff; cursor: pointer; font-size: 1.1rem; }
  .st-pil-p { border: 0; background: #c4b5f4; color: #0c0a24; }
  .st-pil:hover { border-color: #c4b5f4; }
  .st-pil-p:hover { background: #e2dcfb; }

  /* ── Så funkar det ── */
  .st-sa { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: center; padding-bottom: clamp(3rem, 6vw, 5rem); }
  .st-sa-steg ol { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 2rem; }
  .st-sa-steg li > span { font-family: 'Space Grotesk', sans-serif; font-weight: 700; color: #c4b5f4; }
  .st-sa-steg h3 { margin: 0.4rem 0 0.25rem; font-size: 1.2rem; font-weight: 700; color: #fff; }
  .st-sa-steg p { margin: 0; font-size: 1rem; line-height: 1.5; color: rgba(255,255,255,0.72); }
  .st-film-ram { aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); background: #1e1850; }
  .st-film-not { margin: 0.75rem 0 0; font-size: 0.875rem; color: rgba(255,255,255,0.55); }
  .st-film-not a { color: #c4b5f4; }

  /* ── Slutruta ── */
  .st-cta-wrap { padding-bottom: clamp(3rem, 6vw, 6rem); }
  .st-cta { border-radius: 26px; padding: clamp(1.75rem, 4vw, 3.5rem); background: #c4b5f4; color: #0c0a24; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .st-cta > div:first-child { max-width: 620px; }
  .st-cta h2 { margin: 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(1.9rem, 3.6vw, 2.9rem); line-height: 1.05; color: #0c0a24; }
  .st-cta p { margin: 0.9rem 0 0; font-size: 1.1rem; color: rgba(12,10,36,0.78); }
  .st-cta-knappar { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .st-btn-mork { background: #0c0a24; color: #fff; }
  .st-btn-mork:hover { background: #1e1850; color: #fff; }
  .st-btn-kant { border: 1.5px solid #0c0a24; color: #0c0a24; background: transparent; }
  .st-btn-kant:hover { background: rgba(12,10,36,0.08); color: #0c0a24; }

  /* ── Surfplatta ── */
  @media (max-width: 1100px) {
    .st-kort-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .st-logor-rad { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .st-hero-grid, .st-topp, .st-omd, .st-sa { grid-template-columns: minmax(0, 1fr); }
    .st-hero-fig { aspect-ratio: 4 / 3; order: -1; }
    .st-fakta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st-kort-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st-flikar { flex-direction: row; overflow-x: auto; scrollbar-width: none; margin: 0 calc(-1 * clamp(1rem, 3vw, 2rem)); padding: 0 clamp(1rem, 3vw, 2rem); }
    .st-flikar::-webkit-scrollbar { display: none; }
    .st-flik { flex: none; border-radius: 999px; min-height: 40px; padding: 0 1rem; }
    .st-flik span:last-child { display: none; }
  }

  /* ── Mobil ── */
  @media (max-width: 720px) {
    .st-hero { --st-luft: 0.5rem; }
    .st-hero-fig { border-radius: 16px; }
    .st-hero-cap { left: 0.6rem; right: 0.6rem; bottom: 0.6rem; }
    .st-hero-text-cap { font-size: 0.8rem; }
    .st-prischips { display: none; }
    .st-knappar .st-btn { flex: 1; padding: 0.85rem 0; font-size: 0.95rem; }
    .st-fakta { background: transparent; border: 0; gap: 8px; border-radius: 0; }
    .st-fakta-ruta { border-radius: 12px; background: #1e1850; flex-direction: column; align-items: flex-start; gap: 0.25rem; padding: 0.8rem; font-size: 0.78rem; }
    .st-fakta-n { font-size: 1.6rem; }
    .st-kort-grid { gap: 10px; }
    .st-kort { border-radius: 16px; }
    .st-kort-text { grid-template-rows: auto auto auto; row-gap: 4px; padding: 0 0.75rem 0.75rem; }
    .st-kort-desc, .st-chips { display: none; }
    .st-kort-namn { font-family: 'Source Sans 3', sans-serif; font-weight: 700; font-size: 1.05rem; }
    .st-tag { font-size: 0.62rem; }
    .st-dold { display: none; }
    .st-kort-pris { font-size: 0.75rem; }
    .st-kort-pris b { font-size: 0.9rem; }
    .st-snabbval-rubrik { display: block; margin: 1.25rem 0 0.5rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
    .st-snabbval { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 -1rem; padding: 0 1rem; }
    .st-snabbval::-webkit-scrollbar { display: none; }
    .st-snabbval a { flex: none; font-size: 0.82rem; padding: 0.6rem 0.9rem; }
    .st-rad { grid-template-columns: 22px auto minmax(0, 1fr) 44px; gap: 0.6rem; padding: 0.9rem 0.75rem; }
    .st-rang { font-size: 1.25rem; }
    .st-tummar img { width: 40px; height: 48px; border-radius: 8px; }
    .st-tillfalle { font-size: 0.65rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .st-rad-namn { font-size: 0.95rem; }
    .st-rad-pris { grid-column: 3; grid-row: 2; text-align: left; margin-top: -0.4rem; }
    .st-rad-pris b { font-size: 0.85rem; }
    .st-rad-pris > span { display: inline; margin-left: 0.25rem; }
    .st-rad > :last-child { grid-column: 4; grid-row: 1 / span 2; }
    .st-ref-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; scrollbar-width: none; padding: 0 1rem 4px; }
    .st-ref-grid::-webkit-scrollbar { display: none; }
    .st-ref { flex: none; width: 280px; scroll-snap-align: start; }
    .st-svep { display: block; margin: 0.6rem auto 0; font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; color: rgba(255,255,255,0.55); }
    .st-logor { padding: 1rem; gap: 1rem; }
    .st-logor-rad { flex-basis: 100%; gap: 8px; }
    .st-logor-rad span { aspect-ratio: 1; height: auto; border: 1px solid rgba(196,181,244,0.25); border-radius: 12px; padding: 10px; }
    .st-omd-betyg span:first-child { font-size: 3rem; }
    .st-omd-scen { min-height: 270px; border-radius: 16px; }
    .st-citattecken { font-size: 9rem; left: 1rem; }
    .st-omd-kort { padding: 1.5rem 1.4rem; gap: 0.9rem; }
    .st-omd-kort blockquote { font-size: 1.3rem; }
    .st-omd-kort.is-lang blockquote { font-size: 1.05rem; }
    .st-prick-bred { width: 22px; }
    .st-pilar { display: none; }
    .st-sa-steg ol { grid-template-columns: minmax(0, 1fr); gap: 1.1rem; }
    .st-cta-knappar { flex-direction: column; width: 100%; }
    .st-cta-knappar .st-btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-slide, .st-omd-kort, .st-kort > img, .st-ref img { transition: none; }
  }
</style>

<script>
  import { hamtaRecensioner, hydreraSammanfattning, esc, manad, nyckel } from '../scripts/recensioner-live';

  // Växlar bilder i heron och omdömen var sjätte sekund. Pausar när besökaren
  // håller musen över eller har fokus i sektionen, när fliken inte syns och
  // helt för den som valt minskade animationer.
  const stilla = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Slides och prickar slås upp vid varje byte, och prickarnas klick fångas på
  // roten — då kan omdömena bytas ut när live-listan kommer utan ny växlare.
  function vaxlare(rot: HTMLElement, slides: () => HTMLElement[], prickar: () => HTMLButtonElement[], vidByte?: (i: number) => void) {
    let nu = 0;
    let paus = false;
    const visa = (i: number) => {
      const s = slides();
      if (!s.length) return;
      nu = (i + s.length) % s.length;
      s.forEach((el, j) => {
        el.classList.toggle('is-aktiv', j === nu);
        if (j === nu) el.removeAttribute('aria-hidden'); else el.setAttribute('aria-hidden', 'true');
      });
      prickar().forEach((p, j) => { p.classList.toggle('is-aktiv', j === nu); p.setAttribute('aria-pressed', String(j === nu)); });
      vidByte?.(nu);
    };
    rot.addEventListener('click', (e) => {
      const p = (e.target as HTMLElement).closest<HTMLButtonElement>('.st-prick');
      if (!p) return;
      const j = prickar().indexOf(p);
      if (j >= 0) visa(j);
    });
    rot.addEventListener('mouseenter', () => { paus = true; });
    rot.addEventListener('mouseleave', () => { paus = false; });
    rot.addEventListener('focusin', () => { paus = true; });
    rot.addEventListener('focusout', () => { paus = false; });
    if (!stilla) setInterval(() => { if (!paus && !document.hidden) visa(nu + 1); }, 6000);
    return { visa, nu: () => nu };
  }

  // Hero — bild 2–4 laddas först när sidan är klar, så att första bilden får bandbredden.
  const hero = document.querySelector<HTMLElement>('[data-vaxla="hero"]');
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLImageElement>('.st-slide')];
    const prickar = [...hero.querySelectorAll<HTMLButtonElement>('.st-prick')];
    const text = hero.querySelector<HTMLElement>('.st-hero-text-cap');
    const ladda = () => slides.forEach((im) => {
      if (im.dataset.srcset) { im.srcset = im.dataset.srcset; delete im.dataset.srcset; }
      if (im.dataset.src) { im.src = im.dataset.src; delete im.dataset.src; }
    });
    if (document.readyState === 'complete') ladda(); else window.addEventListener('load', ladda, { once: true });
    vaxlare(hero, () => slides, () => prickar, (i) => { ladda(); if (text) text.textContent = prickar[i]?.dataset.text ?? ''; });
  }

  // Omdömen
  const omd = document.querySelector<HTMLElement>('[data-vaxla="omdomen"]');
  if (omd) {
    const v = vaxlare(omd, () => [...omd.querySelectorAll<HTMLElement>('.st-omd-kort')], () => [...omd.querySelectorAll<HTMLButtonElement>('.st-prick')]);
    omd.querySelectorAll<HTMLButtonElement>('.st-pil').forEach((b) => b.addEventListener('click', () => v.visa(v.nu() + Number(b.dataset.steg))));

    // Live-listan: byt korten bara om den skiljer sig från den inbakade.
    hamtaRecensioner().then((d) => {
      if (!d) return;
      const lista = d.reviews.filter((r) => r.rating >= 5 && r.text && r.text.trim().length > 0);
      const nya = lista.map(nyckel);
      let gamla: string[] = [];
      try { gamla = JSON.parse(omd.dataset.recNycklar || '[]'); } catch { /* bygg om */ }
      if (!lista.length || JSON.stringify(nya) === JSON.stringify(gamla)) return;
      const scen = omd.querySelector<HTMLElement>('.st-omd-scen');
      const grupp = omd.querySelector<HTMLElement>('.st-prickar');
      if (!scen || !grupp) return;
      scen.querySelectorAll('.st-omd-kort').forEach((f) => f.remove());
      scen.insertAdjacentHTML('beforeend', lista.map((r, i) => `
        <figure class="st-omd-kort${i === 0 ? ' is-aktiv' : ''}${r.text.length > 170 ? ' is-lang' : ''}"${i === 0 ? '' : ' aria-hidden="true"'}>
          <span class="st-stjarnor" aria-label="${r.rating} av 5 stjärnor">★★★★★</span>
          <blockquote>${esc(r.text)}</blockquote>
          <figcaption><b>${esc(r.author)}</b> · ${esc(manad(r.publishTime))} · Google</figcaption>
        </figure>`).join(''));
      grupp.innerHTML = lista.map((r, i) => `
        <button type="button" class="st-prick st-prick-bred${i === 0 ? ' is-aktiv' : ''}" data-index="${i}" aria-label="Omdöme från ${esc(r.author)}" aria-pressed="${i === 0}"><span></span></button>`).join('');
      // Startsidans CSS är scopad: nya element måste bära samma data-astro-cid-*
      // som den inbakade markupen, annars får korten och prickarna ingen stil.
      const cid = [...scen.attributes].map((at) => at.name).filter((n) => n.startsWith('data-astro-cid-'));
      const nyaEl = [...scen.querySelectorAll('.st-omd-kort'), ...grupp.children];
      nyaEl.forEach((el) => [el, ...el.querySelectorAll('*')].forEach((x) => cid.forEach((n) => x.setAttribute(n, ''))));
      omd.dataset.recNycklar = JSON.stringify(nya);
      v.visa(0);
    });
  }

  // Antal och snitt i faktaraden och omdömessektionen
  hydreraSammanfattning();

  // Topplistans flikar (piltangenter enligt WAI-ARIA tabs)
  const flikar = [...document.querySelectorAll<HTMLButtonElement>('.st-flik')];
  const valjFlik = (f: HTMLButtonElement, fokus = false) => {
    flikar.forEach((x) => {
      const vald = x === f;
      x.setAttribute('aria-selected', String(vald));
      x.tabIndex = vald ? 0 : -1;
      const panel = document.getElementById(x.getAttribute('aria-controls') || '');
      if (panel) panel.hidden = !vald;
    });
    if (fokus) f.focus();
  };
  flikar.forEach((f, i) => {
    f.addEventListener('click', () => valjFlik(f));
    f.addEventListener('keydown', (e) => {
      const steg = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (steg) { e.preventDefault(); valjFlik(flikar[(i + steg + flikar.length) % flikar.length], true); }
    });
  });

  // Ljud & ljus-raderna: lägg båda produkterna i varukorgen
  document.querySelectorAll<HTMLButtonElement>('.st-par-knapp').forEach((b) => {
    b.addEventListener('click', () => {
      const cart = (window as any).skCart;
      if (!cart) return;
      try { (JSON.parse(b.dataset.par || '[]') as any[]).forEach((item) => cart.add(item)); } catch { return; }
      b.classList.add('is-tillagd');
      setTimeout(() => b.classList.remove('is-tillagd'), 1400);
    });
  });

  // "Fråga Sven" öppnar chatten
  document.querySelectorAll('[data-sven-oppna]').forEach((b) => b.addEventListener('click', () => {
    document.getElementById('sven-toggle')?.click();
  }));
</script>

</Layout>
