    </section>

    <!-- Live Google-recensioner + öppet/stängt-pill: ersätter hårdkodade fallback vid pageload -->
    <script>
      (async function loadKontaktGoogleData() {
        // Recensioner + betygsbadge renderas server-side från src/data/reviews.json.
        // Detta script hämtar ENDAST öppettider för öppet/stängt-pillen.
        const CACHE_KEY = 'sk-google-reviews-v3';
        const CACHE_TTL = 24 * 60 * 60 * 1000;

        const openStatus = document.getElementById('kontakt-open-status');

        let data: any = null;
        try {
          const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null');
          if (cached && cached.expires > Date.now() && cached.data?.ok) data = cached.data;
        } catch (_) { /* ignorera korrupt cache */ }

        if (!data) {
          try {
            const r = await fetch('/api/google-reviews?v=3');
            if (!r.ok) return;
            const json = await r.json();
            if (!json.ok) return;
            data = json;
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify({ data, expires: Date.now() + CACHE_TTL }));
            } catch (_) {}
          } catch (_) { return; }
        }

        // ── Öppet/stängt-pill (klient-side beräkning från veckostatiska periods) ──
        if (openStatus && data.openingHours?.periods?.length > 0) {
          const status = computeOpenStatus(data.openingHours.periods);
          renderOpenStatus(openStatus, status);
        }

        function computeOpenStatus(periods: any[]) {
          // Beräkna mot Europe/Stockholm-tid (server kan vara i annan timezone)
          // Workaround: använd Intl.DateTimeFormat för att få Stockholm-tid
          const fmt = new Intl.DateTimeFormat('sv-SE', {
            timeZone: 'Europe/Stockholm',
            hour: '2-digit', minute: '2-digit', weekday: 'short',
            hour12: false,
          });
          const parts = fmt.formatToParts(new Date());
          const hour = parseInt(parts.find(p => p.type === 'hour')?.value || '0');
          const minute = parseInt(parts.find(p => p.type === 'minute')?.value || '0');
          const weekdayShort = parts.find(p => p.type === 'weekday')?.value || '';
          // sv-SE weekday short: mån, tis, ons, tor, fre, lör, sön
          const dayMap: Record<string, number> = { 'sön': 0, 'mån': 1, 'tis': 2, 'ons': 3, 'tor': 4, 'fre': 5, 'lör': 6 };
          const today = dayMap[weekdayShort.toLowerCase().slice(0, 3)] ?? new Date().getDay();
          const nowMins = hour * 60 + minute;

          // Hitta dagens period(er) — kan finnas flera (lunch closure etc.)
          const todayPeriods = periods.filter(p => p.open?.day === today);

          for (const p of todayPeriods) {
            const openMins = (p.open?.hour || 0) * 60 + (p.open?.minute || 0);
            const closeMins = p.close
              ? (p.close.day === today ? (p.close.hour * 60 + p.close.minute) : 24 * 60)
              : 24 * 60; // 24h-öppet
            if (nowMins >= openMins && nowMins < closeMins) {
              const closeStr = p.close
                ? `${String(p.close.hour).padStart(2, '0')}:${String(p.close.minute || 0).padStart(2, '0')}`
                : 'midnatt';
              return { open: true, message: `Öppet nu — stänger ${closeStr}` };
            }
            // Om vi inte börjat ännu idag
            if (nowMins < openMins) {
              const openStr = `${String(p.open.hour).padStart(2, '0')}:${String(p.open.minute || 0).padStart(2, '0')}`;
              return { open: false, message: `Stängt — öppnar idag ${openStr}` };
            }
          }

          // Inga öppna perioder kvar idag — hitta nästa öppning
          for (let i = 1; i <= 7; i++) {
            const futureDay = (today + i) % 7;
            const futurePeriod = periods.find(p => p.open?.day === futureDay);
            if (futurePeriod) {
              const dayNames = ['söndag', 'måndag', 'tisdag', 'onsdag', 'torsdag', 'fredag', 'lördag'];
              const dayLabel = i === 1 ? 'imorgon' : dayNames[futureDay];
              const openStr = `${String(futurePeriod.open.hour).padStart(2, '0')}:${String(futurePeriod.open.minute || 0).padStart(2, '0')}`;
              return { open: false, message: `Stängt — öppnar ${dayLabel} ${openStr}` };
            }
          }
          return { open: false, message: 'Stängt' };
        }

        function renderOpenStatus(el: HTMLElement, status: { open: boolean; message: string }) {
          const dot = el.querySelector('.status-dot') as HTMLElement;
          const text = el.querySelector('.status-text') as HTMLElement;
          if (dot) dot.style.background = status.open ? '#4ade80' : '#f87171';
          if (text) text.textContent = status.message;
          el.style.color = 'rgba(255,255,255,0.85)';
          el.hidden = false;
        }
      })();
    </script>

    <!-- Leveransområde -->
    <section>
      <h2 class="text-2xl font-bold text-white mb-2" style="font-family:'DM Serif Display',serif">Leveransområde</h2>
      <p class="text-gray-400 mb-6">Vi levererar och hämtar upp utrustning inom ca <strong class="text-white">4 mils radie</strong> från Vällingby — det täcker hela Storstockholm och angränsande kommuner. Längre transporter: kontakta oss för offert.</p>
      <div class="flex flex-wrap gap-2 mb-6">
        {orter.map(o => (
          <span class="text-sm px-3 py-1.5 rounded-full" style="background:#1e1850;border:1px solid rgba(196,181,244,0.2);color:rgba(196,181,244,0.8)">
