          </span>
        ))}
      </div>
      <p class="text-gray-400 text-sm">Leverans debiteras per tur-och-retur och anpassas efter hur skrymmande utrustningen är — från 559 kr enkelresa med vanlig bil upp till större bil, släp eller lastbil för skrymmande gods. Exakt fraktpris bekräftas i offerten. Priser exkl. moms, transport tillkommer alltid utöver hyran.</p>
    </section>

  </div>

  <script>
    // Visa företagsnamn-fältet när "Företag" valts som typ
    (() => {
      const typEl     = document.getElementById('k-typ') as HTMLSelectElement | null;
      const wrap      = document.getElementById('k-foretag-wrap');
      const foretagEl = document.getElementById('k-foretag') as HTMLInputElement | null;
      if (!typEl || !wrap) return;
      const sync = () => {
        const isB2B = typEl.value === 'Företag';
        wrap.style.display = isB2B ? 'block' : 'none';
        if (!isB2B && foretagEl) foretagEl.value = '';
      };
      typEl.addEventListener('change', sync);
      sync();
    })();

    document.getElementById('k-skicka')?.addEventListener('click', async () => {
      const btn = document.getElementById('k-skicka') as HTMLButtonElement;
      const namn     = (document.getElementById('k-namn') as HTMLInputElement)?.value.trim();
      const telefon  = (document.getElementById('k-telefon') as HTMLInputElement)?.value.trim();
      const epost    = (document.getElementById('k-epost') as HTMLInputElement)?.value.trim();
      const meddelande = (document.getElementById('k-meddelande') as HTMLTextAreaElement)?.value.trim();
      const typ      = (document.getElementById('k-typ') as HTMLSelectElement)?.value;
      const foretag  = (document.getElementById('k-foretag') as HTMLInputElement)?.value.trim() || '';
      const gaster   = (document.getElementById('k-gaster') as HTMLInputElement)?.value.trim();
      const datum    = (document.getElementById('k-datum') as HTMLInputElement)?.value;
      const leverans = (document.getElementById('k-leverans') as HTMLSelectElement)?.value || '';
      const hittade  = (document.getElementById('k-hittade') as HTMLSelectElement)?.value;
      const honeypot = (document.getElementById('k-website') as HTMLInputElement)?.value;

      if (!namn || !telefon || !epost || !meddelande) {
        alert('Fyll i namn, telefon, e-post och ditt behov innan du skickar.');
        return;
      }
      if (typ === 'Företag' && !foretag) {
        alert('Fyll i företagsnamn när "Företag" är valt.');
        (document.getElementById('k-foretag') as HTMLInputElement | null)?.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Skickar…';

      try {
        const resp = await fetch('/.netlify/functions/skicka-kontakt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ namn, telefon, epost, meddelande, typ, foretag, gaster, datum, leverans, hittade, honeypot, sendCopy: document.getElementById('sendCopyCheck')?.checked || false }),
        });
        const result = await resp.json();
        if (resp.ok && result.ok) {
          window.location.href = '/tack/';
        } else {
          alert(result.error || 'Något gick fel, försök igen eller ring 072-448 10 00.');
          btn.disabled = false;
          btn.textContent = 'Skicka meddelande';
        }
      } catch {
        alert('Nätverksfel — försök igen eller ring 072-448 10 00.');
        btn.disabled = false;
        btn.textContent = 'Skicka meddelande';
      }
    });
  </script>
</Layout>
