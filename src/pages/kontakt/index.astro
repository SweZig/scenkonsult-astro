---
import Layout from '../../layouts/Layout.astro';
import site from '../../data/site.json';
import { getReviews, getSummary } from '../../utils/reviews';

// Kompletta Google-recensioner (nyaste 3 som teaser); komplett lista på /referenser/
const kontaktReviews = getReviews().slice(0, 3);
const googleSummary = getSummary();

// Maps Embed API-nyckel — om satt används det förbättrade `place`-läget
// med info-kort, annars fallback till basic embed (samma som tidigare).
const MAPS_EMBED_KEY = import.meta.env.PUBLIC_GOOGLE_MAPS_EMBED_API_KEY || '';
const PLACE_ID = 'ChIJuWsoFN2fX0YRzIoYyrIjdEY';
const mapEmbedSrc = MAPS_EMBED_KEY
  ? `https://www.google.com/maps/embed/v1/place?key=${MAPS_EMBED_KEY}&q=place_id:${PLACE_ID}&language=sv&zoom=15`
  : `https://maps.google.com/maps?q=Scenkonsult+Grimstagatan+164+Vällingby&output=embed&hl=sv`;

const orter = [
  "Vällingby","Bromma","Spånga","Järfälla","Kista","Solna","Sundbyberg","Sollentuna",
  "Upplands Väsby","Märsta","Sigtuna","Vallentuna","Täby","Danderyd","Lidingö",
  "Östermalm","Vasastan","Kungsholmen","Södermalm","Hägersten","Skärholmen",
  "Nacka","Värmdö","Österåker","Vaxholm","Ekerö","Huddinge","Botkyrka",
  "Salem","Nykvarn","Södertälje","Haninge","Tyresö","Nynäshamn"
];
---

<Layout
