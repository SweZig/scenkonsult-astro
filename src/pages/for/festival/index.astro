---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventOmraden from '../../../components/event/EventOmraden.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import EventBilder from '../../../components/EventBilder.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import sceneData from '../../../data/scenes.json';
import bildData from '../../../data/bild.json';
import tjanster from '../../../data/tjanster.json';

// Uppslag på artno, aldrig på plats i listan — index pekar fel så fort
// listan sorteras om (projektinstruktionen, Principer).
const byArtno = (lista: any[], artno: string) => lista.find((p: any) => p.artno === artno && p.active !== false);
const liveMedium = byArtno(ljudData.live.products as any[], 'SK-LJD-LIV-0002');
const liveSmall = byArtno(ljudData.live.products as any[], 'SK-LJD-LIV-0001');
const mhBeam = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0014');
const mhWash = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0011');
const scenMedium = byArtno(sceneData.products as any[], 'SK-SCN-0004'); // Scenpaket Medium, 5×2 m
const rokmaskin = byArtno(ljusData.rok.products as any[], 'SK-LJS-ROK-0001');

// Minsta och största scenpaketet räknas ur scenes.json (efter yta), liksom
// gränsen för obligatorisk montering — texten stod tidigare som "från 4×3 m".
const _scenMatt = (sceneData.products as any[]).filter((p: any) => p.active !== false)
  .map((p: any) => { const m = String(p.dimensions ?? '').match(/(\d+)\s*×\s*(\d+)/); return m ? { txt: `${m[1]}×${m[2]} m`, yta: +m[1] * +m[2] } : null; })
  .filter(Boolean)
  .sort((a: any, b: any) => a.yta - b.yta);
const scenMin = _scenMatt[0]?.txt;
const scenMax = _scenMatt[_scenMatt.length - 1]?.txt;
const obligOverM2 = (tjanster as any).montering?.obligatoriskOverM2 ?? 16;
const ledTrailer7 = (bildData.products as any[]).find((p:any) => p.artno === 'SK-BLD-0006');
const ledTrailer15 = (bildData.products as any[]).find((p:any) => p.artno === 'SK-BLD-0011');

import { buildPaket, fmtKr, type PaketDef } from '../../../utils/paket';

const festPaketDefs: (PaketDef | null)[] = [
  {
    namn: 'Liten festival',
    gaster: '100–300 besökare',
    beskrivning: 'Scenpodie, live-PA, PAR och moving heads — plus projektor för en mindre publik.',
    rader: [
      { artno: 'SK-LJD-LIV-0001', label: 'Live Small PA (4 000W)' },
      { artno: 'SK-LJS-EFF-0002', label: 'LED PAR-armatur', qty: 8 },
      { artno: 'SK-LJS-EFF-0014', label: 'Moving Head Beam/Spot', qty: 2 },
      { artno: 'SK-SCN-0001', label: 'Scenpodie 4 m²' },
      { artno: 'SK-BLD-0002', label: 'Projektor Full HD' },
      { artno: 'SK-BLD-ACC-0002', label: 'Projektorduk 100″' },
    ],
  },
  {
    namn: 'Mellanstor festival',
    gaster: '300–700 besökare',
    featured: true,
    beskrivning: 'Större scen, Live Large och ett komplett ljuspaket med moving heads.',
    rader: [
      { artno: 'SK-LJD-LIV-0003', label: 'Live Large PA (15 000W)' },
      { artno: 'SK-LJS-PAK-0007', label: 'Ljuspaket Large (moving heads + PAR)' },
      { artno: 'SK-SCN-0004', label: 'Scenpaket Medium (5×2 m)' },
      { artno: 'SK-BLD-0007', label: 'Projektor 4K UHD' },
      { artno: 'SK-BLD-ACC-0002', label: 'Projektorduk 100″' },
    ],
  },
  null, // Stor festival — offert ("Fullrig — kontakta oss")
];
const festPaket = festPaketDefs.map(d => d ? buildPaket(d) : null);
const festPaketPris = festPaket.filter(Boolean) as ReturnType<typeof buildPaket>[];

const faq = [
  {
    q: "Hur stor scen behöver jag till en festival med 500 besökare?",
    a: "För 500 besökare utomhus rekommenderar vi en scen på minst 6×4 m eller 8×4 m med ett PA på 8 000–15 000 W. Scenstorleken beror på antalet artister och deras backline. Kontakta oss — vi räknar ihop exakt vad ni behöver."
  },
  {
    q: "Kan ni leverera till utomhusfestivaler utan fast ström?",
    a: "Ja, vi kan kombinera vår utrustning med elverksaggregat och batteridrivna system. Vi råder er om elbehov för hela riggen och kan hjälpa er kontakta rätt elverk-leverantör."
  },
  {
    q: "Levererar ni till festivaler utanför Stockholm?",
    a: "Vi levererar primärt i Storstockholm men hanterar även större festivaler i Mälardalsregionen. Kontakta oss med plats och datum för en offert inkl. transport."
  },
  {
    q: "Kan utrustningen användas i regn?",
    a: "All vår utrustning har en IP-klass som tål regn och hög luftfuktighet. Vi rekommenderar alltid vädertält för mixerbord och känsligare elektronik vid längre utomhusarrangemang."
  },
  {
    q: "Ingår tekniker vid festivalhyra?",
    a: "Tekniker kan bokas som tillägg (600 kr/tim). Vid större festivaler med flera scener rekommenderar vi starkt att boka en ljudtekniker — det är skillnad på ett bra och ett fantastiskt ljud."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av scen, ljud och ljus till festival och utomhus-event i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "url": "https://scenkonsult.se/for/festival/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra Scen, Ljud & Ljus till Festival & Utomhus-event Stockholm | Scenkonsult"
  description="Hyr festival-scen, storskaligt PA och ljus till utomhus-event i Stockholm. Event för 100–2000 besökare. Tekniker på plats. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    bild={{ src: "/images/event/festival_vinterviken_2.webp", w: 1400, alt: "Publik framför scenen på festivalen i Vinterviken", text: "Festival — Vinterviken" }}
    knappar={[{ label: "Se festivalpaketen", href: "#paket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="För ditt event · Festival & utomhus"
    h1="Scen & ljud till festival i"
    h1Accent="Stockholm"
    intro="Modulscener, kraftfulla PA-system och robust ljus för utomhus-event och festivaler. Vi har utrustning för 100 till 2 000 besökare och hanterar hela Storstockholm."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Festival & utomhus" }
    ]}
    chips={[
      "Scener upp till 8×6 m",
      "PA-system för 2 000 gäster",
      "Tål utomhusbruk och väder",
      "Tekniker på plats tillgängligt",
    ]}
  />

  <EventOmraden
    eyebrow="Komplett festivalrigg"
    rubrik="Utrustning som håller utomhus"
    lead="Utomhusevent kräver mer effekt, robustare utrustning och en plan för vädret. Vi har gjort allt från stadsfester till stora festivaler."
    omraden={[
      { titel: "Modulscener", text: `Från ${scenMin} upp till ${scenMax}, halkfria ytor. Montering tillkommer och är obligatorisk över ${obligOverM2} m².`, href: "/vara-tjanster/hyra-scen/" },
      { titel: "Festival-PA", text: "Line array och kraftfulla subbasar, dimensionerat efter publik och plats.", href: "/vara-tjanster/hyra-ljud/live/" },
      { titel: "Scenljus", text: "Vädertåliga moving heads, PAR och beam-effekter för kvällen.", href: "/vara-tjanster/hyra-ljus/" },
      { titel: "LED-skärm & projektor", text: "LED-trailers 7–28 m² som syns i dagsljus — projektor och duk för mindre scener.", href: "/vara-tjanster/hyra-bild/" },
    ]}
  />

  <EventPaket
    eyebrow="Storleksguide"
    rubrik="Rätt rigg för ert antal besökare"
    lead="Två färdiga riggar att lägga i varukorgen — större festivaler dimensionerar vi tillsammans."
    paket={festPaketPris}
    offertKort={{ namn: "Stor festival", gaster: "700–2 000 besökare", beskrivning: "Scen upp till 8×6 m, line array, fullrig i ljus och LED-trailer 15–28 m².", rader: ["Scen 8×6 m", "Line array", "Fullrig ljus", "LED-trailer 15–28 m²"] }}
    notis="Priserna är summan av riggens artiklar per dygn. Scen, transport, montering och tekniker tillkommer och offereras separat."
  />

  <ProduktRader
    eyebrow="Populärt till festival & utomhus"
    rubrik="Lägg i varukorgen direkt"
    lead="Kraft och pålitlighet för utomhusarrangemang — välj gärna ett steg upp jämfört med inomhus."
    rader={[
      { produkt: liveSmall, not: "Trubadur och duo", kategori: "Ljud" },
      { produkt: liveMedium, not: "Band och större publik", kategori: "Ljud" },
      { produkt: scenMedium, not: "5×2 m — välj höjd och yta i konfiguratorn", kategori: "Scen" },
      { produkt: mhWash, not: "Färgljus över scen och publik", kategori: "Ljus" },
      { produkt: mhBeam, not: "Strålar som syns på håll", kategori: "Ljus" },
      { produkt: rokmaskin, not: "Gör ljuset synligt", kategori: "Ljus" },
      { produkt: ledTrailer7, not: "Monteras alltid av våra tekniker — tillkommer", kategori: "Bild" },
      { produkt: ledTrailer15, not: "Monteras alltid av våra tekniker — tillkommer", kategori: "Bild" },
    ]}
    lankar={[{ label: "Live PA-system", href: "/vara-tjanster/hyra-ljud/live/" }, { label: "Moving heads", href: "/vara-tjanster/hyra-ljus/moving-heads/" }, { label: "Scener", href: "/vara-tjanster/hyra-scen/" }, { label: "LED-skärm & projektor", href: "/vara-tjanster/hyra-bild/" }]}
  />

  <EventBilder kategori="festival" />

  <EventFaq rubrik="Festival & utomhus — vanliga frågor" faq={faq} extra={'Generösa avbokningsregler — <a href="/hyresvillkor/">läs hyresvillkoren</a>.'} />

  <SlutRuta rubrik="Berätta om er festival — vi föreslår en rigg." />

</Layout>
