---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventOmraden from '../../../components/event/EventOmraden.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import EventChecklista from '../../../components/event/EventChecklista.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import EventBilder from '../../../components/EventBilder.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import sceneData from '../../../data/scenes.json';
import bildData from '../../../data/bild.json';

const evSmall = (ljudData.event.products as any[]).find((p:any) => p.artno === 'SK-LJD-EVE-0001');
const evMedium = (ljudData.event.products as any[]).find((p:any) => p.artno === 'SK-LJD-EVE-0002');
const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const shureHeadset = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0023');
const tradlosHand = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0016');
const mhWash = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0011');
const ljusPaketSmall = (ljusData.paket.products as any[]).find((p:any) => p.artno === 'SK-LJS-PAK-0018');
const scenSmall = (sceneData.products as any[]).find((p:any) => p.artno === 'SK-SCN-0001');

// ---- Bröllopspaket: priser hämtas från live-JSON via artno (delad helper) ----
import { buildPaket3, fmtKr, type PaketDef } from '../../../utils/paket';

const paketDefs: PaketDef[] = [
  {
    namn: 'Bröllop Bas',
    gaster: '50–100 gäster',
    beskrivning: 'Tal, vigsel och bakgrundsmusik med stämningsljus. Allt för en fin fest utan dansgolvsanläggning.',
    rader: [
      { artno: 'SK-LJD-EVE-0001', label: 'PA-system (2× 10″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon — tal' },
      { artno: 'SK-LJD-MIK-0017', label: 'Trådlöst headset — vigsel' },
      { artno: 'SK-LJS-PAK-0001', label: 'Ljuspaket Medium' },
      { artno: 'SK-LJD-MIX-0002', label: 'Mixerbord 4+2 kanaler' },
    ],
  },
  {
    namn: 'Bröllop Komplett',
    gaster: '80–120 gäster',
    beskrivning: 'Vårt populäraste upplägg. Ljud, tal, scen, stämningsljus och effekter för dansgolvet — komplett för hela kvällen.',
    featured: true,
    rader: [
      { artno: 'SK-LJD-EVE-0002', label: 'PA-system (2× 12″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon — tal' },
      { artno: 'SK-LJD-MIK-0023', label: 'Shure SLXD headset — toastmaster' },
      { artno: 'SK-LJS-PAK-0020', label: 'Ljuspaket Small+ (kaleidoskop, laser, strobe)' },
      { artno: 'SK-SCN-0001', label: 'Scenpodie för DJ / trubadur' },
      { artno: 'SK-LJS-EFF-0011', label: 'Moving Head Wash', qty: 2 },
    ],
  },
  {
    namn: 'Bröllop Dansgolv',
    gaster: '120–200 gäster',
    beskrivning: 'Full festanläggning med DJ-ljud, subbasar, scen och rejäl ljussättning. För paret som vill köra dansgolv hela natten.',
    rader: [
      { artno: 'SK-LJD-MUS-0003', label: 'Music Medium (2× 12″ + 2× 12″ sub)' },
      { artno: 'SK-LJD-MIK-0026', label: 'Shure SLXD — 2 handmikrofoner' },
      { artno: 'SK-LJS-PAK-0025', label: 'Ljuspaket Medium++ (T-bar, kaleidoskop, spindelarmatur)' },
      { artno: 'SK-SCN-0002', label: 'Scenpodie 2×3 m för band / DJ' },
      { artno: 'SK-LJS-EFF-0011', label: 'Moving Head Wash', qty: 2 },
      { artno: 'SK-LJS-ROK-0001', label: 'Rökmaskin 1500W' },
      { artno: 'SK-LJD-MIX-0005', label: 'Mixerbord 6+4 kanaler' },
    ],
  },
];

const paket = buildPaket3(paketDefs);
const fmt = fmtKr;

const faq = [
  {
    q: "Hur stor PA-anläggning behöver jag till ett bröllop?",
    a: "För 50–80 gäster inomhus räcker ett Event Small eller Medium-paket. Utomhus dubblas effektbehovet. Vi hjälper dig dimensionera exakt rätt utifrån lokal och antal gäster."
  },
  {
    q: "Kan vi hyra utrustning utan att ha tekniker på plats?",
    a: "Ja, alla våra standardpaket är byggda för självinstallation. Vi går igenom allt vid avhämtning och tillhandahåller instruktioner. Vill du ha tekniker på plats erbjuder vi det som tillägg (600 kr/tim)."
  },
  {
    q: "Behöver vi en scen på ett bröllop?",
    a: "En liten scen (4–6 m²) för trubaduren eller DJ:n ger ett professionellt intryck och skapar tydlig fokuspunkt. Den signalerar till gästerna att det händer saker — och frigör naturligt dansyta framför."
  },
  {
    q: "Vad kostar ett komplett bröllopspaket?",
    a: `Ett komplett paket med ljud, ljus och scen för ${paket[1].gaster} kostar ${fmt(paket[1].franPris)} kr per dygn, och en full festanläggning med dansgolvsljus ${fmt(paket[2].franPris)} kr. Pris beror på utrustning och eventuell leverans. Begär offert så räknar vi ihop exakt.`
  },
  {
    q: "Hur långt i förväg måste vi boka för bröllop?",
    a: "Bröllopssäsongen (maj–september) bokas snabbt. Vi rekommenderar att boka 2–4 månader i förväg för att säkra din dag. Vi hanterar även korta varsel om utrustningen är tillgänglig."
  },
  {
    q: "Kan utrustningen användas utomhus?",
    a: "Ja, all vår utrustning tål normal väta och hög luftfuktighet. Vi rekommenderar alltid väderskydd vid längre utomhusarrangemang och kan råda om rätt lösning för just er plats."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av ljud, ljus och scen till bröllop i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr komplett ljud, ljus och scen till ert bröllop i Stockholm. Leverans, montering och tekniker tillgängligt.",
      "url": "https://scenkonsult.se/for/brollop/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra Ljud, Ljus & Scen till Bröllop i Stockholm | Scenkonsult"
  description="Hyr komplett ljud, ljus och scen till ert bröllop i Stockholm från 399 kr/dygn. Leverans i hela Storstockholm. Tekniker på plats om ni vill. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    bild={{ src: "/images/event/kundevent_lakarforbundet.webp", w: 1050, alt: "Dansgolv och DJ i festvåning hos Läkarförbundet", text: "Läkarförbundet — festvåning, Östermalm" }}
    knappar={[{ label: "Se bröllopspaketen", href: "#paket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="För ditt event · Bröllop"
    h1="Teknik till bröllop i"
    h1Accent="Stockholm"
    intro="Ert bröllop förtjänar perfekt ljud, stämningsfull belysning och en scen som lyfter allt. Vi har levererat till hundratals bröllop sedan 1986 — vi vet vad som fungerar."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Bröllop" }
    ]}
    chips={[
      `Bröllopspaket från ${fmt(Math.min(...paket.map((pk: any) => pk.franPris)))} kr/dygn`,
      "Leverans & montering i Storstockholm",
      "Tekniker på plats tillgängligt",
      "Avbokning fram till 3 dagar innan event*",
    ]}
  />

  <EventOmraden
    eyebrow="Bröllopsteknik"
    rubrik="Rätt teknik gör festen oförglömlig"
    lead="Dåligt ljud förstör talen och fel ljus dödar stämningen. Vi hjälper er välja rätt storlek för er lokal och era gäster."
    omraden={[
      { titel: "Ljud", text: "PA för lokalen och trådlösa mikrofoner till tal, trubadur eller band.", href: "/vara-tjanster/hyra-ljud/" },
      { titel: "Ljus & stämning", text: "Uplights längs väggarna, spotlights på borden och ljus för dansgolvet.", href: "/vara-tjanster/hyra-ljus/" },
      { titel: "Scen & podium", text: "4–6 m² för DJ:n eller trubaduren — en tydlig fokuspunkt.", href: "/vara-tjanster/hyra-scen/" },
      { titel: "Bild & projektion", text: "Lookback-video och bildspel under middagen, på skärm eller duk.", href: "/vara-tjanster/hyra-bild/" },
      { titel: "DJ-utrustning", text: "Controllers och DJ-bord om ni har en DJ ni litar på — eller boka en.", href: "/vara-tjanster/hyra-dj-utrustning/" },
      { titel: "Karaoke", text: "Bygg er karaoke med trådlösa mikrofoner och 80 000+ låtar via Singa.", href: "/vara-tjanster/hyra-karaoke/" },
    ]}
  />

  <EventPaket
    eyebrow="Bröllopspaket"
    rubrik="Välj en utgångspunkt — vi finjusterar tillsammans"
    lead="Varje paket är byggt på riktig utrustning. Lägg det i varukorgen som det är, eller begär offert så justerar vi."
    paket={paket}
    notis="Priserna är summan av paketets artiklar per dygn. Transport, montering och tekniker på plats tillkommer och offereras separat utifrån lokal och upplägg."
  />

  <EventChecklista
    eyebrow="Bröllopschecklista"
    rubrik="Vad behöver ni?"
    lead="Bocka av del för del av dagen. Osäkra? Fråga Sven — han känner sortimentet."
    grupper={[
      { fas: "Tal & vigsel", items: ["Trådlös mikrofon för toastmaster", "Trådlöst headset för prästen/celebranten", "Bluetooth-högtalare för processionsmusik"] },
      { fas: "Middagen", items: ["Bakgrundsmusik i låg volym", "Mikrofon för tal vid bordet", "Skärm eller projektor för lookback-video"] },
      { fas: "Dansgolvet", items: ["PA med subbasar för dansgolvet", "Discoljus, laser och rökmaskin", "DJ-utrustning eller scen för live"] },
    ]}
  />

  <ProduktRader
    eyebrow="Populärt till bröllop"
    rubrik="Lägg i varukorgen direkt"
    lead="Det som oftast hyrs till bröllop, styckvis. Klicka på namnet för mått och specifikationer."
    rader={[
      { produkt: evSmall, not: "Tal och bakgrundsmusik", kategori: "Ljud" },
      { produkt: evMedium, not: "Mer räckvidd för större sällskap", kategori: "Ljud" },
      { produkt: portMedium, not: "Batteridrivet — vigsel utomhus", kategori: "Ljud" },
      { produkt: shureHeadset, not: "Toastmaster och celebrant", kategori: "Ljud" },
      { produkt: tradlosHand, not: "Tal vid bordet", kategori: "Ljud" },
      { produkt: mhWash, not: "Färgljus för dansgolvet", kategori: "Ljus" },
      { produkt: ljusPaketSmall, not: "Stämningsljus på stativ", kategori: "Ljus" },
      { produkt: scenSmall, not: "4 m² för DJ eller trubadur", kategori: "Scen" },
    ]}
    lankar={[{ label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" }, { label: "Moving heads", href: "/vara-tjanster/hyra-ljus/moving-heads/" }, { label: "Alla scener", href: "/vara-tjanster/hyra-scen/" }]}
  />

  <EventBilder kategori="brollop" />

  <EventFaq rubrik="Allt ni undrar om bröllopsteknik" faq={faq} />

  <SlutRuta rubrik="Ert bröllop förtjänar teknik som fungerar." />

</Layout>
