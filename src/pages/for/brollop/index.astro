---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import sceneData from '../../../data/scenes.json';
import bildData from '../../../data/bild.json';

const evSmall = ljudData.event.products[0];
const evMedium = ljudData.event.products[1];
const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const shureHeadset = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0023');
const tradlosHand = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0016');
const mhWash = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0011');
const ljusPaketSmall = ljusData.paket.products[0];
const scenSmall = sceneData.products[0];

// ---- Bröllopspaket: priser hämtas från live-JSON via artno ----
// Bygg en platt uppslagstabell över alla produkter (ljud, ljus, scen)
const _prodIndex: Record<string, any> = {};
function _indexProducts(node: any) {
  if (!node) return;
  if (Array.isArray(node)) { node.forEach(_indexProducts); return; }
  if (typeof node === 'object') {
    if (node.artno && typeof node.price === 'number') _prodIndex[node.artno] = node;
    Object.values(node).forEach(_indexProducts);
  }
}
_indexProducts(ljudData);
_indexProducts(ljusData);
_indexProducts(sceneData);

function P(artno: string) {
  const p = _prodIndex[artno];
  if (!p) throw new Error('Bröllopspaket: saknar artno ' + artno);
  return p;
}

type PaketRad = { artno: string; label: string; qty?: number };
type Paket = {
  namn: string;
  badge: string;
  gaster: string;
  beskrivning: string;
  rader: PaketRad[];
  featured?: boolean;
};

const paketDefs: Paket[] = [
  {
    namn: 'Bröllop Bas',
    badge: 'från ca',
    gaster: '50–100 gäster',
    beskrivning: 'Tal, vigsel och bakgrundsmusik med stämningsljus. Allt för en fin fest utan dansgolvsanläggning.',
    rader: [
      { artno: 'SK-LJD-EVE-0001', label: 'PA-system (2× 10″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon — tal' },
      { artno: 'SK-LJD-MIK-0017', label: 'Trådlöst headset — vigsel' },
      { artno: 'SK-LJS-PAK-0001', label: 'Ljuspaket Small (4× RGB PAR)' },
      { artno: 'SK-LJD-MIX-0002', label: 'Mixerbord 4+2 kanaler' },
    ],
  },
  {
    namn: 'Bröllop Komplett',
    badge: 'från ca',
    gaster: '80–120 gäster',
    beskrivning: 'Vårt populäraste upplägg. Ljud, tal, scen, stämningsljus och effekter för dansgolvet — komplett för hela kvällen.',
    featured: true,
    rader: [
      { artno: 'SK-LJD-EVE-0002', label: 'PA-system (2× 12″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon — tal' },
      { artno: 'SK-LJD-MIK-0023', label: 'Shure SLXD headset — toastmaster' },
      { artno: 'SK-LJS-PAK-0003', label: 'Ljuspaket Small++ (PAR, laser, strobe, UV)' },
      { artno: 'SK-SCN-0001', label: 'Scenpodie för DJ / trubadur' },
      { artno: 'SK-LJS-EFF-0011', label: 'Moving Head Wash', qty: 2 },
    ],
  },
  {
    namn: 'Bröllop Dansgolv',
    badge: 'från ca',
    gaster: '120–200 gäster',
    beskrivning: 'Full festanläggning med DJ-ljud, subbasar, scen och rejäl ljussättning. För paret som vill köra dansgolv hela natten.',
    rader: [
      { artno: 'SK-LJD-MUS-0003', label: 'Music Medium (2× 12″ + 2× 12″ sub)' },
      { artno: 'SK-LJD-MIK-0026', label: 'Shure SLXD — 2 handmikrofoner' },
      { artno: 'SK-LJS-PAK-0004', label: 'Ljuspaket Medium (2 trosstorn + moving heads)' },
      { artno: 'SK-SCN-0002', label: 'Scenpodie 2×3 m för band / DJ' },
      { artno: 'SK-LJS-EFF-0011', label: 'Moving Head Wash', qty: 2 },
      { artno: 'SK-LJS-ROK-0001', label: 'Rökmaskin 1500W' },
      { artno: 'SK-LJD-MIX-0005', label: 'Mixerbord 6+4 kanaler' },
    ],
  },
];

// Räkna ut summa per paket från live-priser och avrunda nedåt till jämn 100-lapp som "från ca"-pris
const paket = paketDefs.map(def => {
  const rader = def.rader.map(r => {
    const p = P(r.artno);
    const qty = r.qty ?? 1;
    return { ...r, qty, name: p.name, unitPrice: p.price, radPrice: p.price * qty };
  });
  const summa = rader.reduce((s, r) => s + r.radPrice, 0);
  const franPris = Math.floor(summa / 100) * 100; // avrunda nedåt till hel 100-lapp
  return { ...def, rader, summa, franPris };
});

const fmt = (n: number) => n.toLocaleString('sv-SE').replace(/\u00A0/g, ' ');

const faq = [
  {
    q: "Hur stor PA-anläggning behöver jag till ett bröllop?",
    a: "För 50–80 gäster inomhus räcker ett Event Small eller Medium-paket. Utomhus dubblas effektbehovet. Vi hjälper dig dimensionera exakt rätt utifrån lokal och antal gäster."
  },
  {
    q: "Kan vi hyra utrustning utan att ha tekniker på plats?",
    a: "Ja, alla våra standardpaket är byggda för självinstallation. Vi går igenom allt vid avhämtning och tillhandahåller instruktioner. Vill du ha tekniker på plats erbjuder vi det som tillägg (600 kr/tim)."
  },
  {
    q: "Behöver vi en scen på ett bröllop?",
    a: "En liten scen (4–6 m²) för trubaduren eller DJ:n ger ett professionellt intryck och skapar tydlig fokuspunkt. Den signalerar till gästerna att det händer saker — och frigör naturligt dansyta framför."
  },
  {
    q: "Vad kostar ett komplett bröllopspaket?",
    a: "Ett komplett paket med ljud, ljus och scen för 80–120 gäster startar från ca 4 100 kr per dygn, och en full festanläggning med DJ-ljud och dansgolvsljus landar runt 5 800 kr. Pris beror på utrustning och eventuell leverans. Begär offert så räknar vi ihop exakt."
  },
  {
    q: "Hur långt i förväg måste vi boka för bröllop?",
    a: "Bröllopssäsongen (maj–september) bokas snabbt. Vi rekommenderar att boka 2–4 månader i förväg för att säkra din dag. Vi hanterar även korta varsel om utrustningen är tillgänglig."
  },
  {
    q: "Kan utrustningen användas utomhus?",
    a: "Ja, all vår utrustning tål normal väta och hög luftfuktighet. Vi rekommenderar alltid väderskydd vid längre utomhusarrangemang och kan råda om rätt lösning för just er plats."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av ljud, ljus och scen till bröllop i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr komplett ljud, ljus och scen till ert bröllop i Stockholm. Leverans, montering och tekniker tillgängligt.",
      "url": "https://scenkonsult.se/for/brollop/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra Ljud, Ljus & Scen till Bröllop i Stockholm | Scenkonsult"
  description="Hyr komplett ljud, ljus och scen till ert bröllop i Stockholm från 399 kr/dygn. Leverans i hela Storstockholm. Tekniker på plats om ni vill. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    eyebrow="För ditt event · Bröllop"
    h1="Teknik till bröllop i"
    h1Accent="Stockholm"
    intro="Ert bröllop förtjänar perfekt ljud, stämningsfull belysning och en scen som lyfter allt. Vi har levererat till hundratals bröllop sedan 1986 — vi vet vad som fungerar."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Bröllop" }
    ]}
    chips={[
      "Bröllopspaket från 2 200 kr/dygn",
      "Leverans & montering i Storstockholm",
      "Tekniker på plats tillgängligt",
      "Avbokning fram till 3 dagar innan event*",
    ]}
  />

  <!-- Varför rätt teknik gör skillnad -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Bröllopsteknik</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.8rem,4vw,2.8rem); color:white; margin:0 0 1.25rem; max-width:700px;">Rätt teknik förvandlar en fin fest till ett oförglömligt ögonblick</h2>
      <p style="color:rgba(255,255,255,0.6); font-size:clamp(0.95rem,2vw,1.1rem); line-height:1.75; max-width:680px; margin:0 0 3rem;">
        Dåligt ljud förstör talen. Fel ljussättning dödar stämningen. En scen som vacklar ger fel signaler. Vi hyr ut utrustning som faktiskt fungerar — och vi hjälper er välja rätt storlek för er lokal och era gäster.
      </p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem;">
        {[
          {
            icon: "🔊",
            title: "Ljud",
            desc: "PA-system dimensionerat för er lokal. Trådlösa mikrofoner för tal, trubadur eller bandet. Kristallklart ljud utan feedback.",
            link: "/vara-tjanster/hyra-ljud/",
            cta: "Se ljudpaket"
          },
          {
            icon: "💡",
            title: "Ljus & stämning",
            desc: "Uplights längs väggarna, spotlights på bordsarrangemangen, dansgolvsbelysning. Rätt ljus sätter hela stämningen.",
            link: "/vara-tjanster/hyra-ljus/",
            cta: "Se ljuspaket"
          },
          {
            icon: "🎭",
            title: "Scen & podium",
            desc: "En liten 4–6 m² scen för DJ:n eller trubaduren. Professionell känsla och tydlig fokuspunkt för gästerna.",
            link: "/vara-tjanster/hyra-scen/",
            cta: "Se scener"
          },
          {
            icon: "📽",
            title: "Bild & projektion",
            desc: "Lookback-video under middagen, slideshow med barndomsbilder, projektion av första-dansen-foton. Skärm eller projektor & duk för minnesvärda inslag.",
            link: "/vara-tjanster/hyra-bild/",
            cta: "Se bildlösningar"
          },
          {
            icon: "🎧",
            title: "DJ-utrustning",
            desc: "Pioneer XDJ-RX3, CDJ-3000 eller kompakta kontroller. Hyr professionell DJ-utrustning om ni har en DJ ni litar på.",
            link: "/vara-tjanster/hyra-dj/",
            cta: "Se DJ-utrustning"
          },
          {
            icon: "🎤",
            title: "Karaoke",
            desc: "Komplement till middagen eller efter dansen — sex färdiga karaokepaket med 80 000+ låtar via Singa. Trådlösa mikar, sångtexter på skärm.",
            link: "/vara-tjanster/hyra-karaoke/",
            cta: "Se karaokepaket"
          }
        ].map(item => (
          <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:1.75rem; display:flex; flex-direction:column; gap:0.75rem; transition:border-color 0.2s;" 
               onmouseenter="this.style.borderColor='rgba(196,181,244,0.35)'" 
               onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)'">
            <div style="font-size:1.75rem;">{item.icon}</div>
            <h3 style="font-family:'DM Serif Display',serif; font-size:1.25rem; color:white; margin:0;">{item.title}</h3>
            <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.65; margin:0; flex:1;">{item.desc}</p>
            <a href={item.link} style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; text-decoration:none; margin-top:0.25rem;">
              {item.cta} →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Checklista / Rekommenderad setup -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div class="g2c" style="max-width:1100px; margin:0 auto;">
      <div>
        <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Bröllopschecklista</p>
        <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 1.5rem;">Vad behöver ni till bröllopet?</h2>

        {[
          { fas: "Ljud för tal & tal", items: ["Trådlös mikrofon för toastmaster", "PA-system för 50–200 gäster", "Monitor så artisten hör sig själv"] },
          { fas: "Ceremonin", items: ["Bluetooth-högtalare för processionsmusik", "Trådlöst headset för prästen/celebranten"] },
          { fas: "Middagen", items: ["Bakgrundsmusik i låg volym", "Mikrofon för tal vid bordet", "Skärm eller projektor för lookback-video / barndomsbilder"] },
          { fas: "Dansgolvet", items: ["PA med subbasar för dansgolvet", "Discoljus, laser och rökmaskin", "DJ-utrustning eller scen för live"] }
        ].map(block => (
          <div style="margin-bottom:1.5rem;">
            <h3 style="font-family:'Space Grotesk',sans-serif; font-size:0.85rem; font-weight:700; color:#c4b5f4; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 0.6rem;">{block.fas}</h3>
            {block.items.map(item => (
              <div style="display:flex; align-items:center; gap:0.6rem; padding:0.4rem 0; border-bottom:1px solid rgba(255,255,255,0.05);">
                <span style="color:#86efac; font-size:0.8rem;">✓</span>
                <span style="color:rgba(255,255,255,0.65); font-size:0.9rem;">{item}</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div>
        <div style="background:#1e1850; border:1px solid rgba(196,181,244,0.2); border-radius:16px; padding:2rem;">
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.4rem; color:white; margin:0 0 1rem;">Tre färdiga bröllopspaket</h3>
          <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.65; margin:0 0 1.25rem;">Vi har satt ihop tre utgångslägen — från enkelt taluppägg till full festanläggning. Alla går att justera fritt i dialog med oss så att det passar er lokal, er gästlista och er budget.</p>
          {paket.map(pk => (
            <div style="display:flex; justify-content:space-between; align-items:baseline; padding:0.7rem 0; border-bottom:1px solid rgba(255,255,255,0.07);">
              <span style="color:white; font-size:0.9rem; font-weight:600;">{pk.namn}<span style="color:rgba(255,255,255,0.4); font-weight:400; font-size:0.8rem;"> · {pk.gaster}</span></span>
              <span style="color:#c4b5f4; font-size:0.95rem; font-weight:700; white-space:nowrap;"><span data-exkl={pk.franPris}>{fmt(pk.franPris)}</span> kr</span>
            </div>
          ))}
          <p style="color:rgba(255,255,255,0.55); font-size:0.75rem; margin:1rem 0 0;">Priser per dygn. Leverans, montering och tekniker tillkommer — offereras separat.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tre bröllopspaket -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Bröllopspaket</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 0.75rem;">Välj en utgångspunkt — vi finjusterar tillsammans</h2>
      <p style="color:rgba(255,255,255,0.55); font-size:0.95rem; line-height:1.7; max-width:680px; margin:0 0 2.5rem;">Varje paket är ett konkret förslag byggt på riktig utrustning. Inget är hugget i sten — lägg till, byt ut eller dra ifrån i offertdialogen så hittar vi rätt nivå för just er dag.</p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:1.5rem; align-items:stretch;">
        {paket.map(pk => (
          <div style={`background:#1e1850; border:1px solid ${pk.featured ? 'rgba(196,181,244,0.5)' : 'rgba(255,255,255,0.08)'}; border-radius:16px; padding:1.85rem; display:flex; flex-direction:column; position:relative;`}>
            {pk.featured && (
              <span style="position:absolute; top:-0.7rem; left:1.85rem; background:#c4b5f4; color:#0c0a24; font-family:'Space Grotesk',sans-serif; font-size:0.65rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; padding:0.25rem 0.7rem; border-radius:999px;">Populärast</span>
            )}
            <h3 style="font-family:'DM Serif Display',serif; font-size:1.5rem; color:white; margin:0 0 0.25rem;">{pk.namn}</h3>
            <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.75rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; margin:0 0 0.9rem;">{pk.gaster}</p>
            <p style="color:rgba(255,255,255,0.6); font-size:0.88rem; line-height:1.6; margin:0 0 1.25rem;">{pk.beskrivning}</p>

            <div style="border-top:1px solid rgba(255,255,255,0.1); padding-top:1rem; margin-bottom:1.25rem; flex:1;">
              {pk.rader.map(r => (
                <div style="display:flex; justify-content:space-between; align-items:baseline; gap:0.75rem; padding:0.4rem 0;">
                  <span style="color:rgba(255,255,255,0.72); font-size:0.85rem; line-height:1.4;">
                    {r.qty > 1 && <span style="color:#c4b5f4; font-weight:700;">{r.qty}× </span>}{r.label}
                  </span>
                  <span style="color:rgba(255,255,255,0.45); font-size:0.8rem; white-space:nowrap;"><span data-exkl={r.radPrice}>{fmt(r.radPrice)}</span> kr</span>
                </div>
              ))}
            </div>

            <div style="border-top:1px solid rgba(196,181,244,0.2); padding-top:1rem;">
              <div style="display:flex; justify-content:space-between; align-items:baseline;">
                <span style="color:rgba(255,255,255,0.5); font-size:0.85rem;">Från ca</span>
                <span style="font-family:'DM Serif Display',serif; font-size:1.7rem; color:#c4b5f4;"><span data-exkl={pk.franPris}>{fmt(pk.franPris)}</span> kr</span>
              </div>
              <p style="color:rgba(255,255,255,0.45); font-size:0.72rem; margin:0.25rem 0 0;">/dygn · exkl. leverans &amp; montering</p>
            </div>

            <a href="/bokningssida/" style={`display:block; margin-top:1.25rem; background:${pk.featured ? '#c4b5f4' : 'transparent'}; color:${pk.featured ? '#0c0a24' : '#c4b5f4'}; border:1px solid #c4b5f4; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase; text-decoration:none; padding:0.8rem 1.5rem; border-radius:4px; text-align:center; transition:all 0.2s;`} onmouseenter={`this.style.background='#e2dcfb'; this.style.color='#0c0a24'; this.style.borderColor='#e2dcfb'`} onmouseleave={`this.style.background='${pk.featured ? '#c4b5f4' : 'transparent'}'; this.style.color='${pk.featured ? '#0c0a24' : '#c4b5f4'}'; this.style.borderColor='#c4b5f4'`}>
              Begär offert på detta paket
            </a>
          </div>
        ))}
      </div>

      <p style="color:rgba(255,255,255,0.4); font-size:0.8rem; line-height:1.6; margin:2rem 0 0; max-width:680px;">Angivna priser är ungefärliga utgångspriser per dygn räknat på paketets innehåll. Växla mellan exkl. och inkl. moms längst ner till vänster. Transport, montering och tekniker på plats tillkommer alltid och offereras separat utifrån lokal och upplägg.</p>
    </div>
  </section>


  <!-- Rekommenderade produkter -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Populärt till bröllop</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 0.75rem;">Lägg till i varukorgen direkt</h2>
