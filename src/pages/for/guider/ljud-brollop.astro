---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ljudData from '../../../data/ljud.json';

const evSmall    = ljudData.event.products[0];   // SK-LJD-EVE-0001
const evMedium   = (ljudData.event.products as any[]).find((p:any) => p.artno === 'SK-LJD-EVE-0002');
const portMed    = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const musicSmall = ljudData.music.products[0];   // SK-LJD-MUS-0001
const liveSmall  = ljudData.live.products[0];    // SK-LJD-LIV-0001
const liveMedium = (ljudData.live.products as any[]).find((p:any) => p.artno === 'SK-LJD-LIV-0002');
const shureHS    = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0023');
const shureMygga = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0022');
const tradlos    = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0016');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Hur mycket ljud behöver man till ett bröllop?", "acceptedAnswer": { "@type": "Answer", "text": "För 50–80 gäster inomhus räcker Event Small (2 toppar, ingen sub). Ska det dansdas är Event Medium med subwoofer rätt. Utomhus: välj alltid ett steg upp. Vi hjälper er dimensionera gratis." } },
    { "@type": "Question", "name": "Vilken mikrofon passar till bröllopstalet?", "acceptedAnswer": { "@type": "Answer", "text": "Trådlöst headset (Shure SLXD) för toastmaster och celebrant — händerna är fria och mikrofonen sitter stabilt nära munnen. Trådlös handmikrofon passar den som föredrar att hålla i något. Båda ger kristallklart ljud utan rundgång." } },
    { "@type": "Question", "name": "Kan man hyra ljud till bröllop utan tekniker?", "acceptedAnswer": { "@type": "Answer", "text": "Ja — alla våra standardpaket är byggda för självinstallation. Vi går igenom allt vid utlämning och finns tillgängliga på telefon under hela evenemanget. Vill ni ha tekniker på plats erbjuder vi det som tillägg." } },
    { "@type": "Question", "name": "Vad kostar det att hyra ljud till ett bröllop?", "acceptedAnswer": { "@type": "Answer", "text": "Ett PA-system för 50–100 gäster kostar 799–1 199 kr/dygn. Lägg till trådlös mikrofon (400–749 kr) och eventuell leverans. Räkna totalt 1 500–3 000 kr för ett komplett ljudupplägg till ett medelstort bröllop." } },
    { "@type": "Question", "name": "Ska man välja kolumnhögtalare eller PA på stativ till bröllopet?", "acceptedAnswer": { "@type": "Answer", "text": "Kolumnhögtalare (t.ex. Alto TS108C) är diskreta, snygga och ger jämn ljudspridning — perfekta för vigsel och mingel. PA på stativ ger mer kraft och passar bättre om det ska dansdas. Många bröllop kombinerar: kolumn under middagen, PA på stativ under festen." } }
  ]
};
---
<Layout
  title="Ljud till Bröllop Stockholm — Guide & Priser 2026 | Scenkonsult"
  description="Hur mycket ljud behöver du till bröllopet? Guide till PA-system, mikrofoner och ljud för vigsel, middag och dansgolv. Priser från 799 kr/dygn."
  schemaExtra={faqSchema}
>
  <nav class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-2" style="padding-top:calc(var(--nav-offset,166px) + 1.5rem)" aria-label="Brödsmulor">
    <ol class="flex flex-wrap gap-1.5 text-xs text-gray-500">
      <li><a href="/" class="hover:text-brand-orange transition-colors">Hem</a></li>
      <li class="before:content-['/'] before:mx-1.5"><a href="/for/" class="hover:text-brand-orange transition-colors">För ditt event</a></li>
      <li class="before:content-['/'] before:mx-1.5"><a href="/for/guider/" class="hover:text-brand-orange transition-colors">Guider</a></li>
      <li class="before:content-['/'] before:mx-1.5 text-gray-400">Ljud till bröllop</li>
    </ol>
  </nav>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">

    <header style="margin-bottom:3rem;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Guide</p>
      <h1 style="font-family:'DM Serif Display',serif; font-size:clamp(2rem,5vw,3.2rem); color:white; line-height:1.15; margin:0 0 1.25rem;">Ljud till bröllop — vad behöver man egentligen?</h1>
      <p style="color:rgba(255,255,255,0.6); font-size:1.05rem; line-height:1.8;">Från processionsmusik under vigseln till dansgolvet sent på kvällen — ljudbehovet varierar under ett bröllop. Den här guiden hjälper dig välja rätt system för varje del av dagen.</p>
    </header>

    <!-- De tre faserna -->
    <section style="margin-bottom:3rem;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.4rem,3vw,2rem); color:white; margin:0 0 1.5rem;">Bröllopets tre ljudfaser</h2>
      {[
        { fas: "1. Vigseln", icon: "💍", desc: "Diskret bakgrundsmusik och tydlig förstärkning av prästens/officiantens röst. Kolumnhögtalare är idealiska — de smälter in i miljön och ger jämn spridning utan stativ.", rec: "Kolumnhögtalare + 1 trådlöst headset", pris: "ca 1 500 kr/dygn" },
        { fas: "2. Middagen", icon: "🥂", desc: "Bakgrundsmusik i behaglig volym + tydliga mikrofoner för toastmaster och tal. Mikrofonen är viktigare än PA-effekten — investera i bra trådlös mikrofon.", rec: "PA-system + 1–2 trådlösa mikrofoner", pris: "ca 1 200–2 000 kr/dygn" },
        { fas: "3. Dansgolvet", icon: "🎉", desc: "Nu behövs kraft och bas. Välj PA med subwoofer. Lägg till discoljus och moving heads för att kicka igång dansgolvet.", rec: "PA med sub + discoljus", pris: "ca 2 500–5 000 kr/dygn" }
      ].map(f => (
        <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:1.5rem; margin-bottom:1rem; display:flex; gap:1rem;">
          <div style="font-size:1.75rem; flex-shrink:0;">{f.icon}</div>
          <div>
            <h3 style="font-family:'Space Grotesk',sans-serif; font-weight:700; color:white; margin:0 0 0.4rem;">{f.fas}</h3>
            <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.6; margin:0 0 0.75rem;">{f.desc}</p>
            <div style="display:flex; gap:1.5rem; flex-wrap:wrap;">
              <span style="color:#c4b5f4; font-size:0.82rem; font-family:'Space Grotesk',sans-serif;">✓ {f.rec}</span>
              <span style="color:rgba(255,255,255,0.35); font-size:0.82rem;">{f.pris}</span>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Storleksguide -->
    <section style="margin-bottom:3rem;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.4rem,3vw,2rem); color:white; margin:0 0 1.25rem;">Välj rätt storlek</h2>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:0.87rem;">
          <thead><tr style="border-bottom:2px solid rgba(196,181,244,0.25);">
            {["Gäster","Lokal","Rekommendation","Pris/dygn"].map(h => <th style="text-align:left;padding:0.75rem 0.5rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.08em;">{h}</th>)}
          </tr></thead>
          <tbody>
            {[
              { g:"20–50",   l:"Inomhus",        r:"Portable Medium (kolumn)",          p:portMed.price,  range:false },
              { g:"50–100",  l:"Inomhus",        r:"Event Small",                       p:evSmall.price,  range:false },
              { g:"80–150",  l:"Inomhus m. dans",r:"Event Medium (med sub)",            p:evMedium.price, range:false },
              { g:"50–100",  l:"Utomhus",        r:"Event Medium",                      p:evMedium.price, range:false },
              { g:"100–200", l:"Utomhus",        r:"Music Small el. Live Medium",       p:musicSmall.price, p2:liveMedium.price, range:true },
            ].map(({ g, l, r, p, p2, range }, i) => (
              <tr style={`border-bottom:1px solid rgba(255,255,255,0.06);background:${i%2===0?'transparent':'rgba(255,255,255,0.02)'}`}>
                <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;white-space:nowrap;">{g}</td>
                <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.5);">{l}</td>
                <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.8);">{r}</td>
                <td style="padding:0.75rem 0.5rem;color:#c4b5f4;font-weight:600;white-space:nowrap;">
                  {range
                    ? <><span class="sk-price-excl">{p}–{p2}</span><span class="sk-price-incl hidden">{Math.round(p*1.25)}–{Math.round((p2??0)*1.25)}</span></>
                    : <><span class="sk-price-excl">{p}</span><span class="sk-price-incl hidden">{Math.round(p*1.25)}</span></>
                  } kr
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Mikrofontips -->
    <section style="margin-bottom:3rem;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.4rem,3vw,2rem); color:white; margin:0 0 1rem;">Mikrofon till bröllop — tre alternativ</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem;">
        {[
          { typ: "Trådlöst headset", passar: "Toastmaster, celebrant, musiker", pExcl: shureHS.price, pros: "Händerna fria, sitter stabilt, professionellt" },
          { typ: "Trådlös handmikrofon", passar: "Talare, sångare", pExcl: tradlos.price, pros: "Enkel att använda, ingen installation" },
          { typ: "Trådlös myggmikrofon", passar: "Präst/officiant, konferencier", pExcl: shureMygga.price, pros: "Knappt synlig, kräver inga händer" },
        ].map(m => (
          <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:1.25rem;">
            <div style="color:white; font-weight:700; font-family:'Space Grotesk',sans-serif; margin-bottom:0.4rem;">{m.typ}</div>
            <div style="color:rgba(255,255,255,0.45); font-size:0.82rem; margin-bottom:0.5rem;">Passar: {m.passar}</div>
            <div style="color:#c4b5f4; font-size:0.85rem; font-weight:600; margin-bottom:0.5rem;"><span class="sk-price-excl">{m.pExcl}</span><span class="sk-price-incl hidden">{Math.round(m.pExcl*1.25)}</span> kr/dygn</div>
            <div style="color:rgba(255,255,255,0.55); font-size:0.82rem;">✓ {m.pros}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Produktkort -->
    <section style="margin-bottom:3rem;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.4rem,3vw,2rem); color:white; margin:0 0 1.25rem;">Populärt till bröllop</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <ProductCard artno={evSmall.artno} name={evSmall.name} price={evSmall.price} priceNote="/dygn" image={evSmall.image} alt={evSmall.name} description={evSmall.description} persons={evSmall.persons} specs={evSmall.includes} category="Ljud" />
        <ProductCard artno={portMed.artno} name={portMed.name} price={portMed.price} priceNote="/dygn" image={portMed.image} alt={portMed.name} description={portMed.description} persons={portMed.persons} specs={portMed.includes} category="Ljud" />
        <ProductCard artno={shureHS.artno} name={shureHS.name} price={shureHS.price} priceNote="/dygn" image={shureHS.image} alt={shureHS.name} description={shureHS.description ?? shureHS.desc} specs={shureHS.specs ?? shureHS.includes ?? []} category="Mikrofon" />
        <ProductCard artno={tradlos.artno} name={tradlos.name} price={tradlos.price} priceNote="/dygn" image={tradlos.image} alt={tradlos.name} description={tradlos.description ?? tradlos.desc} specs={tradlos.specs ?? []} category="Mikrofon" />
      </div>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/for/brollop/" class="inline-block border border-white/20 hover:border-brand-orange/40 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">Mer om bröllopsteknik →</a>
        <a href="/vara-tjanster/hyra-ljud/" class="inline-block border border-white/20 hover:border-brand-orange/40 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">Alla ljudpaket →</a>
        <a href="/vara-tjanster/hyra-ljud/kolumnhogtalare/" class="inline-block border border-white/20 hover:border-brand-orange/40 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">Kolumnhögtalare →</a>
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom:3rem;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.4rem,3vw,2rem); color:white; margin:0 0 1.5rem;">Vanliga frågor</h2>
      <div>
        {faqSchema.mainEntity.map((f:any) => (
          <details style="border-bottom:1px solid rgba(255,255,255,0.07);">
            <summary style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem 0; cursor:pointer; list-style:none; color:white; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:0.97rem; gap:1rem;">
              {f.name}
              <span style="color:#c4b5f4; font-size:1.25rem; flex-shrink:0;">+</span>
            </summary>
            <p style="color:rgba(255,255,255,0.6); font-size:0.95rem; line-height:1.75; margin:0 0 1.25rem; padding-right:2rem;">{f.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div style="background:linear-gradient(135deg,#1e1850,#0c0a24); border:1px solid rgba(196,181,244,0.2); border-radius:16px; padding:2rem; text-align:center;">
      <h2 style="font-family:'DM Serif Display',serif; font-size:1.5rem; color:white; margin:0 0 0.5rem;">Osäker på vad ni behöver?</h2>
      <p style="color:rgba(255,255,255,0.55); font-size:0.95rem; margin:0 0 1.5rem;">Ring oss — vi dimensionerar rätt utan kostnad. 072-448 10 00, mån–fre 09–17.</p>
      <a href="/for/brollop/" style="background:#c4b5f4; color:#0c0a24; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.85rem; letter-spacing:0.08em; text-decoration:none; padding:0.85rem 2rem; border-radius:8px; display:inline-block;">Begär offert till ert bröllop</a>
    </div>

  </article>

  <!-- Relaterade guider -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <p style="color:rgba(255,255,255,0.35);font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.75rem;">Relaterade guider</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <a href="/for/guider/ljus-brollop/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">Ljus till bröllop →</a>
        <a href="/for/guider/dj-brollop-pris/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">DJ till bröllop — pris →</a>
        <a href="/for/guider/hyra-tradlos-mikrofon/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">Hyra trådlös mikrofon →</a>
    </div>
  </div>

</Layout>
