---
import Layout from '../../../layouts/Layout.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import sceneData from '../../../data/scenes.json';
import djData from '../../../data/dj.json';
import fraktData from '../../../data/tjanster.json';

// Prisuppslag — alltid synkat med JSON
const _lp = [
  ...ljudData.event.products,
  ...(ljudData.portable.products as any[]),
  ...ljudData.music.products,
  ...ljudData.live.products,
  ...((ljudData as any).mixers ?? []),
  ...(ljudData.tillbehor_mikrofon as any[]),
];
const _jp = (ljusData.paket.products as any[]);
const _je = (ljusData.effekter.products as any[]);
const _jr = (ljusData.rok.products as any[]);
const _sp = [...(sceneData.products as any[]), ...((sceneData as any).accessories ?? [])];
const _dp = [...(((djData as any).equipment) ?? []), ...(((djData as any).packages) ?? [])];

const lp = (artno: string) => _lp.find(x => x.artno === artno)?.price ?? 0;
const jp = (artno: string) => [..._jp,..._je,..._jr].find((x:any) => x.artno === artno)?.price ?? 0;
const sp = (artno: string) => _sp.find(x => x.artno === artno)?.price ?? 0;
const dp = (artno: string) => _dp.find((x:any) => x.artno === artno)?.price ?? 0;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Vad kostar det att hyra scen, ljud och ljus? Prisguide 2026","author":{"@type":"Organization","name":"Scenkonsult Norden"},"datePublished":"2025-01-01","dateModified":"2026-04-16","url":"https://scenkonsult.se/for/guider/vad-kostar-det/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Vad kostar det att hyra scen i Stockholm?","acceptedAnswer":{"@type":"Answer","text":"Scenpaket Small (4 m²): 599 kr/dygn. Medium (10 m²): 1 499 kr/dygn. Large (20 m²): 2 999 kr/dygn. XL (36 m²): 5 399 kr/dygn. Priser exkl. moms. Transport tillkommer."}},{"@type":"Question","name":"Vad kostar det att hyra ljud till en fest med 100 gäster?","acceptedAnswer":{"@type":"Answer","text":"Music Small (999 kr/dygn) täcker 20–80 pers. med dans och subwoofer. Music Medium (1 499 kr/dygn) täcker 60–120 pers. Priser exkl. moms och transport."}},{"@type":"Question","name":"Vad kostar det att hyra ljus till ett event?","acceptedAnswer":{"@type":"Answer","text":"Ljuspaket Small (10–30 pers.): 399 kr/dygn. Ljuspaket Medium (40–80 pers.): 1 199 kr/dygn. Ljuspaket XL (100–250 pers.): 5 999 kr/dygn. Priser exkl. moms."}},{"@type":"Question","name":"Vad kostar leverans av scen och ljud i Stockholm?","acceptedAnswer":{"@type":"Answer","text":"Leverans med vanlig bil kostar 1 118 kr (tur och retur). Bil med släpvagn 1 598 kr. Avhämtning i Vällingby är alltid gratis. Priser exkl. moms."}},{"@type":"Question","name":"Vad kostar ett komplett paket med scen, ljud och ljus?","acceptedAnswer":{"@type":"Answer","text":"Liten fest 50 pers.: ca 1 200 kr/dygn. Bröllop 100 pers.: ca 3 500 kr/dygn. Företagsfest 200 pers.: ca 7 500 kr/dygn. Är det billigare att hämta själv?","acceptedAnswer":{"@type":"Answer","text":"Ja — avhämtning i Vällingby är alltid gratis. Spara leveranskostnaden om ni har lämpligt fordon."}}},{"@type":"Question","name":"Är det billigare att hämta scen och ljud själv?","acceptedAnswer":{"@type":"Answer","text":"Ja — avhämtning i Vällingby är alltid gratis. Spara 1 118 kr om ni har lämpligt fordon. Monteringstjänst kan alltid läggas till separat."}}]}]};
const paket = [
  {title:"Liten fest, ~50 gäster", rows:[
    {kat:"Ljud", prod:"Portable Medium",            p:lp("SK-LJD-POR-0003"), l:"/vara-tjanster/hyra-ljud/portable/"},
    {kat:"Ljus", prod:"Ljuspaket Small",            p:jp("SK-LJS-PAK-0001"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Hämta själv = 0 kr transport"},
  {title:"Bröllop, ~100 gäster", rows:[
    {kat:"Ljud", prod:"Music Small",                p:lp("SK-LJD-MUS-0001"), l:"/vara-tjanster/hyra-ljud/music/"},
    {kat:"Scen", prod:"Scenpaket Small+ (6 m²)",    p:sp("SK-SCN-0002"),     l:"/vara-tjanster/hyra-scen/"},
    {kat:"Scen", prod:"Scentrapp 60 cm",            p:sp("SK-SCN-ACC-0002"), l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus", prod:"Ljuspaket Medium",           p:jp("SK-LJS-PAK-0004"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Transport och montering tillkommer"},
  {title:"Företagsfest, ~200 gäster", rows:[
    {kat:"Ljud",  prod:"Music Large",               p:lp("SK-LJD-MUS-0004"), l:"/vara-tjanster/hyra-ljud/music/"},
    {kat:"Mixer", prod:"Mixerbord 12+4 kanaler",    p:lp("SK-LJD-MIX-0006"), l:"/vara-tjanster/hyra-ljud/event/"},
    {kat:"Scen",  prod:"Scenpaket Medium++ (16 m²)",p:sp("SK-SCN-0007"),     l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus",  prod:"Ljuspaket Medium++",        p:jp("SK-LJS-PAK-0006"), l:"/vara-tjanster/hyra-ljus/"},
    {kat:"DJ",    prod:"Denon Prime 4+",            p:dp("SK-DJ-0003"),      l:"/vara-tjanster/hyra-dj/"},
  ], note:"Transport och montering tillkommer"},
  {title:"Festival, ~500 gäster utomhus", rows:[
    {kat:"Ljud", prod:"Live/Music XL+",             p:lp("SK-LJD-MUS-0006"), l:"/vara-tjanster/hyra-ljud/music/"},
    {kat:"Scen", prod:"Scenpaket Large+ inkl. scentak", p:sp("SK-SCN-0010"), l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus", prod:"Ljuspaket Medium++",         p:jp("SK-LJS-PAK-0006"), l:"/vara-tjanster/hyra-ljus/"},
    {kat:"Rök",  prod:"Rökmaskin 1500W",            p:jp("SK-LJS-ROK-0001"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Kontakta oss för festivalpris"},
].map(pak => ({...pak, total: pak.rows.reduce((s, r) => s + (r.p ?? 0), 0)}));
const sparTips = [
  {t:"Hämta själv",d:"Avhämtning är alltid gratis. Spara leveranskostnaden om ni har lämpligt fordon."},
  {t:"Helg = 1 dygn",d:"Hyr fredag, lämna tillbaka måndag — betala ett dygn om utrustningen inte är bokad."},
  {t:"Installera själv",d:"Standardpaket är byggda för enkel installation. Spara monteringskostnaden på enkla rigg."},
  {t:"Boka i förväg",d:"Populära helger (maj–sept) tar slut. Boka 4–8 veckor i förväg för bäst urval."},
];
---
<Layout title="Vad Kostar det att Hyra Scen, Ljud & Ljus? Prisguide 2026 | Scenkonsult" description="Exakta priser ur vårt sortiment för PA, scen, ljus och DJ-utrustning. Exempelpaket för bröllop, företagsfest och festival. Scenkonsult sedan 1986." schemaExtra={schema}>
  <div style="background:linear-gradient(135deg,#1e1850 0%,#0c0a24 60%);padding-top:calc(36px + 130px + clamp(2rem,4vw,3.5rem));padding-bottom:clamp(2.5rem,5vw,4rem);padding-inline:clamp(1rem,5vw,5rem);">
    <div style="max-width:820px;margin:0 auto;">
      <nav aria-label="Brödsmulor" style="margin-bottom:1.5rem;"><ol style="display:flex;flex-wrap:wrap;gap:0.35rem;list-style:none;margin:0;padding:0;font-size:0.78rem;color:rgba(255,255,255,0.4);"><li><a href="/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Hem</a> <span style="opacity:0.3;">/</span></li><li><a href="/for/guider/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Guider</a> <span style="opacity:0.3;">/</span></li><li style="color:white;">Vad kostar det?</li></ol></nav>
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.6rem;">Prisguide 2025 · Av Scenkonsult Norden</p>
      <h1 style="font-family:'DM Serif Display',serif;font-size:clamp(2rem,5vw,3.25rem);line-height:1.1;color:white;margin:0 0 1rem;">Vad kostar det att hyra scen, ljud och ljus?</h1>
      <p style="color:rgba(255,255,255,0.6);font-size:clamp(0.95rem,2vw,1.1rem);line-height:1.75;margin:0;">Exakta priser ur vårt sortiment — inga uppskattningar. Använd moms-toggle för att växla inkl/exkl.</p>
    </div>
  </div>
  <article style="background:#0c0a24;padding:clamp(2.5rem,5vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:820px;margin:0 auto;color:rgba(255,255,255,0.65);font-size:1rem;line-height:1.8;">
      <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,3vw,1.9rem);color:white;margin:0 0 1.5rem;">Exempelpaket — verkliga produkter och priser</h2>
      <div style="display:flex;flex-direction:column;gap:2rem;margin-bottom:3rem;">
        {paket.map(pak=>(
          <div style="background:#1e1850;border-radius:16px;overflow:hidden;">
            <div style="padding:1.25rem 1.5rem;border-bottom:1px solid rgba(255,255,255,0.07);">
              <h3 style="font-family:'DM Serif Display',serif;font-size:1.15rem;color:white;margin:0;">{pak.title}</h3>
            </div>
            <div style="padding:1rem 1.5rem;">
              {pak.rows.map(r=>(
                <div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">
                  <div style="display:flex;gap:0.75rem;align-items:center;">
                    <span style="background:rgba(196,181,244,0.1);color:#c4b5f4;font-size:0.7rem;font-weight:700;padding:0.1rem 0.4rem;border-radius:9999px;white-space:nowrap;">{r.kat}</span>
                    <a href={r.l} style="color:rgba(255,255,255,0.65);font-size:0.88rem;text-decoration:none;">{r.prod}</a>
                  </div>
                  <span style="color:white;font-weight:600;white-space:nowrap;margin-left:1rem;"><span data-exkl={r.p}>{r.p}</span> kr</span>
                </div>
              ))}
              <div style="display:flex;justify-content:space-between;align-items:center;padding:0.85rem 0 0.25rem;">
                <div>
                  <span style="color:rgba(255,255,255,0.35);font-size:0.8rem;">{pak.note}</span>
                </div>
                <div style="text-align:right;">
                  <div style="color:rgba(255,255,255,0.3);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;">Delsumma</div>
                  <div style="font-family:'DM Serif Display',serif;font-size:1.5rem;color:#c4b5f4;"><span data-exkl={pak.total}>{pak.total}</span> kr</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,3vw,1.9rem);color:white;margin:3rem 0 1rem;">Sparatips</h2>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
        {sparTips.map(r=>(
          <div style="display:flex;gap:1rem;padding:0.85rem 1rem;background:#1e1850;border-radius:8px;">
            <span style="color:#86efac;font-size:0.8rem;flex-shrink:0;margin-top:0.2rem;">✓</span>
            <div><strong style="color:white;font-size:0.9rem;">{r.t}:</strong> <span style="color:rgba(255,255,255,0.55);font-size:0.88rem;">{r.d}</span></div>
          </div>
        ))}
      </div>
      <div style="background:linear-gradient(135deg,#1e1850,#0c0a24);border:1px solid rgba(196,181,244,0.2);border-radius:16px;padding:2rem;text-align:center;margin-top:3rem;">
        <h2 style="font-family:'DM Serif Display',serif;font-size:1.5rem;color:white;margin:0 0 0.5rem;">Begär offert — svar inom 2 timmar</h2>
        <p style="color:rgba(255,255,255,0.55);font-size:0.95rem;margin:0 0 1.5rem;">Berätta om ditt event så sätter vi ihop exakt pris.</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
          <a href="/bokningssida/" style="background:#c4b5f4;color:#0c0a24;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.82rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;padding:0.8rem 1.75rem;border-radius:4px;">Begär offert</a>
          <a href="/vara-tjanster/" style="border:1px solid rgba(196,181,244,0.4);color:rgba(255,255,255,0.7);font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:0.82rem;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;padding:0.8rem 1.75rem;border-radius:4px;">Se hela sortimentet</a>
        </div>
      </div>
    </div>
  </article>

  <!-- Relaterade guider -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <p style="color:rgba(255,255,255,0.35);font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:0.75rem;">Relaterade guider</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;">
        <a href="/for/guider/hyra-pa-system/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">Hyra PA-system →</a>
        <a href="/for/guider/hyra-scen-pris/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">Hyra scen — pris →</a>
        <a href="/for/guider/ljussattning-tips/" style="display:inline-block;background:#1e1850;border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:0.5rem 1rem;color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:600;text-decoration:none;transition:border-color 0.2s;" onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)'" onmouseleave="this.style.borderColor='rgba(255,255,255,0.1)'">Ljussättningstips →</a>
    </div>
  </div>

</Layout>
