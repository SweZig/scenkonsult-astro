---
import Layout from '../../../layouts/Layout.astro';
import GuideLayout from '../../../components/GuideLayout.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import sceneData from '../../../data/scenes.json';
import djData from '../../../data/dj.json';
import fraktData from '../../../data/tjanster.json';

// Prisuppslag — alltid synkat med JSON
const _lp = [
  ...ljudData.event.products,
  ...(ljudData.portable.products as any[]),
  ...ljudData.music.products,
  ...ljudData.live.products,
  ...((ljudData as any).mixers ?? []),
  ...(ljudData.tillbehor_mikrofon as any[]),
];
const _jp = (ljusData.paket.products as any[]);
const _je = (ljusData.effekter.products as any[]);
const _jr = (ljusData.rok.products as any[]);
const _sp = [...(sceneData.products as any[]), ...((sceneData as any).accessories ?? [])];
const _dp = [...(((djData as any).equipment) ?? []), ...(((djData as any).packages) ?? [])];

const lp = (artno: string) => _lp.find(x => x.artno === artno)?.price ?? 0;
const jp = (artno: string) => [..._jp,..._je,..._jr].find((x:any) => x.artno === artno)?.price ?? 0;
const sp = (artno: string) => _sp.find(x => x.artno === artno)?.price ?? 0;
const dp = (artno: string) => _dp.find((x:any) => x.artno === artno)?.price ?? 0;

// Format-helper för schema-strängar — "1 499" med non-breaking thin-space-konvention
const fmt = (n: number) => n.toLocaleString('sv-SE');

// Paket först (så att schema-strängarna kan referera till paket-summor)
const paket = [
  {title:"Liten fest, ~50 gäster", rows:[
    {kat:"Ljud", prod:"Portable Medium",            p:lp("SK-LJD-POR-0003"), l:"/vara-tjanster/hyra-ljud/portable/"},
    {kat:"Ljus", prod:"Ljuspaket Small",            p:jp("SK-LJS-PAK-0018"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Hämta själv = 0 kr transport"},
  {title:"Bröllop, ~100 gäster", rows:[
    {kat:"Ljud", prod:"Music Small",                p:lp("SK-LJD-MUS-0001"), l:"/vara-tjanster/hyra-ljud/music/"},
    {kat:"Scen", prod:"Scenpaket Small+ (6 m²)",    p:sp("SK-SCN-0002"),     l:"/vara-tjanster/hyra-scen/"},
    {kat:"Scen", prod:"Scentrapp 60 cm",            p:sp("SK-SCN-ACC-0002"), l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus", prod:"Ljuspaket Medium",           p:jp("SK-LJS-PAK-0001"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Transport och montering tillkommer"},
  {title:"Företagsfest, ~200 gäster", rows:[
    {kat:"Ljud",  prod:"Music Large",               p:lp("SK-LJD-MUS-0004"), l:"/vara-tjanster/hyra-ljud/music/"},
    {kat:"Mixer", prod:"Mixerbord 12+4 kanaler",    p:lp("SK-LJD-MIX-0011"), l:"/vara-tjanster/hyra-ljud/event/"},
    {kat:"Scen",  prod:"Scenpaket Medium++ (16 m²)",p:sp("SK-SCN-0007"),     l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus",  prod:"Ljuspaket Medium++",        p:jp("SK-LJS-PAK-0025"), l:"/vara-tjanster/hyra-ljus/"},
    {kat:"DJ",    prod:"Denon Prime 4+",            p:dp("SK-DJ-0003"),      l:"/vara-tjanster/hyra-dj/"},
  ], note:"Transport och montering tillkommer"},
  {title:"Festival, ~500 gäster utomhus", rows:[
    {kat:"Ljud", prod:"Live XL (konsert-PA)",   p:lp("SK-LJD-MUS-0008"), l:"/vara-tjanster/hyra-ljud/live/"},
    {kat:"Scen", prod:"Scenpaket Large+ inkl. scentak", p:sp("SK-SCN-0010"), l:"/vara-tjanster/hyra-scen/"},
    {kat:"Ljus", prod:"Ljuspaket Medium++",         p:jp("SK-LJS-PAK-0025"), l:"/vara-tjanster/hyra-ljus/"},
    {kat:"Rök",  prod:"Rökmaskin 1500W",            p:jp("SK-LJS-ROK-0001"), l:"/vara-tjanster/hyra-ljus/"},
  ], note:"Kontakta oss för festivalpris"},
].map(pak => ({...pak, total: pak.rows.reduce((s, r) => s + (r.p ?? 0), 0)}));

// Schema-priser — JSON-first, alltid synkat med datafilerna
const _scenSmall  = sp("SK-SCN-0001");   // 4 m²
const _scenMedium = sp("SK-SCN-0004");   // 10 m²
const _scenLarge  = sp("SK-SCN-0008");   // 20 m²
const _scenXL     = sp("SK-SCN-0011");   // 36 m²
const _musicSmall = lp("SK-LJD-MUS-0001");
const _musicMed   = lp("SK-LJD-MUS-0003");
const _ljusSmall  = jp("SK-LJS-PAK-0018");
const _ljusMed    = jp("SK-LJS-PAK-0001");
const _ljusXL     = jp("SK-LJS-PAK-0010");
const _fraktBil   = (fraktData as any).leverans?.standard?.pris ?? 1118;
const _fraktStor  = (fraktData as any).leverans?.storbil?.pris ?? 2000;
const _fraktLast  = (fraktData as any).leverans?.lastbil?.pris ?? 3000;
const _totLitenFest    = paket[0].total;
const _totBrollop      = paket[1].total;
const _totForetagsfest = paket[2].total;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Article","image":"https://scenkonsult.se/images/hero/scen3_hero.webp", "headline": "Vad kostar det att hyra scen, ljud och ljus? Prisguide 2026", "author": { "@type": "Organization", "name": "Scenkonsult Norden" }, "datePublished": "2025-01-01", "dateModified": "2026-04-16", "url": "https://scenkonsult.se/for/guider/vad-kostar-det/" },
    { "@type": "FAQPage", "mainEntity": [
      { "@type": "Question", "name": "Vad kostar det att hyra scen i Stockholm?", "acceptedAnswer": { "@type": "Answer", "text": `Scenpaket Small (4 m²): ${fmt(_scenSmall)} kr/dygn. Medium (10 m²): ${fmt(_scenMedium)} kr/dygn. Large (20 m²): ${fmt(_scenLarge)} kr/dygn. XL (36 m²): ${fmt(_scenXL)} kr/dygn. Priser exkl. moms. Transport tillkommer.` } },
      { "@type": "Question", "name": "Vad kostar det att hyra ljud till en fest med 100 gäster?", "acceptedAnswer": { "@type": "Answer", "text": `Music Small (${fmt(_musicSmall)} kr/dygn) täcker 20–80 pers. med dans och subwoofer. Music Medium (${fmt(_musicMed)} kr/dygn) täcker 60–120 pers. Priser exkl. moms och transport.` } },
      { "@type": "Question", "name": "Vad kostar det att hyra ljus till ett event?", "acceptedAnswer": { "@type": "Answer", "text": `Ljuspaket Small (10–30 pers.): ${fmt(_ljusSmall)} kr/dygn. Ljuspaket Medium (40–80 pers.): ${fmt(_ljusMed)} kr/dygn. Ljuspaket XL (100–250 pers.): ${fmt(_ljusXL)} kr/dygn. Priser exkl. moms.` } },
      { "@type": "Question", "name": "Vad kostar leverans av scen och ljud i Stockholm?", "acceptedAnswer": { "@type": "Answer", "text": `Leverans med vanlig bil kostar ${fmt(_fraktBil)} kr (tur och retur). Stor bil ${fmt(_fraktStor)} kr och lätt lastbil ${fmt(_fraktLast)} kr — fordonet väljs efter hur mycket och hur skrymmande utrustningen är. Avhämtning i Vällingby är alltid gratis. Priser exkl. moms.` } },
      { "@type": "Question", "name": "Vad kostar ett komplett paket med scen, ljud och ljus?", "acceptedAnswer": { "@type": "Answer", "text": `Liten fest 50 pers.: från ${fmt(_totLitenFest)} kr/dygn. Bröllop 100 pers.: från ${fmt(_totBrollop)} kr/dygn. Företagsfest 200 pers.: från ${fmt(_totForetagsfest)} kr/dygn. Priser exkl. moms — transport och montering tillkommer.` } },
      { "@type": "Question", "name": "Är det billigare att hämta scen och ljud själv?", "acceptedAnswer": { "@type": "Answer", "text": `Ja — avhämtning i Vällingby är alltid gratis. Spara ${fmt(_fraktBil)} kr om ni har lämpligt fordon. Monteringstjänst kan alltid läggas till separat.` } }
    ]}
  ]
};
const sparTips = [
  {t:"Hämta själv",d:"Avhämtning är alltid gratis. Spara leveranskostnaden om ni har lämpligt fordon."},
  {t:"Helg = 1 dygn",d:"Hyr fredag, lämna tillbaka måndag — betala ett dygn om utrustningen inte är bokad."},
  {t:"Installera själv",d:"Standardpaket är byggda för enkel installation. Spara monteringskostnaden på enkla rigg."},
  {t:"Boka i förväg",d:"Populära helger (maj–sept) tar slut. Boka 4–8 veckor i förväg för bäst urval."},
];
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'Vad kostar det?' }];
---
<Layout breadcrumbs={pageBreadcrumbs} title="Vad Kostar det att Hyra Scen, Ljud & Ljus? Prisguide 2026 | Scenkonsult" description="Exakta priser ur vårt sortiment för PA, scen, ljus och DJ-utrustning. Exempelpaket för bröllop, företagsfest och festival. Scenkonsult sedan 1986." schemaExtra={schema}>
  <GuideLayout eyebrow="Guide · Prisguide 2026" h1Html="Vad kostar det att hyra scen, ljud och ljus?" introHtml="Exakta priser ur vårt sortiment — inga uppskattningar. Använd moms-toggle för att växla inkl/exkl." brod={pageBreadcrumbs} sortiment={{ label: "Hela sortimentet", href: "/vara-tjanster/", text: "Alla priser per dygn." }}>

      <h2 class="gl-h2">Exempelpaket — verkliga produkter och priser</h2>
      <div style="display:flex;flex-direction:column;gap:2rem;margin-bottom:3rem;">
        {paket.map(pak=>(
          <div style="background:#1e1850;border-radius:16px;overflow:hidden;">
            <div style="padding:1.25rem 1.5rem;border-bottom:1px solid rgba(255,255,255,0.07);">
              <h3 style="font-family:'DM Serif Display',serif;font-size:1.15rem;color:white;margin:0;">{pak.title}</h3>
            </div>
            <div style="padding:1rem 1.5rem;">
              {pak.rows.map(r=>(
                <div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">
                  <div style="display:flex;gap:0.75rem;align-items:center;">
                    <span style="background:rgba(196,181,244,0.1);color:#c4b5f4;font-size:0.7rem;font-weight:700;padding:0.1rem 0.4rem;border-radius:9999px;white-space:nowrap;">{r.kat}</span>
                    <a href={r.l} style="color:rgba(255,255,255,0.65);font-size:0.88rem;text-decoration:none;">{r.prod}</a>
                  </div>
                  <span style="color:white;font-weight:600;white-space:nowrap;margin-left:1rem;"><span data-exkl={r.p}>{r.p}</span> kr</span>
                </div>
              ))}
              <div style="display:flex;justify-content:space-between;align-items:center;padding:0.85rem 0 0.25rem;">
                <div>
                  <span style="color:rgba(255,255,255,0.60);font-size:0.8rem;">{pak.note}</span>
                </div>
                <div style="text-align:right;">
                  <div style="color:rgba(255,255,255,0.60);font-size:0.7rem;text-transform:uppercase;letter-spacing:0.06em;">Delsumma</div>
                  <div style="font-family:'DM Serif Display',serif;font-size:1.5rem;color:#c4b5f4;"><span data-exkl={pak.total}>{pak.total}</span> kr</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <h2 class="gl-h2">Sparatips</h2>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
        {sparTips.map(r=>(
          <div style="display:flex;gap:1rem;padding:0.85rem 1rem;background:#1e1850;border-radius:8px;">
            <span style="color:#86efac;font-size:0.8rem;flex-shrink:0;margin-top:0.2rem;">✓</span>
            <div><strong style="color:white;font-size:0.9rem;">{r.t}:</strong> <span style="color:rgba(255,255,255,0.55);font-size:0.88rem;">{r.d}</span></div>
          </div>
        ))}
      </div>
      
    
  

  <!-- Relaterade guider -->
  <div class="gl-rel">
    <p class="gl-rel-rubrik">Relaterade guider</p>
    <div class="gl-rel-lista">
        <a href="/for/guider/hyra-pa-system/" class="gl-chip">Hyra PA-system</a>
        <a href="/for/guider/hyra-scen-pris/" class="gl-chip">Hyra scen — pris</a>
        <a href="/for/guider/ljussattning-tips/" class="gl-chip">Ljussättningstips</a>
    </div>
  </div>
  </GuideLayout>
</Layout>
