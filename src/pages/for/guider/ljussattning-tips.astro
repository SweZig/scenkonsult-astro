---
import Layout from '../../../layouts/Layout.astro';
import GuideLayout from '../../../components/GuideLayout.astro';
import ljusData from '../../../data/ljus.json';

const _jp = (ljusData.paket.products as any[]);
const _je = (ljusData.effekter.products as any[]);
const _jr = (ljusData.rok.products as any[]);
const _jstv = ((ljusData as any).stativ?.products ?? []) as any[];
const jp = (artno: string) => [..._jp,..._je,..._jr,..._jstv].find((x:any) => x.artno === artno)?.price ?? 0;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","image":"https://scenkonsult.se/images/hero/scen3_hero.webp","headline":"Ljussättning för event — guide till bättre stämning 2025","author":{"@type":"Organization","name":"Scenkonsult Norden"},"datePublished":"2025-01-01","url":"https://scenkonsult.se/for/guider/ljussattning-tips/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Vad kostar det att hyra ljus till ett event?","acceptedAnswer":{"@type":"Answer","text":`Ljuspaket Small (upp till 20 pers) kostar ${jp("SK-LJS-PAK-0018")} kr/dygn exkl moms. Medium (upp till 40 pers) ${jp("SK-LJS-PAK-0001")} kr/dygn. Enstaka LED PAR-armaturer kostar fr ${jp("SK-LJS-EFF-0001")} kr/dygn. Rökmaskin ${jp("SK-LJS-ROK-0001")}–${jp("SK-LJS-ROK-0002")} kr/dygn.`}},{"@type":"Question","name":"Behöver jag rökmaskin till lasern?","acceptedAnswer":{"@type":"Answer","text":`Ja. En laser utan rök eller haze är knappt synlig. Rökmaskin 1500W kostar ${jp("SK-LJS-ROK-0001")} kr/dygn.`}},{"@type":"Question","name":"Vilket ljuspaket passar 100 gäster?","acceptedAnswer":{"@type":"Answer","text":`Ljuspaket Medium++ (upp till 60 pers, ${jp("SK-LJS-PAK-0025")} kr/dygn) eller Large (60–140 pers, ${jp("SK-LJS-PAK-0007")} kr/dygn). Komplettera med enstaka LED PAR-armaturer (fr ${jp("SK-LJS-EFF-0001")} kr/st) för väggfärg.`}}]}]};
const paket = [
  {n:"Ljuspaket, Small",p:jp("SK-LJS-PAK-0018"),pers:"Upp till 20 pers.",d:"Spindelarmatur med 8× RGBW-huvuden på stativ. Ljudstyrt eller DMX."},
  {n:"Ljuspaket, Small+",p:jp("SK-LJS-PAK-0020"),pers:"Upp till 30 pers.",d:"Kaleidoskop med 6 beam-armar, enklare laser och strobe. Fjärrkontroll ingår."},
  {n:"Ljuspaket, Medium",p:jp("SK-LJS-PAK-0001"),pers:"Upp till 40 pers.",d:"T-bar med 4× PAR RGBW på stativ. Synkar till musik. Plug and play."},
  {n:"Ljuspaket, Medium+",p:jp("SK-LJS-PAK-0002"),pers:"Upp till 40 pers.",d:"Trosstorn med moving head 100W COB. Roterar 540°, DMX/musikstyrning."},
  {n:"Ljuspaket, Medium++",p:jp("SK-LJS-PAK-0025"),pers:"Upp till 60 pers.",d:"Tre stativ: T-bar med PAR, kaleidoskop med laser och spindelarmatur."},
  {n:"Ljuspaket, Large",p:jp("SK-LJS-PAK-0007"),pers:"60–140 pers.",d:"Tross med scanner och fyra moving heads. Automatik eller DMX."},
];
const effekter = [
  {n:"LED PAR (14×8W RGBW)",p:jp("SK-LJS-EFF-0001"),d:"Väggfärg / uplight"},
  {n:"LED PAR (9×10W RGBW)",p:jp("SK-LJS-EFF-0002"),d:"Starkare variant"},
  {n:"LED PAR UV",p:jp("SK-LJS-EFF-0003"),d:"UV-ljus / black light"},
  {n:"LED PAR XL (60×2W RGBW)",p:jp("SK-LJS-EFF-0004"),d:"Bred wash-täckning"},
  {n:"LED-armatur, uppladdningsbar",p:jp("SK-LJS-EFF-0005"),d:"Trådlös, batteri"},
];
const rok = [
  {n:"Rökmaskin (1500W)",p:jp("SK-LJS-ROK-0001")},{n:"Rökmaskin (650W)",p:jp("SK-LJS-ROK-0002")},{n:"Kallgnistmaskin",p:jp("SK-LJS-ROK-0003")},{n:"Konfettiavfyrare",p:jp("SK-LJS-ROK-0004")}
];
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'Ljussättning' }];
---
<Layout breadcrumbs={pageBreadcrumbs} title="Ljussättning för Event — Guide & Priser 2026 | Scenkonsult" description={`Typer av ljus, dramaturgi och vanliga misstag. Priser på ljuspaket fr ${jp('SK-LJS-PAK-0001')} kr/dygn — matchade mot vårt sortiment. Scenkonsult sedan 1986.`} schemaExtra={schema}>
  <GuideLayout eyebrow="Guide & priser" h1Html="Ljussättning för event — <em>rätt stämning med rätt utrustning</em>" introHtml="Rätt ljus är det billigaste sättet att transformera ett rum. Alla priser nedan är ur vårt faktiska sortiment." brod={pageBreadcrumbs} sortiment={{ label: "Hyra ljus", href: "/vara-tjanster/hyra-ljus/", text: "Ljuspaket och effekter." }}>

      <h2 class="gl-h2">Ljuspaket — välj efter gästantal</h2>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:3rem;">
        {paket.map(p=>(
          <div style="background:#1e1850;border-radius:12px;padding:1.25rem 1.5rem;display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-start;flex-wrap:wrap;">
            <div>
              <div style="color:white;font-weight:700;font-size:0.92rem;margin-bottom:0.2rem;">{p.n}</div>
              <div style="color:#c4b5f4;font-size:0.78rem;margin-bottom:0.4rem;">{p.pers}</div>
              <div style="color:rgba(255,255,255,0.5);font-size:0.87rem;line-height:1.55;">{p.d}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="color:#c4b5f4;font-family:'DM Serif Display',serif;font-size:1.5rem;white-space:nowrap;"><span data-exkl={p.p}>{p.p}</span> kr</div>
              <div style="color:rgba(255,255,255,0.60);font-size:0.72rem;">per dygn</div>
            </div>
          </div>
        ))}
      </div>
      <h2 class="gl-h2">Enstaka armaturer — bygg din egen rigg</h2>
      <p style="margin-bottom:1.25rem;">Komplettera paketet med enstaka LED PAR-armaturer för väggfärg (uplight-effekt), eller bygg en helt custom rigg.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:0.75rem;margin-bottom:1rem;">
        {effekter.map(e=>(
          <div style="background:#1e1850;border-radius:8px;padding:1rem;display:flex;justify-content:space-between;align-items:center;gap:0.5rem;">
            <div><div style="color:rgba(255,255,255,0.7);font-size:0.87rem;font-weight:600;">{e.n}</div><div style="color:rgba(255,255,255,0.60);font-size:0.75rem;">{e.d}</div></div>
            <div style="color:#c4b5f4;font-weight:700;white-space:nowrap;"><span data-exkl={e.p}>{e.p}</span> kr</div>
          </div>
        ))}
      </div>
      <p style="color:rgba(255,255,255,0.60);font-size:0.8rem;margin-bottom:3rem;">Stativ med T-bar ingår i paketen. Separat: stativ fr <span data-exkl={jp("SK-LJS-STV-0001")}>{jp("SK-LJS-STV-0001")}</span> kr, trosstorn fr <span data-exkl={jp("SK-LJS-STV-0005")}>{jp("SK-LJS-STV-0005")}</span> kr.</p>
      <h2 class="gl-h2">Rök, gnistor och konfetti</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:0.75rem;margin-bottom:3rem;">
        {rok.map(r=>(
          <div style="background:#1e1850;border-radius:8px;padding:1rem;display:flex;justify-content:space-between;align-items:center;">
            <span style="color:rgba(255,255,255,0.7);font-size:0.87rem;">{r.n}</span>
            <span style="color:#c4b5f4;font-weight:700;white-space:nowrap;margin-left:0.5rem;"><span data-exkl={r.p}>{r.p}</span> kr</span>
          </div>
        ))}
      </div>
      <div style="background:#1e1850;border:1px solid rgba(255,100,100,0.2);border-radius:12px;padding:1.5rem;margin-bottom:3rem;">
        <h3 style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:700;color:#fbbf24;margin:0 0 0.75rem;">⚡ Kom ihåg: laser utan rök syns knappt</h3>
        <p style="color:rgba(255,255,255,0.55);font-size:0.88rem;line-height:1.65;margin:0;">Small++ och Medium-paketen inkluderar laser. För maximal effekt behöver du rökmaskin (fr <span data-exkl={jp("SK-LJS-ROK-0001")}>{jp("SK-LJS-ROK-0001")}</span> kr/dygn) — annars är ljusstrålarna knappt synliga i luften.</p>
      </div>
      <h2 class="gl-h2">Ljus-dramaturgi under kvällen</h2>
      <div style="display:flex;flex-direction:column;gap:0;margin-bottom:2.5rem;">
        {[{fas:"Mingel & middag",tid:"18:00–21:00",desc:"Paketet i auto-musik-läge. Varma färger, låg intensitet. Ingen strobe."},{fas:"Tal & underhållning",tid:"20:00–22:00",desc:"Dimma ner. Eventuell spotlight på talare vid scenen."},{fas:"Dansgolvet öppnar",tid:"22:00+",desc:"Höj intensiteten. Aktivera rök. Färgskiftande läge. Strobe sparsamt."}].map(f=>(
          <div style="background:rgba(196,181,244,0.04);border:1px solid rgba(255,255,255,0.07);padding:1.1rem 1.5rem;">
            <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:0.4rem;">
              <h3 style="font-family:'Space Grotesk',sans-serif;font-size:0.88rem;font-weight:700;color:white;margin:0;">{f.fas}</h3>
              <span style="color:rgba(255,255,255,0.55);font-size:0.75rem;">{f.tid}</span>
            </div>
            <p style="color:rgba(255,255,255,0.55);font-size:0.87rem;line-height:1.6;margin:0;">{f.desc}</p>
          </div>
        ))}
      </div>
      
    
  

  <!-- Relaterade guider -->
  <div class="gl-rel">
    <p class="gl-rel-rubrik">Relaterade guider</p>
    <div class="gl-rel-lista">
        <a href="/for/guider/hyra-uplights/" class="gl-chip">Hyra uplights</a>
        <a href="/for/guider/hyra-rokmaskin/" class="gl-chip">Hyra rökmaskin</a>
        <a href="/for/guider/ljus-brollop/" class="gl-chip">Ljus till bröllop</a>
    </div>
  </div>
  </GuideLayout>
</Layout>
