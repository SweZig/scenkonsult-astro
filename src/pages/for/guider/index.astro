const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Guider om eventproduktion och AV-uthyrning",
  "description": "Kompletta guider om PA-dimensionering, scenstorlekar, ljussättning och event-planering från Scenkonsult Norden.",
  "itemListElement": guider.map((g, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Article",
      "name": g.title,
      "url": `https://scenkonsult.se/for/guider/${g.slug}/`
    }
  }))
};

// Kategoriordning (prioritering: Scen · Ljud · Bild · Ljus · DJ) + planering sist
const kategorier = [
  { namn: "Scen",                  ikon: "🎭", intro: "Storlek, pris och tillbehör för scenuthyrning." },
  { namn: "Ljud & PA",             ikon: "🔊", intro: "Dimensionera PA, välj mikrofon och få ljud som bär." },
  { namn: "Bild & projektion",     ikon: "📽️", intro: "Projektor, skärm och duk för konferens och event." },
  { namn: "Ljus & effekter",       ikon: "💡", intro: "Ljussättning, DMX-styrning, uplights och rökeffekter." },
  { namn: "DJ & musik",            ikon: "🎧", intro: "DJ-bokning, utrustning och DJ kontra liveband." },
  { namn: "Planering & checklistor", ikon: "✅", intro: "Budget, tidsplan och kompletta checklistor." },
];
const guiderPerKategori = (k: string) => guider.filter(g => (g as any).cat === k);
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'För ditt event', href: '/for/' }, { label: 'Guider' }];
---

<Layout breadcrumbs={pageBreadcrumbs}
  title="Guider om Eventproduktion & AV-uthyrning | Scenkonsult Stockholm"
  description="Kompletta guider om PA-dimensionering, scenstorlek, ljussättning, DJ vs liveband och event-planering. Från Scenkonsult — uthyrare sedan 1986."
  schemaExtra={schema}
>
  <header class="gi-hero">
    <nav aria-label="Brödsmulor" class="gi-brod">
      <a href="/">Hem</a><span aria-hidden="true">/</span><a href="/for/">För ditt event</a><span aria-hidden="true">/</span><span class="gi-nu">Guider</span>
    </nav>
    <p class="sk-eyebrow">Kunskapsbank</p>
    <h1>Guider om <em>event&shy;teknik</em></h1>
    <p class="gi-intro">Konkreta svar på de vanligaste frågorna om ljud, ljus, scen och eventproduktion — med priser ur vårt sortiment och erfarenheter från uppdrag sedan 1986.</p>
    <nav class="gi-hopp" aria-label="Kategorier">
      {kategorier.filter(k => guiderPerKategori(k.namn).length).map(k => <a href={`#${k.namn.toLowerCase().replace(/[^a-zåäö]+/g, '-')}`}>{k.namn}</a>)}
    </nav>
  </header>

  <section class="gi-wrap">
    <a href="/svens-kunskapsskola/" class="gi-skola">
      <div>
        <p class="sk-eyebrow">Videoguider · Steg för steg på film</p>
        <h2>Svens Kunskapsskola</h2>
        <p>Videoguider om att koppla in ljud, förstå kontakter och hyra rätt — av Sven intendenten. Inga förkunskaper krävs.</p>
      </div>
      <span class="gi-pil" aria-hidden="true">→</span>
    </a>

    {kategorier.map(kat => {
      const items = guiderPerKategori(kat.namn);
      return items.length === 0 ? null : (
        <div class="gi-kat" id={kat.namn.toLowerCase().replace(/[^a-zåäö]+/g, '-')}>
          <div class="gi-kathuvud">
            <h2 class="sk-h2s">{kat.namn}</h2>
            <p>{kat.intro}</p>
          </div>
          <div class="gi-grid">
            {items.map(g => (
              <a href={`/for/guider/${g.slug}/`} class="gi-kort">
                <h3>{g.title}</h3>
                <p>{g.desc}</p>
                <div class="gi-fot">
                  <span class="gi-taggar">{g.tags.map(t => <span>{t}</span>)}</span>
                  <span class="gi-las">Läs →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="gi-kat">
      <div class="gi-kathuvud">
        <h2 class="sk-h2s">Bredare läsning</h2>
        <p>Två längre guider — mindre om enskilda produkter, mer om hur du planerar och hittar rätt lokal.</p>
      </div>
      <div class="gi-grid">
        {[
          { href: "/guide-till-eventlokaler-i-stockholm/", title: "Guide till eventlokaler i Stockholm", desc: "15+ utvalda lokaler från intima 40-personersmiljöer till Tele2 Arena. Område, kapacitet, kontakt och vår erfarenhet av varje plats.", tags: ["Lokaler", "Stockholm"] },
          { href: "/den-ultimata-guiden-till-minnesvarda-fester/", title: "Den ultimata guiden till minnesvärda fester", desc: "Festteman, produktionstips och dramaturgi från 40 års eventerfarenhet. Hur du planerar en fest gästerna minns — från middag till dansgolv.", tags: ["Fest", "Planering"] },
        ].map(g => (
          <a href={g.href} class="gi-kort">
            <h3>{g.title}</h3>
            <p>{g.desc}</p>
            <div class="gi-fot">
              <span class="gi-taggar">{g.tags.map(t => <span>{t}</span>)}</span>
              <span class="gi-las">Läs →</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="gi-event">
      <p class="sk-eyebrow">Eller — utgå från ditt event</p>
      <div>
        {[
          { href:"/for/brollop/", label:"Bröllop" },
          { href:"/for/foretagsfest/", label:"Företagsfest" },
          { href:"/for/konferens/", label:"Konferens" },
          { href:"/for/festival/", label:"Festival" },
          { href:"/for/studentflak/", label:"Studentflak" },
          { href:"/vara-tjanster/", label:"Alla tjänster" },
        ].map(l => <a href={l.href} class="sk-knapp">{l.label}</a>)}
      </div>
    </div>
  </section>

  <SlutRuta rubrik="Hittar du inte svaret?" />
</Layout>

<style>
  .gi-hero { max-width: 1240px; margin: 0 auto; padding: calc(var(--nav-offset, 166px) + clamp(1.25rem, 3vw, 2.5rem)) clamp(1rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem); }
  .gi-brod { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.4rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.8rem; color: rgba(255,255,255,0.4); }
  .gi-brod a { color: rgba(255,255,255,0.6); text-decoration: none; }
  .gi-brod a:hover, .gi-nu { color: #fff; }
  .gi-hero h1 { margin: 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(2.5rem, 6vw, 4.6rem); line-height: 1; color: #fff; }
  .gi-hero h1 em { color: #c4b5f4; }
  .gi-intro { margin: 1.35rem 0 0; max-width: 640px; font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.6; color: rgba(255,255,255,0.72); }
  .gi-hopp { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.75rem; }
  .gi-hopp a { font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; font-weight: 600; padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.8); text-decoration: none; }
  .gi-hopp a:hover { border-color: #c4b5f4; color: #fff; }
  .gi-wrap { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem); display: grid; gap: clamp(2.75rem, 5vw, 4rem); }
  .gi-skola { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(1.5rem, 3.5vw, 2.5rem); border-radius: 24px; background: #c4b5f4; color: #0c0a24; text-decoration: none; }
  .gi-skola .sk-eyebrow { color: rgba(12,10,36,0.6); }
  .gi-skola h2 { margin: 0.3rem 0 0.5rem; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.05; color: #0c0a24; }
  .gi-skola p { margin: 0; max-width: 560px; color: rgba(12,10,36,0.78); }
  .gi-pil { flex-shrink: 0; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 999px; background: #0c0a24; color: #fff; font-size: 1.4rem; transition: transform 0.15s; }
  .gi-skola:hover .gi-pil { transform: translateX(4px); }
  .gi-kat { scroll-margin-top: calc(var(--nav-offset, 166px) + 1rem); }
  .gi-kathuvud { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 2rem; padding-bottom: 1rem; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .gi-kathuvud h2 { margin: 0; }
  .gi-kathuvud p { margin: 0; color: rgba(255,255,255,0.55); font-size: 0.95rem; }
  .gi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .gi-kort { display: flex; flex-direction: column; gap: 0.7rem; padding: 1.5rem; border-radius: 20px; background: #1e1850; border: 1px solid rgba(255,255,255,0.08); text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
  .gi-kort:hover { border-color: rgba(196,181,244,0.45); transform: translateY(-2px); }
  .gi-kort h3 { margin: 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: 1.4rem; line-height: 1.12; color: #fff; }
  .gi-kort p { margin: 0; flex: 1; font-size: 0.92rem; line-height: 1.6; color: rgba(255,255,255,0.62); }
  .gi-fot { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; padding-top: 0.9rem; border-top: 1px solid rgba(255,255,255,0.08); }
  .gi-taggar { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .gi-taggar span { font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 999px; background: rgba(196,181,244,0.12); color: #c4b5f4; }
  .gi-las { flex-shrink: 0; font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; font-weight: 700; color: #c4b5f4; }
  .gi-event > div { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.9rem; }
  @media (max-width: 720px) {
    .gi-hero { padding-top: calc(132px + 0.75rem); }
    .gi-pil { display: none; }
  }
</style>
