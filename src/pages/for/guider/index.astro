---
import Layout from '../../../layouts/Layout.astro';

const guider = [
  {
    slug: "konferens-av-checklista",
    icon: "📋",
    title: "Konferens AV — komplett checklista",
    desc: "Allt du behöver tänka på: PA, mikrofoner, projektor och hybrid. Rekommenderat upplägg efter konferensstorlek.",
    tags: ["Konferens", "Checklista"],
    lasttid: "4 min"
  },
  {
    slug: "dmx-styrning-guide",
    icon: "🎛",
    title: "DMX-styrning — komplett guide",
    desc: "Från första kabeln till proffsriggen: kanaler, adresser, terminering, trådlöst, RDM och Art-Net. Nybörjardel + avancerad del.",
    tags: ["Ljus", "DMX", "Teknik"],
    lasttid: "9 min"
  },
  {
    slug: "hyra-uplights",
    icon: "🌟",
    title: "Hyra uplights — LED wallwash för ditt event",
    desc: "Förvandla lokalen på 10 minuter. Guide till antal, kabel vs batteri och priser från 79 kr/st/dygn.",
    tags: ["Ljus", "Uplights"],
    lasttid: "4 min"
  },
  {
    slug: "hyra-pa-system",
    icon: "🔊",
    title: "Hyra PA-system — komplett guide 2026",
    desc: "Portable, Event, Music eller Live — vad väljer du? Storleksguide från 10 till 500+ gäster med priser.",
    tags: ["Ljud", "PA"],
    lasttid: "5 min"
  },
  {
    slug: "hyra-rokmaskin",
    icon: "💨",
    title: "Hyra rökmaskin i Stockholm",
    desc: "Rökmaskin, hazer eller kallgnistmaskin? Guide till skillnaderna, brandlarm och vad det kostar.",
    tags: ["Ljus", "Rök"],
    lasttid: "3 min"
  },
  {
    slug: "rokvatska-guide",
    icon: "🧪",
    title: "Rökvätska — standard, haze, heavy eller CO2?",
    desc: "Vilken rökvätska ska du välja? Guide till de fyra huvudtyperna med matchning mot rökmaskin och priser från 119 kr.",
    tags: ["Ljus", "Rök", "Förbrukning"],
    lasttid: "5 min"
  },
  {
    slug: "hyra-tradlos-mikrofon",
    icon: "🎤",
    title: "Hyra trådlös mikrofon — guide till rätt val",
    desc: "Handmikrofon, headset eller myggmikrofon? Skillnaderna, när du väljer vad och vad det kostar. Shure SLXD från 699 kr/dygn.",
    tags: ["Mikrofon", "Konferens", "Bröllop"],
    lasttid: "4 min"
  },
  {
    slug: "ljud-foretagsfest",
    icon: "🏢",
    title: "Ljud till företagsfest — välj rätt system",
    desc: "Event-serie för tal och konferens, Music-serie för dans och DJ. Storleksguide för 30–500 gäster med konkreta priser.",
    tags: ["Ljud", "Företag"],
    lasttid: "4 min"
  },
  {
    slug: "hyra-projektor-pris",
    icon: "📽️",
    title: "Hyra projektor — vad kostar det?",
    desc: "Projektor vs skärm — när väljer du vad? Priser på projektorer, dukar och skärmar. Full HD från 399 kr/dygn, 4K UHD från 899 kr/dygn.",
    tags: ["Projektor", "Konferens", "Priser"],
    lasttid: "3 min"
  },
  {
    slug: "ljus-brollop",
    icon: "💡",
    title: "Ljus till bröllop — vad behöver man?",
    desc: "Guide till uplights, moving heads och stämningsljus. Tre faser: vigsel, middag och dansgolv — med konkreta priser.",
    tags: ["Ljus", "Bröllop"],
    lasttid: "4 min"
  },
  {
    slug: "dj-brollop-pris",
    icon: "🎧",
    title: "DJ till bröllop — vad kostar det?",
    desc: "Pristabell för DJ-bokning, vad som ingår och tillkommer. Junior DJ från 1 999 kr, Senior DJ från 2 399 kr.",
    tags: ["DJ", "Bröllop", "Priser"],
    lasttid: "3 min"
  },
  {
    slug: "studentflak-checklista",
    icon: "🎓",
    title: "Studentflak 2026 — den kompletta checklistan",
    desc: "Allt ni behöver tänka på: ljud, ström, tillstånd och tips. Vilket system passar ert flak?",
    tags: ["Studentflak", "Checklista"],
    lasttid: "4 min"
  },
  {
    slug: "ljud-brollop",
    icon: "💍",
    title: "Ljud till bröllop — vad behöver man?",
    desc: "Guide till PA-system, mikrofoner och ljud för vigsel, middag och dansgolv. Med storlekstabell och priser.",
    tags: ["Ljud", "Bröllop"],
    lasttid: "5 min"
  },
  {
    slug: "hyra-scen-pris",
    icon: "🎭",
    title: "Hyra scen — vad kostar det?",
    desc: "Komplett prisguide för scenuthyrning 2026. Alla storlekar, vad som tillkommer och hur du väljer rätt.",
    tags: ["Scen", "Priser"],
    lasttid: "4 min"
  },
  {
    slug: "varfor-numark-denon-rane",
    icon: "🎛️",
    title: "Varför Numark, Denon & Rane — inte Pioneer?",
    desc: "Konkreta argument för standalone DJ-controllers med inbyggd Spotify/Tidal-streaming mot Pioneer CDJ-systemet.",
    tags: ["DJ", "Utrustning"],
    lasttid: "5 min"
  },
  {
    slug: "hur-stor-pa",
    icon: "🔊",
    title: "Hur stor PA-anläggning behöver jag?",
    desc: "Tabeller för inomhus och utomhus, gästantal och eventtyp. Inkl. guide till subbasen.",
    tags: ["Ljud", "Dimensionering"],
    lasttid: "4 min"
  },
  {
    slug: "hur-stor-scen",
    icon: "🎭",
    title: "Hur stor scen behöver jag?",
    desc: "Referenstabell: scenstorlekar, antal artister, scenhöjder och tillbehör.",
    tags: ["Scen"],
    lasttid: "3 min"
  },
  {
    slug: "dj-eller-liveband",
    icon: "🎸",
    title: "DJ eller liveband till festen?",
    desc: "Ärlig jämförelse på pris, stämning, logistik och teknikkrav. Inkl. combo-alternativet.",
    tags: ["DJ", "Musik"],
    lasttid: "4 min"
  },
  {
    slug: "ljussattning-tips",
    icon: "💡",
    title: "Ljussättning för event",
    desc: "Typer av ljus, placering, dramaturgi under kvällen och de 4 vanligaste misstagen.",
    tags: ["Ljus", "Stämning"],
    lasttid: "5 min"
  },
  {
    slug: "checklista-event",
    icon: "✅",
    title: "Komplett checklista för event",
    desc: "Allt från bokning till retur — 8–12 veckor före, event-dagen och backup-plan.",
    tags: ["Planering", "Checklista"],
    lasttid: "3 min"
  },
  {
    slug: "ljud-utomhus",
    icon: "🌤️",
    title: "Ljud utomhus — komplett guide",
    desc: "Effektbehov, placering, väderskydd och tillståndsregler för utomhus-event.",
    tags: ["Utomhus", "Ljud"],
    lasttid: "4 min"
  },
  {
    slug: "vad-kostar-det",
    icon: "💰",
    title: "Vad kostar det att hyra utrustning?",
    desc: "Prisguide 2025 med tabeller, exempelpaket och tips för att sänka totalkostnaden.",
    tags: ["Pris", "Budget"],
    lasttid: "3 min"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Guider om eventproduktion och AV-uthyrning",
  "description": "Kompletta guider om PA-dimensionering, scenstorlekar, ljussättning och event-planering från Scenkonsult Norden.",
  "itemListElement": guider.map((g, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Article",
      "name": g.title,
      "url": `https://scenkonsult.se/for/guider/${g.slug}/`
    }
  }))
};
---

<Layout
  title="Guider om Eventproduktion & AV-uthyrning | Scenkonsult Stockholm"
  description="Kompletta guider om PA-dimensionering, scenstorlek, ljussättning, DJ vs liveband och event-planering. Från Scenkonsult — uthyrare sedan 1986."
  schemaExtra={schema}
>

  <!-- Header -->
  <div style="background:linear-gradient(135deg,#1e1850 0%,#0c0a24 60%);padding-top:calc(36px + 130px + clamp(2rem,4vw,3.5rem));padding-bottom:clamp(2.5rem,5vw,4rem);padding-inline:clamp(1rem,5vw,5rem);position:relative;overflow:hidden;">
    <div style="position:absolute;right:-5%;top:50%;transform:translateY(-50%);width:clamp(200px,35vw,460px);height:clamp(200px,35vw,460px);border-radius:50%;background-image:radial-gradient(circle,rgba(196,181,244,0.07) 2px,transparent 2px);background-size:22px 22px;pointer-events:none;"></div>
    <div style="max-width:820px;margin:0 auto;position:relative;z-index:2;">
      <nav aria-label="Brödsmulor" style="margin-bottom:1.5rem;">
        <ol style="display:flex;flex-wrap:wrap;gap:0.35rem;list-style:none;margin:0;padding:0;font-size:0.78rem;color:rgba(255,255,255,0.60);">
          <li><a href="/" style="color:rgba(255,255,255,0.5);text-decoration:none;">Hem</a> <span style="opacity:0.3;">/</span></li>
          <li><a href="/for/" style="color:rgba(255,255,255,0.5);text-decoration:none;">För ditt event</a> <span style="opacity:0.3;">/</span></li>
          <li><span style="color:white;">Guider</span></li>
        </ol>
      </nav>
      <p style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.6rem;">Kunskapsbank · Av Scenkonsult Norden</p>
      <h1 style="font-family:'DM Serif Display',serif;font-size:clamp(2rem,5vw,3.25rem);line-height:1.1;color:white;margin:0 0 1rem;">Guider om event-teknik</h1>
      <p style="color:rgba(255,255,255,0.6);font-size:clamp(0.95rem,2vw,1.1rem);line-height:1.75;margin:0;max-width:580px;">Konkreta svar på de vanligaste frågorna om ljud, ljus, scen och eventproduktion — byggda på erfarenheter från hundratals event sedan 1986.</p>
    </div>
  </div>

  <!-- Svens Kunskapsskola — featured -->
  <section style="background:#111030;padding:clamp(2rem,5vw,3.5rem) clamp(1rem,5vw,5rem);border-bottom:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:1100px;margin:0 auto;">
      <a href="/svens-kunskapsskola/"
         style="display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:center;background:linear-gradient(135deg,#1e1850 0%,#2a1f6e 100%);border:1px solid rgba(196,181,244,0.2);border-radius:16px;padding:clamp(1.5rem,4vw,2.5rem);text-decoration:none;transition:border-color 0.2s,transform 0.15s;"
         onmouseenter="this.style.borderColor='rgba(196,181,244,0.5)';this.style.transform='translateY(-2px)'"
         onmouseleave="this.style.borderColor='rgba(196,181,244,0.2)';this.style.transform='translateY(0)'">
        <div>
          <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.75rem;">
            <span style="background:rgba(196,181,244,0.15);color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.2rem 0.6rem;border-radius:4px;">🎬 Videoguider</span>
            <span style="background:rgba(196,181,244,0.15);color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding:0.2rem 0.6rem;border-radius:4px;">4 avsnitt</span>
          </div>
          <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.3rem,2.5vw,1.75rem);color:white;margin:0 0 0.6rem;line-height:1.2;">Svens Kunskapsskola</h2>
          <p style="color:rgba(255,255,255,0.55);font-size:clamp(0.85rem,1.5vw,0.95rem);line-height:1.65;margin:0;max-width:560px;">Videoguider om att koppla in ljud, förstå kontakter och hyra rätt — av Sven intendenten. Inga förkunskaper krävs.</p>
        </div>
        <span style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:1.5rem;flex-shrink:0;">→</span>
      </a>
    </div>
  </section>

  <!-- Guide-kort -->
  <section style="background:#0c0a24;padding:clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5rem;">
      {guider.map(g => (
        <a href={`/for/guider/${g.slug}/`}
           style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:1.75rem;text-decoration:none;display:flex;flex-direction:column;gap:0.75rem;transition:border-color 0.2s,transform 0.15s;"
           onmouseenter="this.style.borderColor='rgba(196,181,244,0.35)';this.style.transform='translateY(-2px)'"
           onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)';this.style.transform='translateY(0)'">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <span style="font-size:1.75rem;">{g.icon}</span>
            <span style="color:rgba(255,255,255,0.55);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;">{g.lasttid} läsning</span>
          </div>
          <h2 style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:white;margin:0;line-height:1.25;">{g.title}</h2>
          <p style="color:rgba(255,255,255,0.5);font-size:0.88rem;line-height:1.65;margin:0;flex:1;">{g.desc}</p>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.25rem;">
            <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
              {g.tags.map(t => (
                <span style="background:rgba(196,181,244,0.1);color:#c4b5f4;font-size:0.7rem;font-weight:600;padding:0.15rem 0.5rem;border-radius:9999px;">{t}</span>
              ))}
            </div>
            <span style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.06em;">Läs →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Klassiska guider — bredare läsning -->
  <section style="background:#0c0a24;padding:clamp(2rem,5vw,3.5rem) clamp(1rem,5vw,5rem);border-top:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60);font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.6rem;">Klassiska guider</p>
      <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(1.4rem,2.8vw,1.9rem);color:white;margin:0 0 0.5rem;line-height:1.2;">Bredare läsning</h2>
      <p style="color:rgba(255,255,255,0.55);font-size:0.92rem;line-height:1.65;margin:0 0 1.75rem;max-width:640px;">Två lite längre, bredare guider — mindre om enskilda produkter och mer om hur du planerar och hittar rätt lokal för ditt event.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.5rem;">
        {[
          {
            href: "/guide-till-eventlokaler-i-stockholm/",
            icon: "🏛️",
            title: "Guide till eventlokaler i Stockholm",
            desc: "15+ utvalda lokaler från intima 40-personersmiljöer till Tele2 Arena. Område, kapacitet, kontakt och vår erfarenhet av varje plats.",
            tags: ["Lokaler", "Stockholm"],
            lasttid: "8 min"
          },
          {
            href: "/den-ultimata-guiden-till-minnesvarda-fester/",
            icon: "🎉",
            title: "Den ultimata guiden till minnesvärda fester",
            desc: "Festteman, produktionstips och dramaturgi från 40 års eventerfarenhet. Hur du planerar en fest gästerna minns — från middag till dansgolv.",
            tags: ["Fest", "Planering"],
            lasttid: "6 min"
          }
        ].map(g => (
          <a href={g.href}
             style="background:#1e1850;border:1px solid rgba(196,181,244,0.18);border-radius:16px;padding:1.75rem;text-decoration:none;display:flex;flex-direction:column;gap:0.75rem;transition:border-color 0.2s,transform 0.15s;"
             onmouseenter="this.style.borderColor='rgba(196,181,244,0.45)';this.style.transform='translateY(-2px)'"
             onmouseleave="this.style.borderColor='rgba(196,181,244,0.18)';this.style.transform='translateY(0)'">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <span style="font-size:1.75rem;">{g.icon}</span>
              <span style="color:rgba(255,255,255,0.55);font-family:'Space Grotesk',sans-serif;font-size:0.72rem;">{g.lasttid} läsning</span>
            </div>
            <h3 style="font-family:'DM Serif Display',serif;font-size:1.2rem;color:white;margin:0;line-height:1.25;">{g.title}</h3>
            <p style="color:rgba(255,255,255,0.5);font-size:0.88rem;line-height:1.65;margin:0;flex:1;">{g.desc}</p>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.25rem;">
              <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                {g.tags.map(t => (
                  <span style="background:rgba(196,181,244,0.1);color:#c4b5f4;font-size:0.7rem;font-weight:600;padding:0.15rem 0.5rem;border-radius:9999px;">{t}</span>
                ))}
              </div>
              <span style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.78rem;font-weight:700;letter-spacing:0.06em;">Läs →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Event-typ-länksektion -->
  <section style="background:#111030;padding:clamp(2.5rem,5vw,4rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px;margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60);font-family:'Space Grotesk',sans-serif;font-size:0.75rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:1.25rem;">Eller — välj ditt event-typ</p>
      <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
        {[
          { href:"/for/brollop/", label:"💍 Bröllop" },
          { href:"/for/foretagsfest/", label:"🎉 Företagsfest" },
          { href:"/for/konferens/", label:"🎤 Konferens" },
          { href:"/for/festival/", label:"🎸 Festival" },
          { href:"/for/studentflak/", label:"🎓 Studentflak" },
          { href:"/vara-tjanster/", label:"✨ Alla tjänster" },
        ].map(l => (
          <a href={l.href} style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:9999px;padding:0.55rem 1.1rem;color:rgba(255,255,255,0.65);font-family:'Space Grotesk',sans-serif;font-size:0.85rem;text-decoration:none;transition:border-color 0.2s,color 0.2s;"
             onmouseenter="this.style.borderColor='rgba(196,181,244,0.4)';this.style.color='white'"
             onmouseleave="this.style.borderColor='rgba(255,255,255,0.08)';this.style.color='rgba(255,255,255,0.65)'">{l.label}</a>
        ))}
      </div>
    </div>
  </section>

</Layout>
