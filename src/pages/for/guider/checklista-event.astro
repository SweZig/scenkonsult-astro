---
import Layout from '../../../layouts/Layout.astro';
import GuideLayout from '../../../components/GuideLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article","image":"https://scenkonsult.se/images/hero/scen3_hero.webp",
      "headline": "Komplett checklista för event — teknik, logistik och timing",
      "description": "Komplett checklista för att planera teknik till fest och event. Ljud, ljus, scen, leverans och backup-plan. Nedladdningsbar PDF-version.",
      "author": { "@type": "Organization", "name": "Scenkonsult Norden" },
      "publisher": { "@type": "Organization", "name": "Scenkonsult Norden", "url": "https://scenkonsult.se" },
      "datePublished": "2025-01-01",
      "dateModified": "2026-09-28",
      "url": "https://scenkonsult.se/for/guider/checklista-event/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Vad behöver man tänka på när man hyr AV-utrustning till ett event?", "acceptedAnswer": { "@type": "Answer", "text": "Viktigast: 1) Boka 4–8 veckor i förväg. 2) Mät lokalen och planera placering. 3) Testa utrustningen innan gästerna anländer. 4) Spara jour-numret: 072-448 10 00." } },
        { "@type": "Question", "name": "Hur lång tid innan ska man boka teknik till ett bröllop?", "acceptedAnswer": { "@type": "Answer", "text": "Boka teknik till bröllop minst 2–4 månader i förväg om det är under högsäsongen (maj–september). Populära helger kan vara slutbokade långt i förväg. Vi hanterar även korta varsel om utrustningen är tillgänglig." } },
        { "@type": "Question", "name": "Vad ska man kontrollera i lokalen innan ett event?", "acceptedAnswer": { "@type": "Answer", "text": "Kontrollera: antal eluttag (ett vanligt 10A-uttag räcker oftast, men stora ljudpaket med flera subbasar – eller ljud, ljus och rök tillsammans – behöver el från minst två uttag på olika faser), takhöjd (för hängande ljus), akustik och efterklangstid, möjligheter att köra kablar, eventuella ljud-restriktioner och stängningstider." } }
      ]
    }
  ]
};

const checklistor = [
  {
    fas: "8–12 veckor före",
    icon: "📅",
    items: [
      { done: false, text: "Välj datum och boka lokal" },
      { done: false, text: "Uppskatta antal gäster" },
      { done: false, text: "Bestäm format: dans, middag, konferens, show" },
      { done: false, text: "Besluta om DJ, liveband eller kombination" },
      { done: false, text: "Begär offert på teknik" },
      { done: false, text: "Boka teknik (populära helger tar slut tidigt)" },
    ]
  },
  {
    fas: "4–6 veckor före",
    icon: "🗓",
    items: [
      { done: false, text: "Mät lokalens yta och planera layout" },
      { done: false, text: "Kontrollera eltillgång (antal uttag, ampere)" },
      { done: false, text: "Bestäm placering av scen, PA och ljus" },
      { done: false, text: "Bekräfta leveransdag och leveranstid" },
      { done: false, text: "Boka eventuell tekniker på plats" },
      { done: false, text: "Planera kabelvägar och dolda ledningar" },
    ]
  },
  {
    fas: "1 vecka före",
    icon: "✅",
    items: [
      { done: false, text: "Bekräfta bokning och gå igenom specifikation" },
      { done: false, text: "Skicka lokal-ritning till leverantören" },
      { done: false, text: "Testa all utrustning du hyr (om möjligt)" },
      { done: false, text: "Planera soundcheck-tid på event-dagen" },
      { done: false, text: "Ha backup: reservkablar, extra mikrofon" },
      { done: false, text: "Informera DJ/artist om scenstorlek och setup" },
    ]
  },
  {
    fas: "Event-dagen",
    icon: "🎪",
    items: [
      { done: false, text: "Leverans och uppackning: räkna all utrustning" },
      { done: false, text: "Rigga i rätt ordning: scen → kablage → ljud → ljus" },
      { done: false, text: "Soundcheck: testa alla mikrofoner och kanaler" },
      { done: false, text: "Ljustest: kör igenom alla lägen" },
      { done: false, text: "Dokumentera riggning med foto (vid retur-frågor)" },
      { done: false, text: "Ha tekniker-kontaktnummer lättillgängligt" },
    ]
  },
  {
    fas: "Retur",
    icon: "📦",
    items: [
      { done: false, text: "Packa ner i original-förpackning" },
      { done: false, text: "Rensa och torka av utrustningen" },
      { done: false, text: "Räkna kablar och tillbehör mot leveranslistan" },
      { done: false, text: "Återlämna i tid (normalt dagen efter kl 11:00)" },
      { done: false, text: "Rapportera eventuella skador omgående" },
    ]
  }
];

const lokalKoll = [
  { punkt: "Eltillgång", detalj: "Räkna uttag. Ett vanligt 10A-uttag räcker oftast – stora ljudpaket med flera subbasar, eller ljud, ljus och rök tillsammans, behöver el från minst två uttag på olika faser." },
  { punkt: "Takhöjd", detalj: "Min 2,5 m för normal rigg. Moving heads hänger ofta på 3–4 m." },
  { punkt: "Akustik", detalj: "Hård lokal (sten, glas) = mycket efterklang. Kräver lägre volym och EQ-anpassning." },
  { punkt: "Kabeldragning", detalj: "Planera hur kablar dras utan att folk snubblar. Kabelskydd finns att hyra." },
  { punkt: "Ljudrestriktioner", detalj: "Fråga lokalen om max dB-nivå och stängningstid. Vanligt på hotell och restauranger." },
  { punkt: "Tillgång för leverans", detalj: "Lastbrygga, hiss eller ramp? Scenelement väger 15–30 kg per modul." },
  { punkt: "Underlag för scen", detalj: "Scenen behöver plant, fast underlag. Är höjdskillnaden över scenytan mer än ca 5 cm? Säg till vid bokning så tar vi med justerbara ben — annars kan det bli extra leverans och längre montering." },
];
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'Checklista för event' }];
---

<Layout breadcrumbs={pageBreadcrumbs}
  title="Komplett Checklista för Event — Teknik, Logistik & Timing | Scenkonsult"
  description="Komplett checklista för att planera AV-teknik till fest och event. Ljud, ljus, scen, leverans och backup-plan. Från Scenkonsult — uthyrare sedan 1986."
  schemaExtra={schema}
>
  <GuideLayout eyebrow="Guide & priser" h1Html="Komplett checklista för event" introHtml="Från bokning till retur — allt du behöver tänka på för att få tekniken att fungera. Byggt på erfarenheter från hundratals event sedan 1986." brod={pageBreadcrumbs} sortiment={{ label: "Hela sortimentet", href: "/vara-tjanster/", text: "Ljud, ljus, scen och bild att hyra." }}>


      <!-- Checklistor per fas -->
      {checklistor.map((fas, fi) => (
        <div style={`margin-bottom:2.5rem;${fi > 0 ? 'padding-top:2.5rem;border-top:1px solid rgba(255,255,255,0.07);' : ''}`}>
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1.25rem;">
            <span style="font-size:1.5rem;">{fas.icon}</span>
            <h2 class="gl-h2">{fas.fas}</h2>
          </div>
          <div style="display:flex;flex-direction:column;gap:0;">
            {fas.items.map(item => (
              <div style="display:flex;align-items:flex-start;gap:0.85rem;padding:0.65rem 0;border-bottom:1px solid rgba(255,255,255,0.05);">
                <div style="width:18px;height:18px;border:2px solid rgba(196,181,244,0.3);border-radius:4px;flex-shrink:0;margin-top:0.15rem;"></div>
                <span style="color:rgba(255,255,255,0.7);font-size:0.95rem;">{item.text}</span>
              </div>
            ))}
          </div>
        </div>
      ))}

      <!-- Lokalkoll -->
      <div style="padding-top:2.5rem;border-top:1px solid rgba(255,255,255,0.07);margin-bottom:2.5rem;">
        <h2 class="gl-h2">🏛 Lokalen — vad du måste kontrollera</h2>
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {lokalKoll.map(r => (
            <div style="background:#1e1850;border-radius:10px;padding:1rem 1.25rem;display:flex;gap:1.25rem;align-items:flex-start;">
              <span style="color:#c4b5f4;font-weight:700;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;min-width:130px;flex-shrink:0;">{r.punkt}</span>
              <span style="color:rgba(255,255,255,0.55);font-size:0.88rem;line-height:1.6;">{r.detalj}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Backup-plan -->
      <div style="background:#1e1850;border:1px solid rgba(255,100,100,0.2);border-radius:14px;padding:1.75rem;margin-bottom:3rem;">
        <h2 class="gl-h2">🛟 Backup-plan — ha alltid en plan B</h2>
        <div style="display:flex;flex-direction:column;gap:0.6rem;">
          {[
            "Extra XLR-kablar (minst 2 st per kanal)",
            "Reservmikrofon — minst en extra trådlös",
            "Tekniker-nummret inlagt i mobilen",
            "Vetskap om närmaste elcentral och säkringar",
            "Ström-UPS eller reservgenerator vid kritiska event",
            "Backup-spellista på separat enhet (USB + dator)",
          ].map(i => (
            <div style="display:flex;gap:0.75rem;align-items:flex-start;">
              <span style="color:#fbbf24;font-size:0.8rem;margin-top:0.2rem;flex-shrink:0;">⚡</span>
              <span style="color:rgba(255,255,255,0.65);font-size:0.9rem;">{i}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA -->
      

      <div class="gl-rel">
        <p class="gl-rel-rubrik">Alla guider</p>
        <div class="gl-rel-lista">
          <a href="/for/guider/hur-stor-pa/" class="gl-chip">Hur stor PA?</a>
          <a href="/for/guider/hur-stor-scen/" class="gl-chip">Hur stor scen?</a>
          <a href="/for/guider/dj-eller-liveband/" class="gl-chip">DJ eller liveband?</a>
          <a href="/for/guider/ljussattning-tips/" class="gl-chip">Ljussättning</a>
          <a href="/for/guider/ljud-utomhus/" class="gl-chip">Ljud utomhus</a>
          <a href="/for/guider/vad-kostar-det/" class="gl-chip">Vad kostar det?</a>
        </div>
      </div>
  </GuideLayout>
</Layout>
