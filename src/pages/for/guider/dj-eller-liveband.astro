---
import Layout from '../../../layouts/Layout.astro';
import GuideLayout from '../../../components/GuideLayout.astro';
import djData from '../../../data/dj.json';
import ljudData from '../../../data/ljud.json';
import sceneData from '../../../data/scenes.json';

const _dp = (djData.equipment as any[]);
const dp = (artno: string) => _dp.find((x:any) => x.artno === artno)?.price ?? 0;
const lp = (artno: string) => [
  ...ljudData.event.products,
  ...ljudData.music.products,
  ...ljudData.live.products,
  ...(ljudData.portable.products as any[]),
  ...((ljudData as any).mixers ?? []),
].find(x => x.artno === artno)?.price ?? 0;
const sp = (artno: string) => [
  ...(sceneData.products as any[]),
  ...((sceneData as any).accessories ?? []),
].find(x => x.artno === artno)?.price ?? 0;
// DJ-service priser härleds från equipment[] (master). Inkl moms = ×1.25.
const _djEq = (djData.equipment as any[]);
const _svc = (tier:string, hours:string) => _djEq.find(p => p.category === 'DJ-tjänst' && p.tier === tier && p.hours === hours);
const djService = ['2 tim','3 tim','4 tim'].map(hours => {
  const j = _svc('junior', hours), s = _svc('senior', hours);
  return {
    tid: hours,
    junior: j?.price ?? 0, juniorInkl: Math.round((j?.price ?? 0) * 1.25),
    senior: s?.price ?? 0, seniorInkl: Math.round((s?.price ?? 0) * 1.25),
  };
});

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","image":"https://scenkonsult.se/images/hero/scen3_hero.webp","headline":"DJ eller liveband? Ärlig jämförelse 2025","author":{"@type":"Organization","name":"Scenkonsult Norden"},"datePublished":"2025-01-01","url":"https://scenkonsult.se/for/guider/dj-eller-liveband/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Vad kostar en DJ till bröllop?","acceptedAnswer":{"@type":"Answer","text":`Via Scenkonsult kostar en junior DJ ${dp("SK-DJ-0009")} kr (2 tim) upp till ${dp("SK-DJ-0011")} kr (4 tim) exkl moms. Senior DJ ${dp("SK-DJ-0012")}–${dp("SK-DJ-0014")} kr exkl moms. DJ-hårdvara ingår.`}},{"@type":"Question","name":"Vad kostar det att hyra DJ-utrustning?","acceptedAnswer":{"@type":"Answer","text":`Numark Mixstream Pro+ kostar ${dp("SK-DJ-0001")} kr/dygn. Denon Prime GO+ ${dp("SK-DJ-0002")} kr/dygn. Denon Prime 4+ ${dp("SK-DJ-0003")} kr/dygn. Rane System One ${dp("SK-DJ-0004")} kr/dygn. Alla priser exkl moms.`}},{"@type":"Question","name":"Kan man kombinera DJ och liveband?","acceptedAnswer":{"@type":"Answer","text":`Ja — liveband under cocktail/middag, DJ på dansgolvet. Det kräver scen (fr Scenpaket Medium+ ${sp("SK-SCN-0005")} kr/dygn) och PA som funkar för båda (Music-serien fr ${lp("SK-LJD-MUS-0001")} kr/dygn).`}}]}]};
const djUtrustning = [
  {n:"Numark Mixstream Pro+",p:dp("SK-DJ-0001"),d:"Standalone, WiFi-streaming inbyggt. Spotify, Tidal, SoundCloud. Inga kablar till laptop.",link:"/vara-tjanster/hyra-dj/"},
  {n:"Denon Prime GO+",p:dp("SK-DJ-0002"),d:"Kompakt 2-deck standalone. Batteri + WiFi. Perfekt för mindre event.",link:"/vara-tjanster/hyra-dj/"},
  {n:"Denon Prime 4+",p:dp("SK-DJ-0003"),d:"4-deck standalone. Stor skärm, inbyggt ljudkort. Professionell setup utan laptop.",link:"/vara-tjanster/hyra-dj/"},
  {n:"Rane System One",p:dp("SK-DJ-0004"),d:"Professionellt Serato-system. Valt av toppnamn. Magistralt ljud och byggkvalitet.",link:"/vara-tjanster/hyra-dj/"},
];
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'DJ eller liveband?' }];
---
<Layout breadcrumbs={pageBreadcrumbs} title="DJ eller Liveband? Ärlig Jämförelse 2026 | Scenkonsult" description="DJ vs liveband — pris, stämning, logistik och teknikkrav. Konkreta priser från Scenkonsults sortiment. Uthyrare sedan 1986." schemaExtra={schema}>
  <GuideLayout eyebrow="Guide & priser" h1Html="DJ eller liveband till festen?" introHtml="Ärlig jämförelse med konkreta priser från vårt sortiment — ingen grönsaksinformation." brod={pageBreadcrumbs} sortiment={{ label: "Hyra DJ", href: "/vara-tjanster/hyra-dj/", text: "Erfarna DJ:s för fest och bröllop." }}>

      <div class="g2c" style="margin-bottom:3rem;">
        {[{t:"Välj DJ om…",items:["Budget under 10 000 kr",  "Dansgolvet är prioritet","Stor musikbredd önskas","Lång kväll (4+ tim)","Litet utrymme"],c:"#c4b5f4"},{t:"Välj liveband om…",items:["WOW-effekten är viktig","Budget tillåter 20 000+","Gästerna är 40+ år","Cocktail/middag-format","Unikt minnesmärke"],c:"#86efac"}].map(k=>(
          <div style={`background:#1e1850;border:1px solid ${k.c}22;border-radius:14px;padding:1.5rem;`}>
            <h3 style={`font-family:'Space Grotesk',sans-serif;font-size:0.82rem;font-weight:700;color:${k.c};text-transform:uppercase;letter-spacing:0.08em;margin:0 0 1rem;`}>{k.t}</h3>
            {k.items.map(i=><div style="display:flex;gap:0.6rem;padding:0.3rem 0;"><span style={`color:${k.c};font-size:0.75rem;flex-shrink:0;`}>✓</span><span style="color:rgba(255,255,255,0.65);font-size:0.85rem;">{i}</span></div>)}
          </div>
        ))}
      </div>

      <h2 class="gl-h2">Hyra DJ-utrustning — vårt sortiment</h2>
      <p style="margin-bottom:1.25rem;">Vi hyr ut standalone DJ-controllers — de behöver <strong style="color:white;">ingen laptop</strong> och har <strong style="color:white;">inbyggd streaming</strong> (Spotify, Tidal, SoundCloud, Amazon Music). Läs mer om varför vi valt dessa modeller i vår guide om <a href="/for/guider/varfor-numark-denon-rane/" style="color:#c4b5f4;">DJ-utrustning och streaming</a>.</p>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:2.5rem;">
        {djUtrustning.map(d=>(
          <div style="background:#1e1850;border-radius:12px;padding:1.25rem 1.5rem;display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-start;flex-wrap:wrap;">
            <div>
              <div style="color:white;font-weight:700;font-size:0.95rem;margin-bottom:0.35rem;">{d.n}</div>
              <div style="color:rgba(255,255,255,0.5);font-size:0.87rem;line-height:1.55;">{d.d}</div>
            </div>
            <div style="text-align:right;flex-shrink:0;">
              <div style="color:#c4b5f4;font-family:'DM Serif Display',serif;font-size:1.5rem;white-space:nowrap;"><span data-exkl={d.p}>{d.p}</span> kr</div>
              <div style="color:rgba(255,255,255,0.60);font-size:0.72rem;">per dygn</div>
            </div>
          </div>
        ))}
      </div>
      <p style="color:rgba(255,255,255,0.60);font-size:0.82rem;margin-bottom:3rem;">Tekniker/DJ-bord: <span data-exkl={dp("SK-DJ-0005")}>{dp("SK-DJ-0005")}</span> kr/dygn. DJ-bord med paneler: <span data-exkl={dp("SK-DJ-0006")}>{dp("SK-DJ-0006")}</span> kr/dygn.</p>

      <h2 class="gl-h2">Hyr professionell DJ — priser</h2>
      <p style="margin-bottom:1.25rem;">DJ-hårdvara ingår i priset. Resa, scen, ljud och ljus tillkommer.</p>
      <div style="overflow-x:auto;margin-bottom:2.5rem;">
        <table style="width:100%;border-collapse:collapse;font-size:0.87rem;">
          <thead><tr style="border-bottom:2px solid rgba(196,181,244,0.25);">
            <th class="gl-th">Speltid</th>
            <th class="gl-th">Junior DJ</th>
            <th class="gl-th">Senior DJ</th>
          </tr></thead>
          <tbody>{djService.map((r,i)=>(
            <tr style={`border-bottom:1px solid rgba(255,255,255,0.06);background:${i%2===0?'transparent':'rgba(255,255,255,0.02)'}`}>
              <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;">{r.tid}</td>
              <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.7);"><span data-exkl={r.junior}>{r.junior}</span> kr</td>
              <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.7);"><span data-exkl={r.senior}>{r.senior}</span> kr</td>
            </tr>
          ))}</tbody>
        </table>
      </div>

      <h2 class="gl-h2">Kombination: liveband + DJ</h2>
      <p>Det bästa av två världar: liveband under cocktail/middag, DJ på dansgolvet. Tekniken som behövs:</p>
      <div class="g2c" style="margin-bottom:2.5rem;">
        {[
          {t:"Ljud", items:[
            `Music Medium (${lp("SK-LJD-MUS-0003")} kr) — täcker hela lokalen`,
            `Mixer 12 kanal (${lp("SK-LJD-MIX-0011")} kr) — hanterar band + DJ`,
          ]},
          {t:"Scen", items:[
            `Scenpaket Medium+ (${sp("SK-SCN-0005")} kr) — passar band och DJ`,
            `Scentrapp 60 cm (${sp("SK-SCN-ACC-0002")} kr)`,
          ]},
        ].map(k=>(
          <div style="background:#1e1850;border-radius:12px;padding:1.25rem;">
            <h3 style="font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:700;color:#c4b5f4;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 0.75rem;">{k.t}</h3>
            {k.items.map(i=><div style="display:flex;gap:0.5rem;padding:0.3rem 0;"><span style="color:#86efac;font-size:0.75rem;flex-shrink:0;">✓</span><span style="color:rgba(255,255,255,0.6);font-size:0.85rem;">{i}</span></div>)}
          </div>
        ))}
      </div>
  </GuideLayout>
</Layout>
