---
import Layout from '../../../layouts/Layout.astro';
import GuideLayout from '../../../components/GuideLayout.astro';
import ljudData from '../../../data/ljud.json';
import { telefon } from '../../../utils/hours';

// Prisuppslag från JSON — uppdateras automatiskt vid prisändring
const _allProds = [
  ...ljudData.event.products,
  ...(ljudData.portable.products as any[]),
  ...ljudData.music.products,
  ...ljudData.live.products,
];
const p = (artno: string): number => (_allProds as any[]).find(x => x.artno === artno)?.price ?? 0;

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","image":"https://scenkonsult.se/images/hero/scen3_hero.webp","headline":"Hur stor PA-anläggning behöver jag? Guide 2025","author":{"@type":"Organization","name":"Scenkonsult Norden"},"datePublished":"2025-01-01","url":"https://scenkonsult.se/for/guider/hur-stor-pa/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Hur stor PA behöver jag för 100 gäster?","acceptedAnswer":{"@type":"Answer","text":`For 100 gäster inomhus med dans: Music Small (${p('SK-LJD-MUS-0001')} kr/dygn exkl moms). Enbart tal: Event Small (${p('SK-LJD-EVE-0001')} kr). Utomhus: Music Medium (${p('SK-LJD-MUS-0003')} kr).`}},{"@type":"Question","name":"Vad är skillnaden på Portable, Event, Music och Live?","acceptedAnswer":{"@type":"Answer","text":"Portable = kompakt plug-and-play under 50 gäster. Event = konferens/tal. Music = dans/DJ med sub. Live = liveband med monitor-utgångar."}},{"@type":"Question","name":"Behöver jag subbasen?","acceptedAnswer":{"@type":"Answer","text":"Till dans och DJ: ja. Music-paketen inkluderar subwoofer. Till tal räcker Event-serien."}},{"@type":"Question","name":"Hur mycket effekt behövs utomhus?","acceptedAnswer":{"@type":"Answer","text":"Välj alltid ett steg upp jämfört med inomhus-rekommendationen. Utomhus saknas reflektioner från väggar och tak."}}]}]};
const inomhus = [
  {g:"10–50", typ:"Tal, mingel", paket:"Portable Small", pris:p("SK-LJD-POR-0001"), sub:"Nej", link:"/vara-tjanster/hyra-ljud/portable/"},
  {g:"20–80", typ:"Fest, ej dans", paket:"Portable Medium", pris:p("SK-LJD-POR-0003"), sub:"Nej", link:"/vara-tjanster/hyra-ljud/portable/"},
  {g:"50–100", typ:"Konferens, föreläsning", paket:"Event Small", pris:p("SK-LJD-EVE-0001"), sub:"Nej", link:"/vara-tjanster/hyra-ljud/event/"},
  {g:"50–100", typ:"Fest, dans, DJ", paket:"Music Small", pris:p("SK-LJD-MUS-0001"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/music/"},
  {g:"100–200", typ:"Event/konferens", paket:"Event Medium", pris:p("SK-LJD-EVE-0002"), sub:"Nej", link:"/vara-tjanster/hyra-ljud/event/"},
  {g:"100–200", typ:"Dansfest, liveband", paket:"Music Medium", pris:p("SK-LJD-MUS-0003"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/music/"},
  {g:"200–500", typ:"Stor fest, DJ", paket:"Music Large", pris:p("SK-LJD-MUS-0004"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/music/"},
  {g:"200–500", typ:"Konsert, liveband", paket:"Live Large", pris:p("SK-LJD-LIV-0003"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/live/"},
  {g:"500+", typ:"Stor DJ-fest", paket:"Music XL", pris:p("SK-LJD-MUS-0005"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/music/"},
  {g:"500+", typ:"Festival, stor konsert", paket:"Live XL / Line Array", pris:p("SK-LJD-MUS-0008"), sub:"Ingår", link:"/vara-tjanster/hyra-ljud/live/"},
];
const utomhus = [
  {g:"10–50", paket:"Portable Large", pris:p("SK-LJD-POR-0006"), k:"Minsta alternativ utomhus"},
  {g:"50–100", paket:"Event Medium", pris:p("SK-LJD-EVE-0002"), k:"Tal och mingel utomhus"},
  {g:"50–150", paket:"Music Small+", pris:p("SK-LJD-MUS-0002"), k:"Dans utomhus – rekommenderat minimum"},
  {g:"150–300", paket:"Music Large", pris:p("SK-LJD-MUS-0004"), k:"Bra täckning utomhus"},
  {g:"300+", paket:"Music XL+", pris:p("SK-LJD-MUS-0006"), k:"Kontakta oss för anpassning"},
];
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'Guider', href: '/for/guider/' }, { label: 'Hur stor PA?' }];
---
<Layout breadcrumbs={pageBreadcrumbs} title="Hur Stor PA-anläggning Behöver Jag? Guide 2026 | Scenkonsult" description={`Rätt PA-system för ditt event. Tabeller inomhus/utomhus, gästantal, eventtyp. Priser fr ${p('SK-LJD-POR-0001')} kr/dygn — Scenkonsult sedan 1986.`} schemaExtra={schema}>
  <GuideLayout eyebrow="Guide & priser" h1Html="Hur stor PA-anläggning behöver jag?" introHtml="Alla priser matchar direkt mot produkterna i vårt sortiment — inga generiska siffror." brod={pageBreadcrumbs} sortiment={{ label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/", text: "Alla PA-paket med priser." }}>

      <div class="gl-snabb">
        <p class="gl-snabb-rubrik">Snabbsvar</p>
        <ul style="margin:0;padding:0 0 0 1.25rem;display:flex;flex-direction:column;gap:0.5rem;">
          <li><strong style="color:white;">Under 50 gäster, tal:</strong> <a href="/vara-tjanster/hyra-ljud/portable/" style="color:#c4b5f4;">Portable Small</a> — <span class="sk-price-excl" data-exkl={p("SK-LJD-POR-0001")}>{p("SK-LJD-POR-0001")}</span> kr/dygn</li>
          <li><strong style="color:white;">50–100 gäster med dans:</strong> <a href="/vara-tjanster/hyra-ljud/music/" style="color:#c4b5f4;">Music Small</a> — <span class="sk-price-excl" data-exkl={p("SK-LJD-MUS-0001")}>{p("SK-LJD-MUS-0001")}</span> kr/dygn</li>
          <li><strong style="color:white;">100–200 gäster, dans:</strong> <a href="/vara-tjanster/hyra-ljud/music/" style="color:#c4b5f4;">Music Medium</a> — <span class="sk-price-excl" data-exkl={p("SK-LJD-MUS-0003")}>{p("SK-LJD-MUS-0003")}</span> kr/dygn</li>
          <li><strong style="color:white;">Utomhus:</strong> Välj alltid ett steg upp i paketserie</li>
        </ul>
      </div>
      <h2 class="gl-h2">Våra fyra paketserier</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:0.75rem;margin-bottom:2.5rem;">
        {[{n:"Portable",d:"Kompakt, plug-and-play. Perfekt under 50 gäster.",l:"/vara-tjanster/hyra-ljud/portable/"},{n:"Event",d:"Konferens och tal. Tydlig talåtergivning utan sub.",l:"/vara-tjanster/hyra-ljud/event/"},{n:"Music",d:"Dans och DJ. Sub ingår. Bred frekvensåtergivning.",l:"/vara-tjanster/hyra-ljud/music/"},{n:"Live",d:"Liveband. Monitor-ingångar, återkopplingsskydd.",l:"/vara-tjanster/hyra-ljud/live/"}].map(p=>(
          <a href={p.l} style="background:#1e1850;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:1rem;text-decoration:none;display:block;">
            <div style="color:#c4b5f4;font-family:'Space Grotesk',sans-serif;font-size:0.85rem;font-weight:700;margin-bottom:0.4rem;">{p.n}</div>
            <div style="color:rgba(255,255,255,0.60);font-size:0.82rem;line-height:1.5;">{p.d}</div>
          </a>
        ))}
      </div>
      <h2 class="gl-h2">Inomhus — rekommenderade paket</h2>
      <div style="overflow-x:auto;margin-bottom:2.5rem;">
        <table style="width:100%;border-collapse:collapse;font-size:0.87rem;">
          <thead><tr style="border-bottom:2px solid rgba(196,181,244,0.25);">{["Gäster","Eventtyp","Paket","Pris/dygn","Sub"].map(h=><th class="gl-th">{h}</th>)}</tr></thead>
          <tbody>{inomhus.map((r,i)=>(
            <tr style={`border-bottom:1px solid rgba(255,255,255,0.06);background:${i%2===0?'transparent':'rgba(255,255,255,0.02)'}`}>
              <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;white-space:nowrap;">{r.g}</td>
              <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.6);">{r.typ}</td>
              <td style="padding:0.75rem 0.5rem;"><a href={r.link} style="color:#c4b5f4;text-decoration:none;">{r.paket}</a></td>
              <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;white-space:nowrap;"><span data-exkl={r.pris}>{r.pris}</span> kr</td>
              <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.5);">{r.sub}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>
      <h2 class="gl-h2">Utomhus — rekommenderade paket</h2>
      <p style="margin-bottom:1.25rem;">Utomhus saknas reflektioner från väggar och tak — välj alltid ett steg upp jämfört med inomhusrekommendationen.</p>
      <div style="overflow-x:auto;margin-bottom:2.5rem;">
        <table style="width:100%;border-collapse:collapse;font-size:0.87rem;">
          <thead><tr style="border-bottom:2px solid rgba(196,181,244,0.25);">{["Gäster","Paket","Pris/dygn","Kommentar"].map(h=><th class="gl-th">{h}</th>)}</tr></thead>
          <tbody>{utomhus.map((r,i)=>(
            <tr style={`border-bottom:1px solid rgba(255,255,255,0.06);background:${i%2===0?'transparent':'rgba(255,255,255,0.02)'}`}>
              <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;">{r.g}</td>
              <td style="padding:0.75rem 0.5rem;"><a href="/vara-tjanster/hyra-ljud/" style="color:#c4b5f4;text-decoration:none;">{r.paket}</a></td>
              <td style="padding:0.75rem 0.5rem;color:white;font-weight:600;white-space:nowrap;"><span data-exkl={r.pris}>{r.pris}</span> kr</td>
              <td style="padding:0.75rem 0.5rem;color:rgba(255,255,255,0.5);font-size:0.85rem;">{r.k}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>
      <h2 class="gl-h2">3 vanliga misstag</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:2.5rem;">
        {[{nr:"01",t:"Event-paketet till dans",d:"Event-serien saknar subwoofer och klippar bassen vid höga volymer. Välj Music-serien när det ska danssas."},{nr:"02",t:"Underdimensionera utomhus",d:"Välj alltid ett paket upp. Utomhus försvinner reflektionerna och ljudet tappar volym och bas."},{nr:"03",t:"Glömma mikrofoner",d:"PA-paketen inkluderar högtalare. Lägg till handmikrofon och mixerbord om du behöver prata."}].map(m=>(
          <div style="background:#1e1850;border-radius:10px;padding:1.25rem 1.5rem;display:flex;gap:1.25rem;">
            <span style="font-family:'DM Serif Display',serif;font-size:1.75rem;color:rgba(196,181,244,0.25);line-height:1;flex-shrink:0;">{m.nr}</span>
            <div><h3 style="font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:700;color:white;margin:0 0 0.4rem;">{m.t}</h3><p style="color:rgba(255,255,255,0.55);font-size:0.88rem;line-height:1.65;margin:0;">{m.d}</p></div>
          </div>
        ))}
      </div>
      
      <div class="gl-rel">
        <p class="gl-rel-rubrik">Relaterade guider</p>
        <div class="gl-rel-lista">
          <a href="/for/guider/hur-stor-scen/" class="gl-chip">Hur stor scen?</a>
          <a href="/for/guider/ljud-utomhus/" class="gl-chip">Ljud utomhus</a>
          <a href="/for/guider/checklista-event/" class="gl-chip">Komplett checklista</a>
        </div>
      </div>
  </GuideLayout>
</Layout>
