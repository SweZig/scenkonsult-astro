---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventOmraden from '../../../components/event/EventOmraden.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import KundRad from '../../../components/event/KundRad.astro';
import EventBilder from '../../../components/EventBilder.astro';
import bildData from '../../../data/bild.json';
import ljudData from '../../../data/ljud.json';

const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const portMedPlus = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0004');
const shureHeadset = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0023');
const shureMygga = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0022');
const projektor = bildData.products.find((p:any) => p.artno === 'SK-BLD-0002');
const skarm65 = bildData.products.find((p:any) => p.artno === 'SK-BLD-0003');

import { buildPaket3, fmtKr, type PaketDef } from '../../../utils/paket';

const konfPaketDefs: PaketDef[] = [
  {
    namn: 'Litet möte / seminarium',
    gaster: '20–50 deltagare',
    rader: [
      { artno: 'SK-LJD-POR-0003', label: '1× kolumnhögtalare (Alto TS108C)' },
      { artno: 'SK-LJD-MIK-0016', label: '1× trådlös handmikrofon' },
      { artno: 'SK-BLD-0002', label: '1× projektor Full HD' },
      { artno: 'SK-BLD-ACC-0002', label: '1× projektorduk 100″' },
    ],
  },
  {
    namn: 'Medelstort event',
    gaster: '50–150 deltagare',
    featured: true,
    rader: [
      { artno: 'SK-LJD-POR-0004', label: '1× kolumnhögtalare (Alto TS112C)' },
      { artno: 'SK-LJD-MIK-0023', label: 'Shure SLXD headset — talare' },
      { artno: 'SK-LJD-MIK-0022', label: 'Shure SLXD myggmikrofon' },
      { artno: 'SK-BLD-0007', label: '1× projektor 4K UHD' },
      { artno: 'SK-BLD-ACC-0002', label: '1× projektorduk 100″' },
    ],
  },
  {
    namn: 'Stor konferens / föreläsning',
    gaster: '150–500 deltagare',
    rader: [
      { artno: 'SK-LJD-EVE-0002', label: 'PA Event Medium (2× 12″)' },
      { artno: 'SK-LJD-MIK-0028', label: 'Shure SLXD — 2 headset' },
      { artno: 'SK-BLD-0003', label: '65″ 4K-skärm' },
      { artno: 'SK-BLD-ACC-0003', label: 'Golvstativ för skärm' },
    ],
  },
];
const konfPaket = buildPaket3(konfPaketDefs);

const faq = [
  {
    q: "Vilket PA-system passar en konferens för 100 personer?",
    a: "För 100 personer i en normal konferenslokal passar kolumnhögtalare (som Alto TS112C) utmärkt — diskret design, brett ljudspridning och enkel styrning via app. Behöver ni mer volym eller salen är stor rekommenderar vi Event Small-paketet."
  },
  {
    q: "Hur hanterar ni mikrofoner för panel och Q&A?",
    a: "Vi hyr ut trådlösa handmikrofoner, headset och bordsmikrofoner. För Q&A-format är trådlösa handmikrofoner att föredra — en för moderatorn och en eller flera att skicka runt i publiken."
  },
  {
    q: "Kan ni kombinera projektor och ljud i ett paket?",
    a: "Ja, vi sätter ihop kompletta AV-paket anpassade för er lokal. Berätta om lokalens storlek och antal sittplatser så rekommenderar vi rätt projektorstyrka och PA-system."
  },
  {
    q: "Kan ni leverera och montera samma dag?",
    a: "Ja, vid tillgänglighet. Vi rekommenderar att boka med minst 2–3 dagars framförhållning. Ring oss direkt för akuta bokningar — 072-448 10 00."
  },
  {
    q: "Hur fungerar betalning för företag och offentlig sektor?",
    a: "Vi fakturerar med individuella betalningsvillkor för registrerade företag och myndigheter (vanligen 5–30 dagar beroende på kreditrating). Företag utan kreditmöjlighet kan betala vid hämtning med kort eller med Swish. Vi kan utfärda offerter och orderbekräftelser för upphandlingsprocesser."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av AV-utrustning och konferensteknik i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr AV-utrustning, mikrofoner, projektorer och PA-system till konferenser och föreläsningar i Stockholm.",
      "url": "https://scenkonsult.se/for/konferens/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra AV-utrustning & Mikrofoner till Konferens Stockholm | Scenkonsult"
  description="Hyr projektor, PA-system och mikrofoner till konferens och föreläsning i Stockholm. Leverans & montering. Faktura med individuella villkor för företag. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    bild={{ src: "/images/event/kundevent_abg_konferens.webp", w: 1600, alt: "ABG Sundal Collier konferens med LED-skärmar och uplight", text: "ABG Sundal Collier — konferens" }}
    knappar={[{ label: "Se konferenspaketen", href: "#paket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="För ditt event · Konferens & föreläsning"
    h1="AV-teknik till konferens i"
    h1Accent="Stockholm"
    intro="Professionellt ljud och bild för presentationer, paneldiskussioner, föreläsningar och hybridmöten. Vi levererar och monterar — ni fokuserar på innehållet."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Konferens & föreläsning" }
    ]}
    chips={[
      "Faktura med individuella villkor",
      "Leverans & montering i Storstockholm",
      "Konferens 20–500 deltagare",
      "Tekniker på plats tillgängligt",
    ]}
  />

  <EventOmraden
    eyebrow="AV-utrustning"
    rubrik="Allt för ett professionellt konferensljud"
    lead="Dåligt ljud tvingar deltagarna att anstränga sig — det tömmer energi och fokus. Vi hyr ut utrustning som låter bra och är enkel att använda, med eller utan tekniker på plats."
    omraden={[
      { titel: "Kolumnhögtalare", text: "Diskreta, bred täckning och styrbara via app — för konferenssalar och föreläsningslokaler.", href: "/vara-tjanster/hyra-ljud/kolumnhogtalare/" },
      { titel: "Trådlösa mikrofoner", text: "Hand, headset och mygga för tydligt tal utan störningar.", href: "/vara-tjanster/konferens-av/#mikrofoner" },
      { titel: "Projektor & duk", text: "Projektorer och dukar för konferenssalar i alla storlekar.", href: "/vara-tjanster/hyra-bild-projektorer-skarmar/" },
      { titel: "Skärmar på stativ", text: "Skarpa och tysta skärmar för presentationer och bildspel.", href: "/vara-tjanster/hyra-bild-projektorer-skarmar/" },
    ]}
  />

  <EventPaket
    eyebrow="Rekommenderade paket"
    rubrik="Rätt paket för er storlek"
    lead="Tre utgångspunkter efter antal deltagare. Lägg det i varukorgen som det är, eller begär offert så justerar vi."
    paket={konfPaket}
    notis="Priserna är summan av paketets artiklar per dygn. Tekniker, leverans och montering tillkommer och offereras separat. Faktura med individuella villkor för företag."
  />

  <ProduktRader
    eyebrow="Populärt till konferens"
    rubrik="Lägg i varukorgen direkt"
    lead="Det som oftast hyrs till konferens, styckvis. Hela utbudet finns på sidan för konferens-AV."
    rader={[
      { produkt: portMedium, not: "Kolumnhögtalare för mindre salar", kategori: "Ljud" },
      { produkt: portMedPlus, not: "Mer räckvidd för större salar", kategori: "Ljud" },
      { produkt: shureHeadset, not: "Talare som rör sig fritt", kategori: "Ljud" },
      { produkt: shureMygga, not: "Diskret för panel och moderator", kategori: "Ljud" },
      { produkt: projektor, not: "Ljusstark, HDMI", kategori: "Bild" },
      { produkt: skarm65, not: "För ljusa rum", kategori: "Bild" },
    ]}
    lankar={[{ label: "Konferens-AV", href: "/vara-tjanster/konferens-av/" }, { label: "Projektor & skärm", href: "/vara-tjanster/hyra-bild-projektorer-skarmar/" }]}
  />

  <EventBilder kategori="konferens" />

  <KundRad rubrik="Anlitade av bland annat" />

  <EventFaq rubrik="Konferensteknik — vanliga frågor" faq={faq} extra={'Generösa avbokningsregler — <a href="/hyresvillkor/">läs hyresvillkoren</a>.'} />

  <SlutRuta rubrik="Berätta om er konferens — vi föreslår en lösning." text="Kostnadsfritt och inte bindande. Faktura med individuella villkor för företag." />

</Layout>
