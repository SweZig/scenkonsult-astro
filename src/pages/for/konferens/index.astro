---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import ProductCard from '../../../components/ProductCard.astro';
import bildData from '../../../data/bild.json';
import ljudData from '../../../data/ljud.json';

const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const portMedPlus = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0004');
const shureHeadset = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0023');
const shureMygga = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0022');
const projektor = bildData.products.find((p:any) => p.artno === 'SK-BLD-0002');
const skarm65 = bildData.products.find((p:any) => p.artno === 'SK-BLD-0003');

const faq = [
  {
    q: "Vilket PA-system passar en konferens för 100 personer?",
    a: "För 100 personer i en normal konferenslokal passar kolumnhögtalare (som Alto TS112C) utmärkt — diskret design, brett ljudspridning och enkel styrning via app. Behöver ni mer volym eller salen är stor rekommenderar vi Event Small-paketet."
  },
  {
    q: "Hur hanterar ni mikrofoner för panel och Q&A?",
    a: "Vi hyr ut trådlösa handmikrofoner, headset och bordsmikrofoner. För Q&A-format är trådlösa handmikrofoner att föredra — en för moderatorn och en eller flera att skicka runt i publiken."
  },
  {
    q: "Kan ni kombinera projektor och ljud i ett paket?",
    a: "Ja, vi sätter ihop kompletta AV-paket anpassade för er lokal. Berätta om lokalens storlek och antal sittplatser så rekommenderar vi rätt projektorstyrka och PA-system."
  },
  {
    q: "Kan ni leverera och montera samma dag?",
    a: "Ja, vid tillgänglighet. Vi rekommenderar att boka med minst 2–3 dagars framförhållning. Ring oss direkt för akuta bokningar — 072-448 10 00."
  },
  {
    q: "Hur fungerar betalning för företag och offentlig sektor?",
    a: "Vi fakturerar med individuella betalningsvillkor för registrerade företag och myndigheter (vanligen 5–30 dagar beroende på kreditrating). Företag utan kreditmöjlighet kan betala vid hämtning med kort eller med Swish. Vi kan utfärda offerter och orderbekräftelser för upphandlingsprocesser."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av AV-utrustning och konferensteknik i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Palmfeltsvägen 5",
          "addressLocality": "Stockholm",
          "postalCode": "121 62",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr AV-utrustning, mikrofoner, projektorer och PA-system till konferenser och föreläsningar i Stockholm.",
      "url": "https://scenkonsult.se/for/konferens/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra AV-utrustning & Mikrofoner till Konferens Stockholm | Scenkonsult"
  description="Hyr projektor, PA-system och mikrofoner till konferens och föreläsning i Stockholm. Leverans & montering. Faktura med individuella villkor för företag. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    eyebrow="För ditt event · Konferens & föreläsning"
    h1="AV-teknik till konferens i"
    h1Accent="Stockholm"
    intro="Professionellt ljud och bild för presentationer, paneldiskussioner, föreläsningar och hybridmöten. Vi levererar och monterar — ni fokuserar på innehållet."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Konferens & föreläsning" }
    ]}
    chips={[
      "Faktura med individuella villkor",
      "Leverans & montering i Storstockholm",
      "Konferens 20–500 deltagare",
      "Tekniker på plats tillgängligt",
    ]}
  />

  <!-- Utrustning för konferens -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">AV-utrustning</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.8rem,4vw,2.8rem); color:white; margin:0 0 1.25rem; max-width:680px;">Allt för ett professionellt konferensljud</h2>
      <p style="color:rgba(255,255,255,0.55); font-size:1rem; line-height:1.75; max-width:640px; margin:0 0 3rem;">Dåligt ljud tvingar deltagarna att anstränga sig för att höra — det tömmer energi och fokus. Vi hyr ut utrustning som låter bra och är enkel att använda, med eller utan tekniker på plats.</p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(250px,1fr)); gap:1.5rem;">
        {[
          { icon: "🔊", title: "Kolumnhögtalare", desc: "Alto TS112C — diskret, bred täckning, styrbar via app. Perfekt för konferenssalar och föreläsningslokaler.", link: "/vara-tjanster/hyra-ljud/", cta: "Se ljud" },
          { icon: "🎤", title: "Trådlösa mikrofoner", desc: "Hand, headset och bordsmikrofoner. Shure och AKG för kristallklart tal utan störningar.", link: "/vara-tjanster/hyra-ljud/", cta: "Se mikrofoner" },
          { icon: "📽️", title: "Projektor & duk", desc: "4000–7000 lumen projektorer. Dukar från 180 till 400 cm. Passar konferenssalar i alla storlekar.", link: "/vara-tjanster/hyra-bild-projektorer-skarmar/", cta: "Se projektorer" },
          { icon: "📺", title: "LED-skärmar & TV", desc: "Platta skärmar på stativ för presentationer och bildspel. Skarpa och tysta — inga fläktljud.", link: "/vara-tjanster/hyra-bild-projektorer-skarmar/", cta: "Se skärmar" }
        ].map(item => (
          <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:1.75rem; display:flex; flex-direction:column; gap:0.75rem;">
            <div style="font-size:1.75rem;">{item.icon}</div>
            <h3 style="font-family:'DM Serif Display',serif; font-size:1.2rem; color:white; margin:0;">{item.title}</h3>
            <p style="color:rgba(255,255,255,0.55); font-size:0.88rem; line-height:1.65; margin:0; flex:1;">{item.desc}</p>
            <a href={item.link} style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.78rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; text-decoration:none;">{item.cta} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Setup-guide -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div class="g2c" style="max-width:1100px; margin:0 auto;">
      <div>
        <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Rekommenderade paket</p>
        <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 1.5rem;">Rätt paket för er storlek</h2>

        {[
          {
            size: "Litet möte / seminarium",
            guests: "20–50 deltagare",
            items: ["1× kolumnhögtalare", "1× trådlös handmick", "1× projektor 4000 lumen", "1× projektorduk 180 cm"]
          },
          {
            size: "Medelstort event",
            guests: "50–150 deltagare",
            items: ["2× kolumnhögtalare stereo", "2× trådlösa mikrofoner", "1× projektor 6000 lumen", "1× duk 250 cm + stativ"]
          },
          {
            size: "Stor konferens / föreläsning",
            guests: "150–500 deltagare",
            items: ["PA Event Medium med subs", "4× trådlösa mikrofoner", "Dubbla projektorer eller LED-vägg", "Tekniker ingår i priset"]
          }
        ].map(p => (
          <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:1.5rem; margin-bottom:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
              <h3 style="font-family:'Space Grotesk',sans-serif; font-size:0.95rem; font-weight:700; color:white; margin:0;">{p.size}</h3>
              <span style="background:rgba(196,181,244,0.12); color:#c4b5f4; font-size:0.75rem; font-weight:600; padding:0.2rem 0.6rem; border-radius:9999px; white-space:nowrap;">{p.guests}</span>
            </div>
            {p.items.map(i => (
              <div style="display:flex; align-items:center; gap:0.5rem; padding:0.3rem 0;">
                <span style="color:#86efac; font-size:0.75rem;">✓</span>
                <span style="color:rgba(255,255,255,0.6); font-size:0.85rem;">{i}</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div style="position:sticky; top:calc(var(--nav-offset,166px) + 2rem);">
        <div style="background:#1e1850; border:1px solid rgba(196,181,244,0.2); border-radius:16px; padding:2rem;">
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.4rem; color:white; margin:0 0 1rem;">Begär offert för er konferens</h3>
          <p style="color:rgba(255,255,255,0.60); font-size:0.85rem; margin:0 0 1.5rem; line-height:1.6;">Berätta om antal deltagare, lokal och datum — vi svarar med ett konkret förslag inom 2 timmar.</p>
          {[
            ["Svarstid", "Inom 2 timmar"],
            ["Betalning", "Faktura med individuella villkor"],
            ["Leverans", "Storstockholm"],
            ["Montering", "Tillgängligt"]
          ].map(([l, v]) => (
            <div style="display:flex; justify-content:space-between; padding:0.5rem 0; border-bottom:1px solid rgba(255,255,255,0.07);">
              <span style="color:rgba(255,255,255,0.60); font-size:0.85rem;">{l}</span>
              <span style="color:white; font-size:0.85rem; font-weight:600;">{v}</span>
            </div>
          ))}
          <a href="/bokningssida/" style="display:block; background:#c4b5f4; color:#0c0a24; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.85rem; letter-spacing:0.1em; text-transform:uppercase; text-decoration:none; padding:1rem 2rem; border-radius:4px; text-align:center; margin-top:1.5rem;">
            Begär offert
          </a>
        </div>
      </div>
    </div>
  </section>


  <!-- Konferens AV-länk prominent -->
  <section style="background:#111030; padding: clamp(2rem,4vw,3rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1200px; margin:0 auto;">
      <a href="/vara-tjanster/konferens-av/" style="display:flex; align-items:center; justify-content:space-between; background:#1e1850; border:1px solid rgba(196,181,244,0.3); border-radius:16px; padding:1.5rem 2rem; text-decoration:none; gap:1rem; flex-wrap:wrap;">
        <div>
          <div style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.4rem;">Komplett AV för konferens</div>
          <div style="color:white; font-family:'DM Serif Display',serif; font-size:1.3rem;">Mikrofoner, projektor och PA — allt samlat på ett ställe</div>
        </div>
        <span style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.85rem; white-space:nowrap;">Se hela utbudet →</span>
      </a>
    </div>
  </section>

  <!-- Produkter för konferens -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Populärt till konferens</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 0.75rem;">Lägg till i varukorgen direkt</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-5">
        <ProductCard
          artno={portMedium.artno} name={portMedium.name} price={portMedium.price}
          priceNote="/dygn" image={portMedium.image} alt={portMedium.name}
          description={portMedium.description} persons={portMedium.persons}
          specs={portMedium.includes} category="Ljud" />
        <ProductCard
          artno={shureHeadset.artno} name={shureHeadset.name} price={shureHeadset.price}
          priceNote="/dygn" image={shureHeadset.image} alt={shureHeadset.name}
          description={shureHeadset.description ?? shureHeadset.desc}
          specs={shureHeadset.specs ?? shureHeadset.includes ?? []} category="Mikrofon" />
        <ProductCard
          artno={shureMygga.artno} name={shureMygga.name} price={shureMygga.price}
          priceNote="/dygn" image={shureMygga.image} alt={shureMygga.name}
          description={shureMygga.description ?? shureMygga.desc}
          specs={shureMygga.specs ?? shureMygga.includes ?? []} category="Mikrofon" />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <ProductCard
          artno={projektor.artno} name={projektor.name} price={projektor.price}
          priceNote="/dygn" image={projektor.image} alt={projektor.name}
          description={projektor.description}
          specs={projektor.includes ?? []} category="Projektor" />
        <ProductCard
          artno={skarm65.artno} name={skarm65.name} price={skarm65.price}
          priceNote="/dygn" image={skarm65.image} alt={skarm65.name}
          description={skarm65.description}
          specs={skarm65.includes ?? []} category="Skärm" />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:820px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Vanliga frågor</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 2.5rem;">Konferensteknik — vanliga frågor</h2>
      <div style="display:flex; flex-direction:column;">
        {faq.map(item => (
          <details style="border-bottom:1px solid rgba(255,255,255,0.07);">
            <summary style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem 0; cursor:pointer; list-style:none; color:white; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:1rem; gap:1rem;">
              {item.q}
              <span style="color:#c4b5f4; font-size:1.25rem; flex-shrink:0;">+</span>
            </summary>
            <p style="color:rgba(255,255,255,0.6); font-size:0.95rem; line-height:1.75; margin:0 0 1.25rem; padding-right:2rem;">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


      <!-- Avbokningspolicy -->
      <div class="flex items-center gap-2 mt-6 text-sm text-gray-400">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Generösa avbokningsregler — <a href="/hyresvillkor/" class="text-brand-orange hover:underline">läs hyresvillkoren</a>.</span>
      </div>
</Layout>
