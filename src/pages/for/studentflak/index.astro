---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import EventChecklista from '../../../components/event/EventChecklista.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import TreSteg from '../../../components/TreSteg.astro';
import ljudData from '../../../data/ljud.json';
import { buildPaket, getProduct, fmtKr } from '../../../utils/paket';
import { helg, vardag } from '../../../utils/hours';

const portSmallPlus = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0002');
const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const portSmallDuo = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0005');
const tradlosHand = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0016');

// Studentflak-paketet — priser från live-JSON, exakt summa (ingen avrundning)
const flakPaket = buildPaket({
  namn: 'Studentflak-paketet',
  gaster: '20–40 studenter',
  round: false,
  rader: [
    { artno: 'SK-LJD-LIV-0002', label: 'Live Medium — 2×15″ sub + 2×12″' },
    { artno: 'SK-LJD-MIX-0003', label: 'LD Vibz8 — 4+1 kanaler' },
    { artno: 'SK-LJD-MIK-0006', label: '1× handmikrofon' },
    { artno: 'SK-LJD-MIK-0007', label: 'Bluetooth-mottagare + AUX' },
  ],
});
const elgenerator = getProduct('SK-EL-0012'); // Elgenerator 2200W (tillval)
// Samma paket med elverk — för flak utan 230 V-uttag
const flakElverk = buildPaket({
  namn: 'Med elverk',
  gaster: '20–40 studenter',
  beskrivning: 'Samma paket plus elgenerator — för flak utan eget 230 V-uttag.',
  rader: [
    { artno: 'SK-LJD-LIV-0002', label: 'Live Medium — 2×15″ sub + 2×12″' },
    { artno: 'SK-LJD-MIX-0003', label: 'LD Vibz8 — 4+1 kanaler' },
    { artno: 'SK-LJD-MIK-0006', label: '1× handmikrofon' },
    { artno: 'SK-LJD-MIK-0007', label: 'Bluetooth-mottagare + AUX' },
    { artno: 'SK-EL-0012', label: elgenerator.name },
  ],
});
const flakVal = [{ ...flakPaket, featured: true, beskrivning: 'Populäraste kombinationen för ett flak — kopplas till flakets 230 V-uttag.' }, flakElverk];

const faq = [
  {
    q: "Hur mycket ljud behövs på ett studentflak?",
    a: "Tumregel: 2 aktiva högtalare (minst 12-tum) + 1 subbasen för ett flak med 20–40 studenter. Viktigare än watt är rätt placering — högtalarna bör riktas mot folket, inte utåt. Vi hjälper er välja rätt system."
  },
  {
    q: "Hur fixar man strömmen på ett flak?",
    a: "Vi levererar utrustning med 230V-anslutning (vanliga eluttag). Ni behöver en dragkabel från fordonets 230V-uttag eller ett separat batteri/elverk. Vi kan råda om rätt effektbehov för er rigg."
  },
  {
    q: "Kan vi ansluta mobil eller Spotify direkt?",
    a: "Ja! Alla våra paket har Bluetooth och AUX-ingång. Koppla in mobilen eller datorn och spela direkt från Spotify eller er studentlåtlista."
  },
  {
    q: "Hur lånar man bäst en mikrofon till studentflaket?",
    a: "Vi hyr ut trådlösa handmikrofoner som passar perfekt för talen och sången på flaket. En trådlös mick är smidigare än med sladd och ger mer rörelseyta."
  },
  {
    q: "Hur tidigt måste jag boka för studentflaket?",
    a: "Studentperioden (maj–juni) är vår allra mest bokade tid. Vi rekommenderar att boka 4–8 veckor i förväg. Ring oss tidigt — populära helger tar slut snabbt."
  },
  {
    q: "Kan vi hämta och lämna utrustningen på en lördag?",
    a: `Ja, depån har öppet för hämtning och återlämning ${vardag({ kort: false })} och ${helg({ kort: false })} (på helger svarar vi i telefon enbart som jour vid pågående uthyrning). Hyr fredag och lämna tillbaka måndag — du betalar bara ett dygn, förutsatt att utrustningen inte är bokad av annan kund. Perfekt för studentflaket som körs på lördag.`
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av ljud och mikrofoner till studentflak i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "url": "https://scenkonsult.se/for/studentflak/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---

<Layout
  title="Hyra Ljud & Mikrofon till Studentflak i Stockholm | Scenkonsult"
  description={`Hyr ljud till studentflaket i Stockholm – batteridrivna högtalare med Bluetooth, trådlös mick och bra bas. Från ${Math.min(portSmallPlus.price, portMedium.price, portSmallDuo.price).toLocaleString('sv-SE').replace(/\u00a0/g, ' ')} kr/dygn. Ring 072-448 10 00.`}
  schemaExtra={pageSchema}
>

  <ModernHero
    bild={{ src: "/images/tjanster/plugg_ljud_portabel.webp", w: 800, h: 1000, alt: "Batteridriven högtalare på stativ med mikrofon" }}
    knappar={[{ label: "Se flakpaketen", href: "#paket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="För ditt event · Studentflak"
    h1="Ljud till studentflaket i"
    h1Accent="Stockholm"
    intro="Flaket rullar, solen skiner och musiken ska dåna. Vi hyr ut kompakta och kraftfulla ljudsystem till studentflak — enkla att koppla in och svåra att stoppa."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Studentflak" }
    ]}
    chips={[
      "Lätta att montera",
      "Bluetooth & AUX",
      "Trådlös mikrofon tillgänglig",
      "Helg = betala bara 1 dygn*",
    ]}
  />

  <EventPaket
    eyebrow="Studentflak-paketet"
    rubrik="Ett paket — med eller utan elverk"
    lead="Lägg paketet i varukorgen som det är, eller begär offert så justerar vi. Boka tidigt — maj–juni bokas snabbt."
    paket={flakVal}
    notis={`Priserna är summan av paketets artiklar per dygn. Helg = betala bara 1 dygn fredag–måndag, förutsatt tillgänglighet. Hämtning i Vällingby även ${helg()}. Leverans tillkommer.`}
  />

  <EventChecklista
    eyebrow="Det ni behöver"
    rubrik="Enkel checklista för ett bra flak"
    lead="Det första är måste, det andra är kul att ha. Osäkra? Fråga Sven."
    grupper={[
      { fas: "Måste ha", items: ["PA med subbas — minst 2×12″ + 1 sub", "Trådlös mikrofon för tal och sång", "Bluetooth — spela direkt från mobilen"] },
      { fas: "Kul att ha", items: ["Extra subbas för rejält basstryck", "Discoljus, rök och laser till kvällen", "Stativ för högtalarna på rätt höjd"] },
    ]}
  />

  <TreSteg rubrik="3 tips för ett bra flakljud" steg={[
    { rubrik: "Placera högtalarna rätt", text: "Rikta högtalarna inåt mot folket — inte utåt. Ljudet ska träffa personerna, inte åka förbi dem." },
    { rubrik: "Använd trådlös mikrofon", text: "En sladd på ett flak är en snubbelrisk och begränsar rörelsefriheten. Trådlöst är värt det." },
    { rubrik: "Ha en backup-spellista", text: "Bluetooth kan droppa. Ha en AUX-kabel som reserv och en spellista på två enheter." },
  ]} />

  <ProduktRader
    eyebrow="Populärt till studentflak"
    rubrik="Lägg i varukorgen direkt"
    lead="Kompakta och kraftfulla system — enkla att montera på flaket, svåra att stoppa."
    rader={[
      { produkt: portSmallPlus, not: "Batteridrivet", kategori: "Ljud" },
      { produkt: portMedium, not: "Batteridrivet, mer tryck", kategori: "Ljud" },
      { produkt: portSmallDuo, not: "Två högtalare — ljud åt båda håll", kategori: "Ljud" },
      { produkt: tradlosHand, not: "Tal och sång på flaket", kategori: "Ljud" },
    ]}
    lankar={[{ label: "Alla portabla system", href: "/vara-tjanster/hyra-ljud/portable/" }, { label: "Alla PA-system", href: "/vara-tjanster/hyra-ljud/" }]}
  />

  <EventFaq rubrik="Studentflak — vanliga frågor" faq={faq} extra={'Generösa avbokningsregler — <a href="/hyresvillkor/">läs hyresvillkoren</a>.'} />

  <SlutRuta rubrik="Klart för flaket? Vi hjälper er välja." />

</Layout>
