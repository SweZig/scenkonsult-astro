---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import EventOmraden from '../../../components/event/EventOmraden.astro';
import EventPaket from '../../../components/event/EventPaket.astro';
import EventChecklista from '../../../components/event/EventChecklista.astro';
import ProduktRader from '../../../components/event/ProduktRader.astro';
import EventFaq from '../../../components/event/EventFaq.astro';
import SlutRuta from '../../../components/event/SlutRuta.astro';
import KundRad from '../../../components/event/KundRad.astro';
import EventBilder from '../../../components/EventBilder.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';
import karaokeData from '../../../data/karaoke.json';
import _bildData from '../../../data/bild.json';
import _djData from '../../../data/dj.json';
import _scenesData from '../../../data/scenes.json';
import _tjData from '../../../data/tjanster.json';
import _elData from '../../../data/el.json';
import { resolveBuilder, minTotal } from '../../../lib/karaoke-builder.mjs';
import { buildPaket3, fmtKr, type PaketDef } from '../../../utils/paket';
import { getFeaturedClients } from '../../../utils/clients';

const kunder = getFeaturedClients();

const evSmall = (ljudData.event.products as any[]).find((p:any) => p.artno === 'SK-LJD-EVE-0001');
const evMedium = (ljudData.event.products as any[]).find((p:any) => p.artno === 'SK-LJD-EVE-0002');
const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const shureMygga = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0022');
const ljusPaket = (ljusData.paket.products as any[]).find((p:any) => p.artno === 'SK-LJS-PAK-0002');
const mhWash = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0010');

// Karaoke: från-pris = billigaste uppsättningen i karaokebyggaren
const karMin = minTotal(resolveBuilder(karaokeData, { karaoke: karaokeData, ljud: ljudData, ljus: ljusData, bild: _bildData, dj: _djData, scenes: _scenesData, tjanster: _tjData, el: _elData }));

// Företagsfest-paket — priser från live-JSON via artno
const ffPaketDefs: PaketDef[] = [
  {
    namn: 'Kickoff & mingel',
    gaster: '20–100 gäster',
    beskrivning: 'Ljud för presentationer och tal, trådlösa mikrofoner och stämningsljus för minglet. Lätt att rigga själva.',
    rader: [
      { artno: 'SK-LJD-EVE-0001', label: 'PA-system (2× 10″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon' },
      { artno: 'SK-LJD-MIK-0023', label: 'Shure SLXD headset — talare' },
      { artno: 'SK-LJS-PAK-0002', label: 'Ljuspaket Small+ (moving head)' },
    ],
  },
  {
    namn: 'Julfest & personalfest',
    gaster: '80–200 gäster',
    featured: true,
    beskrivning: 'Komplett kväll med kraftfullare PA, tal-mikrofoner, dansgolvsljus och rök. Vårt populäraste festupplägg.',
    rader: [
      { artno: 'SK-LJD-EVE-0002', label: 'PA-system (2× 12″ toppar)' },
      { artno: 'SK-LJD-MIK-0016', label: 'Trådlös handmikrofon' },
      { artno: 'SK-LJD-MIK-0023', label: 'Shure SLXD headset — toastmaster' },
      { artno: 'SK-LJS-PAK-0025', label: 'Ljuspaket Medium++ (tre stativ, tre effekttyper)' },
      { artno: 'SK-LJS-EFF-0010', label: 'Moving Head Wash', qty: 2 },
      { artno: 'SK-LJS-ROK-0001', label: 'Rökmaskin 1500W' },
    ],
  },
  {
    namn: 'Gala & prisutdelning',
    gaster: '100–300 gäster',
    beskrivning: 'Scen, storskärm för vinnarbilder och lookback, rejäl ljussättning och dubbla mikrofoner. För det stora kvällseventet.',
    rader: [
      { artno: 'SK-LJD-EVE-0004', label: 'PA Event Medium+ (4× 12″)' },
      { artno: 'SK-LJD-MIK-0026', label: 'Shure SLXD — 2 handmikrofoner' },
      { artno: 'SK-LJS-PAK-0007', label: 'Ljuspaket Large (moving heads + scanner)' },
      { artno: 'SK-SCN-0004', label: 'Scenpaket Medium (5×2 m)' },
      { artno: 'SK-BLD-0003', label: '65″ 4K-skärm' },
      { artno: 'SK-BLD-ACC-0003', label: 'Golvstativ för skärm' },
    ],
  },
];
const ffPaket = buildPaket3(ffPaketDefs);

const faq = [
  {
    q: "Hur lång tid tar det att rigga och plocka ned utrustningen?",
    a: "Ett standardpaket med ljud och ljus tar 1–2 timmar att rigga upp. Vår monteringstjänst (600 kr/tim) är tillgänglig om ni inte vill sköta det själva — vi kan vara klara i god tid innan gästerna anländer."
  },
  {
    q: "Kan vi hyra utrustning till en lokal vi inte äger?",
    a: "Absolut. Vi levererar och monterar i era lokaler, extern konferenslokal eller hyrd festlokal. Vi behöver bara adress och tillgänglig tid för leverans."
  },
  {
    q: "Fungerar utrustningen för både presentationer och fest på samma kväll?",
    a: "Ja. Våra PA-system hanterar både talljud för presentationer och fullt tryck för fest och dans. Vi kan rådge om rätt inställningar för varje fas av kvällen."
  },
  {
    q: "Kan vi boka tekniker som är på plats hela kvällen?",
    a: "Ja, vi erbjuder tekniker på plats (600 kr/tim, min 4 timmar). Det ger er trygghet och frigör er att fokusera på gästerna — inte på kablar och volymknappar."
  },
  {
    q: "Kan ni hantera stora företagsevent med 300+ gäster?",
    a: "Ja, vi har utrustning för event upp till 2 000 gäster. Kontakta oss med era krav så tar vi fram ett förslag anpassat för er storlek, lokal och budget."
  },
  {
    q: "Hur fakturerar ni för företag?",
    a: "Vi fakturerar med individuella betalningsvillkor för registrerade företag (vanligen 5–30 dagar beroende på kreditrating). Företag utan kreditmöjlighet kan betala vid hämtning med kort eller med Swish. Privatpersoner betalar i förväg eller med kort vid hämtning. Kontakta oss för offert och fakturaunderlag."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av ljud, ljus och scen till företagsfest i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr komplett AV-utrustning, ljud, ljus och scen till företagsfester, kickoffs och firmafester i Stockholm.",
      "url": "https://scenkonsult.se/for/foretagsfest/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

---

<Layout
  title="Hyra AV-teknik till Företagsfest & Kickoff Stockholm | Scenkonsult"
  description="Hyr professionell ljud, ljus och scen till er företagsfest i Stockholm. Tekniker på plats, fakturabetalning för företag. Leverans i hela Storstockholm. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    bild={{ src: "/images/event/kundevent_mr_french_1.webp", w: 1050, alt: "DJ spelar på Mr French med högtalare och mixerbord i förgrunden", text: "Mr French — Skeppsbron" }}
    knappar={[{ label: "Se företagspaketen", href: "#paket" }, { label: "Begär offert", href: "/varukorg/" }]}
    eyebrow="För ditt event · Företagsfest & kickoff"
    h1="Teknik till företagsfest i"
    h1Accent="Stockholm"
    intro="Från kickoff och julfest till invigning och personalfest. Vi levererar komplett AV-teknik till företagsevent i alla storlekar — med eller utan tekniker på plats."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Företagsfest & kickoff" }
    ]}
    chips={[
      "Faktura med individuella villkor",
      "Tekniker på plats tillgängligt",
      "Event 20–2 000 gäster",
      "Leverans i hela Storstockholm",
    ]}
  />

  <KundRad rubrik="Anlitade av bland annat" />

  <EventOmraden
    eyebrow="Vi hanterar allt"
    rubrik="Från AW till storkonferens"
    lead="Ljud, ljus, scen och bild för företagsevent i alla storlekar — med eller utan tekniker på plats."
    omraden={[
      { titel: "Julfest & personalfest", tag: "50–500 gäster", text: "Ljud för underhållning och tal, scenljus och discoljus för dansgolvet." },
      { titel: "Kickoff & teambuilding", tag: "20–200 gäster", text: "PA för presentationer, scen för underhållning, bakgrundsmusik under minglet." },
      { titel: "Konferens & föreläsning", tag: "20–500 gäster", text: "Kolumnhögtalare, trådlösa mikrofoner och projektor eller skärm för presentationen." },
      { titel: "Invigning & AW", tag: "30–300 gäster", text: "Portabelt ljud, stämningsljus, DJ-rigg och projektion av logotyper och produktbilder." },
      { titel: "Prisutdelning & gala", tag: "50–1 000 gäster", text: "Scen med spotlight, PA, belysning och storskärm för vinnarbilder och lookback." },
      { titel: "Mässa & utomhus", tag: "Valfri storlek", text: "Batteridrivna högtalare, robust ljus och mobila scener — fungerar utan fast ström." },
    ]}
  />

  <EventPaket
    eyebrow="Företagspaket"
    rubrik="Tre färdiga utgångspunkter"
    lead="Konkreta paket byggda på riktig utrustning — från kickoff till gala. Lägg det i varukorgen som det är, eller begär offert så justerar vi."
    paket={ffPaket}
    notis="Priserna är summan av paketets artiklar per dygn. Transport, montering och tekniker på plats tillkommer och offereras separat. Faktura med individuella villkor för företag."
  />

  <EventChecklista
    eyebrow="Utrustning"
    rubrik="Allt ni behöver, på ett ställe"
    lead="Fem områden — allt hyrs hos oss och kommer på samma offert."
    grupper={[
      { fas: "Ljud", items: ["PA-system för 20–2 000 gäster", "Trådlösa mikrofoner & headset", "Mixerbord & monitorer", "Portabla batteridrivna system"], href: "/vara-tjanster/hyra-ljud/" },
      { fas: "Ljus", items: ["LED PAR för stämning", "Moving heads & effektljus", "Rökmaskin & haze", "Uplights längs väggarna"], href: "/vara-tjanster/hyra-ljus/" },
      { fas: "Scen", items: ["Modulscener från 2×2 m", "Halkfri eller slät yta", "Trappor, scenkjol & räcken", "Tak till större scenpaket"], href: "/vara-tjanster/hyra-scen/" },
      { fas: "Bild", items: ["Projektor + duk i Full HD/4K", "Skärmar 65–85″ på golvstativ", "LED-väggar för storbild", "Mobila LED-trailers 7–28 m²"], href: "/vara-tjanster/hyra-bild/" },
      { fas: "Karaoke", items: [`Bygg er egen karaoke — från ${fmtKr(karMin)} kr/dygn exkl. moms`, "Sladd- eller trådlösa mikrofoner", "Sångtexter på skärm"], href: "/vara-tjanster/hyra-karaoke/", lank: "Bygg er karaoke" },
    ]}
  />

  <ProduktRader
    eyebrow="Populärt till företagsfest"
    rubrik="Lägg i varukorgen direkt"
    lead="Utrustning för kickoff, personalfest och konferensmiddag. Klicka på namnet för mått och specifikationer."
    rader={[
      { produkt: evSmall, not: "Tal och bakgrundsmusik", kategori: "Ljud" },
      { produkt: evMedium, not: "Mer räckvidd för större sällskap", kategori: "Ljud" },
      { produkt: portMedium, not: "Batteridrivet — mingel och AW", kategori: "Ljud" },
      { produkt: shureMygga, not: "Diskret för talare och moderator", kategori: "Ljud" },
      { produkt: ljusPaket, not: "Stämningsljus för minglet", kategori: "Ljus" },
      { produkt: mhWash, not: "Färgljus för dansgolvet", kategori: "Ljus" },
    ]}
    lankar={[{ label: "Konferens-AV", href: "/vara-tjanster/konferens-av/" }, { label: "Hyra ljud", href: "/vara-tjanster/hyra-ljud/" }, { label: "Hyra ljus", href: "/vara-tjanster/hyra-ljus/" }]}
  />

  <EventBilder kategori="foretagsfest" />

  <EventFaq rubrik="Vanliga frågor om företagsevent" faq={faq} extra={'Generösa avbokningsregler — <a href="/hyresvillkor/">läs hyresvillkoren</a>.'} />

  <SlutRuta rubrik="Berätta om ert event — vi föreslår en lösning." text="Kostnadsfritt och inte bindande. Faktura med individuella villkor för företag." />

</Layout>
