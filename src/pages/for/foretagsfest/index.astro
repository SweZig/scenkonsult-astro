---
import Layout from '../../../layouts/Layout.astro';
import ModernHero from '../../../components/ModernHero.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ljudData from '../../../data/ljud.json';
import ljusData from '../../../data/ljus.json';

const evSmall = ljudData.event.products[0];
const evMedium = ljudData.event.products[1];
const portMedium = (ljudData.portable.products as any[]).find((p:any) => p.artno === 'SK-LJD-POR-0003');
const shureMygga = ([...(ljudData.mikrofoner as any[]), ...(ljudData.tillbehor_mikrofon as any[]), ...(ljudData.tillbehor_ljud as any[])]).find((p:any) => p.artno === 'SK-LJD-MIK-0022');
const ljusPaket = ljusData.paket.products[1];
const mhWash = (ljusData.effekter.products as any[]).find((p:any) => p.artno === 'SK-LJS-EFF-0010');

const faq = [
  {
    q: "Hur lång tid tar det att rigga och plocka ned utrustningen?",
    a: "Ett standardpaket med ljud och ljus tar 1–2 timmar att rigga upp. Vår monteringstjänst (600 kr/tim) är tillgänglig om ni inte vill sköta det själva — vi kan vara klara i god tid innan gästerna anländer."
  },
  {
    q: "Kan vi hyra utrustning till en lokal vi inte äger?",
    a: "Absolut. Vi levererar och monterar i era lokaler, extern konferenslokal eller hyrd festlokal. Vi behöver bara adress och tillgänglig tid för leverans."
  },
  {
    q: "Fungerar utrustningen för både presentationer och fest på samma kväll?",
    a: "Ja. Våra PA-system hanterar både talljud för presentationer och fullt tryck för fest och dans. Vi kan rådge om rätt inställningar för varje fas av kvällen."
  },
  {
    q: "Kan vi boka tekniker som är på plats hela kvällen?",
    a: "Ja, vi erbjuder tekniker på plats (600 kr/tim, min 4 timmar). Det ger er trygghet och frigör er att fokusera på gästerna — inte på kablar och volymknappar."
  },
  {
    q: "Kan ni hantera stora företagsevent med 300+ gäster?",
    a: "Ja, vi har utrustning för event upp till 2 000 gäster. Kontakta oss med era krav så tar vi fram ett förslag anpassat för er storlek, lokal och budget."
  },
  {
    q: "Hur fakturerar ni för företag?",
    a: "Vi fakturerar med individuella betalningsvillkor för registrerade företag (vanligen 5–30 dagar beroende på kreditrating). Företag utan kreditmöjlighet kan betala vid hämtning med kort eller med Swish. Privatpersoner betalar i förväg eller med kort vid hämtning. Kontakta oss för offert och fakturaunderlag."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Uthyrning av ljud, ljus och scen till företagsfest i Stockholm",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Scenkonsult Norden",
        "telephone": "+46724481000",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Grimstagatan 164",
          "addressLocality": "Vällingby",
          "postalCode": "162 58",
          "addressCountry": "SE"
        }
      },
      "areaServed": "Stockholm",
      "description": "Hyr komplett AV-utrustning, ljud, ljus och scen till företagsfester, kickoffs och firmafester i Stockholm.",
      "url": "https://scenkonsult.se/for/foretagsfest/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

const kunder = [
  "ICA Sverige", "Solna Stad", "Stockholm Stad", "Haninge Kommun",
  "Akademiska Hus", "ABG Sundal Collier", "Kommunalarbetareförbundet",
  "Mälardalens Universitet", "Houdini Sportsware", "Hornbach"
];
---

<Layout
  title="Hyra AV-teknik till Företagsfest & Kickoff Stockholm | Scenkonsult"
  description="Hyr professionell ljud, ljus och scen till er företagsfest i Stockholm. Tekniker på plats, fakturabetalning för företag. Leverans i hela Storstockholm. Ring 072-448 10 00."
  schemaExtra={pageSchema}
>

  <ModernHero
    eyebrow="För ditt event · Företagsfest & kickoff"
    h1="Teknik till företagsfest i"
    h1Accent="Stockholm"
    intro="Från kickoff och julfest till invigning och personalfest. Vi levererar komplett AV-teknik till företagsevent i alla storlekar — med eller utan tekniker på plats."
    breadcrumbs={[
      { label: "Hem", href: "/" },
      { label: "För ditt event", href: "/for/" },
      { label: "Företagsfest & kickoff" }
    ]}
    chips={[
      "Faktura med individuella villkor",
      "Tekniker på plats tillgängligt",
      "Event 20–2 000 gäster",
      "Leverans i hela Storstockholm",
    ]}
  />

  <!-- Kunder vi jobbat med -->
  <section style="background:#0c0a24; padding: 2rem clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px; margin:0 auto;">
      <p style="color:rgba(255,255,255,0.60); font-family:'Space Grotesk',sans-serif; font-size:0.75rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:1rem; text-align:center;">Anlitade av bland annat</p>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.5rem; justify-content:center;">
        {kunder.map(k => (
          <span style="color:rgba(255,255,255,0.60); font-family:'Space Grotesk',sans-serif; font-size:0.85rem; font-weight:600;">{k}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Vanliga event-typer -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1100px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Vi hanterar allt</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.8rem,4vw,2.8rem); color:white; margin:0 0 2.5rem; max-width:700px;">Från AW till storkonferens</h2>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.25rem;">
        {[
          { icon: "🎉", title: "Julfest & personalfest", desc: "Ljud för underhållning och tal, scenljus och discoljus för dansgolvet. Vi hanterar 50–500 gäster.", guests: "50–500 gäster" },
          { icon: "🚀", title: "Kickoff & teambuilding", desc: "PA för presentationer, scen för underhållning, bakgrundsmusik under minglet.", guests: "20–200 gäster" },
          { icon: "🎤", title: "Konferens & föreläsning", desc: "Kolumnhögtalare, trådlösa mikrofoner och projektor eller LED-skärm för slides. Klart ljud för presentationer och Q&A.", guests: "20–500 gäster" },
          { icon: "🥂", title: "Invigning & AW", desc: "Portabelt ljud, stämningsljus, en DJ-rigg och projektion av företagsloggor eller produktbilder.", guests: "30–300 gäster" },
          { icon: "🏆", title: "Prisutdelning & gala", desc: "Scen med spotlight, högtalaranläggning, belysning och storskärm för vinnarbilder, finalist-namn och lookback.", guests: "50–1000 gäster" },
          { icon: "📢", title: "Mässa & utomhus", desc: "Batteridrivna högtalare, robust ljus och mobila scener. Fungerar utan fast ström.", guests: "Valfri storlek" }
        ].map(item => (
          <div style="background:#1e1850; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:1.5rem;">
            <div style="font-size:1.5rem; margin-bottom:0.75rem;">{item.icon}</div>
            <h3 style="font-family:'Space Grotesk',sans-serif; font-size:0.95rem; font-weight:700; color:white; margin:0 0 0.5rem;">{item.title}</h3>
            <p style="color:rgba(255,255,255,0.5); font-size:0.85rem; line-height:1.6; margin:0 0 0.75rem;">{item.desc}</p>
            <span style="background:rgba(196,181,244,0.12); color:#c4b5f4; font-size:0.75rem; font-weight:600; padding:0.25rem 0.65rem; border-radius:9999px;">{item.guests}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Utrustning -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div class="g2c" style="max-width:1100px; margin:0 auto;">
      <div>
        <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Utrustning</p>
        <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 1.5rem;">Allt ni behöver, på ett ställe</h2>

        {[
          { title: "Ljud", items: ["PA-system för 20–2000 gäster", "Trådlösa mikrofoner & headset", "Mixerbord & monitorer", "Portabla batteririvna system"], link: "/vara-tjanster/hyra-ljud/" },
          { title: "Ljus", items: ["LED par-lampor för stämning", "Moving heads & effektljus", "Rökmaskin & haze", "Uplights längs väggarna"], link: "/vara-tjanster/hyra-ljus/" },
          { title: "Scen", items: ["Modulscenar 2×2 m upp till 8×6 m", "Halkfri eller slät yta", "Scentrappor, scenkjol & räcken", "Tak till större scenpaket"], link: "/vara-tjanster/hyra-scen/" },
          { title: "Bild", items: ["BenQ Full HD/4K-projektor + duk", "Skärmar 65–85\" på golvstativ", "LED-väggar för storbild", "Mobila LED-trailers 7–28 m²"], link: "/vara-tjanster/hyra-bild/" },
          { title: "Karaoke", items: ["6 färdiga karaokepaket (699–4 999 kr/dygn)", "Trådlösa mikar i större paket", "65″ skärm eller projektor för sångtexter", "Singa-appen — 80 000+ låtar"], link: "/vara-tjanster/hyra-karaoke/" }
        ].map(block => (
          <div style="margin-bottom:2rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
              <h3 style="font-family:'Space Grotesk',sans-serif; font-size:0.85rem; font-weight:700; color:#c4b5f4; text-transform:uppercase; letter-spacing:0.08em; margin:0;">{block.title}</h3>
              <a href={block.link} style="color:rgba(255,255,255,0.60); font-size:0.75rem; text-decoration:none;">Se sortiment →</a>
            </div>
            {block.items.map(item => (
              <div style="display:flex; align-items:center; gap:0.6rem; padding:0.4rem 0; border-bottom:1px solid rgba(255,255,255,0.05);">
                <span style="color:#86efac; font-size:0.8rem;">✓</span>
                <span style="color:rgba(255,255,255,0.65); font-size:0.9rem;">{item}</span>
              </div>
            ))}
          </div>
        ))}
      </div>

      <div>
        <div style="background:#1e1850; border:1px solid rgba(196,181,244,0.2); border-radius:16px; padding:2rem; margin-bottom:1.5rem;">
          <h3 style="font-family:'DM Serif Display',serif; font-size:1.4rem; color:white; margin:0 0 0.5rem;">Begär offert</h3>
          <p style="color:rgba(255,255,255,0.60); font-size:0.85rem; margin:0 0 1.5rem; line-height:1.6;">Berätta om ert event, antal gäster och lokal — vi återkommer med ett konkret förslag inom 2 timmar.</p>

          <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem;">
            {[
              ["Svarstid", "Inom 2 timmar"],
              ["Betalning", "Faktura med individuella villkor"],
              ["Leverans", "Hela Storstockholm"],
              ["Tekniker", "Tillgängligt som tillägg"],
            ].map(([label, value]) => (
              <div style="display:flex; justify-content:space-between; padding:0.5rem 0; border-bottom:1px solid rgba(255,255,255,0.07);">
                <span style="color:rgba(255,255,255,0.60); font-size:0.85rem;">{label}</span>
                <span style="color:white; font-size:0.85rem; font-weight:600;">{value}</span>
              </div>
            ))}
          </div>

          <a href="/bokningssida/" style="display:block; background:#c4b5f4; color:#0c0a24; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:0.85rem; letter-spacing:0.1em; text-transform:uppercase; text-decoration:none; padding:1rem 2rem; border-radius:4px; text-align:center; margin-bottom:0.75rem;">
            Begär offert
          </a>
          <a data-tel="MDcyNDQ4MTAwMA==" data-prefix="📞 " data-label="072-448 10 00" href="#tel" style="display:block; text-align:center; color:rgba(255,255,255,0.60); font-family:'Space Grotesk',sans-serif; font-size:0.85rem; text-decoration:none;"><noscript>📞 072-448 10 00</noscript></a>
        </div>
      </div>
    </div>
  </section>


  <!-- Produkter för företagsfest -->
  <section style="background:#0c0a24; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:1200px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Populärt till företagsfest</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 0.75rem;">Lägg till i varukorgen direkt</h2>
      <p style="color:rgba(255,255,255,0.5); font-size:0.95rem; margin:0 0 2.5rem;">Professionell utrustning för kickoff, personalfest och konferensmiddag.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-5">
        <ProductCard
          artno={evMedium.artno} name={evMedium.name} price={evMedium.price}
          priceNote="/dygn" image={evMedium.image} alt={evMedium.name}
          description={evMedium.description} persons={evMedium.persons}
          specs={evMedium.includes} category="Ljud"
          manualUrl={evMedium.manualUrl}
        />
        <ProductCard
          artno={portMedium.artno} name={portMedium.name} price={portMedium.price}
          priceNote="/dygn" image={portMedium.image} alt={portMedium.name}
          description={portMedium.description} persons={portMedium.persons}
          specs={portMedium.includes} category="Ljud"
          manualUrl={portMedium.manualUrl}
        />
        <ProductCard
          artno={shureMygga.artno} name={shureMygga.name} price={shureMygga.price}
          priceNote="/dygn" image={shureMygga.image} alt={shureMygga.name}
          description={shureMygga.description ?? shureMygga.desc}
          specs={shureMygga.specs ?? shureMygga.includes ?? []} category="Mikrofon"
          manualUrl={shureMygga.manualUrl}
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <ProductCard
          artno={ljusPaket.artno} name={ljusPaket.name} price={ljusPaket.price}
          priceNote="/dygn" image={ljusPaket.image} alt={ljusPaket.name}
          description={ljusPaket.description}
          specs={ljusPaket.includes ?? []} category="Ljus"
          manualUrl={ljusPaket.manualUrl}
        />
        <ProductCard
          artno={mhWash.artno} name={mhWash.name} price={mhWash.price}
          priceNote="/st/dygn" image={mhWash.image} alt={mhWash.name}
          description={mhWash.description}
          specs={mhWash.includes ?? []} category="Ljuseffekter"
          manualUrl={mhWash.manualUrl}
        />
      </div>
      <!-- Konferens-länk -->
      <div class="mt-8 bg-brand-navy border border-brand-orange/20 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1">
          <div class="text-brand-orange text-sm font-semibold mb-1">Planerar ni en konferens eller kickoff?</div>
          <div class="text-white font-bold">Se vår kompletta AV-sida för konferens — mikrofoner, projektor och PA samlat</div>
        </div>
        <a href="/vara-tjanster/konferens-av/" class="shrink-0 bg-brand-orange hover:bg-brand-orange-light text-brand-dark font-bold text-sm px-6 py-3 rounded-xl transition-colors">Konferens AV →</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#111030; padding: clamp(3rem,6vw,5rem) clamp(1rem,5vw,5rem);">
    <div style="max-width:820px; margin:0 auto;">
      <p style="color:#c4b5f4; font-family:'Space Grotesk',sans-serif; font-size:0.8rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.75rem;">Vanliga frågor</p>
      <h2 style="font-family:'DM Serif Display',serif; font-size:clamp(1.6rem,3.5vw,2.4rem); color:white; margin:0 0 2.5rem;">Vanliga frågor om företagsevent</h2>
      <div style="display:flex; flex-direction:column; gap:0;">
        {faq.map(item => (
          <details style="border-bottom:1px solid rgba(255,255,255,0.07); padding:0;">
            <summary style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem 0; cursor:pointer; list-style:none; color:white; font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:1rem; gap:1rem;">
              {item.q}
              <span style="color:#c4b5f4; font-size:1.25rem; flex-shrink:0;">+</span>
            </summary>
            <p style="color:rgba(255,255,255,0.6); font-size:0.95rem; line-height:1.75; margin:0 0 1.25rem; padding-right:2rem;">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>


      <!-- Avbokningspolicy -->
      <div class="flex items-center gap-2 mt-6 text-sm text-gray-400">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Generösa avbokningsregler — <a href="/hyresvillkor/" class="text-brand-orange hover:underline">läs hyresvillkoren</a>.</span>
      </div>
</Layout>
