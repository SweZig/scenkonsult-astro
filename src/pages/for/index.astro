---
import Layout from '../../layouts/Layout.astro';
import SidHuvud from '../../components/SidHuvud.astro';
import SlutRuta from '../../components/event/SlutRuta.astro';
import { bildmatt, bildSrcset } from '../../utils/bildmatt';

const occasions = [
  {
    slug: "brollop",
    bild: "/images/event/kundevent_lakarforbundet.webp", pos: "50% 50%",
    _icon: "💍",
    title: "Bröllop",
    desc: "Ljud för tal och trubadur, stämningsljus och scen. Vi har levererat till hundratals bröllop sedan 1986.",
    badge: "Populärast",
    guests: "30–250 gäster"
  },
  {
    slug: "foretagsfest",
    bild: "/images/event/kundevent_mr_french_1.webp", pos: "50% 50%",
    _icon: "🎉",
    title: "Företagsfest & kickoff",
    desc: "Från julfest till invigning. Faktura med individuella villkor. Tekniker på plats om ni vill.",
    badge: null,
    guests: "20–2000 gäster"
  },
  {
    slug: "konferens",
    bild: "/images/event/kundevent_abg_konferens.webp", pos: "50% 50%",
    _icon: "🎤",
    title: "Konferens & föreläsning",
    desc: "AV-teknik, mikrofoner och projektorer. Professionellt ljud för presentationer och paneldiskussioner.",
    badge: null,
    guests: "20–500 deltagare"
  },
  {
    slug: "festival",
    bild: "/images/event/festival_vinterviken_2.webp", pos: "50% 50%",
    _icon: "🎸",
    title: "Festival & utomhus",
    desc: "Modulscener, kraftfulla PA-system och robust ljus för utomhus-event och festivaler.",
    badge: null,
    guests: "100–2000 besökare"
  },
  {
    slug: "studentflak",
    bild: "/images/tjanster/plugg_ljud_portabel.webp", pos: "50% 50%",
    _icon: "🎓",
    title: "Studentflak",
    desc: "Kompakta och kraftfulla ljudsystem med Bluetooth och trådlös mick. Boka tidigt — maj–juni tar slut snabbt.",
    badge: "Säsong maj–juni",
    guests: "15–50 studenter"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Eventuthyrning Stockholm – Alla tillfällen",
  "description": "Hyr scen, ljud och ljus till ditt event i Stockholm. Vi hanterar bröllop, företagsfester, konferenser, festivaler och studentflak.",
  "itemListElement": occasions.map((o, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": o.title,
      "url": `https://scenkonsult.se/for/${o.slug}/`
    }
  }))
};
const forSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Vad kan man hyra för ett event i Stockholm?",
      "acceptedAnswer": { "@type": "Answer", "text": "Scenkonsult hyr ut scen (4–48 m²), PA-system (20–1 500 pers.), ljuspaket, projektorer, LED-skärmar och professionella DJs. Vi levererar och monterar i hela Storstockholm." } },
    { "@type": "Question", "name": "Kan ni hjälpa till med ett komplett event-upplägg?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja — vi sätter ihop kompletta paket med scen, ljud, ljus och DJ anpassade för ert event. En kontaktperson, ett avtal. Kontakta oss för offert." } },
    { "@type": "Question", "name": "Levererar ni utrustning till bröllop, företagsfest och festival?",
      "acceptedAnswer": { "@type": "Answer", "text": "Ja. Vi har levererat till hundratals bröllop, företagsevent och festivaler sedan 1986. Vi har specialanpassade paket för varje eventtyp." } },
    { "@type": "Question", "name": "Vad kostar ett komplett event-paket?",
      "acceptedAnswer": { "@type": "Answer", "text": "Liten fest (50 pers.): från ca 1 200 kr/dygn. Bröllop (100 pers.): ca 3 500 kr/dygn. Företagsfest (200 pers.): ca 5 000–8 000 kr/dygn. Transport och montering tillkommer." } }
  ]
};

const OCC = occasions.map((o: any) => ({ ...o, srcset: bildSrcset(o.bild), matt: bildmatt(o.bild) }));
const pageBreadcrumbs = [{ label: 'Hem', href: '/' }, { label: 'För ditt event' }];
---

<Layout breadcrumbs={pageBreadcrumbs}
  schemaExtra={forSchema}
  title="Hyr Teknik till Ditt Event i Stockholm | Scenkonsult — Alla Tillfällen"
  description="Hyr scen, ljud och ljus anpassat för ditt event. Bröllop, företagsfest, konferens, festival och studentflak. Storstockholm. Sedan 1986."
  schemaExtra={schema}
>

  <SidHuvud
    brod={[{ label: 'Hem', href: '/' }, { label: 'För ditt event' }]}
    eyebrow="Anpassat för ditt tillfälle"
    h1="Rätt teknik för"
    h1Accent="varje event"
    intro="Välj ditt event-typ nedan — vi har tagit fram specifika rekommendationer, checklistor och priser för varje tillfälle."
  />

  <section class="fo-wrap">
    <div class="fo-grid">
      {OCC.map((o: any) => (
        <a href={`/for/${o.slug}/`} class="fo-kort">
          <img src={o.bild} srcset={o.srcset} sizes="(max-width: 720px) 100vw, 400px" alt="" width={o.matt?.w} height={o.matt?.h} loading="lazy" decoding="async" style={`object-position:${o.pos}`} />
          <span class="fo-ton"></span>
          {o.badge && <span class="fo-badge">{o.badge}</span>}
          <span class="fo-text">
            <h2>{o.title}</h2>
            <span class="fo-desc">{o.desc}</span>
            <span class="fo-fot"><span>{o.guests}</span><b>Se mer →</b></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="sk-band">
    <div class="fo-wrap fo-guider">
      <div class="fo-huvud">
        <div>
          <p class="sk-eyebrow">Kunskapsbank</p>
          <h2 class="sk-h2">Guider &amp; tips</h2>
        </div>
        <a href="/for/guider/" class="sk-knapp">Alla guider →</a>
      </div>
      <div class="fo-glista">
        {[
          { href:"/for/guider/hur-stor-pa/", title:"Hur stor PA behöver jag?", tag:"Ljud" },
          { href:"/for/guider/hur-stor-scen/", title:"Hur stor scen behöver jag?", tag:"Scen" },
          { href:"/for/guider/dj-eller-liveband/", title:"DJ eller liveband?", tag:"Musik" },
          { href:"/for/guider/ljussattning-tips/", title:"Ljussättning för event", tag:"Ljus" },
          { href:"/for/guider/checklista-event/", title:"Komplett checklista", tag:"Planering" },
          { href:"/for/guider/vad-kostar-det/", title:"Vad kostar det?", tag:"Pris" },
        ].map(g => (
          <a href={g.href}><span>{g.tag}</span><b>{g.title}</b></a>
        ))}
      </div>
    </div>
  </section>

  <section class="fo-wrap">
    <div class="fo-fakta">
      {[
        ["1986", "Grundat"],
        ["100+", "Event per år"],
        ["20–2000", "Gäster vi hanterar"],
        ["Storstockholm", "Leverans i hela området"],
      ].map(([nr, label]) => (
        <div><b>{nr}</b><span>{label}</span></div>
      ))}
    </div>
  </section>

  <SlutRuta rubrik="Hittar du inte ditt tillfälle?" text="Beskriv ert event så föreslår vi teknik och upplägg — kostnadsfritt och inte bindande." />
</Layout>

<style>
  .fo-wrap { max-width: 80rem; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem); }
  .fo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .fo-kort { position: relative; display: block; border-radius: 22px; overflow: hidden; aspect-ratio: 4 / 5; background: #1e1850; text-decoration: none; }
  .fo-kort img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .fo-kort:hover img { transform: scale(1.04); }
  .fo-ton { position: absolute; inset: 0; background: linear-gradient(to top, rgba(12,10,36,0.97) 0%, rgba(12,10,36,0.8) 42%, rgba(12,10,36,0) 75%); }
  .fo-badge { position: absolute; top: 1rem; left: 1rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.7rem; border-radius: 999px; background: #c4b5f4; color: #0c0a24; }
  .fo-text { position: absolute; left: 1.4rem; right: 1.4rem; bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .fo-text h2 { margin: 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: 2rem; line-height: 1.05; color: #fff; }
  .fo-desc { font-size: 0.95rem; line-height: 1.5; color: rgba(255,255,255,0.78); }
  .fo-fot { display: flex; justify-content: space-between; align-items: center; margin-top: 0.4rem; padding-top: 0.75rem; border-top: 1px solid rgba(255,255,255,0.15); font-family: 'Space Grotesk', sans-serif; font-size: 0.85rem; color: rgba(255,255,255,0.7); }
  .fo-fot b { color: #c4b5f4; }
  .fo-guider { padding-top: clamp(3rem, 6vw, 5rem); }
  .fo-huvud { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .fo-glista { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; overflow: hidden; }
  .fo-glista a { background: #110f30; padding: 1.25rem 1.4rem; text-decoration: none; display: flex; flex-direction: column; gap: 0.35rem; transition: background 0.15s; }
  .fo-glista a:hover { background: #1e1850; }
  .fo-glista span { font-family: 'Space Grotesk', sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #c4b5f4; }
  .fo-glista b { font-family: 'DM Serif Display', serif; font-weight: 400; font-size: 1.35rem; color: #fff; }
  .fo-fakta { margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; overflow: hidden; }
  .fo-fakta > div { background: #0c0a24; padding: 1.4rem; }
  .fo-fakta b { display: block; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.2rem); color: #c4b5f4; }
  .fo-fakta span { font-family: 'Space Grotesk', sans-serif; font-size: 0.8rem; color: rgba(255,255,255,0.6); }
  @media (max-width: 1000px) { .fo-grid, .fo-glista { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fo-fakta { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .fo-grid, .fo-glista { grid-template-columns: minmax(0, 1fr); } }
</style>
