---
import Layout from '../layouts/Layout.astro';
import ModernHero from '../components/ModernHero.astro';
import ProduktRader from '../components/event/ProduktRader.astro';
import EventFaq from '../components/event/EventFaq.astro';
import KundRad from '../components/event/KundRad.astro';
import SlutRuta from '../components/event/SlutRuta.astro';
import { bildmatt, bildSrcset } from '../utils/bildmatt';
import orter from '../data/orter.json';
import _fraktData from '../data/tjanster.json';

// Lägsta enkelresepris ur tjanster.json — aldrig hårdkodat, fraktpriserna
// ändras i adminpanelen och en literal siffra blir tyst fel för kunden.
const _fraktFran = (_fraktData as any).leverans?.standard?.enkelresa;
import ljudData from '../data/ljud.json';
import scenData from '../data/scenes.json';
import { getClientsByOrt } from '../utils/clients';
import { telefon, helg } from '../utils/hours';


export async function getStaticPaths() {
  return orter.map((ort) => ({
    params: { ort: ort.slug },
    props: { ort },
  }));
}

const { ort } = Astro.props;

// Lokala referenskunder: primärt de som taggats med denna ort i admin (clients.json),
// sammanslaget med ev. manuella ort.kunder i orter.json (dedupe).
const lokalaKunder = [...new Set([
  ...getClientsByOrt(ort.namn),
  ...((ort.kunder ?? []) as string[]),
])];

const isHemma = ort.slug === 'vallingby';
const faq = [
  {
    q: `Levererar ni till ${ort.namn}?`,
    a: isHemma
      ? `Ja — Vällingby är vår hemmaplan. Vårt lager ligger på Grimstagatan 164 mitt i Vällingby, så leveransen går snabbt och du kan enkelt hämta utrustningen själv om du föredrar det.`
      : `Ja, vi levererar till ${ort.namn} och hela Storstockholm. Från vårt lager i Vällingby är det ca ${ort.distans} och ${ort.distansMin} minuter till ${ort.namn}. Du kan också hämta utrustningen själv i Vällingby om du föredrar det.`
  },
  {
    q: `Hur lång tid tar det att ställa upp utrustningen i ${ort.namn}?`,
    a: `Ett standard PA-paket tar 30–60 minuter att rigga. En komplett scen med ljus och ljud tar 2–4 timmar beroende på storlek. Vi kan boka specifik leveranstid och hjälper gärna till med tips inför er installering.`
  },
  {
    q: `Vad kostar leverans till ${ort.namn}?`,
    a: `Leveranspriset styrs av hur skrymmande utrustningen är — inte av avståndet till ${ort.namn} specifikt. Vi kör i hela Storstockholm och debiterar normalt tur och retur: från ${_fraktFran} kr enkelresa med vanlig bil, mer för stor bil eller lätt lastbil vid skrymmande gods (exkl. moms). Exakt fraktpris bekräftas i offerten. Hämtar du själv i Vällingby är det alltid kostnadsfritt.`
  },
  {
    q: `Kan jag hyra för en kväll i ${ort.namn}?`,
    a: `Absolut. Vår standardperiod är ett dygn (24 h), men vi erbjuder flexibla upplägg för kortare och längre hyresperioder. Kontakta oss eller lägg produkterna i varukorgen och begär offert — så löser vi det.`
  },
  // Ort-specifika frågor från orter.json (valfritt, { q, a })
  ...((ort.ortFaq ?? []) as { q: string; a: string }[])
];

// Grannorter för intern korslänkning (närmast först, exkl. denna ort)
const grannorter = orter
  .filter(o => o.slug !== ort.slug)
  .sort((a, b) => (a.distansMin ?? 999) - (b.distansMin ?? 999))
  .slice(0, 6);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "name": "Scenkonsult Norden",
      "telephone": "+46724481000",
      "url": `https://scenkonsult.se/hyra-ljud-scen-${ort.slug}/`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Grimstagatan 164",
        "addressLocality": "Vällingby",
        "postalCode": "162 58",
        "addressCountry": "SE"
      },
      "areaServed": {
        "@type": "City",
        "name": ort.namn
      },
      "description": `Hyr scen, ljud och ljus i ${ort.namn}. Leverans från Vällingby på ca ${ort.distansMin} min. Professionell eventutrustning sedan 1986.`,
      "openingHours": ["Mo-Fr 09:00-17:00", "Sa-Su 12:00-15:00"],
      "priceRange": "$$"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Design 2026 ─────────────────────────────────────────────────────────────
const heroMatt = bildmatt(ort.image);
const heroBild = { src: ort.image, alt: ort.imageAlt, w: heroMatt?.w, h: heroMatt?.h };
const V = '/vara-tjanster';
const KORT = [
  { namn: 'Scen & podium', text: 'Från podium till konsertscen', href: `${V}/hyra-scen/`, src: '/images/event/kundevent_tele2_scenpodie.webp', alt: 'Scenpodie med ridå och storbild hos Tele2', pos: '50% 60%' },
  { namn: 'Ljud & PA', text: 'Anpassat efter lokalen', href: `${V}/hyra-ljud/`, src: '/images/event/festival_hard_rock_rising_2.webp', alt: 'Rockband på scenen under Hard Rock Rising', pos: '50% 50%' },
  { namn: 'Ljus & effekter', text: 'Stämning och dansgolv', href: `${V}/hyra-ljus/`, src: '/images/event/installation_german_beerhall_1.webp', alt: 'Blått ljus och LED-ramper i taket på German Beer Hall', pos: '50% 35%' },
  { namn: 'DJ', text: 'Utrustning eller en av våra DJ:s', href: `${V}/hyra-dj/`, src: '/images/event/kundevent_djursholms_slott.webp', alt: 'DJ på galakväll på Djursholms Slott', pos: '50% 50%' },
].map((k) => ({ ...k, srcset: bildSrcset(k.src), matt: bildmatt(k.src) }));
const scenMedium = (scenData.products as any[]).find((p) => p.artno === 'SK-SCN-0004');
const scenLarge = (scenData.products as any[]).find((p) => p.artno === 'SK-SCN-0008');
const eventSmall = (ljudData.event.products as any[]).find((p) => p.artno === 'SK-LJD-EVE-0001');
const POPULART = [
  { produkt: scenMedium, kategori: 'Scen', not: 'Välj höjd och yta i scenkonfiguratorn' },
  { produkt: scenLarge, kategori: 'Scen', not: 'För liveband — välj i scenkonfiguratorn' },
  { produkt: eventSmall, kategori: 'Ljud', not: eventSmall?.persons ? `${String(eventSmall.persons).replace('pers.', 'gäster')} · tal och musik` : 'Tal och musik' },
];
const VARFOR = [
  { t: `Ca ${ort.distansMin} min`, d: `från lagret i Vällingby till ${ort.namn} — ca ${ort.distans}.` },
  { t: 'Kända märken', d: 'Alto, Allen & Heath, LD Systems, Shure och Denon för ljud · ADJ, Cameo, Stairville och Global Truss för ljus · Samsung, BenQ och Epson för bild.' },
  { t: 'Fri rådgivning', d: 'Vi hjälper er välja rätt för lokalen och antalet gäster.' },
  { t: 'Hämta själv', d: 'Hämtning i Vällingby kostar ingenting.' },
  { t: 'Öppettider', d: `Telefon ${telefon({ kort: false })}. Hämtning och återlämning även ${helg({ kort: false })}. Kvällar och helger: telefon endast jour vid pågående uthyrning.` },
  { t: 'Tekniker', d: 'Vill ni ha hjälp på plats bokar ni en av våra tekniker.', href: `${V}/hyra-ljudtekniker/` },
];
---

<Layout
  title={`Hyra Scen, Ljud & Ljus i ${ort.namn} | Scenkonsult Norden`}
  description={`Hyr scen, PA-system, ljusutrustning och DJ-utrustning i ${ort.namn} — leverans från Vällingby på ca ${ort.distansMin} min. Eventutrustning sedan 1986. Ring 072-448 10 00.`}
  schemaExtra={pageSchema}
  mobilBar={true}
>
  <ModernHero
    eyebrow={`Eventutrustning · ${ort.namn}`}
    h1="Hyra scen & ljud i"
    h1Accent={ort.namn}
    intro={`Vi levererar professionell eventutrustning till ${ort.namn} och hela Storstockholm. Scen, PA-system, ljus och DJ-utrustning — hyrt av hundratals kunder sedan 1986. Från Vällingby till ${ort.namn} på ca ${ort.distansMin} minuter.`}
    breadcrumbs={[{ label: 'Hem', href: '/' }, { label: ort.namn }]}
    bild={heroBild}
    knappar={[{ label: 'Se vad vi hyr ut', href: '#utbud' }, { label: 'Begär offert', href: '/varukorg/' }]}
    chips={[
      { html: `Ca <b style="color:#c4b5f4">${ort.distansMin} min</b> från lagret i Vällingby` },
      'Hämtning i Vällingby kostnadsfritt',
      `Telefon ${telefon()}`,
    ]}
  />

  <section id="utbud" class="ort-wrap">
    <div class="ort-huvud">
      <div>
        <p class="sk-eyebrow">Det här levererar vi till {ort.namn}</p>
        <h2 class="sk-h2">Allt till ert event på ett ställe</h2>
      </div>
      <a href="/vara-tjanster/" class="sk-knapp">Alla tjänster</a>
    </div>
    <div class="ort-kort">
      {KORT.map((k) => (
        <a href={k.href} class="ort-k">
          <img src={k.src} srcset={k.srcset} sizes="(max-width: 720px) 50vw, 300px" alt={k.alt} width={k.matt?.w} height={k.matt?.h} loading="lazy" decoding="async" style={`object-position:${k.pos}`} />
          <span class="ort-k-ton"></span>
          <span class="ort-k-text"><b>{k.namn}</b><span>{k.text} →</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="sk-band">
    <div class="ort-wrap ort-om">
      <div>
        <p class="sk-eyebrow">Eventutrustning i {ort.namn}</p>
        <h2 class="sk-h2">Professionell scen- och ljudutrustning — levererat till {ort.namn}</h2>
        <p>{ort.areaDesc}</p>
        <p>Vi hyr ut scener, PA-system, ljusutrustning och DJ-utrustning till privatpersoner, företag och föreningar i {ort.namn}. Allt hyrs per dygn med möjlighet till leverans direkt till er eventplats.</p>
      </div>
      {ort.localVenues && ort.localVenues.length > 0 && (
        <aside class="ort-lokaler">
          <p class="ort-liten">Eventlokaler i {ort.namn}</p>
          <h3>Vi levererar till event på platser som dessa</h3>
          {ort.venuesIntro && <p>{ort.venuesIntro}</p>}
          <ul>{ort.localVenues.map((v: string) => <li>{v}</li>)}</ul>
        </aside>
      )}
    </div>
  </section>

  <ProduktRader
    eyebrow={`Populäraste uthyrningar i ${ort.namn}`}
    rubrik="Hyr till ditt event"
    lead="Priser per dygn exkl. moms. Leverans och montering tillkommer och räknas fram i varukorgen."
    rader={POPULART}
    lankar={[{ label: 'Se alla scener', href: '/vara-tjanster/hyra-scen/' }, { label: 'Hyra ljud i Stockholm', href: '/vara-tjanster/hyra-ljud/' }, { label: 'Hyra ljus i Stockholm', href: '/vara-tjanster/hyra-ljus/' }]}
  />

  <section class="ort-wrap">
    <p class="sk-eyebrow">Varför Scenkonsult i {ort.namn}?</p>
    <h2 class="sk-h2">Snabb leverans, hög kvalitet — sedan 1986</h2>
    <div class="ort-fakta">
      {VARFOR.map((f) => (
        <div>
          <b>{f.t}</b>
          <span>{f.d}{f.href && <> <a href={f.href}>Hyra ljudtekniker →</a></>}</span>
        </div>
      ))}
    </div>
  </section>

  {lokalaKunder.length > 0 && (
    <section class="ort-wrap ort-lokala">
      <p class="sk-eyebrow">Kunder vi levererat till i {ort.namn}</p>
      <div>{lokalaKunder.map((k) => <span>{k}</span>)}</div>
    </section>
  )}
  <KundRad rubrik="Utvalda kunder vi levererat till i Storstockholm" />

  <EventFaq rubrik={`Frågor om hyra i ${ort.namn}`} faq={faq} />

  <section class="ort-wrap ort-grannar">
    <div>
      <p class="sk-eyebrow">Vi levererar i hela Storstockholm</p>
      <h2 class="sk-h2s">Hyra scen, ljud &amp; ljus även i närområdet</h2>
    </div>
    <div class="ort-grannlista">
      {grannorter.map((g) => <a href={`/hyra-ljud-scen-${g.slug}/`} class="sk-knapp">{g.namn} →</a>)}
    </div>
  </section>

  <SlutRuta rubrik={`Boka utrustning till ${ort.namn}`} text={`Lägg produkterna i varukorgen och begär offert — kostnadsfritt och inte bindande.`} />
</Layout>

<style>
  .ort-wrap { max-width: 80rem; margin: 0 auto; padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1rem, 3vw, 2rem); }
  .ort-huvud { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.75rem; }
  .ort-kort { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .ort-k { position: relative; display: block; border-radius: 20px; overflow: hidden; aspect-ratio: 4 / 5; background: #1e1850; }
  .ort-k img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .ort-k:hover img { transform: scale(1.04); }
  .ort-k-ton { position: absolute; inset: 0; background: linear-gradient(to top, rgba(12,10,36,0.95) 0%, rgba(12,10,36,0.6) 40%, rgba(12,10,36,0) 70%); }
  .ort-k-text { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.1rem; color: #fff; }
  .ort-k-text b { display: block; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: clamp(1.4rem, 2.2vw, 1.75rem); line-height: 1.05; }
  .ort-k-text span { font-size: 0.9rem; color: rgba(255,255,255,0.78); }
  .ort-om { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .ort-om > div > p { margin: 1.1rem 0 0; font-size: 1.05rem; line-height: 1.7; color: rgba(255,255,255,0.72); }
  .ort-lokaler { border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); padding: 1.6rem; }
  .ort-liten { margin: 0 0 0.4rem; font-family: 'Space Grotesk', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
  .ort-lokaler h3 { margin: 0; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: 1.5rem; line-height: 1.15; color: #fff; }
  .ort-lokaler p:not(.ort-liten) { margin: 0.6rem 0 0; font-size: 0.95rem; line-height: 1.55; color: rgba(255,255,255,0.65); }
  .ort-lokaler ul { list-style: none; margin: 1rem 0 0; padding: 0; }
  .ort-lokaler li { padding: 0.65rem 0; border-top: 1px solid rgba(255,255,255,0.08); color: #fff; }
  .ort-fakta { margin-top: 1.75rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.08); border-radius: 18px; overflow: hidden; }
  .ort-fakta > div { background: #0c0a24; padding: 1.5rem; }
  .ort-fakta b { display: block; margin-bottom: 0.35rem; font-family: 'DM Serif Display', serif; font-weight: 400; font-size: 1.5rem; color: #fff; }
  .ort-fakta span { font-size: 0.95rem; line-height: 1.55; color: rgba(255,255,255,0.7); }
  .ort-fakta a { color: #c4b5f4; text-decoration: none; white-space: nowrap; }
  .ort-lokala { padding-bottom: 0; }
  .ort-lokala > div { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .ort-lokala span { font-family: 'Space Grotesk', sans-serif; font-size: 0.95rem; font-weight: 600; padding: 0.55rem 1rem; border-radius: 999px; border: 1px solid rgba(196,181,244,0.35); color: #fff; }
  .ort-grannar { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; border-top: 1px solid rgba(255,255,255,0.08); }
  .ort-grannar h2 { margin: 0; }
  .ort-grannlista { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ort-grannlista .sk-knapp { font-size: 0.9rem; padding: 0.6rem 1.05rem; }
  @media (max-width: 1000px) { .ort-kort { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ort-om { grid-template-columns: minmax(0, 1fr); } .ort-fakta { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ort-fakta { grid-template-columns: minmax(0, 1fr); } }
</style>
